// # Ed25519 Wide Scalar-Mult Negation Smoke
//
// Logline: Verifies std/crypto/advanced/ed25519_scalarmult_wide.ed25519_curve_neg negates a curve point by negating the X and T coordinates and is deterministic.
//
// Setup: Imports std/crypto/advanced/ed25519_scalarmult_wide.oo and std/crypto/advanced/ed25519_curve.oo (re-imported to get the identity). Pure, no FS or net. Property test (PROP).
//
// Beats:
//   1. ed25519_curve_identity returns a 64-field point.
//   2. ed25519_curve_neg returns a 64-field point of equal length.
//   3. neg(identity) is deterministic across two calls.
//   4. Print ED25519_SCALARMULT_WIDE_PROP_OK on success.

import "std/sec/asymmetric/ed25519_scalarmult_wide.oo";
import "std/sec/asymmetric/ed25519_curve.oo";

pub fn main() {
    let id: List[Int] = ed25519_curve_identity();
    let neg1: List[Int] = ed25519_curve_neg(id);
    let neg2: List[Int] = ed25519_curve_neg(id);
    let n1: Int = neg1.len();
    let n2: Int = neg2.len();
    let idn: Int = id.len();
    if n1 != idn {
        println("FAIL neg len");
        return;
    }
    let mut k: Int = 0;
    while k < idn {
        if list_get(neg1, k) != list_get(neg2, k) {
            println("FAIL neg non-deterministic");
            return;
        }
        k = k + 1;
    }
    if n2 != n1 {
        println("FAIL neg2 len");
        return;
    }
    println("ED25519_SCALARMULT_WIDE_PROP_OK");
}
