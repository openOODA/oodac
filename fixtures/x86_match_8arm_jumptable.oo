// # 8-arm jump table pattern match
pub fn main() {
    let x = V5(42);
    match x {
        V0(a) => { println(a); },
        V1(b) => { println(b); },
        V2(c) => { println(c); },
        V3(d) => { println(d); },
        V4(e) => { println(e); },
        V5(f) => { println(f); },
        V6(g) => { println(g); },
        V7(h) => { println(h); }
    }
}
