// # Group theory and Galois field arithmetic
//
// Logline: Verify finite cyclic group Z_7, modular inverse via EEA, and F_7 prime field arithmetic.
//
// Setup: Pure in-fixture re-declaration. No std import required.
//
// Beats:
//   1. Z_7 has order 7 and identity 0.
//   2. group_combine is associative on Z_7.
//   3. modular_inverse(3, 7) = 5 because 3 * 5 = 15 = 1 mod 7.
//   4. is_generator(3, 7) = true because gcd(3, 7) = 1.
//   5. F_7 Legendre symbol of 3 is 1 (3 is a quadratic residue mod 7).
//   6. F_7 distributivity: a*(b+c) = a*b + a*c.

type Group = struct {
    n: Int
};

pub fn group_combine(g: Group, a: Int, b: Int) -> Int {
    let n: Int = g.n;
    let mut r: Int = (a + b) % n;
    if r < 0 {
        r = r + n;
    }
    return r;
}

pub fn group_inverse(g: Group, a: Int) -> Int {
    let n: Int = g.n;
    let mut r: Int = (0 - a) % n;
    if r < 0 {
        r = r + n;
    }
    return r;
}

pub fn gcd(a: Int, b: Int) -> Int {
    let mut x: Int = a;
    let mut y: Int = b;
    if x < 0 {
        x = 0 - x;
    }
    if y < 0 {
        y = 0 - y;
    }
    while y != 0 {
        let tmp: Int = y;
        y = x % y;
        x = tmp;
    }
    return x;
}

pub fn modular_inverse(a: Int, m: Int) -> Int {
    if m <= 1 {
        return 0;
    }
    let g: Int = gcd(a, m);
    if g != 1 {
        return 0;
    }
    let exp: Int = m - 2;
    let mut res: Int = 1;
    let mut base: Int = a % m;
    if base < 0 {
        base = base + m;
    }
    let mut e: Int = exp;
    while e > 0 {
        if (e & 1) == 1 {
            res = (res * base) % m;
        }
        base = (base * base) % m;
        e = e >> 1;
    }
    return res;
}

pub fn is_generator(n: Int, a: Int) -> Bool {
    if n <= 1 {
        return true;
    }
    if gcd(a, n) == 1 {
        return true;
    }
    return false;
}

type PrimeField = struct {
    p: Int
};

pub fn fp_new(p: Int) -> PrimeField {
    let mut prime: Int = p;
    if prime < 2 {
        prime = 2;
    }
    return PrimeField { p: prime };
}

pub fn fp_reduce(f: PrimeField, v: Int) -> Int {
    let p: Int = f.p;
    let mut r: Int = v % p;
    if r < 0 {
        r = r + p;
    }
    return r;
}

pub fn fp_add(f: PrimeField, a: Int, b: Int) -> Int {
    return fp_reduce(f, a + b);
}

pub fn fp_sub(f: PrimeField, a: Int, b: Int) -> Int {
    return fp_reduce(f, a - b);
}

pub fn fp_mul(f: PrimeField, a: Int, b: Int) -> Int {
    return fp_reduce(f, a * b);
}

pub fn fp_pow(f: PrimeField, a: Int, exp: Int) -> Int {
    let p: Int = f.p;
    if exp < 0 {
        return 0;
    }
    if exp == 0 {
        return 1;
    }
    let mut res: Int = 1;
    let mut base: Int = fp_reduce(f, a);
    let mut e: Int = exp;
    while e > 0 {
        if (e & 1) == 1 {
            res = (res * base) % p;
        }
        base = (base * base) % p;
        e = e >> 1;
    }
    return res;
}

pub fn fp_legendre(f: PrimeField, a: Int) -> Int {
    let p: Int = f.p;
    if p < 3 {
        return 0;
    }
    let r: Int = fp_pow(f, a, (p - 1) / 2);
    if r == 0 {
        return 0;
    }
    if r == 1 {
        return 1;
    }
    let p_minus_one: Int = p - 1;
    if r == p_minus_one {
        return 0 - 1;
    }
    return 0;
}

pub fn main() {
    let g7: Group = Group { n: 7 };
    if g7.n == 7 {
        println("OK z7_order_7");
    } else {
        println("FAIL z7_order");
        process_exit(1);
    }

    let l: Int = group_combine(g7, group_combine(g7, 2, 3), 4);
    let r: Int = group_combine(g7, 2, group_combine(g7, 3, 4));
    if l == r {
        if l == 2 {
            println("OK z7_associative_2_3_4");
        } else {
            println("FAIL z7_associative_wrong_value");
            process_exit(1);
        }
    } else {
        println("FAIL z7_associative");
        process_exit(1);
    }

    let inv2: Int = modular_inverse(2, 7);
    if inv2 == 4 {
        println("OK modular_inverse_2_mod_7_equals_4");
    } else {
        println("FAIL modular_inverse_2_mod_7");
        process_exit(1);
    }
    let v_check: Int = (2 * inv2) % 7;
    if v_check == 1 {
        println("OK modular_inverse_verification_2_times_4_mod_7");
    } else {
        println("FAIL modular_inverse_verification");
        process_exit(1);
    }

    if is_generator(7, 3) {
        println("OK is_generator_3_mod_7");
    } else {
        println("FAIL is_generator");
        process_exit(1);
    }

    let f7: PrimeField = fp_new(7);
    let a: Int = fp_mul(f7, 3, fp_add(f7, 2, 4));
    let b: Int = fp_add(f7, fp_mul(f7, 3, 2), fp_mul(f7, 3, 4));
    if a == b {
        if a == 4 {
            println("OK f7_distributivity");
        } else {
            println("FAIL f7_distributive_value");
            process_exit(1);
        }
    } else {
        println("FAIL f7_distributive");
        process_exit(1);
    }

    let leg_2: Int = fp_legendre(f7, 2);
    if leg_2 == 1 {
        println("OK legendre_2_mod_7_is_residue");
    } else {
        println("FAIL legendre_2_mod_7");
        process_exit(1);
    }

    let leg_3: Int = fp_legendre(f7, 3);
    if leg_3 == 0 - 1 {
        println("OK legendre_3_mod_7_is_non_residue");
    } else {
        println("FAIL legendre_3_mod_7");
        process_exit(1);
    }

    let leg_0: Int = fp_legendre(f7, 0);
    if leg_0 == 0 {
        println("OK legendre_0_mod_7_is_zero");
    } else {
        println("FAIL legendre_0_mod_7");
        process_exit(1);
    }

    println("test_theory_galois: PASSED");
}
