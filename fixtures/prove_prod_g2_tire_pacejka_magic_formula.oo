// # Product prove std/robot/mpc/tire_pacejka_magic_formula.oo
//
// Logline: Fail-closed emit+gcc+run asserts pacejka_lateral_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/mpc/tire_pacejka_magic_formula.oo.
//
// Beats:
//   1. Call pacejka_lateral_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_tire_pacejka_magic_formula: PASSED only if they match.

import "std/app/robot/mpc/tire_pacejka_magic_formula.oo";

pub fn main() {
    let tire_pacejka_magic_formula_mark: Int = 0;
    if tire_pacejka_magic_formula_mark != 0 {
        process_exit(1);
    }
    let a: PacejkaCoefficients = pacejka_lateral_default();
    let b: PacejkaCoefficients = pacejka_lateral_default();
    if (a).b_stiff != (b).b_stiff {
        println("FAIL pacejka_lateral_default");
        process_exit(1);
    }
    println("prod_g2_tire_pacejka_magic_formula: PASSED");
}
