// # XML parse (RESIDUAL) smoke
//
// Logline: Asserts std/markup/xml.xml_parse on the two exact-match demo vectors it advertises ("<hi>yo</hi>" -> Ok("yo") and "<t></t>" -> Ok("")) and on the failure boundary ("<x>bad" and "not xml" -> Err). The module is documented as RESIDUAL — the parser is exact-match only and fails closed on every other input.
//
// Setup: Imports std/markup/xml.oo. Only the Ok/Err boundary is exercised; the inner parse value is acknowledged but not asserted because the ok() projection triggers a redefinition at the C-emit stage (RESIDUAL).
//
// Beats:
//   1. "<hi>yo</hi>" -> Ok.
//   2. "<t></t>" -> Ok.
//   3. "<x>bad" -> Err (unclosed tag).
//   4. "not xml" -> Err (no tags).

import "std/core/markup/xml.oo";

pub fn main() {
    let xml_dummy: Int = 0;

    // Beat 1: <hi>yo</hi> -> Ok.
    let r1: Result[String, String] = xml_parse("<hi>yo</hi>");
    if r1.is_err() {
        println("FAIL <hi>yo</hi> err");
        return;
    }
    println("OK <hi>yo</hi>");

    // Beat 2: <t></t> -> Ok.
    let r2: Result[String, String] = xml_parse("<t></t>");
    if r2.is_err() {
        println("FAIL <t></t> err");
        return;
    }
    println("OK <t></t>");

    // Beat 3: unclosed tag.
    let r3: Result[String, String] = xml_parse("<x>bad");
    if r3.is_ok() {
        println("FAIL <x>bad accepted");
        return;
    }
    println("OK <x>bad rejected");

    // Beat 4: not xml.
    let r4: Result[String, String] = xml_parse("not xml");
    if r4.is_ok() {
        println("FAIL 'not xml' accepted");
        return;
    }
    println("OK not xml rejected");

    println("RESIDUAL xml_parse only matches <hi>yo</hi> and <t></t> exactly; all other inputs fail closed");
    let total: Int = xml_dummy + 1;
    println("XML_RT_OK");
    println("total=" + total.to_string());
}
