// # Negative Test: Unsatisfiable Multiplicative Interval
//
// Logline: Fails closed when bounded product contradicts lower interval bound.
//
// Setup: Pure .oo test for fail-closed SMT refusal.
//
// Beats:
//   1. Function invalid requires a >= 10 && a <= 20 && b >= 10 && b <= 20 && a * b < 50.
//   2. Compiler refuses with ERR smt unsat requires.
//   3. Process exits with code 1.

pub fn invalid(a: Int, b: Int) -> Int
    requires a >= 10 && a <= 20 && b >= 10 && b <= 20 && a * b < 50
{
    return a * b;
}

pub fn main() {
    println(invalid(10, 10));
}
