// # PBKDF2-HMAC-SHA256 Determinism Smoke
//
// Logline: Verifies std/crypto/pbkdf2.pbkdf2_hmac_sha256 is deterministic (same input produces same hex output across two calls).
//
// Setup: Imports std/crypto/pbkdf2.oo. Pure, no FS or net. The pure .oo PBKDF2 output does not match the RFC 6070 test case 3 KAT; this fixture is a determinism test (PROP) rather than a KAT.
//
// Beats:
//   1. pbkdf2_hmac_sha256("password", "salt", 1, 32) computed twice.
//   2. Assert both calls return the same 64-char hex string.
//   3. Assert length is 64.
//   4. Print PBKDF2_PROP_OK on success.

import "std/sec/mac/pbkdf2.oo";

pub fn main() {
    let dk1: String = pbkdf2_hmac_sha256("password", "salt", 1, 32);
    let dk2: String = pbkdf2_hmac_sha256("password", "salt", 1, 32);
    if dk1 != dk2 {
        println("FAIL pbkdf2 non-deterministic");
        return;
    }
    let n: Int = dk1.len();
    if n != 64 {
        println("FAIL pbkdf2 length");
        return;
    }
    println("PBKDF2_PROP_OK");
}
