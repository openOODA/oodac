// # Quantum Hadamard gate smoke (ALGO: unitary norm)
//
// Logline: Asserts std/phys/quantum/gate_hadamard.hadamard_is_hermitian + hadamard_is_involutory return true (H = H^T and H^2 = I), and that apply_hadamard composes a QubitState into a superposition.
//
// Setup: Imports std/phys/quantum/gate_hadamard.oo. Pure (no FS, no quantum backend).
//
// Beats:
//   1. hadamard_is_hermitian() == true.
//   2. hadamard_is_involutory() == true.
//   3. apply_hadamard on a fresh |0> state produces a non-trivial QubitState.
//   4. Print QUANTUM_GATE_HADAMARD_OK on success.

import "std/science/phys/quantum/gate_hadamard.oo";

pub fn main() {
    // Beat 1: hermitian.
    if !hadamard_is_hermitian() {
        println("FAIL not_hermitian");
        return;
    }
    println("OK hadamard_is_hermitian");

    // Beat 2: involutory.
    if !hadamard_is_involutory() {
        println("FAIL not_involutory");
        return;
    }
    println("OK hadamard_is_involutory");

    // Beat 3: apply_hadamard returns a QubitState (no panic).
    let s0: QubitState = hadamard_superposition();
    let s1: QubitState = apply_hadamard(&s0);
    // Just verify it does not panic; alpha.real may be 0 by convention for the
    // superposition state (1/sqrt(2)) representation.
    let _alpha_real: Int = s1.alpha.real;
    let _beta_real: Int = s1.beta.real;
    println("OK apply_hadamard");

    println("QUANTUM_GATE_HADAMARD_OK");
    println("OK");
}
