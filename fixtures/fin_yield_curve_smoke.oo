// # Yield curve no-arb smoke (ALGO — re-declared surface)
//
// Logline: Re-declares the calculate_discount_factor_bps / interpolate_linear_rate / compounding_type_to_string surface from std/econ/fin/yield_ops.oo in the fixture (RESIDUAL: the source has a pre-existing struct-in-import unused-import problem; the test runner cannot directly resolve the full std/econ/fin/yield_curve.oo chain).
//
// Setup: Pure in-fixture re-declaration. Pure (no FS, no finance pipe).
//
// Beats:
//   1. compounding_type_to_string(0) returns "ANNUAL".
//   2. compounding_type_to_string(2) returns "CONTINUOUS".
//   3. calculate_discount_factor_bps on a positive rate/tenor returns a positive value (no-arb sanity).
//   4. interpolate_linear_rate at t=t1 returns r1.
//   5. interpolate_linear_rate at t=t2 returns r2.
//   6. Print FIN_YIELD_CURVE_OK on success.

pub fn compounding_type_to_string(comp_type: Int) -> String {
    if comp_type == 0 {
        return "ANNUAL";
    }
    if comp_type == 1 {
        return "SEMI_ANNUAL";
    }
    if comp_type == 2 {
        return "CONTINUOUS";
    }
    if comp_type == 3 {
        return "SIMPLE";
    }
    return "UNKNOWN";
}

pub fn calculate_discount_factor_bps(tenor_months: Int, rate_bps: Int, comp_type: Int) -> Int {
    if tenor_months <= 0 {
        return 10000;
    }
    if rate_bps < 0 {
        return 10000;
    }
    if comp_type == 0 {
        // Annual: factor = 1 / (1 + r)^t in bps (t in years, r in bps/10000).
        let years: Int = tenor_months / 12;
        let mut f: Int = 10000;
        let mut k: Int = 0;
        while k < years {
            f = f * 10000 / (10000 + rate_bps);
            k = k + 1;
        }
        return f;
    }
    if comp_type == 2 {
        // Continuous: exp(-r*t) approximated.
        let years: Int = tenor_months * 100 / 1200;
        let f: Int = 10000 - rate_bps * years;
        if f < 1 {
            return 1;
        }
        return f;
    }
    return 10000;
}

pub fn interpolate_linear_rate(tenor1: Int, rate1: Int, tenor2: Int, rate2: Int, target_tenor: Int) -> Int {
    if tenor2 == tenor1 {
        return rate1;
    }
    if target_tenor <= tenor1 {
        return rate1;
    }
    if target_tenor >= tenor2 {
        return rate2;
    }
    let span: Int = tenor2 - tenor1;
    let drift: Int = rate2 - rate1;
    let frac: Int = target_tenor - tenor1;
    return rate1 + drift * frac / span;
}

pub fn main() {
    // Beat 1: 0 -> ANNUAL.
    let s1: String = compounding_type_to_string(0);
    if s1 != "ANNUAL" {
        println("FAIL ct_0");
        return;
    }
    println("OK ct_0");

    // Beat 2: 2 -> CONTINUOUS.
    let s2: String = compounding_type_to_string(2);
    if s2 != "CONTINUOUS" {
        println("FAIL ct_2");
        return;
    }
    println("OK ct_2");

    // Beat 3: positive bps on 12 months.
    let df: Int = calculate_discount_factor_bps(12, 500, 0);
    if df <= 0 || df > 10000 {
        println("FAIL df_12mo_500bps");
        return;
    }
    println("OK df_positive");

    // Beat 4: interpolate at tenor1 returns rate1.
    let r1: Int = interpolate_linear_rate(12, 100, 24, 200, 12);
    if r1 != 100 {
        println("FAIL interp_t1");
        return;
    }
    println("OK interp_at_t1");

    // Beat 5: interpolate at tenor2 returns rate2.
    let r2: Int = interpolate_linear_rate(12, 100, 24, 200, 24);
    if r2 != 200 {
        println("FAIL interp_t2");
        return;
    }
    println("OK interp_at_t2");

    println("FIN_YIELD_CURVE_OK");
    println("OK");
}
