// # KV engine round-trip smoke
//
// Logline: Asserts std/data/db/kv_types.kv_entry_new + kv_entry_tombstone + kv_config_default + str_lt compose the correct records for the LSM/BTree engine.
//
// Setup: Imports std/data/db/kv_types.oo (RESIDUAL: kv_engine.oo has a pre-existing wal mutation bug — the engine is unrunnable, so we exercise the pure type/ctor layer).
//
// Beats:
//   1. kv_entry_new("k", "v", 1) preserves all four fields.
//   2. kv_entry_tombstone flips is_tombstone to true.
//   3. kv_config_default sets memtable_capacity=1000, sync_wal=true.
//   4. str_lt and str_lte produce deterministic comparison results.
//   5. Print DB_KV_ENGINE_RT_OK on success.

import "std/app/data/db/kv_types.oo";

pub fn main() {
    // Beat 1: entry construction.
    let e: KvEntry = kv_entry_new("hello", "world", 7);
    if e.key != "hello" {
        println("FAIL entry_key: " + e.key);
        return;
    }
    if e.value != "world" {
        println("FAIL entry_value: " + e.value);
        return;
    }
    if e.seq_num != 7 {
        println("FAIL entry_seq: " + e.seq_num.to_string());
        return;
    }
    if e.is_tombstone {
        println("FAIL entry_tombstone_should_be_false");
        return;
    }
    println("OK kv_entry_new");

    // Beat 2: tombstone.
    let t: KvEntry = kv_entry_tombstone("dead", 9);
    if !t.is_tombstone {
        println("FAIL entry_tombstone_should_be_true");
        return;
    }
    if t.key != "dead" {
        println("FAIL tombstone_key");
        return;
    }
    println("OK kv_entry_tombstone");

    // Beat 3: default config.
    let cfg: KvConfig = kv_config_default("/tmp/ooda_kv_smoke");
    if cfg.memtable_capacity != 1000 {
        println("FAIL cfg_capacity: " + cfg.memtable_capacity.to_string());
        return;
    }
    if !cfg.sync_wal {
        println("FAIL cfg_sync_wal");
        return;
    }
    if cfg.bloom_bits_per_key != 10 {
        println("FAIL cfg_bloom: " + cfg.bloom_bits_per_key.to_string());
        return;
    }
    println("OK kv_config_default");

    // Beat 4: str_lt / str_lte.
    if !str_lt("a", "b") {
        println("FAIL str_lt a<b");
        return;
    }
    if str_lt("b", "a") {
        println("FAIL str_lt b<a");
        return;
    }
    if !str_lte("a", "a") {
        println("FAIL str_lte a<=a");
        return;
    }
    if !str_lte("a", "b") {
        println("FAIL str_lte a<=b");
        return;
    }
    println("OK str_lt_str_lte");

    println("DB_KV_ENGINE_RT_OK");
    println("OK");
}
