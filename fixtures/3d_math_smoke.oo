// # 3D vector math smoke (inline, no std import)
//
// Logline: Re-declares the Vector3 / vector3_add / vector3_dot / vector3_cross / vector3_length_squared surface from std/ui/3d/math.oo in the fixture (RESIDUAL: std/ui/3d/math.oo is reachable via the test runner but the import checker rejects the import for fixtures outside the mesh_ops lineage).
//
// Setup: Pure in-fixture re-declaration. No FS, no GPU.
//
// Beats:
//   1. vec3_new round-trips fields.
//   2. vec3_add((1,2,3),(4,5,6)) = (5,7,9).
//   3. vec3_sub((5,7,9),(4,5,6)) = (1,2,3).
//   4. vec3_dot((1,2,3),(4,5,6)) = 32.
//   5. vec3_cross((1,0,0),(0,1,0)) = (0,0,1).
//   6. vec3_length_squared((3,4,0)) = 25.
//   7. Print 3D_MATH_OK on success.

type Vector3 = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn vec3_new(x: Int, y: Int, z: Int) -> Vector3 {
    return Vector3 {
        x: x,
        y: y,
        z: z
    };
}

pub fn vec3_add(a: Vector3, b: Vector3) -> Vector3 {
    let ax: Int = a.x;
    let ay: Int = a.y;
    let az: Int = a.z;
    let bx: Int = b.x;
    let by: Int = b.y;
    let bz: Int = b.z;
    return Vector3 {
        x: ax + bx,
        y: ay + by,
        z: az + bz
    };
}

pub fn vec3_sub(a: Vector3, b: Vector3) -> Vector3 {
    let ax: Int = a.x;
    let ay: Int = a.y;
    let az: Int = a.z;
    let bx: Int = b.x;
    let by: Int = b.y;
    let bz: Int = b.z;
    return Vector3 {
        x: ax - bx,
        y: ay - by,
        z: az - bz
    };
}

pub fn vec3_dot(a: Vector3, b: Vector3) -> Int {
    let ax: Int = a.x;
    let ay: Int = a.y;
    let az: Int = a.z;
    let bx: Int = b.x;
    let by: Int = b.y;
    let bz: Int = b.z;
    return (ax * bx) + (ay * by) + (az * bz);
}

pub fn vec3_cross(a: Vector3, b: Vector3) -> Vector3 {
    let ax: Int = a.x;
    let ay: Int = a.y;
    let az: Int = a.z;
    let bx: Int = b.x;
    let by: Int = b.y;
    let bz: Int = b.z;
    return Vector3 {
        x: (ay * bz) - (az * by),
        y: (az * bx) - (ax * bz),
        z: (ax * by) - (ay * bx)
    };
}

pub fn vec3_length_squared(a: Vector3) -> Int {
    return vec3_dot(a, a);
}

pub fn main() {
    // Beat 1: round-trip.
    let v: Vector3 = vec3_new(1, 2, 3);
    if v.x != 1 || v.y != 2 || v.z != 3 {
        println("FAIL vec3_new");
        return;
    }
    println("OK vec3_new");

    // Beat 2: add.
    let s: Vector3 = vec3_add(vec3_new(1, 2, 3), vec3_new(4, 5, 6));
    if s.x != 5 || s.y != 7 || s.z != 9 {
        println("FAIL vec3_add");
        return;
    }
    println("OK vec3_add");

    // Beat 3: sub.
    let d: Vector3 = vec3_sub(s, vec3_new(4, 5, 6));
    if d.x != 1 || d.y != 2 || d.z != 3 {
        println("FAIL vec3_sub");
        return;
    }
    println("OK vec3_sub");

    // Beat 4: dot.
    let dot: Int = vec3_dot(vec3_new(1, 2, 3), vec3_new(4, 5, 6));
    if dot != 32 {
        println("FAIL vec3_dot");
        return;
    }
    println("OK vec3_dot");

    // Beat 5: cross.
    let c: Vector3 = vec3_cross(vec3_new(1, 0, 0), vec3_new(0, 1, 0));
    if c.x != 0 || c.y != 0 || c.z != 1 {
        println("FAIL vec3_cross");
        return;
    }
    println("OK vec3_cross");

    // Beat 6: length squared.
    let lsq: Int = vec3_length_squared(vec3_new(3, 4, 0));
    if lsq != 25 {
        println("FAIL vec3_length_squared");
        return;
    }
    println("OK vec3_length_squared");

    println("3D_MATH_OK");
    println("OK");
}
