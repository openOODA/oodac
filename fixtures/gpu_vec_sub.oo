// # GPU vector sub kernel fixture
//
// Logline: Declares an @gpu k_sub kernel that writes elementwise difference into c.
//
// Setup: FloatPtr buffers and Int length. No host string keywords.
//
// Beats:
//   1. Annotate k_sub as an @gpu device function.
//   2. Walk i from 0 to n and assign c[i] from a[i] minus b[i].
//   3. Provide an empty host main.

@gpu pub fn k_sub(a: FloatPtr, b: FloatPtr, c: FloatPtr, n: Int) {
    let mut i: Int = 0;
    while i < n {
        c[i] = a[i] - b[i];
        i = i + 1;
    }
}
pub fn main() {}
