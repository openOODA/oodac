// # Product prove std/phys/astrophysics_relativity/pulsar_dispersion_measure.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/phys/astrophysics_relativity/pulsar_dispersion_measure.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/phys/astrophysics_relativity/pulsar_dispersion_measure.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pulsar_dispersion_measure: PASSED only if they match.

import "std/science/phys/relativistic/pulsar_dispersion_measure.oo";

pub fn main() {
    let pulsar_dispersion_measure_a = pulsar_dispersion_measure_invert(0, 0);
    let pulsar_dispersion_measure_b = pulsar_dispersion_measure_invert(0, 0);
    if pulsar_dispersion_measure_a != pulsar_dispersion_measure_b {
        println("FAIL pulsar_dispersion_measure");
        process_exit(1);
    }
    println("prod_ap_pulsar_dispersion_measure: PASSED");
}
