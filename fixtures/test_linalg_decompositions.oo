// # Linear Algebra Decomposition Fixture
//
// Logline: Checks LU, Householder QR, Cholesky, and Jacobi SVD against known matrices.
//
// Setup: Isolated emit-c. Run from ooda/.
//
// Beats:
//   1. LU solves Ax = b and matches det and reconstruction residual.
//   2. QR reconstructs A and solves a 3 by 2 least-squares system.
//   3. Cholesky reconstructs an SPD matrix and fail-closes on a non-SPD matrix.
//   4. Jacobi SVD reconstructs A and matches a diagonal pseudo-inverse.

import "std/core/math/linalg/lu_decomp.oo";
import "std/core/math/linalg/qr_decomp.oo";
import "std/core/math/linalg/cholesky.oo";
import "std/core/math/linalg/svd_jacobi.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn unwrap_f(r: Result[Float, String], msg: String) -> Float {
    match r {
        Ok(v) => { return v; },
        Err(e) => { fail(msg + ": " + e); return 0.0; }
    }
}

fn unwrap_fv(r: Result[List[Float], String], msg: String) -> List[Float] {
    match r {
        Ok(v) => { return v; },
        Err(e) => { fail(msg + ": " + e); return list_new(); }
    }
}

fn near(a: Float, b: Float, eps: Float) -> Bool {
    let mut d: Float = a - b;
    if d < 0.0 { d = 0.0 - d; }
    return d <= eps;
}

fn push3(a: List[Float], x: Float, y: Float, z: Float) -> List[Float] {
    let mut o: List[Float] = a;
    o = list_push(o, x);
    o = list_push(o, y);
    o = list_push(o, z);
    return o;
}

fn test_lu() {
    let mut a: List[Float] = list_new();
    a = push3(a, 2.0, 1.0, 0.0 - 1.0);
    a = push3(a, 0.0 - 3.0, 0.0 - 1.0, 2.0);
    a = push3(a, 0.0 - 2.0, 1.0, 2.0);
    let mut b: List[Float] = list_new();
    b = push3(b, 8.0, 0.0 - 11.0, 0.0 - 3.0);
    let pack: List[Float] = unwrap_fv(lu_decomp_factor(a, 3), "lu factor");
    let x: List[Float] = unwrap_fv(lu_decomp_solve(pack, 3, b), "lu solve");
    if near(list_get(x, 0), 2.0, 0.000001) == false { fail("lu x0"); }
    if near(list_get(x, 1), 3.0, 0.000001) == false { fail("lu x1"); }
    if near(list_get(x, 2), 0.0 - 1.0, 0.000001) == false { fail("lu x2"); }
    let det: Float = unwrap_f(lu_decomp_det(pack, 3), "lu det");
    if near(det, 0.0 - 1.0, 0.000001) == false { fail("lu det"); }
    let rec: List[Float] = unwrap_fv(lu_decomp_reconstruct(pack, 3), "lu rec");
    if near(list_get(rec, 0), 2.0, 0.000001) == false { fail("lu rec00"); }
    if near(list_get(rec, 4), 0.0 - 1.0, 0.000001) == false { fail("lu rec11"); }
    if near(list_get(rec, 8), 2.0, 0.000001) == false { fail("lu rec22"); }
    println("OK lu");
}

fn test_qr() {
    let mut a: List[Float] = list_new();
    a = push3(a, 2.0, 1.0, 0.0 - 1.0);
    a = push3(a, 0.0 - 3.0, 0.0 - 1.0, 2.0);
    a = push3(a, 0.0 - 2.0, 1.0, 2.0);
    let pack: List[Float] = unwrap_fv(qr_decomp_factor(a, 3, 3), "qr factor");
    let rec: List[Float] = unwrap_fv(qr_decomp_reconstruct(pack, 3, 3), "qr rec");
    let mut k: Int = 0;
    while k < 9 {
        if near(list_get(rec, k), list_get(a, k), 0.000001) == false { fail("qr rec"); }
        k = k + 1;
    }
    let mut aa: List[Float] = list_new();
    aa = list_push(aa, 1.0);
    aa = list_push(aa, 1.0);
    aa = list_push(aa, 1.0);
    aa = list_push(aa, 2.0);
    aa = list_push(aa, 1.0);
    aa = list_push(aa, 3.0);
    let mut bb: List[Float] = list_new();
    bb = list_push(bb, 1.0);
    bb = list_push(bb, 2.0);
    bb = list_push(bb, 2.0);
    let xs: List[Float] = unwrap_fv(qr_decomp_lstsq(aa, 3, 2, bb), "qr lstsq");
    if near(list_get(xs, 0), 2.0 / 3.0, 0.00001) == false { fail("qr lstsq0"); }
    if near(list_get(xs, 1), 0.5, 0.00001) == false { fail("qr lstsq1"); }
    println("OK qr");
}

fn test_chol() {
    let mut a: List[Float] = list_new();
    a = list_push(a, 4.0);
    a = list_push(a, 2.0);
    a = list_push(a, 2.0);
    a = list_push(a, 3.0);
    let l: List[Float] = unwrap_fv(cholesky_factor(a, 2), "chol factor");
    if near(list_get(l, 0), 2.0, 0.000001) == false { fail("chol l00"); }
    if near(list_get(l, 2), 1.0, 0.000001) == false { fail("chol l10"); }
    let rec: List[Float] = unwrap_fv(cholesky_reconstruct(l, 2), "chol rec");
    if near(list_get(rec, 0), 4.0, 0.000001) == false { fail("chol rec00"); }
    if near(list_get(rec, 3), 3.0, 0.000001) == false { fail("chol rec11"); }
    let mut bad: List[Float] = list_new();
    bad = list_push(bad, 1.0);
    bad = list_push(bad, 2.0);
    bad = list_push(bad, 2.0);
    bad = list_push(bad, 1.0);
    let br: Result[List[Float], String] = cholesky_factor(bad, 2);
    if br.is_ok() { fail("chol should reject non-SPD"); }
    println("OK chol");
}

fn test_svd() {
    let mut a: List[Float] = list_new();
    a = list_push(a, 3.0);
    a = list_push(a, 0.0);
    a = list_push(a, 0.0);
    a = list_push(a, 2.0);
    let pack: List[Float] = unwrap_fv(svd_jacobi_factor(a, 2), "svd factor");
    let rec: List[Float] = unwrap_fv(svd_jacobi_reconstruct(pack, 2), "svd rec");
    if near(list_get(rec, 0), 3.0, 0.00001) == false { fail("svd rec00"); }
    if near(list_get(rec, 3), 2.0, 0.00001) == false { fail("svd rec11"); }
    let pinv: List[Float] = unwrap_fv(svd_jacobi_pinv(pack, 2), "svd pinv");
    if near(list_get(pinv, 0), 1.0 / 3.0, 0.00001) == false { fail("svd pinv00"); }
    if near(list_get(pinv, 3), 0.5, 0.00001) == false { fail("svd pinv11"); }
    let mut b: List[Float] = list_new();
    b = list_push(b, 1.0);
    b = list_push(b, 2.0);
    b = list_push(b, 3.0);
    b = list_push(b, 4.0);
    let pb: List[Float] = unwrap_fv(svd_jacobi_factor(b, 2), "svd b");
    let rb: List[Float] = unwrap_fv(svd_jacobi_reconstruct(pb, 2), "svd b rec");
    if near(list_get(rb, 0), 1.0, 0.0001) == false { fail("svd b00"); }
    if near(list_get(rb, 3), 4.0, 0.0001) == false { fail("svd b11"); }
    println("OK svd");
}

pub fn main() {
    test_lu();
    test_qr();
    test_chol();
    test_svd();
    println("LINALG_DECOMPOSITIONS_ALL_PASSED");
}
