// # Product prove std/phys/astrodynamics/tle_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/phys/astrodynamics/tle_parser.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/phys/astrodynamics/tle_parser.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_tle_parser: PASSED only if they match.

import "std/science/phys/relativistic/tle_parser.oo";

pub fn main() {
    let tle_parser_a = tle_line_len();
    let tle_parser_b = tle_line_len();
    if tle_parser_a != tle_parser_b {
        println("FAIL tle_parser");
        process_exit(1);
    }
    println("prod_ap_tle_parser: PASSED");
}
