// # Negative Test: Unsatisfiable Sign Product
//
// Logline: Fails closed when positive inputs are required to have a non-positive product.
//
// Setup: Pure .oo test for fail-closed SMT refusal.
//
// Beats:
//   1. Function invalid requires x >= 1 && y >= 1 && x * y <= 0.
//   2. Compiler refuses with ERR smt unsat requires.
//   3. Process exits with code 1.

pub fn invalid(x: Int, y: Int) -> Int
    requires x >= 1 && y >= 1 && x * y <= 0
{
    return x * y;
}

pub fn main() {
    println(invalid(2, 3));
}
