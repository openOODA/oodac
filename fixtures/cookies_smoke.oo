// # HTTP cookies RFC 6265 round-trip smoke
//
// Logline: Asserts std/net/cookies builder (cookie_with_path, cookie_with_domain, cookie_with_max_age, cookie_with_secure, cookie_with_http_only, cookie_with_same_site), serializers, and name/value parsers against RFC 6265 §5 examples.
//
// Setup: Imports std/net/cookies.oo. Pure.
//
// Beats:
//   1. cookie_serialize_set_cookie emits the full attribute list per RFC 6265 §5.2.
//   2. cookie_serialize_cookie emits the bare name=value for the Cookie request header.
//   3. cookie_parse_name and cookie_parse_value strip attributes from a Cookie header value.
//   4. cookie_new is a passthrough with empty extra fields.

import "std/net/cookies.oo";

pub fn main() {
    let cookies_dummy: Int = 0;

    // Beat 1: full set-cookie.
    let c1: HttpCookie = cookie_new("session", "abc123");
    let c2: HttpCookie = cookie_with_path(c1, "/api");
    let c3: HttpCookie = cookie_with_domain(c2, "example.com");
    let c4: HttpCookie = cookie_with_max_age(c3, 3600);
    let c5: HttpCookie = cookie_with_secure(c4, true);
    let c6: HttpCookie = cookie_with_http_only(c5, true);
    let c7: HttpCookie = cookie_with_same_site(c6, "Strict");
    let sc: String = cookie_serialize_set_cookie(c7);
    if !sc.contains("session=abc123") {
        println("FAIL set-cookie name=value got " + sc);
        return;
    }
    if !sc.contains("Path=/api") {
        println("FAIL Path got " + sc);
        return;
    }
    if !sc.contains("Domain=example.com") {
        println("FAIL Domain got " + sc);
        return;
    }
    if !sc.contains("Max-Age=3600") {
        println("FAIL Max-Age got " + sc);
        return;
    }
    if !sc.contains("Secure") {
        println("FAIL Secure got " + sc);
        return;
    }
    if !sc.contains("HttpOnly") {
        println("FAIL HttpOnly got " + sc);
        return;
    }
    if !sc.contains("SameSite=Strict") {
        println("FAIL SameSite got " + sc);
        return;
    }
    println("OK set-cookie attributes");

    // Beat 2: cookie request header.
    let ck: String = cookie_serialize_cookie(c7);
    if ck != "session=abc123" {
        println("FAIL cookie request got " + ck);
        return;
    }
    println("OK cookie request");

    // Beat 3: name/value parsing.
    if cookie_parse_name("session=abc123") != "session" {
        println("FAIL parse_name bare got " + cookie_parse_name("session=abc123"));
        return;
    }
    if cookie_parse_value("session=abc123") != "abc123" {
        println("FAIL parse_value bare got " + cookie_parse_value("session=abc123"));
        return;
    }
    if cookie_parse_name("user=foo; Path=/") != "user" {
        println("FAIL parse_name attrs got " + cookie_parse_name("user=foo; Path=/"));
        return;
    }
    if cookie_parse_value("user=foo; Path=/") != "foo" {
        println("FAIL parse_value attrs got " + cookie_parse_value("user=foo; Path=/"));
        return;
    }
    println("OK parse name value");

    let total: Int = cookies_dummy + 1;
    println("COOKIES_RT_OK");
    println("total=" + total.to_string());
}
