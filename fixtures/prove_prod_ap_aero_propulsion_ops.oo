// # Product prove std/phys/aero/propulsion_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/phys/aero/propulsion_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/phys/aero/propulsion_ops.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_propulsion_ops: PASSED only if they match.

import "std/app/combat/propulsion_ops.oo";

pub fn main() {
    let propulsion_ops_a = standard_gravity();
    let propulsion_ops_b = standard_gravity();
    if propulsion_ops_a != propulsion_ops_b {
        println("FAIL propulsion_ops");
        process_exit(1);
    }
    println("prod_ap_propulsion_ops: PASSED");
}
