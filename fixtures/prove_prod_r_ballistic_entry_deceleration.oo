// # Product prove std/phys/space_propulsion/ballistic_entry_deceleration.oo
//
// Logline: Fail-closed emit+gcc+run asserts ballistic_entry_spec_default value or determinism.
//
// Setup: Isolated emit-c. Imports std/phys/space_propulsion/ballistic_entry_deceleration.oo.
//
// Beats:
//   1. Call ballistic_entry_spec_default twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_ballistic_entry_deceleration: PASSED only if asserts hold.

import "std/science/phys/relativistic/ballistic_entry_deceleration.oo";

pub fn main() {
    let ballistic_entry_deceleration: BallisticEntrySpec = ballistic_entry_spec_default();
    let ballistic_entry_deceleration_b: BallisticEntrySpec = ballistic_entry_spec_default();
    if (ballistic_entry_deceleration).entry_velocity_m_s != 7200.0 {
        println("FAIL ballistic_entry_spec_default entry_velocity_m_s");
        process_exit(1);
    }
    if (ballistic_entry_deceleration).entry_velocity_m_s != (ballistic_entry_deceleration_b).entry_velocity_m_s {
        println("FAIL ballistic_entry_spec_default det");
        process_exit(1);
    }
    println("prod_ballistic_entry_deceleration: PASSED");
}
