// # Byte Adversarial Smoke Test
//
// Logline: Verifies byte clamping, range checking, and string byte operations with adversarial inputs.
//
// Setup: Pure integer and string operations. No FS or net dependencies.
//
// Beats:
//   1. VALID: Normal byte clamping and range checks.
//   2. NEGATIVE TRUST: Test with boundary values (0, 255).
//   3. ADVERSARIAL: Test with out-of-range values.
//   4. DOUBLE-RUN: Verify all operations are deterministic.

import "std/core/primitives/byte.oo";

pub fn expect_eq_int(label: String, got: Int, want: Int) -> Bool {
    if got == want { println("OK " + label); return true; }
    println("FAIL " + label + " got=" + got.to_string() + " want=" + want.to_string());
    return false;
}

pub fn expect_true(label: String, cond: Bool) -> Bool {
    if cond { println("OK " + label); return true; }
    println("FAIL " + label);
    return false;
}

pub fn expect_false(label: String, cond: Bool) -> Bool {
    if !cond { println("OK " + label); return true; }
    println("FAIL " + label);
    return false;
}

pub fn main() {
    // VALID: byte_clamp - within range
    if !expect_eq_int("clamp 128", byte_clamp(128), 128) { return; }
    if !expect_eq_int("clamp 0", byte_clamp(0), 0) { return; }
    if !expect_eq_int("clamp 255", byte_clamp(255), 255) { return; }

    // VALID: byte_in_range - within range
    if !expect_true("in_range 0", byte_in_range(0)) { return; }
    if !expect_true("in_range 128", byte_in_range(128)) { return; }
    if !expect_true("in_range 255", byte_in_range(255)) { return; }

    // VALID: byte_len
    let s_hello: String = "hello";
    if !expect_eq_int("byte_len hello", byte_len(s_hello), 5) { return; }

    // VALID: byte_ord
    let s_a: String = "a";
    if !expect_eq_int("byte_ord a", byte_ord(s_a), 97) { return; }

    // VALID: byte_get
    let s_abc: String = "abc";
    if !expect_eq_int("byte_get abc[0]", byte_get(s_abc, 0), 97) { return; }
    if !expect_eq_int("byte_get abc[1]", byte_get(s_abc, 1), 98) { return; }
    if !expect_eq_int("byte_get abc[2]", byte_get(s_abc, 2), 99) { return; }

    // VALID: byte_sub
    let s_sub: String = byte_sub(s_abc, 1, 3);
    if !expect_eq_int("byte_sub len", byte_len(s_sub), 2) { return; }

    // VALID: byte_eq
    if !expect_true("byte_eq same", byte_eq(s_abc, "abc")) { return; }
    if !expect_false("byte_eq diff", byte_eq(s_abc, "xyz")) { return; }

    // NEGATIVE TRUST: Clamp boundary values
    if !expect_eq_int("clamp -1", byte_clamp(-1), 0) { return; }
    if !expect_eq_int("clamp 256", byte_clamp(256), 255) { return; }

    // NEGATIVE TRUST: Range boundary values
    if !expect_false("in_range -1", byte_in_range(-1)) { return; }
    if !expect_false("in_range 256", byte_in_range(256)) { return; }

    // ADVERSARIAL: Clamping extreme values
    if !expect_eq_int("clamp -1000000", byte_clamp(-1000000), 0) { return; }
    if !expect_eq_int("clamp 1000000", byte_clamp(1000000), 255) { return; }

    // ADVERSARIAL: Range extreme values
    if !expect_false("in_range -1000000", byte_in_range(-1000000)) { return; }
    if !expect_false("in_range 1000000", byte_in_range(1000000)) { return; }

    // ADVERSARIAL: Empty string
    let s_empty: String = "";
    if !expect_eq_int("byte_len empty", byte_len(s_empty), 0) { return; }
    if !expect_eq_int("byte_ord empty", byte_ord(s_empty), -1) { return; }

    // DOUBLE-RUN: Determinism check
    if !expect_eq_int("dr clamp 100", byte_clamp(100), byte_clamp(100)) { return; }
    if !expect_true("dr in_range 100", byte_in_range(100)) { return; }
    
    let s_dr: String = "test";
    if !expect_eq_int("dr byte_len", byte_len(s_dr), byte_len(s_dr)) { return; }

    println("OK: byte_smoke passed");
}
