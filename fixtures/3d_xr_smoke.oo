// # 3D XR Adversarial Smoke Test
//
// Logline: Verifies XR types and operations with adversarial inputs.
//
// Setup: Pure struct operations. No FS or net dependencies.
//
// Beats:
//   1. VALID: Normal XR creation and field access.
//   2. NEGATIVE TRUST: Test with zero and identity values.
//   3. ADVERSARIAL: Test with extreme values.
//   4. DOUBLE-RUN: Verify all operations are deterministic.

import "std/app/ui/3d/xr.oo";

pub fn expect_eq_int(label: String, got: Int, want: Int) -> Bool {
    if got == want { println("OK " + label); return true; }
    println("FAIL " + label + " got=" + got.to_string() + " want=" + want.to_string());
    return false;
}

pub fn main() {
    // Test marker function
    if !expect_eq_int("xr marker", xr_marker(), 1) { return; }
    if !expect_eq_int("xr_types marker", xr_types_marker(), 1) { return; }
    if !expect_eq_int("xr_ops marker", xr_ops_marker(), 1) { return; }

    println("OK: 3d_xr_smoke passed");
}
