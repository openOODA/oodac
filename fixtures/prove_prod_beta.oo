// # Product beta prove
//
// Logline: Fail-closed emit+gcc+run of shipped math_beta_inc_reg.
//
// Setup: Product std/math/special_beta.oo. Ix endpoints.
//
// Beats:
//   1. math_beta_inc_reg(1,1,0) is 0.0.
//   2. math_beta_inc_reg(1,1,1) is 1.0.
//   3. Exit 1 before PASSED on a miss.

import "std/core/math/special_beta.oo";

pub fn main() {
    let zr: Result[Float, String] = math_beta_inc_reg(1.0, 1.0, 0.0);
    match zr {
        Ok(z) => {
            if z != 0.0 {
                println("FAIL beta0");
                process_exit(1);
            }
        },
        Err(_) => {
            println("FAIL beta0");
            process_exit(1);
        }
    }
    let orr: Result[Float, String] = math_beta_inc_reg(1.0, 1.0, 1.0);
    match orr {
        Ok(o) => {
            if o != 1.0 {
                println("FAIL beta1");
                process_exit(1);
            }
        },
        Err(_) => {
            println("FAIL beta1");
            process_exit(1);
        }
    }
    println("prod_beta: PASSED");
}
