// # Secret prefix leak
//
// Logline: If an object is tainted, any field access under it must also be refused.
//
// Setup: A struct with a String field.
//
// Beats:
//   1. Mark the whole object as SECRET.
//   2. Print a field of that object.

pub type Box = struct { val: String };

// SECRET: user

pub fn main() {
    let user: Box = Box { val: "secret" };
    println(user.val);
}
