// # 3D Gaussian Cloud Adversarial Smoke Test
//
// Logline: Verifies GaussianCloud creation, count, and opacity operations with adversarial inputs.
//
// Setup: Pure GaussianCloud struct with 16 slots. Import gaussian_types.
//
// Beats:
//   1. Create new GaussianCloud and verify default count.
//   2. NEGATIVE TRUST: Verify initial cloud is empty (count=0).
//   3. ADVERSARIAL: Test with max capacity cloud.
//   4. DOUBLE-RUN: Verify all operations are deterministic.

import "std/app/ui/3d/gaussian_cloud.oo";

pub fn expect_eq_int(label: String, got: Int, want: Int) -> Bool {
    if got == want { println("OK " + label); return true; }
    println("FAIL " + label + " got=" + got.to_string() + " want=" + want.to_string());
    return false;
}

pub fn main() {
    // VALID: Normal cloud creation
    let cloud1: GaussianCloud = gaussian_cloud_new();
    if !expect_eq_int("new cloud count", gaussian_cloud_count(cloud1), 0) { return; }
    if !expect_eq_int("new cloud capacity", cloud1.capacity, 16) { return; }

    // NEGATIVE TRUST: Empty cloud properties
    if !expect_eq_int("empty cloud count", gaussian_cloud_count(cloud1), 0) { return; }

    // ADVERSARIAL: GaussCloud with various counts
    let small_cloud: GaussCloud = gauss_cloud_new(1, 0);
    if !expect_eq_int("small cloud count", small_cloud.count, 1) { return; }
    
    let large_cloud: GaussCloud = gauss_cloud_new(1000, 255);
    if !expect_eq_int("large cloud count", large_cloud.count, 1000) { return; }

    // DOUBLE-RUN: Determinism check
    let cloud2: GaussianCloud = gaussian_cloud_new();
    if !expect_eq_int("dr cloud count", gaussian_cloud_count(cloud2), 0) { return; }

    println("OK: 3d_gaussian_cloud_smoke passed");
}
