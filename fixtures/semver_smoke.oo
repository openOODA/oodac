// # Semver Adversarial Smoke Test
//
// Logline: Verifies semantic version parsing, comparison, and part extraction with adversarial inputs.
//
// Setup: Pure string parsing. No FS or net dependencies.
//
// Beats:
//   1. VALID: Test semver parsing and part extraction.
//   2. VALID: Test semver comparison.
//   3. NEGATIVE TRUST: Test with boundary values and edge cases.
//   4. ADVERSARIAL: Test with extreme and malformed inputs.
//   5. DOUBLE-RUN: Verify all operations are deterministic.

import "std/core/primitives/semver.oo";

pub fn expect_eq_int(label: String, got: Int, want: Int) -> Bool {
    if got == want { println("OK " + label); return true; }
    println("FAIL " + label + " got=" + got.to_string() + " want=" + want.to_string());
    return false;
}

pub fn expect_eq_str(label: String, got: String, want: String) -> Bool {
    if got == want { println("OK " + label); return true; }
    println("FAIL " + label + " got=" + got + " want=" + want);
    return false;
}

pub fn main() {
    // VALID: Test semver parsing
    let ver1: String = "1.2.3";
    let major1: String = semver_part(ver1, 0);
    let minor1: String = semver_part(ver1, 1);
    let patch1: String = semver_part(ver1, 2);
    if !expect_eq_str("major", major1, "1") { return; }
    if !expect_eq_str("minor", minor1, "2") { return; }
    if !expect_eq_str("patch", patch1, "3") { return; }
    
    // VALID: Test semver validity check
    let valid1: Bool = semver_is_valid(ver1);
    let is_valid1: Int = if valid1 { 1 } else { 0 };
    if !expect_eq_int("is valid 1.2.3", is_valid1, 1) { return; }
    
    let valid2: Bool = semver_is_valid("invalid");
    let is_valid2: Int = if valid2 { 1 } else { 0 };
    if !expect_eq_int("is valid invalid", is_valid2, 0) { return; }
    
    // VALID: Test semver major, minor, patch extractors
    let major2: String = semver_major(ver1);
    let minor2: String = semver_minor(ver1);
    let patch2: String = semver_patch(ver1);
    if !expect_eq_str("major func", major2, "1") { return; }
    if !expect_eq_str("minor func", minor2, "2") { return; }
    if !expect_eq_str("patch func", patch2, "3") { return; }
    
    // VALID: Test semver parsing with scan_num
    let scan1: Int = semver_scan_num("123", 0, 3);
    if !expect_eq_int("scan 123", scan1, 3) { return; }
    
    let scan2: Int = semver_scan_num("0123", 0, 4);
    if !expect_eq_int("scan 0123 invalid", scan2, -1) { return; }
    
    // NEGATIVE TRUST: Boundary values
    let ver_zero: String = "0.0.0";
    let major_zero: String = semver_part(ver_zero, 0);
    let minor_zero: String = semver_part(ver_zero, 1);
    let patch_zero: String = semver_part(ver_zero, 2);
    if !expect_eq_str("zero major", major_zero, "0") { return; }
    if !expect_eq_str("zero minor", minor_zero, "0") { return; }
    if !expect_eq_str("zero patch", patch_zero, "0") { return; }
    
    let valid_zero: Bool = semver_is_valid(ver_zero);
    if !expect_eq_int("is valid zero", if valid_zero { 1 } else { 0 }, 1) { return; }
    
    // ADVERSARIAL: Extreme values
    let ver_large: String = "999999.999999.999999";
    let major_large: String = semver_major(ver_large);
    if !expect_eq_str("large major", major_large, "999999") { return; }
    
    // ADVERSARIAL: Malformed inputs
    let scan_invalid: Int = semver_scan_num("abc", 0, 3);
    if !expect_eq_int("scan abc invalid", scan_invalid, -1) { return; }
    
    let part_invalid: String = semver_part("", 0);
    if !expect_eq_str("part empty", part_invalid, "") { return; }
    
    let valid_invalid: Bool = semver_is_valid("");
    let is_valid_invalid: Int = if valid_invalid { 1 } else { 0 };
    if !expect_eq_int("is valid empty", is_valid_invalid, 0) { return; }
    
    // DOUBLE-RUN: Determinism
    let ver_dr: String = "1.2.3";
    let major_dr1: String = semver_major(ver_dr);
    let major_dr2: String = semver_major(ver_dr);
    if !expect_eq_str("dr major", major_dr1, major_dr2) { return; }
    
    let valid_dr1: Bool = semver_is_valid(ver_dr);
    let valid_dr2: Bool = semver_is_valid(ver_dr);
    if !expect_eq_int("dr valid", if valid_dr1 { 1 } else { 0 }, if valid_dr2 { 1 } else { 0 }) { return; }
    
    println("OK: semver_smoke passed");
}
