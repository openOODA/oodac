// # Secret prefix pass
//
// Logline: A non-secret object may print its field.
//
// Setup: A struct with a String field.
//
// Beats:
//   1. No SECRET directive.
//   2. Print a field of that object.

pub type Box = struct { val: String };

pub fn main() {
    let user: Box = Box { val: "public" };
    println(user.val);
}
