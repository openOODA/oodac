// # Merkle Patricia Trie Insert Smoke
//
// Logline: Verifies std/crypto/zk_rollup/merkle_patricia_trie_insert.mpt_insert_leaf_into_empty computes a deterministic new root for an empty-to-leaf insert.
//
// Setup: Imports std/crypto/zk_rollup/merkle_patricia_trie_insert.oo. Pure, no FS or net. Property test (PROP) on the empty-root case from the audit's spec.
//
// Beats:
//   1. mpt_insert_request_new(key=0xab, value=0x01).
//   2. mpt_insert_leaf_into_empty returns new_root = mix(mix(1, 0xab), 0x01) and nodes_created = 1.
//   3. Repeat the insert; assert same new_root (determinism).
//   4. Print MPT_PROP_OK on success.

import "std/sec/zk/merkle_patricia_trie_insert.oo";

pub fn main() {
    let req1: MptInsertRequest = mpt_insert_request_new(171, 1);
    let res1: MptInsertResult = mpt_insert_leaf_into_empty(req1);
    let req2: MptInsertRequest = mpt_insert_request_new(171, 1);
    let res2: MptInsertResult = mpt_insert_leaf_into_empty(req2);
    let r1: Int = res1.new_root;
    let r2: Int = res2.new_root;
    if r1 != r2 {
        println("FAIL mpt non-deterministic");
        return;
    }
    if r1 == 0 {
        println("FAIL mpt root");
        return;
    }
    println("MPT_PROP_OK");
}
