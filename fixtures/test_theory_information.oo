// # Information theory: entropy, KL divergence, and Landauer bound
//
// Logline: Verify Shannon entropy of fair/unfair coins, KL divergence of matching distributions is 0, and the Landauer lower bound at room temperature.
//
// Setup: Pure in-fixture re-declaration. No std import required.
//
// Beats:
//   1. H(fair coin) = ln(2) nats.
//   2. H(certain event) = 0.
//   3. Mutual information is non-negative for a valid joint.
//   4. KL(P || P) = 0.
//   5. Gibbs inequality: KL(P || Q) >= 0.
//   6. Landauer per bit at 300 K >= kB * 300 * ln(2) joules.
//   7. Channel capacity at 1 W and 300 K is positive and within expected order.

pub fn shannon_entropy(probs: List[Float]) -> Float {
    let n: Int = list_len(probs);
    if n == 0 {
        return 0.0;
    }
    let mut h: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let p: Float = list_get(probs, i);
        if p > 0.0 {
            h = h + (0.0 - p * ln(p));
        }
        i = i + 1;
    }
    return h;
}

pub fn kl_divergence(p: List[Float], q: List[Float]) -> Float {
    let n_p: Int = list_len(p);
    let n_q: Int = list_len(q);
    let mut n: Int = n_p;
    if n_q < n {
        n = n_q;
    }
    if n == 0 {
        return 0.0;
    }
    let mut d: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let pi: Float = list_get(p, i);
        let qi: Float = list_get(q, i);
        if pi > 0.0 {
            if qi <= 0.0 {
                return 10000000000.0;
            }
            d = d + pi * ln(pi / qi);
        }
        i = i + 1;
    }
    return d;
}

pub fn cross_entropy(p: List[Float], q: List[Float]) -> Float {
    let n_p: Int = list_len(p);
    let n_q: Int = list_len(q);
    let mut n: Int = n_p;
    if n_q < n {
        n = n_q;
    }
    if n == 0 {
        return 0.0;
    }
    let mut h: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let pi: Float = list_get(p, i);
        let qi: Float = list_get(q, i);
        if pi > 0.0 {
            if qi <= 0.0 {
                return 10000000000.0;
            }
            h = h + (0.0 - pi * ln(qi));
        }
        i = i + 1;
    }
    return h;
}

pub fn mutual_information(hx: Float, hy: Float, hxy: Float) -> Float {
    let mi: Float = hx + hy - hxy;
    if mi < 0.0 {
        return 0.0;
    }
    return mi;
}

pub fn k_B() -> Float {
    return 0.000000000000000000000000001380649;
}

pub fn landauer_per_bit(t_kelvin: Float) -> Float {
    if t_kelvin < 0.0 {
        return 0.0;
    }
    let ln2: Float = 0.6931471805599453;
    return k_B() * t_kelvin * ln2;
}

pub fn approx_eq(a: Float, b: Float, tol: Float) -> Bool {
    let diff: Float = a - b;
    if diff < 0.0 {
        let pos: Float = 0.0 - diff;
        if pos <= tol {
            return true;
        }
    } else {
        if diff <= tol {
            return true;
        }
    }
    return false;
}

pub fn main() {
    let mut fair: List[Float] = list_new();
    fair = list_push(fair, 0.5);
    fair = list_push(fair, 0.5);
    let h_fair: Float = shannon_entropy(fair);
    if approx_eq(h_fair, 0.6931471805599453, 0.0001) {
        println("OK h_fair_coin_equals_ln2");
    } else {
        println("FAIL h_fair_coin");
        process_exit(1);
    }

    let mut certain: List[Float] = list_new();
    certain = list_push(certain, 1.0);
    let h_certain: Float = shannon_entropy(certain);
    if approx_eq(h_certain, 0.0, 0.0001) {
        println("OK h_certain_event_zero");
    } else {
        println("FAIL h_certain_event");
        process_exit(1);
    }

    let mut p: List[Float] = list_new();
    p = list_push(p, 0.5);
    p = list_push(p, 0.5);
    let kl_pp: Float = kl_divergence(p, p);
    if approx_eq(kl_pp, 0.0, 0.0001) {
        println("OK kl_pp_zero");
    } else {
        println("FAIL kl_pp");
        process_exit(1);
    }

    let mut q: List[Float] = list_new();
    q = list_push(q, 0.3);
    q = list_push(q, 0.7);
    let kl_pq: Float = kl_divergence(p, q);
    if kl_pq >= 0.0 {
        println("OK gibbs_inequality_kl_non_negative");
    } else {
        println("FAIL gibbs_inequality");
        process_exit(1);
    }

    let ce: Float = cross_entropy(p, p);
    let h: Float = shannon_entropy(p);
    if approx_eq(ce, h, 0.0001) {
        println("OK cross_entropy_self_equals_entropy");
    } else {
        println("FAIL cross_entropy_self");
        process_exit(1);
    }

    let h_x: Float = shannon_entropy(fair);
    let h_y: Float = shannon_entropy(fair);
    let mut joint: List[Float] = list_new();
    joint = list_push(joint, 0.25);
    joint = list_push(joint, 0.25);
    joint = list_push(joint, 0.25);
    joint = list_push(joint, 0.25);
    let h_xy: Float = shannon_entropy(joint);
    let mi: Float = mutual_information(h_x, h_y, h_xy);
    if mi >= 0.0 {
        println("OK mutual_information_non_negative");
    } else {
        println("FAIL mutual_information");
        process_exit(1);
    }

    let t: Float = 300.0;
    let per_bit: Float = landauer_per_bit(t);
    let k: Float = k_B();
    let ln2: Float = 0.6931471805599453;
    let expected: Float = k * 300.0 * ln2;
    if per_bit > 0.0 {
        if approx_eq(per_bit, expected, 0.0000000000000000000000000001) {
            println("OK landauer_per_bit_at_300K");
        } else {
            println("FAIL landauer_per_bit");
            process_exit(1);
        }
    } else {
        println("FAIL landauer_per_bit_non_positive");
        process_exit(1);
    }

    println("test_theory_information: PASSED");
}
