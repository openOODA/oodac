// # Product prove std/phys/astrodynamics/rocket_tsiolkovsky.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/phys/astrodynamics/rocket_tsiolkovsky.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/phys/astrodynamics/rocket_tsiolkovsky.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rocket_tsiolkovsky: PASSED only if they match.

import "std/science/phys/relativistic/rocket_tsiolkovsky.oo";

pub fn main() {
    let rocket_tsiolkovsky_a = tsiolkovsky_g0();
    let rocket_tsiolkovsky_b = tsiolkovsky_g0();
    if rocket_tsiolkovsky_a != rocket_tsiolkovsky_b {
        println("FAIL rocket_tsiolkovsky");
        process_exit(1);
    }
    println("prod_ap_rocket_tsiolkovsky: PASSED");
}
