// # Shamir 3-of-5 Secret Share Roundtrip Smoke
//
// Logline: Verifies std/crypto/advanced/shamir_secret.shamir_secret_split and shamir_secret_recover return the original secret bytes from a 3-of-5 quorum share set.
//
// Setup: Imports std/crypto/advanced/shamir_secret.oo. Pure, no FS or net. Property test (PROP) of the split/recover cycle over a 4-byte secret.
//
// Beats:
//   1. Split the 4-byte secret [10,20,30,40] into 5 shares with threshold 3 (seed=42).
//   2. Recover from the 5-share pack.
//   3. Assert recovered_len = 4 and recovered[0..3] = [10,20,30,40].
//   4. Print SHAMIR_PROP_OK on success.

import "std/sec/mac/shamir_secret.oo";

pub fn main() {
    let mut secret: List[Int] = list_new();
    secret = list_push(secret, 10);
    secret = list_push(secret, 20);
    secret = list_push(secret, 30);
    secret = list_push(secret, 40);
    let shares_res: Result[List[Int], String] = shamir_secret_split(secret, 3, 5, 42);
    let mut shares: List[Int] = list_new();
    match shares_res {
        Ok(s) => { shares = s; }
        Err(e) => { println("FAIL split " + e); return; }
    };
    let rec_res: Result[List[Int], String] = shamir_secret_recover(shares, 5);
    let mut rec: List[Int] = list_new();
    match rec_res {
        Ok(r) => { rec = r; }
        Err(e) => { println("FAIL recover " + e); return; }
    };
    let rlen: Int = rec.len();
    if rlen != 4 {
        println("FAIL length");
        return;
    }
    if list_get(rec, 0) != 10 {
        println("FAIL byte0");
        return;
    }
    if list_get(rec, 1) != 20 {
        println("FAIL byte1");
        return;
    }
    if list_get(rec, 2) != 30 {
        println("FAIL byte2");
        return;
    }
    if list_get(rec, 3) != 40 {
        println("FAIL byte3");
        return;
    }
    println("SHAMIR_PROP_OK");
}
