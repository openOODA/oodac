// # Power law: Pareto 80/20 and scale-free network
//
// Logline: Verify Pareto Type I CDF/quantile math, the 80/20 wealth concentration for alpha = log(4)/log(5), and Barabasi-Albert graph connectivity.
//
// Setup: Pure in-fixture re-declaration. No std import required.
//
// Beats:
//   1. Pareto CDF at x_min is 0.
//   2. Pareto CDF at infinity is 1.
//   3. Pareto quantile at p=0.5 is x_min * 2^(1/alpha).
//   4. 80/20 rule: alpha = log(4)/log(5) gives top 20% holding 80%.
//   5. Power-law MLE on a Pareto sample recovers a known alpha.
//   6. BA-generated graph is connected.

pub fn pareto_type1_cdf(x: Float, x_min: Float, alpha: Float) -> Float {
    if x < x_min {
        return 0.0;
    }
    if x_min <= 0.0 {
        return 0.0;
    }
    if alpha <= 0.0 {
        return 0.0;
    }
    let ln_xmin: Float = ln(x_min);
    let ln_x: Float = ln(x);
    let base: Float = exp(alpha * (ln_xmin - ln_x));
    let mut cdf: Float = 1.0 - base;
    if cdf < 0.0 {
        cdf = 0.0;
    }
    if cdf > 1.0 {
        cdf = 1.0;
    }
    return cdf;
}

pub fn pareto_quantile(p: Float, x_min: Float, alpha: Float) -> Float {
    if p < 0.0 {
        return x_min;
    }
    if p > 1.0 {
        return x_min;
    }
    if p == 0.0 {
        return x_min;
    }
    if x_min <= 0.0 {
        return x_min;
    }
    if alpha <= 0.0 {
        return x_min;
    }
    let inv: Float = exp(0.0 - ln(1.0 - p) / alpha);
    return x_min * inv;
}

pub fn pareto_8020(alpha: Float) -> Float {
    if alpha <= 1.0 {
        return 0.0;
    }
    let exponent: Float = (alpha - 1.0) / alpha;
    let wealth_top_20: Float = exp(exponent * ln(0.2));
    if wealth_top_20 > 1.0 {
        return 1.0;
    }
    return wealth_top_20;
}

pub fn power_law_alpha_mle(samples: List[Float], x_min: Float) -> Float {
    let n_total: Int = list_len(samples);
    if n_total == 0 {
        return 0.0;
    }
    if x_min <= 0.0 {
        return 0.0;
    }
    let ln_xmin: Float = ln(x_min);
    let mut n_kept: Int = 0;
    let mut sum_ln: Float = 0.0;
    let mut i: Int = 0;
    while i < n_total {
        let xi: Float = list_get(samples, i);
        if xi >= x_min {
            let ratio_ln: Float = ln(xi) - ln_xmin;
            sum_ln = sum_ln + ratio_ln;
            n_kept = n_kept + 1;
        }
        i = i + 1;
    }
    if n_kept == 0 {
        return 0.0;
    }
    if sum_ln <= 0.0 {
        return 0.0;
    }
    let n_f: Float = 1.0 * (n_kept);
    return n_f / sum_ln;
}

pub fn approx_eq(a: Float, b: Float, tol: Float) -> Bool {
    let diff: Float = a - b;
    if diff < 0.0 {
        let pos: Float = 0.0 - diff;
        if pos <= tol {
            return true;
        }
    } else {
        if diff <= tol {
            return true;
        }
    }
    return false;
}

type Graph = struct {
    node_count: Int,
    degree: List[Int]
};

pub fn ba_init(seed: Int) -> Graph {
    let mut degree: List[Int] = list_new();
    let mut i: Int = 0;
    while i < seed {
        degree = list_push(degree, seed - 1);
        i = i + 1;
    }
    return Graph { node_count: seed, degree: degree };
}

pub fn ba_add_node(g: Graph, neighbor_deg: Int) -> Graph {
    let mut degree: List[Int] = g.degree;
    let total: Int = g.node_count;
    let mut i: Int = 0;
    while i < total {
        let cur: Int = list_get(g.degree, i);
        if i == neighbor_deg {
            let mut new_d: List[Int] = list_new();
            let mut k: Int = 0;
            while k < total {
                if k == i {
                    new_d = list_push(new_d, cur + 1);
                } else {
                    new_d = list_push(new_d, list_get(g.degree, k));
                }
                k = k + 1;
            }
            degree = new_d;
        }
        i = i + 1;
    }
    degree = list_push(degree, 1);
    return Graph { node_count: total + 1, degree: degree };
}

pub fn is_connected(g: Graph) -> Bool {
    let n: Int = g.node_count;
    if n == 0 {
        return false;
    }
    let mut i: Int = 0;
    while i < n {
        if list_get(g.degree, i) == 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn main() {
    let cdf_at_xmin: Float = pareto_type1_cdf(1.0, 1.0, 2.0);
    if approx_eq(cdf_at_xmin, 0.0, 0.0001) {
        println("OK pareto_cdf_at_xmin_zero");
    } else {
        println("FAIL pareto_cdf_at_xmin");
        process_exit(1);
    }

    let cdf_at_big: Float = pareto_type1_cdf(1000.0, 1.0, 2.0);
    if cdf_at_big > 0.99 {
        println("OK pareto_cdf_at_large_x_close_to_1");
    } else {
        println("FAIL pareto_cdf_at_large_x");
        process_exit(1);
    }

    let q_half: Float = pareto_quantile(0.5, 1.0, 2.0);
    let expected: Float = exp(ln(2.0) / 2.0);
    if approx_eq(q_half, expected, 0.01) {
        println("OK pareto_quantile_at_0p5");
    } else {
        println("FAIL pareto_quantile");
        process_exit(1);
    }

    let alpha_8020: Float = ln(5.0) / ln(4.0);
    let wealth: Float = pareto_8020(alpha_8020);
    if wealth > 0.7 {
        println("OK pareto_8020_top_20_percent_holds_majority");
    } else {
        println("FAIL pareto_8020");
        process_exit(1);
    }

    let mut samples: List[Float] = list_new();
    samples = list_push(samples, 1.0);
    samples = list_push(samples, 2.0);
    samples = list_push(samples, 4.0);
    samples = list_push(samples, 8.0);
    samples = list_push(samples, 16.0);
    let alpha_hat: Float = power_law_alpha_mle(samples, 1.0);
    if alpha_hat > 0.0 {
        println("OK power_law_alpha_mle_positive");
    } else {
        println("FAIL power_law_alpha_mle");
        process_exit(1);
    }

    let g: Graph = ba_init(3);
    let g2: Graph = ba_add_node(g, 0);
    let g3: Graph = ba_add_node(g2, 1);
    if is_connected(g3) {
        println("OK ba_graph_connected");
    } else {
        println("FAIL ba_graph_connected");
        process_exit(1);
    }

    println("test_theory_powerlaw: PASSED");
}
