// # Product prove std/phys/astro_advanced/deep_space_optical_comm.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/phys/astro_advanced/deep_space_optical_comm.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/phys/astro_advanced/deep_space_optical_comm.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_deep_space_optical_comm: PASSED only if they match.

import "std/science/phys/relativistic/deep_space_optical_comm.oo";

pub fn main() {
    let deep_space_optical_comm_a = optcomm_wavelength_nm();
    let deep_space_optical_comm_b = optcomm_wavelength_nm();
    if deep_space_optical_comm_a != deep_space_optical_comm_b {
        println("FAIL deep_space_optical_comm");
        process_exit(1);
    }
    println("prod_ap_deep_space_optical_comm: PASSED");
}
