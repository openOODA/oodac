// # Product prove std/phys/astrodynamics/sgp4_propagator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/phys/astrodynamics/sgp4_propagator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/phys/astrodynamics/sgp4_propagator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_sgp4_propagator: PASSED only if they match.

import "std/science/phys/relativistic/sgp4_propagator.oo";

pub fn main() {
    let sgp4_propagator_a = sgp4_minutes();
    let sgp4_propagator_b = sgp4_minutes();
    if sgp4_propagator_a != sgp4_propagator_b {
        println("FAIL sgp4_propagator");
        process_exit(1);
    }
    println("prod_ap_sgp4_propagator: PASSED");
}
