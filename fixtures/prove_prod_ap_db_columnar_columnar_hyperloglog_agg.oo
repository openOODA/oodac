// # Product prove std/data/columnar/columnar_hyperloglog_agg.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/data/columnar/columnar_hyperloglog_agg.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/data/columnar/columnar_hyperloglog_agg.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_columnar_hyperloglog_agg: PASSED only if they match.

import "std/app/data/columnar/columnar_hyperloglog_agg.oo";

pub fn main() {
    let columnar_hyperloglog_agg_a = hll_calc_rho(0);
    let columnar_hyperloglog_agg_b = hll_calc_rho(0);
    if columnar_hyperloglog_agg_a != columnar_hyperloglog_agg_b {
        println("FAIL columnar_hyperloglog_agg");
        process_exit(1);
    }
    println("prod_ap_columnar_hyperloglog_agg: PASSED");
}
