// # SHA-1 KAT smoke
//
// Logline: Asserts std/hash/sha1.oo sha1 matches the published RFC 3174 test vectors for empty, "abc", and the long abc-block.
//
// Setup: Imports std/hash/sha1.oo. Pure; backed by crypto_sha1_internal.
//
// Beats:
//   1. sha1("") = "da39a3ee5e6b4b0d3255bfef95601890afd80709".
//   2. sha1("abc") = "a9993e364706816aba3e25717850c26c9cd0d89d".
//   3. sha1 of the 448-bit abc-block = "84983e441c3bd26ebaae4aa1f95129e5e54670f1".
//   4. SHA1_OK on success.

import "std/hash/sha1.oo";

pub fn expect_eq_str(label: String, got: String, want: String) -> Bool {
    if got == want { println("OK " + label); return true; }
    println("FAIL " + label + " got=" + got + " want=" + want);
    return false;
}

pub fn main() {
    let h0: String = sha1("");
    if !expect_eq_str("sha1(\"\")", h0, "da39a3ee5e6b4b0d3255bfef95601890afd80709") { return; }

    let h1: String = sha1("abc");
    if !expect_eq_str("sha1(\"abc\")", h1, "a9993e364706816aba3e25717850c26c9cd0d89d") { return; }

    // RFC 3174 §7.1 TEST2: 56-byte block "abcdbcde...nopq".
    let h2: String = sha1("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq");
    if !expect_eq_str("sha1(rfc3174 test2)", h2, "84983e441c3bd26ebaae4aa1f95129e5e54670f1") { return; }

    // "The quick brown fox jumps over the lazy dog" — common cross-check vector.
    let h3: String = sha1("The quick brown fox jumps over the lazy dog");
    if !expect_eq_str("sha1(quick fox)", h3, "2fd4e1c67a2d28fced849ee1bb76e7391b93eb12") { return; }

    // Determinism: two independent calls produce the same digest.
    let h4a: String = sha1("abc");
    let h4b: String = sha1("abc");
    if !expect_eq_str("sha1(\"abc\") deterministic", h4a, h4b) { return; }

    // Result is always 40 lowercase hex chars.
    if !expect_eq_str("sha1(\"\") length 40", h0.len().to_string(), "40") { return; }
    if !expect_eq_str("sha1(\"abc\") length 40", h1.len().to_string(), "40") { return; }

    println("SHA1_OK");
}
