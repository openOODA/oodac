// # Wasm GC compacting collector smoke (PROP — re-declared surface)
//
// Logline: Re-declares the CompactObject / CompactingHeap surface from std/compile/wasm_gc/wasm_gc_compacting.oo in the fixture and exercises the documented forwarding-offset invariant (PROP: live objects pack at the head of the heap).
//
// Setup: Pure in-fixture re-declaration (RESIDUAL: std/compile/wasm_gc/wasm_gc_compacting.oo has a pre-existing `mut` bug at line 58 — `heap.objects = os;` fails because the mut qualifier does not propagate to struct field assignment).
//
// Beats:
//   1. compact_object_new sets forwarding_offset = -1 (unforwarded).
//   2. compacting_heap_new has object_count=0, heap_size_bytes preserved.
//   3. After heap_add(o1)+heap_add(o2)+compute_forwarding: o1.forwarding_offset=0, o2.forwarding_offset=o1.size_bytes.
//   4. Print WASM_GC_WASM_GC_COMPACTING_PROP_OK on success.

type CompactObject = struct {
    object_id: Int,
    current_offset: Int,
    forwarding_offset: Int,
    size_bytes: Int,
    is_live: Int
};

type CompactingHeap = struct {
    objects: List[CompactObject],
    object_count: Int,
    heap_size_bytes: Int,
    compacted_free_offset: Int
};

pub fn compact_object_new(id: Int, curr_off: Int, sz: Int, live: Int) -> CompactObject {
    return CompactObject {
        object_id: id,
        current_offset: curr_off,
        forwarding_offset: -1,
        size_bytes: sz,
        is_live: live
    };
}

pub fn compacting_heap_new(heap_sz: Int) -> CompactingHeap {
    let empty_objs: List[CompactObject] = list_new();
    return CompactingHeap {
        objects: empty_objs,
        object_count: 0,
        heap_size_bytes: heap_sz,
        compacted_free_offset: 0
    };
}

pub fn compacting_heap_add(heap: CompactingHeap, obj: CompactObject) -> CompactingHeap {
    let mut h: CompactingHeap = heap;
    let os: List[CompactObject] = list_push(h.objects, obj);
    h.objects = os;
    h.object_count = h.object_count + 1;
    return h;
}

pub fn compacting_heap_compute_forwarding(heap: CompactingHeap) -> CompactingHeap {
    let mut h: CompactingHeap = heap;
    let mut next_free: Int = 0;
    let mut new_objs: List[CompactObject] = list_new();
    let mut i: Int = 0;
    let count: Int = h.object_count;
    while i < count {
        let obj: CompactObject = list_get(h.objects, i);
        if obj.is_live == 1 {
            let updated: CompactObject = CompactObject {
                object_id: obj.object_id,
                current_offset: obj.current_offset,
                forwarding_offset: next_free,
                size_bytes: obj.size_bytes,
                is_live: 1
            };
            new_objs = list_push(new_objs, updated);
            next_free = next_free + obj.size_bytes;
        } else {
            new_objs = list_push(new_objs, obj);
        }
        i = i + 1;
    }
    h.objects = new_objs;
    h.compacted_free_offset = next_free;
    return h;
}

pub fn main() {
    // Beat 1: fresh object — unforwarded.
    let o1: CompactObject = compact_object_new(1, 0, 64, 1);
    let fwd_init: Int = o1.forwarding_offset;
    if fwd_init != -1 {
        println("FAIL fwd_init");
        return;
    }
    if o1.size_bytes != 64 {
        println("FAIL sz_init");
        return;
    }
    println("OK compact_object_new");

    // Beat 2: fresh heap.
    let mut h: CompactingHeap = compacting_heap_new(4096);
    if h.object_count != 0 {
        println("FAIL heap_count_init");
        return;
    }
    if h.heap_size_bytes != 4096 {
        println("FAIL heap_size_init");
        return;
    }
    println("OK compacting_heap_new");

    // Beat 3: add two live objects and compute forwarding.
    let o2: CompactObject = compact_object_new(2, 128, 32, 1);
    h = compacting_heap_add(h, o1);
    h = compacting_heap_add(h, o2);
    if h.object_count != 2 {
        println("FAIL heap_count_after_add");
        return;
    }
    h = compacting_heap_compute_forwarding(h);
    let fwd0: Int = list_get(h.objects, 0).forwarding_offset;
    let fwd1: Int = list_get(h.objects, 1).forwarding_offset;
    if fwd0 != 0 {
        println("FAIL fwd0");
        return;
    }
    if fwd1 != 64 {
        println("FAIL fwd1: " + fwd1.to_string());
        return;
    }
    if h.compacted_free_offset != 96 {
        println("FAIL compacted_free");
        return;
    }
    println("OK forwarding_layout");

    println("WASM_GC_WASM_GC_COMPACTING_PROP_OK");
    println("OK");
}
