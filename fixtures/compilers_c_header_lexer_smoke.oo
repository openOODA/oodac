// # C header lexer smoke (PROP round-trip)
//
// Logline: Asserts std/compile/compilers/c_header_lexer.c_token_new + c_tok_eof + c_tok_kw_typedef return the documented token-kind codes and that c_lexer_punct_kind classifies known punctuation.
//
// Setup: Imports std/compile/compilers/c_header_lexer.oo. Pure (no FS).
//
// Beats:
//   1. c_tok_eof() == 0.
//   2. c_tok_ident() == 1.
//   3. c_tok_kw_typedef() != c_tok_kw_struct() (keyword codes distinct).
//   4. c_lexer_punct_kind(ord(';')) != 0 (recognizes ';' as a punctuation).
//   5. c_token_new(kind, line, col, ch) round-trips fields.
//   6. Print COMPILERS_C_HEADER_LEXER_PROP_OK on success.

import "std/compile/compilers/c_header_lexer.oo";

pub fn main() {
    // Beat 1: c_tok_eof.
    if c_tok_eof() != 0 {
        println("FAIL tok_eof");
        return;
    }
    println("OK c_tok_eof");

    // Beat 2: c_tok_ident.
    if c_tok_ident() != 1 {
        println("FAIL tok_ident");
        return;
    }
    println("OK c_tok_ident");

    // Beat 3: distinct keyword codes.
    if c_tok_kw_typedef() == c_tok_kw_struct() {
        println("FAIL kw_codes_not_distinct");
        return;
    }
    if c_tok_kw_struct() == c_tok_kw_const() {
        println("FAIL kw_codes_struct_const");
        return;
    }
    println("OK kw_distinct");

    // Beat 4: punct kind.
    let p: Int = c_lexer_punct_kind(ord(";"));
    if p == 0 {
        println("FAIL punct_kind");
        return;
    }
    println("OK c_lexer_punct_kind");

    // Beat 5: token round-trip.
    let t: CToken = c_token_new(1, 2, 3, 65);
    if t.kind != 1 || t.line != 2 || t.col != 3 || t.ch != 65 {
        println("FAIL token_new_round_trip");
        return;
    }
    println("OK c_token_new");

    println("COMPILERS_C_HEADER_LEXER_PROP_OK");
    println("OK");
}
