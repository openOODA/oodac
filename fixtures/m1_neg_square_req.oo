// # Negative Test: Unsatisfiable Square Requires
//
// Logline: Fails closed when requires specifies an impossible negative square.
//
// Setup: Pure .oo test for fail-closed SMT refusal.
//
// Beats:
//   1. Function invalid requires x * x < 0.
//   2. Compiler refuses with ERR smt unsat requires.
//   3. Process exits with code 1.

pub fn invalid(x: Int) -> Int
    requires x * x < 0
{
    return x;
}

pub fn main() {
    println(invalid(5));
}
