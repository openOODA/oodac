// # Negative Test: Unsatisfiable Ensures Polynomial Contradiction
//
// Logline: Fails closed when ensures specifies an impossible polynomial bound.
//
// Setup: Pure .oo test for fail-closed SMT refusal on ensures contract.
//
// Beats:
//   1. Function invalid requires a >= 3 && a <= 5, b >= 4 && b <= 6.
//   2. Function invalid ensures result * result < 0.
//   3. Compiler refuses with ERR smt unsat ensures at 16:5.

pub fn invalid(a: Int, b: Int) -> Int
    requires a >= 3 && a <= 5
    requires b >= 4 && b <= 6
    ensures result * result < 0
{
    return a * b;
}

pub fn main() {
    println(invalid(3, 4));
}
