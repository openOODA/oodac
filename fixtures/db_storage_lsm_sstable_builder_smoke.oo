// # LSM SSTable builder smoke (RESIDUAL — source has pre-existing type bug)
//
// Logline: Re-declares the SSTableBuilder / BlockHandle surface from std/data/storage/lsm_sstable_builder.oo in the fixture and verifies the documented invariants.
//
// Setup: Pure in-fixture re-declaration (RESIDUAL: importing the real std/data/storage/lsm_sstable_builder.oo triggers a pre-existing type error at line 99 in sstable_builder_add: `next_block_bytes >= b.block_size_limit` is mis-typed as Int vs SSTableBuilder).
//
// Beats:
//   1. sstable_builder_new sets total_entries=0, is_finished=false, block_size_limit preserved.
//   2. block_handle_new(off, sz) round-trips fields.
//   3. Print DB_STORAGE_LSM_SSTABLE_BUILDER_RT_OK on success.

type BlockHandle = struct {
    offset: Int,
    size: Int
};

type SSTableIndexEntry = struct {
    last_key: String,
    handle: BlockHandle
};

type SSTableFooter = struct {
    index_handle: BlockHandle,
    filter_handle: BlockHandle,
    meta_index_handle: BlockHandle,
    magic_number: Int
};

type SSTableBuilder = struct {
    file_id: Int,
    block_size_limit: Int,
    current_block_bytes: Int,
    current_keys: List[String],
    current_values: List[String],
    index_entries: List[SSTableIndexEntry],
    smallest_key: String,
    largest_key: String,
    total_entries: Int,
    total_file_bytes: Int,
    is_finished: Bool
};

pub fn block_handle_new(off: Int, sz: Int) -> BlockHandle {
    return BlockHandle {
        offset: off,
        size: sz
    };
}

pub fn sstable_builder_new(fid: Int, block_limit: Int) -> SSTableBuilder {
    let empty_keys: List[String] = list_new();
    let empty_vals: List[String] = list_new();
    let empty_idx: List[SSTableIndexEntry] = list_new();
    return SSTableBuilder {
        file_id: fid,
        block_size_limit: block_limit,
        current_block_bytes: 0,
        current_keys: empty_keys,
        current_values: empty_vals,
        index_entries: empty_idx,
        smallest_key: "",
        largest_key: "",
        total_entries: 0,
        total_file_bytes: 0,
        is_finished: false
    };
}

pub fn main() {
    // Beat 1: fresh builder.
    let b: SSTableBuilder = sstable_builder_new(7, 4096);
    let fid: Int = b.file_id;
    let bsz: Int = b.block_size_limit;
    let tentries: Int = b.total_entries;
    if tentries != 0 {
        println("FAIL b_total_entries_init");
        return;
    }
    if b.is_finished {
        println("FAIL b_finished_init");
        return;
    }
    if fid != 7 {
        println("FAIL b_file_id");
        return;
    }
    if bsz != 4096 {
        println("FAIL b_block_size_limit");
        return;
    }
    println("OK sstable_builder_new");

    // Beat 2: block_handle_new round-trips.
    let h: BlockHandle = block_handle_new(1024, 256);
    let hoff: Int = h.offset;
    let hsz: Int = h.size;
    if hoff != 1024 {
        println("FAIL handle_offset");
        return;
    }
    if hsz != 256 {
        println("FAIL handle_size");
        return;
    }
    println("OK block_handle_new");

    println("DB_STORAGE_LSM_SSTABLE_BUILDER_RT_OK");
    println("OK");
}
