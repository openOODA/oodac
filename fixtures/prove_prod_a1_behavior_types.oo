// # Product prove std/robot/auto/behavior_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts behavior_types_marker is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/auto/behavior_types.oo.
//
// Beats:
//   1. Call behavior_types_marker twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_behavior_types: PASSED only if they match.

import "std/app/robot/auto/behavior_types.oo";

pub fn main() {
    let a: Int = behavior_types_marker();
    let b: Int = behavior_types_marker();
    if a != b {
        println("FAIL behavior_types_marker");
        process_exit(1);
    }
    println("prod_behavior_types: PASSED");
}
