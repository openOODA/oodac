// # Product prove std/phys/astrodynamics/tle_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts tle_line_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/phys/astrodynamics/tle_parser.oo.
//
// Beats:
//   1. Call tle_line_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tle_parser: PASSED only if they match.

import "std/science/phys/relativistic/tle_parser.oo";

pub fn main() {
    let tle_parser_mark: Int = 0;
    if tle_parser_mark != 0 {
        process_exit(1);
    }
    let a: Int = tle_line_len();
    let b: Int = tle_line_len();
    if a != b {
        println("FAIL tle_line_len");
        process_exit(1);
    }
    println("prod_tle_parser: PASSED");
}
