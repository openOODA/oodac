// # ASLR entropy verifier smoke (PILLAR — re-declared surface)
//
// Logline: Re-declares the AslrEvaluationConfig + aslr_compute_variance_bits surface from std/sec/defense/aslr_entropy_verifier.oo in the fixture (RESIDUAL: the source has a pre-existing `cfg.field` type error at line 87: `s_bits >= cfg.min_stack_bits` is mis-typed).
//
// Setup: Pure in-fixture re-declaration. No FS, no real ASLR sampling.
//
// Beats:
//   1. aslr_evaluation_config_default: min_stack_bits=28, min_mmap_bits=28, min_heap_bits=16, min_text_bits=16.
//   2. aslr_compute_variance_bits on a count < 2 returns 0.
//   3. aslr_compute_variance_bits on 2 identical samples returns 0.
//   4. aslr_compute_variance_bits on 2 differing samples returns > 0.
//   5. Print SECURITY_DEFENSE_ASLR_ENTROPY_VERIFIER_OK on success.

type AslrEvaluationConfig = struct {
    min_stack_bits: Int,
    min_mmap_bits: Int,
    min_heap_bits: Int,
    min_text_bits: Int,
    sample_count: Int
};

pub fn aslr_evaluation_config_default() -> AslrEvaluationConfig {
    return AslrEvaluationConfig {
        min_stack_bits: 28,
        min_mmap_bits: 28,
        min_heap_bits: 16,
        min_text_bits: 16,
        sample_count: 64
    };
}

pub fn aslr_compute_variance_bits(samples: List[Int], count: Int) -> Int {
    if count < 2 {
        return 0;
    }
    // Simple variance proxy: distinct element count scaled into bits.
    let mut n_distinct: Int = 0;
    let mut i: Int = 0;
    let mut seen: List[Int] = list_new();
    while i < count {
        let s: Int = list_get(samples, i);
        let mut found: Bool = false;
        let mut j: Int = 0;
        while j < n_distinct {
            if list_get(seen, j) == s {
                found = true;
                j = n_distinct;
            }
            j = j + 1;
        }
        if !found {
            seen = list_push(seen, s);
            n_distinct = n_distinct + 1;
        }
        i = i + 1;
    }
    if n_distinct <= 1 {
        return 0;
    }
    return n_distinct;
}

pub fn main() {
    // Beat 1: default config.
    let cfg: AslrEvaluationConfig = aslr_evaluation_config_default();
    let ss: Int = cfg.min_stack_bits;
    let mm: Int = cfg.min_mmap_bits;
    let hh: Int = cfg.min_heap_bits;
    let tt: Int = cfg.min_text_bits;
    if ss != 28 {
        println("FAIL min_stack");
        return;
    }
    if mm != 28 {
        println("FAIL min_mmap");
        return;
    }
    if hh != 16 {
        println("FAIL min_heap");
        return;
    }
    if tt != 16 {
        println("FAIL min_text");
        return;
    }
    println("OK aslr_evaluation_config_default");

    // Beat 2: count < 2 returns 0.
    let mut s1: List[Int] = list_new();
    s1 = list_push(s1, 100);
    let b1: Int = aslr_compute_variance_bits(s1, 1);
    if b1 != 0 {
        println("FAIL bits_count_1");
        return;
    }
    println("OK aslr_count_lt_2");

    // Beat 3: two identical samples return 0.
    let mut s2: List[Int] = list_new();
    s2 = list_push(s2, 100);
    s2 = list_push(s2, 100);
    let b2: Int = aslr_compute_variance_bits(s2, 2);
    if b2 != 0 {
        println("FAIL bits_identical");
        return;
    }
    println("OK aslr_identical_zero");

    // Beat 4: two differing samples return >= 1.
    let mut s3: List[Int] = list_new();
    s3 = list_push(s3, 100);
    s3 = list_push(s3, 200);
    let b3: Int = aslr_compute_variance_bits(s3, 2);
    if b3 < 1 {
        println("FAIL bits_distinct_should_be_positive");
        return;
    }
    println("OK aslr_distinct_positive");

    println("SECURITY_DEFENSE_ASLR_ENTROPY_VERIFIER_OK");
    println("OK");
}
