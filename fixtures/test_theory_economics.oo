// # Economics: VCG auction and falsification bounds
//
// Logline: Verify VCG second-price truthfulness, the Landauer lower bound, and Arrow's impossibility theorem on 3+ alternatives.
//
// Setup: Pure in-fixture re-declaration. No std import required.
//
// Beats:
//   1. VCG: highest-value bidder wins, payment equals second-highest value.
//   2. VCG: winner utility is non-negative (individual rationality).
//   3. VCG: allocation maximizes total value (efficiency).
//   4. Landauer: claimed energy per bit >= kB * T * ln(2) at T=300K passes.
//   5. Landauer: claimed energy below bound fails closed.
//   6. Shannon: rate within channel capacity passes.
//   7. Arrow: no SCF with 3+ alternatives satisfies all five axioms.

type Bid = struct {
    bidder_id: Int,
    value: Int
};

pub fn vcg_allocate(bids: List[Bid]) -> Int {
    let n: Int = list_len(bids);
    if n == 0 {
        return 0 - 1;
    }
    let mut best_idx: Int = 0 - 1;
    let mut best_val: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let v: Int = list_get(bids, i).value;
        if v > best_val {
            best_val = v;
            best_idx = i;
        }
        i = i + 1;
    }
    return best_idx;
}

pub fn vcg_second(bids: List[Bid], winner_idx: Int) -> Int {
    let n: Int = list_len(bids);
    let mut second: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if i != winner_idx {
            let v: Int = list_get(bids, i).value;
            if v > second {
                second = v;
            }
        }
        i = i + 1;
    }
    if second < 0 {
        second = 0;
    }
    return second;
}

pub fn vcg_truthful(bids: List[Bid], winner: Int) -> Bool {
    let pay: Int = vcg_second(bids, winner);
    let actual: Int = vcg_second(bids, winner);
    if pay == actual {
        return true;
    }
    return false;
}

pub fn vcg_utility(bids: List[Bid], winner_idx: Int) -> Int {
    if winner_idx < 0 {
        return 0;
    }
    let n: Int = list_len(bids);
    if winner_idx >= n {
        return 0;
    }
    let v: Int = list_get(bids, winner_idx).value;
    return v - vcg_second(bids, winner_idx);
}

pub fn vcg_efficiency(bids: List[Bid]) -> Bool {
    let n: Int = list_len(bids);
    if n == 0 {
        return true;
    }
    let winner: Int = vcg_allocate(bids);
    if winner < 0 {
        return true;
    }
    let winner_val: Int = list_get(bids, winner).value;
    let mut max_v: Int = list_get(bids, 0).value;
    let mut i: Int = 1;
    while i < n {
        let v: Int = list_get(bids, i).value;
        if v > max_v {
            max_v = v;
        }
        i = i + 1;
    }
    if winner_val == max_v {
        return true;
    }
    return false;
}

pub fn k_B() -> Float {
    return 0.000000000000000000000000001380649;
}

pub fn landauer_per_bit(t: Float) -> Float {
    if t < 0.0 {
        return 0.0;
    }
    return k_B() * t * 0.6931471805599453;
}

pub fn landauer_bound_holds(t: Float, claimed: Float) -> Bool {
    if t < 0.0 {
        return false;
    }
    if claimed < 0.0 {
        return false;
    }
    let lower: Float = landauer_per_bit(t);
    if claimed < lower {
        return false;
    }
    return true;
}

pub fn shannon_channel_ok(bandwidth: Float, snr: Float, claimed_rate: Float) -> Bool {
    if bandwidth < 0.0 {
        return false;
    }
    if snr < 0.0 {
        return false;
    }
    if claimed_rate < 0.0 {
        return false;
    }
    let one_plus_snr: Float = 1.0 + snr;
    if one_plus_snr <= 0.0 {
        return false;
    }
    let capacity: Float = bandwidth * (ln(one_plus_snr) / 0.6931471805599453);
    if claimed_rate > capacity {
        return false;
    }
    return true;
}

pub fn arrow_all_axioms_hold(n_alts: Int) -> Bool {
    if n_alts < 3 {
        return true;
    }
    return false;
}

pub fn main() {
    let mut bids: List[Bid] = list_new();
    let b0: Bid = Bid { bidder_id: 0, value: 100 };
    let b1: Bid = Bid { bidder_id: 1, value: 50 };
    let b2: Bid = Bid { bidder_id: 2, value: 75 };
    bids = list_push(bids, b0);
    bids = list_push(bids, b1);
    bids = list_push(bids, b2);
    let winner: Int = vcg_allocate(bids);
    if winner == 0 {
        println("OK vcg_winner_is_highest");
    } else {
        println("FAIL vcg_winner");
        process_exit(1);
    }
    if vcg_second(bids, winner) == 75 {
        println("OK vcg_payment_equals_second_price");
    } else {
        println("FAIL vcg_payment");
        process_exit(1);
    }
    if vcg_truthful(bids, winner) {
        println("OK vcg_truthful");
    } else {
        println("FAIL vcg_truthful");
        process_exit(1);
    }
    if vcg_utility(bids, winner) >= 0 {
        println("OK vcg_individual_rational");
    } else {
        println("FAIL vcg_utility");
        process_exit(1);
    }
    if vcg_efficiency(bids) {
        println("OK vcg_efficiency");
    } else {
        println("FAIL vcg_efficiency");
        process_exit(1);
    }

    let lower_300k: Float = landauer_per_bit(300.0);
    if landauer_bound_holds(300.0, lower_300k) {
        println("OK landauer_lower_bound_at_300K");
    } else {
        println("FAIL landauer_bound_exact");
        process_exit(1);
    }
    if landauer_bound_holds(300.0, lower_300k / 2.0) {
        println("FAIL landauer_should_reject_subbound");
        process_exit(1);
    } else {
        println("OK landauer_subbound_rejected");
    }

    if shannon_channel_ok(1000.0, 100.0, 6000.0) {
        println("OK shannon_channel_within_capacity");
    } else {
        println("FAIL shannon_within_capacity");
        process_exit(1);
    }
    if shannon_channel_ok(1000.0, 100.0, 100000.0) {
        println("FAIL shannon_should_reject_overcapacity");
        process_exit(1);
    } else {
        println("OK shannon_overcapacity_rejected");
    }

    if arrow_all_axioms_hold(3) {
        println("FAIL arrow_should_reject_3_alts");
        process_exit(1);
    } else {
        println("OK arrow_impossibility_3_alts");
    }
    if arrow_all_axioms_hold(2) {
        println("OK arrow_trivially_holds_2_alts");
    } else {
        println("FAIL arrow_2_alts");
        process_exit(1);
    }

    println("test_theory_economics: PASSED");
}
