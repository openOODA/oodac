// # Product prove std/phys/astrophysics_relativity/stellar_chandrasekhar_mass.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/phys/astrophysics_relativity/stellar_chandrasekhar_mass.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/phys/astrophysics_relativity/stellar_chandrasekhar_mass.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_stellar_chandrasekhar_mass: PASSED only if they match.

import "std/science/phys/relativistic/stellar_chandrasekhar_mass.oo";

pub fn main() {
    let stellar_chandrasekhar_mass_a = chandrasekhar_mass_limit_milli(0);
    let stellar_chandrasekhar_mass_b = chandrasekhar_mass_limit_milli(0);
    if stellar_chandrasekhar_mass_a != stellar_chandrasekhar_mass_b {
        println("FAIL stellar_chandrasekhar_mass");
        process_exit(1);
    }
    println("prod_ap_stellar_chandrasekhar_mass: PASSED");
}
