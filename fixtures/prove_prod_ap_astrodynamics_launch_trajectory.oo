// # Product prove std/phys/astrodynamics/launch_trajectory.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/phys/astrodynamics/launch_trajectory.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/phys/astrodynamics/launch_trajectory.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_launch_trajectory: PASSED only if they match.

import "std/science/phys/relativistic/launch_trajectory.oo";

pub fn main() {
    let launch_trajectory_a = launch_az_deg();
    let launch_trajectory_b = launch_az_deg();
    if launch_trajectory_a != launch_trajectory_b {
        println("FAIL launch_trajectory");
        process_exit(1);
    }
    println("prod_ap_launch_trajectory: PASSED");
}
