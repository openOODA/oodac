// # Product buffer_stream prove
//
// Logline: Fail-closed emit+gcc+run of shipped buffer_stream_feed/len/is_empty.
//
// Setup: Product std/io/buffer_stream.oo. Feed "ab".
//
// Beats:
//   1. New stream empty; after feed ab, len 2.
//   2. Exit 1 before PASSED on a miss.

import "std/core/io/buffer_stream.oo";

pub fn main() {
    let s0: BufferStream = buffer_stream_new(8, 8);
    let e: Bool = buffer_stream_is_empty(s0);
    if e == false {
        println("FAIL bufstream empty");
        process_exit(1);
    }
    let fr: Result[BufferStream, String] = buffer_stream_feed(s0, "ab");
    if fr.is_err() {
        println("FAIL bufstream feed");
        process_exit(1);
    }
    let s: BufferStream = match fr { Ok(v) => v, Err(_) => s0 };
    let n: Int = buffer_stream_len(s);
    if n != 2 {
        println("FAIL bufstream len");
        process_exit(1);
    }
    println("prod_bufstream: PASSED");
}
