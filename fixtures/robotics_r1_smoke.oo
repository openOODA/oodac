// # Robotics R1 6-DoF Forward Kinematics & Jacobian Smoke Proof
//
// Logline: Adversarial proof for 6-DoF serial DH forward kinematics and spatial Jacobian.
//
// Setup: Pure geometric kinematics. No capability tokens. Builds DhJoint Lists and validates frame math.
//
// Beats:
//   1. Validate forward kinematics for an all-zero six-link chain.
//   2. Validate forward kinematics for a 90-degree z-rotated chain.
//   3. Validate 6x6 Jacobian flat row-major dimensions and known column values.
//   4. Validate fail-closed error returns for non-six joint lists.

import "std/core/math/constants.oo";
import "std/app/robot/ros2/dh_parameters.oo";
import "std/app/robot/ros2/kinematics_forward_chain.oo";
import "std/app/robot/ros2/spatial_jacobian_6dof.oo";

fn approx_eq(a: Float, b: Float, tol: Float) -> Bool {
    let mut d: Float = a - b;
    if d < 0.0 { d = 0.0 - d; }
    return d <= tol;
}

fn absf(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

fn smoke_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let target: Int = if n < 0 { 0 - n } else { n };
    let mut i: Int = 0;
    while i < target {
        f = f + 1.0;
        i = i + 1;
    }
    if n < 0 { return 0.0 - f; }
    return f;
}

fn ok_pose(res: Result[Pose6D, String]) -> Pose6D {
    if res.is_err() { process_exit(1); }
    return match res {
        Ok(v) => v,
        Err(_) => Pose6D { x: 0.0, y: 0.0, z: 0.0, roll: 0.0, pitch: 0.0, yaw: 0.0 }
    };
}

fn ok_jac(res: Result[List[Float], String]) -> List[Float] {
    if res.is_err() { process_exit(1); }
    return match res {
        Ok(v) => v,
        Err(_) => list_new()
    };
}

fn err_pose(res: Result[Pose6D, String]) -> Int {
    if res.is_err() { return 0; }
    return 1;
}

fn err_jac(res: Result[List[Float], String]) -> Int {
    if res.is_err() { return 0; }
    return 1;
}

fn make_all_zero_links() -> List[DhJoint] {
    let mut joints: List[DhJoint] = list_new();
    let mut i: Int = 0;
    while i < 6 {
        joints = list_push(joints, dh_joint_new(0.0, 0.0, 1.0, 0.0));
        i = i + 1;
    }
    return joints;
}

fn make_rotated_links(theta: Float) -> List[DhJoint] {
    let mut joints: List[DhJoint] = list_new();
    let mut i: Int = 0;
    while i < 6 {
        let t: Float = if i == 0 { theta } else { 0.0 };
        joints = list_push(joints, dh_joint_new(t, 0.0, 1.0, 0.0));
        i = i + 1;
    }
    return joints;
}

fn test_fk_zero() -> Int {
    let joints: List[DhJoint] = make_all_zero_links();
    let pose: Pose6D = ok_pose(fk_chain_6dof(joints));
    let tol: Float = 0.0001;
    if !approx_eq(pose.x, 6.0, tol) { return 1; }
    if !approx_eq(pose.y, 0.0, tol) { return 1; }
    if !approx_eq(pose.z, 0.0, tol) { return 1; }
    if !approx_eq(pose.roll, 0.0, tol) { return 1; }
    if !approx_eq(pose.pitch, 0.0, tol) { return 1; }
    if !approx_eq(pose.yaw, 0.0, tol) { return 1; }
    return 0;
}

fn test_fk_rotated() -> Int {
    let pack: CircleConstants = circle_constants();
    let pi: Float = pack.pi;
    let joints: List[DhJoint] = make_rotated_links(pi / 2.0);
    let pose: Pose6D = ok_pose(fk_chain_6dof(joints));
    let tol: Float = 0.0001;
    if !approx_eq(pose.x, 0.0, tol) { return 1; }
    if !approx_eq(pose.y, 6.0, tol) { return 1; }
    if !approx_eq(pose.z, 0.0, tol) { return 1; }
    if !approx_eq(pose.roll, 0.0, tol) { return 1; }
    if !approx_eq(pose.pitch, 0.0, tol) { return 1; }
    if !approx_eq(pose.yaw, pi / 2.0, tol) { return 1; }
    return 0;
}

fn test_jacobian_zero() -> Int {
    let joints: List[DhJoint] = make_all_zero_links();
    let jac: List[Float] = ok_jac(compute_jacobian_6x6(joints));
    if list_len(jac) != 36 { return 1; }
    let tol: Float = 0.0001;
    let mut r: Int = 0;
    while r < 6 {
        let mut c: Int = 0;
        while c < 6 {
            let idx: Int = (r * 6) + c;
            let val: Float = list_get(jac, idx);
            let cf: Float = smoke_int_to_float(c);
            let expected: Float = if r == 1 { 6.0 - cf } else { if r == 5 { 1.0 } else { 0.0 } };
            if !approx_eq(val, expected, tol) { return 1; }
            c = c + 1;
        }
        r = r + 1;
    }
    return 0;
}

fn test_jacobian_rotated() -> Int {
    let pack: CircleConstants = circle_constants();
    let pi: Float = pack.pi;
    let joints: List[DhJoint] = make_rotated_links(pi / 2.0);
    let jac: List[Float] = ok_jac(compute_jacobian_6x6(joints));
    if list_len(jac) != 36 { return 1; }
    let tol: Float = 0.0001;
    let mut r: Int = 0;
    while r < 6 {
        let mut c: Int = 0;
        while c < 6 {
            let idx: Int = (r * 6) + c;
            let val: Float = list_get(jac, idx);
            let cf: Float = smoke_int_to_float(c);
            let expected: Float = if r == 0 { 0.0 - (6.0 - cf) } else { if r == 5 { 1.0 } else { 0.0 } };
            if !approx_eq(val, expected, tol) { return 1; }
            c = c + 1;
        }
        r = r + 1;
    }
    return 0;
}

fn test_error_paths() -> Int {
    let mut short: List[DhJoint] = list_new();
    short = list_push(short, dh_joint_new(0.0, 0.0, 1.0, 0.0));
    short = list_push(short, dh_joint_new(0.0, 0.0, 1.0, 0.0));
    if err_pose(fk_chain_6dof(short)) != 0 { return 1; }
    if err_jac(compute_jacobian_6x6(short)) != 0 { return 1; }
    let mut long: List[DhJoint] = list_new();
    let mut i: Int = 0;
    while i < 7 {
        long = list_push(long, dh_joint_new(0.0, 0.0, 1.0, 0.0));
        i = i + 1;
    }
    if err_pose(fk_chain_6dof(long)) != 0 { return 1; }
    if err_jac(compute_jacobian_6x6(long)) != 0 { return 1; }
    return 0;
}

pub fn main() -> Int {
    let mut code: Int = test_fk_zero();
    if code != 0 { return code; }
    code = test_fk_rotated();
    if code != 0 { return code; }
    code = test_jacobian_zero();
    if code != 0 { return code; }
    code = test_jacobian_rotated();
    if code != 0 { return code; }
    code = test_error_paths();
    if code != 0 { return code; }
    return 0;
}
