// # FIPS 203 ML-KEM Compress Round-Trip Smoke
//
// Logline: Verifies std/crypto/pqc_nist/fips203_ml_kem_compress.ml_kem_compress_coeff and ml_kem_decompress_coeff are mutual inverses (compress then decompress returns the original x in [0, q)) for d=12.
//
// Setup: Imports std/crypto/pqc_nist/fips203_ml_kem_compress.oo. Pure, no FS or net. Round-trip property (PROP) test for d=12 (small enough to round-trip exactly).
//
// Beats:
//   1. Compress x=100, d=12 → y.
//   2. Decompress y → x'.
//   3. Assert x' equals x.
//   4. Print ML_KEM_COMPRESS_PROP_OK on success.

import "std/sec/asymmetric/fips203_ml_kem_compress.oo";

pub fn main() {
    let x: Int = 100;
    let d: Int = 12;
    let y: Int = ml_kem_compress_coeff(x, d);
    let x_back: Int = ml_kem_decompress_coeff(y, d);
    if x != x_back {
        println("FAIL roundtrip");
        return;
    }
    println("ML_KEM_COMPRESS_PROP_OK");
}
