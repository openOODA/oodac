// # ThreadCap rwlock read/write smoke (PROP — re-declared surface)
//
// Logline: Re-declares the RwLock surface from std/sync/rwlock.oo in the fixture and exercises the read/write mutual exclusion PROP (readers count, writer flag).
//
// Setup: Pure in-fixture re-declaration (RESIDUAL: importing the real std/sync/rwlock.oo triggers a pre-existing pb_types.c redefinition bug for `Result[RwLock, String]`).
//
// Beats:
//   1. rwlock_new sets readers=0, writer=false.
//   2. read_lock on unlocked lock returns next readers=1.
//   3. read_lock twice on same lock yields readers=2.
//   4. write_lock when readers=0 succeeds and sets writer=true.
//   5. write_lock on a lock with writer=true returns -1 (busy).
//   6. Print SYNC_RWLOCK_PROP_OK on success.

type RwLock = struct {
    id: Int,
    readers: Int,
    writer: Bool,
    name: String
};

pub fn rwlock_new(id: Int, name: String) -> RwLock {
    return RwLock {
        id: id,
        readers: 0,
        writer: false,
        name: name
    };
}

// Returns 1 on success (lock acquired), -1 on Err (e.g. write lock currently held for read).
// Mirrors std/sync/rwlock.rwlock_read_lock contract.
pub fn rwlock_read_lock(lock: RwLock) -> Int {
    let wr: Bool = lock.writer;
    if wr == true {
        return -1;
    }
    return 1;
}

// Returns 1 on success, -1 on Err.
pub fn rwlock_write_lock(lock: RwLock) -> Int {
    let r: Int = lock.readers;
    let wr: Bool = lock.writer;
    if r > 0 || wr {
        return -1;
    }
    return 1;
}

pub fn main() {
    // Beat 1: fresh rwlock.
    let mut l: RwLock = rwlock_new(1, "x");
    if l.readers != 0 || l.writer {
        println("FAIL new_rwlock_state");
        return;
    }
    println("OK rwlock_new");

    // Beat 2: first read_lock succeeds.
    let r1: Int = rwlock_read_lock(l);
    if r1 != 1 {
        println("FAIL first_read_lock");
        return;
    }
    l.readers = 1;
    println("OK read_lock_1");

    // Beat 3: read_lock again succeeds (shared read is allowed).
    let r2: Int = rwlock_read_lock(l);
    if r2 != 1 {
        println("FAIL second_read_lock");
        return;
    }
    l.readers = 2;
    println("OK read_lock_2");

    // Beat 4: write_lock while readers=2 returns -1 (busy).
    let w1: Int = rwlock_write_lock(l);
    if w1 != -1 {
        println("FAIL write_lock_with_readers_should_busy");
        return;
    }
    println("OK write_lock_with_readers_rejected");

    // Beat 5: drain readers — set readers=0, then write_lock succeeds.
    l.readers = 0;
    let w2: Int = rwlock_write_lock(l);
    if w2 != 1 {
        println("FAIL write_lock_uncontended_should_succeed");
        return;
    }
    l.writer = true;
    println("OK write_lock_acquired");

    // Beat 6: read_lock while writer=true returns -1.
    let r3: Int = rwlock_read_lock(l);
    if r3 != -1 {
        println("FAIL read_lock_while_writer_should_err");
        return;
    }
    println("OK read_lock_while_writer_rejected");

    println("SYNC_RWLOCK_PROP_OK");
    println("OK");
}
