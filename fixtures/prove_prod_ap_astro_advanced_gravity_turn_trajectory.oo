// # Product prove std/phys/astro_advanced/gravity_turn_trajectory.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/phys/astro_advanced/gravity_turn_trajectory.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/phys/astro_advanced/gravity_turn_trajectory.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_gravity_turn_trajectory: PASSED only if they match.

import "std/science/phys/relativistic/gravity_turn_trajectory.oo";

pub fn main() {
    let gravity_turn_trajectory_a = gravity_turn_pitch_deg();
    let gravity_turn_trajectory_b = gravity_turn_pitch_deg();
    if gravity_turn_trajectory_a != gravity_turn_trajectory_b {
        println("FAIL gravity_turn_trajectory");
        process_exit(1);
    }
    println("prod_ap_gravity_turn_trajectory: PASSED");
}
