// # LinkedList edge smoke
//
// Logline: Asserts std/collections/linked_list.oo push_front, push_back, pop_front, peek_front, peek_back, contains, and head/tail boundary behavior.
//
// Setup: Imports std/collections/linked_list.oo. Pure.
//
// Beats:
//   1. Empty list: len = 0, peek_front/peek_back both Err.
//   2. push_back 1, 2, 3; peek_front = 1, peek_back = 3.
//   3. push_front 0; list is now 0, 1, 2, 3.
//   4. pop_front removes the head; list becomes 1, 2, 3.
//   5. LINKED_LIST_OK on success.

import "std/core/collection/linked_list.oo";

pub fn expect_eq_int(label: String, got: Int, want: Int) -> Bool {
    if got == want { println("OK " + label); return true; }
    println("FAIL " + label + " got=" + got.to_string() + " want=" + want.to_string());
    return false;
}

pub fn expect_true(label: String, cond: Bool) -> Bool {
    if cond { println("OK " + label); return true; }
    println("FAIL " + label);
    return false;
}

pub fn expect_false(label: String, cond: Bool) -> Bool {
    if cond { println("FAIL " + label); return false; }
    println("OK " + label);
    return true;
}

pub fn unwrap_int(r: Result[Int, String]) -> Int {
    if r.is_err() { return 0 - 1; }
    return r.unwrap();
}

pub fn main() {
    let ll0: LinkedList = linked_list_new();
    if !expect_eq_int("initial len", linked_list_len(ll0), 0) { return; }
    if !expect_true("initial is_empty", linked_list_is_empty(ll0)) { return; }
    let pfe: Result[Int, String] = linked_list_peek_front(ll0);
    let pbe: Result[Int, String] = linked_list_peek_back(ll0);
    if !expect_false("peek_front empty is_err", pfe.is_ok()) { return; }
    if !expect_false("peek_back empty is_err", pbe.is_ok()) { return; }

    let mut ll: LinkedList = ll0;
    ll = linked_list_push_back(ll, 1);
    ll = linked_list_push_back(ll, 2);
    ll = linked_list_push_back(ll, 3);
    if !expect_eq_int("len after 3 push_back", linked_list_len(ll), 3) { return; }
    if !expect_eq_int("peek_front = 1", unwrap_int(linked_list_peek_front(ll)), 1) { return; }
    if !expect_eq_int("peek_back = 3", unwrap_int(linked_list_peek_back(ll)), 3) { return; }
    if !expect_true("contains 2", linked_list_contains(ll, 2)) { return; }
    if !expect_false("contains missing 99", linked_list_contains(ll, 99)) { return; }

    ll = linked_list_push_front(ll, 0);
    if !expect_eq_int("len after push_front", linked_list_len(ll), 4) { return; }
    if !expect_eq_int("peek_front = 0 after push_front", unwrap_int(linked_list_peek_front(ll)), 0) { return; }
    if !expect_eq_int("peek_back = 3 unchanged", unwrap_int(linked_list_peek_back(ll)), 3) { return; }

    let ll2: LinkedList = linked_list_pop_front(ll);
    if !expect_eq_int("len after pop_front", linked_list_len(ll2), 3) { return; }
    if !expect_eq_int("peek_front after pop = 1", unwrap_int(linked_list_peek_front(ll2)), 1) { return; }
    if !expect_eq_int("peek_back after pop = 3", unwrap_int(linked_list_peek_back(ll2)), 3) { return; }

    let ll3: LinkedList = linked_list_pop_front(ll2);
    let ll4: LinkedList = linked_list_pop_front(ll3);
    let ll5: LinkedList = linked_list_pop_front(ll4);
    if !expect_eq_int("len after draining pops", linked_list_len(ll5), 0) { return; }
    if !expect_true("drained is_empty", linked_list_is_empty(ll5)) { return; }

    let ll6: LinkedList = linked_list_pop_front(ll5);
    if !expect_eq_int("pop on empty is no-op", linked_list_len(ll6), 0) { return; }

    println("LINKED_LIST_OK");
}
