// # CLI GPU Kernel Emission Router
//
// Logline: Handles emit-msl, emit-spirv, emit-ptx, emit-hip, emit-rocm, and emit-gpu compiler CLI commands.
//
// Setup: Integrates with oodac CLI dispatch pipeline for GPU code emission.
//
// Beats:
//   1. Parse target backend and kernel operation type from CLI arguments.
//   2. Lower source AST and validate fail-closed device invariants.
//   3. Generate target shader or bytecode (Metal MSL, SPIR-V, CUDA PTX, HIP/ROCm).
//   4. Output shader to stdout or write directly to target binary file.




pub fn is_gpu_command(cmd: String) -> Bool {
    if cmd == "emit-msl" || cmd == "emit-spirv" || cmd == "emit-ptx" || cmd == "emit-gpu" || cmd == "emit-hip" || cmd == "emit-rocm" { return true;
}
    return false;
}

pub fn run_emit_gpu_cmd(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, cmd: String, path: String, out_arg: String) -> Bool {
    let src: String = load_source_with_imports(fs_r, path);
if chars_len(src) == 0 { println("ERR\tgpu_emit\tunreadable or empty source: " + path);
return false;
}

    let ir_res: Result[GpuKernelIR, String] = gpu_lower_source_to_ir(src, "");
    match ir_res { Ok(ir) => { if cmd == "emit-hip" || cmd == "emit-rocm" { let hip_code: String = hip_emit_from_ir(ir);
    if out_arg != "" { let _w: Result[Void, String] = write_file(fs_w, out_arg, hip_code);
    } else {
                    println(hip_code);
                }
                return true;
            }
            if cmd == "emit-msl" || cmd == "emit-gpu" {
                let msl_code: String = metal_emit_from_ir(ir);
                if out_arg != "" {
                    let _w: Result[Void, String] = write_file(fs_w, out_arg, msl_code);
                } else {
                    println(msl_code);
                }
                return true;
            }
            if cmd == "emit-spirv" {
                let words: List[Int] = spirv_build_from_ir(ir);
                if out_arg != "" {
                    return spirv_emit_binary_spv(sys, words, out_arg);
                }
                let hex: String = spirv_words_to_hex(words);
                println(hex);
                return true;
            }
            if cmd == "emit-ptx" {
                let ptx_code: String = ptx_emit_from_ir(ir);
                if out_arg != "" {
                    let _w: Result[Void, String] = write_file(fs_w, out_arg, ptx_code);
                } else {
                    println(ptx_code);
                }
                return true;
            }
            println("ERR\tgpu_emit\tunrecognized gpu command: " + cmd);
            return false;
        }
        Err(e) => {
            println("ERR\tgpu_emit\t" + e);
            return false;
        }
    }
}
