// # Shared build-driver helpers
//
// Logline: Home for small build queries used by run_build_san.
//
// Setup: Pure helpers moved out of cli_build.oo so backend blocks
//   fit the module line cap. No behavior change on move.
//
// Beats:
//   1. src_has_main scans source tokens for fn main.
//   2. path_is_compiler_main spots the self-build entry.
//   3. cache_dir resolves the artifact scratch dir.

import "lex/token_fmt.oo";

pub fn src_has_main(src: String) -> Bool {
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_FN" {
            if i + 1 < n {
                let k2: String = field_at(list_get(toks, i + 1), 0);
                let t2: String = field_at(list_get(toks, i + 1), 3);
                if k2 == "IDENT" && t2 == "main" {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

pub fn path_is_compiler_main(path: String) -> Bool {
    return path == "oodac/main.oo";
}

pub fn cache_dir(env: &EnvCap) -> String {
    let wd: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
    if wd.is_ok() {
        let s: String = wd.val;
        if s != "" {
            let mut end: Int = chars_len(s);
            let col: Int = str_index_of(s, ":");
            if col >= 0 { end = col; }
            let base: String = str_slice(s, 0, end);
            if base != "" { return base + "/.ooda-cache/ooda-tmp"; }
        }
    }
    return ".ooda-cache/ooda-tmp";
}
