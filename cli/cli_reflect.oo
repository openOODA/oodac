// # CLI Semantic Reflection Extractor
//
// Logline: Emit structured JSON metadata reflecting functions, structs, types, traits, contracts, and capability tokens.
//
// Setup: FsCap reads source files; SysCap executes queries; outputs JSON objects per reflected symbol.
//
// Beats:
//   1. Parse functions with parameter names, types, return types, requires, ensures, and capability tokens.
//   2. Parse struct and type definitions with typed field schema lists.
//   3. Parse trait declarations and verify blocks into structured JSON representations.


fn reflect_pack(json: String, pos: Int) -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, json);
    out = list_push(out, pos.to_string());
    return out;
}
fn reflect_item_json(item: List[String]) -> String {
    if list_len(item) < 1 { return ""; } return list_get(item, 0);
}
fn reflect_item_pos(item: List[String]) -> Int {
    if list_len(item) < 2 { return 0; } return parse_int(list_get(item, 1));
}
fn reflect_skip_braces(toks: List[String], pos0: Int) -> Int {
    let n = list_len(toks);
    let mut pos = pos0 + 1;
    let mut depth = 1;
    while pos < n && depth > 0 {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "LBRACE" { depth = depth + 1; }
        if k == "RBRACE" { depth = depth - 1; }
        pos = pos + 1;
    }
    return pos;
}
pub fn reflect_symbols_json(src: String) -> String {
    return reflect_symbols_filtered(src, "");
}
pub fn reflect_symbol_single(src: String, filter_sym: String) -> String {
    return reflect_symbols_filtered(src, filter_sym);
}


pub fn reflect_symbols_filtered(src: String, filter_sym: String) -> String {
    let toks: List[String] = tokenize_lines(src); let n: Int = list_len(toks); let mut pos: Int = 0; let mut out: String = ""; while pos < n { let k: String = field_at(list_get(toks, pos), 0); if k == "EOF" { pos = n; } else if k == "KW_PUB" {
            if pos + 1 < n {
                let k2: String = field_at(list_get(toks, pos + 1), 0);
                if k2 == "KW_FN" {
                    let item: List[String] = reflect_parse_fn(toks, pos + 2, n, true, filter_sym);
                    if reflect_item_json(item) != "" { out = out + reflect_item_json(item) + "\n"; }
                    pos = reflect_item_pos(item);
                } else if k2 == "KW_TYPE" {
                    let item: List[String] = reflect_parse_type(toks, pos + 2, n, true, filter_sym);
                    if reflect_item_json(item) != "" { out = out + reflect_item_json(item) + "\n"; }
                    pos = reflect_item_pos(item);
                } else { pos = pos + 1; }
            } else { pos = pos + 1; }
        } else if k == "KW_FN" {
            let item: List[String] = reflect_parse_fn(toks, pos + 1, n, false, filter_sym);
            if reflect_item_json(item) != "" { out = out + reflect_item_json(item) + "\n"; }
            pos = reflect_item_pos(item);
        } else if k == "KW_TYPE" {
            let item: List[String] = reflect_parse_type(toks, pos + 1, n, false, filter_sym);
            if reflect_item_json(item) != "" { out = out + reflect_item_json(item) + "\n"; }
            pos = reflect_item_pos(item);
        } else if k == "KW_VERIFY" {
            pos = pos + 1;
            let mut vname: String = "";
            if pos < n && field_at(list_get(toks, pos), 0) == "IDENT" {
                vname = field_at(list_get(toks, pos), 3);
                pos = pos + 1;
            }
            if vname != "" && (filter_sym == "" || vname == filter_sym) {
                out = out + "{\"kind\":\"verify\",\"name\":\"" + vname + "\"}\n";
            }
            if pos < n && field_at(list_get(toks, pos), 0) == "LBRACE" { pos = reflect_skip_braces(toks, pos); }
        } else { pos = pos + 1; }
    }
    return out;
}

fn reflect_parse_fn(toks: List[String], pos0: Int, n: Int, is_pub: Bool, filter_sym: String) -> List[String] {
    let mut pos: Int = pos0;
    if pos >= n || field_at(list_get(toks, pos), 0) != "IDENT" { return reflect_pack("", pos); }
    let name: String = field_at(list_get(toks, pos), 3);
    pos = pos + 1;
    if pos < n && field_at(list_get(toks, pos), 0) == "LPAREN" { pos = pos + 1; }

    let mut params_json: String = "[";
    let mut caps_json: String = "[";
    let mut first_p: Bool = true;
    let mut first_c: Bool = true;

    while pos < n {
        let pk: String = field_at(list_get(toks, pos), 0);
        if pk == "RPAREN" { pos = pos + 1; break; }
        if pk == "COMMA" { pos = pos + 1; }
        else if pk == "AMP" || pk == "IDENT" {
            if pk == "AMP" { pos = pos + 1; }
            if pos < n && field_at(list_get(toks, pos), 0) == "IDENT" {
                let pname: String = field_at(list_get(toks, pos), 3);
                pos = pos + 1;
                let mut pty: String = "";
                if pos < n && field_at(list_get(toks, pos), 0) == "COLON" {
                    pos = pos + 1;
                    if pos < n && field_at(list_get(toks, pos), 0) == "AMP" { pty = "&"; pos = pos + 1; }
                    while pos < n {
                        let nk: String = field_at(list_get(toks, pos), 0);
                        if nk == "COMMA" || nk == "RPAREN" { break; }
                        pty = pty + field_at(list_get(toks, pos), 3);
                        pos = pos + 1;
                    }
                }
                if str_index_of(pty, "Cap") >= 0 {
                    let mut cname: String = pty;
                    if str_slice(cname, 0, 1) == "&" { cname = str_slice(cname, 1, chars_len(cname)); }
                    if !first_c { caps_json = caps_json + ","; }
                    caps_json = caps_json + "\"" + cname + "\"";
                    first_c = false;
                }
                if !first_p { params_json = params_json + ","; }
                first_p = false;
                params_json = params_json + "{\"name\":\"" + pname + "\",\"type\":\"" + pty + "\"}";
            }
        } else { pos = pos + 1; }
    }
    params_json = params_json + "]";
    caps_json = caps_json + "]";

    let mut ret_ty: String = "";
    if pos < n && field_at(list_get(toks, pos), 0) == "ARROW" {
        pos = pos + 1;
        while pos < n {
            let rk: String = field_at(list_get(toks, pos), 0);
            if rk == "LBRACE" || rk == "KW_REQUIRES" || rk == "KW_ENSURES" || rk == "SEMI" { break; }
            ret_ty = ret_ty + field_at(list_get(toks, pos), 3);
            pos = pos + 1;
        }
    }

    let mut reqs_json: String = "[";
    let mut enss_json: String = "[";
    let mut first_r: Bool = true;
    let mut first_e: Bool = true;

    while pos < n {
        let bk: String = field_at(list_get(toks, pos), 0);
        if bk == "LBRACE" { pos = reflect_skip_braces(toks, pos); break; }
        if bk == "SEMI" { pos = pos + 1; break; }
        if bk == "KW_REQUIRES" || bk == "KW_ENSURES" {
            let is_req: Bool = (bk == "KW_REQUIRES");
            pos = pos + 1;
            let mut c: String = "";
            while pos < n {
                let nk: String = field_at(list_get(toks, pos), 0);
                if nk == "KW_REQUIRES" || nk == "KW_ENSURES" || nk == "LBRACE" || nk == "SEMI" { break; }
                if c != "" { c = c + " "; }
                c = c + field_at(list_get(toks, pos), 3);
                pos = pos + 1;
            }
            if is_req {
                if !first_r { reqs_json = reqs_json + ","; }
                reqs_json = reqs_json + "\"" + c + "\"";
                first_r = false;
            } else {
                if !first_e { enss_json = enss_json + ","; }
                enss_json = enss_json + "\"" + c + "\"";
                first_e = false;
            }
        } else { pos = pos + 1; }
    }
    reqs_json = reqs_json + "]";
    enss_json = enss_json + "]";
    let mut ret_val: String = "null";
    if ret_ty != "" { ret_val = "\"" + ret_ty + "\""; }
    let mut pub_val: String = "false";
    if is_pub { pub_val = "true"; }
    let mut json_obj: String = "";
    if filter_sym == "" || name == filter_sym {
        json_obj = "{\"kind\":\"fn\",\"name\":\"" + name + "\",\"pub\":" + pub_val + ",\"params\":" + params_json + ",\"ret\":" + ret_val + ",\"requires\":" + reqs_json + ",\"ensures\":" + enss_json + ",\"caps\":" + caps_json + "}";
    }
    return reflect_pack(json_obj, pos);
}

fn reflect_parse_type(toks: List[String], pos0: Int, n: Int, is_pub: Bool, filter_sym: String) -> List[String] {
    let mut pos: Int = pos0;
    if pos >= n || field_at(list_get(toks, pos), 0) != "IDENT" { return reflect_pack("", pos); }
    let name: String = field_at(list_get(toks, pos), 3);
    pos = pos + 1;
    let mut fields_json: String = "[";
    let mut first_f: Bool = true;

    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "SEMI" { pos = pos + 1; break; }
        if k == "LBRACE" {
            pos = pos + 1;
            while pos < n {
                let fk: String = field_at(list_get(toks, pos), 0);
                if fk == "RBRACE" { pos = pos + 1; break; }
                if fk == "COMMA" { pos = pos + 1; }
                else if fk == "IDENT" {
                    let fname: String = field_at(list_get(toks, pos), 3);
                    pos = pos + 1;
                    let mut fty: String = "";
                    if pos < n && field_at(list_get(toks, pos), 0) == "COLON" {
                        pos = pos + 1;
                        while pos < n {
                            let tk: String = field_at(list_get(toks, pos), 0);
                            if tk == "COMMA" || tk == "RBRACE" { break; }
                            fty = fty + field_at(list_get(toks, pos), 3);
                            pos = pos + 1;
                        }
                    }
                    if !first_f { fields_json = fields_json + ","; }
                    first_f = false;
                    fields_json = fields_json + "{\"name\":\"" + fname + "\",\"type\":\"" + fty + "\"}";
                } else { pos = pos + 1; }
            }
            if pos < n && field_at(list_get(toks, pos), 0) == "SEMI" { pos = pos + 1; }
            break;
        }
        pos = pos + 1;
    }
    fields_json = fields_json + "]";
    let mut pub_val: String = "false";
    if is_pub { pub_val = "true"; }
    let mut json_obj: String = "";
    if filter_sym == "" || name == filter_sym {
        json_obj = "{\"kind\":\"type\",\"name\":\"" + name + "\",\"pub\":" + pub_val + ",\"fields\":" + fields_json + "}";
    }
    return reflect_pack(json_obj, pos);
}

pub fn run_cli_reflect(fs: &FsReadCap, sys: &ProcessCap, args: List[String]) {
    if list_len(args) < 2 { println("ooda reflect: missing path"); process_exit(2); }
    let mut path: String = ""; let mut sym: String = ""; let mut i: Int = 1;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if str_slice(a, 0, 1) != "-" { if path == "" { path = a; } else if sym == "" { sym = a; } }
        i = i + 1;
    }
    if !path_exists(fs, path) { println("ERR\treflect\tunreadable path: " + path); process_exit(2); }
    let rf: Result[String, String] = read_file(fs, path);
    if rf.is_ok() {
        let src: String = match rf { Ok(s) => s, Err(e) => e };
        let out: String = reflect_symbols_filtered(src, sym);
        if chars_len(out) > 0 { println(out); }
        process_exit(0);
    }
    process_exit(1);
}
