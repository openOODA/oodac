// # Build LLVM and bitcode target binaries
//
// Logline: Lowers AST to LLVM IR and invokes llvm-as, opt, or clang/lld for native binaries.
//
// Setup: load_import, c_emit_helpers, and c_emit exist. ProcessCap executes external toolchains.
//
// Beats:
//   1. Build bitcode (.bc) via emit-llvm and llvm-as/clang.
//   2. Build native LLVM binary via clang, lld, sanitizer flags, and chs_rt.
//   3. Dispatch on target shortname and configure autovectorization environments.




import "emit/llvm/llvm_native_bin.oo";

// P4.39: -Oautovec opt-in helpers.
// The "autovec" opt value maps to this gcc/clang flag string. Used by
// run_build_llvm's clang invocation, and by the C backend (cli_build.oo
// exports OODA_AUTOVEC=1 so cli_build_cc.oo's probe_cc picks it up).
pub fn autovec_flag_str() -> String { return "-O3 -fvectorize -fslp-vectorize-aggressive"; }
pub fn is_autovec_opt(opt: String) -> Bool { return opt == "autovec" || opt == "-Oautovec"; }
// Export OODA_AUTOVEC=1 to the env so the C backend (cli_build_cc.oo)
// picks it up via its probe_cc shell. Returns the env string the caller
// can prepend to its own shell command, or "" if not autovec.
pub fn autovec_env_prefix(sys: &ProcessCap, opt: String) -> String {
    if !is_autovec_opt(opt) { return "";
    }
    let _e: Result[String, String] = sys_exec(sys, "sh", "-c", "export OODA_AUTOVEC=1");
    return "OODA_AUTOVEC=1 ";
}

pub fn run_build_llvm(sys: &ProcessCap, path: String, out: String, is_bc: Bool, opt: String, lto: Bool, release: Bool, is_debug: Bool, target_triple: String, pgo_gen: Bool, pgo_use: String, sanitizers: String) {
    if opt == "ssa" {
        run_build_llvm_ssa(sys, path, out, is_bc, opt, lto, release, is_debug, target_triple, pgo_gen, pgo_use, sanitizers);
        return;
    }
    let tmp_ll = out + ".tmp.ll";
    let probe_dbg = "if [ -n \"$OODA_DEBUG\" ] || [ -n \"$DEBUG\" ] || [ \"$OODA_LLVM_DEBUG\" = \"1\" ]; then exit 0; else exit 1; fi";
    let dbg_res = sys_exec(sys, "sh", "-c", probe_dbg);
    let mut is_dbg = is_debug;
    if dbg_res.is_ok() { is_dbg = true;
    }
    if opt == "dwarf5" || opt == "debug-split" { is_dbg = true;
    }
    let mut dbg_flag = "";
    let mut clang_dbg = "";
    if is_dbg { dbg_flag = " -g";
    clang_dbg = "-g ";
    }
    if opt == "dwarf5" {
        clang_dbg = "-gdwarf-5 ";
    } else if opt == "debug-split" {
        clang_dbg = "-gsplit-dwarf -gdwarf-5 ";
    }
    let mut tr_flag = "";
    let mut clang_tr = "";
    if target_triple != "" {
        tr_flag = " --target-triple=" + target_triple;
        clang_tr = "--target=" + target_triple + " ";
    }
    let mut san_str = sanitizers;
    let san_probe = "if [ -n \"$OODA_SANITIZE\" ]; then echo \"$OODA_SANITIZE\"; elif [ -n \"$SANITIZE\" ]; then echo \"$SANITIZE\"; elif [ -n \"$OODA_FSANITIZE\" ]; then echo \"$OODA_FSANITIZE\"; fi";
    let san_res = sys_exec(sys, "sh", "-c", san_probe);
    if san_str == "" && san_res.is_ok() {
        san_str = match san_res { Ok(s) => str_trim(s), Err(e) => "" };
    }
    let mut san_flags = "";
    let mut clang_san = "";
    if str_index_of(san_str, "address") >= 0 { san_flags = san_flags + " -fsanitize=address";
    clang_san = clang_san + "-fsanitize=address ";
    }
    if str_index_of(san_str, "thread") >= 0 { san_flags = san_flags + " -fsanitize=thread";
    clang_san = clang_san + "-fsanitize=thread ";
    }
    if str_index_of(san_str, "undefined") >= 0 { san_flags = san_flags + " -fsanitize=undefined";
    clang_san = clang_san + "-fsanitize=undefined ";
    }
    if str_index_of(san_str, "fuzzer") >= 0 { san_flags = san_flags + " -fsanitize=fuzzer";
    clang_san = clang_san + "-fsanitize=fuzzer ";
    }
    let r_emit: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-${OODA_COMPILER:-./bin/oodac}}\" && $OODAC_BIN emit-llvm" + dbg_flag + tr_flag + san_flags + " " + shell_sq(path) + " > " + shell_sq(tmp_ll));
    if !r_emit.is_ok() { println("ERR\tbuild\temit-llvm failed");
    process_exit(1);
    }

    if is_bc { let bc_cmd = "if command -v llvm-as >/dev/null 2>&1; then llvm-as " + shell_sq(tmp_ll) + " -o " + shell_sq(out) + "; elif command -v clang >/dev/null 2>&1; then clang -c -emit-llvm -Wno-override-module -x ir " + shell_sq(tmp_ll) + " -o " + shell_sq(out) + "; else exit 1; fi";
    let r_bc: Result[String, String] = sys_exec(sys, "sh", "-c", bc_cmd);
    if r_bc.is_ok() { println("OK\tbuild\t" + out);
    return;
    } else {
            println("ERR\tbuild\tbitcode assembly failed");
            process_exit(1);
        }
    }

    if opt == "verify" {
        let verify_cmd = "if command -v opt >/dev/null 2>&1; then opt -verify -S " + shell_sq(tmp_ll) + " -o /dev/null; else echo 'opt not found, skipping verifier'; fi";
        let r_v: Result[String, String] = sys_exec(sys, "sh", "-c", verify_cmd);
        if r_v.is_ok() {
            println("OK\tllvm_verify\t" + tmp_ll);
        } else {
            println("ERR\tllvm_verify\tverifier rejected " + tmp_ll);
            process_exit(1);
        }
    }

    let mut opt_flag: String = opt;
    if opt_flag == "" {
        if release { opt_flag = "-O2";
        }
        else { opt_flag = "-O0";
        }
    }
    let mut lto_from_opt: Bool = false;
    if opt_flag == "lto" || opt_flag == "pgo_lto" {
        opt_flag = "-O2";
        lto_from_opt = true;
    }
    if opt_flag == "dwarf5" || opt_flag == "debug-split" {
        opt_flag = "-O0";
    }
    // P4.39: -Oautovec opt-in. Hand clang the full vectorize flag string so
    // autovectorization kicks in even though the LLVM IR emitter does not
    // emit vector instructions itself (the C backend is the real beneficiary).
    if is_autovec_opt(opt_flag) {
        opt_flag = autovec_flag_str();
    }
    let mut lto_flags: String = "";
    if lto { lto_flags = "-flto=thin -Wl,--gc-sections";
    } else if lto_from_opt { lto_flags = "-flto";
    }
    let mut pgo_flags: String = "";
    if pgo_gen { pgo_flags = "-fprofile-generate";
    } else if pgo_use != "" {
        pgo_flags = "-fprofile-use=" + pgo_use;
    }
    let clang_cmd = "OO_SSL_C=\"\"; OO_SSL_L=\"\"; if [ \"${OO_HAVE_OPENSSL:-0}\" = 1 ]; then OO_SSL_C=\"-DOO_HAVE_OPENSSL\"; OO_SSL_L=\"-lssl -lcrypto\"; fi; OO_OPT=\"${OODA_OPT:-" + opt_flag + "}\"; if [ -z \"$OO_OPT\" ]; then if [ \"${OODA_RELEASE:-0}\" = \"1\" ]; then OO_OPT=\"-O2\"; else OO_OPT=\"-O0\"; fi; fi; OO_LTO=\"${OODA_LTO:-}\"; OO_LTO_FLAGS=\"" + lto_flags + "\"; if [ \"$OO_LTO\" = \"1\" ]; then OO_LTO_FLAGS=\"-flto=thin -Wl,--gc-sections\"; fi; if [ \"$OO_LTO\" = \"full\" ]; then OO_LTO_FLAGS=\"-flto\"; OO_OPT=\"-O2\"; fi; OO_PGO=\"${OODA_PGO_FLAGS:-" + pgo_flags + "}\"; if [ -n \"$OODA_PGO_GEN\" ] || [ \"${OODA_PROFILE_GENERATE:-0}\" = \"1\" ]; then OO_PGO=\"-fprofile-generate\"; elif [ -n \"$OODA_PGO_USE\" ]; then OO_PGO=\"-fprofile-use=$OODA_PGO_USE\"; fi; OO_SAN=\"${OODA_SAN_FLAGS:-" + clang_san + "}\"; OO_LLD=\"\"; if [ -n \"$OODA_USE_LLD\" ] || [ \"${OODA_LLD:-0}\" = \"1\" ] || command -v ld.lld >/dev/null 2>&1 || command -v lld >/dev/null 2>&1 || command -v lld-link >/dev/null 2>&1; then if command -v lld-link >/dev/null 2>&1 && [ -n \"" + target_triple + "\" ]; then OO_LLD=\"-fuse-ld=lld-link\"; else OO_LLD=\"-fuse-ld=lld\"; fi; fi; clang " + clang_dbg + clang_tr + "$OO_OPT $OO_LTO_FLAGS $OO_PGO $OO_SAN $OO_LLD -Wno-override-module -Wno-unused-command-line-argument -Iruntime $OO_SSL_C " + shell_sq(tmp_ll) + " runtime/chs_rt.c -lm -ldl -lpthread $OO_SSL_L -o " + shell_sq(out);
    let ipl_probe = "if [ \"${OODA_IN_PROCESS_LINK:-0}\" = \"1\" ] || [ \"${OODA_IN_PROCESS_LINK:-0}\" = \"true\" ]; then echo 1; else echo 0; fi";
    let ipl_res = sys_exec(sys, "sh", "-c", ipl_probe);
    let mut use_ipl = false;
    if ipl_res.is_ok() {
        let ipl_p = match ipl_res { Ok(s) => str_trim(s), Err(e) => "" };
        if ipl_p == "1" { use_ipl = true;
        }
    }
    let mut in_process_ok = false;
    if use_ipl {
        let mut is_dbg_val: Int = 0;
        if is_dbg { is_dbg_val = 1;
        }
        let ipl_cfg: List[String] = native_link_config_new(out, opt_flag, is_dbg_val, "");
        let r_ipl: Result[String, String] = native_compile_and_link(sys, tmp_ll, out, "runtime/chs_rt.c", ipl_cfg);
        if r_ipl.is_ok() { in_process_ok = true;
        }
    }
    if !in_process_ok { let r_clang: Result[String, String] = sys_exec(sys, "sh", "-c", clang_cmd);
    if !r_clang.is_ok() { println("ERR\tbuild\tclang compilation failed");
    process_exit(1);
    }
    }
    println("OK\tbuild\t" + out);
    if in_process_ok { println("in-process link OK");
    } else {
        println("shell-out link OK");
    }
    return;
}

pub fn target_shortname_to_triple(sname: String) -> String {
    if sname == "aarch64" || sname == "arm64" || sname == "aarch64-linux" { return "aarch64-unknown-linux-gnu";
}
    if sname == "aarch64-darwin" || sname == "darwin" || sname == "macos" {
        return "aarch64-apple-darwin";
    }
    if sname == "wasm" || sname == "wasm32" || sname == "wasi" {
        return "wasm32-unknown-wasi";
    }
    if sname == "x86_64" || sname == "native" || sname == "" {
        return "";
    }
    return sname;
}

pub fn run_build_target_shortname(sys: &ProcessCap, path: String, out: String, sname: String, opt: String, release: Bool, is_debug: Bool) {
    let triple: String = target_shortname_to_triple(sname);
    if sname != "" && sname != "x86_64" && sname != "native" {
        println("target\tshortname=" + sname + " triple=" + triple);
    }
    run_build_llvm(sys, path, out, false, opt, false, release, is_debug, triple, false, "", "");
}

pub fn run_build_llvm_ssa(sys: &ProcessCap, path: String, out: String, is_bc: Bool, opt: String, lto: Bool, release: Bool, is_debug: Bool, target_triple: String, pgo_gen: Bool, pgo_use: String, sanitizers: String) {
    println("# SSA path");
}
