// # Parse oodac CLI argv
//
// Logline: Walk argv for C-backend cmd, path, and out. Residual flags exit.
//
// Setup: path_exists and file_size on FsReadCap. Usage matches dispatched commands.
//
// Beats:
//   1. Accept --backend c, --json-errors, --plain, -o. Reject residual flags.
//   2. Require a readable path under 64KiB.
//   3. Pack cmd, path, out, backend, json-errors, plain.

pub fn parse_cli_argv(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, args: List[String]) -> List[String] {
    let usage: String = "oodac: usage: tokens|check|build|emit-c|emit-protos|emit-bodies|emit-preamble <file>";
    if list_len(args) < 1 {
        println(usage);
        process_exit(2);
    }
    let mut cmd: String = "";
    let mut path: String = "";
    let mut out_arg: String = "";
    let mut backend: String = "c";
    let mut json_errors: Bool = false;
    let mut is_plain: Bool = false;
    let mut npos: Int = 0;
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "--backend" {
            if i + 1 >= list_len(args) {
                println("ERR\tbackend\tmissing value");
                process_exit(2);
            }
            let bv: String = list_get(args, i + 1);
            if bv != "c" {
                println("ERR\tbackend\tresidual: " + bv);
                process_exit(2);
            }
            backend = bv;
            i = i + 2;
        } else if a == "--json-errors" || a == "-json" || a == "--json" {
            json_errors = true;
            i = i + 1;
        } else if a == "-g" || a == "--debug" || a == "--plain" {
            is_plain = true;
            i = i + 1;
        } else if a == "-o" {
            if i + 1 >= list_len(args) {
                println("ERR\t-o\tmissing value");
                process_exit(2);
            }
            out_arg = list_get(args, i + 1);
            i = i + 2;
        } else if chars_len(a) >= 3 && str_slice(a, 0, 3) == "-o=" {
            out_arg = str_slice(a, 3, chars_len(a));
            i = i + 1;
        } else if a == "--help" || a == "-h" {
            println(usage);
            process_exit(0);
        } else if chars_len(a) >= 1 && str_slice(a, 0, 1) == "-" {
            println("ERR\tflag\tresidual: " + a);
            process_exit(2);
        } else {
            if npos == 0 { cmd = a; }
            else if npos == 1 { path = a; }
            else if npos == 2 { out_arg = a; }
            else {
                println("oodac: too many arguments");
                process_exit(2);
            }
            npos = npos + 1;
            i = i + 1;
        }
    }
    if cmd == "" {
        println(usage);
        process_exit(2);
    }
    if cmd != "tokens" && cmd != "check" && cmd != "build" && cmd != "emit-c" && cmd != "emit-protos" && cmd != "emit-bodies" && cmd != "emit-preamble" {
        println("ERR\tcmd\tresidual: " + cmd);
        process_exit(2);
    }
    if path == "" {
        println("oodac: missing file argument");
        process_exit(2);
    }
    if !path_exists(fs_r, path) {
        println("ERR\t" + cmd + "\tunreadable file: " + path);
        process_exit(2);
    }
    let fsz: Int = file_size(fs_r, path);
    if fsz > 65536 {
        println("ERR\tload\tsource exceeds 64KiB per-file limit");
        process_exit(1);
    }
    let mut packed: List[String] = list_new();
    packed = list_push(packed, cmd);
    packed = list_push(packed, path);
    packed = list_push(packed, out_arg);
    packed = list_push(packed, backend);
    let mut f_je: String = "0";
    if json_errors { f_je = "1"; }
    packed = list_push(packed, f_je);
    let mut f_pl: String = "0";
    if is_plain { f_pl = "1"; }
    packed = list_push(packed, f_pl);
    return packed;
}
