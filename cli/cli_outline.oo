// # CLI Semantic Outline Extractor
//
// Logline: Extract and render public signatures, struct schemas, and trait definitions with ~1.3% token footprint.
//
// Setup: FsCap reads source files; SysCap executes directory probes; output is compressed plain text or JSON.
//
// Beats:
//   1. Walk token stream to parse public functions, struct/type schemas, and traits.
//   2. Format compact outline lines or aggregate structured JSON symbol summaries.
//   3. Support single-file outlines and recursive directory multi-file summaries.
fn outline_pack(line: String, pos: Int) -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, line);
    out = list_push(out, pos.to_string());
    return out;
}
fn outline_item_line(item: List[String]) -> String {
    if list_len(item) < 1 { return ""; } return list_get(item, 0);
}
fn outline_item_pos(item: List[String]) -> Int {
    if list_len(item) < 2 { return 0; } return parse_int(list_get(item, 1));
}
fn outline_skip_braces(toks: List[String], pos0: Int) -> Int {
    let n = list_len(toks);
    let mut pos = pos0 + 1;
    let mut depth = 1;
    while pos < n && depth > 0 {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "LBRACE" { depth = depth + 1; }
        if k == "RBRACE" { depth = depth - 1; }
        pos = pos + 1;
    }
    return pos;
}
pub fn outline_render_source(src: String) -> String {
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut pos: Int = 0;
    let mut out: String = "";
    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "EOF" { pos = n; }
        else if k == "KW_PUB" {
            if pos + 1 < n {
                let k2: String = field_at(list_get(toks, pos + 1), 0);
                if k2 == "KW_FN" {
                    let item: List[String] = outline_parse_fn(toks, pos + 2, n, true);
                    if outline_item_line(item) != "" { out = out + outline_item_line(item) + "\n"; }
                    pos = outline_item_pos(item);
                } else if k2 == "KW_TYPE" {
                    let item: List[String] = outline_parse_type(toks, pos + 2, n, true);
                    if outline_item_line(item) != "" { out = out + outline_item_line(item) + "\n"; }
                    pos = outline_item_pos(item);
                } else if k2 == "IDENT" && field_at(list_get(toks, pos + 1), 3) == "trait" {
                    let item: List[String] = outline_parse_trait(toks, pos + 2, n, true);
                    if outline_item_line(item) != "" { out = out + outline_item_line(item) + "\n"; }
                    pos = outline_item_pos(item);
                } else { pos = pos + 1; }
            } else { pos = pos + 1; }
        } else if k == "KW_FN" {
            while pos < n { let fk: String = field_at(list_get(toks, pos), 0); if fk == "LBRACE" { pos = outline_skip_braces(toks, pos); break; } if fk == "SEMI" { pos = pos + 1; break; } pos = pos + 1; }
        } else if k == "KW_TYPE" {
            let item: List[String] = outline_parse_type(toks, pos + 1, n, false);
            if outline_item_line(item) != "" { out = out + outline_item_line(item) + "\n"; }
            pos = outline_item_pos(item);
        } else if k == "IDENT" && field_at(list_get(toks, pos), 3) == "trait" {
            let item: List[String] = outline_parse_trait(toks, pos + 1, n, false);
            if outline_item_line(item) != "" { out = out + outline_item_line(item) + "\n"; }
            pos = outline_item_pos(item);
        } else if k == "KW_VERIFY" {
            pos = pos + 1;
            if pos < n && field_at(list_get(toks, pos), 0) == "IDENT" { pos = pos + 1; }
            if pos < n && field_at(list_get(toks, pos), 0) == "LBRACE" { pos = outline_skip_braces(toks, pos); }
        } else { pos = pos + 1; }
    }
    return out;
}
fn outline_parse_fn(toks: List[String], pos0: Int, n: Int, is_pub: Bool) -> List[String] {
    let mut pos: Int = pos0;
    if pos >= n || field_at(list_get(toks, pos), 0) != "IDENT" { return outline_pack("", pos); }
    let name: String = field_at(list_get(toks, pos), 3);
    pos = pos + 1;
    if pos < n && field_at(list_get(toks, pos), 0) == "LPAREN" { pos = pos + 1; }
    let mut params: String = "";
    let mut caps: String = "";
    let mut first: Bool = true;
    while pos < n {
        let pk: String = field_at(list_get(toks, pos), 0);
        if pk == "RPAREN" { pos = pos + 1; break; }
        if pk == "COMMA" { pos = pos + 1; }
        else if pk == "AMP" || pk == "IDENT" {
            if pk == "AMP" { pos = pos + 1; }
            if pos < n && field_at(list_get(toks, pos), 0) == "IDENT" {
                let pname: String = field_at(list_get(toks, pos), 3);
                pos = pos + 1;
                let mut pty: String = "";
                if pos < n && field_at(list_get(toks, pos), 0) == "COLON" {
                    pos = pos + 1;
                    if pos < n && field_at(list_get(toks, pos), 0) == "AMP" { pty = "&"; pos = pos + 1; }
                    while pos < n {
                        let nk: String = field_at(list_get(toks, pos), 0);
                        if nk == "COMMA" || nk == "RPAREN" { break; }
                        pty = pty + field_at(list_get(toks, pos), 3);
                        pos = pos + 1;
                    }
                }
                if str_index_of(pty, "Cap") >= 0 { if caps != "" { caps = caps + ","; } caps = caps + pty; }
                if !first { params = params + ", "; }
                first = false;
                params = params + pname;
                if pty != "" { params = params + ": " + pty; }
            }
        } else { pos = pos + 1; }
    }
    let mut ret_ty: String = "";
    if pos < n && field_at(list_get(toks, pos), 0) == "ARROW" {
        pos = pos + 1;
        while pos < n {
            let rk: String = field_at(list_get(toks, pos), 0);
            if rk == "LBRACE" || rk == "KW_REQUIRES" || rk == "KW_ENSURES" || rk == "SEMI" { break; }
            ret_ty = ret_ty + field_at(list_get(toks, pos), 3);
            pos = pos + 1;
        }
    }
    while pos < n {
        let bk: String = field_at(list_get(toks, pos), 0);
        if bk == "LBRACE" { pos = outline_skip_braces(toks, pos); break; }
        if bk == "SEMI" { pos = pos + 1; break; }
        pos = pos + 1;
    }
    let mut line: String = "fn " + name + "(" + params + ")";
    if is_pub { line = "pub fn " + name + "(" + params + ")"; }
    if ret_ty != "" { line = line + " -> " + ret_ty; }
    if caps != "" { line = line + " caps=" + caps; }
    return outline_pack(line, pos);
}
fn outline_parse_type(toks: List[String], pos0: Int, n: Int, is_pub: Bool) -> List[String] {
    let mut pos: Int = pos0;
    if pos >= n || field_at(list_get(toks, pos), 0) != "IDENT" { return outline_pack("", pos); }
    let name: String = field_at(list_get(toks, pos), 3);
    pos = pos + 1;
    let mut type_body: String = "";
    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "SEMI" { pos = pos + 1; break; }
        if k == "LBRACE" {
            type_body = type_body + "{ ";
            pos = pos + 1;
            let mut first_f: Bool = true;
            while pos < n {
                let fk: String = field_at(list_get(toks, pos), 0);
                if fk == "RBRACE" { pos = pos + 1; break; }
                if fk == "COMMA" { pos = pos + 1; }
                else if fk == "IDENT" {
                    let fname: String = field_at(list_get(toks, pos), 3);
                    pos = pos + 1;
                    let mut fty: String = "";
                    if pos < n && field_at(list_get(toks, pos), 0) == "COLON" {
                        pos = pos + 1;
                        while pos < n {
                            let tk: String = field_at(list_get(toks, pos), 0);
                            if tk == "COMMA" || tk == "RBRACE" { break; }
                            fty = fty + field_at(list_get(toks, pos), 3);
                            pos = pos + 1;
                        }
                    }
                    if !first_f { type_body = type_body + ", "; }
                    first_f = false;
                    type_body = type_body + fname + ": " + fty;
                } else { pos = pos + 1; }
            }
            type_body = type_body + " }";
            if pos < n && field_at(list_get(toks, pos), 0) == "SEMI" { pos = pos + 1; }
            break;
        }
        let txt: String = field_at(list_get(toks, pos), 3);
        if txt == "=" || txt == "struct" { if type_body != "" { type_body = type_body + " "; } type_body = type_body + txt; }
        pos = pos + 1;
    }
    let mut line: String = "type " + name;
    if is_pub { line = "pub type " + name; }
    if type_body != "" { line = line + " " + type_body; }
    return outline_pack(line, pos);
}
fn outline_parse_trait(toks: List[String], pos0: Int, n: Int, is_pub: Bool) -> List[String] {
    let mut pos: Int = pos0;
    if pos >= n || field_at(list_get(toks, pos), 0) != "IDENT" { return outline_pack("", pos); }
    let name: String = field_at(list_get(toks, pos), 3);
    pos = pos + 1;
    let mut methods: String = "";
    if pos < n && field_at(list_get(toks, pos), 0) == "LBRACE" {
        pos = pos + 1;
        while pos < n {
            let k: String = field_at(list_get(toks, pos), 0);
            if k == "RBRACE" { pos = pos + 1; break; }
            if k == "KW_FN" {
                let item: List[String] = outline_parse_fn(toks, pos + 1, n, false);
                if outline_item_line(item) != "" { if methods != "" { methods = methods + "; "; } methods = methods + outline_item_line(item); }
                pos = outline_item_pos(item);
            } else { pos = pos + 1; }
        }
    }
    let mut line: String = "trait " + name + " { " + methods + " }";
    if is_pub { line = "pub trait " + name + " { " + methods + " }"; }
    return outline_pack(line, pos);
}
pub fn outline_render_source_json(src: String) -> String {
    let mut fns = "["; let mut tys = "["; let mut trs = "[";
    let mut f1 = true; let mut f2 = true; let mut f3 = true;
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut pos: Int = 0;
    while pos < n {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "KW_PUB" && pos + 1 < n {
            let k2: String = field_at(list_get(toks, pos + 1), 0);
            if k2 == "KW_FN" && pos + 2 < n {
                if !f1 { fns = fns + ","; }
                fns = fns + "\"" + field_at(list_get(toks, pos + 2), 3) + "\""; f1 = false;
            } else if k2 == "KW_TYPE" && pos + 2 < n {
                if !f2 { tys = tys + ","; }
                tys = tys + "\"" + field_at(list_get(toks, pos + 2), 3) + "\""; f2 = false;
            } else if k2 == "IDENT" && field_at(list_get(toks, pos + 1), 3) == "trait" && pos + 2 < n {
                if !f3 { trs = trs + ","; }
                trs = trs + "\"" + field_at(list_get(toks, pos + 2), 3) + "\""; f3 = false;
            }
        }
        pos = pos + 1;
    }
    return "{\"functions\":" + fns + "],\"types\":" + tys + "],\"traits\":" + trs + "],\"verifies\":[]}";
}
pub fn run_cli_outline(fs: &FsReadCap, sys: &ProcessCap, args: List[String]) {
    if list_len(args) < 2 { println("ooda outline: missing path"); process_exit(2); }
    let mut path: String = ""; let mut is_json: Bool = false; let mut i: Int = 1;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "--json" || a == "-json" { is_json = true; } else if path == "" { path = a; }
        i = i + 1;
    }
    if !path_exists(fs, path) { println("ERR\toutline\tunreadable path: " + path); process_exit(2); }
    let rf: Result[String, String] = read_file(fs, path);
    if rf.is_ok() {
        let src: String = match rf { Ok(s) => s, Err(e) => e };
        if is_json { println(outline_render_source_json(src)); }
        else { let out: String = outline_render_source(src); if chars_len(out) > 0 { println(out); } }
        process_exit(0);
    }
    process_exit(1);
}
