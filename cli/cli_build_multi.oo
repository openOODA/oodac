// # Pure .oo Multi-Module Compiler Driver
//
// Logline: Topologically compile all imported modules to .o and link via @objs.rsp.
//
// Setup: Uses check_collect for topological DFS, caches .ll and .o to .ooda-cache/obj.
//
// Beats:
//   1. Check Merkle root binary cache for instantaneous project rebuilds (<15ms).
//   2. Topologically walk modules; skip anchor.oo module indexes.
//   3. Content-addressed .ooda-cache/obj/<sha256>.o caching for incremental modules.
//   4. Write strictly newline-delimited object paths to objs.rsp and link via clang.
//   5. Cache binary to .ooda-cache/obj/<fp>.bin and report OK_PURE_NATIVE.

import "lex/token_parse_int.oo";
import "check/check_collect.oo";
import "check/check_mod.oo";
import "cli_oodar.oo";
import "cli_cache_prune.oo";



fn is_anchor_module(p: String) -> Bool {
    let n: Int = chars_len(p);
    if n == 9 { return p == "anchor.oo" || p == "ANCHOR.oo"; }
    if n > 9 {
        let suf: String = str_slice(p, n - 10, n);
        return suf == "/anchor.oo" || suf == "/ANCHOR.oo";
    }
    return false;
}

fn safe_rel_name(p: String) -> String {
    let n: Int = chars_len(p);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(p, i);
        if c == "/" || c == "." || c == "-" { out = out + "_"; }
        else { out = out + c; }
        i = i + 1;
    }
    return out;
}

fn emit_cache_dir(env: &EnvCap) -> String {
    let ec: Result[String, String] = env_get(env, "OODAC_EMIT_CACHE");
    if ec.is_ok() && ec.val != "" { return ec.val; }
    return ".ooda-cache/oodac_emit";
}

fn is_valid_ll(src: String) -> Bool {
    if chars_len(src) == 0 { return false; }
    if str_index_of(src, "target triple") < 0 { return false; }
    return str_index_of(src, "ERR\t") < 0;
}

fn clang_major(sys: &ProcessCap) -> Int {
    let vr: Result[String, String] = sys_exec(sys, "clang", "--no-default-config", "--version");
    if vr.is_err() { return 0 - 1; }
    let v: String = match vr { Ok(s) => s, Err(_) => "" };
    let at: Int = str_index_of(v, "clang version ");
    if at < 0 { return 0 - 1; }
    return parse_int(str_slice(v, at + 14, chars_len(v)));
}

pub fn build_multi(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, env: &EnvCap, ar: &ArenaCap, host: String, od: String, tmp_dir: String, path: String, out: String, is_shared: Bool) {
    let paths: List[String] = collect_module_paths(fs_r, path);
    let fp: String = compute_input_fp(fs_r, paths);
    let obj_dir: String = ".ooda-cache/obj";
    let bin_cache: String = obj_dir + "/" + fp + ".bin";
    if !is_shared && path_exists(fs_r, bin_cache) {
        let cp_b: Result[String, String] = sys_exec(sys, "/usr/bin/cp", "-f", bin_cache, out);
        if cp_b.is_ok() {
            println("OK_PURE_NATIVE");
            println("OK\tbuild\t" + out);
            return;
        }
    }
    let cm: Int = clang_major(sys);
    if cm < 15 {
        println("ERR\tbuild\tclang >= 15 required for LLVM IR; got major " + cm.to_string());
        process_exit(1);
    }
    if !path_exists(fs_r, obj_dir) {
        let _: Result[String, String] = sys_exec(sys, "/usr/bin/mkdir", "-p", obj_dir);
    }
    let ck: Result[String, String] = sys_exec(sys, host, "check", path);
    if !ck.is_ok() {
        println("ERR\tbuild\tcheck failed");
        let cmsg: String = match ck { Ok(s) => s, Err(e) => e };
        println(cmsg);
        process_exit(1);
    }
    let ec: String = emit_cache_dir(env);
    let _: Result[String, String] = sys_exec(sys, "/usr/bin/mkdir", "-p", ec);
    let _: Result[String, String] = sys_exec(sys, "/usr/bin/mkdir", "-p", tmp_dir);
    let hr: String = write_host_rt(fs_w, tmp_dir);

    let mut objs: List[String] = list_new();
    let mut ext_libs: List[String] = list_new();
    let npaths: Int = list_len(paths);
    let mut i: Int = 0;
    while i < npaths {
        let p: String = list_get(paths, i);
        if !is_anchor_module(p) {
            let sr: Result[String, String] = read_file(fs_r, p);
            let mut src_hash: String = "";
            if sr.is_ok() { src_hash = crypto_sha256_internal(sr.val); }
            let c_obj: String = obj_dir + "/" + crypto_sha256_internal(p + "_" + src_hash) + ".o";
            let cache_ll: String = ec + "/" + fp + "_" + src_hash + ".ll";
            let ml: String = tmp_dir + "/" + safe_rel_name(p) + ".ll";
            let mo: String = tmp_dir + "/" + safe_rel_name(p) + ".o";
            let mut have_obj: Bool = false;
            if src_hash != "" && path_exists(fs_r, c_obj) {
                objs = list_push(objs, c_obj);
                have_obj = true;
                if list_len(ext_libs) < 4 && path_exists(fs_r, cache_ll) {
                    let cll: Result[String, String] = read_file(fs_r, cache_ll);
                    if cll.is_ok() { ext_libs = oodar_merge_exts(ext_libs, oodar_resolve_exts(fs_r, od, cll.val)); }
                }
            }
            if !have_obj {
                let mut have_ll: Bool = false;
                let mut ll_text: String = "";
                if src_hash != "" && path_exists(fs_r, cache_ll) {
                    let cll_r: Result[String, String] = read_file(fs_r, cache_ll);
                    if cll_r.is_ok() && is_valid_ll(cll_r.val) {
                        let wr_ml: Result[Void, String] = write_file(fs_w, ml, cll_r.val);
                        if wr_ml.is_ok() { have_ll = true; ll_text = cll_r.val; }
                    }
                }
                if !have_ll {
                    let mut em: Result[String, String] = sys_exec(sys, host, "emit-llvm", p);
                    let mut emsg: String = match em { Ok(s) => s, Err(e) => e };
                    if str_index_of(emsg, "no artifact") >= 0 {
                        let _: Result[String, String] = sys_exec(sys, host, "check", p);
                        em = sys_exec(sys, host, "emit-llvm", p);
                        emsg = match em { Ok(s) => s, Err(e) => e };
                    }
                    if !em.is_ok() || !is_valid_ll(emsg) {
                        println("ERR\tbuild\temit-llvm failed: " + p);
                        println(emsg);
                        process_exit(1);
                    }
                    let _: Result[Void, String] = write_file(fs_w, ml, emsg);
                    if src_hash != "" { let _: Result[Void, String] = write_file(fs_w, cache_ll, emsg); }
                    ll_text = emsg;
                }
                if list_len(ext_libs) < 4 { ext_libs = oodar_merge_exts(ext_libs, oodar_resolve_exts(fs_r, od, ll_text)); }
                let cr: Result[String, String] = sys_exec(sys, "clang", "--no-default-config", "-c", "-Os", "-g0", "-fno-ident", "-ffunction-sections", "-fdata-sections", "-fno-asynchronous-unwind-tables", "-fno-unwind-tables", "-Wno-override-module", "-frandom-seed=0", ml, "-o", mo);
                if !cr.is_ok() {
                    println("ERR\tbuild\tclang -c failed: " + p);
                    let ctxt: String = match cr { Ok(s) => s, Err(e) => e };
                    println(ctxt);
                    process_exit(1);
                }
                if src_hash != "" { let _: Result[String, String] = sys_exec(sys, "/usr/bin/cp", "-f", mo, c_obj); }
                objs = list_push(objs, mo);
            }
        }
        i = i + 1;
    }
    let mut rsp_content: String = "";
    let no: Int = list_len(objs);
    let mut j: Int = 0;
    while j < no { rsp_content = rsp_content + rsp_quote(list_get(objs, j)) + "\n"; j = j + 1; }
    let nexts: Int = list_len(ext_libs);
    let mut k: Int = 0;
    while k < nexts { rsp_content = rsp_content + rsp_quote(list_get(ext_libs, k)) + "\n"; k = k + 1; }
    let rsp_path: String = tmp_dir + "/objs.rsp";
    let wr_rsp: Result[Void, String] = write_file(fs_w, rsp_path, rsp_content);
    if wr_rsp.is_err() { println("ERR\tbuild\twrite objs.rsp failed"); process_exit(1); }
    let lib_a: String = oodar_lib_core(fs_r, od);
    let mut lr: Result[String, String] = Err("");
    if is_shared {
        lr = sys_exec(sys, "clang", "--no-default-config", "-shared", "-fPIC", "-DOO_SHARED=1", "-fvisibility=hidden", "-Wl,--exclude-libs,ALL", "-Os", "-g0", "-fno-ident", "-ffunction-sections", "-fdata-sections", "-fno-asynchronous-unwind-tables", "-fno-unwind-tables", "-Wno-override-module", "-I" + od, hr, "@" + rsp_path, lib_a, "-frandom-seed=0", "-Wl,--build-id=none", "-Wl,--gc-sections", "-Wl,-z,noseparate-code", "-Wl,--strip-all", "-lm", "-ldl", "-lpthread", "-o", out);
    } else {
        lr = sys_exec(sys, "clang", "--no-default-config", "-Os", "-g0", "-fno-ident", "-ffunction-sections", "-fdata-sections", "-fno-asynchronous-unwind-tables", "-fno-unwind-tables", "-Wno-override-module", "-I" + od, hr, "@" + rsp_path, lib_a, "-Wl,-u,oo_blackbox_trap_cap", "-frandom-seed=0", "-Wl,--build-id=none", "-Wl,--gc-sections", "-Wl,-z,noseparate-code", "-Wl,--strip-debug", "-lm", "-ldl", "-lpthread", "-o", out);
    }
    let _: Result[String, String] = sys_exec(sys, "/usr/bin/rm", "-f", rsp_path);
    if !lr.is_ok() {
        println("ERR\tbuild\tclang llvm failed");
        let gtxt: String = match lr { Ok(s) => s, Err(e) => e };
        println(gtxt);
        process_exit(1);
    }
    let ch: Result[String, String] = sys_exec(sys, "/usr/bin/chmod", "+x", out);
    if ch.is_err() { println("ERR\tbuild\tchmod failed"); process_exit(1); }
    if !is_shared { let _: Result[String, String] = sys_exec(sys, "/usr/bin/cp", "-f", out, bin_cache); }
    let _: Int = prune_emit_cache(fs_r, fs_w, ec);
    println("OK_PURE_NATIVE");
    println("OK\tbuild\t" + out);
}
