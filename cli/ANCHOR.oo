// ──▓▓ Public CLI API ──▓▓──

pub fn cli_parse_args(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, argv: List[String]) -> List[String] {
    return parse_cli_argv(fs_r, fs_w, sys, argv);
}

pub fn cli_run_ast(fs: &FsReadCap, sys: &ProcessCap, args: List[String]) {
    run_cli_ast(fs, sys, args);
}

pub fn cli_run_emit_c(fs: &FsReadCap, sys: &ProcessCap, cmd: String, path: String, is_plain: Bool) {
    run_emit_c_family(fs, sys, cmd, path, is_plain);
}

pub fn cli_ast_dump(src: String) -> String {
    return ast_dump_source(src);
}
