// # CLI Subsystem — Module Entry Door
//
// Logline: Command-line parse, LLVM build, and emit-llvm dispatch.
//
// Setup: Imports CLI parse, build, emit-c, and emit-llvm plus the compiler ANCHORs.
//
// Beats:
//   1. Import parser, build, emit-c, and emit-llvm siblings.
//   2. Re-export parse_cli_argv, run_build_san, and run_emit_c_family.
//   3. Preserve <= 256 lines.

import "lex/anchor.oo";
import "ast/anchor.oo";
import "check/anchor.oo";
import "types/anchor.oo";
import "cli_build.oo";
import "cli_emit.oo";
import "cli_emit_llvm.oo";
import "cli_parse.oo";
import "cli_cache_prune.oo";

// ──▓▓ Public CLI API ──▓▓──
// parse_cli_argv, run_build_san, and run_emit_c_family are pub on the imports.

pub fn cli_parse_args(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, argv: List[String]) -> List[String] {
    return parse_cli_argv(fs_r, fs_w, sys, argv);
}

pub fn cli_run_emit_c(fs: &FsReadCap, env: &EnvCap, cmd: String, path: String, is_plain: Bool) {
    run_emit_c_family(fs, env, cmd, path, is_plain, false, "");
}

pub fn cli_lru_prune(fs_r: &FsReadCap, fs_w: &FsWriteCap, cache_dir: String, max_b: Int, target_b: Int) -> Int {
    return lru_cache_prune(fs_r, fs_w, cache_dir, max_b, target_b);
}
