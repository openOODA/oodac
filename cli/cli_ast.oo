// # CLI AST Tree Structure Dumper
//
// Logline: Dump structured abstract syntax tree node representations and summaries for source files and modules.
//
// Setup: FsReadCap reads source files; outputs hierarchical node structures.
//
// Beats:
//   1. Parse source tokens into hierarchical AST structures using tokenize_lines.
//   2. Dump indented and tagged representation of program items, statements, and expressions.
//   3. Handle CLI argument dispatch and path resolution for single files and modules.



fn skip_braces(toks: List[String], pos0: Int) -> Int {
    let n = list_len(toks);
    let mut pos = pos0 + 1;
    let mut depth = 1;
    while pos < n && depth > 0 {
        let k: String = field_at(list_get(toks, pos), 0);
        if k == "LBRACE" { depth = depth + 1;
        }
        if k == "RBRACE" { depth = depth - 1;
        }
        pos = pos + 1;
    }
    return pos;
}

pub fn ast_dump_source(src: String) -> String {
    let toks: List[String] = tokenize_lines(src);
let n: Int = list_len(toks);
let mut pos: Int = 0;
let mut out: String = "PROGRAM\n";
let mut item_idx: Int = 0;
while pos < n { let k: String = field_at(list_get(toks, pos), 0);
if k == "EOF" { pos = n;
} else if k == "KW_PUB" || k == "KW_FN" {
            let mut is_pub: Bool = false;
            if k == "KW_PUB" { is_pub = true;
            pos = pos + 1;
            }
            if pos < n && field_at(list_get(toks, pos), 0) == "KW_FN" { pos = pos + 1;
            }
            let mut fname: String = "<anon>";
            if pos < n && field_at(list_get(toks, pos), 0) == "IDENT" {
                fname = field_at(list_get(toks, pos), 3);
                pos = pos + 1;
            }
            let idx_str: String = item_idx.to_string();
            let mut pub_tag: String = "";
            if is_pub { pub_tag = "pub ";
            }
            out = out + "  ITEM[" + idx_str + "] FN " + pub_tag + fname + "\n";
            item_idx = item_idx + 1;
            while pos < n {
                let bk: String = field_at(list_get(toks, pos), 0);
                if bk == "LBRACE" { pos = skip_braces(toks, pos);
                break;
                }
                if bk == "SEMI" { pos = pos + 1;
                break;
                }
                pos = pos + 1;
            }
        } else if k == "KW_TYPE" {
            pos = pos + 1;
            let mut tname: String = "<anon>";
            if pos < n && field_at(list_get(toks, pos), 0) == "IDENT" {
                tname = field_at(list_get(toks, pos), 3);
                pos = pos + 1;
            }
            let idx_str: String = item_idx.to_string();
            out = out + "  ITEM[" + idx_str + "] TYPE name=" + tname + "\n";
            item_idx = item_idx + 1;
            while pos < n {
                let tk: String = field_at(list_get(toks, pos), 0);
                if tk == "SEMI" { pos = pos + 1;
                break;
                }
                if tk == "RBRACE" { pos = pos + 1;
                break;
                }
                pos = pos + 1;
            }
        } else if k == "KW_IMPORT" {
            pos = pos + 1;
            let mut ipath: String = "";
            while pos < n {
                let tk: String = field_at(list_get(toks, pos), 0);
                if tk == "SEMI" { pos = pos + 1;
                break;
                }
                ipath = ipath + field_at(list_get(toks, pos), 3);
                pos = pos + 1;
            }
            let idx_str: String = item_idx.to_string();
            out = out + "  ITEM[" + idx_str + "] IMPORT path=" + ipath + "\n";
            item_idx = item_idx + 1;
        } else {
            pos = pos + 1;
        }
    }
    return out;
}

pub fn run_cli_ast(fs: &FsReadCap, sys: &ProcessCap, args: List[String]) {
    if list_len(args) < 2 { println("ooda ast: missing path");
    process_exit(2);
    }
    let mut path: String = "";
    let mut i: Int = 1;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if str_slice(a, 0, 1) != "-" { if path == "" { path = a;
        } }
        i = i + 1;
    }
    if !path_exists(fs, path) { println("ERR\tast\tunreadable path: " + path);
    process_exit(2);
    }
    let rf: Result[String, String] = read_file(fs, path);
    if rf.is_ok() {
        let src: String = match rf { Ok(s) => s, Err(e) => e };
        let out: String = ast_dump_source(src);
        if chars_len(out) > 0 { println(out);
        }
        process_exit(0);
    }
    process_exit(1);
}
