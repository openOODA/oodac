// # Build a source file to a native C binary
//
// Logline: emit-c via ProcessCap argv, write C under the jail, gcc argv.
//
// Setup: Host binary from the tree. C backend only. No sh -c. No OpenSSL fork.
//
// Beats:
//   1. Refuse non-c backends.
//   2. mkdir argv; sys_exec host emit-c; write_file the C.
//   3. One gcc argv with chs_rt.

fn tree_root(fs: &FsReadCap) -> String {
    if path_exists(fs, "oodac/runtime/chs_rt.c") { return "oodac"; }
    if path_exists(fs, "runtime/chs_rt.c") { return "."; }
    println("ERR\tbuild\tchs_rt missing");
    process_exit(1);
    return "";
}

pub fn run_build_san(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, path: String, out_arg: String, backend: String) {
    let mut out: String = path + ".bin";
    if out_arg != "" { out = out_arg; }
    if backend != "" && backend != "c" {
        println("ERR\tbuild\tbackend residual: " + backend);
        process_exit(2);
    }
    let tmp_h: String = crypto_sha256_internal(out + ":" + path);
    let tmp_c: String = ".ooda-cache/ooda-tmp/all_" + str_slice(tmp_h, 0, 16) + ".c";
    let mk: Result[String, String] = sys_exec(sys, "mkdir", "-p", ".ooda-cache/ooda-tmp");
    if mk.is_err() {
        println("ERR\tbuild\tmkdir failed");
        process_exit(1);
    }
    let root: String = tree_root(fs_r);
    let host: String = root + "/bin/oodac_bin.core";
    if !path_exists(fs_r, host) {
        println("ERR\tbuild\tcompiler binary not found");
        process_exit(1);
    }
    let em: Result[String, String] = sys_exec(sys, host, "emit-c", path);
    if !em.is_ok() {
        println("ERR\tbuild\temit-c failed");
        process_exit(1);
    }
    let wr: Result[Void, String] = write_file(fs_w, tmp_c, em.val);
    if wr.is_err() {
        println("ERR\tbuild\twrite C failed");
        process_exit(1);
    }
    let rt: String = root + "/runtime";
    let r: Result[String, String] = sys_exec(sys, "gcc", "-O2", "-I" + rt, rt + "/chs_rt.c", tmp_c, "-frandom-seed=0", "-Wl,--build-id=none", "-lm", "-ldl", "-lpthread", "-o", out);
    if !r.is_ok() {
        println("ERR\tbuild\tgcc failed");
        process_exit(1);
    }
    println("OK_PURE_NATIVE");
    println("OK\tbuild\t" + out);
}
