// # Build a source file to a native C binary or shared library
//
// Logline: check then emit-llvm+clang, rocm hipcc, or --backend elf with no clang.
//
// Setup: Host is OODA_COMPILER, OODAC_BIN, or OODA_TOOLCHAIN layout. Links oodar.c or liboodar.a.
//
// Beats:
//   1. Refuse residual backends, compiler-main concat, -o directory, and no main (unless --shared).
//   2. sys_exec host check; on ERR do not emit or link.
//   3. mkdir; emit-llvm (clang -O2), rocm HIP (hipcc gfx1100), or native ELF. --backend c is residual.

import "lex/token_fmt.oo";
import "lex/token_parse_int.oo";
import "check/check_collect.oo";
import "ast/load_import.oo";
import "cli_oodar.oo";
import "cli_build_multi.oo";
import "emit/elf/elf_emit.oo";
import "emit/wasm/anchor.oo";
import "emit/rocm/anchor.oo";

// Probe mirrors the link invocation: --no-default-config keeps distro
// /etc configs (unreadable under the jail) from failing the version check.
fn clang_major(sys: &ProcessCap) -> Int {
    let vr: Result[String, String] = sys_exec(sys, "clang", "--no-default-config", "--version");
    if vr.is_err() { return 0 - 1; }
    let v: String = match vr { Ok(s) => s, Err(_) => "" };
    let at: Int = str_index_of(v, "clang version ");
    if at < 0 { return 0 - 1; }
    return parse_int(str_slice(v, at + 14, chars_len(v)));
}

fn compiler_host(fs_r: &FsReadCap, env: &EnvCap) -> String {
    let oc: Result[String, String] = env_get(env, "OODA_COMPILER");
    if oc.is_ok() {
        if oc.val != "" {
            if path_exists(fs_r, oc.val) { return oc.val; }
            println("ERR\tbuild\tno oodac at OODA_COMPILER");
            process_exit(1);
        }
    }
    let ob: Result[String, String] = env_get(env, "OODAC_BIN");
    if ob.is_ok() {
        if ob.val != "" {
            if path_exists(fs_r, ob.val) { return ob.val; }
            println("ERR\tbuild\tno oodac at OODAC_BIN");
            process_exit(1);
        }
    }
    let tc: Result[String, String] = env_get(env, "OODA_TOOLCHAIN");
    if tc.is_ok() {
        if tc.val != "" && path_exists(fs_r, tc.val + "/bin/oodac") { return tc.val + "/bin/oodac"; }
    }
    println("ERR\tbuild\tOODA_COMPILER or OODAC_BIN required (or OODA_TOOLCHAIN layout)");
    process_exit(1);
    return "";
}

fn src_has_main(src: String) -> Bool {
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_FN" {
            if i + 1 < n {
                let k2: String = field_at(list_get(toks, i + 1), 0);
                let t2: String = field_at(list_get(toks, i + 1), 3);
                if k2 == "IDENT" && t2 == "main" {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

fn path_is_compiler_main(path: String) -> Bool {
    return path == "oodac/main.oo";
}

fn cache_dir(env: &EnvCap) -> String {
    let wd: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
    if wd.is_ok() {
        let s: String = wd.val;
        if s != "" {
            let mut end: Int = chars_len(s);
            let col: Int = str_index_of(s, ":");
            if col >= 0 { end = col; }
            let base: String = str_slice(s, 0, end);
            if base != "" { return base + "/.ooda-cache/ooda-tmp"; }
        }
    }
    return ".ooda-cache/ooda-tmp";
}

pub fn run_build_san(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, env: &EnvCap, ar: &ArenaCap, path: String, out_arg: String, backend: String, is_shared: Bool) {
    let mut out: String = path + ".bin";
    if is_shared { out = path + ".so"; }
    if out_arg != "" { out = out_arg; }
    if backend != "" && backend != "llvm" && backend != "elf" && backend != "wasm" && backend != "rocm" {
        println("ERR\tbuild\tbackend residual: " + backend);
        process_exit(2);
    }
    if path_is_compiler_main(path) {
        println("ERR\tbuild\tcompiler rebuild is unique_fns");
        process_exit(1);
    }
    if path_exists(fs_r, out) {
        if path_exists(fs_r, out + "/.") {
            println("ERR\tbuild\t-o is a directory");
            process_exit(1);
        }
    }
    let sr: Result[String, String] = read_file(fs_r, path);
    if sr.is_err() {
        println("ERR\tbuild\tunreadable file: " + path);
        process_exit(1);
    }
    let src: String = match sr { Ok(s) => s, Err(_) => "" };
    if !is_shared && !src_has_main(src) {
        println("ERR\tbuild\tno main");
        process_exit(1);
    }
    let host: String = compiler_host(fs_r, env);
    let od: String = oodar_root(fs_r, host);
    let tmp_dir: String = cache_dir(env);
    let tmp_h: String = crypto_sha256_internal(path);
    let tmp_ll: String = tmp_dir + "/all_" + str_slice(tmp_h, 0, 16) + ".ll";
    let mk: Result[String, String] = sys_exec(sys, "/usr/bin/mkdir", "-p", tmp_dir);
    if mk.is_err() {
        println("ERR\tbuild\tmkdir failed");
        process_exit(1);
    }
    // Dormant while the unique_fns refusal above stands (pure_build rebuilds).
    let is_multi: Bool = path_is_compiler_main(path);
    if backend != "elf" && is_multi {
        build_multi(fs_r, fs_w, sys, env, ar, host, od, tmp_dir, path, out, is_shared);
        return;
    }
    let ck: Result[String, String] = sys_exec(sys, host, "check", path);
    if !ck.is_ok() {
        println("ERR\tbuild\tcheck failed");
        let cmsg: String = match ck { Ok(s) => s, Err(e) => e };
        println(cmsg);
        process_exit(1);
    }
    let mut b: String = backend;
    if b == "wasm" {
        let mut blob: String = "";
        blob = wasm_emit_program(load_source_with_imports(fs_r, path));
        let wr: Result[Void, String] = write_file(fs_w, out, blob);
        if wr.is_err() {
            println("ERR\tbuild\twrite " + b + " failed");
            process_exit(1);
        }
        println("OK\tbuild\t" + out);
        return;
    }
    if b == "elf" {
        let mut blob: String = "";
        blob = elf_emit_program(src);
        let wr: Result[Void, String] = write_file(fs_w, out, blob);
        if wr.is_err() {
            println("ERR\tbuild\twrite " + b + " failed");
            process_exit(1);
        }
        let ch: Result[String, String] = sys_exec(sys, "/usr/bin/chmod", "+x", out);
        if ch.is_err() {
            println("ERR\tbuild\tchmod ELF failed");
            process_exit(1);
        }
        println("OK\tbuild\t" + out);
        return;
    }
    if b == "rocm" {
        if is_shared {
            println("ERR\tbuild\trocm shared unsupported");
            process_exit(2);
        }
        let hip: String = rocm_emit_program(load_source_with_imports(fs_r, path));
        let tmp_hip: String = tmp_dir + "/rocm_" + str_slice(tmp_h, 0, 16) + ".hip";
        let tmp_o: String = tmp_dir + "/rocm_" + str_slice(tmp_h, 0, 16) + ".o";
        let wr: Result[Void, String] = write_file(fs_w, tmp_hip, hip);
        if wr.is_err() {
            println("ERR\tbuild\twrite rocm hip failed");
            process_exit(1);
        }
        let hc: Result[String, String] = sys_exec(sys, "hipcc", "-O2", "--offload-arch=gfx1100", "-I" + od, "-c", tmp_hip, "-o", tmp_o);
        if !hc.is_ok() {
            println("ERR\tbuild\thipcc rocm failed");
            let hmsg: String = match hc { Ok(s) => s, Err(e) => e };
            println(hmsg);
            process_exit(1);
        }
        let lib_a: String = oodar_lib_core(fs_r, od);
        let gexts: List[String] = oodar_gpu_ext(fs_r, od);
        let rsp_path: String = oodar_link_rsp(fs_w, tmp_dir, tmp_o, gexts);
        let r: Result[String, String] = sys_exec(sys, "clang++", "--no-default-config", "-O2", "@" + rsp_path, lib_a, "-L/opt/rocm/lib", "-lamdhip64", "-lm", "-ldl", "-lpthread", "-o", out);
        let _: Result[String, String] = sys_exec(sys, "/usr/bin/rm", "-f", rsp_path);
        if !r.is_ok() {
            println("ERR\tbuild\tclang++ rocm failed");
            let gtxt: String = match r { Ok(s) => s, Err(e) => e };
            println(gtxt);
            process_exit(1);
        }
        println("OK_PURE_NATIVE");
        println("OK\tbuild\t" + out);
        return;
    }
    let hr: String = write_host_rt(fs_w, tmp_dir);
    if b == "llvm" || b == "" {
        let em: Result[String, String] = sys_exec(sys, host, "emit-llvm", "--concat", path);
        if !em.is_ok() {
            println("ERR\tbuild\temit-llvm failed");
            let emsg: String = match em { Ok(s) => s, Err(e) => e };
            println(emsg);
            process_exit(1);
        }
        let wr: Result[Void, String] = write_file(fs_w, tmp_ll, em.val);
        if wr.is_err() {
            println("ERR\tbuild\twrite LLVM IR failed");
            process_exit(1);
        }
        let lib_a: String = oodar_lib_core(fs_r, od);
        let exts: List[String] = oodar_resolve_exts(fs_r, od, em.val);
        let rsp_path: String = oodar_link_rsp(fs_w, tmp_dir, tmp_ll, exts);
        let cm: Int = clang_major(sys);
        if cm < 15 {
            println("ERR\tbuild\tclang >= 15 required for LLVM IR (opaque pointers); got major " + cm.to_string() + " via PATH");
            process_exit(1);
        }
        let mut r: Result[String, String] = Err("");
        // Gate anchors: strip-debug keeps the symtab the nm probes verify
        // (landlock ctor, blackbox trio); -u keeps trap_cap past gc-sections.
        if is_shared {
            r = sys_exec(sys, "clang", "--no-default-config", "-shared", "-fPIC", "-DOO_SHARED=1", "-fvisibility=hidden", "-Wl,--exclude-libs,ALL", "-Os", "-g0", "-fno-ident", "-ffunction-sections", "-fdata-sections", "-fno-asynchronous-unwind-tables", "-fno-unwind-tables", "-Wno-override-module", "-I" + od, hr, "@" + rsp_path, lib_a, "-frandom-seed=0", "-Wl,--build-id=none", "-Wl,--gc-sections", "-Wl,-z,noseparate-code", "-Wl,--strip-all", "-lm", "-ldl", "-lpthread", "-o", out);
        } else {
            r = sys_exec(sys, "clang", "--no-default-config", "-Os", "-g0", "-fno-ident", "-ffunction-sections", "-fdata-sections", "-fno-asynchronous-unwind-tables", "-fno-unwind-tables", "-Wno-override-module", "-I" + od, hr, "@" + rsp_path, lib_a, "-Wl,-u,oo_blackbox_trap_cap", "-frandom-seed=0", "-Wl,--build-id=none", "-Wl,--gc-sections", "-Wl,-z,noseparate-code", "-Wl,--strip-debug", "-lm", "-ldl", "-lpthread", "-o", out);
        }
        let _: Result[String, String] = sys_exec(sys, "/usr/bin/rm", "-f", rsp_path);
        if !r.is_ok() {
            println("ERR\tbuild\tclang llvm failed");
            let gtxt: String = match r { Ok(s) => s, Err(e) => e };
            println(gtxt);
            process_exit(1);
        }
    } else {
        println("ERR\tbuild\tbackend residual: " + b);
        process_exit(2);
    }
    println("OK_PURE_NATIVE");
    println("OK\tbuild\t" + out);
}
