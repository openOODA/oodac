// # Build a source file to a native C binary
//
// Logline: check then emit-llvm (default) via ProcessCap argv, write IR/C under jail, clang -O2.
//
// Setup: Host is OODA_COMPILER or OODAC_BIN only. Links oodar.c. No sh -c.
//
// Beats:
//   1. Refuse residual backends, compiler-main concat, -o a directory, and no main.
//   2. sys_exec host check; on ERR do not emit or clang.
//   3. mkdir; emit-llvm (default, clang -O2) or emit-c; oodar.c plus host_rt.

import "lex/token_fmt.oo";
import "cli_oodar.oo";

fn compiler_host(env: &EnvCap) -> String {
    let oc: Result[String, String] = env_get(env, "OODA_COMPILER");
    if oc.is_ok() {
        if oc.val != "" { return oc.val; }
    }
    let ob: Result[String, String] = env_get(env, "OODAC_BIN");
    if ob.is_ok() {
        if ob.val != "" { return ob.val; }
    }
    println("ERR\tbuild\tOODA_COMPILER or OODAC_BIN required");
    process_exit(1);
    return "";
}

fn src_has_main(src: String) -> Bool {
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_FN" {
            if i + 1 < n {
                let k2: String = field_at(list_get(toks, i + 1), 0);
                let t2: String = field_at(list_get(toks, i + 1), 3);
                if k2 == "IDENT" && t2 == "main" {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

fn path_is_compiler_main(path: String) -> Bool {
    let n: Int = chars_len(path);
    if n >= 13 {
        if str_slice(path, n - 13, n) == "oodac/main.oo" {
            return true;
        }
    }
    return path == "oodac/main.oo";
}

fn cache_dir(env: &EnvCap) -> String {
    let wd: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
    if wd.is_ok() {
        if wd.val != "" { return wd.val + "/.ooda-cache/ooda-tmp"; }
    }
    return ".ooda-cache/ooda-tmp";
}

pub fn run_build_san(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, env: &EnvCap, path: String, out_arg: String, backend: String) {
    let mut out: String = path + ".bin";
    if out_arg != "" { out = out_arg; }
    if backend != "" && backend != "c" && backend != "llvm" {
        println("ERR\tbuild\tbackend residual: " + backend);
        process_exit(2);
    }
    if path_is_compiler_main(path) {
        println("ERR\tbuild\tcompiler rebuild is unique_fns");
        process_exit(1);
    }
    if path_exists(fs_r, out) {
        if path_exists(fs_r, out + "/.") {
            println("ERR\tbuild\t-o is a directory");
            process_exit(1);
        }
    }
    let sr: Result[String, String] = read_file(fs_r, path);
    if sr.is_err() {
        println("ERR\tbuild\tunreadable file: " + path);
        process_exit(1);
    }
    let src: String = match sr { Ok(s) => s, Err(_) => "" };
    if !src_has_main(src) {
        println("ERR\tbuild\tno main");
        process_exit(1);
    }
    let host: String = compiler_host(env);
    let od: String = oodar_root(fs_r, host);
    let tmp_dir: String = cache_dir(env);
    let tmp_h: String = crypto_sha256_internal(path);
    let tmp_c: String = tmp_dir + "/all_" + str_slice(tmp_h, 0, 16) + ".c";
    let tmp_ll: String = tmp_dir + "/all_" + str_slice(tmp_h, 0, 16) + ".ll";
    let mk: Result[String, String] = sys_exec(sys, "/usr/bin/mkdir", "-p", tmp_dir);
    if mk.is_err() {
        println("ERR\tbuild\tmkdir failed");
        process_exit(1);
    }
    let ck: Result[String, String] = sys_exec(sys, host, "check", path);
    if !ck.is_ok() {
        println("ERR\tbuild\tcheck failed");
        let cmsg: String = match ck { Ok(s) => s, Err(e) => e };
        println(cmsg);
        process_exit(1);
    }
    let hr: String = write_host_rt(fs_w, tmp_dir);
    if backend == "llvm" || backend == "" {
        let em: Result[String, String] = sys_exec(sys, host, "emit-llvm", "--concat", path);
        if !em.is_ok() {
            println("ERR\tbuild\temit-llvm failed");
            let emsg: String = match em { Ok(s) => s, Err(e) => e };
            println(emsg);
            process_exit(1);
        }
        let wr: Result[Void, String] = write_file(fs_w, tmp_ll, em.val);
        if wr.is_err() {
            println("ERR\tbuild\twrite LLVM IR failed");
            process_exit(1);
        }
        let obj: String = tmp_dir + "/oodar.o";
        let co: Result[String, String] = sys_exec(sys, "/usr/bin/gcc", "-c", "-O2", "-g0", "-fno-ident", "-I" + od, od + "/oodar.c", "-o", obj);
        if !co.is_ok() {
            println("ERR\tbuild\toodar.o failed");
            let ct: String = match co { Ok(s) => s, Err(e) => e };
            println(ct);
            process_exit(1);
        }
        let r: Result[String, String] = sys_exec(sys, "/usr/bin/clang", "--no-default-config", "-O2", "-g0", "-fno-ident", "-Wno-override-module", "-I" + od, obj, hr, tmp_ll, "-frandom-seed=0", "-Wl,--build-id=none", "-Wl,--strip-debug", "-lm", "-ldl", "-lpthread", "-o", out);
        if !r.is_ok() {
            println("ERR\tbuild\tclang llvm failed");
            let gtxt: String = match r { Ok(s) => s, Err(e) => e };
            println(gtxt);
            process_exit(1);
        }
    } else {
        let em: Result[String, String] = sys_exec(sys, host, "emit-c", "--concat", path);
        if !em.is_ok() {
            println("ERR\tbuild\temit-c failed");
            let emsg: String = match em { Ok(s) => s, Err(e) => e };
            println(emsg);
            process_exit(1);
        }
        let wr: Result[Void, String] = write_file(fs_w, tmp_c, em.val);
        if wr.is_err() {
            println("ERR\tbuild\twrite C failed");
            process_exit(1);
        }
        let obj: String = tmp_dir + "/oodar.o";
        let co: Result[String, String] = sys_exec(sys, "/usr/bin/gcc", "-c", "-O2", "-g0", "-fno-ident", "-I" + od, od + "/oodar.c", "-o", obj);
        if !co.is_ok() {
            println("ERR\tbuild\toodar.o failed");
            let ct: String = match co { Ok(s) => s, Err(e) => e };
            println(ct);
            process_exit(1);
        }
        let r: Result[String, String] = sys_exec(sys, "/usr/bin/gcc", "-O2", "-g0", "-fno-ident", "-I" + od, obj, hr, tmp_c, "-frandom-seed=0", "-Wl,--build-id=none", "-Wl,--strip-debug", "-lm", "-ldl", "-lpthread", "-o", out);
        if !r.is_ok() {
            println("ERR\tbuild\tgcc failed");
            let gtxt: String = match r { Ok(s) => s, Err(e) => e };
            println(gtxt);
            process_exit(1);
        }
    }
    println("OK_PURE_NATIVE");
    println("OK\tbuild\t" + out);
}
