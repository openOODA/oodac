// # Build a source file to a native, LLVM, or bitcode binary
//
// Logline: Emits C, LLVM IR, bitcode (.bc), or x86_64 .s, then links via lld/clang/gcc/ld with parallel chunk and cryptographic AST caching.
//
// Setup: Expands module imports, collects whole-program generic instances, verifies SHA-256 AST caches, and coordinates native multi-threaded compilation.
//
// Beats:
//   1. When out_arg is empty, binary path is path.bin; .bc outputs trigger direct llvm-as/clang bitcode emission.
//   2. On x86, emit-x86 to a temp .s and as+ld it. On llvm/bc, emit-llvm and compile to .bc or link via clang/lld.
//   3. On native C, verifies in-process SHA-256 AST caches and partitions generic monomorphization chunks.
//   4. Compiles module translation units and monomorphization chunks in parallel, linking deterministic binaries.


import "cli_build_cc.oo";

import "cli_build_sovereign.oo";

import "cli_build_targets.oo";



fn build_shell_sq(s: String) -> String {
    let n: Int = chars_len(s);
let mut i: Int = 0;
let mut out: String = "'";
while i < n { let c: String = char_at(s, i);
if c == "'" { out = out + "'\\''";
} else {
            out = out + c;
        }
        i = i + 1;
    }
    return out + "'";
}

pub fn gcc_repro_flags() -> String {
    return "-frandom-seed=0 -Wl,--build-id=none";
}

fn build_sanitize_stamp(stamp: String) -> String {
    let n: Int = chars_len(stamp);
let mut out: String = "";
let mut i: Int = 0;
while i < n { let c: String = char_at(stamp, i);
if c == ":" { out = out + "_";
} else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn run_build_san(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, path: String, out_arg: String, backend: String, opt: String, lto: Bool, release: Bool, is_debug: Bool, quiet: Bool, target_triple: String, pgo_gen: Bool, pgo_use: String, sanitizers: String) {
    let mut out = path + ".bin";
    if out_arg != "" { out = out_arg;
    }
    let mut eff_backend = backend;
    if chars_len(out) >= 5 && str_slice(out, chars_len(out) - 5, chars_len(out)) == ".wasm" {
        if eff_backend != "wasm-gc" && eff_backend != "wasm-linear" && eff_backend != "wasm-dual" {
            eff_backend = "wasm";
        }
    }

    if is_sovereign_backend(eff_backend) {
        let sov_ok: Bool = run_build_sovereign(fs_r, fs_w, sys, path, out, eff_backend);
        if sov_ok { println("OK\tbuild\t" + out);
        return;
        } else {
            println("ERR\tbuild\t" + eff_backend + " failed");
            process_exit(1);
        }
    }
    let mut is_bc = false;
    if backend == "bc" || (chars_len(out) >= 3 && str_slice(out, chars_len(out) - 3, chars_len(out)) == ".bc") { is_bc = true;
    }
    if backend == "llvm" || is_bc { run_build_llvm(sys, path, out, is_bc, opt, lto, release, is_debug, target_triple, pgo_gen, pgo_use, sanitizers);
    return;
    }

    let le_res: List[String] = load_expand(fs_r, path, list_new(), list_new());
    let n_le = list_len(le_res);
    let mut mods: List[String] = list_new();
    let mut i = 0;
    while i + 1 < n_le { mods = list_push(mods, list_get(le_res, i));
    i = i + 1;
    }

    let host: String = "./bin/oodac";
    let stamp: String = oo_file_stamp(host);
    let stamp_s: String = build_sanitize_stamp(stamp);
    let repro: String = gcc_repro_flags();

    let lto_s: String = if lto { "1" } else { "0" };
    let rel_s: String = if release { "1" } else { "0" };
    let dbg_s: String = if is_debug { "1" } else { "0" };
    let flags_sig: String = eff_backend + ":" + opt + ":" + repro + ":" + sanitizers + ":" + lto_s + ":" + rel_s + ":" + dbg_s;
    let mut full_sig: String = "FLAGS:" + flags_sig + "\nHOST:" + stamp + "\n";
    let nmods: Int = list_len(mods);
    let mut mi: Int = 0;
    while mi < nmods { let m: String = list_get(mods, mi);
    full_sig = full_sig + m + "=" + oo_file_stamp(m) + "\n";
    mi = mi + 1;
    }
    let manifest_hash: String = crypto_sha256_internal(full_sig);

    if c_cache_check_binary_manifest(fs_r, out, manifest_hash) {
        if !quiet { println("OK_PURE_NATIVE");
        println("OK\tbuild\t" + out);
        }
        return;
    }

    let tmp_h: String = crypto_sha256_internal(out + ":" + path);
    let tmp_all_c: String = ".ooda-cache/ooda-tmp/all_" + str_slice(tmp_h, 0, 16) + ".tmp.c";
    let _mk_tmp: Result[String, String] = sys_exec(sys, "sh", "-c", "mkdir -p .ooda-cache/ooda-tmp");

    let extra_decls: String = "printf 'OoLL_S oo_ll_S_new(void); OoLL_S oo_ll_S_push(OoLL_S,OoSList); OoLL_S oo_ll_S_set(OoLL_S,long long,OoSList); OoSList oo_ll_S_get(OoLL_S,long long); long long oo_ll_S_len(OoLL_S); void oo_ll_S_release(OoLL_S); void oo_ll_S_retain(OoLL_S);\\nOoLL_I oo_ll_I_new(void); OoLL_I oo_ll_I_push(OoLL_I,OoIList); OoLL_I oo_ll_I_set(OoLL_I,long long,OoIList); OoIList oo_ll_I_get(OoLL_I,long long); long long oo_ll_I_len(OoLL_I); void oo_ll_I_release(OoLL_I); void oo_ll_I_retain(OoLL_I);\\nOoLL_F oo_ll_F_new(void); OoLL_F oo_ll_F_push(OoLL_F,OoFList); OoLL_F oo_ll_F_set(OoLL_F,long long,OoFList); OoFList oo_ll_F_get(OoLL_F,long long); long long oo_ll_F_len(OoLL_F); void oo_ll_F_release(OoLL_F); void oo_ll_F_retain(OoLL_F);\\n' >> " + build_shell_sq(tmp_all_c);
    let r_pre: Result[String, String] = sys_exec(sys, "sh", "-c", "export OODAC_BIN=\"${OODAC_BIN:-" + host + "}\" && OODA_EMIT_NO_CONCAT=1 OODA_EMIT_NO_PREAMBLE=1 EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 $OODAC_BIN emit-preamble " + build_shell_sq(path) + " > " + build_shell_sq(tmp_all_c) + " && " + extra_decls);
    if !r_pre.is_ok() { println("ERR\tbuild\tpreamble failed");
    process_exit(1);
    }

    let cdir: String = ".ooda-cache/oodac_emit";
    let _mk: Result[String, String] = sys_exec(sys, "sh", "-c", "mkdir -p " + cdir);
    let pre_c: String = cdir + "/preamble_" + stamp_s + ".c";
    let r_cp: Result[String, String] = sys_exec(sys, "sh", "-c", "cp " + build_shell_sq(tmp_all_c) + " " + build_shell_sq(pre_c));
    if !r_cp.is_ok() { println("ERR\tbuild\tpreamble cache failed");
    process_exit(1);
    }

    let mut skip: Int = 0;
    let mut pbs: List[String] = list_new();
    let mut j = 0;
    while j < nmods {
        let m = list_get(mods, j);
        let h: String = c_cache_module_hash(fs_r, m, stamp_s, repro);
        let cf: String = cdir + "/" + stamp_s + "_" + h + ".pb.c";
        let of: String = cdir + "/" + stamp_s + "_" + h + ".o";
        let hit: Bool = c_cache_verify_hit(fs_r, cf, of);
        if !hit {
            let cmd_emit: String = "export OODAC_BIN=\"${OODAC_BIN:-" + host + "}\" && mkdir -p " + build_shell_sq(cdir) + " && TMPF=$(mktemp /tmp/oo_pb.XXXXXX.c) && env -u PURE_NO_ARC -u OODA_PURE_NO_ARC OODA_EMIT_NO_CONCAT=1 OODA_EMIT_NO_PREAMBLE=1 EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 $OODAC_BIN emit-protos " + build_shell_sq(m) + " > \"$TMPF\" && OODA_EMIT_NO_CONCAT=1 OODA_EMIT_NO_PREAMBLE=1 EMIT_NO_CONCAT=1 EMIT_NO_PREAMBLE=1 $OODAC_BIN emit-bodies " + build_shell_sq(m) + " >> \"$TMPF\" && mv -f \"$TMPF\" " + build_shell_sq(cf);
            let r_emit: Result[String, String] = sys_exec(sys, "sh", "-c", cmd_emit);
            if !r_emit.is_ok() { println("ERR\tbuild\temit failed on " + m);
            process_exit(1);
            }
        } else {
            skip = skip + 1;
        }
        pbs = list_push(pbs, cf);
        let rcat: Result[String, String] = sys_exec(sys, "sh", "-c", "cat " + build_shell_sq(cf) + " >> " + build_shell_sq(tmp_all_c));
        if !rcat.is_ok() { println("ERR\tbuild\tcache cat failed on " + m);
        process_exit(1);
        }
        j = j + 1;
    }

    let reg: List[String] = c_mono_collect_modules(fs_r, mods);
    let nreg: Int = list_len(reg);
    if nreg > 0 { let chunk_paths: List[String] = c_mono_emit_all_chunks(fs_w, sys, reg, cdir, 4);
    let nchunks: Int = list_len(chunk_paths);
    let mut k: Int = 0;
    while k < nchunks { pbs = list_push(pbs, list_get(chunk_paths, k));
    k = k + 1;
    }
    }

    if !quiet { println("emit_cache skip=" + skip.to_string() + " of " + nmods.to_string());
    }
    if is_autovec_opt(opt) {
        let _e: Result[String, String] = sys_exec(sys, "sh", "-c", "export OODA_AUTOVEC=1");
    }
    run_native_cc(fs_r, fs_w, sys, pbs, pre_c, out, repro, quiet, sanitizers);
    c_cache_write_binary_manifest(fs_w, sys, out, manifest_hash);
    let _rm_tmp: Result[String, String] = sys_exec(sys, "rm", "-f", tmp_all_c);
    if !quiet { println("OK_PURE_NATIVE");
    println("OK\tbuild\t" + out);
    }
}

pub fn run_build_debug_pgo(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, path: String, out_arg: String, backend: String, opt: String, lto: Bool, release: Bool, is_debug: Bool, quiet: Bool, target_triple: String, pgo_gen: Bool, pgo_use: String) {
    run_build_san(fs_r, fs_w, sys, path, out_arg, backend, opt, lto, release, is_debug, quiet, target_triple, pgo_gen, pgo_use, "");
}

pub fn run_build_debug(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, path: String, out_arg: String, backend: String, opt: String, lto: Bool, release: Bool, is_debug: Bool, quiet: Bool, target_triple: String) {
    run_build_san(fs_r, fs_w, sys, path, out_arg, backend, opt, lto, release, is_debug, quiet, target_triple, false, "", "");
}

pub fn run_build_opt(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, path: String, out_arg: String, backend: String, opt: String, lto: Bool, release: Bool, quiet: Bool, target_triple: String) {
    run_build_debug(fs_r, fs_w, sys, path, out_arg, backend, opt, lto, release, false, quiet, target_triple);
}

pub fn run_build_cmd(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, path: String, out_arg: String, backend: String, quiet: Bool) {
    run_build_opt(fs_r, fs_w, sys, path, out_arg, backend, "", false, false, quiet, "");
}
