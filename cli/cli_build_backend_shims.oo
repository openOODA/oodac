// # LLVM LTO compilation pipeline / Direct x86-64 and SSA Assembly Target Builder / Profile-Guided Optimization & JIT Execution Engine
//
// Logline: Wires the automated opt / llc LTO pipeline with aggressive loop unrolling and SLP vectorization, so `ooda build --target llvm --lto` or `-Oaggrlto` produces thinLTO bitcode linked through llvm-as and assembled via llc. Invokes emit-x86 and emit-x86-ssa pipelines, assembling with as and linking with ld. Executes multi-stage GCC PGO profiling runs and LLVM JIT execution for CLI builds.
//
// Setup: Merged cohesive compiler module. Zero fallback cascades and ambient variable hunting.
//
// Beats:
//   1. Unified cohesive implementation.
//   2. Fail closed on missing tools without shell heuristic fallbacks.
//   3. Maintain <= 256 lines limit.


pub fn is_aggrlto_opt(opt: String) -> Bool {
    return opt == "aggrlto" || opt == "-Oaggrlto" || opt == "lto+vec";
}

// Run opt with aggressive loop unroll + SLP vectorize on the .ll file.
// Returns path to the optimized .ll, or empty string on error.
pub fn run_opt_aggressive(sys: &ProcessCap, in_ll: String) -> String {
    let out_ll: String = in_ll + ".opt.ll";
    let cmd: String = "opt -O3 -vectorize-slp -enable-loop-unroll -unroll-count=8 -inline-threshold=1000 -S " + in_ll + " -o " + out_ll;
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if r.is_ok() {
        return out_ll;
    }
    return "";
}

// Assemble .ll to .o via llc, then link with clang -flto=thin.
pub fn run_llc_link(sys: &ProcessCap, in_ll: String, out: String) -> Bool {
    let tmp_o: String = out + ".lto.o";
    let llc_cmd: String = "llc -O3 -filetype=obj " + in_ll + " -o " + tmp_o;
    let r_llc: Result[String, String] = sys_exec(sys, "sh", "-c", llc_cmd);
    if !r_llc.is_ok() {
        return false;
    }
    let link_cmd: String = "clang -O3 -flto=thin -Wno-override-module -Wno-unused-command-line-argument -Iruntime " + tmp_o + " runtime/chs_rt.c -lm -ldl -lpthread -o " + out;
    let r_link: Result[String, String] = sys_exec(sys, "sh", "-c", link_cmd);
    return r_link.is_ok();
}

// Aggressive-LTO build entry: opt + llc + clang-flto link.
pub fn run_build_aggrlto(sys: &ProcessCap, path: String, out: String, target_triple: String) -> Bool {
    let tmp_ll: String = out + ".tmp.ll";
    let emit_cmd: String = "OODAC_BIN=\"${OODAC_BIN:-./ooda/oodac_bin}\" && $OODAC_BIN emit-llvm " + path + " > " + tmp_ll;
    let r_emit: Result[String, String] = sys_exec(sys, "sh", "-c", emit_cmd);
    if !r_emit.is_ok() {
        return false;
    }
    let opt_ll: String = run_opt_aggressive(sys, tmp_ll);
    if opt_ll == "" {
        return false;
    }
    return run_llc_link(sys, opt_ll, out);
}

pub fn run_build_x86(sys: &ProcessCap, path: String, out: String) {
    let tmp_s = out + ".tmp.s";
    let tmp_o = out + ".tmp.o";
    let r_emit: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-./ooda/oodac_bin}\" && $OODAC_BIN emit-x86 " + shell_sq(path) + " > " + shell_sq(tmp_s));
    if !r_emit.is_ok() {
        println("ERR\tbuild\temit-x86 failed");
        process_exit(1);
    }
    let r_as: Result[String, String] = sys_exec(sys, "sh", "-c", "as --64 -o " + shell_sq(tmp_o) + " " + shell_sq(tmp_s));
    if !r_as.is_ok() {
        println("ERR\tbuild\tas failed");
        process_exit(1);
    }
    let r_ld: Result[String, String] = sys_exec(sys, "sh", "-c", "ld -o " + shell_sq(out) + " " + shell_sq(tmp_o));
    if r_ld.is_ok() {
        println("OK\tbuild\t" + out);
        return;
    } else {
        println("ERR\tbuild\tld failed");
        process_exit(1);
    }
}

pub fn run_build_x86_ssa(sys: &ProcessCap, path: String, out: String) {
    let tmp_s = out + ".tmp.s";
    let tmp_o = out + ".tmp.o";
    let tmp_full = out + ".tmp.full.s";
    let entry_stub = "    .text\n    .globl _start\n    .p2align 4\n_start:\n    push %rbp\n    mov %rsp, %rbp\n    call main\n    mov %rax, %rdi\n    mov $60, %rax\n    syscall\n";
    let r_emit: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-./ooda/oodac_bin}\" && $OODAC_BIN emit-x86-ssa " + shell_sq(path) + " > " + shell_sq(tmp_s) + " 2>" + shell_sq(tmp_s + ".err"));
    if !r_emit.is_ok() {
        println("ERR\tbuild\temit-x86-ssa failed");
        process_exit(1);
    }
    let r_pre: Result[String, String] = sys_exec(sys, "sh", "-c", "if grep -q '_start:' " + shell_sq(tmp_s) + "; then cp -f " + shell_sq(tmp_s) + " " + shell_sq(tmp_full) + "; else { printf '%s' " + shell_sq(entry_stub) + "; cat " + shell_sq(tmp_s) + "; } > " + shell_sq(tmp_full) + "; fi");
    if !r_pre.is_ok() {
        println("ERR\tbuild\tentry_stub_concat failed");
        process_exit(1);
    }
    let r_as: Result[String, String] = sys_exec(sys, "sh", "-c", "as --64 -o " + shell_sq(tmp_o) + " " + shell_sq(tmp_full));
    if !r_as.is_ok() {
        println("ERR\tbuild\tas failed");
        process_exit(1);
    }
    let r_ld: Result[String, String] = sys_exec(sys, "sh", "-c", "ld -o " + shell_sq(out) + " " + shell_sq(tmp_o));
    if r_ld.is_ok() {
        println("OK\tbuild\t" + out);
        return;
    } else {
        println("ERR\tbuild\tld failed");
        process_exit(1);
    }
}

pub fn run_build_pgo(sys: &ProcessCap, path: String, out: String, sanitizers: String) {
    let tmp_c: String = out + ".pgo.tmp.c";
    let work: String = out + ".pgo.work";
    let r_mk: Result[String, String] = sys_exec(sys, "sh", "-c", "rm -rf " + shell_sq(work) + " && mkdir -p " + shell_sq(work));
    if !r_mk.is_ok() {
        println("ERR\tbuild\tpgo workdir failed");
        process_exit(1);
    }
    let pwd_res = sys_exec(sys, "sh", "-c", "pwd");
    let proj_root: String = match pwd_res { Ok(s) => str_trim(s), Err(e) => "" };
    let rt_path: String = proj_root + "/runtime/chs_rt.c";
    let src_path: String = proj_root + "/" + tmp_c;
    let r_emit: Result[String, String] = sys_exec(sys, "sh", "-c", "OODAC_BIN=\"${OODAC_BIN:-./ooda/oodac_bin}\" && $OODAC_BIN emit-c " + shell_sq(path) + " > " + shell_sq(tmp_c));
    if !r_emit.is_ok() {
        println("ERR\tbuild\tpgo emit-c failed");
        process_exit(1);
    }
    let gen_cmd = "cd " + shell_sq(work) + " && gcc -O2 -fprofile-generate -I" + shell_sq(proj_root) + " " + shell_sq(src_path) + " " + shell_sq(rt_path) + " -lm -ldl -lpthread -o " + shell_sq(out);
    let r_gen: Result[String, String] = sys_exec(sys, "sh", "-c", gen_cmd);
    if !r_gen.is_ok() {
        println("ERR\tbuild\tpgo instrumented compile failed");
        process_exit(1);
    }
    println("OK\tpgo_gen\t" + out);
    let run_cmd = "cd " + shell_sq(work) + " && " + shell_sq(out);
    let r_run: Result[String, String] = sys_exec(sys, "sh", "-c", run_cmd);
    if !r_run.is_ok() {
        println("ERR\tbuild\tpgo run failed");
        process_exit(1);
    }
    let use_cmd = "cd " + shell_sq(work) + " && gcc -O2 -fprofile-use -fprofile-correction -I" + shell_sq(proj_root) + " " + shell_sq(src_path) + " " + shell_sq(rt_path) + " -lm -ldl -lpthread -o " + shell_sq(out);
    let r_use: Result[String, String] = sys_exec(sys, "sh", "-c", use_cmd);
    if !r_use.is_ok() {
        println("ERR\tbuild\tpgo profile-use link failed");
        process_exit(1);
    }
    println("OK\tpgo_use\t" + out);
    println("OK\tbuild\t" + out);
}

pub fn run_build_jit(fs: &FsReadCap, sys: &ProcessCap, path: String, out: String) {
    let tmp_ll: String = out + ".tmp.jit.ll";
    let tmp_err: String = out + ".tmp.jit.err";
    let tmp_st: String = out + ".tmp.jit.st";
    let _mk: Result[String, String] = sys_exec(sys, "sh", "-c", "mkdir -p .ooda-cache/ooda-tmp");
    let r: Result[String, String] = sys_exec(sys, "sh", "-c",
        "OODAC_BIN=\"${OODAC_BIN:-./ooda/oodac_bin}\" && $OODAC_BIN emit-llvm "
        + shell_sq(path) + " > " + shell_sq(tmp_ll) + " 2> " + shell_sq(tmp_err));
    if !r.is_ok() {
        println("ERR\tjit\temit-llvm failed");
        process_exit(1);
    }
    let run_cmd: String = "{ lli " + shell_sq(tmp_ll)
        + "; printf '%d' \"$?\" > " + shell_sq(tmp_st)
        + "; } 2>> " + shell_sq(tmp_err);
    let _rr: Result[String, String] = sys_exec(sys, "sh", "-c", run_cmd);
    let mut rc: Int = 1;
    let st: Result[String, String] = read_file(fs, tmp_st);
    if st.is_ok() {
        let raw: String = match st { Ok(s) => s, Err(e) => e };
        let trimmed: String = str_trim(raw);
        if chars_len(trimmed) > 0 {
            rc = parse_int(trimmed);
        }
    }
    if rc == 0 {
        println("OK\tjit\t" + out);
    } else {
        println("ERR\tjit\trc=" + rc.to_string());
    }
    process_exit(rc);
}
