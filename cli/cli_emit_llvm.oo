// # Run LLVM IR and bitcode emission
//
// Logline: Turns emit-llvm commands into streamed LLVM IR text, module multi-file IR, or module graphs.
//
// Setup: load_import, llvm_emit, and llvm_link_shim are imported. Caps are FsReadCap and ProcessCap.
//
// Beats:
//   1. Build LLVM function symbol table from imports or cache.
//   2. Extract target triple and sanitizer instrumentation flags.
//   3. Stream LLVM IR for single files or whole multi-module graphs.
// RULES.oot 1.7: Under 256 lines.






pub fn llvm_import_fntab(fs: &FsReadCap, path: String) -> String {
    let le: List[String] = load_expand(fs, path, list_new(), list_new());
    let n: Int = list_len(le);
    let mut tab: String = "";
    let mut i: Int = 0;
    while i + 1 < n {
        let p: String = list_get(le, i);
        let src_r: Result[String, String] = read_file(fs, p);
        if src_r.is_ok() {
            let s: String = match src_r { Ok(x) => x, Err(m) => m };
            tab = tab + llvm_fntab_of_src(s);
        }
        i = i + 1;
    }
    return tab;
}

pub fn llvm_fntab_from_env(fs: &FsReadCap, sys: &ProcessCap, path: String) -> String {
    let cached: String = ".ooda-cache/ooda-tmp/llvm_fntab.txt";
    if path_exists(fs, cached) {
        let rr: Result[String, String] = read_file(fs, cached);
        if rr.is_ok() {
            let body: String = match rr { Ok(s) => s, Err(m) => m };
            if chars_len(body) > 8 { return body;
            }
        }
    }
    return llvm_import_fntab(fs, path);
}

pub fn llvm_target_triple_from_env(fs: &FsReadCap, sys: &ProcessCap) -> String {
    let tf: String = ".ooda-cache/ooda-tmp/target_triple.txt";
    let cmd: String = "mkdir -p .ooda-cache/ooda-tmp && printf '%s' \"$OODA_TARGET_TRIPLE\" > " + shell_sq(tf);
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if r.is_ok() {
        let rr: Result[String, String] = read_file(fs, tf);
        if rr.is_ok() { return match rr { Ok(s) => s, Err(e) => "" };
        }
    }
    return "";
}

pub fn llvm_sanitize_from_env(fs: &FsReadCap, sys: &ProcessCap) -> String {
    let sf: String = ".ooda-cache/ooda-tmp/sanitize.txt";
    let cmd: String = "mkdir -p .ooda-cache/ooda-tmp && printf '%s' \"${OODA_SANITIZE:-${SANITIZE:-$OODA_FSANITIZE}}\" > " + shell_sq(sf);
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    if r.is_ok() {
        let rr: Result[String, String] = read_file(fs, sf);
        if rr.is_ok() { return match rr { Ok(s) => s, Err(e) => "" };
        }
    }
    return "";
}

pub fn run_emit_llvm(fs: &FsReadCap, sys: &ProcessCap, path: String, backend: String) {
    run_emit_llvm_san(fs, sys, path, backend, false, "", "");
}

pub fn run_emit_llvm_target(fs: &FsReadCap, sys: &ProcessCap, path: String, backend: String, triple_arg: String) {
    run_emit_llvm_san(fs, sys, path, backend, false, triple_arg, "");
}

pub fn run_emit_llvm_opt(fs: &FsReadCap, sys: &ProcessCap, path: String, backend: String, is_debug: Bool, triple_arg: String) {
    run_emit_llvm_san(fs, sys, path, backend, is_debug, triple_arg, "");
}

pub fn run_emit_llvm_san(fs: &FsReadCap, sys: &ProcessCap, path: String, backend: String, is_debug: Bool, triple_arg: String, san_arg: String) {
    let mut tr: String = triple_arg;
    if tr == "" { tr = llvm_target_triple_from_env(fs, sys);
    }
    let mut san_str: String = san_arg;
    if san_str == "" { san_str = llvm_sanitize_from_env(fs, sys);
    }
    let mut san_markers: String = "";
    if str_index_of(san_str, "address") >= 0 { san_markers = san_markers + "|__san_address__|";
    }
    if str_index_of(san_str, "thread") >= 0 { san_markers = san_markers + "|__san_thread__|";
    }
    if str_index_of(san_str, "undefined") >= 0 { san_markers = san_markers + "|__san_undefined__|";
    }
    if str_index_of(san_str, "fuzzer") >= 0 { san_markers = san_markers + "|__san_fuzzer__|";
    }

    let probe_concat = "if [ -n \"$EMIT_NO_CONCAT\" ] || [ -n \"$OODA_EMIT_NO_CONCAT\" ]; then exit 0; else exit 1; fi";
    let no_concat_res = sys_exec(sys, "sh", "-c", probe_concat);
    let mut no_concat = true;
    if no_concat_res.is_ok() || backend == "llvm" { no_concat = true;
    }
    let probe_pre = "if [ -n \"$EMIT_NO_PREAMBLE\" ] || [ -n \"$OODA_EMIT_NO_PREAMBLE\" ]; then exit 0; else exit 1; fi";
    let no_pre_res = sys_exec(sys, "sh", "-c", probe_pre);
    let mut no_pre = false;
    if no_pre_res.is_ok() { no_pre = true;
    }
    let probe_dbg = "if [ -n \"$OODA_DEBUG\" ] || [ -n \"$DEBUG\" ] || [ \"$OODA_LLVM_DEBUG\" = \"1\" ]; then exit 0; else exit 1; fi";
    let dbg_res = sys_exec(sys, "sh", "-c", probe_dbg);
    let mut is_dbg = is_debug;
    if dbg_res.is_ok() { is_dbg = true;
    }

    let mut src = "";
    if no_concat {
        let src_r = read_file(fs, path);
        if src_r.is_ok() {
            src = match src_r { Ok(s) => s, Err(msg) => msg };
        } else {
            println("ERR\tload\tunreadable file: " + path);
            process_exit(1);
        }
        llvm_emit_stream_full(src, no_pre, llvm_fntab_from_env(fs, sys, path) + san_markers, path, is_dbg, tr);
        return;
    }
    src = load_source_with_imports(fs, path);
    run_check_core(sys, src);
    llvm_emit_stream_full(src, no_pre, san_markers, path, is_dbg, tr);
}

pub fn run_print_llvm_fntab(fs: &FsReadCap, path: String) {
    let tab_str: String = llvm_import_fntab(fs, path);
    println(tab_str);
}

pub fn run_print_llvm_graph(fs: &FsReadCap, path: String) {
    let le: List[String] = load_expand(fs, path, list_new(), list_new());
    let n: Int = list_len(le);
    let mut i: Int = 0;
    while i + 1 < n { println(list_get(le, i));
    i = i + 1;
    }
}

pub fn llvm_mod_ll_name(path: String) -> String {
    let n: Int = chars_len(path);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(path, i);
        if c == "/" { out = out + "_";
        } else { out = out + c;
        }
        i = i + 1;
    }
    return out + ".ll";
}

pub fn run_emit_llvm_mods(fs: &FsReadCap, sys: &ProcessCap, path: String, outdir: String) {
    if outdir == "" { println("ERR\temit-mods\tmissing outdir");
    process_exit(2);
    }
    if sys_exec(sys, "sh", "-c", "mkdir -p " + shell_sq(outdir)).is_err() { println("ERR\temit-mods\tmkdir");
    process_exit(1);
    }
    let le: List[String] = load_expand(fs, path, list_new(), list_new());
    let n: Int = list_len(le);
    let mut listing: String = "";
    let mut i: Int = 0;
    while i + 1 < n { let p: String = list_get(le, i);
    listing = listing + p + "\n";
    i = i + 1;
    }
    let listp: String = outdir + "/list.txt";
    if sys_exec(sys, "sh", "-c", "printf '%s' " + shell_sq(listing) + " > " + shell_sq(listp)).is_err() {
        println("ERR\temit-mods\tlist");
        process_exit(1);
    }
    let tab: String = llvm_import_fntab(fs, path);
    let tabp: String = ".ooda-cache/ooda-tmp/llvm_fntab.txt";
    if sys_exec(sys, "sh", "-c", "mkdir -p .ooda-cache/ooda-tmp && printf '%s' " + shell_sq(tab) + " > " + shell_sq(tabp)).is_err() {
        println("ERR\temit-mods\tfntab");
        process_exit(1);
    }
    let shimp: String = outdir + "/_shim.ll";
    if sys_exec(sys, "sh", "-c", "printf '%s' " + shell_sq(llvm_link_shim_text()) + " > " + shell_sq(shimp)).is_err() {
        println("ERR\temit-mods\tshim");
        process_exit(1);
    }
    i = 0;
    while i + 1 < n {
        let p2: String = list_get(le, i);
        let ll: String = outdir + "/" + llvm_mod_ll_name(p2);
        let cmd: String = "OODA_LLVM_FNTAB_FILE=" + shell_sq(tabp) + " OODAC_BIN=\"${OODAC_BIN:-${OODA_COMPILER:-./oodac/oodac}}\" && $OODAC_BIN --backend llvm emit-llvm " + shell_sq(p2) + " > " + shell_sq(ll);
        if sys_exec(sys, "sh", "-c", cmd).is_err() {
            println("ERR\temit-mods\temit " + p2);
            process_exit(1);
        }
        i = i + 1;
    }
    println("OK\temit-mods\t" + outdir);
}
