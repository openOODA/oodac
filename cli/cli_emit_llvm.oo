// # Run emit-llvm from artifact or tokenize-once
//
// Logline: Same concat/one-TU rules as emit-c. Artifact toks only. No emit/c import.
//
// Setup: Artifact cache from check. load_expand for concat.
//
// Beats:
//   1. --concat or OODA_EMIT_CONCAT=1 walks imports.
//   2. Else one-TU toks.
//   3. ll_emit_stream_toks prints IR.

import "lex/token_fmt.oo";
import "check/check_collect.oo";
import "check/check_artifact.oo";
import "types/typed_artifact.oo";
import "emit/llvm/anchor.oo";
import "emit/llvm/ll_emit.oo";
import "emit/llvm/ll_struct.oo";
import "emit/llvm/ll_tok.oo";
import "lex/token_parse_int.oo";

fn parse_arena_id(res: Result[String, String]) -> Int {
    if res.is_err() { return 0 - 1; }
    let s: String = match res { Ok(v) => v, Err(_) => "" };
    if chars_len(s) >= 7 && str_slice(s, 0, 6) == "arena:" {
        return parse_int(str_slice(s, 6, chars_len(s)));
    }
    return parse_int(s);
}

fn ll_concat(env: &EnvCap) -> Bool {
    let r: Result[String, String] = env_get(env, "OODA_EMIT_CONCAT");
    let v: String = match r { Ok(s) => s, Err(_) => "" };
    return v == "1";
}

fn ll_extra_root(env: &EnvCap, path: String) -> String {
    let r: Result[String, String] = env_get(env, "OODA_LLVM_SIGS_ROOT");
    let v: String = match r { Ok(s) => s, Err(_) => "" };
    if v != "" { return v; }
    return path;
}

fn ll_load_art(fs: &FsReadCap, dest: String) -> TypedArtifact {
    if !path_exists(fs, dest) {
        println("ERR\tllvm\tno artifact");
        process_exit(1);
    }
    let rr: Result[String, String] = read_file(fs, dest);
    if rr.is_err() {
        println("ERR\tllvm\tartifact unreadable");
        process_exit(1);
    }
    let body: String = match rr { Ok(s) => s, Err(_) => "" };
    return artifact_decode(body);
}

fn ll_skip_anchor_tu(p: String) -> Bool {
    let n: Int = chars_len(p);
    if n < 9 { return false; }
    return str_slice(p, n - 9, n) == "ANCHOR.oo";
}

fn ll_smt_sanitize(smt: String) -> String {
    let n: Int = chars_len(smt);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(smt, i);
        if c == "\t" {
            out = out + "|";
        } else if c == "\n" {
            out = out + ",";
        } else if c == ";" {
            out = out + ":";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

fn ll_art_file(fs: &FsReadCap, path: String, src: String) -> TypedArtifact {
    let auto: String = artifact_cache_path(artifact_sha(path, src));
    if !path_exists(fs, auto) {
        println("ERR\tllvm\tno artifact; run check first: " + path);
        process_exit(1);
    }
    let art: TypedArtifact = ll_load_art(fs, auto);
    let want: String = artifact_sha(path, src);
    if !(art.sha == want) {
        println("ERR\tllvm\tartifact sha mismatch");
        process_exit(1);
    }
    artifact_verify_sections(art, "llvm");
    return art;
}

fn ll_toks_file(fs: &FsReadCap, path: String, src: String) -> List[String] {
    let art: TypedArtifact = ll_art_file(fs, path, src);
    return art.toks;
}

pub fn run_emit_llvm(fs: &FsReadCap, fs_w: &FsWriteCap, env: &EnvCap, ar: &ArenaCap, path: String, concat: Bool) {
    if !concat && !ll_concat(env) {
        let pr: Result[String, String] = read_file(fs, path);
        if pr.is_err() {
            println("ERR\tload\tunreadable file: " + path);
            process_exit(1);
        }
        let src: String = match pr { Ok(s) => s, Err(_) => "" };
        let art: TypedArtifact = ll_art_file(fs, path, src);
        let toks: List[String] = art.toks;
        let root: String = ll_extra_root(env, path);
        let cx: Result[String, String] = env_get(env, "OODA_LLVM_EXTRA_CACHE");
        let cp: String = match cx { Ok(s) => s, Err(_) => "" };
        let mut extra: String = "";
        if cp != "" && path_exists(fs, cp) {
            let er: Result[String, String] = read_file(fs, cp);
            extra = match er { Ok(s) => s, Err(_) => "" };
        } else {
            let ar_res: Result[String, String] = arena_create(ar, 65536);
            let ar_id: Int = parse_arena_id(ar_res);
            let paths: List[String] = collect_module_paths(fs, root);
            let mut st_all: String = "";
            let mut i: Int = 0;
            while i < list_len(paths) {
                let ip: String = list_get(paths, i);
                let mut skip: Bool = ip == path && root == path;
                if ll_skip_anchor_tu(ip) { skip = true; }
                if !skip {
                    let ir: Result[String, String] = read_file(fs, ip);
                    if ir.is_ok() {
                        let isrc: String = match ir { Ok(s) => s, Err(_) => "" };
                        let auto: String = artifact_cache_path(artifact_sha(ip, isrc));
                        if path_exists(fs, auto) {
                            let itoks: List[String] = ll_toks_file(fs, ip, isrc);
                            st_all = ll_struct_declare(itoks, st_all);
                            extra = extra + ll_collect_pub_sigs(itoks, ll_struct_tab_of(st_all));
                        }
                    }
                    if ar_id >= 0 {
                        let _: Result[String, String] = arena_reset(ar, ar_id);
                    }
                }
                i = i + 1;
            }
            if ar_id >= 0 {
                let _: Result[String, String] = arena_destroy(ar, ar_id);
            }
            extra = st_all + extra;
            if cp != "" {
                let _: Result[Void, String] = write_file(fs_w, cp, extra);
            }
        }
        if art.smt != "" {
            let s_smt: String = ll_smt_sanitize(art.smt);
            extra = extra + "__sym____art_smt__=" + s_smt + ";";
            extra = extra + "__art_smt__=" + s_smt + ";";
        }
        let tx: Result[String, String] = env_get(env, "OODA_LLVM_TRIPLE");
        let mut triple: String = match tx { Ok(s) => s, Err(_) => "" };
        if triple == "" { triple = "x86_64-unknown-linux-gnu"; }
        ll_emit_stream_plus_t(toks, extra, triple);
        return;
    }
    let paths: List[String] = collect_module_paths(fs, path);
    let nle: Int = list_len(paths);
    let mut toks: List[String] = list_new();
    let mut all_smt: String = "";
    let mut i: Int = 0;
    while i < nle {
        let p: String = list_get(paths, i);
        if ll_skip_anchor_tu(p) {
            i = i + 1;
            continue;
        }
        let pr: Result[String, String] = read_file(fs, p);
        if pr.is_err() {
            println("ERR\tload\tunreadable file: " + p);
            process_exit(1);
        }
        let fsx: String = match pr { Ok(s) => s, Err(_) => "" };
        let part_art: TypedArtifact = ll_art_file(fs, p, fsx);
        if part_art.smt != "" {
            all_smt = all_smt + part_art.smt + "\n";
        }
        let part: List[String] = part_art.toks;
        let pn: Int = list_len(part);
        let mut j: Int = 0;
        while j < pn {
            let row: String = list_get(part, j);
            if field_at(row, 0) != "EOF" {
                toks = list_push(toks, row);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let mut extra: String = "";
    if all_smt != "" {
        let s_smt: String = ll_smt_sanitize(all_smt);
        extra = extra + "__sym____art_smt__=" + s_smt + ";";
        extra = extra + "__art_smt__=" + s_smt + ";";
    }
    let tx: Result[String, String] = env_get(env, "OODA_LLVM_TRIPLE");
    let mut triple: String = match tx { Ok(s) => s, Err(_) => "" };
    if triple == "" { triple = "x86_64-unknown-linux-gnu"; }
    ll_emit_stream_plus_t(toks, extra, triple);
}
