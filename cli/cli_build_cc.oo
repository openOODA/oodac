// # Multi-threaded parallel compilation cache and native link
//
// Logline: Compiles translation units and chunks in parallel across CPU cores with host preambles and links via lld, clang, or gcc with chs_rt.
//
// Setup: Probes CPU core concurrency, batches cache-miss compilation jobs, executes multi-threaded C jobs, and links object files.
//
// Beats:
//   1. Bundles proto prefixes so all TUs see cross-module declarations under -Werror=implicit-function-declaration.
//   2. Probes available CPU cores and dispatches parallel multi-threaded compiler worker jobs for cache misses.
//   3. Supports compilation of both module translation units and monomorphization chunks (.pb_types_chunk_<n>.c).
//   4. Links all compiled objects and chs_rt.c with lld/clang/gcc, repro, and ssl flags.

import "types/str_escape.oo";

fn probe_src_root() -> String {
    let mut s: String = "OODA_SRC_ROOT=\"${OODA_SRC_ROOT:-${OODA_REPO_ROOT:-.}}\"; ";
    s = s + "if [ -f \"$OODA_SRC_ROOT/runtime/chs_rt.c\" ]; then true; ";
    s = s + "elif [ -f \"./runtime/chs_rt.c\" ]; then OODA_SRC_ROOT=\".\"; fi; export OODA_SRC_ROOT; ";
    return s;
}

fn probe_cc() -> String {
    let mut s: String = "CC=\"${CC:-}\"; ";
    s = s + "if [ -z \"$CC\" ]; then ";
    s = s + "if [ \"${OODA_BYPASS_GCC:-0}\" = \"1\" ] && command -v clang >/dev/null 2>&1; then CC=\"clang\"; ";
    s = s + "elif command -v gcc >/dev/null 2>&1; then CC=\"gcc\"; ";
    s = s + "elif command -v clang >/dev/null 2>&1; then CC=\"clang\"; ";
    s = s + "else CC=\"cc\"; fi; fi; export CC; ";
    return s;
}

fn probe_nproc() -> String {
    let mut s: String = "NPROC=\"${NPROC:-}\"; ";
    s = s + "if [ -z \"$NPROC\" ]; then ";
    s = s + "if command -v nproc >/dev/null 2>&1; then NPROC=$(nproc); ";
    s = s + "elif command -v sysctl >/dev/null 2>&1; then NPROC=$(sysctl -n hw.ncpu 2>/dev/null || echo 4); ";
    s = s + "else NPROC=4; fi; fi; export NPROC; ";
    return s;
}

fn probe_ssl() -> String {
    let mut s: String = "OO_SSL_C=\"\"; OO_SSL_L=\"\"; ";
    s = s + "if [ \"${OO_HAVE_OPENSSL:-}\" = \"0\" ]; then true; ";
    s = s + "elif [ -e /usr/lib64/libssl.so.3 ]; then OO_SSL_C=\"-DOO_HAVE_OPENSSL\"; OO_SSL_L=\"/usr/lib64/libssl.so.3 /usr/lib64/libcrypto.so.3\"; ";
    s = s + "elif [ -e /lib64/libssl.so.3 ]; then OO_SSL_C=\"-DOO_HAVE_OPENSSL\"; OO_SSL_L=\"/lib64/libssl.so.3 /lib64/libcrypto.so.3\"; ";
    s = s + "elif [ -e /usr/lib/x86_64-linux-gnu/libssl.so.3 ]; then OO_SSL_C=\"-DOO_HAVE_OPENSSL\"; OO_SSL_L=\"/usr/lib/x86_64-linux-gnu/libssl.so.3 /usr/lib/x86_64-linux-gnu/libcrypto.so.3\"; ";
    s = s + "elif [ \"${OO_HAVE_OPENSSL:-}\" = \"1\" ]; then OO_SSL_C=\"-DOO_HAVE_OPENSSL\"; OO_SSL_L=\"-lssl -lcrypto\"; fi; ";
    return s;
}

fn probe_autovec() -> String {
    return "OO_AV=\"\"; if [ \"${OODA_AUTOVEC:-0}\" = \"1\" ]; then OO_AV=\"-O3 -fvectorize -fslp-vectorize-aggressive\"; else OO_AV=\"-O2\"; fi; export OO_AV; ";
}

pub fn run_native_cc(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, pbs: List[String], pre: String, out: String, repro: String, quiet: Bool, sanitizers: String) {
    let mut san_str: String = sanitizers;
    let san_probe: String = "if [ -n \"$OODA_SANITIZE\" ]; then echo \"$OODA_SANITIZE\"; elif [ -n \"$SANITIZE\" ]; then echo \"$SANITIZE\"; elif [ -n \"$OODA_FSANITIZE\" ]; then echo \"$OODA_FSANITIZE\"; fi";
    let san_res: Result[String, String] = sys_exec(sys, "sh", "-c", san_probe);
    if san_str == "" && san_res.is_ok() {
        san_str = match san_res { Ok(s) => str_trim(s), Err(_) => "" };
    }
    let mut san_flags: String = "";
    if str_index_of(san_str, "address") >= 0 { san_flags = san_flags + " -fsanitize=address";
    }
    if str_index_of(san_str, "thread") >= 0 { san_flags = san_flags + " -fsanitize=thread";
    }
    if str_index_of(san_str, "undefined") >= 0 { san_flags = san_flags + " -fsanitize=undefined";
    }
    if str_index_of(san_str, "fuzzer") >= 0 { san_flags = san_flags + " -fsanitize=fuzzer";
    }

    let n: Int = list_len(pbs);
    let pf: String = ".ooda-cache/ooda-tmp/proto_" + str_slice(crypto_sha256_internal(out), 0, 16) + ".protos.c";
    let mut acmd: String = "mkdir -p .ooda-cache/ooda-tmp && : > " + shell_sq(pf);
    if n > 0 {
        acmd = "mkdir -p .ooda-cache/ooda-tmp && awk '/^#line /{nextfile} {print}'";
        let mut a: Int = 0;
        while a < n { acmd = acmd + " " + shell_sq(list_get(pbs, a));
        a = a + 1;
        }
        acmd = acmd + " > " + shell_sq(pf);
    }
    let rp: Result[String, String] = sys_exec(sys, "sh", "-c", acmd);
    if !rp.is_ok() { println("ERR\tbuild\tproto bundle failed");
    process_exit(1);
    }

    let mut skipc: Int = 0;
    let mut objs: String = "";
    let mut jobs: List[String] = list_new();
    let mut i: Int = 0;
    while i < n { let cf: String = list_get(pbs, i);
    let ofile: String = str_slice(cf, 0, chars_len(cf) - 5) + ".o";
    if !objs.contains(ofile) { objs = objs + " " + shell_sq(ofile);
    }
        let mut hit: Bool = false;
        if path_exists(fs_r, ofile) {
            hit = true;
        }
        if hit { skipc = skipc + 1;
        } else {
            let single_job: String = "mkdir -p $(dirname " + shell_sq(ofile) + ") && TMP_O=$(mktemp /tmp/oo_obj.XXXXXX.o) && TMP_TU=$(mktemp /tmp/oo_tu.XXXXXX.c) && cat " + shell_sq(pre) + " " + shell_sq(pf) + " " + shell_sq(cf) + " > \"$TMP_TU\" && $CC -x c -c $OO_AV -g -Werror=implicit-function-declaration -Werror=return-type -Werror=uninitialized" + san_flags + " -I\"$OODA_SRC_ROOT/runtime\" \"$TMP_TU\" -o \"$TMP_O\" && mv -f \"$TMP_O\" " + shell_sq(ofile) + " && rm -f \"$TMP_TU\"";
            jobs = list_push(jobs, single_job);
        }
        i = i + 1;
    }

    let njobs: Int = list_len(jobs);
    if njobs == 1 {
        let single_cmd: String = probe_src_root() + probe_cc() + probe_autovec() + list_get(jobs, 0);
        let rc: Result[String, String] = sys_exec(sys, "sh", "-c", single_cmd);
        if !rc.is_ok() { println("ERR\tbuild\tcc -c failed");
        process_exit(1);
        }
    } else if njobs > 1 { let mut batch_body: String = "";
    let mut j: Int = 0;
    while j < njobs { batch_body = batch_body + list_get(jobs, j) + "\n";
    j = j + 1;
    }
        let b_hash: String = crypto_sha256_internal(out + "\n" + batch_body);
        let batch_file: String = ".ooda-cache/ooda-tmp/batch_cc_" + str_slice(b_hash, 0, 16) + ".txt";
        let r_bw: Result[Void, String] = write_file(fs_w, batch_file, batch_body);
        if r_bw.is_err() {
            let cmd_bw: String = "mkdir -p .ooda-cache/ooda-tmp && cat << 'EOF_BATCH' > " + shell_sq(batch_file) + "\n" + batch_body + "EOF_BATCH\n";
            let _rbw: Result[String, String] = sys_exec(sys, "sh", "-c", cmd_bw);
        }
        let batch_sh: String = probe_src_root() + probe_cc() + probe_autovec() + probe_nproc() + "cat " + shell_sq(batch_file) + " | xargs -P\"$NPROC\" -I{} sh -c '{}'";
        let rc_b: Result[String, String] = sys_exec(sys, "sh", "-c", batch_sh);
        let _rm_b: Result[String, String] = sys_exec(sys, "rm", "-f", batch_file);
        if !rc_b.is_ok() { println("ERR\tbuild\tparallel cc -c failed");
        process_exit(1);
        }
    }

    if !quiet { println("cc_cache skip=" + skipc.to_string() + " of " + n.to_string());
    }

    let mut gcc_cmd: String = probe_ssl() + probe_src_root() + probe_cc() + probe_autovec();
    gcc_cmd = gcc_cmd + "OO_LLD=\"\"; if [ -n \"$OODA_USE_LLD\" ] || [ \"${OODA_LLD:-0}\" = \"1\" ] || command -v ld.lld >/dev/null 2>&1 || command -v lld >/dev/null 2>&1 || command -v lld-link >/dev/null 2>&1; then OO_LLD=\"-fuse-ld=lld\"; fi; ";
    gcc_cmd = gcc_cmd + "RT_DIR=\"$OODA_SRC_ROOT/runtime\"; RT_SRC=\"$RT_DIR/chs_rt.c\"; ";
    // FIX: include chs_rt_*.c siblings of chs_rt.c that are NOT #include'd by chs_rt.c
    // (chs_rt_proc_mem.c, chs_rt_weak.c, chs_rt_cycle.c, chs_rt_list_set.c).
    // Previously only chs_rt.c was linked, leaving functions like oo_proc_mem_read
    // (defined in chs_rt_proc_mem.c) undefined at link time.
    gcc_cmd = gcc_cmd + "RT_SRCS=\"$RT_DIR/chs_rt.c\"; for f in \"$RT_DIR\"/chs_rt_proc_mem.c \"$RT_DIR\"/chs_rt_weak.c \"$RT_DIR\"/chs_rt_cycle.c; do [ -f \"$f\" ] && RT_SRCS=\"$RT_SRCS $f\"; done; ";
    gcc_cmd = gcc_cmd + "RT_KEY=$( (echo \"$CC $OO_AV $OO_SSL_C " + san_flags + "\"; ls -l \"$RT_DIR\"/chs_rt* 2>/dev/null) | (sha256sum 2>/dev/null || shasum -a 256 2>/dev/null || md5sum) | cut -c1-16 ); ";
    gcc_cmd = gcc_cmd + "RT_OBJ=\".ooda-cache/runtime/chs_rt_${RT_KEY}.o\"; ";
    gcc_cmd = gcc_cmd + "if [ ! -f \"$RT_OBJ\" ]; then mkdir -p .ooda-cache/runtime && TMP_RT_O=$(mktemp /tmp/oo_rt.XXXXXX.o) && cat $RT_SRCS > \"$RT_DIR/_rt_all.c\" && $CC -x c -c $OO_AV -g -Werror=implicit-function-declaration -Werror=return-type -Werror=uninitialized " + san_flags + " -I\"$RT_DIR\" $OO_SSL_C \"$RT_DIR/_rt_all.c\" -o \"$TMP_RT_O\" && rm -f \"$RT_DIR/_rt_all.c\" && mv -f \"$TMP_RT_O\" \"$RT_OBJ\"; fi; ";
    gcc_cmd = gcc_cmd + "SOURCE_DATE_EPOCH=\"${SOURCE_DATE_EPOCH:-0}\" $CC $OO_AV -g -Werror=implicit-function-declaration -Werror=return-type -Werror=uninitialized " + repro + san_flags + " $OO_LLD -I\"$RT_DIR\" $OO_SSL_C " + objs + " \"$RT_OBJ\" -lm -ldl -lpthread $OO_SSL_L -o " + shell_sq(out);

    let r_gcc: Result[String, String] = sys_exec(sys, "sh", "-c", gcc_cmd);
    let _rm_pf: Result[String, String] = sys_exec(sys, "rm", "-f", pf);
    if r_gcc.is_ok() {
        return;
    }
    println("ERR\tbuild\tlink failed");
    process_exit(1);
}

