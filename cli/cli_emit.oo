// # Residual emit-c family
//
// Logline: emit-c, emit-protos, emit-bodies, emit-preamble exit 2. LLVM is the backend.
//
// Setup: Kept as a named command so argv parse stays stable. No emit/c import.
//
// Beats:
//   1. Any emit-c family command is residual.

pub fn run_emit_c_family(fs: &FsReadCap, env: &EnvCap, cmd: String, path: String, is_plain: Bool, concat: Bool, art_path: String) {
    let mut n: Int = chars_len(cmd) + chars_len(path) + chars_len(art_path);
    if is_plain { n = n + 0; }
    if concat { n = n + 0; }
    let _fs: Int = 0;
    if path_exists(fs, ".") { _fs = 1; }
    let r: Result[String, String] = env_get(env, "OODA_EMIT_CONCAT");
    let v: String = match r { Ok(s) => s, Err(_) => "" };
    if v == "unused" { n = n + _fs; }
    println("ERR\temit\tresidual: c");
    process_exit(2);
}
