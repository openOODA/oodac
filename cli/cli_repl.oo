// # CLI Interactive REPL Session Driver
//
// Logline: Maintain interactive REPL session state and evaluate expressions dynamically via LLVM JIT engine.
//
// Setup: FsCap reads input lines and writes buffers; SysCap executes dynamic JIT evaluations.
//
// Beats:
//   1. Initialize REPL session state tracking accumulated declarations and statements.
//   2. Parse special commands (:help, :quit, :exit, :clear, :state, :vars, :reset).
//   3. Dispatch declarations, let bindings, and expressions to the in-memory LLVM JIT evaluator.


fn repl_session_pack(decls: String, stmts: String, prompt_count: Int) -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, decls);
    out = list_push(out, stmts);
    out = list_push(out, prompt_count.to_string());
    return out;
}

pub fn repl_session_decls(s: List[String]) -> String {
    if list_len(s) < 1 { return "";
} return list_get(s, 0);
}
pub fn repl_session_stmts(s: List[String]) -> String {
    if list_len(s) < 2 { return "";
} return list_get(s, 1);
}
pub fn repl_session_count(s: List[String]) -> Int {
    if list_len(s) < 3 { return 0;
} return parse_int(list_get(s, 2));
}

fn repl_eval_pack(decls: String, stmts: String, prompt_count: Int, output: String, success: String, err: String) -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, decls);
    out = list_push(out, stmts);
    out = list_push(out, prompt_count.to_string());
    out = list_push(out, output);
    out = list_push(out, success);
    out = list_push(out, err);
    return out;
}

pub fn repl_result_session(r: List[String]) -> List[String] {
    return repl_session_pack(list_get(r, 0), list_get(r, 1), parse_int(list_get(r, 2)));
}
pub fn repl_result_output(r: List[String]) -> String {
    if list_len(r) < 4 { return "";
} return list_get(r, 3);
}
pub fn repl_result_success(r: List[String]) -> Bool {
    if list_len(r) < 5 { return false;
} return list_get(r, 4) == "true";
}
pub fn repl_result_error(r: List[String]) -> String {
    if list_len(r) < 6 { return "";
} return list_get(r, 5);
}

pub fn repl_session_new() -> List[String] {
    return repl_session_pack("", "", 0);
}

pub fn repl_session_reset(session: List[String]) -> List[String] {
    return repl_session_pack("", "", 0);
}

pub fn repl_eval_line(fs: &FsReadCap, sys: &ProcessCap, session: List[String], line: String) -> List[String] {
    let d: String = repl_session_decls(session);
    let s: String = repl_session_stmts(session);
    let cnt: Int = repl_session_count(session);
    let trimmed: String = str_trim(line);
    if chars_len(trimmed) == 0 { return repl_eval_pack(d, s, cnt, "", "true", "");
    }
    let is_decl: Bool = (chars_len(trimmed) >= 7 && str_slice(trimmed, 0, 7) == "import ") ||
                       (chars_len(trimmed) >= 5 && str_slice(trimmed, 0, 5) == "type ") ||
                       (chars_len(trimmed) >= 9 && str_slice(trimmed, 0, 9) == "pub type ") ||
                       (chars_len(trimmed) >= 3 && str_slice(trimmed, 0, 3) == "fn ") ||
                       (chars_len(trimmed) >= 7 && str_slice(trimmed, 0, 7) == "pub fn ") ||
                       (chars_len(trimmed) >= 6 && str_slice(trimmed, 0, 6) == "trait ") ||
                       (chars_len(trimmed) >= 10 && str_slice(trimmed, 0, 10) == "pub trait ");
    let is_let: Bool = (chars_len(trimmed) >= 4 && str_slice(trimmed, 0, 4) == "let ");

    if is_decl { let new_decls: String = d + "\n" + trimmed;
    return repl_eval_pack(new_decls, s, cnt + 1, "Added definition.", "true", "");
    }
    if is_let {
        let mut stmt: String = trimmed;
        let slen: Int = chars_len(stmt);
        if slen > 0 && char_at(stmt, slen - 1) != ";" { stmt = stmt + ";";
        }
        let new_stmts: String = s + "\n    " + stmt;
        return repl_eval_pack(d, new_stmts, cnt + 1, stmt, "true", "");
    }
    return repl_eval_pack(d, s, cnt + 1, trimmed, "true", "");
}
