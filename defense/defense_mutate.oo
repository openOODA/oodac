// # Metamorphic Instruction Substitution Engine / Metamorphic Register Allocation Permutation
//
// Logline: Applies semantic-preserving algebraic transformations and opcode substitutions across machine instruction streams. Randomizes physical scratch register preference tables observing SysV AMD64 and AAPCS64 ABI calling conventions.
//
// Setup: Merged cohesive compiler module.
//
// Beats:
//   1. Unified cohesive implementation.



pub fn meta_insn_subst_pack(op: String, dst: String, src: String, imm: Int) -> String {
    return op + "\t" + dst + "\t" + src + "\t" + imm.to_string();
}

pub fn meta_insn_subst_op(insn: String) -> String {
    return field_at(insn, 0);
}
pub fn meta_insn_subst_dst(insn: String) -> String {
    return field_at(insn, 1);
}
pub fn meta_insn_subst_src(insn: String) -> String {
    return field_at(insn, 2);
}
pub fn meta_insn_subst_imm(insn: String) -> Int {
    return parse_int(field_at(insn, 3));
}

pub fn meta_insn_subst_zeroing(stream: List[String], seed: Int) -> List[String] {
    let mut out: List[String] = list_new();
    let n: Int = list_len(stream);
    let mut i: Int = 0;

    while i < n {
        let insn: String = list_get(stream, i);
        let op: String = meta_insn_subst_op(insn);
        let imm: Int = (0 + meta_insn_subst_imm(insn));
        let dst: String = meta_insn_subst_dst(insn);

        if op == "mov" && imm == 0 {
            let choice: Int = (seed + i) % 2;
            let mut new_op: String = "xor";
            if choice == 1 { new_op = "sub";
            }
            let sub_insn: String = meta_insn_subst_pack(new_op, dst, dst, 0);
            out = list_push(out, sub_insn);
        } else {
            out = list_push(out, insn);
        }
        i = i + 1;
    }
    return out;
}

pub fn meta_insn_subst_arith(stream: List[String]) -> List[String] {
    let mut out: List[String] = list_new();
    let n: Int = list_len(stream);
    let mut i: Int = 0;

    while i < n { let insn: String = list_get(stream, i);
    let op: String = meta_insn_subst_op(insn);
    let imm: Int = (0 + meta_insn_subst_imm(insn));
    let dst: String = meta_insn_subst_dst(insn);
    if op == "add" && imm == 1 { let inc_insn: String = meta_insn_subst_pack("inc", dst, "", 0);
    out = list_push(out, inc_insn);
    } else if op == "cmp" && imm == 0 { let test_insn: String = meta_insn_subst_pack("test", dst, dst, 0);
    out = list_push(out, test_insn);
    } else {
            out = list_push(out, insn);
        }
        i = i + 1;
    }
    return out;
}

pub fn meta_reg_permute_x86() -> List[String] {
    let mut regs: List[String] = list_new();
    regs = list_push(regs, "rax");
    regs = list_push(regs, "rcx");
    regs = list_push(regs, "rdx");
    regs = list_push(regs, "rsi");
    regs = list_push(regs, "rdi");
    regs = list_push(regs, "r8");
    regs = list_push(regs, "r9");
    regs = list_push(regs, "r10");
    regs = list_push(regs, "r11");
    return regs;
}

pub fn meta_reg_permute_aarch64() -> List[String] {
    let mut regs: List[String] = list_new();
    regs = list_push(regs, "x9");
    regs = list_push(regs, "x10");
    regs = list_push(regs, "x11");
    regs = list_push(regs, "x12");
    regs = list_push(regs, "x13");
    regs = list_push(regs, "x14");
    regs = list_push(regs, "x15");
    return regs;
}

pub fn meta_reg_permute_list(regs: List[String], seed: Int) -> List[String] {
    let n: Int = list_len(regs);
    if n <= 1 { return regs;
    }
    let mut perm: List[String] = list_new();
    let shift: Int = (seed % n + n) % n;
    let mut i: Int = 0;
    while i < n { let idx: Int = (i + shift) % n;
    let reg: String = list_get(regs, idx);
    perm = list_push(perm, reg);
    i = i + 1;
    }
    return perm;
}

pub fn meta_reg_permute_scratch(regs: List[String], idx: Int) -> String {
    let n: Int = list_len(regs);
    if n == 0 { return "rax";
    }
    let safe_idx: Int = (idx % n + n) % n;
    return list_get(regs, safe_idx);
}
