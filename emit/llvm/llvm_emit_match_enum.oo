// # Lower enum matches to LLVM
//
// Logline: Lowers user-defined algebraic sum types and multi-variant enums to a single switch table with bitcast payload extraction per arm.
//
// Setup: Called from llvm_emit_match.oo when scrutinee is %struct.*.
//
// Beats:
//   1. First pass collects tag, label, bind, payload kind, and body bounds for every arm.
//   2. Emit one switch instruction over the tag dispatching to each arm label with a default fall-through to the merge label.
//   3. Second pass emits each arm label, extracts the payload by bitcast or extractvalue, lowers the body, and branches to merge.
//   4. Emit the merge label; mark it unreachable when every arm already returned.


import "llvm_emit_ty.oo";

import "llvm_emit_env.oo";

import "llvm_emit_expr.oo";

import "llvm_emit_lowering.oo";

import "llvm_emit_match_slot.oo";



fn llvm_menum_pack(p: Int, env: List[String]) -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, list_get(env, 0));
    out = list_push(out, list_get(env, 1));
    out = list_push(out, list_get(env, 2));
    out = list_push(out, list_get(env, 3));
    out = list_push(out, list_get(env, 4));
    return out;
}

fn llvm_menum_env5(src: List[String], base: Int) -> List[String] {
    let mut e: List[String] = list_new();
    e = list_push(e, list_get(src, base));
    e = list_push(e, list_get(src, base + 1));
    e = list_push(e, list_get(src, base + 2));
    e = list_push(e, list_get(src, base + 3));
    e = list_push(e, list_get(src, base + 4));
    return e;
}

fn llvm_menum_skip_arm(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p = pos;
    if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
        let mut depth = 0;
        while p < n {
            let k: String = field_at(list_get(toks, p), 0);
            if k == "LBRACE" { depth = depth + 1;
            }
            if k == "RBRACE" {
                depth = depth - 1;
                p = p + 1;
                if depth == 0 { break;
                }
            } else {
                p = p + 1;
            }
        }
    } else {
        let mut depth = 0;
        while p < n {
            let k: String = field_at(list_get(toks, p), 0);
            if k == "LPAREN" || k == "LBRACE" || k == "LBRACKET" { depth = depth + 1;
            }
            if k == "RPAREN" || k == "RBRACE" || k == "RBRACKET" { depth = depth - 1;
            }
            if depth <= 0 {
                if k == "COMMA" || k == "RBRACE" { break;
                }
                if k == "IDENT" {
                    let t: String = field_at(list_get(toks, p), 3);
                    if t == "Err" || t == "Ok" || t == "None" || t == "Some" { break;
                    }
                }
                if k == "PIPE" { break;
                }
            }
            p = p + 1;
        }
    }
    if p < n && field_at(list_get(toks, p), 0) == "COMMA" { p = p + 1;
    }
    return p;
}

pub fn llvm_match_emit_enum(toks: List[String], pos: Int, n: Int, env: List[String], scrut: String, rty: String) -> List[String] {
    let mut p = pos;
    let mut cur_env: List[String] = env;

    // First pass: collect (tag, label, bind, payk, body_start, body_end) per arm.
    let mut variants: List[String] = list_new();
    let scan_p = p;
    let mut sp = scan_p;
    while sp < n && field_at(list_get(toks, sp), 0) != "RBRACE" {
        if field_at(list_get(toks, sp), 0) != "IDENT" {
            sp = sp + 1;
        } else {
            let ctor: String = field_at(list_get(toks, sp), 3);
            sp = sp + 1;
            let spec: String = llvm_env_get_var_ty(cur_env, "__ctor__" + ctor);
            let tag_num: String = c_sum_tag_of(spec);
            let payk: String = c_sum_pay_of(spec);
            let mut bind: String = "_" + ctor;
            if sp < n && field_at(list_get(toks, sp), 0) == "LPAREN" {
                sp = sp + 1;
                if sp < n && field_at(list_get(toks, sp), 0) == "IDENT" {
                    bind = field_at(list_get(toks, sp), 3);
                    sp = sp + 1;
                }
                if sp < n && field_at(list_get(toks, sp), 0) == "RPAREN" { sp = sp + 1;
                }
            }
            if sp < n && field_at(list_get(toks, sp), 0) == "FATARROW" { sp = sp + 1;
            }
            // Allocate arm label up front.
            let arm_lr: List[String] = llvm_gen_label("bb_match_arm", cur_env);
            let lbl_arm: String = list_get(arm_lr, 0);
            cur_env = llvm_menum_env5(arm_lr, 1);
            // Find body end via token-only traversal.
            let body_end: Int = 0 + llvm_menum_skip_arm(toks, sp, n);
            let rec: String = tag_num + "|" + lbl_arm + "|" + bind + "|" + payk + "|" + sp.to_string() + "|" + body_end.to_string();
            variants = list_push(variants, rec);
            sp = body_end;
        }
    }

    // Reserve the end label so all arm branches can target it.
    let end_lr: List[String] = llvm_gen_label("bb_match_end", cur_env);
    let lbl_end: String = list_get(end_lr, 0);
    cur_env = llvm_menum_env5(end_lr, 1);

    // Extract the tag once.
    let tag_reg_res: List[String] = llvm_gen_reg(cur_env);
    let tag_val: String = list_get(tag_reg_res, 0);
    cur_env = llvm_menum_env5(tag_reg_res, 1);
    println("  " + tag_val + " = extractvalue " + rty + " " + scrut + ", 0");

    // Emit a single switch table dispatching the tag to each arm label.
    println("  switch i32 " + tag_val + ", label %" + lbl_end + " [");
    let mut vi: Int = 0;
    while vi < list_len(variants) {
        let rec: String = list_get(variants, vi);
        let parts: List[String] = str_split(rec, "|");
        let tag_num: String = list_get(parts, 0);
        let lbl_arm: String = list_get(parts, 1);
        println("    i32 " + tag_num + ", label %" + lbl_arm);
        vi = vi + 1;
    }
    println("  ]");

    // Second pass: emit each arm body in original order.
    vi = 0;
    while vi < list_len(variants) {
        let rec: String = list_get(variants, vi);
        let parts: List[String] = str_split(rec, "|");
        let tag_num: String = list_get(parts, 0);
        let lbl_arm: String = list_get(parts, 1);
        let bind: String = list_get(parts, 2);
        let payk: String = list_get(parts, 3);
        let body_start: Int = parse_int(list_get(parts, 4));
        let body_end: Int = parse_int(list_get(parts, 5));

        println(lbl_arm + ":");
        let mut arm_env: List[String] = cur_env;
        if payk != "" && payk != "U" {
            let pty: String = llvm_ty_map(payk);
            let rc: Int = parse_int(list_get(arm_env, 0));
            let rc1: Int = rc + 1;
            let arm_slot: String = bind + "." + rc.to_string();
            let mut bumped: List[String] = list_new();
            bumped = list_push(bumped, rc1.to_string());
            bumped = list_push(bumped, list_get(arm_env, 1));
            bumped = list_push(bumped, list_get(arm_env, 2));
            bumped = list_push(bumped, list_get(arm_env, 3));
            bumped = list_push(bumped, list_get(arm_env, 4));
            arm_env = llvm_env_add_var(bumped, "__slot__" + bind, arm_slot);
            arm_env = llvm_env_add_var(arm_env, bind, pty);
            println("  %" + arm_slot + ".slot = alloca " + pty + ", align 8");
            llvm_match_zero_slot(pty, arm_slot);
            let fidx: Int = parse_int(tag_num) + 1;
            // Bitcast payload extraction: bitcast the entire struct to a single-field struct of the payload type, then extractvalue index 0.
            let pay_bc: List[String] = llvm_gen_reg(arm_env);
            let pay_bc_v: String = list_get(pay_bc, 0);
            arm_env = llvm_menum_env5(pay_bc, 1);
            let pay_ld: List[String] = llvm_gen_reg(arm_env);
            let pay_v: String = list_get(pay_ld, 0);
            arm_env = llvm_menum_env5(pay_ld, 1);
            println("  " + pay_bc_v + " = bitcast " + rty + " " + scrut + " to { " + pty + " }");
            println("  " + pay_v + " = extractvalue { " + pty + " } " + pay_bc_v + ", 0");
            println("  store " + pty + " " + pay_v + ", " + pty + "* %" + arm_slot + ".slot, align 8");
        }
        let mut bp: Int = body_start;
        if bp < n && field_at(list_get(toks, bp), 0) == "LBRACE" {
            let br: List[String] = llvm_emit_block(toks, bp, n, arm_env);
            bp = parse_int(list_get(br, 0));
            arm_env = llvm_menum_env5(br, 1);
        } else {
            let asgn: String = llvm_env_get_var_ty(arm_env, "__asgn__");
            if asgn != "" {
                let ex: List[String] = llvm_emit_expr(toks, bp, n, arm_env);
                let ev: String = list_get(ex, 0);
                let et: String = list_get(ex, 1);
                bp = parse_int(list_get(ex, 2));
                arm_env = llvm_menum_env5(ex, 3);
                let aslot: String = llvm_env_slot(arm_env, asgn);
                let mut aty: String = llvm_env_get_var_ty(arm_env, asgn);
                if aty == "" { aty = et;
                }
                println("  store " + aty + " " + ev + ", " + aty + "* %" + aslot + ".slot, align 8");
            } else {
                let ex: List[String] = llvm_emit_expr(toks, bp, n, arm_env);
                bp = parse_int(list_get(ex, 2));
                arm_env = llvm_menum_env5(ex, 3);
            }
        }
        // Suppress unused warnings for body_end.
        if body_end < 0 { println("  unreachable");
        }
        let arm_ret: Bool = llvm_env_vars_has(list_get(arm_env, 4), "__did_ret__");
        if !arm_ret { println("  br label %" + lbl_end);
        }
        cur_env = arm_env;
        vi = vi + 1;
    }
    let any_ret: Bool = llvm_env_vars_has(list_get(cur_env, 4), "__did_ret__");
    if !any_ret { println("  unreachable");
    }
    println(lbl_end + ":");
    // Consume the closing RBRACE for the match block.
    p = p;
    let mut endp: Int = pos;
    while endp < n && field_at(list_get(toks, endp), 0) != "RBRACE" { endp = endp + 1;
    }
    if endp < n && field_at(list_get(toks, endp), 0) == "RBRACE" { p = endp + 1;
    }
    return llvm_menum_pack(p, cur_env);
}
