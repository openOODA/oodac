// # LLVM struct lists and struct results
//
// Logline: Lower List[Struct] to OoL helpers and Result[Struct] ctors.
//
// Setup: Kinds olist_Name and resSt_Name. Per-module IR defines. No emit/c import.
//
// Beats:
//   1. olist kinds plus OoL type and new/len/get/push defines.
//   2. Retain cascade on get and push copy.
//   3. Builtin dispatch helpers for list ops.
//   4. resSt types for struct payload results.
import "ll_tok.oo";
import "ll_ty.oo";
import "ll_slot.oo";
import "ll_ir.oo";

pub fn ll_is_olist(kind: String) -> Bool {
    if chars_len(kind) < 6 { return false; }
    if str_slice(kind, 0, 6) != "olist_" { return false; }
    return true;
}

pub fn ll_is_resst(kind: String) -> Bool {
    if chars_len(kind) < 6 { return false; }
    if str_slice(kind, 0, 6) != "resSt_" { return false; }
    return true;
}

pub fn ll_is_optst(kind: String) -> Bool {
    if chars_len(kind) < 6 { return false; }
    if str_slice(kind, 0, 6) != "optSt_" { return false; }
    return true;
}

fn ll_olist_nm(kind: String) -> String {
    let n: Int = chars_len(kind);
    if n <= 6 { return ""; }
    let mut end: Int = n;
    let c: Int = str_index_of(kind, ",");
    if c >= 6 && c < end { end = c; }
    let h: Int = str_index_of(kind, "#");
    if h >= 6 && h < end { end = h; }
    return str_slice(kind, 6, end);
}

pub fn ll_olist_wanted(toks: List[String], nm: String) -> Bool {
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 3 < n {
        if ll_k(toks, i) == "IDENT" && ll_t(toks, i) == "List" {
            if ll_k(toks, i + 1) == "LBRACKET" && ll_k(toks, i + 2) == "IDENT" {
                if ll_t(toks, i + 2) == nm { return true; }
            }
        }
        i = i + 1;
    }
    return false;
}

pub fn ll_st_wrap_emit(nm: String, toks: List[String], ir: &mut IrBuf) {
    ll_ir_text(ir, "%OoRes_St_" + nm + " = type { i32, %St_" + nm + ", %OoStr }");
    ll_ir_text(ir, "%OoOpt_St_" + nm + " = type { i32, %St_" + nm + " }");
    if ll_olist_wanted(toks, nm) { ll_olist_emit_one(nm, ir); }
}

pub fn ll_olist_emit_one(nm: String, ir: &mut IrBuf) {
    ll_ir_text(ir, "%OoL_" + nm + " = type { ptr, i64, i64 }");
    ll_ir_fn_open(ir, "define hidden void @oo_l_" + nm + "_new(ptr sret(%OoL_" + nm + ") align 8 %out) {");
    ll_heap(ir);
    ll_ir_inst(ir, "store", "%OoL_" + nm, "", "{ ptr null, i64 0, i64 0 }, ptr %out, align 8", 1, 1);
    ll_ir_inst(ir, "ret", "void", "", "", 1, 1);
    ll_ir_fn_close(ir);
    ll_ir_fn_open(ir, "define hidden i64 @oo_l_" + nm + "_len(ptr %l) {");
    ll_heap(ir);
    ll_ir_inst(ir, "getelementptr inbounds", "%OoL_" + nm, "%lp", "ptr %l, i32 0, i32 1", 1, 1);
    ll_ir_inst(ir, "load", "i64", "%lv", "ptr %lp, align 8", 1, 1);
    ll_ir_inst(ir, "ret", "i64", "", "%lv", 1, 1);
    ll_ir_fn_close(ir);
    ll_ir_fn_open(ir, "define hidden %St_" + nm + " @oo_l_" + nm + "_get(ptr %l, i64 %i) {");
    ll_heap(ir);
    ll_ir_inst(ir, "getelementptr inbounds", "%OoL_" + nm, "%lp", "ptr %l, i32 0, i32 1", 1, 1);
    ll_ir_inst(ir, "load", "i64", "%len", "ptr %lp, align 8", 1, 1);
    ll_ir_inst(ir, "icmp ult", "i64", "%ok", "%i, %len", 1, 1);
    ll_ir_inst(ir, "br", "i1", "", "%ok, label %gok_" + nm + ", label %gbad_" + nm, 1, 1);
    ll_ir_label(ir, "gbad_" + nm);
    ll_ir_inst(ir, "call", "void", "", "@oo_process_exit(i64 1)", 1, 1);
    ll_ir_inst(ir, "unreachable", "", "", "", 1, 1);
    ll_ir_label(ir, "gok_" + nm);
    ll_ir_inst(ir, "getelementptr inbounds", "%OoL_" + nm, "%dp", "ptr %l, i32 0, i32 0", 1, 1);
    ll_ir_inst(ir, "load", "ptr", "%data", "ptr %dp, align 8", 1, 1);
    ll_ir_inst(ir, "getelementptr inbounds", "%St_" + nm, "%ep", "ptr %data, i64 %i", 1, 1);
    ll_ir_inst(ir, "load", "%St_" + nm, "%v", "ptr %ep, align 8", 1, 1);
    ll_ir_inst(ir, "call", "void", "", "@oo_retain_St_" + nm + "(ptr %ep)", 1, 1);
    ll_ir_inst(ir, "ret", "%St_" + nm, "", "%v", 1, 1);
    ll_ir_fn_close(ir);
    ll_ir_fn_open(ir, "define hidden void @oo_l_" + nm + "_push(ptr sret(%OoL_" + nm + ") align 8 %out, ptr %l, ptr %vp) {");
    ll_heap(ir);
    ll_ir_inst(ir, "getelementptr inbounds", "%OoL_" + nm, "%lenp", "ptr %l, i32 0, i32 1", 1, 1);
    ll_ir_inst(ir, "load", "i64", "%len", "ptr %lenp, align 8", 1, 1);
    ll_ir_inst(ir, "getelementptr inbounds", "%OoL_" + nm, "%capp", "ptr %l, i32 0, i32 2", 1, 1);
    ll_ir_inst(ir, "load", "i64", "%cap", "ptr %capp, align 8", 1, 1);
    ll_ir_inst(ir, "getelementptr inbounds", "%OoL_" + nm, "%dp0", "ptr %l, i32 0, i32 0", 1, 1);
    ll_ir_inst(ir, "load", "ptr", "%data0", "ptr %dp0, align 8", 1, 1);
    ll_ir_inst(ir, "icmp ne", "i64", "%hascap", "%cap, 0", 1, 1);
    ll_ir_inst(ir, "select", "i1", "%ncap0", "%hascap, i64 %cap, i64 8", 1, 1);
    ll_slot_name("%ncap", ir);
    ll_ir_inst(ir, "store", "i64", "", "%ncap0, ptr %ncap, align 8", 1, 1);
    ll_ir_inst(ir, "br", "label", "", "%pgrow_" + nm, 1, 1);
    ll_ir_label(ir, "pgrow_" + nm);
    ll_ir_inst(ir, "load", "i64", "%nc", "ptr %ncap, align 8", 1, 1);
    ll_ir_inst(ir, "add", "i64", "%need", "%len, 1", 1, 1);
    ll_ir_inst(ir, "icmp uge", "i64", "%enough", "%nc, %need", 1, 1);
    ll_ir_inst(ir, "br", "i1", "", "%enough, label %palloc_" + nm + ", label %pdouble_" + nm, 1, 1);
    ll_ir_label(ir, "pdouble_" + nm);
    ll_ir_inst(ir, "mul", "i64", "%nd", "%nc, 2", 1, 1);
    ll_ir_inst(ir, "store", "i64", "", "%nd, ptr %ncap, align 8", 1, 1);
    ll_ir_inst(ir, "br", "label", "", "%pgrow_" + nm, 1, 1);
    ll_ir_label(ir, "palloc_" + nm);
    ll_ir_inst(ir, "load", "i64", "%ncapf", "ptr %ncap, align 8", 1, 1);
    ll_ir_inst(ir, "getelementptr inbounds", "%St_" + nm, "%szp", "ptr null, i32 1", 1, 1);
    ll_ir_inst(ir, "ptrtoint", "ptr", "%esz", "%szp to i64", 1, 1);
    ll_ir_inst(ir, "call", "ptr", "%ndata", "@oo_list_alloc_payload(i64 %esz, i64 %ncapf)", 1, 1);
    ll_slot_name("%ci", ir);
    ll_ir_inst(ir, "store", "i64", "", "0, ptr %ci, align 8", 1, 1);
    ll_ir_inst(ir, "br", "label", "", "%pcopy_" + nm, 1, 1);
    ll_ir_label(ir, "pcopy_" + nm);
    ll_ir_inst(ir, "load", "i64", "%iv", "ptr %ci, align 8", 1, 1);
    ll_ir_inst(ir, "icmp ult", "i64", "%more", "%iv, %len", 1, 1);
    ll_ir_inst(ir, "br", "i1", "", "%more, label %pstep_" + nm + ", label %papp_" + nm, 1, 1);
    ll_ir_label(ir, "pstep_" + nm);
    ll_ir_inst(ir, "getelementptr inbounds", "%St_" + nm, "%sp", "ptr %data0, i64 %iv", 1, 1);
    ll_ir_inst(ir, "load", "%St_" + nm, "%sv", "ptr %sp, align 8", 1, 1);
    ll_ir_inst(ir, "call", "void", "", "@oo_retain_St_" + nm + "(ptr %sp)", 1, 1);
    ll_ir_inst(ir, "getelementptr inbounds", "%St_" + nm, "%dp2", "ptr %ndata, i64 %iv", 1, 1);
    ll_ir_inst(ir, "store", "%St_" + nm, "", "%sv, ptr %dp2, align 8", 1, 1);
    ll_ir_inst(ir, "add", "i64", "%iv2", "%iv, 1", 1, 1);
    ll_ir_inst(ir, "store", "i64", "", "%iv2, ptr %ci, align 8", 1, 1);
    ll_ir_inst(ir, "br", "label", "", "%pcopy_" + nm, 1, 1);
    ll_ir_label(ir, "papp_" + nm);
    ll_ir_inst(ir, "load", "%St_" + nm, "%v", "ptr %vp, align 8", 1, 1);
    ll_ir_inst(ir, "call", "void", "", "@oo_retain_St_" + nm + "(ptr %vp)", 1, 1);
    ll_ir_inst(ir, "getelementptr inbounds", "%St_" + nm, "%ap", "ptr %ndata, i64 %len", 1, 1);
    ll_ir_inst(ir, "store", "%St_" + nm, "", "%v, ptr %ap, align 8", 1, 1);
    ll_ir_inst(ir, "add", "i64", "%nl", "%len, 1", 1, 1);
    ll_ir_inst(ir, "insertvalue", "%OoL_" + nm, "%r0", "{ ptr null, i64 0, i64 0 }, ptr %ndata, 0", 1, 1);
    ll_ir_inst(ir, "insertvalue", "%OoL_" + nm, "%r1", "%r0, i64 %nl, 1", 1, 1);
    ll_ir_inst(ir, "insertvalue", "%OoL_" + nm, "%r2", "%r1, i64 %ncapf, 2", 1, 1);
    ll_ir_inst(ir, "store", "%OoL_" + nm, "", "%r2, ptr %out, align 8", 1, 1);
    ll_ir_inst(ir, "ret", "void", "", "", 1, 1);
    ll_ir_fn_close(ir);
}

pub fn ll_olist_new(expect: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let nm: String = ll_olist_nm(expect);
    let a: String = ll_tmpa(ssa0 + 1);
    ll_slot_name(a, ir);
    ll_ir_inst(ir, "call", "void", "", "@oo_l_" + nm + "_new(ptr sret(%OoL_" + nm + ") align 8 " + a + ")", 1, 1);
    return ll_pack(0, ssa0 + 1, expect, a);
}

pub fn ll_olist_len(arg: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let nm: String = ll_olist_nm(ll_pk(arg));
    let a0: String = ll_ensure_ptr(arg, ssa0, ir);
    let s: Int = ll_pssa(a0) + 1;
    ll_ir_inst(ir, "call", "i64", ll_ssa(s), "@oo_l_" + nm + "_len(ptr " + ll_pptr(a0) + ")", 1, 1);
    return ll_pack(0, s, "i64", "");
}

pub fn ll_olist_get(arg: String, idx: String, ssa0: Int, expect: String, ir: &mut IrBuf) -> String {
    let nm: String = ll_olist_nm(ll_pk(arg));
    let a0: String = ll_ensure_ptr(arg, ssa0, ir);
    let s: Int = ll_pssa(a0) + 1;
    ll_ir_inst(ir, "call", "%St_" + nm, ll_ssa(s), "@oo_l_" + nm + "_get(ptr " + ll_pptr(a0) + ", i64 " + ll_opnd(idx) + ")", 1, 1);
    let mut rk: String = "St_" + nm;
    if ll_is_struct(expect) { rk = expect; }
    return ll_pack(0, s, rk, "");
}

pub fn ll_olist_push(arg: String, val: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let nm: String = ll_olist_nm(ll_pk(arg));
    let a0: String = ll_ensure_ptr(arg, ssa0, ir);
    let vp: String = ll_ensure_ptr(val, ll_pssa(a0), ir);
    let s: Int = ll_pssa(vp) + 1;
    let out: String = ll_tmpa(s);
    ll_slot_name(out, ir);
    ll_ir_inst(ir, "call", "void", "", "@oo_l_" + nm + "_push(ptr sret(%OoL_" + nm + ") align 8 " + out + ", ptr " + ll_pptr(a0) + ", ptr " + ll_pptr(vp) + ")", 1, 1);
    return ll_pack(0, s, ll_pk(arg), out);
}

pub fn ll_olist_builtin(name: String, args: List[String], ssa0: Int, expect: String, ir: &mut IrBuf) -> String {
    if name == "list_new" && ll_is_olist(expect) {
        return ll_olist_new(expect, ssa0, ir);
    }
    let na: Int = list_len(args);
    if na < 1 { return ""; }
    if !ll_is_olist(ll_pk(list_get(args, 0))) { return ""; }
    if name == "list_len" && na >= 1 {
        return ll_olist_len(list_get(args, 0), ssa0, ir);
    }
    if name == "list_get" && na >= 2 {
        return ll_olist_get(list_get(args, 0), list_get(args, 1), ssa0, expect, ir);
    }
    if name == "list_push" && na >= 2 {
        return ll_olist_push(list_get(args, 0), list_get(args, 1), ssa0, ir);
    }
    return "";
}
