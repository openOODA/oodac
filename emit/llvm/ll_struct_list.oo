// # LLVM struct lists and struct results
//
// Logline: Lower List[Struct] to OoL helpers and Result[Struct] ctors.
//
// Setup: Kinds olist_Name and resSt_Name. Per-module IR defines. No emit/c import.
//
// Beats:
//   1. olist kinds plus OoL type and new/len/get/push defines.
//   2. In-place append check, retain, and release with quota refund.
//   3. Builtin dispatch helpers for list ops.
//   4. resSt types for struct payload results.
import "ll_tok.oo";
import "ll_ty.oo";
import "ll_slot.oo";
import "ll_ir.oo";
import "ll_struct_list_ops.oo";

pub fn ll_is_olist(kind: String) -> Bool { return chars_len(kind) >= 6 && str_slice(kind, 0, 6) == "olist_"; }
pub fn ll_is_resst(kind: String) -> Bool { return chars_len(kind) >= 6 && str_slice(kind, 0, 6) == "resSt_"; }
pub fn ll_is_optst(kind: String) -> Bool { return chars_len(kind) >= 6 && str_slice(kind, 0, 6) == "optSt_"; }
fn ll_is_st(k: String) -> Bool { let kl: Int = chars_len(k); let u: String = if kl > 0 && char_at(k, 0) == "%" { str_slice(k, 1, kl) } else { k }; return chars_len(u) >= 3 && str_slice(u, 0, 3) == "St_"; }

fn ll_olist_nm(kind: String) -> String {
    let n: Int = chars_len(kind);
    if n <= 6 { return ""; }
    let mut end: Int = n;
    let c: Int = str_index_of(kind, ",");
    if c >= 6 && c < end { end = c; }
    let h: Int = str_index_of(kind, "#");
    if h >= 6 && h < end { end = h; }
    return str_slice(kind, 6, end);
}

pub fn ll_olist_wanted(toks: List[String], nm: String) -> Bool {
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i + 3 < n {
        if ll_k(toks, i) == "IDENT" && ll_t(toks, i) == "List" {
            if ll_k(toks, i + 1) == "LBRACKET" && ll_k(toks, i + 2) == "IDENT" {
                if ll_t(toks, i + 2) == nm { return true; }
            }
        }
        i = i + 1;
    }
    return false;
}

pub fn ll_st_wrap_emit(nm: String, toks: List[String], ir: &mut IrBuf) {
    ll_ir_text(ir, "%OoRes_St_" + nm + " = type { i32, %St_" + nm + ", %OoStr }");
    ll_ir_text(ir, "%OoOpt_St_" + nm + " = type { i32, %St_" + nm + " }");
    if ll_olist_wanted(toks, nm) { ll_olist_emit_one(nm, ir); }
}



pub fn ll_olist_new(expect: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let nm: String = ll_olist_nm(expect);
    let a: String = ll_tmpa(ssa0 + 1);
    ll_slot_ty(a, "%OoL_" + nm, ir);
    ll_ir_inst(ir, "call", "void", "", "@oo_l_" + nm + "_new(ptr sret(%OoL_" + nm + ") align 8 " + a + ")", 1, 1);
    return ll_pack(0, ssa0 + 1, expect, a);
}

pub fn ll_olist_len(arg: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let nm: String = ll_olist_nm(ll_pk(arg));
    let a0: String = ll_ensure_ptr(arg, ssa0, ir);
    let s: Int = ll_pssa(a0) + 1;
    ll_ir_inst(ir, "call", "i64", ll_ssa(s), "@oo_l_" + nm + "_len(ptr " + ll_pptr(a0) + ")", 1, 1);
    return ll_pack(0, s, "i64", "");
}

pub fn ll_olist_get(arg: String, idx: String, ssa0: Int, expect: String, ir: &mut IrBuf) -> String {
    let nm: String = ll_olist_nm(ll_pk(arg));
    let a0: String = ll_ensure_ptr(arg, ssa0, ir);
    let s: Int = ll_pssa(a0) + 1;
    ll_ir_inst(ir, "call", "%St_" + nm, ll_ssa(s), "@oo_l_" + nm + "_get(ptr " + ll_pptr(a0) + ", i64 " + ll_opnd(idx) + ")", 1, 1);
    let mut rk: String = "St_" + nm;
    if ll_is_struct(expect) { rk = expect; }
    return ll_pack(0, s, rk, "");
}

pub fn ll_olist_push(arg: String, val: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let nm: String = ll_olist_nm(ll_pk(arg));
    let a0: String = ll_ensure_ptr(arg, ssa0, ir);
    let vp: String = ll_ensure_ptr(val, ll_pssa(a0), ir);
    let s: Int = ll_pssa(vp) + 1;
    let out: String = ll_tmpa(s);
    ll_slot_ty(out, "%OoL_" + nm, ir);
    ll_ir_inst(ir, "call", "void", "", "@oo_l_" + nm + "_push(ptr sret(%OoL_" + nm + ") align 8 " + out + ", ptr " + ll_pptr(a0) + ", ptr " + ll_pptr(vp) + ")", 1, 1);
    return ll_pack(0, s, ll_pk(arg), out);
}

pub fn ll_olist_set(arg: String, idx: String, val: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let nm: String = ll_olist_nm(ll_pk(arg));
    let a0: String = ll_ensure_ptr(arg, ssa0, ir);
    let vp: String = ll_ensure_ptr(val, ll_pssa(a0), ir);
    let s: Int = ll_pssa(vp) + 1;
    let out: String = ll_tmpa(s);
    ll_slot_ty(out, "%OoL_" + nm, ir);
    ll_ir_inst(ir, "call", "void", "", "@oo_l_" + nm + "_set(ptr sret(%OoL_" + nm + ") align 8 " + out + ", ptr " + ll_pptr(a0) + ", i64 " + ll_opnd(idx) + ", ptr " + ll_pptr(vp) + ")", 1, 1);
    return ll_pack(0, s, ll_pk(arg), out);
}

pub fn ll_olist_slice(arg: String, lo: String, hi: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let nm: String = ll_olist_nm(ll_pk(arg));
    let a0: String = ll_ensure_ptr(arg, ssa0, ir);
    let s: Int = ll_pssa(a0) + 1;
    let out: String = ll_tmpa(s);
    ll_slot_ty(out, "%OoL_" + nm, ir);
    ll_ir_inst(ir, "call", "void", "", "@oo_l_" + nm + "_slice(ptr sret(%OoL_" + nm + ") align 8 " + out + ", ptr " + ll_pptr(a0) + ", i64 " + ll_opnd(lo) + ", i64 " + ll_opnd(hi) + ")", 1, 1);
    return ll_pack(0, s, ll_pk(arg), out);
}

fn ll_ll_new(expect: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let a: String = ll_tmpa(ssa0 + 1);
    let ty: String = if expect == "ll_i" { "%OoLL_I" } else { "%OoLL_S" };
    let fnm: String = if expect == "ll_i" { "@oo_ll_I_new" } else { "@oo_ll_S_new" };
    ll_slot_ty(a, ty, ir);
    ll_ir_inst(ir, "call", "void", "", fnm + "(ptr sret(" + ty + ") align 8 " + a + ")", 1, 1);
    return ll_pack(0, ssa0 + 1, expect, a);
}

fn ll_ll_len(arg: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let k: String = ll_pk(arg);
    let a0: String = ll_ensure_ptr(arg, ssa0, ir);
    let s: Int = ll_pssa(a0) + 1;
    let ty: String = if k == "ll_i" { "%OoLL_I" } else { "%OoLL_S" };
    let fnm: String = if k == "ll_i" { "@oo_ll_I_len" } else { "@oo_ll_S_len" };
    ll_ir_inst(ir, "call", "i64", ll_ssa(s), fnm + "(ptr byval(" + ty + ") align 8 " + ll_pptr(a0) + ")", 1, 1);
    return ll_pack(0, s, "i64", "");
}

fn ll_ll_get(arg: String, idx: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let k: String = ll_pk(arg);
    let a0: String = ll_ensure_ptr(arg, ssa0, ir);
    let s: Int = ll_pssa(a0) + 1;
    let out: String = ll_tmpa(s);
    let rk: String = if k == "ll_i" { "ilist" } else { "slist" };
    let ty: String = if k == "ll_i" { "%OoLL_I" } else { "%OoLL_S" };
    let ety: String = if k == "ll_i" { "%OoIList" } else { "%OoSList" };
    let fnm: String = if k == "ll_i" { "@oo_ll_I_get" } else { "@oo_ll_S_get" };
    ll_slot_ty(out, ety, ir);
    ll_ir_inst(ir, "call", "void", "", fnm + "(ptr sret(" + ety + ") align 8 " + out + ", ptr byval(" + ty + ") align 8 " + ll_pptr(a0) + ", i64 " + ll_opnd(idx) + ")", 1, 1);
    return ll_pack(0, s, rk, out);
}

fn ll_ll_push(arg: String, val: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let k: String = ll_pk(arg);
    let a0: String = ll_ensure_ptr(arg, ssa0, ir);
    let vp: String = ll_ensure_ptr(val, ll_pssa(a0), ir);
    let s: Int = ll_pssa(vp) + 1;
    let out: String = ll_tmpa(s);
    let ty: String = if k == "ll_i" { "%OoLL_I" } else { "%OoLL_S" };
    let ety: String = if k == "ll_i" { "%OoIList" } else { "%OoSList" };
    let fnm: String = if k == "ll_i" { "@oo_ll_I_push" } else { "@oo_ll_S_push" };
    ll_slot_ty(out, ty, ir);
    ll_ir_inst(ir, "call", "void", "", fnm + "(ptr sret(" + ty + ") align 8 " + out + ", ptr byval(" + ty + ") align 8 " + ll_pptr(a0) + ", ptr byval(" + ety + ") align 8 " + ll_pptr(vp) + ")", 1, 1);
    return ll_pack(0, s, k, out);
}

fn ll_ll_set(arg: String, idx: String, val: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let k: String = ll_pk(arg);
    let a0: String = ll_ensure_ptr(arg, ssa0, ir);
    let vp: String = ll_ensure_ptr(val, ll_pssa(a0), ir);
    let s: Int = ll_pssa(vp) + 1;
    let out: String = ll_tmpa(s);
    let ty: String = if k == "ll_i" { "%OoLL_I" } else { "%OoLL_S" };
    let ety: String = if k == "ll_i" { "%OoIList" } else { "%OoSList" };
    let fnm: String = if k == "ll_i" { "@oo_ll_I_set" } else { "@oo_ll_S_set" };
    ll_slot_ty(out, ty, ir);
    ll_ir_inst(ir, "call", "void", "", fnm + "(ptr sret(" + ty + ") align 8 " + out + ", ptr byval(" + ty + ") align 8 " + ll_pptr(a0) + ", i64 " + ll_opnd(idx) + ", ptr byval(" + ety + ") align 8 " + ll_pptr(vp) + ")", 1, 1);
    return ll_pack(0, s, k, out);
}

fn ll_ll_slice(arg: String, lo: String, hi: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let k: String = ll_pk(arg);
    let a0: String = ll_ensure_ptr(arg, ssa0, ir);
    let s: Int = ll_pssa(a0) + 1;
    let out: String = ll_tmpa(s);
    let ty: String = if k == "ll_i" { "%OoLL_I" } else { "%OoLL_S" };
    let fnm: String = if k == "ll_i" { "@oo_ll_I_slice" } else { "@oo_ll_S_slice" };
    ll_slot_ty(out, ty, ir);
    ll_ir_inst(ir, "call", "void", "", fnm + "(ptr sret(" + ty + ") align 8 " + out + ", ptr byval(" + ty + ") align 8 " + ll_pptr(a0) + ", i64 " + ll_opnd(lo) + ", i64 " + ll_opnd(hi) + ")", 1, 1);
    return ll_pack(0, s, k, out);
}

pub fn ll_olist_builtin(name: String, args: List[String], ssa0: Int, expect: String, ir: &mut IrBuf) -> String {
    if name == "list_new" {
        if ll_is_olist(expect) { return ll_olist_new(expect, ssa0, ir); }
        if expect == "ll_i" || expect == "ll_s" { return ll_ll_new(expect, ssa0, ir); }
    }
    let na: Int = list_len(args);
    if na < 1 { return ""; }
    let k0: String = ll_pk(list_get(args, 0));
    if k0 == "ll_i" || k0 == "ll_s" {
        if name == "list_len" && na >= 1 { return ll_ll_len(list_get(args, 0), ssa0, ir); }
        if name == "list_get" && na >= 2 { return ll_ll_get(list_get(args, 0), list_get(args, 1), ssa0, ir); }
        if name == "list_push" && na >= 2 { return ll_ll_push(list_get(args, 0), list_get(args, 1), ssa0, ir); }
        if name == "list_set" && na >= 3 { return ll_ll_set(list_get(args, 0), list_get(args, 1), list_get(args, 2), ssa0, ir); }
        if name == "list_slice" && na >= 3 { return ll_ll_slice(list_get(args, 0), list_get(args, 1), list_get(args, 2), ssa0, ir); }
        return "";
    }
    if !ll_is_olist(k0) { return ""; }
    if name == "list_len" && na >= 1 { return ll_olist_len(list_get(args, 0), ssa0, ir); }
    if name == "list_get" && na >= 2 { return ll_olist_get(list_get(args, 0), list_get(args, 1), ssa0, expect, ir); }
    if name == "list_push" && na >= 2 { return ll_olist_push(list_get(args, 0), list_get(args, 1), ssa0, ir); }
    if name == "list_set" && na >= 3 { return ll_olist_set(list_get(args, 0), list_get(args, 1), list_get(args, 2), ssa0, ir); }
    if name == "list_slice" && na >= 3 { return ll_olist_slice(list_get(args, 0), list_get(args, 1), list_get(args, 2), ssa0, ir); }
    return "";
}
