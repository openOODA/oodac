// # LLVM float (f64) lowering
//
// Logline: f64 literals, arithmetic, comparisons, negation, conditions, print.
//
// Setup: Kind "f64" maps to IR double. No mixed int/float exists: the checker
//   rejects those programs, and any that arrive here fail closed.
//
// Beats:
//   1. FLOAT literals (digits.digits) pack as #imm and print as constants.
//   2. Pure f64 + - * / lower to fadd/fsub/fmul/fdiv.
//   3. == != < > <= >= lower to ordered fcmp predicates (NaN-safe like C).
//   4. Unary minus lowers to fneg; bare conditions to fcmp une.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_ir.oo";

pub fn ll_float_lit(toks: List[String], pos: Int, ssa0: Int, ir: &mut IrBuf) -> String {
    let s: Int = ssa0 + 1;
    return ll_pack(pos + 1, s, "f64", "#" + ll_t(toks, pos));
}

pub fn ll_apply_floatop(op: String, lhs: String, rhs: String, ir: &mut IrBuf) -> String {
    let s0: Int = ll_hw(ll_pssa(lhs), ll_pssa(rhs));
    if op == "PLUS" {
        let s: Int = s0 + 1;
        ll_ir_inst(ir, "fadd", "double", ll_ssa(s), ll_opnd(lhs) + ", " + ll_opnd(rhs), 1, 1);
        return ll_pack(ll_ppos(rhs), s, "f64", "");
    }
    if op == "MINUS" {
        let s: Int = s0 + 1;
        ll_ir_inst(ir, "fsub", "double", ll_ssa(s), ll_opnd(lhs) + ", " + ll_opnd(rhs), 1, 1);
        return ll_pack(ll_ppos(rhs), s, "f64", "");
    }
    if op == "STAR" {
        let s: Int = s0 + 1;
        ll_ir_inst(ir, "fmul", "double", ll_ssa(s), ll_opnd(lhs) + ", " + ll_opnd(rhs), 1, 1);
        return ll_pack(ll_ppos(rhs), s, "f64", "");
    }
    if op == "SLASH" {
        let s: Int = s0 + 1;
        ll_ir_inst(ir, "fdiv", "double", ll_ssa(s), ll_opnd(lhs) + ", " + ll_opnd(rhs), 1, 1);
        return ll_pack(ll_ppos(rhs), s, "f64", "");
    }
    if op == "EQEQ" || op == "NEQ" || op == "LT" || op == "GT" || op == "LTE" || op == "GTE" {
        let mut pred: String = "oeq";
        if op == "NEQ" { pred = "one"; }
        if op == "LT" { pred = "olt"; }
        if op == "GT" { pred = "ogt"; }
        if op == "LTE" { pred = "ole"; }
        if op == "GTE" { pred = "oge"; }
        let s: Int = s0 + 1;
        ll_ir_inst(ir, "fcmp " + pred, "double", ll_ssa(s), ll_opnd(lhs) + ", " + ll_opnd(rhs), 1, 1);
        return ll_pack(ll_ppos(rhs), s, "i1", "");
    }
    println("ERR\tllvm\tfloat op " + op);
    process_exit(1);
    return ll_pack(ll_ppos(rhs), s0, "f64", "");
}

pub fn ll_neg_float(r: String, ir: &mut IrBuf) -> Int {
    let s: Int = ll_pssa(r) + 1;
    ll_ir_inst(ir, "fneg", "double", ll_ssa(s), ll_ssa(ll_pssa(r)), 1, 1);
    return s;
}

pub fn ll_float_cond(v: String, ssa0: Int, ir: &mut IrBuf) -> Int {
    let s: Int = ssa0 + 1;
    ll_ir_inst(ir, "fcmp une", "double", ll_ssa(s), ll_ssa(ll_pssa(v)) + ", 0.0", 1, 1);
    return s;
}

pub fn ll_print_float(ssa: Int, ptr: String, ssa0: Int, ir: &mut IrBuf) -> Int {
    let mut ds: Int = ssa;
    let mut ns: Int = ssa0;
    if ptr != "" {
        ds = ssa0 + 1;
        ns = ds;
        ll_ir_inst(ir, "load", "double", ll_ssa(ds), "ptr " + ptr + ", align 8", 1, 1);
    }
    ll_ir_inst(ir, "call", "void", "", "@oo_print_double(double " + ll_ssa(ds) + ")", 1, 1);
    ll_ir_inst(ir, "call", "void", "", "@oo_println()", 1, 1);
    return ns;
}
