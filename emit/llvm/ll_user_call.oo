// # LLVM user-call and call-at
//
// Logline: Lower user function calls and IDENT( argument lists.
//
// Setup: Sigs from env. sret/byval for memory returns. Ref args are ptr.
//
// Beats:
//   1. Int immediates use ll_opnd.
//   2. Unknown callee fails closed.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_slot.oo";
import "ll_builtin.oo";
import "ll_expr.oo";
import "types/types_core.oo";
import "ll_ir.oo";
import "ll_range.oo";
import "ll_c_abi.oo";

pub fn ll_user_call(name: String, sig: String, args: List[String], ssa0: Int, ir: &mut IrBuf) -> String {
    let gt: Int = str_index_of(sig, ">");
    if gt < 0 {
        println("ERR\tllvm\tmissing sig for " + name);
        process_exit(1);
    }
    let ret: String = str_slice(sig, gt + 1, chars_len(sig));
    let na: Int = list_len(args);
    let mut call: String = "";
    let mut i: Int = 0;
    let mut s: Int = ssa0;
    while i < na {
        let a: String = list_get(args, i);
        if ll_is_mem(ll_pk(a)) {
            let ap: String = ll_ensure_ptr(a, s, ir);
            s = ll_pssa(ap);
            if call != "" { call = call + ", "; }
            call = call + ll_pass(ll_pk(ap)) + " " + ll_pptr(ap);
        } else {
            let k: String = ll_pk(a);
            if ll_is_niche_ptr(k) {
                if ll_is_c_abi_call(name) {
                    let packed: String = ll_c_abi_pack_arg(a, s, ir);
                    s = ll_pssa(packed);
                    if call != "" { call = call + ", "; }
                    call = call + "ptr byval(%OoOpt_Ptr) align 8 " + ll_pptr(packed);
                } else {
                    if call != "" { call = call + ", "; }
                    let mut pval: String = ll_opnd(a);
                    if ll_is_imm(a) {
                        pval = str_slice(ll_pptr(a), 1, chars_len(ll_pptr(a)));
                    } else if ll_pptr(a) != "" {
                        pval = ll_pptr(a);
                    }
                    call = call + "ptr " + pval;
                }
            } else if ll_is_refk(k) {
                if call != "" { call = call + ", "; }
                call = call + "ptr " + ll_pptr(a);
            } else if k == "str" {
                let av: String = ll_as_val(a, s, ir);
                s = ll_pssa(av);
                if call != "" { call = call + ", "; }
                call = call + ll_ir_val(k) + " " + ll_ssa(ll_pssa(av));
            } else {
                let pk: String = ll_sig_param(sig, i);
                if pk != "" && ll_is_int(k) && ll_is_int(pk) && k != pk {
                    let av: String = ll_int_convert(a, ll_hw(s, ll_pssa(a)), pk, ir);
                    s = ll_pssa(av);
                    if call != "" { call = call + ", "; }
                    call = call + ll_ir_val(ll_pk(av)) + " " + ll_opnd(av);
                } else {
                    if call != "" { call = call + ", "; }
                    call = call + ll_ir_val(k) + " " + ll_opnd(a);
                }
            }
        }
        i = i + 1;
    }
    if ret == "void" || ret == "" {
        ll_ir_inst(ir, "call", "void", "", "@" + name + "(" + call + ")", 1, 1);
        return ll_pack(0, s, "void", "");
    }
    if ll_is_niche_ptr(ret) {
        if ll_is_c_abi_call(name) {
            let a: String = ll_tmpa(s + 1);
            s = s + 1;
            ll_slot_ty(a, "%OoOpt_Ptr", ir);
            if call != "" {
                ll_ir_inst(ir, "call", "void", "", "@" + name + "(ptr sret(%OoOpt_Ptr) align 8 " + a + ", " + call + ")", 1, 1);
            } else {
                ll_ir_inst(ir, "call", "void", "", "@" + name + "(ptr sret(%OoOpt_Ptr) align 8 " + a + ")", 1, 1);
            }
            return ll_c_abi_unpack_ret(a, s, ir);
        }
        let s2: Int = s + 1;
        ll_ir_inst(ir, "call", "ptr", ll_ssa(s2), "@" + name + "(" + call + ")", 1, 1);
        return ll_pack(0, s2, ret, "");
    }
    if ll_is_mem(ret) {
        let a: String = ll_tmpa(s + 1);
        s = s + 1;
        ll_slot_ty(a, ll_ir_alloc(ret), ir);
        if call != "" {
            ll_ir_inst(ir, "call", "void", "", "@" + name + "(ptr sret(" + ll_ir_alloc(ret) + ") align 8 " + a + ", " + call + ")", 1, 1);
        } else {
            ll_ir_inst(ir, "call", "void", "", "@" + name + "(ptr sret(" + ll_ir_alloc(ret) + ") align 8 " + a + ")", 1, 1);
        }
        return ll_pack(0, s, ret, a);
    }
    let s2: Int = s + 1;
    let meta: String = if ll_range_is_bint(ret) { ll_range_meta_load(ret, "") } else { "" };
    ll_ir_inst(ir, "call", ll_ir_val(ret), ll_ssa(s2), "@" + name + "(" + call + ")" + meta, 1, 1);
    return ll_pack(0, s2, ret, "");
}

pub fn ll_call_at(toks: List[String], pos: Int, n: Int, ssa0: Int, env: String, ir: &mut IrBuf) -> String {
    let nm: String = ll_t(toks, pos);
    let mut p: Int = pos + 1;
    if p >= n || ll_k(toks, p) != "LPAREN" {
        println("ERR\tllvm\tcall");
        process_exit(1);
    }
    p = p + 1;
    let sig0: String = type_env_get(env, "__fn__" + nm);
    let mut args: List[String] = list_new();
    let mut ssa: Int = ssa0;
    let mut ai: Int = 0;
    while p < n && ll_k(toks, p) != "RPAREN" {
        if ll_k(toks, p) == "COMMA" { p = p + 1; continue; }
        let mut aenv: String = str_slice(env, 0, chars_len(env));
        if sig0 != "" {
            let pk: String = ll_sig_param(sig0, ai);
            if pk != "" { aenv = type_env_put(aenv, "__e__", pk); }
        }
        let a: String = ll_expr(toks, p, n, ssa, aenv, ir);
        args = list_push(args, a);
        p = ll_ppos(a); ssa = ll_pssa(a);
        ai = ai + 1;
    }
    if p < n && ll_k(toks, p) == "RPAREN" { p = p + 1; }
    let mut expect: String = type_env_get(env, "__e__");
    if nm == "list_new" && (expect == "" || expect == "i64" || expect == "void") {
        expect = ll_guess_list_kind(toks, pos, n);
    }
    let b: String = ll_builtin(nm, args, ssa, expect, ir);
    if b != "" {
        return ll_pack(p, ll_pssa(b), ll_pk(b), ll_pptr(b));
    }
    let sig: String = type_env_get(env, "__fn__" + nm);
    if sig == "" {
        println("ERR\tllvm\tunknown call " + nm);
        process_exit(1);
    }
    let mut gnm: String = type_env_get(env, "__sym__" + nm);
    if gnm == "" { gnm = nm; }
    let u: String = ll_user_call(gnm, sig, args, ssa, ir);
    return ll_pack(p, ll_pssa(u), ll_pk(u), ll_pptr(u));
}
