// # LLVM struct layouts and literals
// Logline: Lower type struct to St kinds, %St types, retain/release, literals.
// Setup: Thread __st__/__stf__ in env; rich kinds carry table for bare field ops.
// Beats: St kinds plus rich tables; %St types plus retain/release; literals fail closed.
import "ll_tok.oo";
import "ll_ty.oo";
import "ll_struct_list.oo";
import "types/types_core.oo";
import "lex/token_parse_int.oo";
pub fn ll_struct_kind(name: String) -> String {
    return "St_" + name;
}
pub fn ll_is_struct(kind: String) -> Bool {
    if chars_len(kind) < 3 { return false; }
    if str_slice(kind, 0, 3) != "St_" { return false; }
    return true;
}
fn ll_st_basek(kind: String) -> String {
    if !ll_is_struct(kind) { println("ERR\tllvm\tstruct kind " + kind); process_exit(1); }
    let h: Int = str_index_of(kind, "#");
    if h < 0 { return kind; }
    return str_slice(kind, 0, h);
}
pub fn ll_struct_field(kind: String, field: String) -> String {
    if !ll_is_struct(kind) { return ""; }
    let h: Int = str_index_of(kind, "#");
    if h < 0 { return ""; }
    let body: String = str_slice(kind, h + 1, chars_len(kind));
    let n: Int = chars_len(body);
    let mut i: Int = 0; let mut idx: Int = 0; let mut cur: String = "";
    while i <= n {
        let e: Bool = i == n || char_at(body, i) == ",";
        if e {
            if cur != "" {
                let c: Int = str_index_of(cur, ":");
                if c >= 0 {
                    if str_slice(cur, 0, c) == field {
                        return idx.to_string() + ":" + ll_st_map(str_slice(cur, c + 1, chars_len(cur)), "|", ",");
                    }
                    idx = idx + 1;
                }
            }
            cur = "";
            i = i + 1;
        } else { cur = cur + char_at(body, i); i = i + 1; }
    }
    return "";
}
pub fn ll_struct_field_ptr(kind: String, ptr: String, field: String, ssa0: Int) -> String {
    let fi: String = ll_struct_field(kind, field);
    if fi == "" || str_index_of(fi, ":") < 0 { println("ERR\tllvm\tunknown field " + field); process_exit(1); }
    let ci: Int = str_index_of(fi, ":");
    let idx: String = str_slice(fi, 0, ci); let fk: String = str_slice(fi, ci + 1, chars_len(fi)); let s: Int = ssa0 + 1;
    println("  " + ll_ssa(s) + " = getelementptr %" + ll_st_basek(kind) + ", ptr " + ptr + ", i32 0, i32 " + idx);
    return ll_pack(0, s, fk, ll_ssa(s));
}
pub fn ll_struct_field_load(kind: String, ssa: Int, ptr: String, field: String, ssa0: Int) -> String {
    if ptr == "" { println("ERR\tllvm\tstruct load no ptr"); process_exit(1); }
    let fp: String = ll_struct_field_ptr(kind, ptr, field, ssa0);
    let fk: String = ll_pk(fp);
    let t: Int = ll_pssa(fp) + 1;
    println("  " + ll_ssa(t) + " = load " + ll_ir_val(fk) + ", ptr " + ll_pptr(fp));
    return ll_pack(0, t, fk, "");
}
pub fn ll_struct_declare(toks: List[String]) -> String {
    let n: Int = list_len(toks); let mut env: String = ""; let mut i: Int = 0;
    while i < n {
        if ll_k(toks, i) == "KW_TYPE" {
            let mut q: Int = i + 1;
            if q < n && ll_k(toks, q) == "IDENT" {
                let nm: String = ll_t(toks, q);
                q = q + 1;
                if q < n && ll_k(toks, q) == "EQ" {
                    q = q + 1;
                    if q < n && ll_k(toks, q) == "IDENT" && ll_t(toks, q) == "struct" {
                        q = q + 1;
                        if q < n && ll_k(toks, q) == "LBRACE" {
                            q = q + 1;
                            if type_env_get(env, "__st__" + nm) != "" { println("ERR\tllvm\tdup struct " + nm); process_exit(1); }
                            let mut idx: Int = 0; // decl fields in order
                            while q < n && ll_k(toks, q) != "RBRACE" {
                                if ll_k(toks, q) == "COMMA" { q = q + 1; continue; }
                                if ll_k(toks, q) != "IDENT" { println("ERR\tllvm\tstruct field"); process_exit(1); }
                                let fld: String = ll_t(toks, q);
                                if type_env_get(env, "__stf__" + nm + "." + fld) != "" { println("ERR\tllvm\tdup field " + fld); process_exit(1); }
                                q = q + 1;
                                if q >= n || ll_k(toks, q) != "COLON" { println("ERR\tllvm\tstruct colon"); process_exit(1); }
                                q = q + 1;
                                let fk: String = ll_ty_at(toks, q, n, ll_struct_tab_of(env)); env = type_env_put(env, "__stf__" + nm + "." + fld, idx.to_string() + ":" + fk);
                                idx = idx + 1; q = ll_skip_type(toks, q, n);
                            }
                            if q >= n || ll_k(toks, q) != "RBRACE" { println("ERR\tllvm\tstruct rbrace"); process_exit(1); }
                            env = type_env_put(env, "__st__" + nm, idx.to_string());
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return env;
}
pub fn ll_struct_emit_types(env: String) {
    println("declare void @oo_str_retain({ ptr, i64 })");
    println("declare void @oo_str_release({ ptr, i64 })");
    println("declare void @oo_slist_retain(ptr byval(%OoSList) align 8)");
    println("declare void @oo_slist_release(ptr byval(%OoSList) align 8)");
    println("declare void @oo_ilist_retain(ptr byval(%OoIList) align 8)");
    println("declare void @oo_ilist_release(ptr byval(%OoIList) align 8)");
    println("declare ptr @oo_list_alloc_payload(i64, i64)");
    let n: Int = chars_len(env); let mut i: Int = 0;
    while i < n {
        if i + 6 <= n && str_slice(env, i, i + 6) == "__st__" {
            let mut e: Int = i + 6;
            while e < n && char_at(env, e) != "=" { e = e + 1; }
            let nm: String = str_slice(env, i + 6, e); e = e + 1;
            let mut c: Int = e;
            while c < n && char_at(env, c) != ";" { c = c + 1; }
            let pre: String = "__stf__" + nm + "."; let pl: Int = chars_len(pre);
            let mut tys: String = ""; let mut fl: String = ""; let mut j: Int = 0;
            while j < n {
                if j + pl <= n && str_slice(env, j, j + pl) == pre {
                    let mut k: Int = j + pl;
                    while k < n && char_at(env, k) != "=" { k = k + 1; }
                    k = k + 1;
                    let mut m: Int = k;
                    while m < n && char_at(env, m) != ";" { m = m + 1; }
                    let val: String = str_slice(env, k, m); let ci: Int = str_index_of(val, ":");
                    if ci < 0 { println("ERR\tllvm\tstruct tab"); process_exit(1); }
                    let fk: String = str_slice(val, ci + 1, chars_len(val));
                    if tys != "" { tys = tys + ", "; }
                    tys = tys + ll_ir_alloc(fk);
                    if fl != "" { fl = fl + ","; }
                    fl = fl + ll_st_map(fk, ",", "|"); j = m;
                }
                j = j + 1;
            }
            println("%St_" + nm + " = type { " + tys + " }");
            println("define void @oo_retain_St_" + nm + "(ptr %p) {");
            ll_st_rr(fl, nm, 1);
            println("  ret void");
            println("}");
            println("define void @oo_release_St_" + nm + "(ptr %p) {");
            ll_st_rr(fl, nm, 0);
            println("  ret void");
            println("}");
            ll_olist_emit_one(nm);
            i = c;
        }
        i = i + 1;
    }
}
fn ll_st_rr(fl: String, nm: String, is_ret: Int) {
    let mut op: String = "retain";
    if is_ret == 0 { op = "release"; }
    let n: Int = chars_len(fl); let mut i: Int = 0; let mut idx: Int = 0; let mut cur: String = ""; let mut s: Int = 10;
    while i <= n {
        let e: Bool = i == n || char_at(fl, i) == ",";
        if e {
            if cur != "" {
                let fk: String = ll_st_map(cur, "|", ",");
                if fk != "i64" && fk != "i1" && fk != "opti" {
                    println("  " + ll_ssa(s) + " = getelementptr %St_" + nm + ", ptr %p, i32 0, i32 " + idx.to_string());
                    if fk == "str" {
                        println("  " + ll_ssa(s + 1) + " = load { ptr, i64 }, ptr " + ll_ssa(s));
                        println("  call void @oo_str_" + op + "({ ptr, i64 } " + ll_ssa(s + 1) + ")");
                    } else if fk == "slist" || fk == "ilist" {
                        println("  call void @oo_" + fk + "_" + op + "(ptr byval(" + ll_ir_alloc(fk) + ") align 8 " + ll_ssa(s) + ")");
                    } else if ll_is_struct(fk) {
                        println("  call void @oo_" + op + "_" + ll_st_basek(fk) + "(ptr " + ll_ssa(s) + ")");
                    } else {
                        let mut inner: Int = 1;
                        if fk == "resi" { inner = 2; }
                        println("  " + ll_ssa(s + 1) + " = getelementptr " + ll_ir_alloc(fk) + ", ptr " + ll_ssa(s) + ", i32 0, i32 " + inner.to_string());
                        println("  " + ll_ssa(s + 2) + " = load { ptr, i64 }, ptr " + ll_ssa(s + 1));
                        println("  call void @oo_str_" + op + "({ ptr, i64 } " + ll_ssa(s + 2) + ")");
                    }
                }
                if fk == "slist" || fk == "ilist" || ll_is_struct(fk) { s = s + 1; } else if fk == "i64" || fk == "i1" || fk == "opti" { s = s; } else { s = s + 2; }
                idx = idx + 1; cur = "";
            }
            i = i + 1;
        } else { cur = cur + char_at(fl, i); i = i + 1; }
    }
}
pub fn ll_struct_lit_at(toks: List[String], pos: Int, n: Int, ssa0: Int, env: String) -> String {
    let nm: String = ll_t(toks, pos);
    if type_env_get(env, "__st__" + nm) == "" { println("ERR\tllvm\tunknown struct " + nm); process_exit(1); }
    if pos + 1 >= n || ll_k(toks, pos + 1) != "LBRACE" { println("ERR\tllvm\tstruct lit"); process_exit(1); }
    let a: String = ll_tmpa(ssa0 + 1); let mut s: Int = ssa0 + 1;
    println("  " + a + " = alloca %St_" + nm + ", align 8");
    let mut rich: String = "St_" + nm + "#"; let mut first: Bool = true;
    let en: Int = chars_len(env); let pre: String = "__stf__" + nm + "."; let pl: Int = chars_len(pre); let mut j: Int = 0;
    while j < en {
        if j + pl <= en && str_slice(env, j, j + pl) == pre {
            let mut k: Int = j + pl;
            while k < en && char_at(env, k) != "=" { k = k + 1; }
            let fld: String = str_slice(env, j + pl, k);
            k = k + 1;
            let mut m: Int = k;
            while m < en && char_at(env, m) != ";" { m = m + 1; }
            let seg: String = str_slice(env, k, m);
            let ci2: Int = str_index_of(seg, ":");
            let fk: String = str_slice(seg, ci2 + 1, chars_len(seg));
            if !first { rich = rich + ","; }
            rich = rich + fld + ":" + ll_st_map(fk, ",", "|");
            first = false;
            j = m;
        }
        j = j + 1;
    }
    let mut p: Int = pos + 2;
    while p < n && ll_k(toks, p) != "RBRACE" {
        if ll_k(toks, p) == "COMMA" { p = p + 1; continue; }
        if ll_k(toks, p) != "IDENT" { println("ERR\tllvm\tstruct lit field"); process_exit(1); }
        let fld2: String = ll_t(toks, p); let fe2: String = type_env_get(env, "__stf__" + nm + "." + fld2);
        if fe2 == "" { println("ERR\tllvm\tunknown field " + fld2); process_exit(1); }
        let cj2: Int = str_index_of(fe2, ":");
        let fk: String = str_slice(fe2, cj2 + 1, chars_len(fe2)); p = p + 1;
        if p >= n || ll_k(toks, p) != "COLON" { println("ERR\tllvm\tstruct lit colon"); process_exit(1); }
        p = p + 1;
        let v: String = ll_expr(toks, p, n, s, env); p = ll_ppos(v); s = ll_pssa(v);
        if ll_pk(v) != fk && ll_st_basek(ll_pk(v) + "#") != ll_st_basek(fk + "#") { println("ERR\tllvm\tfield type " + fld2); process_exit(1); }
        let fi: String = ll_struct_field(rich, fld2); let idx: String = str_slice(fi, 0, str_index_of(fi, ":"));
        s = s + 1;
        println("  " + ll_ssa(s) + " = getelementptr %St_" + nm + ", ptr " + a + ", i32 0, i32 " + idx);
        if ll_pptr(v) != "" {
            s = s + 1;
            println("  " + ll_ssa(s) + " = load " + ll_ir_val(fk) + ", ptr " + ll_pptr(v));
            println("  store " + ll_ir_val(fk) + " " + ll_ssa(s) + ", ptr " + ll_ssa(s - 1));
        } else {
            println("  store " + ll_ir_val(fk) + " " + ll_ssa(ll_pssa(v)) + ", ptr " + ll_ssa(s));
        }
    }
    if p >= n || ll_k(toks, p) != "RBRACE" { println("ERR\tllvm\tstruct lit rbrace"); process_exit(1); }
    return ll_pack(p + 1, s, rich, a);
}
