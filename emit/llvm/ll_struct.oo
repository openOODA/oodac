// # LLVM struct layouts and literals
// Logline: Lower type struct to St kinds, %St types, retain/release, literals.
// Setup: Thread __st__/__stf__ in env; rich kinds carry table for bare field ops.
// Beats: St kinds plus rich tables; %St types plus retain/release; literals fail closed.
import "ll_tok.oo";
import "ll_ty.oo";
import "ll_struct_list.oo";
import "ll_struct_rr.oo";
import "ll_slot.oo";
import "types/types_core.oo";
import "ll_ir.oo";
pub fn ll_struct_declare(toks: List[String], base: String) -> String {
    let n: Int = list_len(toks); let mut env: String = base; let mut i: Int = 0;
    while i < n {
        if ll_k(toks, i) == "KW_PUB" && i + 1 < n && ll_k(toks, i + 1) == "KW_TYPE" { i = i + 1; continue; }
        if ll_k(toks, i) == "KW_TYPE" {
            let mut q: Int = i + 1;
            if q < n && ll_k(toks, q) == "IDENT" {
                let nm: String = ll_t(toks, q);
                q = q + 1;
                if q < n && ll_k(toks, q) == "EQ" {
                    q = q + 1;
                    if q < n && ll_k(toks, q) == "IDENT" && ll_t(toks, q) == "struct" {
                        q = q + 1;
                        if q < n && ll_k(toks, q) == "LBRACE" {
                            q = q + 1;
                            if type_env_get(env, "__st__" + nm) != "" {
                                i = i + 1;
                                continue;
                            }
                            let mut idx: Int = 0; // decl fields in order
                            while q < n && ll_k(toks, q) != "RBRACE" {
                                if ll_k(toks, q) == "COMMA" { q = q + 1; continue; }
                                if ll_k(toks, q) != "IDENT" { println("ERR\tllvm\tstruct field"); process_exit(1); }
                                let fld: String = ll_t(toks, q);
                                if type_env_get(env, "__stf__" + nm + "." + fld) != "" { println("ERR\tllvm\tdup field " + fld); process_exit(1); }
                                q = q + 1;
                                if q >= n || ll_k(toks, q) != "COLON" { println("ERR\tllvm\tstruct colon"); process_exit(1); }
                                q = q + 1;
                                let fk: String = ll_ty_at(toks, q, n, ll_struct_tab_of(env)); env = type_env_put(env, "__stf__" + nm + "." + fld, idx.to_string() + ":" + fk);
                                idx = idx + 1; q = ll_skip_type(toks, q, n);
                            }
                            if q >= n || ll_k(toks, q) != "RBRACE" { println("ERR\tllvm\tstruct rbrace"); process_exit(1); }
                            env = type_env_put(env, "__st__" + nm, idx.to_string());
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return env;
}
pub fn ll_struct_emit_types(env: String, toks: List[String], ir: &mut IrBuf) {
    let n: Int = chars_len(env); let mut i: Int = 0;
    while i < n {
        if i + 6 <= n && str_slice(env, i, i + 6) == "__st__" {
            let mut e: Int = i + 6;
            while e < n && char_at(env, e) != "=" { e = e + 1; }
            let nm: String = str_slice(env, i + 6, e); e = e + 1;
            let mut c: Int = e;
            while c < n && char_at(env, c) != ";" { c = c + 1; }
            let pre: String = "__stf__" + nm + "."; let pl: Int = chars_len(pre);
            let mut tys: String = ""; let mut fl: String = ""; let mut j: Int = 0;
            while j < n {
                if j + pl <= n && str_slice(env, j, j + pl) == pre {
                    let mut k: Int = j + pl;
                    while k < n && char_at(env, k) != "=" { k = k + 1; }
                    k = k + 1;
                    let mut m: Int = k;
                    while m < n && char_at(env, m) != ";" { m = m + 1; }
                    let val: String = str_slice(env, k, m); let ci: Int = str_index_of(val, ":");
                    if ci < 0 { println("ERR\tllvm\tstruct tab"); process_exit(1); }
                    let fk: String = str_slice(val, ci + 1, chars_len(val));
                    if tys != "" { tys = tys + ", "; }
                    tys = tys + ll_ir_alloc(fk);
                    if fl != "" { fl = fl + ","; }
                    fl = fl + ll_st_map(fk, ",", "|"); j = m;
                }
                j = j + 1;
            }
            ll_ir_text(ir, "%St_" + nm + " = type { " + tys + " }");
            ll_ir_fn_open(ir, "define hidden void @oo_retain_St_" + nm + "(ptr noalias nocapture noundef %p) nounwind {");
            ll_heap(ir);
            ll_st_rr(fl, nm, 1, ir);
            ll_heap_end(ir);
            ll_ir_inst(ir, "ret", "void", "", "", 1, 1);
            ll_ir_fn_close(ir);
            ll_ir_fn_open(ir, "define hidden void @oo_release_St_" + nm + "(ptr noalias nocapture noundef %p) nounwind {");
            ll_heap(ir);
            ll_st_rr(fl, nm, 0, ir);
            ll_heap_end(ir);
            ll_ir_inst(ir, "ret", "void", "", "", 1, 1);
            ll_ir_fn_close(ir);
            ll_st_wrap_emit(nm, toks, ir);
            i = c;
        }
        i = i + 1;
    }
}
