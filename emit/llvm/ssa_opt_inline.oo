// # Static Single Assignment Function Inlining (stub)
//
// Logline: First-cut inliner scan that detects a call immediately followed by a ret in the same block and inserts a comment-marker instruction (op=0) carrying the call's target name.
//
// Setup: Pure linear pass over the SsaFunction parallel-instruction representation; performs no SSA rewriting, only marks trivial call+ret candidates for the real inliner to replace later.
//
// Beats:
//   1. Walk instructions linearly; for each call (op=46) check the following instruction.
//   2. If the following instruction is a ret (op=19) AND shares the same block_id, treat it as a trivial inlinable candidate.
//   3. Emit a single comment-marker instruction (op=0, res=0, imm=call's target name, lhs=0, block_id=same) immediately AFTER the ret.
//   4. Real SSA rewriting (clone callee body, rename, fix up phi nodes) is a multi-day follow-up; this stub produces only the marker the future inliner will replace.

import "ssa_ir.oo";

fn ssa_inline_update_list_local(xs: List[Int], idx: Int, val: Int) -> List[Int] {
    let n: Int = list_len(xs);
    let mut out: List[Int] = list_new();
    let mut k: Int = 0;
    while k < n {
        if k == idx { out = list_push(out, val); } else { out = list_push(out, list_get(xs, k)); }
        k = k + 1;
    }
    return out;
}

pub fn ssa_opt_inline(fn_data: SsaFunction) -> SsaFunction {
    let n: Int = (0 + ssa_fn_inst_count(fn_data));
    if n == 0 { return fn_data; }

    // Opcodes. ssa_op_call=46, ssa_op_ret=19. Marker opcode 0 is reserved for
    // inliner-emitted comment markers and is not a real instruction.
    let op_call: Int = 46;
    let op_ret: Int = 19;
    let op_marker: Int = 0;

    let mut new_ops: List[Int] = list_new();
    let mut new_res: List[Int] = list_new();
    let mut new_imms: List[Int] = list_new();
    let mut new_bids: List[Int] = list_new();
    let mut new_lhss: List[Int] = list_new();

    // pending_marker_imm is set when we see a ret that is preceded by a call in
    // the same block. We emit the marker AFTER the ret (immediately), so the
    // order in new_* is [call, ret, marker] (matches the test fixture's
    // expectations).
    let mut pending_marker_imm: Int = 0 - 1;
    let mut pending_marker_bid: Int = 0;

    let mut i: Int = 0;
    while i < n {
        let op: Int = list_get(fn_data.inst_opcodes, i);
        let res: Int = list_get(fn_data.inst_results, i);
        let imm: Int = list_get(fn_data.inst_imm_vals, i);
        let bid: Int = list_get(fn_data.inst_block_ids, i);

        // Pass through the original instruction.
        new_ops = list_push(new_ops, op);
        new_res = list_push(new_res, res);
        new_imms = list_push(new_imms, imm);
        new_lhss = list_push(new_lhss, 0);
        new_bids = list_push(new_bids, bid);

        // If the just-pushed instruction is a ret AND we have a pending marker
        // from a previous call in this block, emit the marker now (after ret).
        if op == op_ret && pending_marker_imm != 0 - 1 {
            new_ops = list_push(new_ops, op_marker);
            new_res = list_push(new_res, 0);
            new_imms = list_push(new_imms, pending_marker_imm);
            new_lhss = list_push(new_lhss, 0);
            new_bids = list_push(new_bids, pending_marker_bid);
            pending_marker_imm = 0 - 1;
        }

        if op == op_call && (i + 1) < n {
            let next_op: Int = list_get(fn_data.inst_opcodes, i + 1);
            let next_bid: Int = list_get(fn_data.inst_block_ids, i + 1);
            if next_op == op_ret && next_bid == bid {
                // Mark: the next instruction (ret) needs a marker after it.
                pending_marker_imm = imm;
                pending_marker_bid = bid;
            }
        }
        i = i + 1;
    }

    return SsaFunction {
        name: fn_data.name,
        return_type: fn_data.return_type,
        block_count: fn_data.block_count,
        block_names: fn_data.block_names,
        inst_opcodes: new_ops,
        inst_results: new_res,
        inst_imm_vals: new_imms,
        inst_lhs_vals: new_lhss,
        inst_block_ids: new_bids
    };
}
