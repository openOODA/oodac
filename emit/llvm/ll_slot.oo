// # LLVM entry-block typed allocas and lifetime bounds
//
// Logline: Canonical typed stack allocas and symmetric lifetime bounds.
//
// Setup: Replaces untyped buffers with exact LLVM types.
//
// Beats:
//   1. ll_slot_ty emits typed A records hoisted to function entry.
//   2. ll_lifetime_start and ll_lifetime_end emit symmetric scope intrinsics.
//   3. Zero untyped stack memory buffer allocations.

import "ll_ir.oo";

pub fn ll_heap(ir: &mut IrBuf) {
    ir.recs = ir.recs + "";
}

pub fn ll_heap_end(ir: &mut IrBuf) {
    ir.recs = ir.recs + "";
}

pub fn ll_slot_ty(dst: String, ty: String, ir: &mut IrBuf) {
    let mut t: String = ty;
    if t == "" { t = "i64"; }
    ll_ir_push(ir, "A\t" + t + "\t" + dst);
}

pub fn ll_slot_size(ty: String) -> Int {
    if ty == "i1" || ty == "i8" || ty == "u8" { return 1; }
    if ty == "i16" || ty == "u16" { return 2; }
    if ty == "i32" || ty == "u32" { return 4; }
    if ty == "i64" || ty == "u64" || ty == "double" || ty == "ptr" { return 8; }
    if ty == "%OoStr" || ty == "{ ptr, i64 }" { return 16; }
    if ty == "%OoSList" || ty == "%OoIList" || ty == "%OoFList" || ty == "%OoLL_I" || ty == "%OoLL_S" { return 24; }
    if chars_len(ty) >= 5 && str_slice(ty, 0, 5) == "%OoL_" { return 24; }
    if ty == "%OoOptI" { return 16; }
    if ty == "%OoOptS" || ty == "%OoResS" || ty == "%OoResV" { return 24; }
    if ty == "%OoResI" { return 32; }
    if ty == "%OoResL" || ty == "%OoResLI" { return 48; }
    if chars_len(ty) >= 10 && str_slice(ty, 0, 10) == "%OoOpt_St_" { return -1; }
    if chars_len(ty) >= 10 && str_slice(ty, 0, 10) == "%OoRes_St_" { return -1; }
    if chars_len(ty) >= 4 && str_slice(ty, 0, 4) == "%St_" { return -1; }
    if chars_len(ty) >= 3 && str_slice(ty, 0, 1) == "[" { return -1; }
    return 8;
}

pub fn ll_lifetime_start(dst: String, size_bytes: Int, ir: &mut IrBuf) {
    ll_ir_inst(ir, "call", "void", "", "@llvm.lifetime.start.p0(i64 " + size_bytes.to_string() + ", ptr " + dst + ")", 1, 1);
}

pub fn ll_lifetime_end(dst: String, size_bytes: Int, ir: &mut IrBuf) {
    ll_ir_inst(ir, "call", "void", "", "@llvm.lifetime.end.p0(i64 " + size_bytes.to_string() + ", ptr " + dst + ")", 1, 1);
}

pub fn ll_nhash(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut h: Int = 0;
    let mut i: Int = 0;
    while i < n {
        h = h * 31 + byte_at(char_at(s, i), 0);
        i = i + 1;
    }
    if h < 0 { h = 0 - h; }
    return 20000 + (h % 20000);
}

pub fn ll_slot(dst: String, n: Int, ir: &mut IrBuf) {
    ll_slot_ty(dst, "i64", ir);
}

pub fn ll_slot_tmp(n: Int, ir: &mut IrBuf) -> String {
    let a: String = "%a" + n.to_string();
    ll_slot_ty(a, "i64", ir);
    return a;
}


pub fn ll_trap(ir: &mut IrBuf) {
    ll_heap_end(ir);
    ll_ir_inst(ir, "call", "void", "", "@oo_process_exit(i64 1)", 0, 0);
    ll_ir_inst(ir, "unreachable", "", "", "", 0, 0);
}
