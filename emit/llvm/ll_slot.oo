// # LLVM entry-block heap slots
//
// Logline: Per-local entry allocas; A records flushed before other insts.
//
// Setup: ll_slot_ty emits A records. ll_heap is a no-op.
//
// Beats:
//   1. Named Int slots are alloca i64.
//   2. Other slots are alloca [1024 x i8].

import "ll_ir.oo";

pub fn ll_heap(ir: &mut IrBuf) {
    ir.recs = ir.recs + "";
}

pub fn ll_heap_end(ir: &mut IrBuf) {
    ir.recs = ir.recs + "";
}

pub fn ll_slot_ty(dst: String, ty: String, ir: &mut IrBuf) {
    let mut t: String = ty;
    if t == "" { t = "i64"; }
    ll_ir_push(ir, "A\t" + t + "\t" + dst);
}

pub fn ll_nhash(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut h: Int = 0;
    let mut i: Int = 0;
    while i < n {
        h = h * 31 + byte_at(char_at(s, i), 0);
        i = i + 1;
    }
    if h < 0 { h = 0 - h; }
    return 20000 + (h % 20000);
}

pub fn ll_slot(dst: String, n: Int, ir: &mut IrBuf) {
    if n < 0 { ll_slot_ty(dst, "i64", ir); return; }
    ll_slot_ty(dst, "[1024 x i8]", ir);
}

pub fn ll_slot_tmp(n: Int, ir: &mut IrBuf) -> String {
    let a: String = "%a" + n.to_string();
    ll_slot(a, n, ir);
    return a;
}

pub fn ll_slot_name(dst: String, ir: &mut IrBuf) {
    ll_slot_ty(dst, "[1024 x i8]", ir);
}

pub fn ll_trap(ir: &mut IrBuf) {
    ll_heap_end(ir);
    ll_ir_inst(ir, "call", "void", "", "@oo_process_exit(i64 1)", 0, 0);
    ll_ir_inst(ir, "unreachable", "", "", "", 0, 0);
}
