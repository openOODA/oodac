// # LLVM integer div and rem with zero trap
//
// Logline: sdiv/udiv/srem/urem after an eq-zero check; trap is fail-closed.
//
// Setup: Called from ll_apply_intop. Labels use the SSA index as a suffix.
//
// Beats:
//   1. Divisor 0 calls oo_process_exit and unreachable.
//   2. Defined wrapping add/mul stay in ll_int.oo; only div is checked.

import "ll_tok.oo";
import "ll_ir.oo";

pub fn ll_int_div(op: String, inst: String, t: String, le: String, re: String, s: Int, ck: String, ir: &mut IrBuf) -> String {
    let tag: String = s.to_string();
    ll_ir_inst(ir, "icmp eq", t, ll_ssa(s), ll_opnd(re) + ", 0", 1, 1);
    ll_ir_inst(ir, "br", "i1", "", ll_ssa(s) + ", label %div0" + tag + ", label %divok" + tag, 1, 1);
    ll_ir_label(ir, "div0" + tag);
    ll_ir_inst(ir, "call", "void", "", "@oo_process_exit(i64 1)", 1, 1);
    ll_ir_inst(ir, "unreachable", "", "", "", 1, 1);
    ll_ir_label(ir, "divok" + tag);
    ll_ir_inst(ir, "xor", "i1", ll_ssa(s + 1), ll_ssa(s) + ", true", 1, 1);
    ll_ir_inst(ir, "call", "void", "", "@llvm.assume(i1 " + ll_ssa(s + 1) + ")", 1, 1);
    ll_ir_inst(ir, inst, t, ll_ssa(s + 2), ll_opnd(le) + ", " + ll_opnd(re), 1, 1);
    return ll_pack(ll_ppos(re), s + 2, ck, "");
}
