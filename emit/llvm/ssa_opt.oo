// # SSA Optimizer Pipeline (-O3)
//
// Logline: Multi-pass SSA optimization pipeline executing constant folding, dead code elimination, CSE, and LICM.
//
// Setup: Pure graph optimization engine performing deterministic instruction rewriting and control flow simplification.
//
// Beats:
//   1. Constant propagation and arithmetic folding.
//   2. Dead Code Elimination (DCE) removing unused definitions.
//   3. Common Subexpression Elimination (CSE) identifying identical computations.
//   4. Loop Invariant Code Motion (LICM) hoisting invariant expressions.

import "ssa_ir.oo";
import "ssa_opt_licm.oo";
import "ssa_opt_cse.oo";
import "ssa_opt_gvn.oo";
import "ssa_opt_inline.oo";
import "ssa_opt_tail_call.oo";

fn ssa_update_list_local(xs: List[Int], idx: Int, val: Int) -> List[Int] {
    let n: Int = list_len(xs);
    let mut out: List[Int] = list_new();
    let mut k: Int = 0;
    while k < n {
        if k == idx { out = list_push(out, val); } else { out = list_push(out, list_get(xs, k)); }
        k = k + 1;
    }
    return out;
}

pub fn ssa_opt_const_fold(fn_data: SsaFunction) -> SsaFunction {
    let n: Int = 0 + ssa_fn_inst_count(fn_data);
    let mut new_ops: List[Int] = list_new();
    let mut new_res: List[Int] = list_new();
    let mut new_imms: List[Int] = list_new();
    let mut new_bids: List[Int] = list_new();
    let mut new_lhss: List[Int] = list_new();

    // Floating-point opcodes (P2.10): 25=fadd, 26=fsub, 27=fmul, 28=fdiv, 29=frem.
    // fadd/fsub/fmul/fdiv with imm 0 are identities (except 0/0); fold to drop.
    let op_fadd: Int = 25;
    let op_fsub: Int = 26;
    let op_fmul: Int = 27;
    let op_fdiv: Int = 28;
    let op_frem: Int = 29;

    let mut i: Int = 0;
    while i < n {
        let op: Int = list_get(fn_data.inst_opcodes, i);
        let res: Int = list_get(fn_data.inst_results, i);
        let imm: Int = list_get(fn_data.inst_imm_vals, i);
        let lhs: Int = list_get(fn_data.inst_lhs_vals, i);
        let bid: Int = list_get(fn_data.inst_block_ids, i);

        if op == ssa_op_add() && imm == 0 {
            // Fold %x + 0 -> const 0
            new_ops = list_push(new_ops, ssa_op_const());
            new_res = list_push(new_res, res);
            new_imms = list_push(new_imms, 0);
            new_lhss = list_push(new_lhss, 0);
            new_bids = list_push(new_bids, bid);
        } else if op == ssa_op_sub() && imm == 0 {
            // Fold %x - 0 -> identity (drop op; res is whatever the lhs already was)
        } else if op == ssa_op_mul() && imm == 0 {
            // Fold %x * 0 -> const 0
            new_ops = list_push(new_ops, ssa_op_const());
            new_res = list_push(new_res, res);
            new_imms = list_push(new_imms, 0);
            new_lhss = list_push(new_lhss, 0);
            new_bids = list_push(new_bids, bid);
        } else if op == ssa_op_mul() && imm == 1 {
            // Fold %x * 1 -> identity (drop op)
        } else if op == ssa_op_sdiv() && imm == 1 {
            // Fold %x / 1 -> identity (drop op)
        } else if op == ssa_op_and() && imm == 0 {
            // Fold %x & 0 -> const 0
            new_ops = list_push(new_ops, ssa_op_const());
            new_res = list_push(new_res, res);
            new_imms = list_push(new_imms, 0);
            new_lhss = list_push(new_lhss, 0);
            new_bids = list_push(new_bids, bid);
        } else if op == ssa_op_and() && imm == (0 - 1) {
            // Fold %x & -1 (all-ones) -> identity (drop op)
        } else if op == ssa_op_or() && imm == 0 {
            // Fold %x | 0 -> identity (drop op)
        } else if op == ssa_op_xor() && imm == 0 {
            // Fold %x ^ 0 -> identity (drop op)
        } else if op == ssa_op_xor() && imm == (res) {
            // Fold %x ^ %x (same SSA reg in imm and res) -> const 0
            new_ops = list_push(new_ops, ssa_op_const());
            new_res = list_push(new_res, res);
            new_imms = list_push(new_imms, 0);
            new_lhss = list_push(new_lhss, 0);
            new_bids = list_push(new_bids, bid);
        } else if op == ssa_op_shl() && imm == 0 {
            // Fold %x << 0 -> identity (drop op)
        } else if op == ssa_op_shr() && imm == 0 {
            // Fold %x >> 0 -> identity (drop op)
        } else if op == ssa_op_const() && imm == (res) {
            // Fold const %x, x (self-referential) -> drop (no-op duplicate)
        } else if (op == op_fadd || op == op_fsub || op == op_fmul || op == op_fdiv || op == op_frem) && imm == 0 {
            // Fold fadd/fsub/fmul/fdiv/frem %x, 0.0 -> identity (drop op).
            // Note: 0.0/0.0 is NaN, but constant folder only sees the immediate 0; the
            // dynamic check is left to runtime. fdiv-by-zero path is handled by DCE/strength.
        } else {
            new_ops = list_push(new_ops, op);
            new_res = list_push(new_res, res);
            new_imms = list_push(new_imms, imm);
            new_lhss = list_push(new_lhss, lhs);
            new_bids = list_push(new_bids, bid);
        }
        i = i + 1;
    }

    return SsaFunction {
        name: fn_data.name,
        return_type: fn_data.return_type,
        block_count: fn_data.block_count,
        block_names: fn_data.block_names,
        inst_opcodes: new_ops,
        inst_results: new_res,
        inst_imm_vals: new_imms,
        inst_lhs_vals: new_lhss,
        inst_block_ids: new_bids
    };
}

pub fn ssa_opt_dce(fn_data: SsaFunction) -> SsaFunction {
    let n: Int = (0 + ssa_fn_inst_count(fn_data));
    if n == 0 {
        return fn_data;
    }
    // v0.216.0: real DCE. Previous version was an identity transform (see
    // SHIPPED.oot:35). Algorithm: worklist fixed-point. Step 1: mark all
    // side-effect instructions live. Step 2: for each live instruction,
    // mark its lhs and imm (when meaningful) value-refs as live, and the
    // producing instructions live. Step 3: drop everything not live.

    // live[i] = 1 if instruction i is live.
    let mut live: List[Int] = list_new();
    let mut init_i: Int = 0;
    while init_i < n {
        live = list_push(live, 0);
        init_i = init_i + 1;
    }
    // worklist: instruction indices to process.
    let mut worklist: List[Int] = list_new();
    // Step 1: seed worklist with side-effect instructions.
    let mut seed_i: Int = 0;
    while seed_i < n {
        let op: Int = list_get(fn_data.inst_opcodes, seed_i);
        let is_se: Bool = (op == 16) || (op == 17) || (op == 18) || (op == 19) || (op == 21) || (op == 23) || (op == 24) || (op == 46) || (op == 53) || (op == 54) || (op == 55);
        if is_se {
            if list_get(live, seed_i) == 0 {
                live = ssa_update_list_local(live, seed_i, 1);
                worklist = list_push(worklist, seed_i);
            }
        }
        seed_i = seed_i + 1;
    }
    // Step 2: worklist. For each live instruction, mark its producers live.
    let mut wl_len: Int = list_len(worklist);
    let mut wl_pos: Int = 0;
    while wl_pos < wl_len {
        let i: Int = list_get(worklist, wl_pos);
        let lhs: Int = list_get(fn_data.inst_lhs_vals, i);
        let imm: Int = list_get(fn_data.inst_imm_vals, i);
        // Find producer of lhs.
        let mut p: Int = 0;
        while p < n {
            let r: Int = list_get(fn_data.inst_results, p);
            if r == lhs && list_get(live, p) == 0 {
                live = ssa_update_list_local(live, p, 1);
                worklist = list_push(worklist, p);
                wl_len = wl_len + 1;
            }
            p = p + 1;
        }
        // Find producer of imm (only when imm is a value ref, not a slot/block id).
        let op: Int = list_get(fn_data.inst_opcodes, i);
        let imm_is_value: Bool = !((op == 14) || (op == 15) || (op == 16) || (op == 17) || (op == 18) || (op == 21));
        if imm_is_value {
            let mut q: Int = 0;
            while q < n {
                let r2: Int = list_get(fn_data.inst_results, q);
                if r2 == imm && list_get(live, q) == 0 {
                    live = ssa_update_list_local(live, q, 1);
                    worklist = list_push(worklist, q);
                    wl_len = wl_len + 1;
                }
                q = q + 1;
            }
        }
        wl_pos = wl_pos + 1;
    }
    // Step 3: emit only live instructions.
    let mut new_ops: List[Int] = list_new();
    let mut new_res: List[Int] = list_new();
    let mut new_imms: List[Int] = list_new();
    let mut new_lhss: List[Int] = list_new();
    let mut new_bids: List[Int] = list_new();
    let mut emit_i: Int = 0;
    while emit_i < n {
        if list_get(live, emit_i) == 1 {
            let op2: Int = list_get(fn_data.inst_opcodes, emit_i);
            let r3: Int = list_get(fn_data.inst_results, emit_i);
            let imm2: Int = list_get(fn_data.inst_imm_vals, emit_i);
            let lhs2: Int = list_get(fn_data.inst_lhs_vals, emit_i);
            let bid2: Int = list_get(fn_data.inst_block_ids, emit_i);
            new_ops = list_push(new_ops, op2);
            new_res = list_push(new_res, r3);
            new_imms = list_push(new_imms, imm2);
            new_lhss = list_push(new_lhss, lhs2);
            new_bids = list_push(new_bids, bid2);
        }
        emit_i = emit_i + 1;
    }
    return SsaFunction {
        name: fn_data.name,
        return_type: fn_data.return_type,
        block_count: fn_data.block_count,
        block_names: fn_data.block_names,
        inst_opcodes: new_ops,
        inst_results: new_res,
        inst_imm_vals: new_imms,
        inst_lhs_vals: new_lhss,
        inst_block_ids: new_bids
    };
}

pub fn ssa_opt_run_o3(fn_data: SsaFunction) -> SsaFunction {
    let f1: SsaFunction = ssa_opt_const_fold(fn_data);
    let f2: SsaFunction = ssa_opt_cse(f1);
    let f3: SsaFunction = ssa_opt_gvn(f2);
    let f_inline: SsaFunction = ssa_opt_inline(f3);
    let f4: SsaFunction = ssa_opt_tail_call_elim(f_inline);
    let f5: SsaFunction = ssa_opt_dce(f4);
    let f6: SsaFunction = ssa_opt_run_licm(f5);
    let f7: SsaFunction = ssa_opt_run_strength_reduction(f6);
    let f8: SsaFunction = ssa_opt_run_loop_unroll(f7, 2);
    return f8;
}

