// # LLVM builtin and user-call dispatch
//
// Logline: list_new, list_len, str ops, env_get, path_exists, sys_exec, process_exit, user calls.
//
// Setup: Args are packed expr results. Aggregates use sret/byval. No emit/c import.
//
// Beats:
//   1. list_new honors __e__ expect slist vs ilist.
//   2. sys_exec packs OoStr argv. env_get returns ress.
//   3. User calls read kinds>ret sigs.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_call.oo";
import "ll_ctor.oo";
import "ll_struct_list.oo";
import "ll_builtin_host.oo";

pub fn ll_arg(args: List[String], i: Int) -> String {
    return list_get(args, i);
}

pub fn ll_list_new(expect: String, ssa0: Int) -> String {
    let mut k: String = "slist";
    if expect == "ilist" { k = "ilist"; }
    let a: String = ll_tmpa(ssa0 + 1);
    println("  " + a + " = alloca " + ll_ir_alloc(k) + ", align 8");
    if k == "ilist" {
        println("  call void @oo_ilist_new(ptr sret(%OoIList) align 8 " + a + ")");
    } else {
        println("  call void @oo_slist_new(ptr sret(%OoSList) align 8 " + a + ")");
    }
    return ll_pack(0, ssa0 + 1, k, a);
}

pub fn ll_builtin(name: String, args: List[String], ssa0: Int, expect: String) -> String {
    if name == "list_new" && ll_is_olist(expect) {
        return ll_olist_new(expect, ssa0);
    }
    if name == "list_new" {
        return ll_list_new(expect, ssa0);
    }
    let na: Int = list_len(args);
    if name == "list_len" || name == "list_get" || name == "list_push" {
        let ob: String = ll_olist_builtin(name, args, ssa0, expect);
        if ob != "" { return ob; }
    }
    if name == "list_len" && na >= 1 {
        let a0: String = ll_ensure_ptr(ll_arg(args, 0), ssa0);
        let k: String = ll_pk(a0);
        let s: Int = ll_pssa(a0) + 1;
        if k == "ilist" {
            println("  " + ll_ssa(s) + " = call i64 @oo_ilist_len(ptr byval(%OoIList) align 8 " + ll_pptr(a0) + ")");
        } else {
            println("  " + ll_ssa(s) + " = call i64 @oo_slist_len(ptr byval(%OoSList) align 8 " + ll_pptr(a0) + ")");
        }
        return ll_pack(0, s, "i64", "");
    }
    if name == "list_get" && na >= 2 {
        let a0: String = ll_ensure_ptr(ll_arg(args, 0), ssa0);
        let ix: String = ll_i64arg(args, 1, ll_pssa(a0));
        let s: Int = ll_hw(ll_pssa(a0), ll_pssa(ix)) + 1;
        if ll_pk(a0) == "ilist" {
            println("  " + ll_ssa(s) + " = call i64 @oo_ilist_get(ptr byval(%OoIList) align 8 " + ll_pptr(a0) + ", i64 " + ll_ssa(ll_pssa(ix)) + ")");
            return ll_pack(0, s, "i64", "");
        }
        println("  " + ll_ssa(s) + " = call { ptr, i64 } @oo_slist_get(ptr byval(%OoSList) align 8 " + ll_pptr(a0) + ", i64 " + ll_ssa(ll_pssa(ix)) + ")");
        return ll_pack(0, s, "str", "");
    }
    if name == "list_push" && na >= 2 {
        let a0: String = ll_ensure_ptr(ll_arg(args, 0), ssa0);
        let a1r: String = ll_arg(args, 1);
        let as_i: Bool = ll_pk(a0) == "ilist" || ll_is_int(ll_pk(a1r));
        let s0: Int = ll_pssa(a0);
        let out: String = ll_tmpa(s0 + 1);
        let mut s: Int = s0 + 1;
        if as_i {
            let pv: String = ll_i64arg(args, 1, s);
            s = ll_hw(s, ll_pssa(pv)) + 1;
            println("  " + out + " = alloca %OoIList, align 8");
            println("  call void @oo_ilist_push(ptr sret(%OoIList) align 8 " + out + ", ptr byval(%OoIList) align 8 " + ll_pptr(a0) + ", i64 " + ll_ssa(ll_pssa(pv)) + ")");
            return ll_pack(0, s, "ilist", out);
        }
        let a1: String = ll_as_val(a1r, s);
        s = ll_pssa(a1);
        println("  " + out + " = alloca %OoSList, align 8");
        println("  call void @oo_slist_push(ptr sret(%OoSList) align 8 " + out + ", ptr byval(%OoSList) align 8 " + ll_pptr(a0) + ", { ptr, i64 } " + ll_ssa(s) + ")");
        return ll_pack(0, s, "slist", out);
    }
    if name == "list_slice" && na >= 3 {
        let a0: String = ll_ensure_ptr(ll_arg(args, 0), ssa0);
        let c1: String = ll_i64arg(args, 1, ll_pssa(a0));
        let c2: String = ll_i64arg(args, 2, ll_pssa(c1));
        let s: Int = ll_hw(ll_hw(ll_pssa(a0), ll_pssa(c1)), ll_pssa(c2)) + 1;
        let out: String = ll_tmpa(s);
        println("  " + out + " = alloca " + ll_ir_alloc(ll_pk(a0)) + ", align 8");
        let a: String = ll_ssa(ll_pssa(c1));
        let b: String = ll_ssa(ll_pssa(c2));
        if ll_pk(a0) == "ilist" {
            println("  call void @oo_ilist_slice(ptr sret(%OoIList) align 8 " + out + ", ptr byval(%OoIList) align 8 " + ll_pptr(a0) + ", i64 " + a + ", i64 " + b + ")");
            return ll_pack(0, s, "ilist", out);
        }
        println("  call void @oo_slist_slice(ptr sret(%OoSList) align 8 " + out + ", ptr byval(%OoSList) align 8 " + ll_pptr(a0) + ", i64 " + a + ", i64 " + b + ")");
        return ll_pack(0, s, "slist", out);
    }
    if (name == "chars_len" || name == "bytes_len") && na >= 1 {
        let mut callee: String = "oo_chars_len";
        if name == "bytes_len" { callee = "oo_bytes_len"; }
        let a0: String = ll_as_val(ll_arg(args, 0), ssa0);
        let s: Int = ll_pssa(a0) + 1;
        println("  " + ll_ssa(s) + " = call i64 @" + callee + "({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ")");
        return ll_pack(0, s, "i64", "");
    }
    if name == "char_at" && na >= 2 {
        let a0: String = ll_as_val(ll_arg(args, 0), ssa0);
        let cx: String = ll_i64arg(args, 1, ll_pssa(a0));
        let s: Int = ll_hw(ll_pssa(a0), ll_pssa(cx)) + 1;
        println("  " + ll_ssa(s) + " = call { ptr, i64 } @oo_char_at({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ", i64 " + ll_ssa(ll_pssa(cx)) + ")");
        return ll_pack(0, s, "str", "");
    }
    if (name == "str_starts_with" || name == "str_ends_with") && na >= 2 {
        let mut callee: String = "oo_str_starts_with";
        if name == "str_ends_with" { callee = "oo_str_ends_with"; }
        let a0: String = ll_as_val(ll_arg(args, 0), ssa0);
        let a1: String = ll_as_val(ll_arg(args, 1), ll_pssa(a0));
        let s: Int = ll_pssa(a1) + 1;
        println("  " + ll_ssa(s) + " = call i32 @" + callee + "({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")");
        let s2: Int = s + 1;
        println("  " + ll_ssa(s2) + " = icmp ne i32 " + ll_ssa(s) + ", 0");
        return ll_pack(0, s2, "i1", "");
    }
    if name == "str_slice" && na >= 3 {
        let a0: String = ll_as_val(ll_arg(args, 0), ssa0);
        let d1: String = ll_i64arg(args, 1, ll_pssa(a0));
        let d2: String = ll_i64arg(args, 2, ll_pssa(d1));
        let s: Int = ll_hw(ll_hw(ll_pssa(a0), ll_pssa(d1)), ll_pssa(d2)) + 1;
        println("  " + ll_ssa(s) + " = call { ptr, i64 } @oo_str_slice({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ", i64 " + ll_ssa(ll_pssa(d1)) + ", i64 " + ll_ssa(ll_pssa(d2)) + ")");
        return ll_pack(0, s, "str", "");
    }
    if name == "str_index_of" && na >= 2 {
        let a0: String = ll_as_val(ll_arg(args, 0), ssa0);
        let a1: String = ll_as_val(ll_arg(args, 1), ll_pssa(a0));
        let s: Int = ll_pssa(a1) + 1;
        println("  " + ll_ssa(s) + " = call i64 @oo_str_index_of({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")");
        return ll_pack(0, s, "i64", "");
    }
    if name == "path_exists" && na >= 2 {
        let a1: String = ll_as_val(ll_arg(args, 1), ssa0);
        let s: Int = ll_pssa(a1) + 1;
        println("  " + ll_ssa(s) + " = call i32 @oo_path_exists(i64 " + ll_ssa(ll_pssa(ll_arg(args, 0))) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")");
        let s2: Int = s + 1;
        println("  " + ll_ssa(s2) + " = icmp ne i32 " + ll_ssa(s) + ", 0");
        return ll_pack(0, s2, "i1", "");
    }
    if name == "file_size" && na >= 2 {
        let a1: String = ll_as_val(ll_arg(args, 1), ssa0);
        let s: Int = ll_pssa(a1) + 1;
        println("  " + ll_ssa(s) + " = call i64 @oo_file_size(i64 " + ll_ssa(ll_pssa(ll_arg(args, 0))) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")");
        return ll_pack(0, s, "i64", "");
    }
    if name == "process_exit" && na >= 1 {
        let ex: String = ll_i64arg(args, 0, ssa0);
        println("  call void @oo_process_exit(i64 " + ll_ssa(ll_pssa(ex)) + ")");
        println("  unreachable");
        return ll_pack(0, ll_hw(ssa0, ll_pssa(ex)), "noret", "");
    }
    if name == "env_get" && na >= 2 {
        let a1: String = ll_as_val(ll_arg(args, 1), ssa0);
        let a: String = ll_tmpa(ll_pssa(a1) + 1);
        let s: Int = ll_pssa(a1) + 1;
        println("  " + a + " = alloca %OoResS, align 8");
        println("  call void @oo_env_get(ptr sret(%OoResS) align 8 " + a + ", i64 " + ll_ssa(ll_pssa(ll_arg(args, 0))) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")");
        return ll_pack(0, s, "ress", a);
    }
    if name == "sys_exec" && na >= 2 {
        return ll_sys_exec(args, ssa0);
    }
    let host: String = ll_builtin_host(name, args, ssa0, expect);
    if host != "" { return host; }
    if name == "Some" || name == "None" || name == "Ok" || name == "Err" {
        let mut dummy: String = ll_pack(0, ssa0, "i64", "");
        if na >= 1 { dummy = ll_arg(args, 0); }
        return ll_ctor(name, dummy, ssa0, expect);
    }
    return "";
}

fn ll_sys_exec(args: List[String], ssa0: Int) -> String {
    let na: Int = list_len(args);
    let argc: Int = na - 1;
    let mut s: Int = ssa0;
    let av: String = ll_tmpa(s + 1);
    s = s + 1;
    println("  " + av + " = alloca [" + argc.to_string() + " x %OoStr], align 8");
    let mut i: Int = 1;
    while i < na {
        let a: String = ll_ensure_ptr(ll_arg(args, i), s);
        s = ll_pssa(a);
        let sl: Int = s + 1;
        println("  " + ll_ssa(sl) + " = load { ptr, i64 }, ptr " + ll_pptr(a));
        let gp: Int = sl + 1;
        println("  " + ll_ssa(gp) + " = getelementptr [" + argc.to_string() + " x %OoStr], ptr " + av + ", i64 0, i64 " + (i - 1).to_string());
        println("  store { ptr, i64 } " + ll_ssa(sl) + ", ptr " + ll_ssa(gp));
        s = gp;
        i = i + 1;
    }
    let res: String = ll_tmpa(s + 1);
    s = s + 1;
    println("  " + res + " = alloca %OoResS, align 8");
    let base: Int = s + 1;
    println("  " + ll_ssa(base) + " = getelementptr [" + argc.to_string() + " x %OoStr], ptr " + av + ", i64 0, i64 0");
    println("  call void @oo_sys_exec(ptr sret(%OoResS) align 8 " + res + ", i64 " + ll_ssa(ll_pssa(ll_arg(args, 0))) + ", i32 " + argc.to_string() + ", ptr " + ll_ssa(base) + ")");
    return ll_pack(0, base, "ress", res);
}

pub fn ll_print_val(kind: String, ssa: Int, ptr: String, ssa0: Int) -> Int {
    if kind == "f64" {
        return ll_print_float(ssa, ptr, ssa0);
    }
    if kind == "i1" {
        let n2: Int = ssa0 + 1;
        println("  " + ll_ssa(n2) + " = zext i1 " + ll_ssa(ssa) + " to i64");
        return ll_print_val("i64", n2, "", n2);
    }
    if kind == "str" {
        let mut s: Int = ssa;
        if ptr != "" {
            s = ssa0 + 1;
            println("  " + ll_ssa(s) + " = load { ptr, i64 }, ptr " + ptr);
        }
        let p: Int = s + 1;
        let l: Int = s + 2;
        println("  " + ll_ssa(p) + " = extractvalue { ptr, i64 } " + ll_ssa(s) + ", 0");
        println("  " + ll_ssa(l) + " = extractvalue { ptr, i64 } " + ll_ssa(s) + ", 1");
        println("  call void @oo_print_str(ptr " + ll_ssa(p) + ", i64 " + ll_ssa(l) + ")");
        println("  call void @oo_println()");
        return l;
    }
    if kind == "i64" {
        let n2: Int = ssa0 + 1;
        println("  " + ll_ssa(n2) + " = call { ptr, i64 } @oo_int_to_str(i64 " + ll_ssa(ssa) + ")");
        return ll_print_val("str", n2, "", n2);
    }
    if ll_is_int(kind) {
        let e: String = ll_int_convert(ll_pack(0, ssa, kind, ptr), ssa0, "i64");
        return ll_print_val("i64", ll_pssa(e), "", ll_pssa(e));
    }
    println("ERR\tllvm\tprint kind " + kind);
    process_exit(1);
    return ssa0;
}


