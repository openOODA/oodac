// # LLVM builtin and user-call dispatch
//
// Logline: list_new, list_len, str ops, env_get, path_exists, sys_exec, process_exit, user calls.
//
// Setup: Args are packed expr results. Aggregates use sret/byval. No emit/c import.
//
// Beats:
//   1. list_new honors __e__ expect slist vs ilist.
//   2. sys_exec packs OoStr argv. env_get returns ress.
//   3. User calls read kinds>ret sigs.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_call.oo";
import "ll_ctor.oo";
import "ll_struct_list.oo";
import "ll_builtin_host.oo";
import "ll_print.oo";
import "ll_slot.oo";
import "ll_vec.oo";
import "ll_ir.oo";

pub fn ll_arg(args: List[String], i: Int) -> String {
    return list_get(args, i);
}

pub fn ll_guess_list_kind(toks: List[String], pos: Int, n: Int) -> String {
    let mut i: Int = pos;
    let mut saw_i: Bool = false;
    let mut saw_s: Bool = false;
    while i + 3 < n {
        if ll_k(toks, i) == "IDENT" && ll_t(toks, i) == "list_push" {
            if ll_k(toks, i + 1) == "LPAREN" {
                let mut d: Int = 1;
                let mut j: Int = i + 2;
                let mut commas: Int = 0;
                while j < n && d > 0 {
                    let kk: String = ll_k(toks, j);
                    if kk == "LPAREN" { d = d + 1; }
                    if kk == "RPAREN" { d = d - 1; }
                    if kk == "COMMA" && d == 1 { commas = commas + 1; }
                    if commas == 1 && d == 1 && kk != "COMMA" {
                        if kk == "INT" { saw_i = true; }
                        if kk == "STRING" { saw_s = true; }
                        commas = 2;
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    if saw_i && !saw_s { return "ilist"; }
    return "slist";
}

pub fn ll_list_new(expect: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let mut k: String = "slist";
    if expect == "ilist" { k = "ilist"; }
    let a: String = ll_tmpa(ssa0 + 1);
    ll_slot_ty(a, ll_ir_alloc(k), ir);
    if k == "ilist" {
        ll_ir_inst(ir, "call", "void", "", "@oo_ilist_new(ptr sret(%OoIList) align 8 " + a + ")", 1, 1);
    } else {
        ll_ir_inst(ir, "call", "void", "", "@oo_slist_new(ptr sret(%OoSList) align 8 " + a + ")", 1, 1);
    }
    return ll_pack(0, ssa0 + 1, k, a);
}

pub fn ll_builtin(name: String, args: List[String], ssa0: Int, expect: String, ir: &mut IrBuf) -> String {
    let vx: String = ll_vec_builtin(name, args, ssa0, ir);
    if vx != "" { return vx; }
    if name == "list_new" && ll_is_olist(expect) {
        return ll_olist_new(expect, ssa0, ir);
    }
    if name == "list_new" {
        return ll_list_new(expect, ssa0, ir);
    }
    let na: Int = list_len(args);
    if name == "list_len" || name == "list_get" || name == "list_push" {
        let ob: String = ll_olist_builtin(name, args, ssa0, expect, ir);
        if ob != "" { return ob; }
    }
    if name == "list_len" && na >= 1 {
        let a0: String = ll_ensure_ptr(ll_arg(args, 0), ssa0, ir);
        let k: String = ll_pk(a0);
        let s: Int = ll_pssa(a0) + 1;
        if k == "ilist" {
            ll_ir_inst(ir, "call", "i64", ll_ssa(s), "@oo_ilist_len(ptr byval(%OoIList) align 8 " + ll_pptr(a0) + ")", 1, 1);
        } else {
            ll_ir_inst(ir, "call", "i64", ll_ssa(s), "@oo_slist_len(ptr byval(%OoSList) align 8 " + ll_pptr(a0) + ")", 1, 1);
        }
        return ll_pack(0, s, "i64", "");
    }
    if name == "list_get" && na >= 2 {
        let a0: String = ll_ensure_ptr(ll_arg(args, 0), ssa0, ir);
        let ix: String = ll_i64arg(args, 1, ll_pssa(a0), ir);
        let s: Int = ll_hw(ll_pssa(a0), ll_pssa(ix)) + 1;
        if ll_pk(a0) == "ilist" {
            ll_ir_inst(ir, "call", "i64", ll_ssa(s), "@oo_ilist_get(ptr byval(%OoIList) align 8 " + ll_pptr(a0) + ", i64 " + ll_opnd(ix) + ")", 1, 1);
            return ll_pack(0, s, "i64", "");
        }
        ll_ir_inst(ir, "call", "{ ptr, i64 }", ll_ssa(s), "@oo_slist_get(ptr byval(%OoSList) align 8 " + ll_pptr(a0) + ", i64 " + ll_opnd(ix) + ")", 1, 1);
        return ll_pack(0, s, "str", "");
    }
    if name == "list_push" && na >= 2 {
        let a0: String = ll_ensure_ptr(ll_arg(args, 0), ssa0, ir);
        let a1r: String = ll_arg(args, 1);
        let as_i: Bool = ll_pk(a0) == "ilist" || ll_is_int(ll_pk(a1r));
        let s0: Int = ll_pssa(a0);
        let out: String = ll_tmpa(s0 + 1);
        let mut s: Int = s0 + 1;
        if as_i {
            let pv: String = ll_i64arg(args, 1, s, ir);
            s = ll_hw(s, ll_pssa(pv)) + 1;
            ll_slot_ty(out, "%OoIList", ir);
            ll_ir_inst(ir, "call", "void", "", "@oo_ilist_push(ptr sret(%OoIList) align 8 " + out + ", ptr byval(%OoIList) align 8 " + ll_pptr(a0) + ", i64 " + ll_opnd(pv) + ")", 1, 1);
            return ll_pack(0, s, "ilist", out);
        }
        let a1: String = ll_as_val(a1r, s, ir);
        s = ll_pssa(a1);
        ll_slot_ty(out, "%OoSList", ir);
        ll_ir_inst(ir, "call", "void", "", "@oo_slist_push(ptr sret(%OoSList) align 8 " + out + ", ptr byval(%OoSList) align 8 " + ll_pptr(a0) + ", { ptr, i64 } " + ll_ssa(s) + ")", 1, 1);
        return ll_pack(0, s, "slist", out);
    }
    if name == "list_slice" && na >= 3 {
        let a0: String = ll_ensure_ptr(ll_arg(args, 0), ssa0, ir);
        let c1: String = ll_i64arg(args, 1, ll_pssa(a0), ir);
        let c2: String = ll_i64arg(args, 2, ll_pssa(c1), ir);
        let s: Int = ll_hw(ll_hw(ll_pssa(a0), ll_pssa(c1)), ll_pssa(c2)) + 1;
        let out: String = ll_tmpa(s);
        ll_slot_ty(out, if ll_pk(a0) == "ilist" { "%OoIList" } else { "%OoSList" }, ir);
        let a: String = ll_opnd(c1);
        let b: String = ll_opnd(c2);
        if ll_pk(a0) == "ilist" {
            ll_ir_inst(ir, "call", "void", "", "@oo_ilist_slice(ptr sret(%OoIList) align 8 " + out + ", ptr byval(%OoIList) align 8 " + ll_pptr(a0) + ", i64 " + a + ", i64 " + b + ")", 1, 1);
            return ll_pack(0, s, "ilist", out);
        }
        ll_ir_inst(ir, "call", "void", "", "@oo_slist_slice(ptr sret(%OoSList) align 8 " + out + ", ptr byval(%OoSList) align 8 " + ll_pptr(a0) + ", i64 " + a + ", i64 " + b + ")", 1, 1);
        return ll_pack(0, s, "slist", out);
    }
    if (name == "chars_len" || name == "oo_chars_len" || name == "bytes_len" || name == "oo_bytes_len") && na >= 1 {
        let mut callee: String = "oo_chars_len";
        if name == "bytes_len" || name == "oo_bytes_len" { callee = "oo_bytes_len"; }
        let a0: String = ll_as_val(ll_arg(args, 0), ssa0, ir);
        let s: Int = ll_pssa(a0) + 1;
        ll_ir_inst(ir, "call", "i64", ll_ssa(s), "@" + callee + "({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ")", 1, 1);
        return ll_pack(0, s, "i64", "");
    }
    if (name == "char_at" || name == "oo_char_at") && na >= 2 {
        let a0: String = ll_as_val(ll_arg(args, 0), ssa0, ir);
        let cx: String = ll_i64arg(args, 1, ll_pssa(a0), ir);
        let s: Int = ll_hw(ll_pssa(a0), ll_pssa(cx)) + 1;
        ll_ir_inst(ir, "call", "{ ptr, i64 }", ll_ssa(s), "@oo_char_at({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ", i64 " + ll_opnd(cx) + ")", 1, 1);
        return ll_pack(0, s, "str", "");
    }
    if (name == "str_starts_with" || name == "oo_str_starts_with" || name == "str_ends_with" || name == "oo_str_ends_with") && na >= 2 {
        let mut callee: String = "oo_str_starts_with";
        if name == "str_ends_with" || name == "oo_str_ends_with" { callee = "oo_str_ends_with"; }
        let a0: String = ll_as_val(ll_arg(args, 0), ssa0, ir);
        let a1: String = ll_as_val(ll_arg(args, 1), ll_pssa(a0), ir);
        let s: Int = ll_pssa(a1) + 1;
        ll_ir_inst(ir, "call", "i32", ll_ssa(s), "@" + callee + "({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")", 1, 1);
        let s2: Int = s + 1;
        ll_ir_inst(ir, "icmp ne", "i32", ll_ssa(s2), ll_ssa(s) + ", 0", 1, 1);
        return ll_pack(0, s2, "i1", "");
    }
    if (name == "str_slice" || name == "oo_str_slice") && na >= 3 {
        let a0: String = ll_as_val(ll_arg(args, 0), ssa0, ir);
        let d1: String = ll_i64arg(args, 1, ll_pssa(a0), ir);
        let d2: String = ll_i64arg(args, 2, ll_pssa(d1), ir);
        let s: Int = ll_hw(ll_hw(ll_pssa(a0), ll_pssa(d1)), ll_pssa(d2)) + 1;
        ll_ir_inst(ir, "call", "{ ptr, i64 }", ll_ssa(s), "@oo_str_slice({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ", i64 " + ll_opnd(d1) + ", i64 " + ll_opnd(d2) + ")", 1, 1);
        return ll_pack(0, s, "str", "");
    }
    if (name == "str_index_of" || name == "oo_str_index_of") && na >= 2 {
        let a0: String = ll_as_val(ll_arg(args, 0), ssa0, ir);
        let a1: String = ll_as_val(ll_arg(args, 1), ll_pssa(a0), ir);
        let s: Int = ll_pssa(a1) + 1;
        ll_ir_inst(ir, "call", "i64", ll_ssa(s), "@oo_str_index_of({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")", 1, 1);
        return ll_pack(0, s, "i64", "");
    }
    if (name == "path_exists" || name == "oo_path_exists") && na >= 2 {
        let a1: String = ll_as_val(ll_arg(args, 1), ssa0, ir);
        let s: Int = ll_pssa(a1) + 1;
        ll_ir_inst(ir, "call", "i32", ll_ssa(s), "@oo_path_exists(i64 " + ll_ssa(ll_pssa(ll_arg(args, 0))) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")", 1, 1);
        let s2: Int = s + 1;
        ll_ir_inst(ir, "icmp ne", "i32", ll_ssa(s2), ll_ssa(s) + ", 0", 1, 1);
        return ll_pack(0, s2, "i1", "");
    }
    if (name == "file_size" || name == "oo_file_size") && na >= 2 {
        let a1: String = ll_as_val(ll_arg(args, 1), ssa0, ir);
        let s: Int = ll_pssa(a1) + 1;
        ll_ir_inst(ir, "call", "i64", ll_ssa(s), "@oo_file_size(i64 " + ll_ssa(ll_pssa(ll_arg(args, 0))) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")", 1, 1);
        return ll_pack(0, s, "i64", "");
    }
    if name == "process_exit" && na >= 1 {
        let ex: String = ll_i64arg(args, 0, ssa0, ir);
        ll_ir_inst(ir, "call", "void", "", "@oo_process_exit(i64 " + ll_opnd(ex) + ")", 1, 1);
        ll_ir_inst(ir, "unreachable", "", "", "", 1, 1);
        return ll_pack(0, ll_hw(ssa0, ll_pssa(ex)), "noret", "");
    }
    if (name == "env_get" || name == "oo_env_get") && na >= 2 {
        let a1: String = ll_as_val(ll_arg(args, 1), ssa0, ir);
        let a: String = ll_tmpa(ll_pssa(a1) + 1);
        let s: Int = ll_pssa(a1) + 1;
        ll_slot_ty(a, "%OoResS", ir);
        ll_ir_inst(ir, "call", "void", "", "@oo_env_get(ptr sret(%OoResS) align 8 " + a + ", i64 " + ll_ssa(ll_pssa(ll_arg(args, 0))) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")", 1, 1);
        return ll_pack(0, s, "ress", a);
    }
    if name == "sys_exec" && na >= 2 {
        return ll_sys_exec(args, ssa0, ir);
    }
    let host: String = ll_builtin_host(name, args, ssa0, expect, ir);
    if host != "" { return host; }
    if name == "Some" || name == "None" || name == "Ok" || name == "Err" {
        let mut dummy: String = ll_pack(0, ssa0, "i64", "");
        if na >= 1 { dummy = ll_arg(args, 0); }
        return ll_ctor(name, dummy, ssa0, expect, ir);
    }
    return "";
}

fn ll_sys_exec(args: List[String], ssa0: Int, ir: &mut IrBuf) -> String {
    let na: Int = list_len(args);
    let argc: Int = na - 1;
    let mut s: Int = ssa0;
    let av: String = ll_tmpa(s + 1);
    s = s + 1;
    ll_slot_ty(av, "[" + argc.to_string() + " x %OoStr]", ir);
    let mut i: Int = 1;
    while i < na {
        let a: String = ll_ensure_ptr(ll_arg(args, i), s, ir);
        s = ll_pssa(a);
        let sl: Int = s + 1;
        ll_ir_inst(ir, "load", "{ ptr, i64 }", ll_ssa(sl), "ptr " + ll_pptr(a) + ", align 8", 1, 1);
        let gp: Int = sl + 1;
        ll_ir_inst(ir, "getelementptr inbounds", "[" + argc.to_string() + " x %OoStr]", ll_ssa(gp), "ptr " + av + ", i64 0, i64 " + (i - 1).to_string(), 1, 1);
        ll_ir_inst(ir, "store", "{ ptr, i64 }", "", ll_ssa(sl) + ", ptr " + ll_ssa(gp) + ", align 8", 1, 1);
        s = gp;
        i = i + 1;
    }
    let res: String = ll_tmpa(s + 1);
    s = s + 1;
    ll_slot_ty(res, "%OoResS", ir);
    let base: Int = s + 1;
    ll_ir_inst(ir, "getelementptr inbounds", "[" + argc.to_string() + " x %OoStr]", ll_ssa(base), "ptr " + av + ", i64 0, i64 0", 1, 1);
    ll_ir_inst(ir, "call", "void", "", "@oo_sys_exec(ptr sret(%OoResS) align 8 " + res + ", i64 " + ll_ssa(ll_pssa(ll_arg(args, 0))) + ", i32 " + argc.to_string() + ", ptr " + ll_ssa(base) + ")", 1, 1);
    return ll_pack(0, base, "ress", res);
}
