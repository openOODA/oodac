// # LLVM stream from a typed token artifact
//
// Logline: Print runtime header then emit reachable fns from main. Skip type/import rows.
//
// Setup: Product path is artifact toks. No second lex. No emit/c import.
//
// Beats:
//   1. ll_rt_header emits types and STRING globals.
//   2. Collect fn sigs. Reachability from main so concat std does not lower dead fns.
//   3. Walk KW_FN / KW_PUB fn items that are reachable.

import "ll_tok.oo";
import "ll_rt.oo";
import "ll_fn.oo";
import "types/token_search.oo";
import "types/types_core.oo";

fn ll_collect_sigs(toks: List[String]) -> String {
    let n: Int = list_len(toks);
    let mut pos: Int = 0;
    let mut env: String = "";
    while pos < n {
        let k: String = ll_k(toks, pos);
        if k == "EOF" { return env; }
        if k == "KW_PUB" || k == "KW_FN" {
            let sig: String = ll_parse_sig(toks, pos, n);
            if sig != "" {
                let eq: Int = str_index_of(sig, "=");
                let nm: String = str_slice(sig, 0, eq);
                let rest: String = str_slice(sig, eq + 1, chars_len(sig));
                env = type_env_put(env, "__fn__" + nm, rest);
            }
            pos = ll_skip_fn(toks, pos, n);
        } else {
            pos = pos + 1;
        }
    }
    return env;
}

fn ll_in_set(set: String, name: String) -> Bool {
    return str_index_of(set, "\t" + name + "\t") >= 0;
}

fn ll_reachable(toks: List[String], sigs: String) -> String {
    let n: Int = list_len(toks);
    let mut set: String = "\tmain\t";
    let mut added: Bool = true;
    while added {
        added = false;
        let mut pos: Int = 0;
        while pos < n {
            if ll_k(toks, pos) == "KW_PUB" || ll_k(toks, pos) == "KW_FN" {
                let nm: String = ll_fn_name_at(toks, pos, n);
                let end: Int = ll_skip_fn(toks, pos, n);
                if ll_in_set(set, nm) {
                    let mut i: Int = pos;
                    while i < end {
                        if ll_k(toks, i) == "IDENT" && i + 1 < end && ll_k(toks, i + 1) == "LPAREN" {
                            let cal: String = ll_t(toks, i);
                            if i > 0 && ll_k(toks, i - 1) == "DOT" {
                                i = i + 1;
                                continue;
                            }
                            if type_env_get(sigs, "__fn__" + cal) != "" {
                                if !ll_in_set(set, cal) {
                                    set = set + cal + "\t";
                                    added = true;
                                }
                            }
                        }
                        i = i + 1;
                    }
                }
                pos = end;
            } else {
                pos = pos + 1;
            }
        }
    }
    return set;
}

fn ll_emit_fn_strings(toks: List[String], pos: Int, n: Int) {
    let end: Int = ll_skip_fn(toks, pos, n);
    let mut i: Int = pos;
    while i < end {
        if ll_k(toks, i) == "STRING" {
            let tx: String = ll_t(toks, i);
            let ln: Int = chars_len(tx) + 1;
            println("@.s" + i.to_string() + " = private unnamed_addr constant [" + ln.to_string() + " x i8] c\"" + ll_c_esc(tx) + "\\00\"");
        }
        i = i + 1;
    }
}

pub fn ll_emit_stream_toks(toks: List[String]) {
    if list_len(toks) < 1 {
        println("ERR\tllvm\tempty artifact");
        process_exit(1);
    }
    ll_rt_header(toks);
    let sigs: String = ll_collect_sigs(toks);
    let keep: String = ll_reachable(toks, sigs);
    let n: Int = list_len(toks);
    let mut pos: Int = 0;
    while pos < n {
        let k: String = ll_k(toks, pos);
        if k == "EOF" {
            pos = n;
        } else if k == "SRC_PATH" || k == "LINEFILE" {
            pos = pos + 1;
        } else if k == "KW_IMPORT" || k == "KW_TYPE" {
            pos = skip_until_semi(toks, pos);
        } else if k == "KW_PUB" || k == "KW_FN" {
            let nm: String = ll_fn_name_at(toks, pos, n);
            if ll_in_set(keep, nm) {
                ll_emit_fn_strings(toks, pos, n);
                pos = ll_emit_fn(toks, pos, n, sigs);
            } else {
                pos = ll_skip_fn(toks, pos, n);
            }
        } else if k == "IDENT" && (ll_t(toks, pos) == "trait" || ll_t(toks, pos) == "impl") {
            pos = skip_trait_or_impl(toks, pos);
        } else {
            pos = pos + 1;
        }
    }
}
