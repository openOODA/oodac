// # LLVM stream from a typed token artifact
//
// Logline: Print runtime header then emit fns. Skip type/import rows.
//
// Setup: Product path is artifact toks. No second lex. No emit/c import.
//
// Beats:
//   1. ll_rt_header emits types and STRING globals.
//   2. Programs with main keep reachable fns; one-TU libraries keep every fn.
//   3. Walk keep-set fns; duplicate names first-wins (concat unique_fns).

import "ll_tok.oo";
import "ll_rt.oo";
import "ll_fn.oo";
import "ll_ir.oo";
import "ll_ir_flush.oo";
import "ll_int.oo";
import "ll_user_call.oo";
import "ll_struct.oo";
import "ll_expr.oo";
import "ll_ty.oo";
import "ll_verify.oo";
import "ll_decl.oo";
import "ll_struct_imp.oo";
import "ll_reach.oo";
import "types/token_search.oo";
import "types/types_core.oo";

fn skip_balanced(toks: List[String], pos0: Int) -> Int {
    let n: Int = list_len(toks);
    let mut pos: Int = pos0 + 1;
    let mut depth: Int = 1;
    while pos < n {
        if depth == 0 { return pos; }
        let k: String = ll_k(toks, pos);
        if k == "LBRACE" { depth = depth + 1; }
        if k == "RBRACE" { depth = depth - 1; }
        pos = pos + 1;
    }
    return pos;
}

fn skip_until_semi(toks: List[String], pos0: Int) -> Int {
    let n: Int = list_len(toks);
    let mut pos: Int = pos0;
    while pos < n {
        if ll_k(toks, pos) == "SEMI" { return pos + 1; }
        pos = pos + 1;
    }
    return pos;
}


fn ll_emit_fn_strings(toks: List[String], pos: Int, n: Int, ir: &mut IrBuf) {
    let mut end: Int = ll_skip_fn(toks, pos, n);
    if ll_k(toks, pos) == "KW_VERIFY" {
        let mut p: Int = pos + 1;
        if p < n && ll_k(toks, p) == "IDENT" { p = p + 1; }
        if p < n && ll_k(toks, p) == "LBRACE" { end = skip_balanced(toks, p); }
    }
    let mut i: Int = pos;
    while i < end {
        if ll_k(toks, i) == "STRING" {
            let tx: String = ll_t(toks, i);
            let ln: Int = bytes_len(tx) + 1;
            ll_ir_text(ir, "@.s" + i.to_string() + " = private unnamed_addr constant [" + ln.to_string() + " x i8] c\"" + ll_c_esc(tx) + "\\00\"");
        }
        i = i + 1;
    }
}


pub fn ll_emit_stream_toks(toks: List[String]) {
    ll_emit_stream_plus(toks, "");
}

pub fn ll_emit_stream_plus(toks: List[String], extra: String) {
    ll_emit_stream_plus_t(toks, extra, "x86_64-unknown-linux-gnu");
}

pub fn ll_emit_stream_plus_t(toks: List[String], extra: String, triple: String) {
    if list_len(toks) < 1 {
        println("ERR\tllvm\tempty artifact");
        process_exit(1);
    }
    ll_rt_header_triple(toks, triple);
    let mut ir: IrBuf = ll_ir_new();
    let extra_st: String = ll_struct_tab_of(extra);
    let stenv: String = ll_struct_declare(toks, extra_st);
    let local_st: String = ll_st_pick(stenv, ll_local_st_names(toks));
    ll_struct_emit_imports(stenv, local_st, toks, ir);
    ll_struct_emit_types(local_st, toks, ir);
    let stab: String = ll_struct_tab_of(stenv);
    let local_sigs: String = ll_collect_sigs(toks, stab);
    let sigs: String = local_sigs + stenv + extra;
    let local_fns: String = ll_known_fns(local_sigs);
    let mut keep: String = ll_reachable(toks, ll_known_fns(sigs));
    if !ll_in_set(local_fns, "main") { keep = local_fns; }
    let n: Int = list_len(toks);
    let mut want: String = "\t";
    let mut p2: Int = 0;
    while p2 < n {
        let k2: String = ll_k(toks, p2);
        if k2 == "KW_PUB" || k2 == "KW_EXPORT" || k2 == "KW_FN" {
            let nm2: String = ll_fn_name_at(toks, p2, n);
            if ll_in_set(keep, nm2) { want = want + ll_callee_set(toks, p2, n); }
            p2 = ll_skip_fn(toks, p2, n);
        } else { p2 = p2 + 1; }
    }
    ll_emit_import_decls(extra, local_fns, want);
    let mut pos: Int = 0;
    let mut seen_fn: String = "\t";
    let mut ctors: String = "";
    while pos < n {
        let k: String = ll_k(toks, pos);
        if k == "EOF" {
            pos = n;
        } else if k == "SRC_PATH" || k == "LINEFILE" {
            pos = pos + 1;
        } else if k == "KW_IMPORT" || k == "KW_TYPE" {
            pos = skip_until_semi(toks, pos);
        } else if k == "KW_PUB" && pos + 1 < n && ll_k(toks, pos + 1) == "KW_TYPE" {
            pos = skip_until_semi(toks, pos);
        } else if k == "KW_PUB" || k == "KW_EXPORT" || k == "KW_FN" {
            let nm: String = ll_fn_name_at(toks, pos, n);
            if ll_in_set(keep, nm) && !ll_in_set(seen_fn, nm) {
                seen_fn = seen_fn + nm + "\t";
                ll_ir_text(ir, "; FN " + nm);
                ll_emit_fn_strings(toks, pos, n, ir);
                let penv: String = ll_prune_sigs(sigs, stenv, ll_callee_set(toks, pos, n));
                pos = ll_emit_fn(toks, pos, n, penv, stab, ir);
                ll_ir_flush(ir);
                ir = ll_ir_new();
            } else {
                pos = ll_skip_fn(toks, pos, n);
            }
        } else if k == "IDENT" && (ll_t(toks, pos) == "trait" || ll_t(toks, pos) == "impl") {
            while pos < n && ll_k(toks, pos) != "LBRACE" && ll_k(toks, pos) != "EOF" { pos = pos + 1; }
            if pos < n && ll_k(toks, pos) == "LBRACE" { pos = skip_balanced(toks, pos); }
        } else if k == "KW_VERIFY" {
            ll_emit_fn_strings(toks, pos, n, ir);
            let vr: String = ll_emit_verify(toks, pos, n, stab, ir);
            pos = ll_ppos(vr);
            if ll_pk(vr) != "" { ctors = ctors + ll_pk(vr) + "\t"; }
        } else {
            pos = pos + 1;
        }
    }
    ll_emit_ctors(ctors, ir);
    ll_ir_flush(ir);
}
