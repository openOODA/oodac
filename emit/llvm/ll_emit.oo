// # LLVM stream from a typed token artifact
//
// Logline: Print runtime header then emit reachable fns from main. Skip type/import rows.
//
// Setup: Product path is artifact toks. No second lex. No emit/c import.
//
// Beats:
//   1. ll_rt_header emits types and STRING globals.
//   2. Collect fn sigs. Reachability from main so concat std does not lower dead fns.
//   3. Walk KW_FN / KW_PUB fn items that are reachable.

import "ll_tok.oo";
import "ll_rt.oo";
import "ll_fn.oo";
import "ll_int.oo";
import "ll_struct.oo";
import "ll_expr.oo";
import "ll_ty.oo";
import "ll_verify.oo";
import "types/token_search.oo";
import "types/types_core.oo";

fn ll_collect_sigs(toks: List[String], stab: String) -> String {
    let n: Int = list_len(toks);
    let mut pos: Int = 0;
    let mut env: String = "";
    while pos < n {
        let k: String = ll_k(toks, pos);
        if k == "EOF" { return env; }
        if k == "KW_PUB" || k == "KW_EXPORT" || k == "KW_FN" {
            let sig: String = ll_parse_sig(toks, pos, n, stab);
            if sig != "" {
                let eq: Int = str_index_of(sig, "=");
                let nm: String = str_slice(sig, 0, eq);
                let rest: String = str_slice(sig, eq + 1, chars_len(sig));
                env = type_env_put(env, "__fn__" + nm, rest);
            }
            pos = ll_skip_fn(toks, pos, n);
        } else {
            pos = pos + 1;
        }
    }
    return env;
}

fn ll_in_set(set: String, name: String) -> Bool {
    return str_index_of(set, "\t" + name + "\t") >= 0;
}

fn ll_known_fns(sigs: String) -> String {    let n: Int = chars_len(sigs); let mut o: String = "\t"; let mut i: Int = 0;
    while i < n {
        let at: Bool = i == 0 || char_at(sigs, i - 1) == ";";
        if at && i + 6 <= n && str_slice(sigs, i, i + 6) == "__fn__" {
            let mut k: Int = i + 6;
            while k < n && char_at(sigs, k) != "=" { k = k + 1; }
            o = o + str_slice(sigs, i + 6, k) + "\t";
            i = k;
        }
        i = i + 1;
    }
    return o;
}

pub fn ll_store_field_stmt(toks: List[String], p0: Int, n: Int, ssa0: Int, env: String, stab: String) -> String {
    let p: Int = p0;
    let bk: String = type_env_get(env, ll_t(toks, p));
    let fi: String = ll_struct_field(bk, ll_t(toks, p + 2));
    if fi == "" || str_index_of(fi, ":") < 0 {
        println("ERR\tllvm\tunknown field " + ll_t(toks, p + 2));
        process_exit(1);
    }
    let ck: Int = str_index_of(fi, ":");
    let fk: String = str_slice(fi, ck + 1, chars_len(fi));
    let mut bptr: String = ll_var(ll_t(toks, p));
    let bloc: String = type_env_get(env, "__l__" + ll_t(toks, p));
    if bloc != "" { bptr = bloc; }
    let fp: String = ll_struct_field_ptr(bk, bptr, ll_t(toks, p + 2), ssa0);
    let rhs0: String = ll_expr(toks, p + 4, n, ll_pssa(fp), type_env_put(env, "__e__", fk));
    let rhs: String = ll_int_convert(rhs0, ll_pssa(rhs0), fk);
    let mut np: Int = ll_ppos(rhs); let mut ns: Int = ll_pssa(rhs);
    if ll_pptr(rhs) != "" {
        ns = ns + 1;
        println("  " + ll_ssa(ns) + " = load " + ll_ir_val(fk) + ", ptr " + ll_pptr(rhs));
    }
    println("  store " + ll_ir_val(fk) + " " + ll_ssa(ns) + ", ptr " + ll_pptr(fp));
    if np < n && ll_k(toks, np) == "SEMI" { np = np + 1; }
    return ll_pack(np, ns, fk, "");
}

fn ll_reachable(toks: List[String], known: String) -> String {    let n: Int = list_len(toks);
    let mut set: String = "\tmain\t";
    let mut added: Bool = true;
    while added {
        added = false;
        let mut pos: Int = 0;
        while pos < n {
            if ll_k(toks, pos) == "KW_PUB" || ll_k(toks, pos) == "KW_EXPORT" || ll_k(toks, pos) == "KW_FN" {
                let nm: String = ll_fn_name_at(toks, pos, n);
                let end: Int = ll_skip_fn(toks, pos, n);
                if ll_in_set(set, nm) {
                    let mut i: Int = pos;
                    while i < end {
                        if ll_k(toks, i) == "IDENT" && i + 1 < end && ll_k(toks, i + 1) == "LPAREN" {
                            let cal: String = ll_t(toks, i);
                            if i > 0 && ll_k(toks, i - 1) == "DOT" {
                                i = i + 1;
                                continue;
                            }
                            if ll_in_set(known, cal) {
                                if !ll_in_set(set, cal) {
                                    set = set + cal + "\t";
                                    added = true;
                                }
                            }
                        }
                        i = i + 1;
                    }
                }
                pos = end;
            } else {
                pos = pos + 1;
            }
        }
    }
    return set;
}

fn ll_emit_fn_strings(toks: List[String], pos: Int, n: Int) {
    let end: Int = ll_skip_fn(toks, pos, n);
    let mut i: Int = pos;
    while i < end {
        if ll_k(toks, i) == "STRING" {
            let tx: String = ll_t(toks, i);
            let ln: Int = chars_len(tx) + 1;
            println("@.s" + i.to_string() + " = private unnamed_addr constant [" + ln.to_string() + " x i8] c\"" + ll_c_esc(tx) + "\\00\"");
        }
        i = i + 1;
    }
}

fn ll_callee_set(toks: List[String], pos: Int, n: Int) -> String {
    let end: Int = ll_skip_fn(toks, pos, n);
    let mut o: String = "\t"; let mut i: Int = pos;
    while i < end {
        if ll_k(toks, i) == "IDENT" && i + 1 < end && ll_k(toks, i + 1) == "LPAREN" {
            if !(i > pos && ll_k(toks, i - 1) == "DOT") {
                o = o + ll_t(toks, i) + "\t";
            }
        }
        i = i + 1;
    }
    return o;
}

fn ll_prune_sigs(sigs: String, stenv: String, want: String) -> String {
    let n: Int = chars_len(sigs); let mut o: String = ""; let mut i: Int = 0;
    while i < n {
        let at: Bool = i == 0 || char_at(sigs, i - 1) == ";";
        if at && i + 6 <= n && str_slice(sigs, i, i + 6) == "__fn__" {
            let mut k: Int = i + 6;
            while k < n && char_at(sigs, k) != "=" { k = k + 1; }
            if ll_in_set(want, str_slice(sigs, i + 6, k)) {
                let mut m: Int = k;
                while m < n && char_at(sigs, m) != ";" { m = m + 1; }
                o = o + str_slice(sigs, i, m) + ";";
                i = m;
            }
        }
        i = i + 1;
    }
    return o + stenv;
}

pub fn ll_emit_stream_toks(toks: List[String]) {
    if list_len(toks) < 1 {
        println("ERR\tllvm\tempty artifact");
        process_exit(1);
    }
    ll_rt_header(toks);
    let stenv: String = ll_struct_declare(toks);
    ll_struct_emit_types(stenv);
    let stab: String = ll_struct_tab_of(stenv);
    let sigs: String = ll_collect_sigs(toks, stab) + stenv;
    let keep: String = ll_reachable(toks, ll_known_fns(sigs));
    let n: Int = list_len(toks);
    let mut pos: Int = 0;
    while pos < n {
        let k: String = ll_k(toks, pos);
        if k == "EOF" {
            pos = n;
        } else if k == "SRC_PATH" || k == "LINEFILE" {
            pos = pos + 1;
        } else if k == "KW_IMPORT" || k == "KW_TYPE" {
            pos = skip_until_semi(toks, pos);
        } else if k == "KW_PUB" || k == "KW_EXPORT" || k == "KW_FN" {
            let nm: String = ll_fn_name_at(toks, pos, n);
            if ll_in_set(keep, nm) {
                println("; FN " + nm);
                ll_emit_fn_strings(toks, pos, n);
                let penv: String = ll_prune_sigs(sigs, stenv, ll_callee_set(toks, pos, n));
                pos = ll_emit_fn(toks, pos, n, penv, stab);
            } else {
                pos = ll_skip_fn(toks, pos, n);
            }
        } else if k == "IDENT" && (ll_t(toks, pos) == "trait" || ll_t(toks, pos) == "impl") {
            while pos < n && ll_k(toks, pos) != "LBRACE" && ll_k(toks, pos) != "EOF" { pos = pos + 1; }
            if pos < n && ll_k(toks, pos) == "LBRACE" { pos = skip_balanced(toks, pos); }
        } else if k == "KW_VERIFY" {
            pos = ll_emit_verify(toks, pos, n, stab);
        } else {
            pos = pos + 1;
        }
    }
}
