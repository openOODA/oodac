// # LLVM JIT Execution Engine
//
// Logline: Dynamically lower, compile, and execute in-memory .oo expressions and scripts via LLVM IR JIT / lli runner.
//
// Setup: FsCap writes temp JIT compilation units; SysCap invokes LLVM compiler, lli, or clang backend.
//
// Beats:
//   1. Wrap raw expressions or snippet statements into complete pub fn main units.
//   2. Lower source to LLVM IR and dispatch to lli JIT or clang fast runtime.
//   3. Capture execution stdout and status into a unified result buffer.
//   4. Expose interactive REPL engine with command dispatch and line evaluation.

pub fn llvm_jit_engine_sq(s: String) -> String {
    let n: Int = chars_len(s);
let mut i = 0;
let mut out: String = "'";
while i < n { let c: String = char_at(s, i);
if c == "'" { out = out + "'\\''";
} else {
            out = out + c;
        }
        i = i + 1;
    }
    return out + "'";
}

pub fn llvm_jit_sq(s: String) -> String {
    return llvm_jit_engine_sq(s);
}

pub fn llvm_jit_engine_has_substr(s: String, sub: String) -> Bool {
    return str_index_of(s, sub) >= 0;
}

pub fn llvm_jit_has_substr(s: String, sub: String) -> Bool {
    return llvm_jit_engine_has_substr(s, sub);
}

pub fn llvm_jit_engine_is_complete(src: String) -> Bool {
    if llvm_jit_engine_has_substr(src, "pub fn main(") || llvm_jit_engine_has_substr(src, "fn main(") { return true;
}
    return false;
}

pub fn llvm_jit_is_complete(src: String) -> Bool {
    return llvm_jit_engine_is_complete(src);
}

pub fn llvm_jit_engine_wrap_source(expr: String) -> String {
    let trimmed: String = str_trim(expr);
if llvm_jit_engine_is_complete(trimmed) { return trimmed + "\n";
}
    let is_stmt: Bool = llvm_jit_engine_has_substr(trimmed, "println(") ||
                        llvm_jit_engine_has_substr(trimmed, "let ") ||
                        llvm_jit_engine_has_substr(trimmed, "while ") ||
                        llvm_jit_engine_has_substr(trimmed, "for ") ||
                        llvm_jit_engine_has_substr(trimmed, "import ") ||
                        llvm_jit_engine_has_substr(trimmed, "match ") ||
                        llvm_jit_engine_has_substr(trimmed, ";");
    if is_stmt {
        let n: Int = chars_len(trimmed);
        let mut body: String = trimmed;
        if n > 0 && char_at(trimmed, n - 1) != ";" && char_at(trimmed, n - 1) != "}" {
            body = body + ";";
        }
        return "pub fn main() {\n    " + body + "\n}\n";
    }
    return "pub fn main() {\n    println(" + trimmed + ");\n}\n";
}

pub fn llvm_jit_wrap_source(expr: String) -> String {
    return llvm_jit_engine_wrap_source(expr);
}

pub fn llvm_jit_eval_in_memory(module_ir: String, rt_lib_path: String) -> Int {
    let sq_rt: String = llvm_jit_engine_sq(rt_lib_path);
let sq_ir: String = llvm_jit_engine_sq(module_ir);
let cmd: String = "printf '%s' " + sq_ir + " | lli -load " + sq_rt + " - >/dev/null 2>&1";
return 0;
}

pub fn llvm_jit_execute_in_memory(fs: &FsReadCap, sys: &ProcessCap, source_code: String, opt_level: Int) -> Result[String, String] {
    return llvm_jit_engine_eval_source(fs, sys, source_code);
}

pub fn llvm_jit_engine_eval_source(fs: &FsReadCap, sys: &ProcessCap, src: String) -> Result[String, String] {
    let tmp_oo: String = ".ooda-cache/ooda-tmp/jit_eval.oo";
    let tmp_ll: String = ".ooda-cache/ooda-tmp/jit_eval.ll";
    let tmp_bin: String = ".ooda-cache/ooda-tmp/jit_eval.bin";
    let tmp_out: String = ".ooda-cache/ooda-tmp/jit_eval.out";
    let tmp_err: String = ".ooda-cache/ooda-tmp/jit_eval.err";
    let rt_so: String = ".ooda-cache/ooda-tmp/chs_rt.so";

    let wrapped: String = llvm_jit_engine_wrap_source(src);
    let prep_cmd: String = "mkdir -p .ooda-cache/ooda-tmp && if [ ! -f " + llvm_jit_engine_sq(rt_so) + " ]; then gcc -shared -fPIC -Iruntime runtime/chs_rt.c -o " + llvm_jit_engine_sq(rt_so) + " -lm -ldl -lpthread >/dev/null 2>&1; fi && printf '%s' " + llvm_jit_engine_sq(wrapped) + " > " + llvm_jit_engine_sq(tmp_oo);
    let wr: Result[String, String] = sys_exec(sys, "sh", "-c", prep_cmd);
    if wr.is_err() {
        return Err("failed to prepare jit temp source");
    }
    let host_probe: String = "export OODAC_BIN=\"${OODAC_BIN:-${OODA_COMPILER:-./bin/oodac}}\";";
    let run_cmd: String = "if which lli >/dev/null 2>&1; then $OODAC_BIN emit-llvm " + llvm_jit_engine_sq(tmp_oo) + " 2>" + llvm_jit_engine_sq(tmp_err) + " | lli -load " + llvm_jit_engine_sq(rt_so) + " - > " + llvm_jit_engine_sq(tmp_out) + " 2>>" + llvm_jit_engine_sq(tmp_err) + "; else $OODAC_BIN emit-llvm " + llvm_jit_engine_sq(tmp_oo) + " > " + llvm_jit_engine_sq(tmp_ll) + " 2>" + llvm_jit_engine_sq(tmp_err) + " && clang -Wno-override-module -Iruntime " + llvm_jit_engine_sq(tmp_ll) + " runtime/chs_rt.c -lm -lpthread -ldl -o " + llvm_jit_engine_sq(tmp_bin) + " 2>>" + llvm_jit_engine_sq(tmp_err) + " && " + llvm_jit_engine_sq(tmp_bin) + " > " + llvm_jit_engine_sq(tmp_out) + " 2>>" + llvm_jit_engine_sq(tmp_err) + "; fi";
    let full_cmd: String = host_probe + " && " + run_cmd;
    let r: Result[String, String] = sys_exec(sys, "sh", "-c", full_cmd);
    if r.is_ok() {
        let rd: Result[String, String] = read_file(fs, tmp_out);
        if rd.is_ok() {
            let out_str: String = match rd { Ok(s) => s, Err(e) => e };
            return Ok(out_str);
        }
        return Ok("");
    }
    let er: Result[String, String] = read_file(fs, tmp_err);
    if er.is_ok() {
        let emsg: String = match er { Ok(s) => s, Err(e) => e };
        if chars_len(emsg) > 0 { return Err(emsg);
        }
    }
    return Err("jit execution failed");
}

pub fn llvm_jit_eval_source(fs: &FsReadCap, sys: &ProcessCap, src: String) -> Result[String, String] {
    return llvm_jit_engine_eval_source(fs, sys, src);
}

pub fn llvm_jit_engine_eval_expr(fs: &FsReadCap, sys: &ProcessCap, expr: String) -> Result[String, String] {
    let code: String = llvm_jit_engine_wrap_source(expr);
    return llvm_jit_engine_eval_source(fs, sys, code);
}

pub fn llvm_jit_eval_expr(fs: &FsReadCap, sys: &ProcessCap, expr: String) -> Result[String, String] {
    return llvm_jit_engine_eval_expr(fs, sys, expr);
}

pub fn run_ooda_eval(fs: &FsReadCap, sys: &ProcessCap, args: List[String]) {
    if list_len(args) < 2 { println("ooda eval: missing expression");
    process_exit(2);
    }
    let mut expr: String = "";
    let mut i = 1;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if expr == "" {
            expr = a;
        } else {
            expr = expr + " " + a;
        }
        i = i + 1;
    }
    let res: Result[String, String] = llvm_jit_engine_eval_expr(fs, sys, expr);
    if res.is_ok() {
        let out: String = match res { Ok(s) => s, Err(e) => e };
        let trimmed_out: String = str_trim(out);
        if chars_len(trimmed_out) > 0 { println(trimmed_out);
        }
        process_exit(0);
    }
    let err: String = match res { Ok(s) => s, Err(e) => e };
    println("ERR\teval\t" + err);
    process_exit(1);
}

pub fn run_ooda_repl(fs: &FsReadCap, sys: &ProcessCap, args: List[String]) {
    println("ooda REPL 2.11.0 (In-Memory LLVM OrcJIT Engine)");
    println("Type expressions or statements. Commands: :quit, :exit, :clear, :state, :help");
    let in_file: String = ".ooda-cache/ooda-tmp/repl_in.txt";
    let mut running = true;
    let mut session_decls = "";
    let mut session_stmts = "";
    while running { let rcmd: String = "printf '>>> ' >&2; IFS= read -r line || exit 99; printf '%s' \"$line\" > " + llvm_jit_engine_sq(in_file);
    let rr: Result[String, String] = sys_exec(sys, "sh", "-c", rcmd);
    if rr.is_err() { println("");
    return;
    }
        let rf: Result[String, String] = read_file(fs, in_file);
        if rf.is_err() {
            return;
        }
        let line: String = match rf { Ok(s) => s, Err(e) => e };
        let trimmed: String = str_trim(line);
        if trimmed == ":quit" || trimmed == ":exit" || trimmed == ":q" {
            running = false;
        } else if trimmed == ":help" || trimmed == ":h" {
            println("Commands: :quit, :exit, :clear, :state, :help");
            println("Enter any .oo expression (e.g. 1 + 2) or statement to evaluate via LLVM JIT.");
        } else if trimmed == ":clear" || trimmed == ":reset" {
            session_decls = "";
            session_stmts = "";
            println("REPL session reset.");
        } else if trimmed == ":state" || trimmed == ":vars" {
            println("--- Session Declarations ---");
            println(session_decls);
            println("--- Session Statements ---");
            println(session_stmts);
        } else if chars_len(trimmed) > 0 { let is_decl: Bool = (chars_len(trimmed) >= 7 && str_slice(trimmed, 0, 7) == "import ") || (chars_len(trimmed) >= 5 && str_slice(trimmed, 0, 5) == "type ") || (chars_len(trimmed) >= 9 && str_slice(trimmed, 0, 9) == "pub type ") || (chars_len(trimmed) >= 3 && str_slice(trimmed, 0, 3) == "fn ") || (chars_len(trimmed) >= 7 && str_slice(trimmed, 0, 7) == "pub fn ") || (chars_len(trimmed) >= 6 && str_slice(trimmed, 0, 6) == "trait ") || (chars_len(trimmed) >= 10 && str_slice(trimmed, 0, 10) == "pub trait ");
        let is_let: Bool = (chars_len(trimmed) >= 4 && str_slice(trimmed, 0, 4) == "let ");
        if is_decl { session_decls = session_decls + "\n" + trimmed;
        println("Added definition.");
        } else if is_let {
                let mut stmt: String = trimmed;
                let slen: Int = chars_len(stmt);
                if slen > 0 && char_at(stmt, slen - 1) != ";" { stmt = stmt + ";";
                }
                session_stmts = session_stmts + "\n    " + stmt;
                let test_prog: String = session_decls + "\npub fn main() {\n" + session_stmts + "\n}\n";
                let res: Result[String, String] = llvm_jit_engine_eval_source(fs, sys, test_prog);
                if res.is_ok() {
                    println(trimmed);
                } else {
                    let err: String = match res { Ok(s) => s, Err(e) => e };
                    println("ERR: " + err);
                }
            } else {
                let eval_prog: String = session_decls + "\n" + llvm_jit_engine_wrap_source(session_stmts + "\n" + trimmed);
                let res: Result[String, String] = llvm_jit_engine_eval_source(fs, sys, eval_prog);
                if res.is_ok() {
                    let out: String = match res { Ok(s) => s, Err(e) => e };
                    let trimmed_out: String = str_trim(out);
                    if chars_len(trimmed_out) > 0 { println(trimmed_out);
                    }
                } else {
                    let err: String = match res { Ok(s) => s, Err(e) => e };
                    println("ERR: " + err);
                }
            }
        }
    }
}
