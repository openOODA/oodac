// # SSA Dominance Frontier Engine
//
// Logline: Computes CFG successors, predecessors, immediate dominators, dominance frontiers, and iterated dominance frontiers for phi placement.
//
// Setup: Graph analysis module for cross-block mem2reg promotion and SSA phi node generation.
//
// Beats:
//   1. Build CFG predecessor and successor adjacency lists from SsaFunction branches.
//   2. Compute immediate dominators (idom) via iterative fixed-point algorithm.
//   3. Compute dominance frontiers (DF) for every basic block.
//   4. Compute iterated dominance frontiers (IDF) for variable definition sets.

import "ssa_ir.oo";

fn ssa_list_contains(xs: List[Int], v: Int) -> Bool {
    let n: Int = list_len(xs);
    let mut i: Int = 0;
    while i < n {
        if list_get(xs, i) == v { return true; }
        i = i + 1;
    }
    return false;
}

pub fn ssa_cfg_succs(fn_node: SsaFunction) -> List[Int] {
    let n_blocks: Int = fn_node.block_count;
    let mut succs: List[Int] = list_new();
    let n_insts: Int = list_len(fn_node.inst_opcodes);
    let ops: List[Int] = fn_node.inst_opcodes;
    let res: List[Int] = fn_node.inst_results;
    let imms: List[Int] = fn_node.inst_imm_vals;
    let bids: List[Int] = fn_node.inst_block_ids;
    let mut i: Int = 0;
    while i < n_insts {
        let bid: Int = list_get(bids, i);
        let op: Int = list_get(ops, i);
        if bid >= 0 && bid < n_blocks {
            if op == ssa_op_br() {
                let target: Int = list_get(imms, i);
                if target >= 0 && target < n_blocks {
                    let edge: Int = bid * 10000 + target;
                    if !ssa_list_contains(succs, edge) { succs = list_push(succs, edge); }
                }
            } else if op == ssa_op_cond_br() {
                let t_then: Int = list_get(res, i);
                let t_else: Int = list_get(imms, i);
                if t_then >= 0 && t_then < n_blocks {
                    let edge1: Int = bid * 10000 + t_then;
                    if !ssa_list_contains(succs, edge1) { succs = list_push(succs, edge1); }
                }
                if t_else >= 0 && t_else < n_blocks {
                    let edge2: Int = bid * 10000 + t_else;
                    if !ssa_list_contains(succs, edge2) { succs = list_push(succs, edge2); }
                }
            }
        }
        i = i + 1;
    }
    return succs;
}

pub fn ssa_cfg_preds(fn_node: SsaFunction) -> List[Int] {
    let succs: List[Int] = ssa_cfg_succs(fn_node);
    let mut preds: List[Int] = list_new();
    let n: Int = list_len(succs);
    let mut i: Int = 0;
    while i < n {
        let edge: Int = list_get(succs, i);
        let u: Int = edge / 10000;
        let v: Int = edge % 10000;
        let pred_edge: Int = u * 10000 + v;
        if !ssa_list_contains(preds, pred_edge) { preds = list_push(preds, pred_edge); }
        i = i + 1;
    }
    return preds;
}

fn ssa_preds_of(preds: List[Int], v: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = list_len(preds);
    let mut i: Int = 0;
    while i < n {
        let edge: Int = list_get(preds, i);
        if edge % 10000 == v { out = list_push(out, edge / 10000); }
        i = i + 1;
    }
    return out;
}

fn ssa_intersect_idoms(idom: List[Int], b1: Int, b2: Int) -> Int {
    let mut f1: Int = b1;
    let mut f2: Int = b2;
    let mut guard: Int = 0;
    while f1 != f2 && guard < 1000 {
        while f1 > f2 && f1 > 0 { f1 = list_get(idom, f1); }
        while f2 > f1 && f2 > 0 { f2 = list_get(idom, f2); }
        guard = guard + 1;
    }
    return f1;
}

pub fn ssa_compute_dominators(fn_node: SsaFunction) -> List[Int] {
    let n_blocks: Int = fn_node.block_count;
    let mut idom: List[Int] = list_new();
    if n_blocks == 0 { return idom; }
    let mut b: Int = 0;
    while b < n_blocks {
        if b == 0 { idom = list_push(idom, 0); } else { idom = list_push(idom, -1); }
        b = b + 1;
    }
    let preds: List[Int] = ssa_cfg_preds(fn_node);
    let mut changed: Bool = true;
    let mut pass: Int = 0;
    while changed && pass < 100 {
        changed = false;
        let mut i: Int = 1;
        while i < n_blocks {
            let p_list: List[Int] = ssa_preds_of(preds, i);
            let np: Int = list_len(p_list);
            if np > 0 {
                let mut first_processed: Int = -1;
                let mut p_idx: Int = 0;
                while p_idx < np {
                    let p: Int = list_get(p_list, p_idx);
                    if list_get(idom, p) != -1 {
                        if first_processed == -1 { first_processed = p; }
                        else { first_processed = ssa_intersect_idoms(idom, p, first_processed); }
                    }
                    p_idx = p_idx + 1;
                }
                if first_processed != -1 && list_get(idom, i) != first_processed {
                    idom = ssa_list_set_l(idom, i, first_processed);
                    changed = true;
                }
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    return idom;
}

pub fn ssa_compute_dominance_frontiers(fn_node: SsaFunction, idom: List[Int]) -> List[Int] {
    let n_blocks: Int = fn_node.block_count;
    let mut df: List[Int] = list_new();
    let preds: List[Int] = ssa_cfg_preds(fn_node);
    let mut y: Int = 0;
    while y < n_blocks {
        let p_list: List[Int] = ssa_preds_of(preds, y);
        if list_len(p_list) >= 2 {
            let idom_y: Int = list_get(idom, y);
            let mut p_idx: Int = 0;
            while p_idx < list_len(p_list) {
                let mut runner: Int = list_get(p_list, p_idx);
                let mut guard: Int = 0;
                while runner != idom_y && runner >= 0 && guard < n_blocks {
                    let edge: Int = runner * 10000 + y;
                    if !ssa_list_contains(df, edge) { df = list_push(df, edge); }
                    let next_runner: Int = list_get(idom, runner);
                    if next_runner == runner { runner = -1; } else { runner = next_runner; }
                    guard = guard + 1;
                }
                p_idx = p_idx + 1;
            }
        }
        y = y + 1;
    }
    return df;
}

pub fn ssa_compute_idf(df: List[Int], def_blocks: List[Int]) -> List[Int] {
    let mut idf: List[Int] = list_new();
    let mut worklist: List[Int] = list_new();
    let mut i: Int = 0;
    while i < list_len(def_blocks) {
        worklist = list_push(worklist, list_get(def_blocks, i));
        i = i + 1;
    }
    let mut head: Int = 0;
    while head < list_len(worklist) {
        let x: Int = list_get(worklist, head);
        head = head + 1;
        let n_df: Int = list_len(df);
        let mut j: Int = 0;
        while j < n_df {
            let edge: Int = list_get(df, j);
            if edge / 10000 == x {
                let y: Int = edge % 10000;
                if !ssa_list_contains(idf, y) {
                    idf = list_push(idf, y);
                    if !ssa_list_contains(def_blocks, y) { worklist = list_push(worklist, y); }
                }
            }
            j = j + 1;
        }
    }
    return idf;
}

fn ssa_list_set_l(xs: List[Int], idx: Int, val: Int) -> List[Int] {
    let n: Int = list_len(xs);
    let mut out: List[Int] = list_new();
    let mut k: Int = 0;
    while k < n {
        if k == idx { out = list_push(out, val); } else { out = list_push(out, list_get(xs, k)); }
        k = k + 1;
    }
    return out;
}
