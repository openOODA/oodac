// ──▓▓ Public LLVM Emitter API ──▓▓──

pub fn emit_llvm_stream(src: String, no_preamble: Bool, extra_fntab: String) {
    llvm_emit_stream(src, no_preamble, extra_fntab);
}

pub fn emit_llvm_stream_target(src: String, no_preamble: Bool, extra_fntab: String, triple: String) {
    llvm_emit_stream_target(src, no_preamble, extra_fntab, triple);
}
