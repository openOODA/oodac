// # LLVM expression lowering
//
// Logline: Walk primary, postfix, unary, and binop tokens. Locals in env.
//
// Setup: Parses expressions via precedence climbing. Dispatches calls and constructors.
//
// Beats:
//   1. Primary expressions lower literals, identifiers, and paren groupings.
//   2. Unary operators handle borrow, deref, negation, and logical not.
//   3. Precedence climbing lowers binary arithmetic, comparison, and short-circuit logic.
import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "types/types_core.oo";
import "ll_call.oo";
import "ll_method.oo";
import "ll_match_expr.oo";
import "ll_builtin.oo";
import "ll_ctor.oo";
import "ll_struct_kind.oo";
import "ll_slot.oo";
import "ll_arc.oo";
import "ll_struct_list.oo";
import "ll_float.oo";
import "ll_ir.oo";
import "ll_expr_util.oo";
import "ll_exit.oo";
import "ll_ifexpr.oo";
import "ll_user_call.oo";
pub fn ll_expr(toks: List[String], pos: Int, n: Int, ssa0: Int, env: String, ir: &mut IrBuf) -> String {
    if pos < n { ll_ir_set_loc(ir, ll_line(toks, pos), ll_col(toks, pos)); }
    return ll_bin_climb(toks, pos, n, 2, ssa0, env, ir);
}
fn ll_unary(toks: List[String], pos: Int, n: Int, ssa0: Int, env: String, ir: &mut IrBuf) -> String {
    if pos < n && ll_k(toks, pos) == "AMP" {
        return ll_borrow_addr(toks, pos, n, ssa0, env, ir);
    }
    if pos < n && ll_k(toks, pos) == "STAR" {
        let r: String = ll_unary(toks, pos + 1, n, ssa0, env, ir);
        return ll_deref_load(r, ir);
    }
    if pos < n && ll_k(toks, pos) == "BANG" {
        let r: String = ll_unary(toks, pos + 1, n, ssa0, env, ir);
        return ll_not_i1(r, ir);
    }
    if pos < n && ll_k(toks, pos) == "MINUS" {
        let r: String = ll_unary(toks, pos + 1, n, ssa0, env, ir);
        return ll_neg_int(r, ir);
    }
    return ll_postfix(toks, pos, n, ssa0, env, ir);
}

fn ll_postfix(toks: List[String], pos: Int, n: Int, ssa0: Int, env: String, ir: &mut IrBuf) -> String {
    let mut r: String = ll_primary(toks, pos, n, ssa0, env, ir);
    let mut p: Int = ll_ppos(r);
    let mut ssa: Int = ll_pssa(r);
    while p < n && ll_k(toks, p) == "DOT" {
        p = p + 1;
        if p >= n || ll_k(toks, p) != "IDENT" {
            println("ERR\tllvm\tmethod");
            process_exit(1);
        }
        let m: String = ll_t(toks, p);
        p = p + 1;
        let mut arg: String = ll_pack(p, ssa, "", "");
        if p < n && ll_k(toks, p) == "LPAREN" {
            p = p + 1;
            if p < n && ll_k(toks, p) == "RPAREN" {
                arg = ll_pack(p, ssa, "empty", "");
                p = p + 1;
            } else {
                let av: String = ll_expr(toks, p, n, ssa, env, ir);
                p = ll_ppos(av); ssa = ll_pssa(av);
                if p >= n || ll_k(toks, p) != "RPAREN" {
                    println("ERR\tllvm\tmethod args residual");
                    process_exit(1);
                }
                p = p + 1;
                arg = ll_pack(p, ssa, ll_pk(av), ll_pptr(av));
            }
        }
        r = ll_method(ll_pk(r), ll_pssa(r), ll_pptr(r), m, ssa, env, arg, ir);
        ssa = ll_pssa(r);
        r = ll_pack(p, ssa, ll_pk(r), ll_pptr(r));
    }
    return r;
}

fn ll_bin_climb(toks: List[String], pos: Int, n: Int, min_bp: Int, ssa0: Int, env: String, ir: &mut IrBuf) -> String {
    let mut r: String = ll_unary(toks, pos, n, ssa0, env, ir);
    let mut p: Int = ll_ppos(r);
    while p < n {
        let op: String = ll_k(toks, p);
        let bp: Int = ll_bin_bp(op);
        if bp < min_bp || bp == 0 {
            return r;
        }
        p = p + 1;
        let ls: Int = ll_pssa(r);
        if op == "ANDAND" {
            ll_guard_i1(ll_pk(r), op, "lhs");
            let id: Int = ls;
            ll_ir_inst(ir, "br", "i1", "", ll_opnd(r) + ", label %ar" + id.to_string() + ", label %af" + id.to_string(), 1, 1);
            ll_ir_label(ir, "ar" + id.to_string());
            let rhs: String = ll_bin_climb(toks, p, n, bp + 1, ls, env, ir);
            ll_guard_i1(ll_pk(rhs), op, "rhs");
            p = ll_ppos(rhs);
            let rs: Int = ll_pssa(rhs);
            ll_ir_inst(ir, "br", "", "", "label %aj" + id.to_string(), 1, 1);
            ll_ir_label(ir, "aj" + id.to_string());
            ll_ir_inst(ir, "br", "", "", "label %ae" + id.to_string(), 1, 1);
            ll_ir_label(ir, "af" + id.to_string());
            ll_ir_inst(ir, "br", "", "", "label %ae" + id.to_string(), 1, 1);
            ll_ir_label(ir, "ae" + id.to_string());
            let ph: Int = rs + 1;
            ll_ir_inst(ir, "phi", "i1", ll_ssa(ph), "[ " + ll_opnd(rhs) + ", %aj" + id.to_string() + " ], [ false, %af" + id.to_string() + " ]", 1, 1);
            r = ll_pack(p, ph, "i1", "");
        } else if op == "OROR" {
            ll_guard_i1(ll_pk(r), op, "lhs");
            let id: Int = ls;
            ll_ir_inst(ir, "br", "i1", "", ll_opnd(r) + ", label %ot" + id.to_string() + ", label %or" + id.to_string(), 1, 1);
            ll_ir_label(ir, "or" + id.to_string());
            let rhs: String = ll_bin_climb(toks, p, n, bp + 1, ls, env, ir);
            ll_guard_i1(ll_pk(rhs), op, "rhs");
            p = ll_ppos(rhs);
            let rs: Int = ll_pssa(rhs);
            ll_ir_inst(ir, "br", "", "", "label %oj" + id.to_string(), 1, 1);
            ll_ir_label(ir, "oj" + id.to_string());
            ll_ir_inst(ir, "br", "", "", "label %ae" + id.to_string(), 1, 1);
            ll_ir_label(ir, "ot" + id.to_string());
            ll_ir_inst(ir, "br", "", "", "label %ae" + id.to_string(), 1, 1);
            ll_ir_label(ir, "ae" + id.to_string());
            let ph: Int = rs + 1;
            ll_ir_inst(ir, "phi", "i1", ll_ssa(ph), "[ true, %ot" + id.to_string() + " ], [ " + ll_opnd(rhs) + ", %oj" + id.to_string() + " ]", 1, 1);
            r = ll_pack(p, ph, "i1", "");
        } else {
            let rhs: String = ll_bin_climb(toks, p, n, bp + 1, ls, env, ir);
            r = ll_apply_binop(op, r, rhs, ir);
            p = ll_ppos(rhs);
            r = ll_pack(p, ll_pssa(r), ll_pk(r), ll_pptr(r));
        }
    }
    return r;
}

fn ll_primary(toks: List[String], pos: Int, n: Int, ssa0: Int, env: String, ir: &mut IrBuf) -> String {
    if pos >= n {
        println("ERR\tllvm\texpr eof");
        process_exit(1);
    }
    let k: String = ll_k(toks, pos);
    if k == "INT" {
        let s: Int = ssa0 + 1;
        return ll_pack(pos + 1, s, "i64", "#" + ll_t(toks, pos));
    }
    if k == "FLOAT" { return ll_float_lit(toks, pos, ssa0, ir); }
    if k == "KW_TRUE" || k == "KW_FALSE" {
        let s: Int = ssa0 + 1;
        let bit: String = if k == "KW_TRUE" { "1" } else { "0" };
        return ll_pack(pos + 1, s, "i1", "#" + bit);
    }
    if k == "STRING" {
        return ll_str_gep(toks, pos, ssa0, ir);
    }
    if k == "LPAREN" {
        let mut p: Int = pos + 1;
        if p < n && ll_k(toks, p) == "RPAREN" {
            return ll_pack(p + 1, ssa0, "void", "");
        }
        let r: String = ll_expr(toks, p, n, ssa0, env, ir);
        p = ll_ppos(r);
        if p < n && ll_k(toks, p) == "RPAREN" { p = p + 1; }
        return ll_pack(p, ll_pssa(r), ll_pk(r), ll_pptr(r));
    }
    if k == "KW_MATCH" { return ll_match_expr(toks, pos, n, ssa0, env, ir); }
    if k == "KW_IF" { return ll_if_value_at(toks, pos, n, ssa0, env, ir); }
    if k == "KW_RETURN" {
        let r: String = ll_return_stmt(toks, pos, n, ssa0, env, type_env_get(env, "__rk__"), "", ir);
        return ll_pack(ll_ppos(r), ll_pssa(r), "noret", "") + "\t1";
    }
    if k == "IDENT" {
        let nm: String = ll_t(toks, pos);
        if pos + 1 < n && ll_k(toks, pos + 1) == "LBRACE" && type_env_get(env, "__st__" + nm) != "" {
            return ll_struct_lit_at(toks, pos, n, ssa0, env, ir);
        }
        if pos + 1 < n && ll_k(toks, pos + 1) == "LPAREN" {
            return ll_call_at(toks, pos, n, ssa0, env, ir);
        }
        if nm == "None" {
            let c: String = ll_ctor("None", ll_pack(pos, ssa0, "i64", ""), ssa0, type_env_get(env, "__e__"), ir);
            return ll_pack(pos + 1, ll_pssa(c), ll_pk(c), ll_pptr(c));
        }
        let ld: String = ll_load_ident(nm, env, ssa0, ir);
        return ll_pack(pos + 1, ll_pssa(ld), ll_pk(ld), ll_pptr(ld));
    }
    println("ERR\tllvm\tunsupported expr " + k);
    process_exit(1);
    return ll_pack(pos, ssa0, "i64", "");
}
pub fn ll_struct_lit_at(toks: List[String], pos: Int, n: Int, ssa0: Int, env: String, ir: &mut IrBuf) -> String {
    let nm: String = ll_t(toks, pos);
    if type_env_get(env, "__st__" + nm) == "" { println("ERR\tllvm\tunknown struct " + nm); process_exit(1); }
    if pos + 1 >= n || ll_k(toks, pos + 1) != "LBRACE" { println("ERR\tllvm\tstruct lit"); process_exit(1); }
    let a: String = ll_tmpa(ssa0 + 1); let mut s: Int = ssa0 + 1;
    ll_slot_ty(a, "%St_" + nm, ir);
    let rich: String = ll_struct_rich_scan(env, nm);
    let mut p: Int = pos + 2;
    while p < n && ll_k(toks, p) != "RBRACE" {
        if ll_k(toks, p) == "COMMA" { p = p + 1; continue; }
        if ll_k(toks, p) != "IDENT" { println("ERR\tllvm\tstruct lit field"); process_exit(1); }
        let fld2: String = ll_t(toks, p); let fe2: String = type_env_get(env, "__stf__" + nm + "." + fld2);
        if fe2 == "" { println("ERR\tllvm\tunknown field " + fld2); process_exit(1); }
        let cj2: Int = str_index_of(fe2, ":");
        let fk: String = ll_st_map(str_slice(fe2, cj2 + 1, chars_len(fe2)), ",", "|"); p = p + 1;
        if p >= n || ll_k(toks, p) != "COLON" { println("ERR\tllvm\tstruct lit colon"); process_exit(1); }
        p = p + 1; let lrhs0: Int = p; let v0: String = ll_expr(toks, p, n, s, type_env_put(env, "__e__", fk), ir); p = ll_ppos(v0); s = ll_pssa(v0);
        let mut v: String = ll_int_convert(v0, s, fk, ir);
        s = ll_pssa(v);
        let mut pk: String = ll_pk(v);
        if pk == "slist" && chars_len(fk) >= 6 && str_slice(fk, 0, 6) == "olist_" {
            v = ll_olist_new(fk, s, ir);
            s = ll_pssa(v);
            pk = ll_pk(v);
        }
        if pk != fk {
            let mut same: Bool = false;
            if ll_is_struct(pk) && ll_is_struct(fk) {
                if ll_st_basek(pk) == ll_st_basek(fk) { same = true; }
            }
            if !same { println("ERR\tllvm\tfield type " + fld2); process_exit(1); }
        }
        let fi: String = ll_struct_field(rich, fld2); let idx: String = str_slice(fi, 0, str_index_of(fi, ":"));
        s = s + 1;
        ll_ir_inst(ir, "getelementptr inbounds", "%St_" + nm, ll_ssa(s), "ptr " + a + ", i32 0, i32 " + idx, 1, 1);
        let fk_ty: String = ll_ir_val(fk);
        if ll_has_slot(v) {
            s = s + 1;
            ll_ir_inst(ir, "load", fk_ty, ll_ssa(s), "ptr " + ll_pptr(v) + ", align 8", 1, 1);
            ll_ir_inst(ir, "store", fk_ty, "", ll_ssa(s) + ", ptr " + ll_ssa(s - 1) + ", align 8", 1, 1);
        } else {
            ll_ir_inst(ir, "store", fk_ty, "", ll_opnd(v) + ", ptr " + ll_ssa(s) + ", align 8", 1, 1);
        }
        if ll_arc_owned(fk) && (ll_is_var(ll_pptr(v)) || (ll_pptr(v) != "" && ll_slot_borrowed(toks, lrhs0, n))) { s = ll_arc_keep_ptr(fk, ll_pptr(v), s, ir); }
    }
    if p >= n || ll_k(toks, p) != "RBRACE" { println("ERR\tllvm\tstruct lit rbrace"); process_exit(1); }
    return ll_pack(p + 1, s, rich, a);
}
