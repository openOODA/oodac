// # LLVM match-statement lowering
//
// Logline: Lower match as a statement: Result/Option tag arms and String literal arms.
//
// Setup: Called from ll_emit_stmts on KW_MATCH. Sibling expr/stmt fns resolve
//   through the emit closure (cf. ll_method.oo). No ll_stmt import (cycle).
//
// Beats:
//   1. Result/Option arms in either order lower to a tag branch with scoped payload binds.
//   2. String arms lower to an oo_str_eq chain with a wildcard else.
//   3. Block arms run full statements; single arms run println, assign, or expr.
//   4. Anything else fails closed with an explicit kind.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_struct_kind.oo";
import "ll_ir.oo";
import "lex/token_fmt.oo";
import "lex/token_parse_int.oo";
import "ll_call.oo";
import "ll_struct_list.oo";
import "ll_match_arm.oo";
import "ll_expr.oo";

pub fn ll_match_stmt(toks: List[String], p0: Int, n: Int, ssa0: Int, env: String, ret_kind: String, stab: String, ir: &mut IrBuf) -> String {
    let scr: String = ll_expr(toks, p0 + 1, n, ssa0, env, ir);
    let mut p: Int = ll_ppos(scr);
    let sk: String = ll_pk(scr);
    if sk == "str" {
        return ll_str_match_stmt(toks, scr, p, n, env, ret_kind, stab, ir);
    }
    if sk != "resi" && sk != "resb" && sk != "resf" && sk != "ress" && sk != "resl" && sk != "resil" && sk != "opti" && sk != "opts" && sk != "optp" && sk != "resp" && !ll_is_resst(sk) && !ll_is_optst(sk) {
        println("ERR\tllvm\tmatch scrutinee kind " + sk);
        process_exit(1);
    }
    if p >= n || ll_k(toks, p) != "LBRACE" {
        println("ERR\tllvm\tmatch expected {");
        process_exit(1);
    }
    p = p + 1;
    let sp: String = ll_ensure_ptr(scr, ll_pssa(scr), ir);
    let id: Int = ll_pssa(sp) + 1;
    let tag: Int = ll_match_tag(sk, ll_pptr(sp), ll_pssa(sp), ir);
    let a1: String = ll_match_arm_head(toks, p, n);
    let tag1: String = field_at(a1, 0);
    let bind1: String = field_at(a1, 1);
    p = parse_int(field_at(a1, 2));
    let ok1: Int = ll_match_ok_tag(tag1);
    let mut cond: Int = tag;
    if ok1 == 0 {
        cond = tag + 1;
        ll_ir_inst(ir, "xor", "i1", ll_ssa(cond), ll_ssa(tag) + ", true", 1, 1);
    }
    ll_ir_inst(ir, "br", "i1", "", ll_ssa(cond) + ", label %marm1" + id.to_string() + ", label %marm2" + id.to_string(), 1, 1);
    ll_ir_label(ir, "marm1" + id.to_string());
    let b1: String = ll_match_bind(sk, ll_pptr(sp), bind1, ok1, id, cond, ir);
    let e1: String = ll_match_arm_env(env, bind1, b1);
    let r1: String = ll_match_arm_body(toks, p, n, ll_pssa(b1) + 1, e1, ret_kind, stab, ir);
    p = ll_ppos(r1);
    let mut ssa: Int = ll_pssa(r1);
    let t1: Int = ll_pterm(r1);
    if t1 == 0 {
        ll_ir_inst(ir, "br", "label", "", "%mend" + id.to_string(), 1, 1);
    }
    if p < n && ll_k(toks, p) == "COMMA" { p = p + 1; }
    let a2: String = ll_match_arm_head(toks, p, n);
    let tag2: String = field_at(a2, 0);
    let bind2: String = field_at(a2, 1);
    p = parse_int(field_at(a2, 2));
    let ok2: Int = ll_match_ok_tag(tag2);
    if ok2 == ok1 {
        println("ERR\tllvm\tmatch arms must pair ok with err");
        process_exit(1);
    }
    ll_ir_label(ir, "marm2" + id.to_string());
    let b2: String = ll_match_bind(sk, ll_pptr(sp), bind2, ok2, id, ssa, ir);
    let e2: String = ll_match_arm_env(env, bind2, b2);
    let r2: String = ll_match_arm_body(toks, p, n, ll_pssa(b2) + 1, e2, ret_kind, stab, ir);
    p = ll_ppos(r2);
    ssa = ll_pssa(r2);
    let t2: Int = ll_pterm(r2);
    if t2 == 0 {
        ll_ir_inst(ir, "br", "label", "", "%mend" + id.to_string(), 1, 1);
    }
    if p < n && ll_k(toks, p) == "COMMA" { p = p + 1; }
    if p < n && ll_k(toks, p) == "RBRACE" { p = p + 1; }
    ll_ir_label(ir, "mend" + id.to_string());
    if t1 != 0 && t2 != 0 {
        ll_ir_inst(ir, "unreachable", "", "", "", 1, 1);
        p = ll_skip_to_rbrace(toks, p, n);
        return ll_pack(p, ssa, ret_kind, env) + "\t1";
    }
    return ll_pack(p, ssa, ret_kind, env);
}

fn ll_match_ok_tag(tag: String) -> Int {
    if tag == "Ok" || tag == "Some" { return 1; }
    return 0;
}

