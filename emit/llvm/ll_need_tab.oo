// # LLVM runtime symbol table catalog
//
// Logline: Complete prototype catalog for sovereign @oo_* runtime symbols.
//
// Setup: Maps runtime symbol names to exact LLVM declare signatures.
//
// Beats:
//   1. Core scalar I/O, string operations, and conversion declarations.
//   2. List operations, allocator payloads, and ARC retain/release helpers.
//   3. Capability grant intrinsics, filesystem, system, and TUI calls.

pub fn ll_need_proto(sym: String) -> String {
    let d1: String = ll_need_proto_core(sym);
    if d1 != "" { return d1; }
    let d2: String = ll_need_proto_list(sym);
    if d2 != "" { return d2; }
    let d3: String = ll_need_proto_sys(sym);
    if d3 != "" { return d3; }
    return ll_need_proto_tui(sym);
}

pub fn ll_need_extra(sym: String) -> String {
    if sym == "getenv" {
        return "@.oodatest = private unnamed_addr constant [10 x i8] c\"OODA_TEST\\00\"\n@.vok = private unnamed_addr constant [10 x i8] c\"OK verify\\00\"";
    }
    if sym == "oo_unwrap_msg" {
        return "@.uunwrapmsg = private unnamed_addr constant [12 x i8] c\"ERR\\09unwrap\\0A\\00\"";
    }
    return "";
}

fn ll_need_proto_core(sym: String) -> String {
    if sym == "getenv" { return "declare ptr @getenv(ptr) nounwind"; }
    if sym == "oo_print_int" { return "declare void @oo_print_int(i64) nounwind"; }
    if sym == "oo_print_bool" { return "declare void @oo_print_bool(i32) nounwind"; }
    if sym == "oo_print_double" { return "declare void @oo_print_double(double) nounwind"; }
    if sym == "oo_print_str" { return "declare void @oo_print_str(ptr, i64) nounwind"; }
    if sym == "oo_println" { return "declare void @oo_println() nounwind"; }
    if sym == "oo_int_to_str" { return "declare { ptr, i64 } @oo_int_to_str(i64) nounwind"; }
    if sym == "oo_str_lit" { return "declare { ptr, i64 } @oo_str_lit(ptr) nounwind"; }
    if sym == "oo_str_concat" { return "declare { ptr, i64 } @oo_str_concat({ ptr, i64 }, { ptr, i64 }) nounwind"; }
    if sym == "oo_str_repeat" { return "declare { ptr, i64 } @oo_str_repeat({ ptr, i64 }, i64) nounwind"; }
    if sym == "oo_str_to_uppercase" { return "declare { ptr, i64 } @oo_str_to_uppercase({ ptr, i64 }) nounwind"; }
    if sym == "oo_str_to_lowercase" { return "declare { ptr, i64 } @oo_str_to_lowercase({ ptr, i64 }) nounwind"; }
    if sym == "oo_char_at" { return "declare { ptr, i64 } @oo_char_at({ ptr, i64 }, i64) nounwind"; }
    if sym == "oo_str_slice" { return "declare { ptr, i64 } @oo_str_slice({ ptr, i64 }, i64, i64) nounwind"; }
    if sym == "oo_chars_len" { return "declare i64 @oo_chars_len({ ptr, i64 }) nounwind"; }
    if sym == "oo_bytes_len" { return "declare i64 @oo_bytes_len({ ptr, i64 }) nounwind"; }
    if sym == "oo_str_eq" { return "declare i32 @oo_str_eq({ ptr, i64 }, { ptr, i64 }) nounwind"; }
    if sym == "oo_str_ends_with" { return "declare i32 @oo_str_ends_with({ ptr, i64 }, { ptr, i64 }) nounwind"; }
    if sym == "oo_str_starts_with" { return "declare i32 @oo_str_starts_with({ ptr, i64 }, { ptr, i64 }) nounwind"; }
    if sym == "oo_str_contains" { return "declare i32 @oo_str_contains({ ptr, i64 }, { ptr, i64 }) nounwind"; }
    if sym == "oo_str_index_of" { return "declare i64 @oo_str_index_of({ ptr, i64 }, { ptr, i64 }) nounwind"; }
    if sym == "oo_byte_at" { return "declare i64 @oo_byte_at({ ptr, i64 }, i64) nounwind"; }
    if sym == "oo_byte_slice" { return "declare { ptr, i64 } @oo_byte_slice({ ptr, i64 }, i64, i64) nounwind"; }
    if sym == "oo_char_is_digit" { return "declare i32 @oo_char_is_digit({ ptr, i64 }) nounwind"; }
    if sym == "oo_char_is_alpha" { return "declare i32 @oo_char_is_alpha({ ptr, i64 }) nounwind"; }
    if sym == "oo_char_is_space" { return "declare i32 @oo_char_is_space({ ptr, i64 }) nounwind"; }
    if sym == "oo_str_trim" { return "declare { ptr, i64 } @oo_str_trim({ ptr, i64 }) nounwind"; }
    if sym == "oo_process_exit" { return "declare void @oo_process_exit(i64) noreturn nounwind"; }
    return "";
}

fn ll_need_proto_list(sym: String) -> String {
    if sym == "oo_closure_retain" { return "declare void @oo_closure_retain(ptr byval(%OoClosure) align 8) nounwind"; }
    if sym == "oo_closure_release" { return "declare void @oo_closure_release(ptr byval(%OoClosure) align 8) nounwind"; }
    if sym == "oo_slist_new" { return "declare void @oo_slist_new(ptr noalias sret(%OoSList) align 8) nounwind"; }
    if sym == "oo_slist_len" { return "declare i64 @oo_slist_len(ptr byval(%OoSList) align 8) nounwind"; }
    if sym == "oo_ilist_new" { return "declare void @oo_ilist_new(ptr noalias sret(%OoIList) align 8) nounwind"; }
    if sym == "oo_ilist_len" { return "declare i64 @oo_ilist_len(ptr byval(%OoIList) align 8) nounwind"; }
    if sym == "str_split" { return "declare void @str_split(ptr noalias sret(%OoSList) align 8, { ptr, i64 }, { ptr, i64 }) nounwind"; }
    if sym == "oo_str_retain" { return "declare void @oo_str_retain({ ptr, i64 }) nounwind"; }
    if sym == "oo_str_release" { return "declare void @oo_str_release({ ptr, i64 }) nounwind"; }
    if sym == "oo_slist_retain" { return "declare void @oo_slist_retain(ptr byval(%OoSList) align 8) nounwind"; }
    if sym == "oo_slist_release" { return "declare void @oo_slist_release(ptr byval(%OoSList) align 8) nounwind"; }
    if sym == "oo_ilist_retain" { return "declare void @oo_ilist_retain(ptr byval(%OoIList) align 8) nounwind"; }
    if sym == "oo_ilist_release" { return "declare void @oo_ilist_release(ptr byval(%OoIList) align 8) nounwind"; }
    if sym == "oo_slist_push" { return "declare void @oo_slist_push(ptr noalias sret(%OoSList) align 8, ptr byval(%OoSList) align 8, { ptr, i64 }) nounwind"; }
    if sym == "oo_slist_get" { return "declare { ptr, i64 } @oo_slist_get(ptr byval(%OoSList) align 8, i64) nounwind"; }
    if sym == "oo_slist_slice" { return "declare void @oo_slist_slice(ptr noalias sret(%OoSList) align 8, ptr byval(%OoSList) align 8, i64, i64) nounwind"; }
    if sym == "oo_slist_set" { return "declare void @oo_slist_set(ptr noalias sret(%OoSList) align 8, ptr byval(%OoSList) align 8, i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_ilist_push" { return "declare void @oo_ilist_push(ptr noalias sret(%OoIList) align 8, ptr byval(%OoIList) align 8, i64) nounwind"; }
    if sym == "oo_ilist_get" { return "declare i64 @oo_ilist_get(ptr byval(%OoIList) align 8, i64) nounwind"; }
    if sym == "oo_ilist_slice" { return "declare void @oo_ilist_slice(ptr noalias sret(%OoIList) align 8, ptr byval(%OoIList) align 8, i64, i64) nounwind"; }
    if sym == "oo_ilist_set" { return "declare void @oo_ilist_set(ptr noalias sret(%OoIList) align 8, ptr byval(%OoIList) align 8, i64, i64) nounwind"; }
    if sym == "oo_flist_new" { return "declare void @oo_flist_new(ptr noalias sret(%OoFList) align 8) nounwind"; }
    if sym == "oo_flist_len" { return "declare i64 @oo_flist_len(ptr byval(%OoFList) align 8) nounwind"; }
    if sym == "oo_flist_get" { return "declare double @oo_flist_get(ptr byval(%OoFList) align 8, i64) nounwind"; }
    if sym == "oo_flist_push" { return "declare void @oo_flist_push(ptr noalias sret(%OoFList) align 8, ptr byval(%OoFList) align 8, double) nounwind"; }
    if sym == "oo_flist_slice" { return "declare void @oo_flist_slice(ptr noalias sret(%OoFList) align 8, ptr byval(%OoFList) align 8, i64, i64) nounwind"; }
    if sym == "oo_flist_set" { return "declare void @oo_flist_set(ptr noalias sret(%OoFList) align 8, ptr byval(%OoFList) align 8, i64, double) nounwind"; }
    if sym == "oo_ll_I_slice" { return "declare void @oo_ll_I_slice(ptr noalias sret(%OoLL_I) align 8, ptr byval(%OoLL_I) align 8, i64, i64) nounwind"; }
    if sym == "oo_ll_S_slice" { return "declare void @oo_ll_S_slice(ptr noalias sret(%OoLL_S) align 8, ptr byval(%OoLL_S) align 8, i64, i64) nounwind"; }
    if sym == "oo_ll_I_set" { return "declare void @oo_ll_I_set(ptr noalias sret(%OoLL_I) align 8, ptr byval(%OoLL_I) align 8, i64, ptr byval(%OoIList) align 8) nounwind"; }
    if sym == "oo_ll_I_new" { return "declare void @oo_ll_I_new(ptr noalias sret(%OoLL_I) align 8) nounwind"; }
    if sym == "oo_ll_I_len" { return "declare i64 @oo_ll_I_len(ptr byval(%OoLL_I) align 8) nounwind"; }
    if sym == "oo_ll_I_get" { return "declare void @oo_ll_I_get(ptr noalias sret(%OoIList) align 8, ptr byval(%OoLL_I) align 8, i64) nounwind"; }
    if sym == "oo_ll_I_push" { return "declare void @oo_ll_I_push(ptr noalias sret(%OoLL_I) align 8, ptr byval(%OoLL_I) align 8, ptr byval(%OoIList) align 8) nounwind"; }
    if sym == "oo_ll_S_set" { return "declare void @oo_ll_S_set(ptr noalias sret(%OoLL_S) align 8, ptr byval(%OoLL_S) align 8, i64, ptr byval(%OoSList) align 8) nounwind"; }
    if sym == "oo_ll_S_new" { return "declare void @oo_ll_S_new(ptr noalias sret(%OoLL_S) align 8) nounwind"; }
    if sym == "oo_ll_S_len" { return "declare i64 @oo_ll_S_len(ptr byval(%OoLL_S) align 8) nounwind"; }
    if sym == "oo_ll_S_get" { return "declare void @oo_ll_S_get(ptr noalias sret(%OoSList) align 8, ptr byval(%OoLL_S) align 8, i64) nounwind"; }
    if sym == "oo_ll_S_push" { return "declare void @oo_ll_S_push(ptr noalias sret(%OoLL_S) align 8, ptr byval(%OoLL_S) align 8, ptr byval(%OoSList) align 8) nounwind"; }
    if sym == "oo_flist_retain" { return "declare void @oo_flist_retain(ptr byval(%OoFList) align 8) nounwind"; }
    if sym == "oo_flist_release" { return "declare void @oo_flist_release(ptr byval(%OoFList) align 8) nounwind"; }
    if sym == "oo_ll_I_retain" { return "declare void @oo_ll_I_retain(ptr byval(%OoLL_I) align 8) nounwind"; }
    if sym == "oo_ll_I_release" { return "declare void @oo_ll_I_release(ptr byval(%OoLL_I) align 8) nounwind"; }
    if sym == "oo_ll_S_retain" { return "declare void @oo_ll_S_retain(ptr byval(%OoLL_S) align 8) nounwind"; }
    if sym == "oo_ll_S_release" { return "declare void @oo_ll_S_release(ptr byval(%OoLL_S) align 8) nounwind"; }
    if sym == "oo_bytes_new" { return "declare void @oo_bytes_new(ptr noalias sret(%OoIList) align 8) nounwind"; }
    if sym == "oo_bytes_push" { return "declare void @oo_bytes_push(ptr noalias sret(%OoIList) align 8, ptr byval(%OoIList) align 8, i64) nounwind"; }
    if sym == "oo_bytes_to_str" { return "declare { ptr, i64 } @oo_bytes_to_str(ptr byval(%OoIList) align 8) nounwind"; }
    if sym == "oo_list_alloc_payload" { return "declare ptr @oo_list_alloc_payload(i64, i64) nounwind"; }
    if sym == "oo_list_quota_release_bytes" { return "declare void @oo_list_quota_release_bytes(i64, i64) nounwind"; }
    if sym == "oo_payload_free" { return "declare void @oo_payload_free(ptr) nounwind"; }
    return "";
}

fn ll_need_proto_sys(sym: String) -> String {
    let c: String = ll_need_proto_cap(sym);
    if c != "" { return c; }
    if sym == "crypto_sha256_internal" { return "declare { ptr, i64 } @crypto_sha256_internal({ ptr, i64 }) nounwind"; }
    if sym == "crypto_sha512_internal" { return "declare { ptr, i64 } @crypto_sha512_internal({ ptr, i64 }) nounwind"; }
    if sym == "crypto_hmac_sha256_internal" { return "declare { ptr, i64 } @crypto_hmac_sha256_internal({ ptr, i64 }, { ptr, i64 }) nounwind"; }
    if sym == "oo_path_exists" { return "declare i32 @oo_path_exists(i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_file_size" { return "declare i64 @oo_file_size(i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_env_get" { return "declare void @oo_env_get(ptr noalias sret(%OoResS) align 8, i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_sys_exec" { return "declare void @oo_sys_exec(ptr noalias sret(%OoResS) align 8, i64, i32, ptr) nounwind"; }
    if sym == "oo_sleep_ms" { return "declare void @oo_sleep_ms(i64, i64) nounwind"; }
    if sym == "oo_now_ms" { return "declare i64 @oo_now_ms(i64) nounwind"; }
    if sym == "oo_monotonic_us" { return "declare i64 @oo_monotonic_us() nounwind"; }
    if sym == "oo_alloc_bytes" { return "declare i64 @oo_alloc_bytes(i64, i64) nounwind"; }
    if sym == "oo_hot_reload" { return "declare i64 @oo_hot_reload({ ptr, i64 }) nounwind"; }
    if sym == "oo_read_file" { return "declare void @oo_read_file(ptr noalias sret(%OoResS) align 8, i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_write_file" { return "declare void @oo_write_file(ptr noalias sret(%OoResV) align 8, i64, { ptr, i64 }, { ptr, i64 }) nounwind"; }
    if sym == "oo_file_stamp" { return "declare { ptr, i64 } @oo_file_stamp(i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_fs_is_dir" { return "declare i32 @oo_fs_is_dir(i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_fs_read_dir" { return "declare void @oo_fs_read_dir(ptr noalias sret(%OoSList) align 8, i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_fs_mkdir" { return "declare void @oo_fs_mkdir(ptr noalias sret(%OoResV) align 8, i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_fs_rmdir" { return "declare void @oo_fs_rmdir(ptr noalias sret(%OoResV) align 8, i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_fs_remove_file" { return "declare void @oo_fs_remove_file(ptr noalias sret(%OoResV) align 8, i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_fs_hardlink" { return "declare void @oo_fs_hardlink(ptr noalias sret(%OoResV) align 8, i64, { ptr, i64 }, { ptr, i64 }) nounwind"; }
    if sym == "oo_fs_symlink" { return "declare void @oo_fs_symlink(ptr noalias sret(%OoResV) align 8, i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_sys_args" { return "declare void @oo_sys_args(ptr noalias sret(%OoSList) align 8, i64) nounwind"; }
    if sym == "oo_sys_exec_wait" { return "declare void @oo_sys_exec_wait(ptr noalias sret(%OoResI) align 8, i64, { ptr, i64 }, ptr byval(%OoSList) align 8) nounwind"; }
    if sym == "oo_sys_spawn" { return "declare void @oo_sys_spawn(ptr noalias sret(%OoResS) align 8, i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_sys_wait" { return "declare void @oo_sys_wait(ptr noalias sret(%OoResS) align 8, i64, i64) nounwind"; }
    if sym == "oo_sys_kill" { return "declare void @oo_sys_kill(ptr noalias sret(%OoResS) align 8, i64, i64, i64) nounwind"; }
    if sym == "oo_sys_epoll_create" { return "declare void @oo_sys_epoll_create(ptr noalias sret(%OoResS) align 8, i64, i64) nounwind"; }
    if sym == "oo_sys_inotify_init" { return "declare void @oo_sys_inotify_init(ptr noalias sret(%OoResS) align 8, i64) nounwind"; }
    if sym == "oo_sys_prctl" { return "declare void @oo_sys_prctl(ptr noalias sret(%OoResS) align 8, i64, i64) nounwind"; }
    if sym == "oo_landlock_is_available" { return "declare i32 @oo_landlock_is_available() nounwind"; }
    if sym == "oo_read_stdin" { return "declare { ptr, i64 } @oo_read_stdin(i64) nounwind"; }
    if sym == "oo_read_stdin_chunk" { return "declare void @oo_read_stdin_chunk(ptr noalias sret(%OoResS) align 8, i64, i64) nounwind"; }
    return "";
}

fn ll_need_proto_cap(sym: String) -> String {
    if chars_len(sym) >= 13 && str_slice(sym, 0, 13) == "oo_cap_grant_" {
        return "declare i64 @" + sym + "() nounwind";
    }
    return "";
}

fn ll_need_proto_tui(sym: String) -> String {
    if sym == "oo_tui_enable_raw" { return "declare void @oo_tui_enable_raw(ptr noalias sret(%OoResS) align 8, i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_tui_disable_raw" { return "declare void @oo_tui_disable_raw(ptr noalias sret(%OoResS) align 8, i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_tui_get_size" { return "declare void @oo_tui_get_size(ptr noalias sret(%OoResS) align 8, i64) nounwind"; }
    if sym == "oo_tui_alt_screen_enter" { return "declare void @oo_tui_alt_screen_enter(ptr noalias sret(%OoResS) align 8, i64) nounwind"; }
    if sym == "oo_tui_alt_screen_leave" { return "declare void @oo_tui_alt_screen_leave(ptr noalias sret(%OoResS) align 8, i64) nounwind"; }
    if sym == "oo_tui_show_cursor" { return "declare void @oo_tui_show_cursor(ptr noalias sret(%OoResS) align 8, i64, i64) nounwind"; }
    if sym == "oo_tui_clear" { return "declare void @oo_tui_clear(ptr noalias sret(%OoResS) align 8, i64) nounwind"; }
    if sym == "oo_tui_write" { return "declare void @oo_tui_write(ptr noalias sret(%OoResS) align 8, i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_tui_read_byte" { return "declare void @oo_tui_read_byte(ptr noalias sret(%OoResS) align 8, i64, { ptr, i64 }) nounwind"; }
    if sym == "oo_tui_read_byte_timeout" { return "declare void @oo_tui_read_byte_timeout(ptr noalias sret(%OoResS) align 8, i64, { ptr, i64 }, i64) nounwind"; }
    if sym == "oo_tui_signal_winch_install" { return "declare void @oo_tui_signal_winch_install(ptr noalias sret(%OoResS) align 8, i64) nounwind"; }
    if sym == "oo_tui_signal_winch_poll" { return "declare void @oo_tui_signal_winch_poll(ptr noalias sret(%OoResS) align 8, i64) nounwind"; }
    return "";
}
