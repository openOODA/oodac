// # SSA Expression Lowering Engine
//
// Logline: Lowers AST literals, variables, binary/unary expressions, and control flow branches into SSA form.
//
// Setup: Sub-pass of the AST-to-SSA lowering pipeline under openOODA compiler.
//
// Beats:
//   1. Lower primitive integer, boolean, float, and string literals.
//   2. Lower variable lookups, assignments, and binary/unary operators.
//   3. Lower function calls, println builtins, and SIMD intrinsics.
//   4. Lower match and if/else conditional expressions.

import "ssa_ir.oo";
import "ssa_lower_util.oo";
import "ssa_lower_simd.oo";
import "ast/ANCHOR.oo";

pub fn ssa_lower_expr_node(ctx: SsaLowerContext, expr: String) -> SsaLowerContext {
    let tag: String = ast_tag(expr);
    let args: String = ssa_lower_args_of(expr);
    if tag == "ELitInt" {
        let val: Int = (0 + ssa_parse_int(list_get_str(args, 0)));
        let reg: Int = ctx.next_reg;
        let c1: SsaLowerContext = ssa_ctx_emit(ctx, reg, (0 + ssa_op_const()), val);
        return ssa_ctx_set_last(c1, reg + 1, reg);
    }
    if tag == "ELitBool" {
        let val: Int = if list_get_str(args, 0) == "true" { 1 } else { 0 };
        let reg: Int = ctx.next_reg;
        let c1: SsaLowerContext = ssa_ctx_emit(ctx, reg, (0 + ssa_op_const()), val);
        return ssa_ctx_set_last(c1, reg + 1, reg);
    }
    if tag == "ELitFloat" || tag == "ELitStr" {
        let reg: Int = ctx.next_reg;
        let c1: SsaLowerContext = ssa_ctx_emit(ctx, reg, (0 + ssa_op_const()), 0);
        return ssa_ctx_set_last(c1, reg + 1, 0);
    }
    if tag == "EVar" {
        let slot: Int = (0 + ssa_sym_lookup(ctx, list_get_str(args, 0)));
        let reg: Int = ctx.next_reg;
        let c1: SsaLowerContext = ssa_ctx_emit(ctx, reg, (0 + ssa_op_load()), slot);
        return ssa_ctx_set_last(c1, reg + 1, reg);
    }
    if tag == "EBinop" {
        let op_s: String = list_get_str(args, 0);
        let l_node: String = list_get_str(args, 1);
        let r_node: String = list_get_str(args, 2);
        if op_s == "Assign" {
            let mut c1: SsaLowerContext = ssa_lower_expr_node(ctx, r_node);
            let val: Int = c1.last_val;
            let vname: String = if ast_is(l_node, "EVar") { list_get_str(ssa_lower_args_of(l_node), 0) } else { l_node };
            let slot: Int = (0 + ssa_sym_lookup(c1, vname));
            c1 = ssa_ctx_emit_lhs(c1, 0, (0 + ssa_op_store()), slot, val);
            return ssa_ctx_set_last(c1, c1.next_reg, val);
        }
        let mut c1: SsaLowerContext = ssa_lower_expr_node(ctx, l_node);
        let l_tag: String = ast_tag(l_node);
        let l_arg: String = list_get_str(ssa_lower_args_of(l_node), 0);
        let mut lhs_reg: Int = 0;
        if l_tag == "ELitInt" {
            let val: Int = (0 + ssa_parse_int(l_arg));
            let reg: Int = c1.next_reg;
            c1 = ssa_ctx_emit(c1, reg, (0 + ssa_op_const_forced()), val);
            lhs_reg = reg;
            c1 = ssa_ctx_set_last(c1, reg + 1, val);
        } else if l_tag == "ELitBool" {
            let val: Int = if l_arg == "true" { 1 } else { 0 };
            let reg: Int = c1.next_reg;
            c1 = ssa_ctx_emit(c1, reg, (0 + ssa_op_const_forced()), val);
            lhs_reg = reg;
            c1 = ssa_ctx_set_last(c1, reg + 1, val);
        } else if l_tag == "ELitStr" || l_tag == "ELitFloat" {
            let reg: Int = c1.next_reg;
            c1 = ssa_ctx_emit(c1, reg, (0 + ssa_op_const()), 0);
            lhs_reg = reg;
            c1 = ssa_ctx_set_last(c1, reg + 1, 0);
        } else {
            lhs_reg = c1.last_val;
        }
        let r_tag: String = ast_tag(r_node);
        let r_arg: String = list_get_str(ssa_lower_args_of(r_node), 0);
        let mut c2: SsaLowerContext = c1;
        let mut r_val: Int = 0;
        if r_tag == "ELitInt" {
            let val: Int = (0 + ssa_parse_int(r_arg));
            let reg: Int = c1.next_reg;
            c2 = ssa_ctx_emit(c1, reg, (0 + ssa_op_const_forced()), val);
            r_val = reg;
            c2 = ssa_ctx_set_last(c2, reg + 1, val);
        } else if r_tag == "ELitBool" {
            let val: Int = if r_arg == "true" { 1 } else { 0 };
            let reg: Int = c1.next_reg;
            c2 = ssa_ctx_emit(c1, reg, (0 + ssa_op_const_forced()), val);
            r_val = reg;
            c2 = ssa_ctx_set_last(c2, reg + 1, val);
        } else {
            c2 = ssa_lower_expr_node(c1, r_node);
            r_val = c2.last_val;
        }
        let res_reg: Int = c2.next_reg;
        let c3: SsaLowerContext = ssa_ctx_emit_lhs(c2, res_reg, ssa_map_binop(op_s), r_val, lhs_reg);
        return ssa_ctx_set_last(c3, res_reg + 1, res_reg);
    }
    if tag == "EUnop" {
        let op_s: String = list_get_str(args, 0);
        let mut c1: SsaLowerContext = ssa_lower_expr_node(ctx, list_get_str(args, 1));
        let x_val: Int = c1.last_val;
        let res_reg: Int = c1.next_reg;
        if op_s == "Neg" {
            let zero_reg: Int = c1.next_reg;
            c1 = ssa_ctx_emit(c1, zero_reg, (0 + ssa_op_const_forced()), 0);
            c1 = ssa_ctx_set_last(c1, zero_reg + 1, 0);
            let arg_reg: Int = c1.next_reg;
            c1 = ssa_ctx_emit(c1, arg_reg, (0 + ssa_op_const_forced()), x_val);
            c1 = ssa_ctx_set_last(c1, arg_reg + 1, x_val);
            let c2: SsaLowerContext = ssa_ctx_emit_lhs(c1, res_reg, (0 + ssa_op_sub()), arg_reg, zero_reg);
            return ssa_ctx_set_last(c2, res_reg + 1, res_reg);
        }
        let mut op_code: Int = (0 + ssa_op_sub());
        let mut imm_val: Int = x_val;
        if op_s == "Not" { op_code = (0 + ssa_op_xor()); imm_val = 1; }
        let c2: SsaLowerContext = ssa_ctx_emit(c1, res_reg, op_code, imm_val);
        return ssa_ctx_set_last(c2, res_reg + 1, res_reg);
    }
    if tag == "ECall" || tag == "EMethod" {
        let callee_node: String = if tag == "ECall" { list_get_str(args, 0) } else { list_get_str(args, 1) };
        let arg_str: String = if tag == "ECall" { list_get_str(args, 1) } else { list_get_str(args, 2) };
        let callee_name: String = if ast_is(callee_node, "EVar") { list_get_str(ssa_lower_args_of(callee_node), 0) } else { callee_node };
        let mut c1: SsaLowerContext = ctx;
        let n_args: Int = (0 + list_len_str(arg_str));
        let mut arg_reg: Int = 0;
        let mut first_arg_reg: Int = 0;
        let mut second_arg_reg: Int = 0;
        if n_args > 0 { let a0: String = list_get_str(arg_str, 0); if a0 != "" { c1 = ssa_lower_expr_node(c1, a0); arg_reg = c1.next_reg - 1; first_arg_reg = arg_reg; } }
        if n_args > 1 { let a1: String = list_get_str(arg_str, 1); if a1 != "" { c1 = ssa_lower_expr_node(c1, a1); arg_reg = c1.next_reg - 1; second_arg_reg = arg_reg; } }
        let mut i: Int = 2;
        while i < n_args { let a_node: String = list_get_str(arg_str, i); if a_node != "" { c1 = ssa_lower_expr_node(c1, a_node); arg_reg = c1.next_reg - 1; } i = i + 1; }
        if callee_name == "println" {
            let res_reg: Int = c1.next_reg;
            let c2: SsaLowerContext = ssa_ctx_emit(c1, res_reg, (0 + ssa_op_println_int()), first_arg_reg);
            return ssa_ctx_set_last(c2, res_reg + 1, res_reg);
        }
        if ssa_is_simd_op_name(callee_name) {
            let simd_op: Int = ssa_simd_op_code(callee_name);
            let res_reg: Int = c1.next_reg;
            let c2: SsaLowerContext = ssa_ctx_emit_lhs(c1, res_reg, simd_op, second_arg_reg, first_arg_reg);
            return ssa_ctx_set_last(c2, res_reg + 1, res_reg);
        }
        let res_reg: Int = c1.next_reg;
        let c2: SsaLowerContext = ssa_ctx_emit_lhs(c1, res_reg, (0 + ssa_op_call()), n_args, arg_reg);
        return ssa_ctx_set_last(c2, res_reg + 1, res_reg);
    }
    if tag == "EField" {
        let recv: String = list_get_str(args, 0);
        let fname: String = list_get_str(args, 1);
        let mut c1: SsaLowerContext = ssa_lower_expr_node(ctx, recv);
        let base_reg: Int = c1.last_val;
        let fidx: Int = if fname == "tag" || fname == "1" { 1 } else if fname == "2" { 2 } else { 0 };
        let res_reg: Int = c1.next_reg;
        let c2: SsaLowerContext = ssa_ctx_emit_lhs(c1, res_reg, (0 + ssa_op_extractvalue()), fidx, base_reg);
        return ssa_ctx_set_last(c2, res_reg + 1, res_reg);
    }
    return ctx;
}
