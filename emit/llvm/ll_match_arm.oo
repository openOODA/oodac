// # LLVM match arms (leaf of ll_match)
// Logline: Statement-match arm parsing, binding, and lowering.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_ir.oo";
import "ll_struct_kind.oo";
import "ll_expr.oo";
import "ll_call.oo";
import "ll_print.oo";
import "types/types_core.oo";
import "ll_stmt.oo";

pub fn ll_match_arm_head(toks: List[String], p: Int, n: Int) -> String {
    if p >= n || ll_k(toks, p) != "IDENT" {
        println("ERR\tllvm\tmatch expected arm");
        process_exit(1);
    }
    let tag: String = ll_t(toks, p);
    if tag != "Ok" && tag != "Err" && tag != "Some" && tag != "None" {
        println("ERR\tllvm\tmatch arm tag " + tag);
        process_exit(1);
    }
    let mut q: Int = p + 1;
    let mut bn: String = "_";
    if q < n && ll_k(toks, q) == "LPAREN" {
        q = q + 1;
        if q < n && ll_k(toks, q) == "IDENT" { bn = ll_t(toks, q); q = q + 1; }
        if q < n && ll_k(toks, q) == "RPAREN" { q = q + 1; }
    }
    if q >= n || ll_k(toks, q) != "FATARROW" {
        println("ERR\tllvm\tmatch expected =>");
        process_exit(1);
    }
    let np: Int = q + 1;
    return tag + "\t" + bn + "\t" + np.to_string();
}

pub fn ll_match_arm_env(env: String, bn: String, b: String) -> String {
    let mut e: String = str_slice(env, 0, chars_len(env));
    if ll_pptr(b) != "" {
        let mut bk: String = ll_pk(b);
        if ll_is_struct(bk) && str_index_of(bk, "#") < 0 {
            bk = ll_rich_of(env, str_slice(bk, 3, chars_len(bk)));
        }
        e = type_env_put(type_env_put(env, bn, bk), "__l__" + bn, ll_pptr(b));
    }
    return e;
}

pub fn ll_match_arm_body(toks: List[String], p: Int, n: Int, ssa: Int, env: String, ret_kind: String, stab: String, ir: &mut IrBuf) -> String {
    if p < n && ll_k(toks, p) == "LBRACE" {
        let b: String = ll_emit_stmts(toks, p + 1, n, ret_kind, env, ssa, stab, ir);
        let mut q: Int = ll_ppos(b);
        if q < n && ll_k(toks, q) == "RBRACE" { q = q + 1; }
        if ll_pterm(b) != 0 {
            return ll_pack(q, ll_pssa(b), ret_kind, env) + "\t1";
        }
        return ll_pack(q, ll_pssa(b), ret_kind, env);
    }
    return ll_match_single(toks, p, n, ssa, env, ret_kind, ir);
}

pub fn ll_match_single(toks: List[String], p: Int, n: Int, ssa: Int, env: String, ret_kind: String, ir: &mut IrBuf) -> String {
    if p < n && ll_k(toks, p) == "IDENT" && ll_t(toks, p) == "println" {
        let v: String = ll_expr(toks, p + 2, n, ssa, env, ir);
        let mut q: Int = ll_ppos(v);
        if q < n && ll_k(toks, q) == "RPAREN" { q = q + 1; }
        if q < n && ll_k(toks, q) == "SEMI" { q = q + 1; }
        let ns: Int = ll_print_val(ll_pk(v), ll_pssa(v), ll_pptr(v), ll_pssa(v), ir);
        return ll_pack(q, ns, ret_kind, env);
    }
    if p < n && ll_k(toks, p) == "KW_RETURN" {
        println("ERR\tllvm\tmatch single arm needs block for return");
        process_exit(1);
    }
    if p < n && ll_k(toks, p) == "IDENT" && (ll_t(toks, p) == "break" || ll_t(toks, p) == "continue") {
        println("ERR\tllvm\tmatch single arm needs block for " + ll_t(toks, p));
        process_exit(1);
    }
    if p < n && ll_k(toks, p) == "IDENT" && p + 1 < n && ll_k(toks, p + 1) == "EQ" {
        let name: String = ll_t(toks, p);
        let ty: String = type_env_get(env, name);
        let v2: String = ll_expr(toks, p + 2, n, ssa, type_env_put(env, "__e__", ty), ir);
        let mut q2: Int = ll_ppos(v2);
        let ns2: Int = ll_store(name, ty, v2, ll_pssa(v2), env, ir);
        if q2 < n && ll_k(toks, q2) == "SEMI" { q2 = q2 + 1; }
        return ll_pack(q2, ns2, ret_kind, env);
    }
    let e: String = ll_expr(toks, p, n, ssa, env, ir);
    if ll_pk(e) == "noret" {
        return ll_pack(ll_ppos(e), ll_pssa(e), ret_kind, env) + "\t1";
    }
    return ll_pack(ll_ppos(e), ll_pssa(e), ret_kind, env);
}

pub fn ll_str_match_stmt(toks: List[String], scr: String, p: Int, n: Int, env: String, ret_kind: String, stab: String, ir: &mut IrBuf) -> String {
    if p >= n || ll_k(toks, p) != "LBRACE" {
        println("ERR\tllvm\tstring-match expected {");
        process_exit(1);
    }
    let sv: String = ll_as_val(scr, ll_pssa(scr), ir);
    let ssv: Int = ll_pssa(sv);
    let id: Int = ssv + 1;
    let mut q: Int = p + 1;
    let mut arm: Int = 0;
    let mut ssa: Int = ssv;
    let mut all_term: Int = 1;
    let mut last_wild: Int = 0;
    let mut seen_wild: Int = 0;
    while q < n && ll_k(toks, q) != "RBRACE" {
        if seen_wild != 0 {
            println("ERR\tllvm\tunreachable arm after wildcard");
            process_exit(1);
        }
        let mut is_wild: Int = 0;
        let mut litpos: Int = -1;
        if ll_k(toks, q) == "STRING" {
            litpos = q;
            q = q + 1;
        } else if ll_k(toks, q) == "IDENT" && ll_t(toks, q) == "_" {
            is_wild = 1;
            q = q + 1;
        } else {
            println("ERR\tllvm\tstring-match expected STRING or _");
            process_exit(1);
        }
        if q >= n || ll_k(toks, q) != "FATARROW" {
            println("ERR\tllvm\tstring-match expected =>");
            process_exit(1);
        }
        q = q + 1;
        if is_wild != 0 { seen_wild = 1; }
        let an: String = id.to_string() + "_" + arm.to_string();
        if is_wild == 0 {
            let lp: String = ll_str_gep(toks, litpos, ssa, ir);
            ssa = ll_pssa(lp);
            let eq: Int = ssa + 1;
            ll_ir_inst(ir, "call", "i32", ll_ssa(eq), "@oo_str_eq({ ptr, i64 } " + ll_ssa(ssv) + ", { ptr, i64 } " + ll_ssa(ssa) + ")", 1, 1);
            let c: Int = eq + 1;
            ll_ir_inst(ir, "icmp ne", "i32", ll_ssa(c), ll_ssa(eq) + ", 0", 1, 1);
            ssa = c;
            ll_ir_inst(ir, "br", "i1", "", ll_ssa(c) + ", label %smA" + an + ", label %smN" + an, 1, 1);
            ll_ir_label(ir, "smA" + an);
        }
        last_wild = is_wild;
        let rb: String = ll_match_arm_body(toks, q, n, ssa, env, ret_kind, stab, ir);
        q = ll_ppos(rb);
        ssa = ll_pssa(rb);
        if ll_pterm(rb) == 0 {
            all_term = 0;
            ll_ir_inst(ir, "br", "label", "", "%smEnd" + id.to_string(), 1, 1);
        }
        if is_wild == 0 {
            ll_ir_label(ir, "smN" + an);
        }
        if q < n && ll_k(toks, q) == "COMMA" { q = q + 1; }
        arm = arm + 1;
    }
    if q < n && ll_k(toks, q) == "RBRACE" { q = q + 1; }
    if last_wild == 0 {
        ll_ir_inst(ir, "br", "label", "", "%smEnd" + id.to_string(), 1, 1);
    }
    ll_ir_label(ir, "smEnd" + id.to_string());
    if arm != 0 && all_term != 0 {
        ll_ir_inst(ir, "unreachable", "", "", "", 1, 1);
        q = ll_skip_to_rbrace(toks, q, n);
        return ll_pack(q, ssa, ret_kind, env) + "\t1";
    }
    return ll_pack(q, ssa, ret_kind, env);
}

