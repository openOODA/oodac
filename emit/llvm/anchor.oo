// # LLVM backend — typed artifact consumer
//
// Logline: Lower artifact tokens to LLVM IR. Does not import emit/c lowering.
//
// Setup: types/ and lex only. clang compiles the .ll with oodar.c.
//
// Beats:
//   1. Re-export ll_emit_stream_toks.
//   2. Fail closed on empty toks.
//   3. Dispatch emission to ll_emit pipeline.

import "ll_emit.oo";

pub fn emit_llvm_toks(toks: List[String]) {
    ll_emit_stream_toks(toks);
}
