// # Static Single Assignment Tail Call Elimination
//
// Logline: Detect `call` immediately followed by `ret` in the same basic block and emit a stub marker (op=0, imm=99) so a downstream backend pass can lower it to a real tail call.
//
// Setup: Pure graph optimization pass operating on the SsaFunction parallel-instruction representation; conservatively only annotates, never rewrites call args.
//
// Beats:
//   1. Walk all instructions; record the last-in-block index per block_id by tracking block transitions.
//   2. For each call (opcode 46), check whether the immediately following instruction is a ret (opcode 19) in the same block.
//   3. If so, emit a marker: opcode 0, imm=99 in the same block (placeholder; a future lane will lower this to `musttail call` or `tail call` with proper arg remapping).
//   4. Calls that are not at the end of their block, or whose terminator is not `ret`, are left untouched. Arg-remap rewriting is a multi-day follow-up and is explicitly out of scope for this first cut.

import "ssa_ir.oo";

fn ssa_tc_update_list_local(xs: List[Int], idx: Int, val: Int) -> List[Int] {
    let n: Int = list_len(xs);
    let mut out: List[Int] = list_new();
    let mut k: Int = 0;
    while k < n {
        if k == idx { out = list_push(out, val); } else { out = list_push(out, list_get(xs, k)); }
        k = k + 1;
    }
    return out;
}

pub fn ssa_opt_tail_call_elim(fn_data: SsaFunction) -> SsaFunction {
    let n: Int = (0 + ssa_fn_inst_count(fn_data));
    if n == 0 { return fn_data; }

    let op_call: Int = 46;
    let op_ret: Int = 19;
    let op_marker: Int = 0;
    let marker_imm: Int = 99;

    let mut new_ops: List[Int] = list_new();
    let mut new_res: List[Int] = list_new();
    let mut new_imms: List[Int] = list_new();
    let mut new_bids: List[Int] = list_new();
    let mut new_lhss: List[Int] = list_new();

    let mut i: Int = 0;
    while i < n {
        let op: Int = list_get(fn_data.inst_opcodes, i);
        let res: Int = list_get(fn_data.inst_results, i);
        let imm: Int = list_get(fn_data.inst_imm_vals, i);
        let bid: Int = list_get(fn_data.inst_block_ids, i);

        // Always copy the current instruction.
        new_ops = list_push(new_ops, op);
        new_res = list_push(new_res, res);
        new_imms = list_push(new_imms, imm);
        new_lhss = list_push(new_lhss, 0);
        new_bids = list_push(new_bids, bid);

        // Check tail-call pattern: this is a call AND the very next instruction
        // is a ret in the same block. The next instruction must exist (i+1 < n).
        if op == op_call && (i + 1) < n {
            let next_op: Int = list_get(fn_data.inst_opcodes, i + 1);
            let next_bid: Int = list_get(fn_data.inst_block_ids, i + 1);
            if next_op == op_ret && next_bid == bid {
                // Emit marker (op=0, imm=99) as a stub. We reuse `res` and `bid`
                // for the marker so it is unambiguously associated with the call
                // site; a downstream lane will look for op=0/imm=99 to lower to
                // musttail/tail call. The marker takes the place of any future
                // arg-remap metadata (which is out of scope for this first cut).
                new_ops = list_push(new_ops, op_marker);
                new_res = list_push(new_res, res);
                new_imms = list_push(new_imms, marker_imm);
                new_lhss = list_push(new_lhss, 0);
                new_bids = list_push(new_bids, bid);
            }
        }

        i = i + 1;
    }

    return SsaFunction {
        name: fn_data.name,
        return_type: fn_data.return_type,
        block_count: fn_data.block_count,
        block_names: fn_data.block_names,
        inst_opcodes: new_ops,
        inst_results: new_res,
        inst_imm_vals: new_imms,
        inst_lhs_vals: new_lhss,
        inst_block_ids: new_bids
    };
}
