// # LLVM match as a value
//
// Logline: Result/Option match-expr with expr arms or noret block arms.
//
// Setup: Tag branch to mok/merr. Expr arms phi. Block arms run statements.
//
// Beats:
//   1. Ok(s) => s plus Err(e) => e phi the payload.
//   2. Err(e) => { ... process_exit } is noret; mok value is the result.
//   3. Empty () unit already lowered in ll_expr.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_struct.oo";
import "ll_slot.oo";
import "ll_ir.oo";

pub fn ll_match_expr(toks: List[String], pos: Int, n: Int, ssa0: Int, env: String, ir: &mut IrBuf) -> String {
    let scr: String = ll_expr(toks, pos + 1, n, ssa0, env, ir);
    let mut p: Int = ll_ppos(scr);
    if p < n && ll_k(toks, p) == "LBRACE" { p = p + 1; }
    let sk: String = ll_pk(scr);
    let sp: String = ll_ensure_ptr(scr, ll_pssa(scr), ir);
    let id: Int = ll_pssa(sp) + 1;
    let cmp: Int = ll_match_tag(sk, ll_pptr(sp), ll_pssa(sp), ir);
    ll_ir_inst(ir, "br", "i1", "", ll_ssa(cmp) + ", label %mok" + id.to_string() + ", label %merr" + id.to_string(), 1, 1);
    while p < n && ll_k(toks, p) != "IDENT" { p = p + 1; }
    if p < n { p = p + 1; }
    if p < n && ll_k(toks, p) == "LPAREN" { p = p + 1; }
    let mut bn: String = "_";
    if p < n && ll_k(toks, p) == "IDENT" { bn = ll_t(toks, p); p = p + 1; }
    while p < n && ll_k(toks, p) != "FATARROW" { p = p + 1; }
    if p < n { p = p + 1; }
    ll_ir_label(ir, "mok" + id.to_string());
    let b: String = ll_match_bind(sk, ll_pptr(sp), bn, 1, id, cmp, ir);
    let mut env2: String = str_slice(env, 0, chars_len(env));
    if ll_pptr(b) != "" {
        let mut bk2: String = ll_pk(b);
        if ll_is_struct(bk2) && str_index_of(bk2, "#") < 0 {
            bk2 = ll_rich_of(env, str_slice(bk2, 3, chars_len(bk2)));
        }
        env2 = type_env_put(type_env_put(env, bn, bk2), "__l__" + bn, ll_pptr(b));
    }
    let okarm: String = ll_expr(toks, p, n, ll_pssa(b) + 1, env2, ir);
    p = ll_ppos(okarm);
    let mut oks: Int = ll_arm_val(okarm, ll_pssa(okarm), ir);
    if p < n && ll_k(toks, p) == "COMMA" { p = p + 1; }
    ll_ir_inst(ir, "br", "", "", "label %tj" + id.to_string(), 1, 1);
    ll_ir_label(ir, "tj" + id.to_string());
    ll_ir_inst(ir, "br", "", "", "label %mend" + id.to_string(), 1, 1);
    if p < n && ll_k(toks, p) == "IDENT" { p = p + 1; }
    if p < n && ll_k(toks, p) == "LPAREN" { p = p + 1; }
    let mut ebn: String = "_";
    if p < n && ll_k(toks, p) == "IDENT" { ebn = ll_t(toks, p); p = p + 1; }
    while p < n && ll_k(toks, p) != "FATARROW" { p = p + 1; }
    if p < n { p = p + 1; }
    ll_ir_label(ir, "merr" + id.to_string());
    let eb: String = ll_match_bind(sk, ll_pptr(sp), ebn, 0, id, oks, ir);
    let mut env3: String = str_slice(env, 0, chars_len(env));
    if ll_pptr(eb) != "" {
        let mut bk3: String = ll_pk(eb);
        if ll_is_struct(bk3) && str_index_of(bk3, "#") < 0 {
            bk3 = ll_rich_of(env, str_slice(bk3, 3, chars_len(bk3)));
        }
        env3 = type_env_put(type_env_put(env, ebn, bk3), "__l__" + ebn, ll_pptr(eb));
    }
    if p < n && ll_k(toks, p) == "LBRACE" {
        let bd: String = ll_emit_stmts(toks, p + 1, n, type_env_get(env, "__rk__"), env3, ll_pssa(eb) + 1, ll_struct_tab_of(env), ir);
        p = ll_ppos(bd);
        if p < n && ll_k(toks, p) == "RBRACE" { p = p + 1; }
        if p < n && ll_k(toks, p) == "COMMA" { p = p + 1; }
        if p < n && ll_k(toks, p) == "RBRACE" { p = p + 1; }
        if ll_pterm(bd) == 0 { ll_ir_inst(ir, "unreachable", "", "", "", 1, 1); }
        ll_ir_label(ir, "mend" + id.to_string());
        let pk: String = ll_pk(okarm);
        let hw: Int = ll_hw(oks, ll_pssa(bd)) + 1;
        let a: String = ll_tmpa(hw);
        ll_slot_ty(a, ll_ir_alloc(pk), ir);
        ll_ir_inst(ir, "store", ll_ir_val(pk), "", ll_ssa(oks) + ", ptr " + a + ", align 8", 1, 1);
        let s2: Int = hw + 1;
        ll_ir_inst(ir, "load", ll_ir_val(pk), ll_ssa(s2), "ptr " + a + ", align 8", 1, 1);
        return ll_pack(p, s2, pk, a);
    }
    let erarm: String = ll_expr(toks, p, n, ll_pssa(eb) + 1, env3, ir);
    p = ll_ppos(erarm);
    if ll_pk(erarm) == "noret" || ll_pterm(erarm) != 0 {
        if p < n && ll_k(toks, p) == "SEMI" { p = p + 1; }
        if p < n && ll_k(toks, p) == "COMMA" { p = p + 1; }
        if p < n && ll_k(toks, p) == "RBRACE" { p = p + 1; }
        ll_ir_label(ir, "mend" + id.to_string());
        let pk0: String = ll_pk(okarm);
        let hw0: Int = ll_hw(oks, ll_pssa(erarm)) + 1;
        let a0: String = ll_tmpa(hw0);
        ll_slot_ty(a0, ll_ir_alloc(pk0), ir);
        ll_ir_inst(ir, "store", ll_ir_val(pk0), "", ll_ssa(oks) + ", ptr " + a0 + ", align 8", 1, 1);
        let s3: Int = hw0 + 1;
        ll_ir_inst(ir, "load", ll_ir_val(pk0), ll_ssa(s3), "ptr " + a0 + ", align 8", 1, 1);
        return ll_pack(p, s3, pk0, a0);
    }
    let ers0: Int = ll_arm_val(erarm, ll_pssa(erarm), ir);
    let mut pk: String = ll_pk(okarm);
    let ek: String = ll_pk(erarm);
    let mut ers2: Int = ers0;
    if pk != ek {
        if ll_is_int(pk) && ll_is_int(ek) {
            let pkw: String = ll_int_wide(pk);
            let ekw: String = ll_int_wide(ek);
            if pkw == "i64" {
                if ekw == "i32" {
                    let ec: String = ll_int_convert(ll_pack(ll_ppos(erarm), ers0, ek, ""), ers0, pk, ir);
                    ers2 = ll_pssa(ec);
                }
            } else if ekw == "i64" {
                let oc: String = ll_int_convert(ll_pack(ll_ppos(okarm), oks, pk, ""), oks, ek, ir);
                oks = ll_pssa(oc);
                pk = ek;
            }
        } else {
            println("ERR\tllvm\tmatch arm type mismatch");
            process_exit(1);
        }
    }
    if p < n && ll_k(toks, p) == "COMMA" { p = p + 1; }
    if p < n && ll_k(toks, p) == "RBRACE" { p = p + 1; }
    ll_ir_inst(ir, "br", "", "", "label %ej" + id.to_string(), 1, 1);
    ll_ir_label(ir, "ej" + id.to_string());
    ll_ir_inst(ir, "br", "", "", "label %mend" + id.to_string(), 1, 1);
    ll_ir_label(ir, "mend" + id.to_string());
    let ph: Int = ll_hw(oks, ers2) + 1;
    ll_ir_inst(ir, "phi", ll_ir_val(pk), ll_ssa(ph), "[ " + ll_ssa(oks) + ", %tj" + id.to_string() + " ], [ " + ll_ssa(ers2) + ", %ej" + id.to_string() + " ]", 1, 1);
    return ll_pack(p, ph, pk, "");
}
