// # Struct literal lowering with field inference
//
// Logline: When a struct type isn't declared via `type X = struct { ... }`, walk the literal `X { a: ..., b: ... }` and assign sequential GEP indices; emit a default all-i64 struct definition for the IR.
//
// Setup: Pure emitter, no FS or sys. Called from llvm_emit_slit (was inlined here for size; see llvm_emit_expr.oo).
//
// Beats:
//   1. If the struct is in the stab, use declared field indices.
//   2. Otherwise count fields as we walk, deduping by name, and emit a default struct definition.
//
// RULES 1.7: <= 256 lines.

import "llvm_emit_env.oo";

import "llvm_emit_mem.oo";



pub fn llvm_struct_field_count(stab: String, sname: String) -> Int {
    let needle: String = "|" + sname + "=";
    let slen = chars_len(stab);
    let nlen = chars_len(needle);
    let mut i: Int = 0;
    while i + nlen <= slen {
        if str_slice(stab, i, i + nlen) == needle {
            let mut j: Int = i + nlen;
            let mut cnt: Int = 0;
            while j < slen && char_at(stab, j) != "|" {
                if char_at(stab, j) == "," { cnt = cnt + 1;
                }
                j = j + 1;
            }
            return cnt;
        }
        i = i + 1;
    }
    return 0;
}

fn llvm_slit_field_idx(stab: String, sname: String, fname: String, names: List[String]) -> List[String] {
    let fidx: Int = 0 + llvm_struct_field_idx(stab, sname, fname);
    let known: Int = 0 + llvm_struct_field_count(stab, sname);
    if !(fidx == 0 && known == 0) {
        return list_push(list_new(), fidx.to_string());
    }
    let mut found: Int = -1;
    let mut ki: Int = 0;
    let kn: Int = list_len(names);
    while ki < kn {
        if list_get(names, ki) == fname { found = ki;
        }
        ki = ki + 1;
    }
    if found >= 0 { return list_push(list_new(), found.to_string());
    }
    let next: Int = list_len(names);
    let mut new_names: List[String] = names;
    new_names = list_push(new_names, fname);
    let mut out: List[String] = list_new();
    out = list_push(out, next.to_string());
    let mut ni: Int = 0;
    let nn: Int = list_len(new_names);
    while ni < nn { out = list_push(out, list_get(new_names, ni));
    ni = ni + 1;
    }
    return out;
}

fn llvm_slit_emit_def(name: String, nf: Int) {
    if nf <= 0 { return;
    }
    let mut body: String = "i64";
    let mut fi: Int = 1;
    while fi < nf { body = body + ", i64";
    fi = fi + 1;
    }
    let _b: String = body;
    let _n: String = name;
    // %struct.Name already emitted once in llvm_emit_type_aliases.
}

pub fn llvm_emit_slit_full(txt: String, toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    let stab: String = llvm_env_get_var_ty(env, "__stab__");
    let mut cur_env: List[String] = env;
    let reg_res: List[String] = llvm_gen_reg(cur_env);
    let t_slot: String = list_get(reg_res, 0) + ".slit";
    cur_env = llvm_pack_env5(reg_res, 1);
    println("  " + t_slot + " = alloca %struct." + txt + ", align 8");
    let mut names: List[String] = list_new();
    let mut p_lit: Int = pos + 2;
    let mut field_count: Int = 0;
    while p_lit < n && field_at(list_get(toks, p_lit), 0) != "RBRACE" {
        if field_at(list_get(toks, p_lit), 0) == "COMMA" { p_lit = p_lit + 1;
        }
        if p_lit >= n || field_at(list_get(toks, p_lit), 0) != "IDENT" { break;
        }
        let fname: String = field_at(list_get(toks, p_lit), 3);
        p_lit = p_lit + 1;
        if p_lit < n && field_at(list_get(toks, p_lit), 0) == "COLON" { p_lit = p_lit + 1;
        }
        let f_val_res: List[String] = llvm_emit_expr(toks, p_lit, n, cur_env);
        let f_val: String = list_get(f_val_res, 0);
        let f_ty: String = list_get(f_val_res, 1);
        p_lit = parse_int(list_get(f_val_res, 2));
        cur_env = llvm_pack_env5(f_val_res, 3);
        let ires: List[String] = llvm_slit_field_idx(stab, txt, fname, names);
        let use_idx_str: String = list_get(ires, 0);
        if list_len(ires) > 1 { names = list_new();
        let mut ni: Int = 1;
        while ni < list_len(ires) { names = list_push(names, list_get(ires, ni));
        ni = ni + 1;
        }
        }
        let use_idx: Int = parse_int(use_idx_str);
        if use_idx >= field_count { field_count = use_idx + 1;
        }
        let reg_gep: List[String] = llvm_gen_reg(cur_env);
        let fptr: String = list_get(reg_gep, 0);
        cur_env = llvm_pack_env5(reg_gep, 1);
        println("  " + fptr + " = getelementptr inbounds %struct." + txt + ", %struct." + txt + "* " + t_slot + ", i32 0, i32 " + use_idx_str);
        println("  store " + f_ty + " " + f_val + ", " + f_ty + "* " + fptr + ", align 8");
    }
    if p_lit < n && field_at(list_get(toks, p_lit), 0) == "RBRACE" { p_lit = p_lit + 1;
    }
    if field_count > 0 && (0 + llvm_struct_field_count(stab, txt)) == 0 { llvm_slit_emit_def(txt, field_count);
    }
    let reg_ld: List[String] = llvm_gen_reg(cur_env);
    let t_val: String = list_get(reg_ld, 0);
    cur_env = llvm_pack_env5(reg_ld, 1);
    println("  " + t_val + " = load %struct." + txt + ", %struct." + txt + "* " + t_slot + ", align 8");
    return llvm_out_val(t_val, "%struct." + txt, p_lit, cur_env);
}
