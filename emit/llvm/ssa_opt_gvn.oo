// # Static Single Assignment Global Value Numbering
//
// Logline: Generalize CSE to commutative operations (add/mul/and/or/xor/fadd/fmul) by canonicalizing operand order when constructing the value key.
//
// Setup: Pure graph optimization pass operating on the SsaFunction parallel-instruction representation; reuses the dce use-count heuristic.
//
// Beats:
//   1. For each pure instruction, build a canonical value key: for commutative ops, swap operands so the smaller is first; for non-commutative ops, keep order.
//   2. Walk instructions; track first-occurrence (canonical_key, op, block_id) -> result_reg in parallel seen arrays.
//   3. On a duplicate value, drop the second occurrence only when its result has 0 downstream uses (safe conservative GVN, matches CSE cut).
//   4. Side-effecting opcodes are never GVN candidates (same exclusion list as ssa_opt_cse).

import "ssa_ir.oo";

fn ssa_gvn_update_list_local(xs: List[Int], idx: Int, val: Int) -> List[Int] {
    let n: Int = list_len(xs);
    let mut out: List[Int] = list_new();
    let mut k: Int = 0;
    while k < n {
        if k == idx { out = list_push(out, val); } else { out = list_push(out, list_get(xs, k)); }
        k = k + 1;
    }
    return out;
}

fn ssa_gvn_is_commutative(op: Int) -> Bool {
    // add, mul, and, or, xor are bitwise/arithmetically commutative.
    // fadd, fmul are float-commutative (NaN-signaling differs but for value-equality in GVN we treat them as commutative).
    return op == 1 || op == 3 || op == 6 || op == 7 || op == 8 || op == 25 || op == 27;
}

fn ssa_gvn_canonical_key(op: Int, imm: Int, lhs: Int) -> Int {
    // Pack op, imm, lhs into one key. For commutative ops, swap so min(imm,lhs)*100003 + max(imm,lhs).
    // We use a simple hash: op*1000003 + imm*10007 + lhs. For commutative ops, normalize imm,lhs order.
    let mut a: Int = imm;
    let mut b: Int = lhs;
    if ssa_gvn_is_commutative(op) {
        if a > b {
            let t: Int = a; a = b; b = t;
        }
    }
    return op * 1000003 + a * 10007 + b;
}

pub fn ssa_opt_gvn(fn_data: SsaFunction) -> SsaFunction {
    let n: Int = (0 + ssa_fn_inst_count(fn_data));
    if n == 0 { return fn_data; }

    // Compute use_count the same way dce/cse do. Scan inst_results for the
    // actual max result_reg (it can exceed current inst count after drops).
    let mut max_res: Int = 0;
    let mut scan_i: Int = 0;
    while scan_i < n {
        let r: Int = list_get(fn_data.inst_results, scan_i);
        if r > max_res { max_res = r; }
        scan_i = scan_i + 1;
    }
    let mut use_count: List[Int] = list_new();
    let mut uc_i: Int = 0;
    while uc_i <= max_res {
        use_count = list_push(use_count, 0);
        uc_i = uc_i + 1;
    }
    uc_i = 0;
    while uc_i < n {
        let imm: Int = list_get(fn_data.inst_imm_vals, uc_i);
        if imm > 0 && imm <= max_res {
            let c: Int = list_get(use_count, imm);
            use_count = ssa_gvn_update_list_local(use_count, imm, c + 1);
        }
        uc_i = uc_i + 1;
    }

    // Side-effecting opcodes never GVN-eligible.
    let op_alloca: Int = 14;
    let op_store: Int = 16;
    let op_br: Int = 17;
    let op_cond_br: Int = 18;
    let op_ret: Int = 19;
    let op_store_lit: Int = 21;
    let op_println_int: Int = 23;
    let op_println_str: Int = 24;
    let op_switch: Int = 53;
    let op_unreachable: Int = 54;
    let op_landingpad: Int = 55;

    let mut seen_keys: List[Int] = list_new();
    let mut seen_ops: List[Int] = list_new();
    let mut seen_bids: List[Int] = list_new();
    let mut seen_results: List[Int] = list_new();

    let mut new_ops: List[Int] = list_new();
    let mut new_res: List[Int] = list_new();
    let mut new_imms: List[Int] = list_new();
    let mut new_bids: List[Int] = list_new();
    let mut new_lhss: List[Int] = list_new();

    let mut i: Int = 0;
    while i < n {
        let op: Int = list_get(fn_data.inst_opcodes, i);
        let res: Int = list_get(fn_data.inst_results, i);
        let imm: Int = list_get(fn_data.inst_imm_vals, i);
        let lhs: Int = list_get(fn_data.inst_lhs_vals, i);
        let bid: Int = list_get(fn_data.inst_block_ids, i);

        let is_pure: Bool = (op != op_alloca) && (op != op_store) && (op != op_br) && (op != op_cond_br) && (op != op_ret) && (op != op_store_lit) && (op != op_println_int) && (op != op_println_str) && (op != op_switch) && (op != op_unreachable) && (op != op_landingpad);

        let key: Int = (0 + ssa_gvn_canonical_key(op, imm, lhs));

        // Linear scan seen list for matching (key, op, bid).
        let mut found_idx: Int = 0 - 1;
        if is_pure {
            let mut j: Int = 0;
            let seen_n: Int = list_len(seen_ops);
            while j < seen_n {
                let s_key: Int = list_get(seen_keys, j);
                let s_op: Int = list_get(seen_ops, j);
                let s_bid: Int = list_get(seen_bids, j);
                if s_key == key && s_op == op && s_bid == bid {
                    found_idx = j;
                    j = seen_n;
                } else {
                    j = j + 1;
                }
            }
        }

        if found_idx >= 0 {
            // Duplicate value found. Drop only if duplicate's result has 0 downstream uses.
            let uses: Int = list_get(use_count, res);
            if uses == 0 {
                i = i + 1;
                continue;
            }
            // Duplicate has downstream uses; can't safely rewrite. Keep it and
            // record so future identical values don't match.
            seen_keys = list_push(seen_keys, key);
            seen_ops = list_push(seen_ops, op);
            seen_bids = list_push(seen_bids, bid);
            seen_results = list_push(seen_results, res);
            new_ops = list_push(new_ops, op);
            new_res = list_push(new_res, res);
            new_imms = list_push(new_imms, imm);
            new_lhss = list_push(new_lhss, lhs);
            new_bids = list_push(new_bids, bid);
        } else {
            // First occurrence (or side-effecting op). Keep and record.
            seen_keys = list_push(seen_keys, key);
            seen_ops = list_push(seen_ops, op);
            seen_bids = list_push(seen_bids, bid);
            seen_results = list_push(seen_results, res);
            new_ops = list_push(new_ops, op);
            new_res = list_push(new_res, res);
            new_imms = list_push(new_imms, imm);
            new_lhss = list_push(new_lhss, lhs);
            new_bids = list_push(new_bids, bid);
        }
        i = i + 1;
    }

    return SsaFunction {
        name: fn_data.name,
        return_type: fn_data.return_type,
        block_count: fn_data.block_count,
        block_names: fn_data.block_names,
        inst_opcodes: new_ops,
        inst_results: new_res,
        inst_imm_vals: new_imms,
        inst_lhs_vals: new_lhss,
        inst_block_ids: new_bids
    };
}
