// # LLVM struct field store
//
// Logline: Lower `x.f = e` to getelementptr inbounds plus store. No emit/c import.
//
// Setup: Field table from ll_struct. Called from ll_emit_stmts.
//
// Beats:
//   1. Resolve the field type from the receiver kind.
//   2. Store through the field pointer, loading if the rhs is in memory.
//   3. Fail closed on an unknown field.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_struct.oo";
import "ll_slot.oo";
import "types/types_core.oo";
import "ll_ir.oo";

pub fn ll_field_tab(kind: String, m: String) -> String {
    if kind == "resi" && m == "val" { return "1:i64"; }
    if kind == "resi" && m == "err" { return "2:str"; }
    if kind == "resb" && m == "val" { return "1:i1"; }
    if kind == "resb" && m == "err" { return "2:str"; }
    if kind == "ress" && (m == "val" || m == "err") { return "1:str"; }
    if (kind == "resl" || kind == "resil") && m == "val" {
        if kind == "resil" { return "1:ilist"; }
        return "1:slist";
    }
    if (kind == "resl" || kind == "resil") && m == "err" { return "2:str"; }
    if kind == "opti" && m == "val" { return "1:i64"; }
    if kind == "opts" && m == "val" { return "1:str"; }
    if chars_len(kind) >= 6 && str_slice(kind, 0, 6) == "resSt_" && m == "val" {
        return "1:St_" + str_slice(kind, 6, chars_len(kind));
    }
    if chars_len(kind) >= 6 && str_slice(kind, 0, 6) == "resSt_" && m == "err" { return "2:str"; }
    if chars_len(kind) >= 6 && str_slice(kind, 0, 6) == "optSt_" && m == "val" {
        return "1:St_" + str_slice(kind, 6, chars_len(kind));
    }
    return "";
}

pub fn ll_field_load(kind: String, ssa: Int, ptr: String, m: String, ssa0: Int, env: String, ir: &mut IrBuf) -> String {
    let tab: String = ll_field_tab(kind, m);
    if tab == "" {
        println("ERR\tllvm\tmethod " + m + " kind " + kind);
        process_exit(1);
    }
    let ci: Int = str_index_of(tab, ":");
    let idx: String = str_slice(tab, 0, ci);
    let mut fk: String = str_slice(tab, ci + 1, chars_len(tab));
    if ll_is_struct(fk) && str_index_of(fk, "#") < 0 {
        fk = ll_rich_of(env, str_slice(fk, 3, chars_len(fk)));
    }
    let base: String = ll_ensure_ptr(ll_pack(0, ssa, kind, ptr), ssa0, ir);
    let s: Int = ll_pssa(base) + 1;
    ll_ir_inst(ir, "getelementptr inbounds", ll_ir_alloc(kind), ll_ssa(s), "ptr " + ll_pptr(base) + ", i32 0, i32 " + idx, 1, 1);
    let s2: Int = s + 1;
    ll_ir_inst(ir, "load", ll_ir_val(fk), ll_ssa(s2), "ptr " + ll_ssa(s) + ", align 8", 1, 1);
    if ll_is_agg(fk) {
        let a: String = ll_tmpa(s2 + 1);
        ll_slot_ty(a, ll_ir_alloc(fk), ir);
        ll_ir_inst(ir, "store", ll_ir_val(fk), "", ll_ssa(s2) + ", ptr " + a + ", align 8", 1, 1);
        return ll_pack(0, s2 + 1, fk, a);
    }
    return ll_pack(0, s2, fk, "");
}


