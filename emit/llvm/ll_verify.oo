// # LLVM verify-block constructors
//
// Logline: Lower verify Name { stmts } to an internal ctor gated on OODA_TEST.
//
// Setup: Mirrors C getenv("OODA_TEST") constructors via llvm.global_ctors.
// Body runs through ll_emit_stmts. No emit/c import.
//
// Beats:
//   1. Skip the optional name and require a brace block.
//   2. getenv null or empty returns without running the body.
//   3. Append a global ctor so ooda test runs the block.

import "ll_tok.oo";
import "ll_stmt.oo";
import "ll_slot.oo";
import "types/token_search.oo";
import "ll_ir.oo";

pub fn ll_emit_verify(toks: List[String], pos: Int, n: Int, stab: String, ir: &mut IrBuf) -> String {
    let mut p: Int = pos + 1;
    let mut vname: String = "anon";
    if p < n && ll_k(toks, p) == "IDENT" {
        vname = ll_t(toks, p);
        p = p + 1;
    }
    if p >= n || ll_k(toks, p) != "LBRACE" { return ll_pack(p, 0, "", ""); }
    let id: String = pos.to_string();
    let fnn: String = "oo_verify_" + vname + "_" + id;
    ll_ir_fn_open(ir, "define internal void @" + fnn + "() nounwind {");
    ll_ir_label(ir, "entry");
    ll_heap(ir);
    ll_ir_inst(ir, "call", "ptr", "%g", "@getenv(ptr @.oodatest)", 1, 1);
    ll_ir_inst(ir, "icmp eq", "ptr", "%z", "%g, null", 1, 1);
    ll_ir_inst(ir, "br", "i1", "", "%z, label %vskip" + id + ", label %vchk" + id, 1, 1);
    ll_ir_label(ir, "vchk" + id);
    ll_ir_inst(ir, "load", "i8", "%c", "ptr %g, align 1", 1, 1);
    ll_ir_inst(ir, "icmp eq", "i8", "%e", "%c, 0", 1, 1);
    ll_ir_inst(ir, "br", "i1", "", "%e, label %vskip" + id + ", label %vrun" + id, 1, 1);
    ll_ir_label(ir, "vrun" + id);
    let body: String = ll_emit_stmts(toks, p + 1, n, "void", "", 10, stab, ir);
    if ll_pterm(body) == 0 {
        ll_ir_inst(ir, "call", "void", "", "@oo_print_str(ptr getelementptr inbounds ([10 x i8], ptr @.vok, i64 0, i64 0), i64 9)", 1, 1);
        ll_ir_inst(ir, "call", "void", "", "@oo_println()", 1, 1);
        ll_ir_inst(ir, "br", "label", "", "%vskip" + id, 1, 1);
    }
    ll_ir_label(ir, "vskip" + id);
    ll_heap_end(ir);
    ll_ir_inst(ir, "ret", "void", "", "", 1, 1);
    ll_ir_fn_close(ir);
    return ll_pack(skip_balanced(toks, p), 0, fnn, "");
}

pub fn ll_emit_ctors(ctors: String, ir: &mut IrBuf) {
    if ctors == "" { return; }
    let n: Int = chars_len(ctors);
    let mut names: List[String] = list_new();
    let mut i: Int = 0;
    let mut start: Int = 0;
    while i <= n {
        if i == n || char_at(ctors, i) == "\t" {
            if i > start { names = list_push(names, str_slice(ctors, start, i)); }
            start = i + 1;
        }
        i = i + 1;
    }
    let cnt: Int = list_len(names);
    if cnt < 1 { return; }
    let mut line: String = "@llvm.global_ctors = appending global [" + cnt.to_string() + " x { i32, ptr, ptr }] [";
    let mut j: Int = 0;
    while j < cnt {
        if j > 0 { line = line + ", "; }
        line = line + "{ i32, ptr, ptr } { i32 65535, ptr @" + list_get(names, j) + ", ptr null }";
        j = j + 1;
    }
    ll_ir_text(ir, line + "]");
}
