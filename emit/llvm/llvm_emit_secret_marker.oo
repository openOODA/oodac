// # LLVM SECRET / IFC marker recognition
//
// Logline: Recognize secret directives and bare @secret lines as IFC surface markers. This is a stub — full IFC (lattice reasoning, sink refusal, NetCap integration) is a moonshot. The marker only records what the source said; it does not propagate taint.
//
// Setup: byte_at, chars_len, str_slice, list_new, list_push, list_len are in scope (stdlib + c_emit_helpers.oo). Parallel of c_is_secret_directive_line (oodac/c_emit_helpers.oo:81-120) but extended to cover the @secret annotation. The LLVM emit's SECRET gate already delegates to c_emit_secret_check.oo; this file adds a parallel LLVM-side surface for future IFC work and a smoke entry point.
//
// Beats:
//   1. is_secret_directive_line recognizes secret prefix, @secret prefix, and bare @secret.
//   2. llvm_collect_secret_markers walks src and returns one `MARKER\t<ident>` row per recognized line (empty ident = function-level marker).
//   3. llvm_emit_secret_marker_test is the public dispatch entry point. Stub: returns an empty error list.
//
// residual: full IFC propagation, sink refusal, lattice reasoning, #[Secret] attribute, NetCap integration, sticky-clear protection — all out of scope for this stub.

// True iff the (trimmed) line carries a SECRET marker. Recognizes three forms:
//   secret directive with ident
//   @secret directive with ident
//   @secret (function-level marker, no ident)
pub fn is_secret_directive_line(s: String) -> Bool {
    let n: Int = chars_len(s);
let mut i: Int = 0;
while i < n { let b: Int = byte_at(s, i);
if b == 32 || b == 9 { i = i + 1;
} else {
            break;
        }
    }
    // Must start with "//".
    if i + 1 >= n { return false;
    }
    if byte_at(s, i) != 47 || byte_at(s, i + 1) != 47 { return false;
    }
    i = i + 2;
    // Skip whitespace after "//".
    while i < n { let b2: Int = byte_at(s, i);
    if b2 == 32 || b2 == 9 { i = i + 1;
    } else {
            break;
        }
    }
    // Try "SECRET:" (7 bytes).
    if i + 7 <= n
        && byte_at(s, i) == 83
        && byte_at(s, i + 1) == 69
        && byte_at(s, i + 2) == 67
        && byte_at(s, i + 3) == 82
        && byte_at(s, i + 4) == 69
        && byte_at(s, i + 5) == 84
        && byte_at(s, i + 6) == 58 { if i + 7 == n { return true;
        }
        let fc: Int = byte_at(s, i + 7);
        if fc == 32 || fc == 9 { return true;
        }
        return false;
    }
    // Try "@secret" (7 bytes: '@', 's', 'e', 'c', 'r', 'e', 't').
    if i + 7 <= n
        && byte_at(s, i) == 64
        && byte_at(s, i + 1) == 115
        && byte_at(s, i + 2) == 101
        && byte_at(s, i + 3) == 99
        && byte_at(s, i + 4) == 114
        && byte_at(s, i + 5) == 101
        && byte_at(s, i + 6) == 116 { if i + 7 == n { return true;
        }
        let fc2: Int = byte_at(s, i + 7);
        if fc2 == 32 || fc2 == 9 { return true;
        }
        if fc2 == 58 { if i + 8 == n { return true;
        }
            let fc3: Int = byte_at(s, i + 8);
            if fc3 == 32 || fc3 == 9 { return true;
            }
        }
        return false;
    }
    return false;
}

// Walk src, split on '\n', and collect each recognized SECRET-marker line as
// a `MARKER\t<ident>` row. ident is the trailing name after SECRET: / @secret:
// (or empty for a bare `// @secret` function-level marker).
pub fn llvm_collect_secret_markers(src: String) -> List[String] {
    let mut out: List[String] = list_new();
    let total: Int = chars_len(src);
    if total == 0 { return out;
    }
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= total { let at_eol: Bool = i == total;
    let is_break: Bool = at_eol || byte_at(src, i) == 10;
    if is_break { let line = str_slice(src, start, i);
    if is_secret_directive_line(line) { let ln: Int = chars_len(line);
    let mut j: Int = 0;
    while j < ln { let b: Int = byte_at(line, j);
    if b == 32 || b == 9 { j = j + 1;
    } else {
                        break;
                    }
                }
                // Skip "//".
                if j + 1 < ln && byte_at(line, j) == 47 && byte_at(line, j + 1) == 47 { j = j + 2;
                }
                // Skip whitespace.
                while j < ln { let b2: Int = byte_at(line, j);
                if b2 == 32 || b2 == 9 { j = j + 1;
                } else {
                        break;
                    }
                }
                // Skip "SECRET" (6 bytes) or "@secret" (7 bytes).
                if j + 6 <= ln && byte_at(line, j) == 83 { j = j + 6;
                } else if j + 7 <= ln && byte_at(line, j) == 64 { j = j + 7;
                }
                // Skip optional ':' and whitespace.
                while j < ln { let b3: Int = byte_at(line, j);
                if b3 == 32 || b3 == 9 || b3 == 58 { j = j + 1;
                } else {
                        break;
                    }
                }
                // Trim trailing whitespace from ident.
                let mut end: Int = ln;
                while end > j { let b4: Int = byte_at(line, end - 1);
                if b4 == 32 || b4 == 9 { end = end - 1;
                } else {
                        break;
                    }
                }
                let ident: String = str_slice(line, j, end);
                out = list_push(out, "MARKER\t" + ident);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

// Public dispatch entry point. Stub: returns an empty error list so the
// build proceeds. The real IFC would return error rows for any taint flow
// that crosses a trust boundary (e.g. println(secret), write_file(secret)).
pub fn llvm_emit_secret_marker_test(src: String) -> List[String] {
    let mut empty: List[String] = list_new();
    return empty;
}
