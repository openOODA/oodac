// # LLVM method-call lowering
//
// Logline: Lower .method() calls: builtins, predicates, payloads, and unwrap.
//
// Setup: ll_tok and ll_ty for packs and types; sibling fns (print, tag,
//   field load, as-val) resolve through the emit closure.
//
// Beats:
//   1. Zero-arg predicates and payloads lower inline.
//   2. contains/len take one lowered argument.
//   3. unwrap branches to ok-load or message plus exit.
//   4. Match expressions lower through tag-check plus arm phis.
//

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_struct.oo";

pub fn ll_method(kind: String, ssa: Int, ptr: String, m: String, ssa0: Int, env: String, arg: String) -> String {
    if ll_is_struct(kind) {
        let fi: String = ll_struct_field(kind, m);
        if fi == "" {
            println("ERR\tllvm\tunknown field " + m);
            process_exit(1);
        }
        let fr: String = ll_struct_field_load(kind, ssa, ptr, m, ssa0);
        if ll_pptr(fr) == "" && ll_is_struct(ll_pk(fr)) {
            let a: String = ll_tmpa(ll_pssa(fr) + 1);
            println("  " + a + " = alloca " + ll_ir_alloc(ll_pk(fr)) + ", align 8");
            println("  store " + ll_ir_val(ll_pk(fr)) + " " + ll_ssa(ll_pssa(fr)) + ", ptr " + a);
            return ll_pack(0, ll_pssa(fr) + 1, ll_pk(fr), a);
        }
        return fr;
    }
    if m == "to_string" {
        if kind == "str" { return ll_pack(0, ssa, "str", ptr); }
        if kind == "f64" {
            println("ERR\tllvm\tfloat to_string needs a runtime helper");
            process_exit(1);
        }
        let mut tk: String = ll_pack(0, ssa, kind, ptr);
        if ll_is_int(kind) && kind != "i64" {
            tk = ll_int_convert(tk, ssa0, "i64");
        }
        let s: Int = ll_hw(ssa0, ll_pssa(tk)) + 1;
        println("  " + ll_ssa(s) + " = call { ptr, i64 } @oo_int_to_str(i64 " + ll_ssa(ll_pssa(tk)) + ")");
        return ll_pack(0, s, "str", "");
    }
    if m == "is_some" || m == "is_ok" || m == "is_none" || m == "is_err" {
        let s3: Int = ll_match_tag(kind, ptr, ssa0);
        if m == "is_some" || m == "is_ok" { return ll_pack(0, s3, "i1", ""); }
        let nz: Int = s3 + 1;
        println("  " + ll_ssa(nz) + " = xor i1 " + ll_ssa(s3) + ", true");
        return ll_pack(0, nz, "i1", "");
    }
    if m == "val" || m == "err" {
        return ll_field_load(kind, ssa, ptr, m, ssa0, env);
    }
    if m == "contains" {
        if ll_pk(arg) == "" || ll_pk(arg) == "empty" {
            println("ERR\tllvm\tcontains needs an argument");
            process_exit(1);
        }
        let r0: String = ll_as_val(ll_pack(0, ssa, kind, ptr), ssa0);
        let a0: String = ll_as_val(arg, ll_pssa(r0));
        let s: Int = ll_pssa(a0) + 1;
        println("  " + ll_ssa(s) + " = call i32 @oo_str_contains({ ptr, i64 } " + ll_ssa(ll_pssa(r0)) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ")");
        let s2: Int = s + 1;
        println("  " + ll_ssa(s2) + " = icmp ne i32 " + ll_ssa(s) + ", 0");
        return ll_pack(0, s2, "i1", "");
    }
    if m == "len" {
        if ll_pk(arg) == "" {
            println("ERR\tllvm\tlen needs parens");
            process_exit(1);
        }
        if kind == "str" {
            let rv: String = ll_as_val(ll_pack(0, ssa, kind, ptr), ssa0);
            let s: Int = ll_pssa(rv) + 1;
            println("  " + ll_ssa(s) + " = call i64 @oo_chars_len({ ptr, i64 } " + ll_ssa(ll_pssa(rv)) + ")");
            return ll_pack(0, s, "i64", "");
        }
        if kind == "ilist" || kind == "slist" {
            let e: String = ll_ensure_ptr(ll_pack(0, ssa, kind, ptr), ssa0);
            let s: Int = ll_pssa(e) + 1;
            if kind == "ilist" {
                println("  " + ll_ssa(s) + " = call i64 @oo_ilist_len(ptr byval(%OoIList) align 8 " + ll_pptr(e) + ")");
            } else {
                println("  " + ll_ssa(s) + " = call i64 @oo_slist_len(ptr byval(%OoSList) align 8 " + ll_pptr(e) + ")");
            }
            return ll_pack(0, s, "i64", "");
        }
        println("ERR\tllvm\tlen needs str or list");
        process_exit(1);
    }
    if m == "unwrap" {
        if kind != "resi" && kind != "ress" && kind != "resl" && kind != "opti" && kind != "opts" && !ll_is_resst(kind) && !ll_is_optst(kind) {
            println("ERR\tllvm\tunwrap needs Result or Option");
            process_exit(1);
        }
        let base: String = ll_ensure_ptr(ll_pack(0, ssa, kind, ptr), ssa0);
        let bp: String = ll_pptr(base);
        let tag: Int = ll_match_tag(kind, bp, ll_pssa(base));
        let id: Int = tag + 1;
        println("  br i1 " + ll_ssa(tag) + ", label %uok" + id.to_string() + ", label %uerr" + id.to_string());
        println("uok" + id.to_string() + ":");
        println("  br label %umerge" + id.to_string());
        println("uerr" + id.to_string() + ":");
        let ms: Int = tag + 1;
        println("  " + ll_ssa(ms) + " = getelementptr [12 x i8], ptr @.uunwrapmsg, i64 0, i64 0");
        let ml: Int = ms + 1;
        println("  " + ll_ssa(ml) + " = call { ptr, i64 } @oo_str_lit(ptr " + ll_ssa(ms) + ")");
        let pe: Int = ll_print_val("str", ml, "", ml);
        println("  call void @oo_process_exit(i64 1)");
        println("  unreachable");
        println("umerge" + id.to_string() + ":");
        let lv: String = ll_field_load(kind, ssa, bp, "val", pe, env);
        return ll_pack(0, ll_pssa(lv), ll_pk(lv), ll_pptr(lv));
    }
    if m == "unwrap_or" {
        if kind != "resi" && kind != "ress" && kind != "resl" && kind != "opti" && kind != "opts" && !ll_is_resst(kind) && !ll_is_optst(kind) {
            println("ERR\tllvm\tunwrap_or needs Result or Option");
            process_exit(1);
        }
        if ll_pk(arg) == "" || ll_pk(arg) == "empty" {
            println("ERR\tllvm\tunwrap_or needs a default");
            process_exit(1);
        }
        let mut vk: String = "i64";
        if kind == "ress" || kind == "opts" { vk = "str"; }
        if kind == "resl" { vk = "slist"; }
        if ll_is_resst(kind) || ll_is_optst(kind) {
            vk = "St_" + str_slice(kind, 6, chars_len(kind));
            let mut ak: String = ll_pk(arg);
            if ll_is_struct(ak) { ak = ll_st_basek(ak + "#"); }
            if ak != vk {
                println("ERR\tllvm\tunwrap_or default kind");
                process_exit(1);
            }
        } else if ll_pk(arg) != vk {
            println("ERR\tllvm\tunwrap_or default kind");
            process_exit(1);
        }
        let base: String = ll_ensure_ptr(ll_pack(0, ssa, kind, ptr), ssa0);
        let bp: String = ll_pptr(base);
        let tag: Int = ll_match_tag(kind, bp, ll_pssa(base));
        let dv: Int = ll_arm_val(arg, tag);
        let top: Int = ll_hw(tag, dv);
        let id: Int = top + 1;
        println("  br i1 " + ll_ssa(tag) + ", label %wok" + id.to_string() + ", label %werr" + id.to_string());
        println("wok" + id.to_string() + ":");
        let lv: String = ll_field_load(kind, ssa, bp, "val", top, env);
        let mut vs: Int = ll_pssa(lv);
        if ll_is_struct(ll_pk(lv)) && ll_pptr(lv) != "" {
            vs = vs + 1;
            println("  " + ll_ssa(vs) + " = load " + ll_ir_val(ll_pk(lv)) + ", ptr " + ll_pptr(lv));
        }
        println("  br label %wmerge" + id.to_string());
        println("werr" + id.to_string() + ":");
        println("  br label %wmerge" + id.to_string());
        println("wmerge" + id.to_string() + ":");
        let ph: Int = ll_hw(vs, dv) + 1;
        println("  " + ll_ssa(ph) + " = phi " + ll_ir_val(ll_pk(lv)) + " [ " + ll_ssa(vs) + ", %wok" + id.to_string() + " ], [ " + ll_ssa(dv) + ", %werr" + id.to_string() + " ]");
        if ll_is_struct(ll_pk(lv)) {
            let wa: String = ll_tmpa(ph + 1);
            println("  " + wa + " = alloca " + ll_ir_alloc(ll_pk(lv)) + ", align 8");
            println("  store " + ll_ir_val(ll_pk(lv)) + " " + ll_ssa(ph) + ", ptr " + wa);
            return ll_pack(0, ph + 1, ll_pk(lv), wa);
        }
        return ll_pack(0, ph, ll_pk(lv), "");
    }
    println("ERR\tllvm\tunsupported method " + m);
    process_exit(1);
    return ll_pack(0, ssa0, "i64", "");
}

pub fn ll_arm_val(arm: String, ssa0: Int) -> Int {
    if ll_pptr(arm) == "" { return ll_pssa(arm); }
    let s: Int = ll_hw(ll_pssa(arm), ssa0) + 1;
    println("  " + ll_ssa(s) + " = load " + ll_ir_val(ll_pk(arm)) + ", ptr " + ll_pptr(arm));
    return s;
}
