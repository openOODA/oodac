// # LLVM method-call lowering
//
// Logline: Lower .method() calls: builtins, predicates, payloads, and unwrap.
//
// Setup: ll_tok and ll_ty for packs and types; sibling fns (print, tag,
//   field load, as-val) resolve through the emit closure.
//
// Beats:
//   1. Zero-arg predicates and payloads lower inline.
//   2. contains/len take one lowered argument.
//   3. unwrap branches to ok-load or message plus exit.
//   4. Match expressions lower through tag-check plus arm phis.
//

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_struct.oo";
import "ll_slot.oo";
import "ll_ir.oo";
import "ll_call.oo";
import "ll_field.oo";
import "ll_print.oo";
import "ll_arc.oo";
import "ll_niche.oo";

pub fn ll_method(kind: String, ssa: Int, ptr: String, m: String, ssa0: Int, env: String, arg: String, ir: &mut IrBuf) -> String {
    if ll_is_struct(kind) {
        let mut skind: String = str_slice(kind, 0, chars_len(kind));
        let mut fi: String = ll_struct_field(skind, m);
        if fi == "" {
            skind = ll_rich_of(env, str_slice(ll_st_basek(skind), 3, chars_len(ll_st_basek(skind))));
            fi = ll_struct_field(skind, m);
        }
        if fi == "" {
            println("ERR\tllvm\tunknown field " + m);
            process_exit(1);
        }
        let fr: String = ll_struct_field_load(skind, ssa, ptr, m, ssa0, ir);
        if ll_pptr(fr) == "" && ll_is_struct(ll_pk(fr)) {
            let a: String = ll_tmpa(ll_pssa(fr) + 1);
            ll_slot_ty(a, ll_ir_alloc(ll_pk(fr)), ir);
            ll_ir_inst(ir, "store", ll_ir_val(ll_pk(fr)), "", ll_opnd(fr) + ", ptr " + a + ", align 8", 1, 1);
            return ll_pack(0, ll_pssa(fr) + 1, ll_pk(fr), a);
        }
        return fr;
    }
    if m == "to_string" {
        if kind == "str" { return ll_pack(0, ssa, "str", ptr); }
        if kind == "f64" {
            println("ERR\tllvm\tfloat to_string needs a runtime helper");
            process_exit(1);
        }
        let mut tk: String = ll_pack(0, ssa, kind, ptr);
        if ll_is_int(kind) && kind != "i64" {
            tk = ll_int_convert(tk, ssa0, "i64", ir);
        }
        let s: Int = ll_hw(ssa0, ll_pssa(tk)) + 1;
        ll_ir_inst(ir, "call", "{ ptr, i64 }", ll_ssa(s), "@oo_int_to_str(i64 " + ll_opnd(tk) + ")", 1, 1);
        return ll_pack(0, s, "str", "");
    }
    if ll_is_niche(kind) {
        let nr: String = ll_niche_method(kind, ssa, ptr, m, ssa0, arg, ir);
        if nr != "" { return nr; }
    }
    if m == "is_some" || m == "is_ok" || m == "is_none" || m == "is_err" {
        let base: String = ll_ensure_ptr(ll_pack(0, ssa, kind, str_slice(ptr, 0, chars_len(ptr))), ssa0, ir);
        let bp: String = ll_pptr(base);
        let s3: Int = ll_match_tag(kind, bp, ll_pssa(base), ir);
        if m == "is_some" || m == "is_ok" { return ll_pack(0, s3, "i1", ""); }
        let nz: Int = s3 + 1;
        ll_ir_inst(ir, "xor", "i1", ll_ssa(nz), ll_ssa(s3) + ", true", 1, 1);
        return ll_pack(0, nz, "i1", "");
    }
    if m == "val" || m == "err" {
        return ll_field_load(kind, ssa, ptr, m, ssa0, env, ir);
    }
    if m == "contains" {
        if ll_pk(arg) == "" || ll_pk(arg) == "empty" {
            println("ERR\tllvm\tcontains needs an argument");
            process_exit(1);
        }
        let r0: String = ll_as_val(ll_pack(0, ssa, kind, ptr), ssa0, ir);
        let a0: String = ll_as_val(arg, ll_pssa(r0), ir);
        let s: Int = ll_pssa(a0) + 1;
        ll_ir_inst(ir, "call", "i32", ll_ssa(s), "@oo_str_contains({ ptr, i64 } " + ll_ssa(ll_pssa(r0)) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ")", 1, 1);
        let s2: Int = s + 1;
        ll_ir_inst(ir, "icmp ne", "i32", ll_ssa(s2), ll_ssa(s) + ", 0", 1, 1);
        return ll_pack(0, s2, "i1", "");
    }
    if m == "len" {
        if ll_pk(arg) == "" {
            println("ERR\tllvm\tlen needs parens");
            process_exit(1);
        }
        if kind == "str" {
            let rv: String = ll_as_val(ll_pack(0, ssa, kind, ptr), ssa0, ir);
            let s: Int = ll_pssa(rv) + 1;
            ll_ir_inst(ir, "call", "i64", ll_ssa(s), "@oo_chars_len({ ptr, i64 } " + ll_ssa(ll_pssa(rv)) + ")", 1, 1);
            return ll_pack(0, s, "i64", "");
        }
        if kind == "ilist" || kind == "slist" {
            let e: String = ll_ensure_ptr(ll_pack(0, ssa, kind, ptr), ssa0, ir);
            let s: Int = ll_pssa(e) + 1;
            if kind == "ilist" {
                ll_ir_inst(ir, "call", "i64", ll_ssa(s), "@oo_ilist_len(ptr byval(%OoIList) align 8 " + ll_pptr(e) + ")", 1, 1);
            } else {
                ll_ir_inst(ir, "call", "i64", ll_ssa(s), "@oo_slist_len(ptr byval(%OoSList) align 8 " + ll_pptr(e) + ")", 1, 1);
            }
            return ll_pack(0, s, "i64", "");
        }
        println("ERR\tllvm\tlen needs str or list");
        process_exit(1);
    }
    if m == "unwrap" {
        if kind != "resi" && kind != "resb" && kind != "ress" && kind != "resl" && kind != "resil" && kind != "opti" && kind != "opts" && !ll_is_resst(kind) && !ll_is_optst(kind) {
            println("ERR\tllvm\tunwrap needs Result or Option");
            process_exit(1);
        }
        let base: String = ll_ensure_ptr(ll_pack(0, ssa, kind, ptr), ssa0, ir);
        let bp: String = ll_pptr(base);
        let tag: Int = ll_match_tag(kind, bp, ll_pssa(base), ir);
        let id: Int = tag + 1;
        ll_ir_inst(ir, "br", "i1", "", ll_ssa(tag) + ", label %uok" + id.to_string() + ", label %uerr" + id.to_string(), 1, 1);
        ll_ir_label(ir, "uok" + id.to_string());
        ll_ir_inst(ir, "br", "label", "", "%umerge" + id.to_string(), 1, 1);
        ll_ir_label(ir, "uerr" + id.to_string());
        let ms: Int = tag + 1;
        ll_ir_inst(ir, "getelementptr inbounds", "[12 x i8]", ll_ssa(ms), "ptr @.uunwrapmsg, i64 0, i64 0", 1, 1);
        let ml: Int = ms + 1;
        ll_ir_inst(ir, "call", "{ ptr, i64 }", ll_ssa(ml), "@oo_str_lit(ptr " + ll_ssa(ms) + ")", 1, 1);
        let pe: Int = ll_print_val("str", ml, "", ml, ir);
        ll_ir_inst(ir, "call", "void", "", "@oo_process_exit(i64 1)", 1, 1);
        ll_ir_inst(ir, "unreachable", "", "", "", 1, 1);
        ll_ir_label(ir, "umerge" + id.to_string());
        let lv: String = ll_field_load(kind, ssa, bp, "val", pe, env, ir);
        return ll_pack(0, ll_pssa(lv), ll_pk(lv), ll_pptr(lv));
    }
    if m == "unwrap_or" {
        if kind != "resi" && kind != "resb" && kind != "ress" && kind != "resl" && kind != "resil" && kind != "opti" && kind != "opts" && !ll_is_resst(kind) && !ll_is_optst(kind) {
            println("ERR\tllvm\tunwrap_or needs Result or Option");
            process_exit(1);
        }
        if ll_pk(arg) == "" || ll_pk(arg) == "empty" {
            println("ERR\tllvm\tunwrap_or needs a default");
            process_exit(1);
        }
        let mut vk: String = "i64";
        if kind == "ress" || kind == "opts" { vk = "str"; }
        if kind == "resl" { vk = "slist"; }
        if ll_is_resst(kind) || ll_is_optst(kind) {
            vk = "St_" + str_slice(kind, 6, chars_len(kind));
            let mut ak: String = ll_pk(arg);
            if ll_is_struct(ak) { ak = ll_st_basek(ak + "#"); }
            if ak != vk {
                println("ERR\tllvm\tunwrap_or default kind");
                process_exit(1);
            }
        } else if ll_pk(arg) != vk {
            println("ERR\tllvm\tunwrap_or default kind");
            process_exit(1);
        }
        let base: String = ll_ensure_ptr(ll_pack(0, ssa, kind, ptr), ssa0, ir);
        let bp: String = ll_pptr(base);
        let tag: Int = ll_match_tag(kind, bp, ll_pssa(base), ir);
        let dv: Int = ll_arm_val(arg, tag, ir);
        let top: Int = ll_hw(tag, dv);
        let id: Int = top + 1;
        ll_ir_inst(ir, "br", "i1", "", ll_ssa(tag) + ", label %wok" + id.to_string() + ", label %werr" + id.to_string(), 1, 1);
        ll_ir_label(ir, "wok" + id.to_string());
        let lv: String = ll_field_load(kind, ssa, bp, "val", top, env, ir);
        let mut vs: Int = ll_pssa(lv);
        if ll_is_struct(ll_pk(lv)) && ll_pptr(lv) != "" {
            vs = vs + 1;
            ll_ir_inst(ir, "load", ll_ir_val(ll_pk(lv)), ll_ssa(vs), "ptr " + ll_pptr(lv) + ", align 8", 1, 1);
        }
        ll_ir_inst(ir, "br", "label", "", "%wmerge" + id.to_string(), 1, 1);
        ll_ir_label(ir, "werr" + id.to_string());
        ll_ir_inst(ir, "br", "label", "", "%wmerge" + id.to_string(), 1, 1);
        ll_ir_label(ir, "wmerge" + id.to_string());
        let ph: Int = ll_hw(vs, dv) + 1;
        ll_ir_inst(ir, "phi", ll_ir_val(ll_pk(lv)), ll_ssa(ph), "[ " + ll_ssa(vs) + ", %wok" + id.to_string() + " ], [ " + ll_ssa(dv) + ", %werr" + id.to_string() + " ]", 1, 1);
        if ll_is_struct(ll_pk(lv)) {
            let wa: String = ll_tmpa(ph + 1);
            ll_slot_ty(wa, ll_ir_alloc(ll_pk(lv)), ir);
            ll_ir_inst(ir, "store", ll_ir_val(ll_pk(lv)), "", ll_ssa(ph) + ", ptr " + wa + ", align 8", 1, 1);
            return ll_pack(0, ph + 1, ll_pk(lv), wa);
        }
        return ll_pack(0, ph, ll_pk(lv), "");
    }
    println("ERR\tllvm\tunsupported method " + m);
    process_exit(1);
    return ll_pack(0, ssa0, "i64", "");
}

pub fn ll_arm_val(arm: String, ssa0: Int, ir: &mut IrBuf) -> Int {
    if ll_is_imm(arm) {
        let s: Int = ll_hw(ll_pssa(arm), ssa0) + 1;
        let a: String = ll_tmpa(s);
        ll_slot_ty(a, ll_ir_alloc(ll_pk(arm)), ir);
        ll_ir_inst(ir, "store", ll_ir_val(ll_pk(arm)), "", ll_opnd(arm) + ", ptr " + a + ", align 8", 1, 1);
        let s2: Int = s + 1;
        ll_ir_inst(ir, "load", ll_ir_val(ll_pk(arm)), ll_ssa(s2), "ptr " + a + ", align 8", 1, 1);
        return s2;
    }
    if !ll_has_slot(arm) { return ll_pssa(arm); }
    let mut s: Int = ll_hw(ll_pssa(arm), ssa0);
    if ll_arc_owned(ll_pk(arm)) && ll_is_var(ll_pptr(arm)) {
        s = ll_arc_keep_ptr(ll_pk(arm), ll_pptr(arm), s, ir);
    }
    s = s + 1;
    ll_ir_inst(ir, "load", ll_ir_val(ll_pk(arm)), ll_ssa(s), "ptr " + ll_pptr(arm) + ", align 8", 1, 1);
    return s;
}

pub fn ll_borrow_addr(toks: List[String], pos: Int, n: Int, ssa0: Int, env: String, ir: &mut IrBuf) -> String {
    let mut ap: Int = pos + 1;
    if ap < n && ll_k(toks, ap) == "KW_MUT" { ap = ap + 1; }
    if ap >= n || ll_k(toks, ap) != "IDENT" {
        println("ERR\tllvm\taddress of non-ident");
        process_exit(1);
    }
    let mut ad: String = ll_addr_ident(ll_t(toks, ap), env, ssa0, ir);
    ap = ap + 1;
    while ap + 1 < n && ll_k(toks, ap) == "DOT" && ll_k(toks, ap + 1) == "IDENT" {
        if ap + 2 < n && ll_k(toks, ap + 2) == "LPAREN" { break; }
        let fp: String = ll_struct_field_ptr(ll_pk(ad), ll_pptr(ad), ll_t(toks, ap + 1), ll_pssa(ad), ir);
        ad = ll_pack(0, ll_pssa(fp), ll_pk(fp), ll_pptr(fp));
        ap = ap + 2;
    }
    if ll_is_agg(ll_pk(ad)) || ll_is_refk(ll_pk(ad)) {
        return ll_pack(ap, ll_pssa(ad), ll_pk(ad), ll_pptr(ad));
    }
    if ll_pk(ad) == "f64" { return ll_pack(ap, ll_pssa(ad), "rf64", ll_pptr(ad)); }
    if ll_pk(ad) == "i1" || ll_pk(ad) == "bool" { return ll_pack(ap, ll_pssa(ad), "ri1", ll_pptr(ad)); }
    if ll_pk(ad) == "u64" { return ll_pack(ap, ll_pssa(ad), "ru64", ll_pptr(ad)); }
    if ll_pk(ad) == "i32" { return ll_pack(ap, ll_pssa(ad), "ri32", ll_pptr(ad)); }
    if ll_pk(ad) == "u32" { return ll_pack(ap, ll_pssa(ad), "ru32", ll_pptr(ad)); }
    if ll_pk(ad) != "i64" {
        println("ERR\tllvm\tborrow of narrow/float/bool not lowered");
        process_exit(1);
    }
    return ll_pack(ap, ll_pssa(ad), "ri64", ll_pptr(ad));
}

