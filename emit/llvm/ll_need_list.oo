// # Refine list runtime declares to ilist vs slist
//
// Logline: Drop unused oo_slist_* or oo_ilist_* after a TU-level kind scan.
//
// Setup: List[Int]/list_push INT → ilist; List[String]/STRING/args → slist.
//
// Beats:
//   1. Scan List[T] and list_push second args.
//   2. args marks slist so argv helpers stay.
//   3. Mixed or unknown keeps both.

import "ll_tok.oo";

fn ll_need_drop(need: String, name: String) -> String {
    let needle: String = "\t" + name + "\t";
    let p: Int = str_index_of(need, needle);
    if p < 0 { return need; }
    return str_slice(need, 0, p) + "\t" + str_slice(need, p + chars_len(needle), chars_len(need));
}

fn ll_need_drop_list(need: String, k: String) -> String {
    let mut n: String = need;
    n = ll_need_drop(n, "oo_" + k + "_new");
    n = ll_need_drop(n, "oo_" + k + "_len");
    n = ll_need_drop(n, "oo_" + k + "_get");
    n = ll_need_drop(n, "oo_" + k + "_push");
    n = ll_need_drop(n, "oo_" + k + "_slice");
    n = ll_need_drop(n, "oo_" + k + "_set");
    n = ll_need_drop(n, "oo_" + k + "_retain");
    n = ll_need_drop(n, "oo_" + k + "_release");
    return n;
}

fn ll_need_list_kind(toks: List[String]) -> String {
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    let mut saw_i: Bool = false;
    let mut saw_s: Bool = false;
    while i < n {
        if ll_k(toks, i) == "IDENT" {
            let nm: String = ll_t(toks, i);
            if nm == "args" { saw_s = true; }
            if nm == "List" && i + 2 < n && ll_k(toks, i + 1) == "LBRACKET" && ll_k(toks, i + 2) == "IDENT" {
                let e: String = ll_t(toks, i + 2);
                if e == "Int" { saw_i = true; }
                if e == "String" { saw_s = true; }
            }
            if nm == "list_push" && i + 1 < n && ll_k(toks, i + 1) == "LPAREN" {
                let mut d: Int = 1;
                let mut j: Int = i + 2;
                let mut commas: Int = 0;
                while j < n && d > 0 {
                    let kk: String = ll_k(toks, j);
                    if kk == "LPAREN" { d = d + 1; }
                    if kk == "RPAREN" { d = d - 1; }
                    if kk == "COMMA" && d == 1 { commas = commas + 1; }
                    if commas == 1 && d == 1 && kk != "COMMA" {
                        if kk == "INT" { saw_i = true; }
                        if kk == "STRING" { saw_s = true; }
                        commas = 2;
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    if saw_i && !saw_s { return "ilist"; }
    if saw_s && !saw_i { return "slist"; }
    return "both";
}

pub fn ll_need_refine_list(toks: List[String], need0: String) -> String {
    let lk: String = ll_need_list_kind(toks);
    if lk == "ilist" { return ll_need_drop_list(need0, "slist"); }
    if lk == "slist" { return ll_need_drop_list(need0, "ilist"); }
    return need0;
}
