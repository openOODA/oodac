// # Print structured IR records as LLVM text
//
// Logline: The only function-body LLVM printer. Consumes IrBuf records.
//
// Setup: I records are typed insts. L is a label. F/E wrap a function.
//   T is a raw line. A is a per-local alloca hoisted to entry.
//
// Beats:
//   1. Collect every A record, then print all allocas before other insts.
//   2. lifetime.start comes after the alloca prefix, not between allocas.
//   3. !dbg DILocation scope is the function DISubprogram, not the CU.

import "ll_ir.oo";
import "lex/token_fmt.oo";
import "lex/token_parse_int.oo";

fn ll_nl(s: String, i: Int) -> Int {
    let n: Int = chars_len(s);
    while i < n {
        if char_at(s, i) == "\n" { return i; }
        i = i + 1;
    }
    return n;
}

fn ll_dbg_loc(line: Int, col: Int, scope: Int) -> String {
    let mut ln: Int = line;
    let mut cn: Int = col;
    let mut sc: Int = scope;
    if ln < 1 { ln = 1; }
    if cn < 1 { cn = 1; }
    if sc < 1 { sc = 10; }
    return ", !dbg !DILocation(line: " + ln.to_string() + ", column: " + cn.to_string() + ", scope: !" + sc.to_string() + ")";
}

fn ll_t_is_label(s: String) -> Bool {
    let n: Int = chars_len(s);
    if n < 1 { return false; }
    return char_at(s, n - 1) == ":";
}

fn ll_t_is_call(s: String) -> Bool {
    if chars_len(s) > 0 && char_at(s, 0) == "@" { return false; }
    if str_index_of(s, " = call ") >= 0 { return true; }
    if str_index_of(s, "  call ") >= 0 { return true; }
    return false;
}

fn ll_fn_scope(chunk: String) -> Int {
    let p: Int = str_index_of(chunk, "!dbg !");
    if p < 0 { return 10; }
    let n: Int = chars_len(chunk);
    let e: Int = ll_nl(chunk, p);
    let digits: String = str_slice(chunk, p + 6, e);
    let mut i: Int = 0;
    let mut s: String = "";
    while i < chars_len(digits) {
        let c: String = char_at(digits, i);
        if str_index_of("0123456789", c) < 0 { break; }
        s = s + c;
        i = i + 1;
    }
    if s == "" { return 10; }
    return parse_int(s);
}

fn ll_print_t(s: String, scope: Int) {
    if ll_t_is_call(s) && str_index_of(s, "!dbg") < 0 {
        println(s + ll_dbg_loc(1, 1, scope));
        return;
    }
    println(s);
}

fn ll_print_a(ty: String, dst: String) {
    println("  " + dst + " = alloca " + ty + ", align 8");
}

fn ll_print_life(ty: String, dst: String, scope: Int) {
    let mut sz: String = "8";
    if ty == "i32" { sz = "4"; }
    if ty == "i1" { sz = "1"; }
    if chars_len(ty) >= 3 && str_slice(ty, 0, 1) == "[" { sz = "256"; }
    println("  call void @llvm.lifetime.start.p0(i64 " + sz + ", ptr " + dst + ")" + ll_dbg_loc(1, 1, scope));
}

fn ll_each_a(hold: String, life: Bool, scope: Int) {
    let n: Int = chars_len(hold);
    let mut i: Int = 0;
    while i < n {
        let e: Int = ll_nl(hold, i);
        if e > i {
            let rec: String = str_slice(hold, i, e);
            if life {
                ll_print_life(field_at(rec, 1), field_at(rec, 2), scope);
            } else {
                ll_print_a(field_at(rec, 1), field_at(rec, 2));
            }
        }
        i = e + 1;
    }
}

fn ll_dump_as(hold: String, scope: Int) {
    ll_each_a(hold, false, scope);
    ll_each_a(hold, true, scope);
}

fn ll_ir_print_i(op: String, ty: String, dst: String, args: String, line: Int, col: Int, scope: Int) {
    let comma: Bool = op == "load" || op == "alloca" || op == "getelementptr" || op == "getelementptr inbounds" || op == "extractvalue" || op == "insertelement" || op == "shufflevector";
    let mut body: String = op;
    if ty != "" { body = body + " " + ty; }
    if args != "" {
        if comma {
            body = body + ", " + args;
        } else {
            body = body + " " + args;
        }
    }
    let loc: String = ll_dbg_loc(line, col, scope);
    if dst != "" {
        println("  " + dst + " = " + body + loc);
    } else {
        println("  " + body + loc);
    }
}

fn ll_ir_print_rec(rec: String, scope: Int) {
    let k: String = field_at(rec, 0);
    if k == "T" { ll_print_t(field_at(rec, 1), scope); return; }
    if k == "L" { println(field_at(rec, 1) + ":"); return; }
    if k == "F" { println(field_at(rec, 1)); return; }
    if k == "E" { println("}"); return; }
    if k == "I" {
        ll_ir_print_i(field_at(rec, 1), field_at(rec, 2), field_at(rec, 3), field_at(rec, 4), parse_int(field_at(rec, 7)), parse_int(field_at(rec, 8)), scope);
    }
}

fn ll_is_hdr(rec: String) -> Bool {
    let k: String = field_at(rec, 0);
    if k == "L" || k == "F" { return true; }
    if k == "T" {
        let s: String = field_at(rec, 1);
        if ll_t_is_label(s) { return true; }
        if str_index_of(s, "define ") >= 0 { return true; }
    }
    return false;
}

fn ll_collect_a(chunk: String) -> String {
    let n: Int = chars_len(chunk);
    let mut i: Int = 0;
    let mut hold: String = "";
    while i < n {
        let e: Int = ll_nl(chunk, i);
        if e > i {
            let rec: String = str_slice(chunk, i, e);
            if field_at(rec, 0) == "A" { hold = hold + rec + "\n"; }
        }
        i = e + 1;
    }
    return hold;
}

fn ll_flush_fn(chunk: String) {
    let hold: String = ll_collect_a(chunk);
    let scope: Int = ll_fn_scope(chunk);
    let n: Int = chars_len(chunk);
    let mut i: Int = 0;
    let mut dumped: Bool = false;
    while i < n {
        let e: Int = ll_nl(chunk, i);
        if e > i {
            let rec: String = str_slice(chunk, i, e);
            if field_at(rec, 0) != "A" {
                if ll_is_hdr(rec) {
                    ll_ir_print_rec(rec, scope);
                } else {
                    if !dumped {
                        ll_dump_as(hold, scope);
                        dumped = true;
                    }
                    ll_ir_print_rec(rec, scope);
                }
            }
        }
        i = e + 1;
    }
    if !dumped { ll_dump_as(hold, scope); }
}

pub fn ll_ir_flush(b: &IrBuf) {
    let s: String = b.recs;
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    let mut chunk: String = "";
    while i < n {
        let e: Int = ll_nl(s, i);
        if e > i {
            let rec: String = str_slice(s, i, e);
            let k: String = field_at(rec, 0);
            let is_def: Bool = k == "F" || (k == "T" && str_index_of(field_at(rec, 1), "define ") >= 0);
            if is_def && chunk != "" {
                ll_flush_fn(chunk);
                chunk = "";
            }
            chunk = chunk + rec + "\n";
            if k == "E" || (k == "T" && field_at(rec, 1) == "}") {
                ll_flush_fn(chunk);
                chunk = "";
            }
        }
        i = e + 1;
    }
    if chunk != "" { ll_flush_fn(chunk); }
}
