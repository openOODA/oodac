// # Print structured MIR graph as LLVM text
//
// Logline: Sole function-body LLVM printer. Consumes in-memory MIR data structures.
//
// Setup: Traverses MirBlock graph and MirInst lists directly. No string parsing.
//
// Beats:
//   1. Emits top-level text and globals preceding function definitions.
//   2. Hoists all allocas to function entry block with exact lifetime.start calls.
//   3. Traverses basic blocks emitting labels and formatted instructions with debug locations.

import "mir_types.oo";
import "mir_block.oo";
import "ll_ir.oo";
import "ll_slot.oo";

fn ll_dbg_loc(line: Int, col: Int, scope: Int) -> String {
    if scope <= 0 || scope == 10 { return ""; }
    let mut ln: Int = line;
    let mut cn: Int = col;
    if ln < 1 { ln = 1; }
    if cn < 1 { cn = 1; }
    return ", !dbg !DILocation(line: " + ln.to_string() + ", column: " + cn.to_string() + ", scope: !" + scope.to_string() + ")";
}

fn ll_print_life(ty: String, dst: String, scope: Int) {
    let sz: Int = ll_slot_size(ty);
    println("  call void @llvm.lifetime.start.p0(i64 " + sz.to_string() + ", ptr " + dst + ")" + ll_dbg_loc(1, 1, scope));
}

fn ll_print_life_end(ty: String, dst: String, scope: Int) {
    let sz: Int = ll_slot_size(ty);
    println("  call void @llvm.lifetime.end.p0(i64 " + sz.to_string() + ", ptr " + dst + ")" + ll_dbg_loc(1, 1, scope));
}

fn ll_print_mir_inst(inst: MirInst, scope: Int) {
    let comma: Bool = inst.op == "load" || inst.op == "alloca" ||
        inst.op == "getelementptr" || inst.op == "getelementptr inbounds" ||
        inst.op == "extractvalue" || inst.op == "insertelement" || inst.op == "shufflevector";
    let mut body: String = inst.op;
    if inst.ty != "" { body = body + " " + inst.ty; }
    let args: String = mir_inst_format_args(inst);
    if args != "" {
        if comma {
            body = body + ", " + args;
        } else {
            body = body + " " + args;
        }
    }
    let sc: Int = if inst.scope_id > 0 { inst.scope_id } else { scope };
    let loc: String = ll_dbg_loc(inst.line, inst.col, sc);
    if inst.dst != "" {
        println("  " + inst.dst + " = " + body + loc);
    } else {
        println("  " + body + loc);
    }
}

pub fn mir_flush_fn(f: &MirFn, fn_hdr: String) {
    if fn_hdr != "" {
        println(fn_hdr);
    } else {
        let ds: String = if f.scope_id > 0 { " !dbg !" + f.scope_id.to_string() } else { "" };
        println("define " + f.vis + f.ret_ty + " @" + f.name + "(" + f.params + ") nounwind" + ds + " {");
    }

    let nb: Int = mir_fn_block_count(f);
    if nb > 0 {
        let b0: MirBlock = mir_fn_get_block(f, 0);
        if b0.label != "" { println(b0.label + ":"); }
    }

    let na: Int = list_len(f.allocas);
    let mut ai: Int = 0;
    while ai < na {
        let inst: MirInst = list_get(f.allocas, ai);
        println("  " + inst.dst + " = alloca " + inst.ty + ", align 8");
        ai = ai + 1;
    }
    ai = 0;
    while ai < na {
        let inst: MirInst = list_get(f.allocas, ai);
        ll_print_life(inst.ty, inst.dst, f.scope_id);
        ai = ai + 1;
    }

    let mut bi: Int = 0;
    while bi < nb {
        let b: MirBlock = mir_fn_get_block(f, bi);
        if bi > 0 && b.label != "" {
            println(b.label + ":");
        }
        let ni: Int = mir_block_inst_count(&b);
        let mut ii: Int = 0;
        while ii < ni {
            let inst: MirInst = mir_block_get_inst(&b, ii);
            if inst.op == "ret" {
                let mut ai_end: Int = 0;
                while ai_end < na {
                    let ainst: MirInst = list_get(f.allocas, ai_end);
                    ll_print_life_end(ainst.ty, ainst.dst, f.scope_id);
                    ai_end = ai_end + 1;
                }
            }
            ll_print_mir_inst(inst, f.scope_id);
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    println("}");
}

fn mir_parse_scope_id(hdr: String) -> Int {
    let p: Int = str_index_of(hdr, "!dbg !");
    if p < 0 { return 0; }
    let n: Int = chars_len(hdr);
    let mut i: Int = p + 6;
    let mut num: Int = 0;
    while i < n {
        let c: String = char_at(hdr, i);
        let b: Int = byte_at(c, 0);
        if b < 48 || b > 57 { break; }
        num = num * 10 + (b - 48);
        i = i + 1;
    }
    return num;
}

fn mir_parse_int(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    let mut val: Int = 0;
    while i < n {
        let b: Int = byte_at(char_at(s, i), 0);
        if b >= 48 && b <= 57 {
            val = val * 10 + (b - 48);
        }
        i = i + 1;
    }
    return val;
}

fn mir_split_lines(s: String) -> List[String] {
    let mut lines: List[String] = list_new();
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    let mut start: Int = 0;
    while i <= n {
        if i == n || char_at(s, i) == "\n" {
            if i > start {
                lines = list_push(lines, str_slice(s, start, i));
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return lines;
}

fn mir_split_tabs(line: String) -> List[String] {
    let mut parts: List[String] = list_new();
    let n: Int = chars_len(line);
    let mut i: Int = 0;
    let mut start: Int = 0;
    while i <= n {
        if i == n || char_at(line, i) == "\t" {
            parts = list_push(parts, str_slice(line, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    return parts;
}

pub fn ll_ir_flush(b: &IrBuf) {
    let lines: List[String] = mir_split_lines(b.recs);
    let total: Int = list_len(lines);
    let mut li: Int = 0;
    let mut in_fn: Bool = false;
    let mut fn_hdr: String = "";
    let mut mfn: MirFn = mir_fn_new("", "", "void", "", "", 0);
    let mut cur_block: MirBlock = mir_block_new("");

    while li < total {
        let line: String = list_get(lines, li);
        let parts: List[String] = mir_split_tabs(line);
        let nparts: Int = list_len(parts);
        if nparts > 0 {
            let tag: String = list_get(parts, 0);
            if tag == "T" {
                if in_fn {
                    println("ERR\tllvm\traw instruction in function body: " + line);
                    process_exit(1);
                }
                let text: String = if chars_len(line) >= 2 { str_slice(line, 2, chars_len(line)) } else { "" };
                println(text);
            } else if tag == "F" {
                in_fn = true;
                fn_hdr = if chars_len(line) >= 2 { str_slice(line, 2, chars_len(line)) } else { "" };
                let scope: Int = mir_parse_scope_id(fn_hdr);
                mfn = mir_fn_new("", "", "void", "", "", scope);
                cur_block = mir_block_new("");
            } else if tag == "A" {
                let ty: String = if nparts > 1 { list_get(parts, 1) } else { "i64" };
                let dst: String = if nparts > 2 { list_get(parts, 2) } else { "" };
                let empty_args: List[MirOpnd] = list_new();
                let inst: MirInst = MirInst { op: "alloca", dst: dst, ty: ty, args: empty_args, raw_args: "", line: 1, col: 1, scope_id: mfn.scope_id };
                mir_fn_add_alloca(&mut mfn, inst);
            } else if tag == "L" {
                let lbl: String = if nparts > 1 { list_get(parts, 1) } else { "" };
                if cur_block.label != "" || mir_block_inst_count(&cur_block) > 0 {
                    mir_fn_add_block(&mut mfn, cur_block);
                    cur_block = mir_block_new(lbl);
                } else {
                    cur_block.id = lbl;
                    cur_block.label = lbl;
                }
            } else if tag == "I" {
                let op: String = if nparts > 1 { list_get(parts, 1) } else { "" };
                let ty: String = if nparts > 2 { list_get(parts, 2) } else { "" };
                let dst: String = if nparts > 3 { list_get(parts, 3) } else { "" };
                let args: String = if nparts > 4 { list_get(parts, 4) } else { "" };
                let ln: Int = if nparts > 7 { mir_parse_int(list_get(parts, 7)) } else { 1 };
                let col: Int = if nparts > 8 { mir_parse_int(list_get(parts, 8)) } else { 1 };
                let empty_args2: List[MirOpnd] = list_new();
                let inst: MirInst = MirInst { op: op, dst: dst, ty: ty, args: empty_args2, raw_args: args, line: ln, col: col, scope_id: mfn.scope_id };
                mir_block_add_inst(&mut cur_block, inst);
            } else if tag == "E" {
                if cur_block.label != "" || mir_block_inst_count(&cur_block) > 0 {
                    mir_fn_add_block(&mut mfn, cur_block);
                }
                mir_flush_fn(&mfn, fn_hdr);
                in_fn = false;
            }
        }
        li = li + 1;
    }
}

pub fn mir_flush_types_stub(xs: List[MirInst], bs: List[MirBlock]) -> Int {
    return list_len(xs) + list_len(bs);
}
