// # LLVM function emit
//
// Logline: Emit main and named fns with real param types. Cap formals grant in main.
//
// Setup: Lists use sret/byval. Main is i32. Result main returns 0/1.
//
// Beats:
//   1. Parse name, params, optional arrow type into a sig string.
//   2. main grants caps. Formals copy into %v_name allocas.
//   3. Body via ll_emit_stmts.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_stmt.oo";
import "ll_ifexpr.oo";
import "ll_contract.oo";
import "ll_slot.oo";
import "ll_fn_main.oo";
import "ll_ir.oo";
import "ll_int.oo";
import "types/types_core.oo";
import "ll_range.oo";
import "lex/token_parse_int.oo";
import "ll_di.oo";

pub fn ll_fn_name_at(toks: List[String], pos: Int, n: Int) -> String {
    let mut p: Int = pos;
    while p < n && (ll_k(toks, p) == "KW_PUB" || ll_k(toks, p) == "KW_EXPORT") { p = p + 1; }
    if p < n && ll_k(toks, p) == "KW_FN" { p = p + 1; }
    if p < n && ll_k(toks, p) == "IDENT" { return ll_t(toks, p); }
    return "";
}

pub fn ll_parse_sig(toks: List[String], pos: Int, n: Int, stab: String) -> String {
    let mut p: Int = pos;
    while ll_k(toks, p) == "KW_PUB" || ll_k(toks, p) == "KW_EXPORT" { p = p + 1; }
    if ll_k(toks, p) != "KW_FN" { return ""; }
    p = p + 1;
    let name: String = ll_t(toks, p);
    p = p + 1;
    if p < n && ll_k(toks, p) == "LPAREN" { p = p + 1; }
    let mut aks: String = "";
    while p < n && ll_k(toks, p) != "RPAREN" {
        if ll_k(toks, p) == "COMMA" { p = p + 1; continue; }
        if ll_k(toks, p) == "IDENT" {
            p = p + 1;
            if p < n && ll_k(toks, p) == "COLON" {
                p = p + 1;
                let mut k: String = ll_ty_at(toks, p, n, stab);
                let h: Int = str_index_of(k, "#");
                if h >= 0 { k = str_slice(k, 0, h); }
                if aks != "" { aks = aks + ","; }
                aks = aks + k;
                p = ll_skip_type(toks, p, n);
            }
        } else {
            p = p + 1;
        }
    }
    if p < n && ll_k(toks, p) == "RPAREN" { p = p + 1; }
    let mut rk: String = "void";
    if p < n && ll_k(toks, p) == "ARROW" {
        p = p + 1;
        rk = ll_ty_at(toks, p, n, stab);
    }
    if name == "main" { rk = "main_i32"; }
    return name + "=" + aks + ">" + rk;
}

pub fn ll_is_side_effect_call(name: String) -> Bool {
    if name == "println" || name == "print" || name == "eprintln" { return true; }
    if name == "oo_println" || name == "oo_print_str" || name == "oo_print_int" { return true; }
    if name == "oo_print_bool" || name == "oo_print_double" { return true; }
    if name == "panic" || name == "process_exit" || name == "oo_process_exit" { return true; }
    if name == "write_file" || name == "sys_exec" { return true; }
    return false;
}

pub fn ll_has_side_effects(toks: List[String], p0: Int, pend: Int) -> Bool {
    let mut i: Int = p0;
    while i < pend {
        if ll_k(toks, i) == "IDENT" {
            let nm: String = ll_t(toks, i);
            if ll_is_side_effect_call(nm) { return true; }
        }
        i = i + 1;
    }
    return false;
}

pub fn ll_emit_fn(toks: List[String], pos: Int, n: Int, fenv: String, stab: String, ir: &mut IrBuf) -> Int {
    let mut p: Int = pos;
    let mut is_export: Bool = false;
    let mut is_pub: Bool = false;
    if ll_k(toks, p) == "KW_EXPORT" { is_export = true; p = p + 1; }
    if ll_k(toks, p) == "KW_PUB" { is_pub = true; p = p + 1; }
    if ll_k(toks, p) == "KW_EXPORT" { is_export = true; p = p + 1; }
    if ll_k(toks, p) != "KW_FN" { return ll_skip_fn(toks, pos, n); }
    p = p + 1;
    let name: String = ll_t(toks, p);
    p = p + 1;
    if p < n && ll_k(toks, p) == "LPAREN" { p = p + 1; }
    let mut env: String = fenv;
    env = type_env_put(env, "__fname__", name);
    let mut caps: String = "";
    let mut form: String = "";
    let mut plist: String = "";
    let mut refs: String = ";";
    let mut use_args: Bool = false;
    let mut has_mut_ref: Bool = false;
    while p < n && ll_k(toks, p) != "RPAREN" {
        if ll_k(toks, p) == "COMMA" { p = p + 1; continue; }
        if ll_k(toks, p) == "IDENT" {
            let pn: String = ll_t(toks, p);
            let ptok: Int = p;
            p = p + 1;
            if p < n && ll_k(toks, p) == "COLON" {
                p = p + 1;
                let cn: String = ll_peek_cap_name(toks, p, n);
                let g: String = ll_cap_grant(cn);
                let isref: Bool = p < n && ll_k(toks, p) == "AMP";
                let ismut: Bool = isref && p + 1 < n && ll_k(toks, p + 1) == "KW_MUT";
                if ismut { has_mut_ref = true; }
                let k: String = ll_ty_at(toks, p, n, stab);
                env = type_env_put(env, pn, k);
                if pn == "args" { use_args = true; }
                if isref { refs = refs + pn + ";"; }
                if g != "" { caps = caps + pn + "=" + g + ";"; }
                if name == "main" && str_index_of(cn, "Cap") >= 0 && g == "" {
                    println("ERR\tllvm\tunknown capability " + cn);
                    process_exit(1);
                }
                if form != "" { form = form + "\t"; }
                form = form + pn + ":" + ptok.to_string() + ":" + k;
                if name != "main" {
                    if plist != "" { plist = plist + ", "; }
                    plist = plist + ll_pass(k) + " %p_" + pn;
                }
                p = ll_skip_type(toks, p, n);
            }
        } else {
            p = p + 1;
        }
    }
    if p < n && ll_k(toks, p) == "RPAREN" { p = p + 1; }
    let mut rk: String = "void";
    if p < n && ll_k(toks, p) == "ARROW" {
        p = p + 1;
        rk = ll_ty_at(toks, p, n, stab);
        p = ll_skip_type(toks, p, n);
    }
    let ci: String = ll_contract_collect(toks, p, n, env, name);
    p = ll_ppos(ci);
    env = ll_pptr(ci);
    if p >= n { return p; }
    if ll_k(toks, p) != "LBRACE" { return p; }
    p = p + 1;
    if name == "main" {
        return ll_emit_main(toks, pos, n, p, env, caps, rk, stab, use_args, ir);
    }
    let mut vis: String = "internal ";
    if is_pub { vis = "hidden "; }
    if is_export { vis = "default "; }
    let mut gnm: String = type_env_get(fenv, "__sym__" + name);
    if gnm == "" { gnm = name; }
    let db: Int = pos + 20;
    let fn_line: Int = ll_line(toks, pos);
    ll_ir_sub(name, fn_line, db);
    let ds: String = " !dbg !" + db.to_string();
    ll_ir_set_loc(ir, fn_line, 1);
    ll_ir_set_scope(ir, db);
    let is_scalar_ret: Bool = (ll_is_int(rk) || rk == "bool" || rk == "f64") && rk != "void";
    let fn_end: Int = ll_skip_fn(toks, pos, n);
    let has_side_effects: Bool = ll_has_side_effects(toks, p, fn_end);
    let is_pure: Bool = name != "main" && caps == "" && !has_mut_ref && is_scalar_ret && !has_side_effects;
    let fn_attrs: String = if is_pure { "readonly nounwind" } else { "nounwind" };
    if ll_is_mem(rk) {
        if plist != "" {
            ll_ir_fn_open(ir, "define " + vis + "void @" + gnm + "(ptr noalias sret(" + ll_ir_alloc(rk) + ") align 8 %ret, " + plist + ") nounwind" + ds + " {");
        } else {
            ll_ir_fn_open(ir, "define " + vis + "void @" + gnm + "(ptr noalias sret(" + ll_ir_alloc(rk) + ") align 8 %ret) nounwind" + ds + " {");
        }
    } else if rk == "void" {
        ll_ir_fn_open(ir, "define " + vis + "void @" + gnm + "(" + plist + ") nounwind" + ds + " {");
    } else {
        let rk_val: String = if ll_range_is_bint(rk) { ll_range_ret_val(rk) } else if ll_is_int(rk) { "noundef " + ll_ir_val(rk) } else { ll_ir_val(rk) };
        ll_ir_fn_open(ir, "define " + vis + rk_val + " @" + gnm + "(" + plist + ") " + fn_attrs + ds + " {");
    }
    ll_heap(ir);
    let mut fi: Int = 0;
    let fnn: Int = chars_len(form);
    let mut start: Int = 0;
    let mut ssa: Int = 1;
    let mut arg_idx: Int = 1;
    while fi <= fnn {
        if fi == fnn || char_at(form, fi) == "\t" {
            if fi > start {
                let pair: String = str_slice(form, start, fi);
                let c1: Int = str_index_of(pair, ":");
                let pn: String = str_slice(pair, 0, c1);
                let rest: String = str_slice(pair, c1 + 1, chars_len(pair));
                let c2: Int = str_index_of(rest, ":");
                let ptok: Int = parse_int(str_slice(rest, 0, c2));
                let k: String = str_slice(rest, c2 + 1, chars_len(rest));
                let pln: Int = ll_line(toks, ptok);
                let vid: Int = ll_di_param_var(pn, arg_idx, db, pln, ll_di_type_id(k), ptok);
                arg_idx = arg_idx + 1;
                if str_index_of(refs, ";" + pn + ";") >= 0 && (ll_is_mem(k) || ll_is_refk(k)) {
                    env = type_env_put(env, "__l__" + pn, "%p_" + pn);
                    ll_ir_inst(ir, "call", "void", "", "@llvm.dbg.declare(metadata ptr %p_" + pn + ", metadata !" + vid.to_string() + ", metadata !DIExpression())", pln, 1);
                } else {
                    ll_slot_ty(ll_var(pn), ll_ir_alloc(k), ir);
                    ll_ir_inst(ir, "call", "void", "", "@llvm.dbg.declare(metadata ptr " + ll_var(pn) + ", metadata !" + vid.to_string() + ", metadata !DIExpression())", pln, 1);
                    if ll_is_mem(k) {
                        ssa = ssa + 1;
                        ll_ir_inst(ir, "load", ll_ir_val(k), ll_ssa(ssa), "ptr %p_" + pn + ", align 8", pln, 1);
                        ll_ir_inst(ir, "store", ll_ir_val(k), "", ll_ssa(ssa) + ", ptr " + ll_var(pn) + ", align 8", pln, 1);
                    } else if ll_is_refk(k) {
                        ll_ir_inst(ir, "store", "ptr", "", "%p_" + pn + ", ptr " + ll_var(pn) + ", align 8", pln, 1);
                    } else {
                        ll_ir_inst(ir, "store", ll_ir_val(k), "", "%p_" + pn + ", ptr " + ll_var(pn) + ", align 8", pln, 1);
                    }
                }
            }
            start = fi + 1;
        }
        fi = fi + 1;
    }
    env = type_env_put(env, "__rk__", rk);
    let ce: String = ll_contract_entry(toks, env, ssa, name, ir);
    ssa = ll_pssa(ce);
    env = ll_pptr(ce);
    let fb: String = ll_emit_stmts(toks, p, n, rk, env, ssa + 1, stab, ir);
    if ll_pterm(fb) == 0 {
        ll_heap_end(ir);
        if rk == "void" || ll_is_mem(rk) { ll_ir_inst(ir, "ret", "void", "", "", 1, 1); }
        else { ll_ir_inst(ir, "unreachable", "", "", "", 1, 1); }
    }
    ll_ir_fn_close(ir);
    return fn_end;
}
