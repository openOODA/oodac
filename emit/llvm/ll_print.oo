// # LLVM println lowering
//
// Logline: Print Int/Bool/String/Float values through oo_* helpers.
//
// Setup: Called from ll_stmt. Int constants use #imm in ptr.
//
// Beats:
//   1. i64 uses oo_print_int then println.
//   2. f64 uses ll_print_float.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_float.oo";
import "ll_ir.oo";

pub fn ll_print_val(kind: String, ssa: Int, ptr: String, ssa0: Int, ir: &mut IrBuf) -> Int {
    if kind == "f64" {
        return ll_print_float(ssa, ptr, ssa0, ir);
    }
    if kind == "i1" {
        let n2: Int = ssa0 + 1;
        let mut b: String = ll_ssa(ssa);
        if chars_len(ptr) >= 2 && char_at(ptr, 0) == "#" { b = str_slice(ptr, 1, chars_len(ptr)); }
        ll_ir_inst(ir, "zext", "i1", ll_ssa(n2), b + " to i64", 1, 1);
        return ll_print_val("i64", n2, "", n2, ir);
    }
    if kind == "str" {
        let mut s: Int = ssa;
        if ptr != "" {
            s = ssa0 + 1;
            ll_ir_inst(ir, "load", "{ ptr, i64 }", ll_ssa(s), "ptr " + ptr + ", align 8", 1, 1);
        }
        let p: Int = s + 1;
        let l: Int = s + 2;
        ll_ir_inst(ir, "extractvalue", "{ ptr, i64 } " + ll_ssa(s), ll_ssa(p), "0", 1, 1);
        ll_ir_inst(ir, "extractvalue", "{ ptr, i64 } " + ll_ssa(s), ll_ssa(l), "1", 1, 1);
        ll_ir_inst(ir, "call", "void", "", "@oo_print_str(ptr " + ll_ssa(p) + ", i64 " + ll_ssa(l) + ")", 1, 1);
        ll_ir_inst(ir, "call", "void", "", "@oo_println()", 1, 1);
        return l;
    }
    if kind == "i64" {
        let mut arg: String = ll_ssa(ssa);
        if chars_len(ptr) >= 2 && char_at(ptr, 0) == "#" { arg = str_slice(ptr, 1, chars_len(ptr)); }
        ll_ir_inst(ir, "call", "void", "", "@oo_print_int(i64 " + arg + ")", 1, 1);
        ll_ir_inst(ir, "call", "void", "", "@oo_println()", 1, 1);
        return ssa0;
    }
    if ll_is_int(kind) {
        let e: String = ll_int_convert(ll_pack(0, ssa, kind, ptr), ssa0, "i64", ir);
        return ll_print_val("i64", ll_pssa(e), "", ll_pssa(e), ir);
    }
    println("ERR\tllvm\tprint kind " + kind);
    process_exit(1);
    return ssa0;
}
