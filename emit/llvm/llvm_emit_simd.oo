pub fn llvm_emit_simd_insertelement(vec_ty: String, vec_val: String, elem_val: String, idx_val: String, env: List[String]) -> List[String] {
    let reg_res: List[String] = llvm_gen_reg(env);
    let treg: String = list_get(reg_res, 0);
    let cur_env: List[String] = llvm_simd_pack_env(reg_res);
    let lty: String = llvm_simd_ty_map(vec_ty);
    let ety: String = llvm_simd_elem_ty(lty);
    println("  " + treg + " = insertelement " + lty + " " + vec_val + ", " + ety + " " + elem_val + ", i32 " + idx_val);
    return llvm_simd_make_out(treg, lty, cur_env);
}

pub fn llvm_emit_simd_extractelement(vec_ty: String, vec_val: String, idx_val: String, env: List[String]) -> List[String] {
