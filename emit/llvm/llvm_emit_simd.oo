// # Lower SIMD Vector Types and Operations to LLVM IR
//
// Logline: Lowers explicit vector types (Vec4f, Vec8f, Vec4i, Vec8i, Vec16b) and vector intrinsics (fadd, fmul, fsub, fdiv, fma, shufflevector, insertelement, extractelement) to LLVM IR.
//
// Setup: Vector arithmetic, extraction, insertion, and shuffle expressions are prepared for LLVM IR vector code generation.
//
// Beats:
//   1. Map explicit SIMD vector types to LLVM vector representations (<4 x float>, <8 x float>, <4 x i32>, <8 x i32>, <16 x i8>).
//   2. Lower vector arithmetic intrinsics (fadd, fsub, fmul, fdiv, add, sub, mul, sdiv, fma).
//   3. Lower vector element manipulation (insertelement, extractelement, splat, zero).
//   4. Lower vector shuffle and swizzle intrinsics (shufflevector) for AVX2 and NEON acceleration.


import "llvm_emit_ty.oo";

import "llvm_emit_env.oo";


pub fn llvm_simd_is_vec_ty(t: String) -> Bool {
    if t == "Vec4f" || t == "<4 x float>" || t == "vec4f" { return true;
    }
    if t == "Vec8f" || t == "<8 x float>" || t == "vec8f" { return true;
    }
    if t == "Vec4i" || t == "<4 x i32>" || t == "vec4i" { return true;
    }
    if t == "Vec8i" || t == "<8 x i32>" || t == "vec8i" { return true;
    }
    if t == "Vec16b" || t == "<16 x i8>" || t == "vec16b" { return true;
    }
    return false;
}

pub fn llvm_simd_ty_map(t: String) -> String {
    if t == "Vec4f" || t == "<4 x float>" || t == "vec4f" { return "<4 x float>";
    }
    if t == "Vec8f" || t == "<8 x float>" || t == "vec8f" { return "<8 x float>";
    }
    if t == "Vec4d" || t == "<4 x double>" || t == "vec4d" { return "<4 x double>";
    }
    if t == "Vec4i" || t == "<4 x i32>" || t == "vec4i" { return "<4 x i32>";
    }
    if t == "Vec8i" || t == "<8 x i32>" || t == "vec8i" { return "<8 x i32>";
    }
    if t == "Vec16b" || t == "<16 x i8>" || t == "vec16b" { return "<16 x i8>";
    }
    return llvm_ty_map(t);
}

pub fn llvm_simd_elem_ty(vec_ty: String) -> String {
    if vec_ty == "<4 x float>" || vec_ty == "<8 x float>" || vec_ty == "Vec4f" || vec_ty == "Vec8f" { return "float";
    }
    if vec_ty == "<4 x double>" || vec_ty == "Vec4d" { return "double";
    }
    if vec_ty == "<4 x i32>" || vec_ty == "<8 x i32>" || vec_ty == "Vec4i" || vec_ty == "Vec8i" { return "i32";
    }
    if vec_ty == "<16 x i8>" || vec_ty == "Vec16b" { return "i8";
    }
    return "i64";
}

pub fn llvm_simd_lane_count(vec_ty: String) -> Int {
    if vec_ty == "<4 x float>" || vec_ty == "<4 x i32>" || vec_ty == "Vec4f" || vec_ty == "Vec4i" { return 4;
    }
    if vec_ty == "<8 x float>" || vec_ty == "<8 x i32>" || vec_ty == "Vec8f" || vec_ty == "Vec8i" { return 8;
    }
    if vec_ty == "<4 x double>" || vec_ty == "Vec4d" { return 4;
    }
    if vec_ty == "<16 x i8>" || vec_ty == "Vec16b" { return 16;
    }
    return 1;
}

fn llvm_simd_pack_env(src: List[String]) -> List[String] {
    let mut e: List[String] = list_new();
    let mut i: Int = 1;
    while i <= 5 { e = list_push(e, list_get(src, i));
    i = i + 1;
    }
    return e;
}

fn llvm_simd_make_out(treg: String, ty: String, env: List[String]) -> List[String] {
    let mut o: List[String] = list_new();
    o = list_push(o, treg);
    o = list_push(o, ty);
    let mut i: Int = 0;
    while i < 5 { o = list_push(o, list_get(env, i));
    i = i + 1;
    }
    return o;
}

pub fn llvm_emit_simd_fadd(vec_ty: String, lhs: String, rhs: String, env: List[String]) -> List[String] {
    let reg_res: List[String] = llvm_gen_reg(env);
    let treg: String = list_get(reg_res, 0);
    let cur_env: List[String] = llvm_simd_pack_env(reg_res);
    let lty: String = llvm_simd_ty_map(vec_ty);
    println("  " + treg + " = fadd " + lty + " " + lhs + ", " + rhs);
    return llvm_simd_make_out(treg, lty, cur_env);
}

pub fn llvm_emit_simd_fsub(vec_ty: String, lhs: String, rhs: String, env: List[String]) -> List[String] {
    let reg_res: List[String] = llvm_gen_reg(env);
    let treg: String = list_get(reg_res, 0);
    let cur_env: List[String] = llvm_simd_pack_env(reg_res);
    let lty: String = llvm_simd_ty_map(vec_ty);
    println("  " + treg + " = fsub " + lty + " " + lhs + ", " + rhs);
    return llvm_simd_make_out(treg, lty, cur_env);
}

