pub fn llvm_emit_simd_fdiv(vec_ty: String, lhs: String, rhs: String, env: List[String]) -> List[String] {
    let reg_res: List[String] = llvm_gen_reg(env);
    let treg: String = list_get(reg_res, 0);
    let cur_env: List[String] = llvm_simd_pack_env(reg_res);
    let lty: String = llvm_simd_ty_map(vec_ty);
    println("  " + treg + " = fdiv " + lty + " " + lhs + ", " + rhs);
    return llvm_simd_make_out(treg, lty, cur_env);
}

pub fn llvm_emit_simd_fma(vec_ty: String, a: String, b: String, c: String, env: List[String]) -> List[String] {
    let r: List[String] = llvm_gen_reg(env);
    let t: String = list_get(r, 0);
    let e: List[String] = llvm_simd_pack_env(r);
    let lty: String = llvm_simd_ty_map(vec_ty);
    let fnm: String = "llvm.fma." + lty;
    println("  " + t + " = call " + lty + " @" + fnm + "(" + lty + " " + a + ", " + lty + " " + b + ", " + lty + " " + c + ")");
    return llvm_simd_make_out(t, lty, e);
}

