    println("  " + treg + " = extractelement " + lty + " " + vec_val + ", i32 " + idx_val);
    return llvm_simd_make_out(treg, ety, cur_env);
}

pub fn llvm_emit_simd_shufflevector(vec_ty: String, v1_val: String, v2_val: String, mask_ty: String, mask_val: String, env: List[String]) -> List[String] {
    let reg_res: List[String] = llvm_gen_reg(env);
    let treg: String = list_get(reg_res, 0);
    let cur_env: List[String] = llvm_simd_pack_env(reg_res);
    let lty: String = llvm_simd_ty_map(vec_ty);
    let mty: String = llvm_simd_ty_map(mask_ty);
    println("  " + treg + " = shufflevector " + lty + " " + v1_val + ", " + lty + " " + v2_val + ", " + mty + " " + mask_val);
    return llvm_simd_make_out(treg, lty, cur_env);
}
