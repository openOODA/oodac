// # LLVM main function body
//
// Logline: hidden i32 main; cap grants; argv List only if args is bound.
//
// Setup: Called from ll_emit_fn after the signature walk.
//
// Beats:
//   1. Per-local allocas in entry. Caps are i64 slots.
//   2. No oo_slist argv construction when args is unused.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_stmt.oo";
import "ll_slot.oo";
import "ll_tok.oo";
import "ll_ir.oo";
import "types/types_core.oo";

pub fn ll_emit_main(toks: List[String], pos: Int, n: Int, p: Int, env0: String, caps: String, rk: String, stab: String, use_args: Bool, ir: &mut IrBuf) -> Int {
    let mut env: String = env0;
    let db: Int = pos + 20;
    let fn_line: Int = ll_line(toks, pos);
    ll_ir_sub("main", fn_line, db);
    ll_ir_set_loc(ir, fn_line, 1);
    ll_ir_set_scope(ir, db);
    ll_ir_fn_open(ir, "define hidden i32 @main(i32 noundef %argc, ptr nocapture noundef %argv) nounwind !dbg !" + db.to_string() + " {");
    ll_ir_label(ir, "entry");
    ll_heap(ir);
    let mut i: Int = 0;
    let cn: Int = chars_len(caps);
    while i < cn {
        if char_at(caps, i) == "=" {
            let mut s: Int = i;
            while s > 0 && char_at(caps, s - 1) != ";" { s = s - 1; }
            let nm: String = str_slice(caps, s, i);
            let mut e: Int = i + 1;
            while e < cn && char_at(caps, e) != ";" { e = e + 1; }
            let suf: String = str_slice(caps, i + 1, e);
            ll_slot_ty(ll_var(nm), "i64", ir);
            ll_ir_inst(ir, "call", "i64", "%g_" + nm, "@oo_cap_grant_" + suf + "()", 1, 1);
            ll_ir_inst(ir, "store", "i64", "", "%g_" + nm + ", ptr " + ll_var(nm) + ", align 8", 1, 1);
        }
        i = i + 1;
    }
    if use_args {
        ll_slot_ty("%v_args", "%OoSList", ir);
        ll_ir_inst(ir, "call", "void", "", "@oo_slist_new(ptr sret(%OoSList) align 8 %v_args)", 1, 1);
        ll_ir_inst(ir, "br", "label", "", "%args0", 1, 1);
        ll_ir_label(ir, "args0");
        ll_ir_inst(ir, "phi", "i32", "%ai", "[ 1, %entry ], [ %ai2, %args1 ]", 1, 1);
        ll_ir_inst(ir, "icmp slt", "i32", "%acmp", "%ai, %argc", 1, 1);
        ll_ir_inst(ir, "br", "i1", "", "%acmp, label %args1, label %args2", 1, 1);
        ll_ir_label(ir, "args1");
        ll_ir_inst(ir, "getelementptr inbounds", "ptr", "%ap", "ptr %argv, i32 %ai", 1, 1);
        ll_ir_inst(ir, "load", "ptr", "%astr", "ptr %ap, align 8", 1, 1);
        ll_ir_inst(ir, "call", "{ ptr, i64 }", "%alit", "@oo_str_lit(ptr %astr)", 1, 1);
        ll_slot_ty("%anew", "%OoSList", ir);
        ll_ir_inst(ir, "call", "void", "", "@oo_slist_push(ptr sret(%OoSList) align 8 %anew, ptr byval(%OoSList) align 8 %v_args, { ptr, i64 } %alit)", 1, 1);
        ll_ir_inst(ir, "load", "%OoSList", "%acpy", "ptr %anew, align 8", 1, 1);
        ll_ir_inst(ir, "store", "%OoSList", "", "%acpy, ptr %v_args, align 8", 1, 1);
        ll_ir_inst(ir, "add", "i32", "%ai2", "%ai, 1", 1, 1);
        ll_ir_inst(ir, "br", "label", "", "%args0", 1, 1);
        ll_ir_label(ir, "args2");
        env = type_env_put(env, "args", "slist");
        env = type_env_put(env, "__l__args", "%v_args");
    }
    let mut mrk: String = "main_i32";
    if rk == "resi" { mrk = "resim"; }
    if rk == "opti" { mrk = "optim"; }
    if rk == "opts" { mrk = "optsm"; }
    env = type_env_put(env, "__rk__", mrk);
    if type_env_get(env, "__creq__") != "" || type_env_get(env, "__cens__") != "" {
        println("ERR\tllvm\tcontracts on main not lowered");
        process_exit(1);
    }
    let mb: String = ll_emit_stmts(toks, p, n, mrk, env, 10, stab, ir);
    if ll_pterm(mb) == 0 { ll_heap_end(ir); ll_ir_inst(ir, "ret", "i32", "", "0", 1, 1); }
    ll_ir_fn_close(ir);
    return ll_skip_fn(toks, pos, n);
}
