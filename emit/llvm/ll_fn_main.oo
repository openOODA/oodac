// # LLVM main function body
//
// Logline: hidden i32 main; cap grants; argv List only if args is bound.
//
// Setup: Called from ll_emit_fn after the signature walk.
//
// Beats:
//   1. Per-local allocas in entry. Caps are i64 slots.
//   2. No oo_slist argv construction when args is unused.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_stmt.oo";
import "ll_slot.oo";
import "ll_ir.oo";
import "types/types_core.oo";

pub fn ll_emit_main(toks: List[String], pos: Int, n: Int, p: Int, env0: String, caps: String, rk: String, stab: String, use_args: Bool, ir: &mut IrBuf) -> Int {
    let mut env: String = env0;
    let db: Int = pos + 20;
    ll_ir_sub("main", pos, db);
    ll_ir_text(ir, "define hidden i32 @main(i32 noundef %argc, ptr nocapture noundef %argv) nounwind !dbg !" + db.to_string() + " {");
    ll_ir_text(ir, "entry:");
    ll_heap(ir);
    let mut i: Int = 0;
    let cn: Int = chars_len(caps);
    while i < cn {
        if char_at(caps, i) == "=" {
            let mut s: Int = i;
            while s > 0 && char_at(caps, s - 1) != ";" { s = s - 1; }
            let nm: String = str_slice(caps, s, i);
            let mut e: Int = i + 1;
            while e < cn && char_at(caps, e) != ";" { e = e + 1; }
            let suf: String = str_slice(caps, i + 1, e);
            ll_slot_ty(ll_var(nm), "i64", ir);
            ll_ir_text(ir, "  %g_" + nm + " = call i64 @oo_cap_grant_" + suf + "()");
            ll_ir_text(ir, "  store i64 %g_" + nm + ", ptr " + ll_var(nm) + ", align 8");
        }
        i = i + 1;
    }
    if use_args {
        ll_slot_ty("%v_args", "%OoSList", ir);
        ll_ir_text(ir, "  call void @oo_slist_new(ptr sret(%OoSList) align 8 %v_args)");
        ll_ir_text(ir, "  br label %args0");
        ll_ir_text(ir, "args0:");
        ll_ir_text(ir, "  %ai = phi i32 [ 1, %entry ], [ %ai2, %args1 ]");
        ll_ir_text(ir, "  %acmp = icmp slt i32 %ai, %argc");
        ll_ir_text(ir, "  br i1 %acmp, label %args1, label %args2");
        ll_ir_text(ir, "args1:");
        ll_ir_text(ir, "  %ap = getelementptr inbounds ptr, ptr %argv, i32 %ai");
        ll_ir_text(ir, "  %astr = load ptr, ptr %ap, align 8");
        ll_ir_text(ir, "  %alit = call { ptr, i64 } @oo_str_lit(ptr %astr)");
        ll_slot_name("%anew", ir);
        ll_ir_text(ir, "  call void @oo_slist_push(ptr sret(%OoSList) align 8 %anew, ptr byval(%OoSList) align 8 %v_args, { ptr, i64 } %alit)");
        ll_ir_text(ir, "  %acpy = load %OoSList, ptr %anew, align 8");
        ll_ir_text(ir, "  store %OoSList %acpy, ptr %v_args, align 8");
        ll_ir_text(ir, "  %ai2 = add i32 %ai, 1");
        ll_ir_text(ir, "  br label %args0");
        ll_ir_text(ir, "args2:");
        env = type_env_put(env, "args", "slist");
        env = type_env_put(env, "__l__args", "%v_args");
    }
    let mut mrk: String = "main_i32";
    if rk == "resi" { mrk = "resim"; }
    if rk == "opti" { mrk = "optim"; }
    if rk == "opts" { mrk = "optsm"; }
    env = type_env_put(env, "__rk__", mrk);
    if type_env_get(env, "__creq__") != "" || type_env_get(env, "__cens__") != "" {
        println("ERR\tllvm\tcontracts on main not lowered");
        process_exit(1);
    }
    let mb: String = ll_emit_stmts(toks, p, n, mrk, env, 10, stab, ir);
    if ll_pterm(mb) == 0 { ll_heap_end(ir); ll_ir_text(ir, "  ret i32 0"); }
    ll_ir_text(ir, "}");
    return ll_skip_fn(toks, pos, n);
}
