// # LLVM token row helpers
//
// Logline: Kind and text from TSV rows. Skip types, parens, braces. Pack expr results.
//
// Setup: field_at from lex. skip_balanced from types/token_search. parse_int for packed pos.
//
// Beats:
//   1. ll_k and ll_t read kind and text.
//   2. ll_skip_type walks IDENT List[T] AMP types.
//   3. ll_pack holds pos, ssa, kind, and optional alloca ptr.

import "lex/token_fmt.oo";
import "lex/token_parse_int.oo";
import "types/token_search.oo";

pub fn ll_k(toks: List[String], i: Int) -> String {
    if i < 0 || i >= list_len(toks) { return ""; }
    return field_at(list_get(toks, i), 0);
}

pub fn ll_t(toks: List[String], i: Int) -> String {
    if i < 0 || i >= list_len(toks) { return ""; }
    return field_at(list_get(toks, i), 3);
}

pub fn ll_skip_type(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    if p < n && ll_k(toks, p) == "AMP" { p = p + 1; }
    if p < n && ll_k(toks, p) == "KW_MUT" { p = p + 1; }
    if p >= n { return p; }
    if ll_k(toks, p) != "IDENT" { return p; }
    p = p + 1;
    if p < n && ll_k(toks, p) == "LBRACKET" {
        let mut d: Int = 1;
        p = p + 1;
        while p < n && d > 0 {
            let k: String = ll_k(toks, p);
            if k == "LBRACKET" { d = d + 1; }
            if k == "RBRACKET" { d = d - 1; }
            p = p + 1;
        }
    }
    return p;
}

pub fn ll_skip_fn(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    while ll_k(toks, p) == "KW_PUB" || ll_k(toks, p) == "KW_EXPORT" { p = p + 1; }
    if ll_k(toks, p) != "KW_FN" { return p + 1; }
    p = p + 1;
    if p < n && ll_k(toks, p) == "IDENT" { p = p + 1; }
    while p < n && ll_k(toks, p) != "LBRACE" {
        if ll_k(toks, p) == "SEMI" { return p + 1; }
        p = p + 1;
    }
    if p < n && ll_k(toks, p) == "LBRACE" {
        return skip_balanced(toks, p);
    }
    return p;
}

pub fn ll_pack(pos: Int, ssa: Int, kind: String, ptr: String) -> String {
    return pos.to_string() + "\t" + ssa.to_string() + "\t" + kind + "\t" + ptr;
}

pub fn ll_ppos(r: String) -> Int {
    return parse_int(field_at(r, 0));
}

pub fn ll_pssa(r: String) -> Int {
    return parse_int(field_at(r, 1));
}

pub fn ll_pk(r: String) -> String {
    return field_at(r, 2);
}

pub fn ll_pptr(r: String) -> String {
    return field_at(r, 3);
}

pub fn ll_ssa(n: Int) -> String {
    return "%t" + n.to_string();
}

pub fn ll_var(name: String) -> String {
    return "%v_" + name;
}

pub fn ll_tmpa(n: Int) -> String {
    return "%a" + n.to_string();
}

pub fn ll_hw(a: Int, b: Int) -> Int {
    if a > b { return a; }
    return b;
}

pub fn ll_st_map(s: String, a: String, b: String) -> String {
    let n: Int = chars_len(s); let mut o: String = ""; let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == a { o = o + b; } else { o = o + c; }
        i = i + 1;
    }
    return o;
}

pub fn ll_struct_tab_of(env: String) -> String {
    let n: Int = chars_len(env); let mut o: String = ""; let mut i: Int = 0;
    while i < n {
        let at: Bool = i == 0 || char_at(env, i - 1) == ";";
        if at && i + 6 <= n && str_slice(env, i, i + 6) == "__stf_" {
            let mut k: Int = i;
            while k < n && char_at(env, k) != ";" { k = k + 1; }
            o = o + str_slice(env, i, k) + ";";
            i = k;
        } else if at && i + 6 <= n && str_slice(env, i, i + 6) == "__st__" {
            let mut k: Int = i;
            while k < n && char_at(env, k) != ";" { k = k + 1; }
            o = o + str_slice(env, i, k) + ";";
            i = k;
        }
        i = i + 1;
    }
    return o;
}

pub fn ll_stab_rich(stab: String, t: String) -> String {
    let pre: String = "__stf__" + t + "."; let pl: Int = chars_len(pre);
    let n: Int = chars_len(stab); let mut rich: String = ""; let mut first: Bool = true;
    let mut j: Int = 0;
    while j < n {
        if j + pl <= n && str_slice(stab, j, j + pl) == pre {
            let mut k: Int = j + pl;
            while k < n && char_at(stab, k) != "=" { k = k + 1; }
            let fld: String = str_slice(stab, j + pl, k);
            k = k + 1;
            let mut m: Int = k;
            while m < n && char_at(stab, m) != ";" { m = m + 1; }
            let val: String = str_slice(stab, k, m);
            let ci: Int = str_index_of(val, ":");
            if ci >= 0 {
                if !first { rich = rich + ","; }
                rich = rich + fld + ":" + ll_st_map(str_slice(val, ci + 1, chars_len(val)), ",", "|");
                first = false;
            }
            j = m;
        }
        j = j + 1;
    }
    if first { return ""; }
    return "St_" + t + "#" + rich;
}

pub fn ll_pterm(r: String) -> Int {
    if field_at(r, 4) == "1" { return 1; }
    return 0;
}

pub fn ll_arm_split(toks: List[String], lb: Int, n: Int) -> String {
    let mut d: Int = 0;
    let mut i: Int = lb;
    let mut rb: Int = -1;
    while i < n {
        let k: String = ll_k(toks, i);
        if k == "LBRACE" { d = d + 1; }
        if k == "RBRACE" {
            d = d - 1;
            if d == 0 { rb = i; break; }
        }
        i = i + 1;
    }
    if rb < 0 {
        println("ERR\tllvm\tunbalanced arm");
        process_exit(1);
    }
    let mut j: Int = rb - 1;
    let mut dd: Int = 0;
    let mut ls: Int = -1;
    while j > lb {
        let k2: String = ll_k(toks, j);
        if k2 == "RBRACE" || k2 == "RPAREN" || k2 == "RBRACKET" { dd = dd + 1; }
        else if k2 == "LBRACE" || k2 == "LPAREN" || k2 == "LBRACKET" { dd = dd - 1; }
        else if k2 == "SEMI" && dd == 0 { ls = j; break; }
        j = j - 1;
    }
    let lb1: Int = lb + 1;
    if ls < 0 {
        return rb.to_string() + "\t" + lb1.to_string() + "\t0";
    }
    let es: Int = ls + 1;
    return rb.to_string() + "\t" + es.to_string() + "\t1";
}

pub fn ll_skip_to_rbrace(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    let mut d: Int = 0;
    while p < n {
        let k: String = ll_k(toks, p);
        if k == "LBRACE" { d = d + 1; }
        if k == "RBRACE" {
            if d == 0 { return p; }
            d = d - 1;
        }
        if k == "EOF" { return p; }
        p = p + 1;
    }
    return p;
}
