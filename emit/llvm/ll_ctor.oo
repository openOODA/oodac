// # LLVM Ok/Err/Some/None constructors
//
// Logline: Wrap payload into Option/Result aggregates. Refuse unknown kinds.
//
// Setup: expect is __e__ from let or return. Aggregates live in allocas.
//
// Beats:
//   1. None requires opti or opts.
//   2. Some/Ok/Err wrap Int or String payloads only.
//   3. Result return copies a wrapped resi; bare i64 is ERR.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_struct.oo";

fn ll_resst_base(expect: String) -> String {
    if chars_len(expect) >= 6 && str_slice(expect, 0, 6) == "resSt_" {
        return str_slice(expect, 6, chars_len(expect));
    }
    return "";
}

fn ll_optst_base(expect: String) -> String {
    if chars_len(expect) >= 6 && str_slice(expect, 0, 6) == "optSt_" {
        return str_slice(expect, 6, chars_len(expect));
    }
    return "";
}

fn ll_struct_base_of(ak: String) -> String {
    let hh: Int = str_index_of(ak, "#");
    if hh < 0 { return str_slice(ak, 3, chars_len(ak)); }
    return str_slice(ak, 3, hh);
}

pub fn ll_ret_resi(v: String, ssa0: Int) -> Int {
    if ll_pk(v) != "resi" {
        println("ERR\tllvm\tResult return must be Ok or Err");
        process_exit(1);
    }
    let p: String = ll_ensure_ptr(v, ssa0);
    let s: Int = ll_pssa(p) + 1;
    println("  " + ll_ssa(s) + " = load %OoResI, ptr " + ll_pptr(p));
    println("  store %OoResI " + ll_ssa(s) + ", ptr %ret");
    println("  ret void");
    return s;
}

pub fn ll_ret_opt(v: String, kind: String, ssa0: Int) -> Int {
    if ll_pk(v) != kind {
        println("ERR\tllvm\tOption return must match fn kind");
        process_exit(1);
    }
    let p: String = ll_ensure_ptr(v, ssa0);
    let s: Int = ll_pssa(p) + 1;
    println("  " + ll_ssa(s) + " = load " + ll_ir_alloc(kind) + ", ptr " + ll_pptr(p));
    println("  store " + ll_ir_alloc(kind) + " " + ll_ssa(s) + ", ptr %ret");
    println("  ret void");
    return s;
}

pub fn ll_ret_resim(v: String, ssa0: Int) -> Int {
    if ll_pk(v) != "resi" {
        println("ERR\tllvm\tResult main must return Ok or Err");
        process_exit(1);
    }
    let p: String = ll_ensure_ptr(v, ssa0);
    let s: Int = ll_pssa(p) + 1;
    println("  " + ll_ssa(s) + " = getelementptr %OoResI, ptr " + ll_pptr(p) + ", i32 0, i32 0");
    let s2: Int = s + 1;
    println("  " + ll_ssa(s2) + " = load i32, ptr " + ll_ssa(s));
    let s3: Int = s2 + 1;
    println("  " + ll_ssa(s3) + " = icmp eq i32 " + ll_ssa(s2) + ", 0");
    let s4: Int = s3 + 1;
    println("  " + ll_ssa(s4) + " = zext i1 " + ll_ssa(s3) + " to i32");
    println("  ret i32 " + ll_ssa(s4));
    return s4;
}

pub fn ll_ctor(name: String, arg: String, ssa0: Int, expect: String) -> String {
    if name == "None" {
        let nb: String = ll_optst_base(expect);
        if nb != "" {
            let a: String = ll_tmpa(ssa0 + 1);
            let s: Int = ssa0 + 1;
            println("  " + a + " = alloca %OoOpt_St_" + nb + ", align 8");
            println("  store %OoOpt_St_" + nb + " { i32 0, %St_" + nb + " zeroinitializer }, ptr " + a);
            return ll_pack(0, s, expect, a);
        }
        if expect != "opti" && expect != "opts" {
            println("ERR\tllvm\tNone type");
            process_exit(1);
        }
        let a: String = ll_tmpa(ssa0 + 1);
        let s: Int = ssa0 + 1;
        println("  " + a + " = alloca " + ll_ir_alloc(expect) + ", align 8");
        if expect == "opts" {
            println("  store %OoOptS { i32 0, %OoStr { ptr null, i64 0 } }, ptr " + a);
        } else {
            println("  store %OoOptI { i32 0, i64 0 }, ptr " + a);
        }
        return ll_pack(0, s, expect, a);
    }
    if name == "Some" { return ll_ctor_some(arg, ssa0, expect); }
    if name == "Ok" { return ll_ctor_ok(arg, ssa0, expect); }
    if name == "Err" { return ll_ctor_err(arg, ssa0, expect); }
    println("ERR\tllvm\tctor " + name);
    process_exit(1);
    return arg;
}

fn ll_oostr_from_pair(pair: Int) -> Int {
    let s0: Int = pair + 1;
    println("  " + ll_ssa(s0) + " = extractvalue { ptr, i64 } " + ll_ssa(pair) + ", 0");
    let s1: Int = s0 + 1;
    println("  " + ll_ssa(s1) + " = extractvalue { ptr, i64 } " + ll_ssa(pair) + ", 1");
    let s2: Int = s1 + 1;
    println("  " + ll_ssa(s2) + " = insertvalue %OoStr { ptr null, i64 0 }, ptr " + ll_ssa(s0) + ", 0");
    let s3: Int = s2 + 1;
    println("  " + ll_ssa(s3) + " = insertvalue %OoStr " + ll_ssa(s2) + ", i64 " + ll_ssa(s1) + ", 1");
    return s3;
}

fn ll_ctor_some(arg: String, ssa0: Int, expect: String) -> String {
    let sav: String = ll_int_convert(arg, ssa0, "i64");
    let sab: Int = ll_hw(ssa0, ll_pssa(sav));
    if ll_pk(sav) == "i64" && (expect == "opti" || expect == "") {
        let a: String = ll_tmpa(sab + 1);
        let s: Int = sab + 1;
        println("  " + a + " = alloca %OoOptI, align 8");
        let s2: Int = s + 1;
        println("  " + ll_ssa(s2) + " = insertvalue %OoOptI { i32 1, i64 0 }, i64 " + ll_ssa(ll_pssa(sav)) + ", 1");
        println("  store %OoOptI " + ll_ssa(s2) + ", ptr " + a);
        return ll_pack(0, s2, "opti", a);
    }
    if ll_pk(arg) == "str" && (expect == "opts" || expect == "") {
        let av: String = ll_as_val(arg, ssa0);
        let a: String = ll_tmpa(ll_pssa(av) + 1);
        println("  " + a + " = alloca %OoOptS, align 8");
        let os: Int = ll_oostr_from_pair(ll_pssa(av));
        let s2: Int = os + 1;
        println("  " + ll_ssa(s2) + " = insertvalue %OoOptS { i32 1, %OoStr { ptr null, i64 0 } }, %OoStr " + ll_ssa(os) + ", 1");
        println("  store %OoOptS " + ll_ssa(s2) + ", ptr " + a);
        return ll_pack(0, s2, "opts", a);
    }
    if ll_is_struct(ll_pk(arg)) {
        let mut rb: String = ll_optst_base(expect);
        if rb == "" { rb = ll_struct_base_of(ll_pk(arg)); }
        if rb != "" && (expect == "optSt_" + rb || expect == "") {
            let av: String = ll_as_val(arg, ssa0);
            let a: String = ll_tmpa(ll_pssa(av) + 1);
            println("  " + a + " = alloca %OoOpt_St_" + rb + ", align 8");
            let os: Int = ll_pssa(av) + 1;
            println("  " + ll_ssa(os) + " = insertvalue %OoOpt_St_" + rb + " { i32 1, %St_" + rb + " zeroinitializer }, %St_" + rb + " " + ll_ssa(ll_pssa(av)) + ", 1");
            println("  store %OoOpt_St_" + rb + " " + ll_ssa(os) + ", ptr " + a);
            return ll_pack(0, os, "optSt_" + rb, a);
        }
    }
    println("ERR\tllvm\tSome kind");
    process_exit(1);
    return arg;
}

fn ll_ctor_ok(arg: String, ssa0: Int, expect: String) -> String {
    let oav: String = ll_int_convert(arg, ssa0, "i64");
    let oab: Int = ll_hw(ssa0, ll_pssa(oav));
    if ll_pk(oav) == "i64" && (expect == "resi" || expect == "resim" || expect == "") {
        let a: String = ll_tmpa(oab + 1);
        let s: Int = oab + 1;
        println("  " + a + " = alloca %OoResI, align 8");
        let s2: Int = s + 1;
        println("  " + ll_ssa(s2) + " = insertvalue %OoResI { i32 1, i64 0, %OoStr { ptr null, i64 0 } }, i64 " + ll_ssa(ll_pssa(oav)) + ", 1");
        println("  store %OoResI " + ll_ssa(s2) + ", ptr " + a);
        return ll_pack(0, s2, "resi", a);
    }
    if ll_pk(arg) == "str" && (expect == "ress" || expect == "") {
        let av: String = ll_as_val(arg, ssa0);
        let a: String = ll_tmpa(ll_pssa(av) + 1);
        println("  " + a + " = alloca %OoResS, align 8");
        let os: Int = ll_oostr_from_pair(ll_pssa(av));
        let s2: Int = os + 1;
        println("  " + ll_ssa(s2) + " = insertvalue %OoResS { i32 1, %OoStr { ptr null, i64 0 } }, %OoStr " + ll_ssa(os) + ", 1");
        println("  store %OoResS " + ll_ssa(s2) + ", ptr " + a);
        return ll_pack(0, s2, "ress", a);
    }
    if ll_is_struct(ll_pk(arg)) {
        let mut rb: String = ll_resst_base(expect);
        if rb == "" {
            let ak: String = ll_pk(arg);
            let hh: Int = str_index_of(ak, "#");
            if hh < 0 { rb = str_slice(ak, 3, chars_len(ak)); }
            else { rb = str_slice(ak, 3, hh); }
        }
        if rb != "" {
            let av: String = ll_as_val(arg, ssa0);
            let a: String = ll_tmpa(ll_pssa(av) + 1);
            println("  " + a + " = alloca %OoRes_St_" + rb + ", align 8");
            let os: Int = ll_pssa(av) + 1;
            println("  " + ll_ssa(os) + " = insertvalue %OoRes_St_" + rb + " { i32 1, %St_" + rb + " zeroinitializer, %OoStr { ptr null, i64 0 } }, %St_" + rb + " " + ll_ssa(ll_pssa(av)) + ", 1");
            println("  store %OoRes_St_" + rb + " " + ll_ssa(os) + ", ptr " + a);
            return ll_pack(0, os, "resSt_" + rb, a);
        }
    }
    println("ERR\tllvm\tOk kind");
    process_exit(1);
    return arg;
}

fn ll_ctor_err(arg: String, ssa0: Int, expect: String) -> String {
    if ll_pk(arg) != "str" {
        println("ERR\tllvm\tErr kind");
        process_exit(1);
    }
    let av: String = ll_as_val(arg, ssa0);
    if ll_resst_base(expect) != "" {
        let rb: String = ll_resst_base(expect);
        let a: String = ll_tmpa(ll_pssa(av) + 1);
        println("  " + a + " = alloca %OoRes_St_" + rb + ", align 8");
        let os: Int = ll_oostr_from_pair(ll_pssa(av));
        let s2: Int = os + 1;
        println("  " + ll_ssa(s2) + " = insertvalue %OoRes_St_" + rb + " { i32 0, %St_" + rb + " zeroinitializer, %OoStr { ptr null, i64 0 } }, %OoStr " + ll_ssa(os) + ", 2");
        println("  store %OoRes_St_" + rb + " " + ll_ssa(s2) + ", ptr " + a);
        return ll_pack(0, s2, expect, a);
    }
    if expect == "ress" {
        let a: String = ll_tmpa(ll_pssa(av) + 1);
        println("  " + a + " = alloca %OoResS, align 8");
        let os: Int = ll_oostr_from_pair(ll_pssa(av));
        let s2: Int = os + 1;
        println("  " + ll_ssa(s2) + " = insertvalue %OoResS { i32 0, %OoStr { ptr null, i64 0 } }, %OoStr " + ll_ssa(os) + ", 1");
        println("  store %OoResS " + ll_ssa(s2) + ", ptr " + a);
        return ll_pack(0, s2, "ress", a);
    }
    let a: String = ll_tmpa(ll_pssa(av) + 1);
    println("  " + a + " = alloca %OoResI, align 8");
    let os: Int = ll_oostr_from_pair(ll_pssa(av));
    let s2: Int = os + 1;
    println("  " + ll_ssa(s2) + " = insertvalue %OoResI { i32 0, i64 0, %OoStr { ptr null, i64 0 } }, %OoStr " + ll_ssa(os) + ", 2");
    println("  store %OoResI " + ll_ssa(s2) + ", ptr " + a);
    return ll_pack(0, s2, "resi", a);
}
