// # LLVM Ok/Err/Some/None constructors
//
// Logline: Wrap payload into Option/Result aggregates. Refuse unknown kinds.
//
// Setup: expect is __e__. Option/Result keep i32 tags (oodar ABI; no niche).
// Beats: None/Some/Ok/Err wrap Int, String, list, or struct.
//   3. Result return copies a wrapped resi; bare i64 is ERR.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_struct.oo";
import "ll_slot.oo";
import "ll_ir.oo";
import "ll_niche.oo";
import "ll_ctor_resb.oo";
import "ll_ctor_resf.oo";
import "ll_ctor_keep.oo";
import "ll_reinterpret.oo";

fn ll_resst_base(expect: String) -> String {
    if chars_len(expect) >= 6 && str_slice(expect, 0, 6) == "resSt_" {
        return str_slice(expect, 6, chars_len(expect));
    }
    return "";
}

fn ll_optst_base(expect: String) -> String {
    if chars_len(expect) >= 6 && str_slice(expect, 0, 6) == "optSt_" {
        return str_slice(expect, 6, chars_len(expect));
    }
    return "";
}

fn ll_struct_base_of(ak: String) -> String {
    let hh: Int = str_index_of(ak, "#");
    if hh < 0 { return str_slice(ak, 3, chars_len(ak)); }
    return str_slice(ak, 3, hh);
}


pub fn ll_ctor(name: String, arg: String, ssa0: Int, expect: String, ir: &mut IrBuf) -> String {
    if name == "None" {
        if expect == "optp" { return ll_niche_none(ssa0); }
        let nb: String = ll_optst_base(expect);
        if nb != "" {
            let a: String = ll_tmpa(ssa0 + 1);
            let s: Int = ssa0 + 1;
            ll_slot_ty(a, "%OoOpt_St_" + nb, ir);
            ll_ir_inst(ir, "store", "%OoOpt_St_" + nb, "", "{ i32 0, %St_" + nb + " zeroinitializer }, ptr " + a + ", align 8", 1, 1);
            return ll_pack(0, s, expect, a);
        }
        if expect != "opti" && expect != "opts" {
            println("ERR\tllvm\tNone type");
            process_exit(1);
        }
        let a: String = ll_tmpa(ssa0 + 1);
        let s: Int = ssa0 + 1;
        ll_slot_ty(a, if expect == "opts" { "%OoOptS" } else { "%OoOptI" }, ir);
        if expect == "opts" {
            ll_ir_inst(ir, "store", "%OoOptS", "", "{ i32 0, %OoStr { ptr null, i64 0 } }, ptr " + a + ", align 8", 1, 1);
        } else {
            ll_ir_inst(ir, "store", "%OoOptI", "", "{ i32 0, i64 0 }, ptr " + a + ", align 8", 1, 1);
        }
        return ll_pack(0, s, expect, a);
    }
    if name == "Some" {
        if expect == "optp" || ll_is_refk(ll_pk(arg)) {
            return ll_niche_some(arg, ssa0, ir);
        }
        return ll_ctor_some(arg, ssa0, expect, ir);
    }
    if name == "Ok" {
        if expect == "resp" { return ll_niche_ok(arg, ssa0, ir); }
        return ll_ctor_ok(arg, ssa0, expect, ir);
    }
    if name == "Err" {
        if expect == "resp" { return ll_niche_err(arg, ssa0, ir); }
        return ll_ctor_err(arg, ssa0, expect, ir);
    }
    println("ERR\tllvm\tctor " + name);
    process_exit(1);
    return arg;
}

fn ll_ctor_some(arg: String, ssa0: Int, expect: String, ir: &mut IrBuf) -> String {
    let sav: String = ll_int_convert(arg, ssa0, "i64", ir);
    let sab: Int = ll_hw(ssa0, ll_pssa(sav));
    if ll_pk(sav) == "i64" && (expect == "opti" || expect == "") {
        let a: String = ll_tmpa(sab + 1);
        let s: Int = sab + 1;
        ll_slot_ty(a, "%OoOptI", ir);
        let s2: Int = s + 1;
        ll_ir_inst(ir, "insertvalue", "%OoOptI", ll_ssa(s2), "{ i32 1, i64 0 }, i64 " + ll_opnd(sav) + ", 1", 1, 1);
        ll_ir_inst(ir, "store", "%OoOptI", "", ll_ssa(s2) + ", ptr " + a + ", align 8", 1, 1);
        return ll_pack(0, s2, "opti", a);
    }
    if ll_pk(arg) == "str" && (expect == "opts" || expect == "") {
        let av: String = ll_as_val(arg, ll_ctor_keep(arg, ssa0, ir), ir);
        let a: String = ll_tmpa(ll_pssa(av) + 1);
        ll_slot_ty(a, "%OoOptS", ir);
        let os: Int = ll_oostr_from_pair(ll_pssa(av), ir);
        let s2: Int = os + 1;
        ll_ir_inst(ir, "insertvalue", "%OoOptS", ll_ssa(s2), "{ i32 1, %OoStr { ptr null, i64 0 } }, %OoStr " + ll_ssa(os) + ", 1", 1, 1);
        ll_ir_inst(ir, "store", "%OoOptS", "", ll_ssa(s2) + ", ptr " + a + ", align 8", 1, 1);
        return ll_pack(0, s2, "opts", a);
    }
    if ll_is_struct(ll_pk(arg)) {
        let mut rb: String = ll_optst_base(expect);
        if rb == "" { rb = ll_struct_base_of(ll_pk(arg)); }
        if rb != "" && (expect == "optSt_" + rb || expect == "") {
            let av: String = ll_as_val(arg, ssa0, ir);
            let a: String = ll_tmpa(ll_pssa(av) + 1);
            ll_slot_ty(a, "%OoOpt_St_" + rb, ir);
            let os: Int = ll_pssa(av) + 1;
            ll_ir_inst(ir, "insertvalue", "%OoOpt_St_" + rb, ll_ssa(os), "{ i32 1, %St_" + rb + " zeroinitializer }, %St_" + rb + " " + ll_ssa(ll_pssa(av)) + ", 1", 1, 1);
            ll_ir_inst(ir, "store", "%OoOpt_St_" + rb, "", ll_ssa(os) + ", ptr " + a + ", align 8", 1, 1);
            return ll_pack(0, os, "optSt_" + rb, a);
        }
    }
    println("ERR\tllvm\tSome kind");
    process_exit(1);
    return arg;
}

fn ll_ctor_ok(arg: String, ssa0: Int, expect: String, ir: &mut IrBuf) -> String {
    if ll_pk(arg) == "void" {
        let a: String = ll_tmpa(ssa0 + 1);
        ll_slot_ty(a, "%OoResS", ir);
        ll_ir_inst(ir, "store", "%OoResS", "", "{ i32 1, %OoStr { ptr null, i64 0 } }, ptr " + a + ", align 8", 1, 1);
        return ll_pack(0, ssa0 + 1, "ress", a);
    }
    if ll_pk(arg) == "i1" && expect == "resb" {
        return ll_ctor_ok_resb(arg, ssa0, ir);
    }
    if ll_pk(arg) == "f64" && expect == "resf" {
        return ll_ctor_ok_resf(arg, ssa0, ir);
    }
    let oav: String = ll_int_convert(arg, ssa0, "i64", ir);
    let oab: Int = ll_hw(ssa0, ll_pssa(oav));
    if ll_pk(oav) == "i64" && (expect == "resi" || expect == "resim" || expect == "") {
        let a: String = ll_tmpa(oab + 1);
        let s: Int = oab + 1;
        ll_slot_ty(a, "%OoResI", ir);
        let s2: Int = s + 1;
        ll_ir_inst(ir, "insertvalue", "%OoResI", ll_ssa(s2), "{ i32 1, i64 0, %OoStr { ptr null, i64 0 } }, i64 " + ll_opnd(oav) + ", 1", 1, 1);
        ll_ir_inst(ir, "store", "%OoResI", "", ll_ssa(s2) + ", ptr " + a + ", align 8", 1, 1);
        return ll_pack(0, s2, "resi", a);
    }
    if ll_pk(arg) == "str" && (expect == "ress" || expect == "") {
        let av: String = ll_as_val(arg, ll_ctor_keep(arg, ssa0, ir), ir);
        let a: String = ll_tmpa(ll_pssa(av) + 1);
        ll_slot_ty(a, "%OoResS", ir);
        let os: Int = ll_oostr_from_pair(ll_pssa(av), ir);
        let s2: Int = os + 1;
        ll_ir_inst(ir, "insertvalue", "%OoResS", ll_ssa(s2), "{ i32 1, %OoStr { ptr null, i64 0 } }, %OoStr " + ll_ssa(os) + ", 1", 1, 1);
        ll_ir_inst(ir, "store", "%OoResS", "", ll_ssa(s2) + ", ptr " + a + ", align 8", 1, 1);
        return ll_pack(0, s2, "ress", a);
    }
    if ll_pk(arg) == "slist" || expect == "resl" {
        let av: String = ll_as_val(arg, ll_ctor_keep(arg, ssa0, ir), ir);
        let mut avv: Int = ll_pssa(av);
        if chars_len(ll_pk(av)) >= 6 && str_slice(ll_pk(av), 0, 6) == "olist_" { avv = ll_reinterpret(ll_ir_val(ll_pk(av)), ll_pssa(av), "%OoSList", ll_pssa(av), ir); }
        let a: String = ll_tmpa(avv + 1);
        ll_slot_ty(a, "%OoResL", ir);
        let os: Int = avv + 1;
        ll_ir_inst(ir, "insertvalue", "%OoResL", ll_ssa(os), "{ i32 1, %OoSList zeroinitializer, %OoStr { ptr null, i64 0 } }, %OoSList " + ll_ssa(avv) + ", 1", 1, 1);
        ll_ir_inst(ir, "store", "%OoResL", "", ll_ssa(os) + ", ptr " + a + ", align 8", 1, 1);
        return ll_pack(0, os, "resl", a);
    }
    if ll_pk(arg) == "ilist" || expect == "resil" {
        let av: String = ll_as_val(arg, ll_ctor_keep(arg, ssa0, ir), ir);
        let a: String = ll_tmpa(ll_pssa(av) + 1);
        ll_slot_ty(a, "%OoResLI", ir);
        let os: Int = ll_pssa(av) + 1;
        ll_ir_inst(ir, "insertvalue", "%OoResLI", ll_ssa(os), "{ i32 1, %OoIList zeroinitializer, %OoStr { ptr null, i64 0 } }, %OoIList " + ll_ssa(ll_pssa(av)) + ", 1", 1, 1);
        ll_ir_inst(ir, "store", "%OoResLI", "", ll_ssa(os) + ", ptr " + a + ", align 8", 1, 1);
        return ll_pack(0, os, "resil", a);
    }
    if ll_is_struct(ll_pk(arg)) {
        let mut rb: String = ll_resst_base(expect);
        if rb == "" {
            let ak: String = ll_pk(arg);
            let hh: Int = str_index_of(ak, "#");
            if hh < 0 { rb = str_slice(ak, 3, chars_len(ak)); }
            else { rb = str_slice(ak, 3, hh); }
        }
        if rb != "" {
            let av: String = ll_as_val(arg, ll_ctor_keep(arg, ssa0, ir), ir);
            let a: String = ll_tmpa(ll_pssa(av) + 1);
            ll_slot_ty(a, "%OoRes_St_" + rb, ir);
            let os: Int = ll_pssa(av) + 1;
            ll_ir_inst(ir, "insertvalue", "%OoRes_St_" + rb, ll_ssa(os), "{ i32 1, %St_" + rb + " zeroinitializer, %OoStr { ptr null, i64 0 } }, %St_" + rb + " " + ll_ssa(ll_pssa(av)) + ", 1", 1, 1);
            ll_ir_inst(ir, "store", "%OoRes_St_" + rb, "", ll_ssa(os) + ", ptr " + a + ", align 8", 1, 1);
            return ll_pack(0, os, "resSt_" + rb, a);
        }
    }
    println("ERR\tllvm\tOk kind");
    process_exit(1);
    return arg;
}

fn ll_ctor_err(arg: String, ssa0: Int, expect: String, ir: &mut IrBuf) -> String {
    if ll_pk(arg) != "str" {
        println("ERR\tllvm\tErr kind");
        process_exit(1);
    }
    let av: String = ll_as_val(arg, ll_ctor_keep(arg, ssa0, ir), ir);
    if ll_resst_base(expect) != "" {
        let rb: String = ll_resst_base(expect);
        let a: String = ll_tmpa(ll_pssa(av) + 1);
        ll_slot_ty(a, "%OoRes_St_" + rb, ir);
        let os: Int = ll_oostr_from_pair(ll_pssa(av), ir);
        let s2: Int = os + 1;
        ll_ir_inst(ir, "insertvalue", "%OoRes_St_" + rb, ll_ssa(s2), "{ i32 0, %St_" + rb + " zeroinitializer, %OoStr { ptr null, i64 0 } }, %OoStr " + ll_ssa(os) + ", 2", 1, 1);
        ll_ir_inst(ir, "store", "%OoRes_St_" + rb, "", ll_ssa(s2) + ", ptr " + a + ", align 8", 1, 1);
        return ll_pack(0, s2, expect, a);
    }
    if expect == "ress" {
        let a: String = ll_tmpa(ll_pssa(av) + 1);
        ll_slot_ty(a, "%OoResS", ir);
        let os: Int = ll_oostr_from_pair(ll_pssa(av), ir);
        let s2: Int = os + 1;
        ll_ir_inst(ir, "insertvalue", "%OoResS", ll_ssa(s2), "{ i32 0, %OoStr { ptr null, i64 0 } }, %OoStr " + ll_ssa(os) + ", 1", 1, 1);
        ll_ir_inst(ir, "store", "%OoResS", "", ll_ssa(s2) + ", ptr " + a + ", align 8", 1, 1);
        return ll_pack(0, s2, "ress", a);
    }
    if expect == "resl" {
        let a: String = ll_tmpa(ll_pssa(av) + 1);
        ll_slot_ty(a, "%OoResL", ir);
        let os: Int = ll_oostr_from_pair(ll_pssa(av), ir); let s2: Int = os + 1;
        ll_ir_inst(ir, "insertvalue", "%OoResL", ll_ssa(s2), "{ i32 0, %OoSList zeroinitializer, %OoStr { ptr null, i64 0 } }, %OoStr " + ll_ssa(os) + ", 2", 1, 1);
        ll_ir_inst(ir, "store", "%OoResL", "", ll_ssa(s2) + ", ptr " + a + ", align 8", 1, 1);
        return ll_pack(0, s2, "resl", a);
    }
    if expect == "resil" {
        let a: String = ll_tmpa(ll_pssa(av) + 1);
        ll_slot_ty(a, "%OoResLI", ir);
        let os: Int = ll_oostr_from_pair(ll_pssa(av), ir); let s2: Int = os + 1;
        ll_ir_inst(ir, "insertvalue", "%OoResLI", ll_ssa(s2), "{ i32 0, %OoIList zeroinitializer, %OoStr { ptr null, i64 0 } }, %OoStr " + ll_ssa(os) + ", 2", 1, 1);
        ll_ir_inst(ir, "store", "%OoResLI", "", ll_ssa(s2) + ", ptr " + a + ", align 8", 1, 1);
        return ll_pack(0, s2, "resil", a);
    }
    if expect == "resb" {
        return ll_ctor_err_resb(av, ir);
    }
    if expect == "resf" {
        return ll_ctor_err_resf(av, ir);
    }
    let a: String = ll_tmpa(ll_pssa(av) + 1);
    ll_slot_ty(a, "%OoResI", ir);
    let os: Int = ll_oostr_from_pair(ll_pssa(av), ir); let s2: Int = os + 1;
    ll_ir_inst(ir, "insertvalue", "%OoResI", ll_ssa(s2), "{ i32 0, i64 0, %OoStr { ptr null, i64 0 } }, %OoStr " + ll_ssa(os) + ", 2", 1, 1);
    ll_ir_inst(ir, "store", "%OoResI", "", ll_ssa(s2) + ", ptr " + a + ", align 8", 1, 1);
    return ll_pack(0, s2, "resi", a);
}
