// # LLVM runtime ABI header
//
// Logline: Print x86_64 SysV declares for oo_* matching clang sret/byval for lists and {ptr,i64} for OoStr.
//
// Setup: Product links oodar.c and host_rt. No emit/c import.
//
// Beats:
//   1. Module datalayout and aggregate types.
//   2. Declare list, str, print, cap, fs, and exec helpers.
//   3. STRING globals use @.s<pos> from the token index.

import "ll_need.oo";
import "ll_rt_decl.oo";
import "ll_ir.oo";
import "ll_range.oo";

pub fn ll_c_esc(s: String) -> String {
    let n: Int = chars_len(s);
    let mut o: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" {
            o = o + "\\\\";
        } else if c == "\"" {
            o = o + "\\22";
        } else if c == "\n" {
            o = o + "\\0A";
        } else if c == "\t" {
            o = o + "\\09";
        } else {
            let b: Int = byte_at(c, 0);
            if b == 13 {
                o = o + "\\0D";
            } else if b == 8 {
                o = o + "\\08";
            } else if b == 12 {
                o = o + "\\0C";
            } else if b == 11 {
                o = o + "\\0B";
            } else if b == 0 {
                o = o + "\\00";
            } else {
                o = o + c;
            }
        }
        i = i + 1;
    }
    return o;
}

pub fn ll_layout_of(triple: String) -> String {
    if chars_len(triple) >= 7 && str_slice(triple, 0, 7) == "aarch64" {
        return "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128";
    }
    return "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128";
}

pub fn ll_rt_header(toks: List[String]) {
    ll_rt_header_triple(toks, "x86_64-unknown-linux-gnu");
}

pub fn ll_rt_header_triple(toks: List[String], triple: String) {
    println("target datalayout = \"" + ll_layout_of(triple) + "\"");
    println("target triple = \"" + triple + "\"");
    println("!llvm.module.flags = !{!0, !1, !12}");
    println("!0 = !{i32 1, !\"wchar_size\", i32 4}");
    println("!1 = !{i32 8, !\"PIC Level\", i32 2}");
    println("declare void @llvm.lifetime.start.p0(i64 immarg, ptr nocapture) nounwind");
    println("declare void @llvm.lifetime.end.p0(i64 immarg, ptr nocapture) nounwind");
    println("declare void @llvm.assume(i1) nounwind willreturn memory(inaccessiblemem: readwrite)");
    println("declare void @llvm.dbg.declare(metadata, metadata, metadata) nounwind readnone speculatable");
    println("declare void @llvm.dbg.value(metadata, metadata, metadata) nounwind readnone speculatable");
    ll_ir_begin(toks);
    ll_ir_subty();
    ll_range_emit_all(toks);
    println("%OoStr = type { ptr, i64 }");
    println("%OoSList = type { ptr, i64, i64 }");
    println("%OoIList = type { ptr, i64, i64 }");
    println("%OoResI = type { i32, i64, %OoStr }");
    println("%OoResL = type { i32, %OoSList, %OoStr }");
    println("%OoResLI = type { i32, %OoIList, %OoStr }");
    println("%OoResS = type { i32, %OoStr }");
    println("%OoOptI = type { i32, i64 }");
    println("%OoOptS = type { i32, %OoStr }");
    println("%OoOpt_Ptr = type { i32, ptr }");
    println("%OoRes_Ptr = type { i32, ptr }");
    println("%OoResV = type { i32, %OoStr }");
    println("%OoClosure = type { ptr, ptr, ptr }");
    ll_need_emit_referenced(ll_need_scan(toks));
}
