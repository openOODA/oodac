// # LLVM runtime ABI header
//
// Logline: Print x86_64 SysV declares for oo_* matching clang sret/byval for lists and {ptr,i64} for OoStr.
//
// Setup: Product links chs_rt.c and blackbox.c. No emit/c import.
//
// Beats:
//   1. Module datalayout and OoStr/OoSList/OoIList/OoResI types.
//   2. Declare list, str, print, cap, and fs helpers.

pub fn ll_rt_header() {
    println("target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"");
    println("target triple = \"x86_64-unknown-linux-gnu\"");
    println("%OoStr = type { ptr, i64 }");
    println("%OoSList = type { ptr, i64, i64 }");
    println("%OoIList = type { ptr, i64, i64 }");
    println("%OoResI = type { i32, i64, %OoStr }");
    println("%OoResS = type { i32, %OoStr }");
    println("declare void @oo_slist_new(ptr sret(%OoSList) align 8)");
    println("declare i64 @oo_slist_len(ptr byval(%OoSList) align 8)");
    println("declare void @oo_slist_release(ptr byval(%OoSList) align 8)");
    println("declare void @oo_slist_push(ptr sret(%OoSList) align 8, ptr byval(%OoSList) align 8, ptr, i64)");
    println("declare void @oo_ilist_new(ptr sret(%OoIList) align 8)");
    println("declare i64 @oo_ilist_len(ptr byval(%OoIList) align 8)");
    println("declare void @oo_ilist_release(ptr byval(%OoIList) align 8)");
    println("declare { ptr, i64 } @oo_int_to_str(i64)");
    println("declare { ptr, i64 } @oo_str_lit(ptr)");
    println("declare { ptr, i64 } @oo_str_concat(ptr byval(%OoStr) align 8, ptr byval(%OoStr) align 8)");
    println("declare void @oo_print_str(ptr, i64)");
    println("declare void @oo_println()");
    println("declare i64 @oo_chars_len(ptr byval(%OoStr) align 8)");
    println("declare i32 @oo_str_ends_with(ptr byval(%OoStr) align 8, ptr byval(%OoStr) align 8)");
    println("declare i32 @oo_str_starts_with(ptr byval(%OoStr) align 8, ptr byval(%OoStr) align 8)");
    println("declare i64 @oo_str_index_of(ptr byval(%OoStr) align 8, ptr byval(%OoStr) align 8)");
    println("declare i32 @oo_path_exists(i64, ptr byval(%OoStr) align 8)");
    println("declare void @oo_process_exit(i64)");
    println("declare i64 @oo_cap_grant_process()");
    println("declare i64 @oo_cap_grant_env()");
    println("declare i64 @oo_cap_grant_fsread()");
    println("declare i64 @oo_cap_grant_fswrite()");
}
