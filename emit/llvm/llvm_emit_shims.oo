// # Fill LLVM main args from argv / LLVM link shims for CHS runtime names / Nested List[List[Int]] list_set helper in IR / Lower a brace block to LLVM
//
// Logline: After alloca of main's args slot, construct an OoSList from sys_argv[1..argc]. Text of _shim.ll: process_exit, path_exists, file_size, read_file, write_file, sys_exec. Defines oo_ll_I_set in the module so nested list_set clang-links with chs_rt only. Walks statements inside a brace block, keeps the five-slot LLVM env in step, and returns the token after the close plus that env.
//
// Setup: Merged cohesive compiler module.
//
// Beats:
//   1. Unified cohesive implementation.

import "llvm_emit_arc.oo";


pub fn llvm_emit_main_args(pn: String) {
    println("  call void @oo_slist_new(%OoSList* sret(%OoSList) %" + pn + ".slot)");
    println("  %" + pn + ".ai = alloca i32, align 4");
    println("  store i32 1, i32* %" + pn + ".ai, align 4");
    println("  br label %" + pn + ".args_loop");
    println(pn + ".args_loop:");
    println("  %" + pn + ".aiv = load i32, i32* %" + pn + ".ai, align 4");
    println("  %" + pn + ".more = icmp slt i32 %" + pn + ".aiv, %sys_argc");
    println("  br i1 %" + pn + ".more, label %" + pn + ".args_body, label %" + pn + ".args_done");
    println(pn + ".args_body:");
    println("  %" + pn + ".ai64 = sext i32 %" + pn + ".aiv to i64");
    println("  %" + pn + ".ap = getelementptr inbounds i8*, i8** %sys_argv, i64 %" + pn + ".ai64");
    println("  %" + pn + ".cstr = load i8*, i8** %" + pn + ".ap, align 8");
    println("  %" + pn + ".astr = call %OoStr @oo_str_lit(i8* %" + pn + ".cstr)");
    println("  %" + pn + ".in = alloca %OoSList, align 8");
    println("  %" + pn + ".cur = load %OoSList, %OoSList* %" + pn + ".slot, align 8");
    println("  store %OoSList %" + pn + ".cur, %OoSList* %" + pn + ".in, align 8");
    println("  %" + pn + ".out = alloca %OoSList, align 8");
    println("  call void @oo_slist_push(%OoSList* sret(%OoSList) %" + pn + ".out, %OoSList* byval(%OoSList) %" + pn + ".in, %OoStr %" + pn + ".astr)");
    println("  %" + pn + ".nxt = load %OoSList, %OoSList* %" + pn + ".out, align 8");
    println("  store %OoSList %" + pn + ".nxt, %OoSList* %" + pn + ".slot, align 8");
    println("  %" + pn + ".ain = add i32 %" + pn + ".aiv, 1");
    println("  store i32 %" + pn + ".ain, i32* %" + pn + ".ai, align 4");
    println("  br label %" + pn + ".args_loop");
    println(pn + ".args_done:");
}

pub fn llvm_link_shim_text() -> String {
    let mut s: String = "; oodac llvm runtime shims\n";
    s = s + "target triple = \"x86_64-unknown-linux-gnu\"\n";
    s = s + "%OoStr = type { i8*, i64 }\n%OoResS = type { i32, %OoStr }\n%OoResV = type { i32, %OoStr }\n";
    s = s + "declare void @exit(i32)\n";
    s = s + "declare i32 @oo_path_exists(i64, %OoStr)\n";
    s = s + "declare i64 @oo_file_size(i64, %OoStr)\n";
    s = s + "declare void @oo_read_file(%OoResS* sret(%OoResS), i64, %OoStr)\n";
    s = s + "declare void @oo_write_file(%OoResV* sret(%OoResV), i64, %OoStr, %OoStr)\n";
    s = s + "declare void @oo_sys_exec(%OoResS* sret(%OoResS), i64, i32, %OoStr*)\n";
    s = s + "define void @process_exit(i64 %c) {\n  %t = trunc i64 %c to i32\n  call void @exit(i32 %t)\n  unreachable\n}\n";
    s = s + "define i32 @path_exists(i64 %cap, %OoStr %p) {\n  %r = call i32 @oo_path_exists(i64 %cap, %OoStr %p)\n  ret i32 %r\n}\n";
    s = s + "define i64 @file_size(i64 %cap, %OoStr %p) {\n  %r = call i64 @oo_file_size(i64 %cap, %OoStr %p)\n  ret i64 %r\n}\n";
    s = s + "define %OoResS @read_file(i64 %cap, %OoStr %p) {\n  %slot = alloca %OoResS, align 8\n";
    s = s + "  call void @oo_read_file(%OoResS* sret(%OoResS) %slot, i64 %cap, %OoStr %p)\n";
    s = s + "  %r = load %OoResS, %OoResS* %slot, align 8\n  ret %OoResS %r\n}\n";
    s = s + "define %OoResS @write_file(i64 %cap, %OoStr %p, %OoStr %s) {\n  %vslot = alloca %OoResV, align 8\n";
    s = s + "  call void @oo_write_file(%OoResV* sret(%OoResV) %vslot, i64 %cap, %OoStr %p, %OoStr %s)\n";
    s = s + "  %v = load %OoResV, %OoResV* %vslot, align 8\n  %ok = extractvalue %OoResV %v, 0\n";
    s = s + "  %val = extractvalue %OoResV %v, 1\n  %t0 = insertvalue %OoResS undef, i32 %ok, 0\n";
    s = s + "  %t1 = insertvalue %OoResS %t0, %OoStr %val, 1\n  ret %OoResS %t1\n}\n";
    s = s + "define %OoResS @sys_exec(i64 %cap, %OoStr %a, %OoStr %b, %OoStr %c) {\n";
    s = s + "  %arr = alloca [3 x %OoStr], align 8\n";
    s = s + "  %p0 = getelementptr inbounds [3 x %OoStr], [3 x %OoStr]* %arr, i32 0, i32 0\n";
    s = s + "  %p1 = getelementptr inbounds [3 x %OoStr], [3 x %OoStr]* %arr, i32 0, i32 1\n";
    s = s + "  %p2 = getelementptr inbounds [3 x %OoStr], [3 x %OoStr]* %arr, i32 0, i32 2\n";
    s = s + "  store %OoStr %a, %OoStr* %p0, align 8\n  store %OoStr %b, %OoStr* %p1, align 8\n";
    s = s + "  store %OoStr %c, %OoStr* %p2, align 8\n  %slot = alloca %OoResS, align 8\n";
    s = s + "  call void @oo_sys_exec(%OoResS* sret(%OoResS) %slot, i64 %cap, i32 3, %OoStr* %p0)\n";
    s = s + "  %r = load %OoResS, %OoResS* %slot, align 8\n  ret %OoResS %r\n}\n";
    return s;
}

pub fn llvm_emit_ll_I_set_def() {
    println("define void @oo_ll_I_set(%OoLL_I* sret(%OoLL_I) %out, %OoLL_I* byval(%OoLL_I) %l, i64 %i, %OoIList* byval(%OoIList) %v) {");
    println("  %dp = getelementptr inbounds %OoLL_I, %OoLL_I* %l, i32 0, i32 0");
    println("  %data = load %OoIList*, %OoIList** %dp, align 8");
    println("  %lp = getelementptr inbounds %OoLL_I, %OoLL_I* %l, i32 0, i32 1");
    println("  %len = load i64, i64* %lp, align 8");
    println("  %cp = getelementptr inbounds %OoLL_I, %OoLL_I* %l, i32 0, i32 2");
    println("  %cap = load i64, i64* %cp, align 8");
    println("  %ok = icmp ult i64 %i, %len");
    println("  br i1 %ok, label %okb, label %oob");
    println("oob:");
    println("  call void @llvm.trap()");
    println("  unreachable");
    println("okb:");
    println("  %raw = bitcast %OoIList* %data to i8*");
    println("  %hdr8 = getelementptr inbounds i8, i8* %raw, i64 -8");
    println("  %hdr = bitcast i8* %hdr8 to %OoListHeader*");
    println("  %rcp = getelementptr inbounds %OoListHeader, %OoListHeader* %hdr, i32 0, i32 0");
    println("  %rc = load i32, i32* %rcp, align 4");
    println("  %nrc = add i32 %rc, 1");
    println("  store i32 %nrc, i32* %rcp, align 4");
    println("  call void @oo_ilist_retain(%OoIList* byval(%OoIList) %v)");
    println("  %ep = getelementptr inbounds %OoIList, %OoIList* %data, i64 %i");
    println("  %vv = load %OoIList, %OoIList* %v, align 8");
    println("  store %OoIList %vv, %OoIList* %ep, align 8");
    println("  %odp = getelementptr inbounds %OoLL_I, %OoLL_I* %out, i32 0, i32 0");
    println("  store %OoIList* %data, %OoIList** %odp, align 8");
    println("  %olp = getelementptr inbounds %OoLL_I, %OoLL_I* %out, i32 0, i32 1");
    println("  store i64 %len, i64* %olp, align 8");
    println("  %ocp = getelementptr inbounds %OoLL_I, %OoLL_I* %out, i32 0, i32 2");
    println("  store i64 %cap, i64* %ocp, align 8");
    println("  ret void");
    println("}");
}

pub fn llvm_emit_block(toks: List[String], pos: Int, n: Int, env: List[String]) -> List[String] {
    let mut p = pos;
    let mut cur_env: List[String] = env;
    if p < n && field_at(list_get(toks, p), 0) == "LBRACE" {
        cur_env = llvm_env_push_scope(cur_env);

        p = p + 1;
    }

    while p < n { let k: String = field_at(list_get(toks, p), 0);
    if k == "RBRACE" { if !llvm_env_vars_has(list_get(cur_env, 3), "__did_ret__") { cur_env = llvm_emit_scope_exit(cur_env);
    }
            p = p + 1;
            break;
        }
        let st_res: List[String] = llvm_emit_stmt(toks, p, n, cur_env);
        p = parse_int(list_get(st_res, 0));
        cur_env = list_new();
        cur_env = list_push(cur_env, list_get(st_res, 1));
        cur_env = list_push(cur_env, list_get(st_res, 2));
        cur_env = list_push(cur_env, list_get(st_res, 3));
        cur_env = list_push(cur_env, list_get(st_res, 4));
        cur_env = list_push(cur_env, list_get(st_res, 5));
    }

    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string());
    out = list_push(out, list_get(cur_env, 0));
    out = list_push(out, list_get(cur_env, 1));
    out = list_push(out, list_get(cur_env, 2));
    out = list_push(out, list_get(cur_env, 3));
    out = list_push(out, list_get(cur_env, 4));
    return out;
}
