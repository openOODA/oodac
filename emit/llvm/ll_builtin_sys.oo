// # LLVM sys host ABI
//
// Logline: Lower sys_args, sys_exec_wait, spawn/wait/kill, and stdin to oodar IR.
//
// Setup: Caps are i64. argv is byval %OoSList. Result[Int] sret %OoResI.
//
// Beats:
//   1. sys_args sret a string list. sys_exec_wait sret resi.
//   2. spawn/wait/kill/epoll/inotify/prctl sret ress.
//   3. landlock_is_available is a 0-arg i32. stdin returns str or ress.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_slot.oo";
import "ll_ir.oo";

fn ll_tok_sys_cap(args: List[String]) -> String {
    return ll_ssa(ll_pssa(list_get(args, 0)));
}

fn ll_ty_ress(callee: String, args: List[String], ssa0: Int, extra: String, ir: &mut IrBuf) -> String {
    let s: Int = ssa0 + 1;
    let out: String = ll_tmpa(s);
    ll_slot_ty(out, "%OoResS", ir);
    ll_ir_inst(ir, "call", "void", "", "@" + callee + "(ptr sret(%OoResS) align 8 " + out + ", i64 " + ll_tok_sys_cap(args) + extra + ")", 1, 1);
    return ll_pack(0, s, "ress", out);
}

fn ll_sys_exec(args: List[String], ssa0: Int, ir: &mut IrBuf) -> String {
    let na: Int = list_len(args);
    let argc: Int = na - 1;
    let mut s: Int = ssa0;
    let av: String = ll_tmpa(s + 1);
    s = s + 1;
    ll_slot_ty(av, "[" + argc.to_string() + " x %OoStr]", ir);
    let mut i: Int = 1;
    while i < na {
        let a: String = ll_ensure_ptr(list_get(args, i), s, ir);
        s = ll_pssa(a);
        let sl: Int = s + 1;
        ll_ir_inst(ir, "load", "{ ptr, i64 }", ll_ssa(sl), "ptr " + ll_pptr(a) + ", align 8", 1, 1);
        let gp: Int = sl + 1;
        ll_ir_inst(ir, "getelementptr inbounds", "[" + argc.to_string() + " x %OoStr]", ll_ssa(gp), "ptr " + av + ", i64 0, i64 " + (i - 1).to_string(), 1, 1);
        ll_ir_inst(ir, "store", "{ ptr, i64 }", "", ll_ssa(sl) + ", ptr " + ll_ssa(gp) + ", align 8", 1, 1);
        s = gp;
        i = i + 1;
    }
    let res: String = ll_tmpa(s + 1);
    s = s + 1;
    ll_slot_ty(res, "%OoResS", ir);
    let base: Int = s + 1;
    ll_ir_inst(ir, "getelementptr inbounds", "[" + argc.to_string() + " x %OoStr]", ll_ssa(base), "ptr " + av + ", i64 0, i64 0", 1, 1);
    ll_ir_inst(ir, "call", "void", "", "@oo_sys_exec(ptr sret(%OoResS) align 8 " + res + ", i64 " + ll_ssa(ll_pssa(list_get(args, 0))) + ", i32 " + argc.to_string() + ", ptr " + ll_ssa(base) + ")", 1, 1);
    return ll_pack(0, base, "ress", res);
}

pub fn ll_builtin_sys(name: String, args: List[String], ssa0: Int, expect: String, ir: &mut IrBuf) -> String {
    let na: Int = list_len(args);
    if expect == "noret" { return ""; }
    if (name == "sys_exec" || name == "oo_sys_exec") && na >= 2 {
        return ll_sys_exec(args, ssa0, ir);
    }
    if (name == "sys_args" || name == "oo_sys_args") && na >= 1 {
        let s: Int = ll_pssa(list_get(args, 0)) + 1;
        let out: String = ll_tmpa(s);
        ll_slot_ty(out, "%OoSList", ir);
        ll_ir_inst(ir, "call", "void", "", "@oo_sys_args(ptr sret(%OoSList) align 8 " + out + ", i64 " + ll_tok_sys_cap(args) + ")", 1, 1);
        return ll_pack(0, s, "slist", out);
    }
    if (name == "sys_exec_wait" || name == "oo_sys_exec_wait") && na >= 3 {
        let a1: String = ll_as_val(list_get(args, 1), ssa0, ir);
        let a2: String = ll_ensure_ptr(list_get(args, 2), ll_pssa(a1), ir);
        let s: Int = ll_hw(ll_pssa(a1), ll_pssa(a2)) + 1;
        let out: String = ll_tmpa(s);
        ll_slot_ty(out, "%OoResI", ir);
        ll_ir_inst(ir, "call", "void", "", "@oo_sys_exec_wait(ptr sret(%OoResI) align 8 " + out + ", i64 " + ll_tok_sys_cap(args) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ", ptr byval(%OoSList) align 8 " + ll_pptr(a2) + ")", 1, 1);
        return ll_pack(0, s, "resi", out);
    }
    if (name == "sys_spawn" || name == "oo_sys_spawn") && na >= 2 {
        let a1: String = ll_as_val(list_get(args, 1), ssa0, ir);
        return ll_ty_ress("oo_sys_spawn", args, ll_pssa(a1), ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)), ir);
    }
    if (name == "sys_wait" || name == "oo_sys_wait") && na >= 2 {
        let pid: String = ll_i64arg(args, 1, ssa0, ir);
        return ll_ty_ress("oo_sys_wait", args, ll_pssa(pid), ", i64 " + ll_opnd(pid), ir);
    }
    if (name == "sys_kill" || name == "oo_sys_kill") && na >= 3 {
        let pid: String = ll_i64arg(args, 1, ssa0, ir);
        let sig: String = ll_i64arg(args, 2, ll_pssa(pid), ir);
        return ll_ty_ress("oo_sys_kill", args, ll_pssa(sig), ", i64 " + ll_opnd(pid) + ", i64 " + ll_opnd(sig), ir);
    }
    if (name == "sys_epoll_create" || name == "oo_sys_epoll_create") && na >= 2 {
        let fl: String = ll_i64arg(args, 1, ssa0, ir);
        return ll_ty_ress("oo_sys_epoll_create", args, ll_pssa(fl), ", i64 " + ll_opnd(fl), ir);
    }
    if (name == "sys_inotify_init" || name == "oo_sys_inotify_init") && na >= 1 {
        return ll_ty_ress("oo_sys_inotify_init", args, ssa0, "", ir);
    }
    if (name == "sys_prctl" || name == "oo_sys_prctl") && na >= 2 {
        let op: String = ll_i64arg(args, 1, ssa0, ir);
        return ll_ty_ress("oo_sys_prctl", args, ll_pssa(op), ", i64 " + ll_opnd(op), ir);
    }
    if name == "landlock_is_available" || name == "oo_landlock_is_available" {
        let s: Int = ssa0 + 1;
        ll_ir_inst(ir, "call", "i32", ll_ssa(s), "@oo_landlock_is_available()", 1, 1);
        let s2: Int = s + 1;
        ll_ir_inst(ir, "icmp ne", "i32", ll_ssa(s2), ll_ssa(s) + ", 0", 1, 1);
        return ll_pack(0, s2, "i1", "");
    }
    if (name == "oo_read_stdin" || name == "read_stdin") && na >= 1 {
        let s: Int = ll_pssa(list_get(args, 0)) + 1;
        ll_ir_inst(ir, "call", "{ ptr, i64 }", ll_ssa(s), "@oo_read_stdin(i64 " + ll_tok_sys_cap(args) + ")", 1, 1);
        return ll_pack(0, s, "str", "");
    }
    if (name == "oo_read_stdin_chunk" || name == "read_stdin_chunk") && na >= 2 {
        let ms: String = ll_i64arg(args, 1, ssa0, ir);
        let s: Int = ll_pssa(ms) + 1;
        let out: String = ll_tmpa(s);
        ll_slot_ty(out, "%OoResS", ir);
        ll_ir_inst(ir, "call", "void", "", "@oo_read_stdin_chunk(ptr sret(%OoResS) align 8 " + out + ", i64 " + ll_tok_sys_cap(args) + ", i64 " + ll_opnd(ms) + ")", 1, 1);
        return ll_pack(0, s, "ress", out);
    }
    return "";
}
