// # Structured LLVM IR records
//
// Logline: Token lowering builds typed insts; ll_ir_flush prints LLVM text.
//
// Setup: IrBuf holds I/L/F/E/T records with op, type, dest, args, spans.
// Option/Result keep an i32 tag: oodar ABI is {i32, payload}, so a niche
// discriminant would mis-link.
//
// Beats:
//   1. ll_ir_val_rec packs ssa, kind, line, col.
//   2. ll_ir_inst appends a typed instruction.
//   3. ll_ir_flush is the only function-body LLVM printer.

import "ll_tok.oo";
import "ll_di.oo";

pub type IrBuf = struct {
    recs: String,
    cur_line: Int,
    cur_col: Int,
    scope_id: Int
};

pub fn ll_ir_new() -> IrBuf {
    return IrBuf { recs: "", cur_line: 1, cur_col: 1, scope_id: 0 };
}

pub fn ll_ir_push(b: &mut IrBuf, rec: String) {
    b.recs = b.recs + rec + "\n";
}

pub fn ll_ir_set_loc(b: &mut IrBuf, line: Int, col: Int) {
    if line > 0 { b.cur_line = line; }
    if col > 0 { b.cur_col = col; }
}

pub fn ll_ir_set_scope(b: &mut IrBuf, sc: Int) {
    b.scope_id = sc;
}

pub fn ll_ir_val_rec(ssa: Int, kind: String, line: Int, col: Int) -> String {
    return ssa.to_string() + "\t" + kind + "\t" + line.to_string() + "\t" + col.to_string();
}

pub fn ll_ir_inst(b: &mut IrBuf, op: String, ty: String, dst: String, args: String, line: Int, col: Int) {
    let mut ln: Int = line;
    let mut cn: Int = col;
    if ln <= 1 && cn <= 1 && b.cur_line > 1 {
        ln = b.cur_line;
        cn = b.cur_col;
    }
    let sc: Int = b.scope_id;
    let vr: String = ll_ir_val_rec(0, ty, ln, cn);
    ll_ir_push(b, "I\t" + op + "\t" + ty + "\t" + dst + "\t" + args + "\t" + vr + "\t" + sc.to_string());
}

pub fn ll_ir_label(b: &mut IrBuf, name: String) {
    ll_ir_push(b, "L\t" + name);
}

pub fn ll_ir_text(b: &mut IrBuf, s: String) {
    ll_ir_push(b, "T\t" + s);
}

pub fn ll_ir_fn_open(b: &mut IrBuf, line: String) {
    ll_ir_push(b, "F\t" + line);
}

pub fn ll_ir_fn_close(b: &mut IrBuf) {
    ll_ir_push(b, "E\t");
}

pub fn ll_src_path(toks: List[String]) -> String {
    if list_len(toks) < 1 { return "src.oo"; }
    if ll_k(toks, 0) == "SRC_PATH" {
        let p: String = ll_t(toks, 0);
        if p != "" { return p; }
    }
    return "src.oo";
}

pub fn ll_src_stem(toks: List[String]) -> String {
    let p: String = ll_src_path(toks);
    let n: Int = chars_len(p);
    let mut slash: Int = 0 - 1;
    let mut i: Int = 0;
    while i < n {
        if char_at(p, i) == "/" { slash = i; }
        i = i + 1;
    }
    let mut start: Int = 0;
    if slash >= 0 { start = slash + 1; }
    let mut end: Int = n;
    if n >= 3 && str_slice(p, n - 3, n) == ".oo" { end = n - 3; }
    let mut s: String = "";
    i = start;
    while i < end {
        let c: String = char_at(p, i);
        if c == "-" || c == "." { s = s + "_"; } else { s = s + c; }
        i = i + 1;
    }
    if s == "" { return "m"; }
    return s;
}

pub fn ll_sym_of(toks: List[String], name: String, is_pub: Bool, is_export: Bool) -> String {
    if name == "main" { return "main"; }
    if is_pub || is_export { return name; }
    return ll_src_stem(toks) + "_" + name;
}

pub fn ll_ir_begin(toks: List[String]) {
    let path: String = ll_src_path(toks);
    ll_di_compile_unit(path);
    ll_di_basic_types();
}

pub fn ll_ir_sub(name: String, line: Int, id: Int) {
    ll_di_sub(name, line, id);
}

pub fn ll_ir_subty() {
    ll_di_subty();
}
