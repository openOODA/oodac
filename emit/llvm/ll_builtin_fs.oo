// # LLVM fs host ABI
//
// Logline: Lower fs_is_dir, read_dir, mkdir, rmdir, remove, link, symlink to oodar.
//
// Setup: Caps are i64. Lists sret %OoSList. Result[Void] sret %OoResV as ress.
//
// Beats:
//   1. Bool queries icmp the i32 oodar return.
//   2. read_dir sret a string list.
//   3. mkdir/rmdir/remove sret ress. hardlink/symlink take two paths.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_slot.oo";
import "ll_ir.oo";

fn ll_tok_cap(args: List[String]) -> String {
    return ll_ssa(ll_pssa(list_get(args, 0)));
}

fn ll_ty_bool(s: Int, ir: &mut IrBuf) -> String {
    let s2: Int = s + 1;
    ll_ir_inst(ir, "icmp ne", "i32", ll_ssa(s2), ll_ssa(s) + ", 0", 1, 1);
    return ll_pack(0, s2, "i1", "");
}

fn ll_int_bool2(callee: String, args: List[String], ssa0: Int, ir: &mut IrBuf) -> String {
    let a1: String = ll_as_val(list_get(args, 1), ssa0, ir);
    let s: Int = ll_pssa(a1) + 1;
    ll_ir_inst(ir, "call", "i32", ll_ssa(s), "@" + callee + "(i64 " + ll_tok_cap(args) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")", 1, 1);
    return ll_ty_bool(s, ir);
}

fn ll_int_slist2(callee: String, args: List[String], ssa0: Int, ir: &mut IrBuf) -> String {
    let a1: String = ll_as_val(list_get(args, 1), ssa0, ir);
    let s: Int = ll_pssa(a1) + 1;
    let out: String = ll_tmpa(s);
    ll_slot_name(out, ir);
    ll_ir_inst(ir, "call", "void", "", "@" + callee + "(ptr sret(%OoSList) align 8 " + out + ", i64 " + ll_tok_cap(args) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")", 1, 1);
    return ll_pack(0, s, "slist", out);
}

fn ll_int_resv2(callee: String, args: List[String], ssa0: Int, ir: &mut IrBuf) -> String {
    let a1: String = ll_as_val(list_get(args, 1), ssa0, ir);
    let s: Int = ll_pssa(a1) + 1;
    let out: String = ll_tmpa(s);
    ll_slot_name(out, ir);
    ll_ir_inst(ir, "call", "void", "", "@" + callee + "(ptr sret(%OoResV) align 8 " + out + ", i64 " + ll_tok_cap(args) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")", 1, 1);
    return ll_pack(0, s, "ress", out);
}

fn ll_int_resv3(callee: String, args: List[String], ssa0: Int, ir: &mut IrBuf) -> String {
    let a1: String = ll_as_val(list_get(args, 1), ssa0, ir);
    let a2: String = ll_as_val(list_get(args, 2), ll_pssa(a1), ir);
    let s: Int = ll_pssa(a2) + 1;
    let out: String = ll_tmpa(s);
    ll_slot_name(out, ir);
    ll_ir_inst(ir, "call", "void", "", "@" + callee + "(ptr sret(%OoResV) align 8 " + out + ", i64 " + ll_tok_cap(args) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a2)) + ")", 1, 1);
    return ll_pack(0, s, "ress", out);
}

pub fn ll_builtin_fs(name: String, args: List[String], ssa0: Int, expect: String, ir: &mut IrBuf) -> String {
    let na: Int = list_len(args);
    if expect == "noret" { return ""; }
    if (name == "fs_is_dir" || name == "oo_fs_is_dir") && na >= 2 {
        return ll_int_bool2("oo_fs_is_dir", args, ssa0, ir);
    }
    if (name == "fs_read_dir" || name == "oo_fs_read_dir") && na >= 2 {
        return ll_int_slist2("oo_fs_read_dir", args, ssa0, ir);
    }
    if (name == "fs_mkdir" || name == "oo_fs_mkdir") && na >= 2 {
        return ll_int_resv2("oo_fs_mkdir", args, ssa0, ir);
    }
    if (name == "fs_rmdir" || name == "oo_fs_rmdir") && na >= 2 {
        return ll_int_resv2("oo_fs_rmdir", args, ssa0, ir);
    }
    if (name == "fs_remove_file" || name == "oo_fs_remove_file") && na >= 2 {
        return ll_int_resv2("oo_fs_remove_file", args, ssa0, ir);
    }
    if (name == "fs_hardlink" || name == "oo_fs_hardlink") && na >= 3 {
        return ll_int_resv3("oo_fs_hardlink", args, ssa0, ir);
    }
    if (name == "fs_symlink" || name == "oo_fs_symlink") && na >= 3 {
        return ll_int_resv3("oo_fs_symlink", args, ssa0, ir);
    }
    return "";
}
