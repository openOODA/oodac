// # LLVM integer kind lattice
//
// Logline: i32/u32/i64/u64 kinds with C-exact conversions. No emit/c import.
//
// Setup: Kinds flow in env strings and packs. ll_ty maps spellings; this file
//   owns extension, truncation, common kinds, int binops, and user calls.
//
// Beats:
//   1. zext/sext/trunc; C promotions; user-call arg kinds.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_float.oo";
import "ll_int_div.oo";
import "ll_slot.oo";
import "ll_ir.oo";

pub fn ll_is_int(kind: String) -> Bool {
    if kind == "i32" || kind == "u32" || kind == "i64" || kind == "u64" || kind == "i1" { return true; }
    return false;
}

pub fn ll_is_uint(kind: String) -> Bool {
    if kind == "u32" || kind == "u64" { return true; }
    return false;
}

pub fn ll_int_wide(kind: String) -> String {
    if kind == "i64" || kind == "u64" { return "i64"; }
    return "i32";
}

pub fn ll_int_common(a: String, b: String) -> String {
    if a == "u64" || b == "u64" { return "u64"; }
    if a == "i64" || b == "i64" { return "i64"; }
    if a == "u32" || b == "u32" { return "u32"; }
    return "i32";
}

pub fn ll_int_convert(v: String, ssa0: Int, target: String, ir: &mut IrBuf) -> String {
    let fk: String = ll_pk(v);
    if fk == target { return v; }
    if fk == "i1" && ll_is_int(target) {
        let mut s: Int = ll_hw(ssa0, ll_pssa(v)) + 1;
        ll_ir_inst(ir, "zext", "i1", ll_ssa(s), ll_opnd(v) + " to " + ll_ir_val(target), 1, 1);
        return ll_pack(ll_ppos(v), s, target, "");
    }
    if !ll_is_int(fk) || !ll_is_int(target) { return v; }
    let mut s: Int = ll_hw(ssa0, ll_pssa(v));
    let mut src: String = ll_opnd(v);
    if ll_pptr(v) != "" && (chars_len(ll_pptr(v)) < 1 || char_at(ll_pptr(v), 0) != "#") {
        s = s + 1;
        ll_ir_inst(ir, "load", ll_ir_alloc(fk), ll_ssa(s), "ptr " + ll_pptr(v) + ", align 8", 1, 1);
        src = ll_ssa(s);
    }
    if ll_int_wide(fk) == ll_int_wide(target) {
        if ll_is_imm(v) {
            return ll_pack(ll_ppos(v), ll_pssa(v), target, ll_pptr(v));
        }
        if src != ll_ssa(ll_pssa(v)) {
            return ll_pack(ll_ppos(v), s, target, "");
        }
        return ll_pack(ll_ppos(v), ll_pssa(v), target, ll_pptr(v));
    }
    s = s + 1;
    if ll_int_wide(fk) == "i64" {
        ll_ir_inst(ir, "trunc", "i64", ll_ssa(s), src + " to i32", 1, 1);
    } else if ll_is_uint(fk) {
        ll_ir_inst(ir, "zext", "i32", ll_ssa(s), src + " to i64", 1, 1);
    } else {
        ll_ir_inst(ir, "sext", "i32", ll_ssa(s), src + " to i64", 1, 1);
    }
    return ll_pack(ll_ppos(v), s, target, "");
}

pub fn ll_i64arg(args: List[String], i: Int, ssa0: Int, ir: &mut IrBuf) -> String {
    let a: String = list_get(args, i);
    if !ll_is_int(ll_pk(a)) { return a; }
    return ll_int_convert(a, ssa0, "i64", ir);
}

pub fn ll_neg_int(r: String, ir: &mut IrBuf) -> String {
    let k: String = ll_pk(r);
    if k == "f64" {
        return ll_pack(ll_ppos(r), ll_neg_float(r, ir), "f64", "");
    }
    if !ll_is_int(k) || k == "i64" {
        ll_ir_inst(ir, "sub", "i64", ll_ssa(ll_pssa(r) + 1), "0, " + ll_opnd(r), 1, 1);
        return ll_pack(ll_ppos(r), ll_pssa(r) + 1, "i64", "");
    }
    let s: Int = ll_pssa(r) + 1;
    ll_ir_inst(ir, "sub", "i32", ll_ssa(s), "0, " + ll_opnd(r), 1, 1);
    return ll_pack(ll_ppos(r), s, k, "");
}

pub fn ll_apply_intop(op: String, lhs: String, rhs: String, ir: &mut IrBuf) -> String {
    let lk: String = ll_pk(lhs);
    let rk: String = ll_pk(rhs);
    if !ll_is_int(lk) || !ll_is_int(rk) {
        println("ERR\tllvm\tintop kind");
        process_exit(1);
    }
    let ck: String = ll_int_common(lk, rk);
    let s0: Int = ll_hw(ll_pssa(lhs), ll_pssa(rhs));
    let le: String = ll_int_convert(lhs, s0, ck, ir);
    let re: String = ll_int_convert(rhs, ll_pssa(le), ck, ir);
    let s: Int = ll_hw(ll_pssa(le), ll_pssa(re)) + 1;
    let mut t: String = "i64";
    if ll_int_wide(ck) == "i32" { t = "i32"; }
    let uns: Bool = ll_is_uint(ck);
    let mut inst: String = "";
    if op == "PLUS" { inst = "add"; }
    else if op == "MINUS" { inst = "sub"; }
    else if op == "STAR" { inst = "mul"; }
    else if op == "SLASH" { if uns { inst = "udiv"; } else { inst = "sdiv"; } }
    else if op == "PERCENT" { if uns { inst = "urem"; } else { inst = "srem"; } }
    else if op == "EQEQ" { inst = "icmp eq"; }
    else if op == "NEQ" { inst = "icmp ne"; }
    else if op == "LT" { if uns { inst = "icmp ult"; } else { inst = "icmp slt"; } }
    else if op == "GT" { if uns { inst = "icmp ugt"; } else { inst = "icmp sgt"; } }
    else if op == "LTE" { if uns { inst = "icmp ule"; } else { inst = "icmp sle"; } }
    else if op == "GTE" { if uns { inst = "icmp uge"; } else { inst = "icmp sge"; } }
    else if op == "AMP" { inst = "and"; }
    else if op == "PIPE" { inst = "or"; }
    else if op == "CARET" { inst = "xor"; }
    else if op == "LSHIFT" { inst = "shl"; }
    else if op == "RSHIFT" { if uns { inst = "lshr"; } else { inst = "ashr"; } }
    else { println("ERR\tllvm\tintop " + op); process_exit(1); }
    if op == "EQEQ" || op == "NEQ" || op == "LT" || op == "GT" || op == "LTE" || op == "GTE" {
        ll_ir_inst(ir, inst, t, ll_ssa(s), ll_opnd(le) + ", " + ll_opnd(re), 1, 1);
        return ll_pack(ll_ppos(rhs), s, "i1", "");
    }
    if op == "SLASH" || op == "PERCENT" {
        return ll_int_div(op, inst, t, le, re, s, ck, ir);
    }
    if op == "LSHIFT" || op == "RSHIFT" {
        let mut mask: String = "63";
        if t == "i32" { mask = "31"; }
        ll_ir_inst(ir, "and", t, ll_ssa(s), ll_opnd(re) + ", " + mask, 1, 1);
        ll_ir_inst(ir, inst, t, ll_ssa(s + 1), ll_opnd(le) + ", " + ll_ssa(s), 1, 1);
        return ll_pack(ll_ppos(rhs), s + 1, ck, "");
    }
    ll_ir_inst(ir, inst, t, ll_ssa(s), ll_opnd(le) + ", " + ll_opnd(re), 1, 1);
    return ll_pack(ll_ppos(rhs), s, ck, "");
}

pub fn ll_sig_param(sig: String, i: Int) -> String {
    let gt: Int = str_index_of(sig, ">");
    if gt < 0 { return ""; }
    let body: String = str_slice(sig, 0, gt);
    let n: Int = chars_len(body);
    let mut idx: Int = 0;
    let mut start: Int = 0;
    let mut p: Int = 0;
    while p <= n {
        if p == n || char_at(body, p) == "," {
            if idx == i { return str_slice(body, start, p); }
            idx = idx + 1;
            start = p + 1;
        }
        p = p + 1;
    }
    return "";
}

