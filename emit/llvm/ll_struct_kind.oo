// # LLVM struct kind helpers (leaf)
// Logline: St kind strings, rich field tables, field GEP/load. No declare/emit/literal.
import "ll_tok.oo";
import "ll_ty.oo";
import "ll_ir.oo";
pub fn ll_struct_kind(name: String) -> String {
    return "St_" + name;
}
pub fn ll_st_unp(kind: String) -> String {
    let kl: Int = chars_len(kind);
    if kl > 0 && char_at(kind, 0) == "%" { return str_slice(kind, 1, kl); }
    return kind;
}
pub fn ll_is_struct(kind: String) -> Bool {
    let k: String = ll_st_unp(kind);
    return chars_len(k) >= 3 && str_slice(k, 0, 3) == "St_";
}
pub fn ll_st_basek(kind: String) -> String {
    let k: String = ll_st_unp(kind);
    if !ll_is_struct(k) { println("ERR\tllvm\tstruct kind " + k); process_exit(1); }
    let h: Int = str_index_of(k, "#");
    if h < 0 { return k; }
    return str_slice(k, 0, h);
}
pub fn ll_rich_of(env: String, e: String) -> String {
    let pre: String = "__stf__" + e + ".";
    let pl: Int = chars_len(pre); let en: Int = chars_len(env); let mut o: String = "St_" + e + "#";
    let mut first: Bool = true; let mut j: Int = 0;
    while j < en {
        if j + pl <= en && str_slice(env, j, j + pl) == pre {
            let mut k: Int = j + pl;
            while k < en && char_at(env, k) != "=" { k = k + 1; }
            let fld: String = str_slice(env, j + pl, k);
            if k < en { k = k + 1; }
            let v0: Int = k;
            while k < en && char_at(env, k) != ";" { k = k + 1; }
            let val: String = str_slice(env, v0, k);
            let c: Int = str_index_of(val, ":");
            let fk: String = str_slice(val, c + 1, chars_len(val));
            if !first { o = o + ","; }
            o = o + fld + ":" + ll_st_map(fk, ",", "|"); first = false; j = k + 1;
        } else {
            while j < en && char_at(env, j) != ";" { j = j + 1; }
            j = j + 1;
        }
    }
    return o;
}

pub fn ll_struct_field(kind: String, field: String) -> String {
    if !ll_is_struct(kind) { return ""; }
    let h: Int = str_index_of(kind, "#");
    if h < 0 { return ""; }
    let body: String = str_slice(kind, h + 1, chars_len(kind));
    if str_index_of(body, "|") >= 0 && str_index_of(body, ",") < 0 { return ""; }
    let n: Int = chars_len(body);
    let mut i: Int = 0; let mut idx: Int = 0; let mut cur: String = "";
    while i <= n {
        let e: Bool = i == n || char_at(body, i) == ",";
        if e {
            if cur != "" {
                let c: Int = str_index_of(cur, ":");
                if c >= 0 {
                    if str_slice(cur, 0, c) == field {
                        return idx.to_string() + ":" + str_slice(cur, c + 1, chars_len(cur));
                    }
                    idx = idx + 1;
                }
            }
            cur = "";
            i = i + 1;
        } else { cur = cur + char_at(body, i); i = i + 1; }
    }
    return "";
}
pub fn ll_struct_field_ptr(kind: String, ptr: String, field: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let fi: String = ll_struct_field(kind, field);
    if fi == "" || str_index_of(fi, ":") < 0 { println("ERR\tllvm\tunknown field " + field); process_exit(1); }
    let ci: Int = str_index_of(fi, ":");
    let idx: String = str_slice(fi, 0, ci); let fk: String = str_slice(fi, ci + 1, chars_len(fi)); let s: Int = ssa0 + 1;
    ll_ir_inst(ir, "getelementptr inbounds", "%" + ll_st_basek(kind), ll_ssa(s), "ptr " + ptr + ", i32 0, i32 " + idx, 1, 1);
    return ll_pack(0, s, fk, ll_ssa(s));
}
pub fn ll_struct_field_load(kind: String, ssa: Int, ptr: String, field: String, ssa0: Int, ir: &mut IrBuf) -> String {
    if ptr == "" { println("ERR\tllvm\tstruct load no ptr"); process_exit(1); }
    let fp: String = ll_struct_field_ptr(kind, ptr, field, ssa0, ir);
    let fk: String = ll_st_unp(ll_pk(fp));
    let t: Int = ll_pssa(fp) + 1;
    ll_ir_inst(ir, "load", ll_ir_val(fk), ll_ssa(t), "ptr " + ll_pptr(fp) + ", align 8", 1, 1);
    return ll_pack(0, t, fk, ll_pptr(fp));
}


pub fn ll_struct_rich_scan(env: String, nm: String) -> String {
    let mut rich: String = "St_" + nm + "#"; let mut first: Bool = true;
    let en: Int = chars_len(env); let pre: String = "__stf__" + nm + "."; let pl: Int = chars_len(pre); let mut j: Int = 0;
    while j < en {
        if j + pl <= en && str_slice(env, j, j + pl) == pre {
            let mut k: Int = j + pl;
            while k < en && char_at(env, k) != "=" { k = k + 1; }
            let fld: String = str_slice(env, j + pl, k);
            k = k + 1;
            let mut m: Int = k;
            while m < en && char_at(env, m) != ";" { m = m + 1; }
            let seg: String = str_slice(env, k, m);
            let ci2: Int = str_index_of(seg, ":");
            let fk: String = str_slice(seg, ci2 + 1, chars_len(seg));
            if !first { rich = rich + ","; }
            rich = rich + fld + ":" + ll_st_map(fk, ",", "|");
            first = false;
            j = m;
        }
        j = j + 1;
    }
    return rich;
}
