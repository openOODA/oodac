// # LLVM exact runtime symbol tracker
//
// Logline: Tracks genuinely referenced @oo_* runtime symbols and emits declarations.
//
// Setup: Refined scan and registration ensure declarations match exact TU needs.
//
// Beats:
//   1. Tab-delimited symbol set accumulation and queries.
//   2. Exact call, type, and capability scanner.
//   3. Deterministic referenced-only LLVM declaration emission.

import "ll_tok.oo";
import "ll_need_list.oo";
import "ll_need_tab.oo";

pub fn ll_need_add(need: String, name: String) -> String {
    if name == "" || str_index_of(need, "\t" + name + "\t") >= 0 { return need; }
    return need + name + "\t";
}

pub fn ll_need_has(need: String, name: String) -> Bool {
    return str_index_of(need, "\t" + name + "\t") >= 0;
}

pub fn ll_need_register(sym: String) -> String {
    return ll_need_add("\t", sym);
}

pub fn ll_need_emit_referenced(need: String) {
    let n: Int = chars_len(need);
    let mut i: Int = 0;
    let mut start: Int = 0;
    while i <= n {
        if i == n || char_at(need, i) == "\t" {
            if i > start {
                let sym: String = str_slice(need, start, i);
                let proto: String = ll_need_proto(sym);
                if proto != "" { println(proto); }
                let ext: String = ll_need_extra(sym);
                if ext != "" { println(ext); }
            }
            start = i + 1;
        }
        i = i + 1;
    }
}

fn ll_need_call(need: String, nm: String) -> String {
    let mut n: String = need;
    if nm == "println" {
        n = ll_need_add(n, "oo_println");
        n = ll_need_add(n, "oo_print_int");
        return n;
    }
    if nm == "print" {
        n = ll_need_add(n, "oo_print_str");
        return n;
    }
    if nm == "unwrap" || nm == "unwrap_or" {
        n = ll_need_add(n, "oo_unwrap_msg");
        n = ll_need_add(n, "oo_str_lit");
        n = ll_need_add(n, "oo_print_str");
        n = ll_need_add(n, "oo_println");
        n = ll_need_add(n, "oo_process_exit");
        return n;
    }
    if nm == "list_new" {
        return ll_need_add(ll_need_add(ll_need_add(ll_need_add(ll_need_add(n, "oo_slist_new"), "oo_ilist_new"), "oo_flist_new"), "oo_ll_I_new"), "oo_ll_S_new");
    }
    if nm == "list_len" {
        return ll_need_add(ll_need_add(ll_need_add(ll_need_add(ll_need_add(n, "oo_slist_len"), "oo_ilist_len"), "oo_flist_len"), "oo_ll_I_len"), "oo_ll_S_len");
    }
    if nm == "list_get" {
        return ll_need_add(ll_need_add(ll_need_add(ll_need_add(ll_need_add(n, "oo_slist_get"), "oo_ilist_get"), "oo_flist_get"), "oo_ll_I_get"), "oo_ll_S_get");
    }
    if nm == "list_push" {
        return ll_need_add(ll_need_add(ll_need_add(ll_need_add(ll_need_add(n, "oo_slist_push"), "oo_ilist_push"), "oo_flist_push"), "oo_ll_I_push"), "oo_ll_S_push");
    }
    if nm == "list_slice" {
        return ll_need_add(ll_need_add(ll_need_add(ll_need_add(ll_need_add(n, "oo_slist_slice"), "oo_ilist_slice"), "oo_flist_slice"), "oo_ll_I_slice"), "oo_ll_S_slice");
    }
    if nm == "list_set" {
        return ll_need_add(ll_need_add(ll_need_add(ll_need_add(ll_need_add(n, "oo_slist_set"), "oo_ilist_set"), "oo_flist_set"), "oo_ll_I_set"), "oo_ll_S_set");
    }
    if nm == "len" || nm == "chars_len" {
        return ll_need_add(ll_need_add(ll_need_add(ll_need_add(ll_need_add(n, "oo_chars_len"), "oo_slist_len"), "oo_ilist_len"), "oo_ll_I_len"), "oo_ll_S_len");
    }
    if nm == "contains" || nm == "str_contains" { return ll_need_add(n, "oo_str_contains"); }
    if nm == "bytes_len" { return ll_need_add(n, "oo_bytes_len"); }
    if nm == "char_at" { return ll_need_add(n, "oo_char_at"); }
    if nm == "str_slice" { return ll_need_add(n, "oo_str_slice"); }
    if nm == "str_eq" { return ll_need_add(n, "oo_str_eq"); }
    if nm == "str_ends_with" { return ll_need_add(n, "oo_str_ends_with"); }
    if nm == "str_starts_with" { return ll_need_add(n, "oo_str_starts_with"); }
    if nm == "str_index_of" { return ll_need_add(n, "oo_str_index_of"); }
    if nm == "byte_at" { return ll_need_add(n, "oo_byte_at"); }
    if nm == "byte_slice" { return ll_need_add(n, "oo_byte_slice"); }
    if nm == "char_is_digit" { return ll_need_add(n, "oo_char_is_digit"); }
    if nm == "char_is_alpha" { return ll_need_add(n, "oo_char_is_alpha"); }
    if nm == "char_is_space" { return ll_need_add(n, "oo_char_is_space"); }
    if nm == "str_split" { return ll_need_add(n, "str_split"); }
    if nm == "str_trim" { return ll_need_add(n, "oo_str_trim"); }
    if nm == "str_concat" { return ll_need_add(n, "oo_str_concat"); }
    if nm == "str_repeat" { return ll_need_add(n, "oo_str_repeat"); }
    if nm == "to_string" || nm == "int_to_str" { return ll_need_add(n, "oo_int_to_str"); }
    if nm == "to_uppercase" { return ll_need_add(n, "oo_str_to_uppercase"); }
    if nm == "to_lowercase" { return ll_need_add(n, "oo_str_to_lowercase"); }
    if nm == "path_exists" || nm == "file_size" || nm == "file_stamp" { return ll_need_add(n, "oo_" + nm); }
    if nm == "read_file" || nm == "write_file" { return ll_need_add(n, "oo_" + nm); }
    if nm == "env_get" || nm == "sys_exec" || nm == "process_exit" { return ll_need_add(n, "oo_" + nm); }
    if nm == "sleep_ms" || nm == "now_ms" || nm == "monotonic_us" { return ll_need_add(n, "oo_" + nm); }
    if nm == "hot_reload" || nm == "alloc_bytes" { return ll_need_add(n, "oo_" + nm); }
    if chars_len(nm) >= 3 && str_slice(nm, 0, 3) == "oo_" { return ll_need_add(n, nm); }
    if chars_len(nm) >= 4 && str_slice(nm, 0, 4) == "sys_" { return ll_need_add(n, "oo_" + nm); }
    if chars_len(nm) >= 3 && str_slice(nm, 0, 3) == "fs_" { return ll_need_add(n, "oo_" + nm); }
    if chars_len(nm) >= 4 && str_slice(nm, 0, 4) == "tui_" { return ll_need_add(n, "oo_" + nm); }
    if chars_len(nm) >= 6 && str_slice(nm, 0, 6) == "bytes_" { return ll_need_add(n, "oo_" + nm); }
    if chars_len(nm) >= 7 && str_slice(nm, 0, 7) == "crypto_" { return ll_need_add(n, nm); }
    if nm == "arena_reset" { return ll_need_add(n, "oo_arena_reset"); }
    if chars_len(nm) >= 6 && str_slice(nm, 0, 6) == "arena_" { return ll_need_add(n, "oo_" + nm); }
    if chars_len(nm) >= 4 && str_slice(nm, 0, 4) == "gpu_" { return ll_need_add(n, "oo_" + nm); }
    if chars_len(nm) >= 6 && str_slice(nm, 0, 6) == "actor_" { return ll_need_add(n, "oo_" + nm); }
    if chars_len(nm) >= 6 && str_slice(nm, 0, 6) == "audio_" { return ll_need_add(n, "oo_" + nm); }
    if chars_len(nm) >= 8 && str_slice(nm, 0, 8) == "channel_" { return ll_need_add(n, "oo_" + nm); }
    if chars_len(nm) >= 7 && str_slice(nm, 0, 7) == "thread_" { return ll_need_add(n, "oo_" + nm); }
    if nm == "otp_supervise" { return ll_need_add(n, "oo_otp_supervise"); }
    return n;
}

fn ll_need_cap_sym(t: String) -> String {
    if t == "ProcessCap" { return "oo_cap_grant_process"; }
    if t == "EnvCap" { return "oo_cap_grant_env"; }
    if t == "FsReadCap" { return "oo_cap_grant_fsread"; }
    if t == "FsWriteCap" { return "oo_cap_grant_fswrite"; }
    if t == "BindCap" { return "oo_cap_grant_bind"; }
    if t == "SysCap" { return "oo_cap_grant_sys"; }
    if t == "TimeCap" { return "oo_cap_grant_time"; }
    if t == "AllocCap" { return "oo_cap_grant_alloc"; }
    if t == "TcpCap" { return "oo_cap_grant_tcp"; }
    if t == "UdpCap" { return "oo_cap_grant_udp"; }
    if t == "NetCap" { return "oo_cap_grant_net"; }
    if t == "FsCap" { return "oo_cap_grant_fs"; }
    if t == "RandCap" { return "oo_cap_grant_rand"; }
    if t == "ArenaCap" { return "oo_cap_grant_arena"; }
    if t == "FfiCap" { return "oo_cap_grant_ffi"; }
    if t == "ThreadCap" { return "oo_cap_grant_thread"; }
    if t == "GpuCap" { return "oo_cap_grant_gpu"; }
    if t == "CompilerReadCap" { return "oo_cap_grant_compiler_read"; }
    if t == "SignCap" { return "oo_cap_grant_sign"; }
    if t == "AudioCap" { return "oo_cap_grant_audio"; }
    if t == "CameraCap" { return "oo_cap_grant_camera"; }
    if t == "UsbCap" { return "oo_cap_grant_usb"; }
    if t == "HidCap" { return "oo_cap_grant_hid"; }
    if t == "WindowCap" { return "oo_cap_grant_window"; }
    if t == "FrameCap" { return "oo_cap_grant_frame"; }
    if t == "MetricsCap" { return "oo_cap_grant_metrics"; }
    return "";
}

fn ll_need_caps(toks: List[String], need0: String) -> String {
    let n: Int = list_len(toks);
    let mut need: String = need0;
    let mut i: Int = 0;
    while i < n {
        if ll_k(toks, i) == "IDENT" {
            let s: String = ll_need_cap_sym(ll_t(toks, i));
            if s != "" { need = ll_need_add(need, s); }
        }
        i = i + 1;
    }
    return need;
}

pub fn ll_need_scan(toks: List[String]) -> String {
    let n: Int = list_len(toks);
    let mut need: String = "\t";
    let mut i: Int = 0;
    let mut has_str: Bool = false;
    let mut has_list: Bool = false;
    let mut has_args: Bool = false;
    let mut has_verify: Bool = false;
    let mut has_float: Bool = false;
    while i < n {
        let k: String = ll_k(toks, i);
        if k == "STRING" { has_str = true; }
        if k == "FLOAT" { has_float = true; }
        if k == "KW_VERIFY" || k == "KW_ENSURES" || k == "KW_REQUIRES" { has_verify = true; }
        if k == "SLASH" || k == "PERCENT" {
            need = ll_need_add(need, "oo_process_exit");
        }
        if k == "IDENT" {
            let nm: String = ll_t(toks, i);
            if nm == "String" || nm == "to_string" || nm == "char_at" || nm == "str_slice" { has_str = true; }
            if nm == "Float" { has_float = true; }
            if nm == "List" { has_list = true; }
            if nm == "List" && i + 2 < n && ll_k(toks, i + 1) == "LBRACKET" && ll_k(toks, i + 2) == "IDENT" {
                let el: String = ll_t(toks, i + 2);
                if el != "Int" && el != "String" { need = ll_need_add(need, "oo_process_exit"); }
            }
            if nm == "args" { has_args = true; }
            if i + 1 < n && ll_k(toks, i + 1) == "LPAREN" {
                need = ll_need_call(need, nm);
                if nm == "list_new" || nm == "list_len" || nm == "list_get" || nm == "list_push" || nm == "list_slice" || nm == "list_set" { has_list = true; }
            }
            if i > 0 && ll_k(toks, i - 1) == "DOT" && i + 1 < n && ll_k(toks, i + 1) == "LPAREN" {
                need = ll_need_call(need, nm);
            }
        }
        i = i + 1;
    }
    if has_str {
        need = ll_need_add(need, "oo_str_lit");
        need = ll_need_add(need, "oo_str_retain");
        need = ll_need_add(need, "oo_str_release");
        need = ll_need_add(need, "oo_str_concat");
        need = ll_need_add(need, "oo_str_eq");
        if ll_need_has(need, "oo_println") { need = ll_need_add(need, "oo_print_str"); }
    }
    if has_list {
        need = ll_need_add(need, "oo_slist_retain");
        need = ll_need_add(need, "oo_slist_release");
        need = ll_need_add(need, "oo_ilist_retain");
        need = ll_need_add(need, "oo_ilist_release");
        need = ll_need_add(need, "oo_flist_retain");
        need = ll_need_add(need, "oo_flist_release");
        need = ll_need_add(need, "oo_ll_I_retain");
        need = ll_need_add(need, "oo_ll_I_release");
        need = ll_need_add(need, "oo_ll_S_retain");
        need = ll_need_add(need, "oo_ll_S_release");
        need = ll_need_add(ll_need_add(need, "oo_list_alloc_payload"), "oo_list_quota_release_bytes");
        need = ll_need_add(need, "oo_payload_free");
    }
    if has_args {
        need = ll_need_add(need, "oo_slist_new");
        need = ll_need_add(need, "oo_slist_push");
        need = ll_need_add(need, "oo_str_lit");
    }
    if has_verify {
        need = ll_need_add(need, "getenv");
        need = ll_need_add(need, "oo_print_str");
        need = ll_need_add(need, "oo_println");
        need = ll_need_add(need, "oo_str_lit");
        need = ll_need_add(need, "oo_process_exit");
    }
    if has_float {
        need = ll_need_add(need, "oo_print_double");
    }
    need = ll_need_caps(toks, need);
    return ll_need_refine_list(toks, need);
}
