// # LLVM type names from Ooda tokens
//
// Logline: Map IDENT types at a token index to slist, ilist, str, i64, i1, resi, opti, ress.
//
// Setup: ll_k/ll_t. Shared names stay conceptual with types/; no emit/c import.
//
// Beats:
//   1. List[String] is slist. List[Int] is ilist.
//   2. Result[Int, String] is resi. Result[String, String] is ress. Option[Int] is opti.
//   3. Cap tokens are i64.

import "ll_tok.oo";

pub fn ll_ty_at(toks: List[String], pos: Int, n: Int) -> String {
    let mut p: Int = pos;
    if p < n && ll_k(toks, p) == "AMP" { p = p + 1; }
    if p >= n || ll_k(toks, p) != "IDENT" {
        println("ERR\tllvm\ttype token");
        process_exit(1);
    }
    let t: String = ll_t(toks, p);
    if t == "Int" || t == "i64" { return "i64"; }
    if t == "Bool" { return "i1"; }
    if t == "String" { return "str"; }
    if t == "Void" { return "void"; }
    if t == "ProcessCap" || t == "EnvCap" || t == "FsReadCap" || t == "FsWriteCap" { return "i64"; }
    if t == "SysCap" || t == "AllocCap" || t == "TimeCap" || t == "BindCap" { return "i64"; }
    if t == "TcpCap" || t == "UdpCap" || t == "NetCap" || t == "FsCap" { return "i64"; }
    if t == "RandCap" || t == "ArenaCap" || t == "FfiCap" || t == "ThreadCap" { return "i64"; }
    if t == "GpuCap" || t == "CompilerReadCap" || t == "SignCap" || t == "AudioCap" { return "i64"; }
    if t == "CameraCap" || t == "UsbCap" || t == "HidCap" || t == "WindowCap" { return "i64"; }
    if t == "FrameCap" { return "i64"; }
    if t == "List" {
        if p + 2 < n && ll_k(toks, p + 1) == "LBRACKET" && ll_k(toks, p + 2) == "IDENT" {
            let e: String = ll_t(toks, p + 2);
            if e == "String" { return "slist"; }
            if e == "Int" { return "ilist"; }
        }
        println("ERR\tllvm\tlist kind");
        process_exit(1);
    }
    if t == "Result" {
        if p + 2 < n && ll_k(toks, p + 2) == "IDENT" {
            let e: String = ll_t(toks, p + 2);
            if e == "String" { return "ress"; }
            if e == "Int" { return "resi"; }
        }
        println("ERR\tllvm\tresult kind");
        process_exit(1);
    }
    if t == "Option" {
        if p + 2 < n && ll_k(toks, p + 1) == "LBRACKET" && ll_k(toks, p + 2) == "IDENT" {
            let e: String = ll_t(toks, p + 2);
            if e == "Int" { return "opti"; }
            if e == "String" { return "opts"; }
        }
        println("ERR\tllvm\toption kind");
        process_exit(1);
    }
    println("ERR\tllvm\tunknown type " + t);
    process_exit(1);
    return "i64";
}

pub fn ll_cap_grant(ty: String) -> String {
    if ty == "ProcessCap" { return "process"; }
    if ty == "EnvCap" { return "env"; }
    if ty == "FsReadCap" { return "fsread"; }
    if ty == "FsWriteCap" { return "fswrite"; }
    if ty == "BindCap" { return "bind"; }
    if ty == "SysCap" { return "sys"; }
    if ty == "TimeCap" { return "time"; }
    if ty == "AllocCap" { return "alloc"; }
    if ty == "TcpCap" { return "tcp"; }
    if ty == "UdpCap" { return "udp"; }
    if ty == "NetCap" { return "net"; }
    if ty == "FsCap" { return "fs"; }
    if ty == "RandCap" { return "rand"; }
    if ty == "ArenaCap" { return "arena"; }
    if ty == "FfiCap" { return "ffi"; }
    if ty == "ThreadCap" { return "thread"; }
    if ty == "GpuCap" { return "gpu"; }
    if ty == "CompilerReadCap" { return "compiler_read"; }
    if ty == "SignCap" { return "sign"; }
    if ty == "AudioCap" { return "audio"; }
    if ty == "CameraCap" { return "camera"; }
    if ty == "UsbCap" { return "usb"; }
    if ty == "HidCap" { return "hid"; }
    if ty == "WindowCap" { return "window"; }
    if ty == "FrameCap" { return "frame"; }
    return "";
}

pub fn ll_peek_cap_name(toks: List[String], pos: Int, n: Int) -> String {
    let mut p: Int = pos;
    if p < n && ll_k(toks, p) == "AMP" { p = p + 1; }
    if p < n && ll_k(toks, p) == "IDENT" { return ll_t(toks, p); }
    return "";
}

pub fn ll_ir_alloc(kind: String) -> String {
    if kind == "slist" { return "%OoSList"; }
    if kind == "ilist" { return "%OoIList"; }
    if kind == "str" { return "%OoStr"; }
    if kind == "opti" { return "%OoOptI"; }
    if kind == "opts" { return "%OoOptS"; }
    if kind == "ress" { return "%OoResS"; }
    if kind == "resi" { return "%OoResI"; }
    if kind == "i1" { return "i1"; }
    return "i64";
}

pub fn ll_ir_val(kind: String) -> String {
    if kind == "str" { return "{ ptr, i64 }"; }
    return ll_ir_alloc(kind);
}

pub fn ll_is_agg(kind: String) -> Bool {
    if kind == "slist" { return true; }
    if kind == "ilist" { return true; }
    if kind == "str" { return true; }
    if kind == "opti" { return true; }
    if kind == "opts" { return true; }
    if kind == "ress" { return true; }
    if kind == "resi" { return true; }
    return false;
}

pub fn ll_is_mem(kind: String) -> Bool {
    if kind == "slist" { return true; }
    if kind == "ilist" { return true; }
    if kind == "ress" { return true; }
    if kind == "resi" { return true; }
    if kind == "opti" { return true; }
    if kind == "opts" { return true; }
    return false;
}

pub fn ll_pass(kind: String) -> String {
    if ll_is_mem(kind) {
        return "ptr byval(" + ll_ir_alloc(kind) + ") align 8";
    }
    return ll_ir_val(kind);
}

pub fn ll_ensure_ptr(v: String, ssa0: Int) -> String {
    if ll_pptr(v) != "" { return ll_pack(ll_ppos(v), ssa0, ll_pk(v), ll_pptr(v)); }
    let a: String = ll_tmpa(ssa0 + 1);
    let s: Int = ssa0 + 1;
    println("  " + a + " = alloca " + ll_ir_alloc(ll_pk(v)) + ", align 8");
    println("  store " + ll_ir_val(ll_pk(v)) + " " + ll_ssa(ll_pssa(v)) + ", ptr " + a);
    return ll_pack(ll_ppos(v), s, ll_pk(v), a);
}

pub fn ll_as_val(v: String, ssa0: Int) -> String {
    let p: String = ll_ensure_ptr(v, ssa0);
    let s: Int = ll_pssa(p) + 1;
    println("  " + ll_ssa(s) + " = load " + ll_ir_val(ll_pk(v)) + ", ptr " + ll_pptr(p));
    return ll_pack(ll_ppos(v), s, ll_pk(v), "");
}
