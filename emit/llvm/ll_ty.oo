// # LLVM type names from Ooda tokens
//
// Logline: Map IDENT types to slist, ilist, str, i64, i1, resi, opti. Caps are i64.
//
// Setup: Maps high-level Ooda types to canonical LLVM IR allocation and value types.
//
// Beats:
//   1. Map primitive, list, option, result, and struct types.
//   2. Compute capability grants and pass-by attributes.
//   3. Helper functions for pointer and value coercion.
import "ll_tok.oo";
import "ll_slot.oo";
import "ll_ir.oo";
import "ll_range.oo";
import "ll_cap.oo";

pub fn ll_ty_at(toks: List[String], pos: Int, n: Int, stab: String) -> String {
    let mut p: Int = pos;
    let mut isref: Bool = false;
    if p < n && ll_k(toks, p) == "AMP" { isref = true; p = p + 1; }
    if p < n && ll_k(toks, p) == "KW_MUT" { p = p + 1; }
    if p >= n || ll_k(toks, p) != "IDENT" {
        println("ERR\tllvm\ttype token");
        process_exit(1);
    }
    let t: String = ll_t(toks, p);
    if t == "Int" || t == "i64" {
        if isref { return "ri64"; }
        let br: String = ll_range_parse(toks, p, n);
        if br != "" { return br; }
        return "i64";
    }
    if t == "Float" { if isref { return "rf64"; } return "f64"; }
    if t == "u64" { if isref { return "ru64"; } return "u64"; }
    if t == "i32" { if isref { return "ri32"; } return "i32"; }
    if t == "u32" { if isref { return "ru32"; } return "u32"; }
    if t == "u8" || t == "i8" || t == "u16" || t == "i16" {
        println("ERR\tllvm\tnarrow int not lowered " + t);
        process_exit(1);
    }
    if t == "Bool" { if isref { return "ri1"; } return "i1"; }
    if t == "f32x8" { return "v8f32"; }
    if t == "f64x4" { return "v4f64"; }
    if t == "String" { return "str"; }
    if t == "Void" { return "void"; }
    if str_index_of(t, "Cap") >= 0 { return "i64"; }
    if t == "List" {
        if p + 2 < n && ll_k(toks, p + 1) == "LBRACKET" && ll_k(toks, p + 2) == "IDENT" {
            let e: String = ll_t(toks, p + 2);
            if e == "String" { return "slist"; }
            if e == "Int" { return "ilist"; }
            if e == "Float" { return "flist"; }
            if e == "List" && p + 4 < n {
                if ll_t(toks, p + 4) == "Int" { return "ll_i"; }
                if ll_t(toks, p + 4) == "String" { return "ll_s"; }
            }
            return "olist_" + e;
        }
        println("ERR\tllvm\tlist kind");
        process_exit(1);
    }
    if t == "Result" {
        if p + 2 < n && (ll_k(toks, p + 1) == "LBRACKET" || ll_k(toks, p + 1) == "LT") && ll_k(toks, p + 2) == "AMP" {
            let mut q: Int = p + 3;
            if q < n && ll_k(toks, q) == "KW_MUT" { q = q + 1; }
            if q < n && ll_k(toks, q) == "IDENT" && ll_is_cap_ty(ll_t(toks, q)) { return "resi"; }
            return "resp";
        }
        if p + 2 < n && ll_k(toks, p + 2) == "IDENT" {
            let e: String = ll_t(toks, p + 2);
            if e == "String" { return "ress"; }
            if e == "Int" { return "resi"; }
            if e == "Void" { return "ress"; }
            if e == "List" {
                if p + 4 < n && ll_t(toks, p + 4) == "Int" { return "resil"; }
                return "resl";
            }
            return "resSt_" + e;
        }
        println("ERR\tllvm\tresult kind");
        process_exit(1);
    }
    if t == "Option" {
        if p + 2 < n && (ll_k(toks, p + 1) == "LBRACKET" || ll_k(toks, p + 1) == "LT") {
            if ll_k(toks, p + 2) == "AMP" {
                let mut q: Int = p + 3;
                if q < n && ll_k(toks, q) == "KW_MUT" { q = q + 1; }
                if q < n && ll_k(toks, q) == "IDENT" && ll_is_cap_ty(ll_t(toks, q)) { return "opti"; }
                return "optp";
            }
            if ll_k(toks, p + 2) == "IDENT" {
                let e: String = ll_t(toks, p + 2);
                if e == "Int" { return "opti"; }
                if e == "String" { return "opts"; }
                return "optSt_" + e;
            }
        }
        println("ERR\tllvm\toption kind");
        process_exit(1);
    }
    let sr: String = ll_stab_rich(stab, t);
    if sr != "" { return sr; }
    let sc: String = ll_ty_struct_rich(toks, t, n, stab);
    if sc != "" { return sc; }
    println("ERR\tllvm\tunknown type " + t);
    process_exit(1);
    return "i64";
}
fn ll_ty_struct_rich(toks: List[String], t: String, n: Int, stab: String) -> String {
    let mut i: Int = 0;
    while i < n {
        if ll_k(toks, i) == "KW_TYPE" {
            let mut q: Int = i + 1;
            if q < n && ll_k(toks, q) == "IDENT" && ll_t(toks, q) == t {
                q = q + 1;
                if q < n && ll_k(toks, q) == "EQ" {
                    q = q + 1;
                    if q < n && ll_k(toks, q) == "IDENT" && ll_t(toks, q) == "struct" {
                        q = q + 1;
                        if q < n && ll_k(toks, q) == "LBRACE" {
                            q = q + 1;
                            let mut rich: String = "St_" + t + "#"; let mut first: Bool = true;
                            while q < n && ll_k(toks, q) != "RBRACE" {
                                if ll_k(toks, q) == "COMMA" { q = q + 1; continue; }
                                if ll_k(toks, q) != "IDENT" { println("ERR\tllvm\tstruct field"); process_exit(1); }
                                let fld: String = ll_t(toks, q); q = q + 1;
                                if q >= n || ll_k(toks, q) != "COLON" { println("ERR\tllvm\tstruct colon"); process_exit(1); }
                                q = q + 1;
                                let fk: String = ll_ty_at(toks, q, n, stab);
                                if !first { rich = rich + ","; }
                                rich = rich + fld + ":" + ll_st_map(fk, ",", "|"); first = false;
                                q = ll_skip_type(toks, q, n);
                            }
                            if q >= n || ll_k(toks, q) != "RBRACE" { println("ERR\tllvm\tstruct rbrace"); process_exit(1); }
                            return rich;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return "";
}

fn ll_unp(s: String) -> String {
    let n: Int = chars_len(s);
    if n > 0 && char_at(s, 0) == "%" { return str_slice(s, 1, n); }
    return s;
}
fn ll_st_raw(s: String) -> String {
    let n: Int = chars_len(s);
    let mut end: Int = n;
    let c: Int = str_index_of(s, ",");
    if c >= 0 && c < end { end = c; }
    let h: Int = str_index_of(s, "#");
    if h >= 0 && h < end { end = h; }
    return str_slice(s, 0, end);
}
pub fn ll_ir_alloc(kind: String) -> String {
    let k: String = ll_unp(kind);
    if ll_is_refk(k) || k == "optp" || k == "resp" { return "ptr"; }
    if k == "slist" { return "%OoSList"; }
    if k == "ilist" { return "%OoIList"; }
    if k == "flist" { return "%OoFList"; }
    if k == "ll_i" { return "%OoLL_I"; }
    if k == "ll_s" { return "%OoLL_S"; }
    if k == "str" { return "%OoStr"; }
    if k == "opti" { return "%OoOptI"; }
    if k == "opts" { return "%OoOptS"; }
    if k == "ress" { return "%OoResS"; }
    if k == "resi" { return "%OoResI"; }
    if k == "resl" { return "%OoResL"; }
    if k == "resil" { return "%OoResLI"; }
    if k == "i1" { return "i1"; }
    if k == "i8" || k == "u8" { return "i8"; }
    if k == "i16" || k == "u16" { return "i16"; }
    if k == "i32" || k == "u32" { return "i32"; }
    if k == "i64" || k == "u64" { return "i64"; }
    if ll_range_is_bint(k) { return "i64"; }
    if k == "f64" { return "double"; }
    if k == "v8f32" { return "<8 x float>"; }
    if k == "v4f64" { return "<4 x double>"; }
    if chars_len(k) >= 3 && str_slice(k, 0, 3) == "St_" {
        return "%" + ll_st_raw(k);
    }
    if chars_len(k) >= 6 && str_slice(k, 0, 6) == "olist_" {
        return "%OoL_" + ll_st_raw(str_slice(k, 6, chars_len(k)));
    }
    if chars_len(k) >= 6 && str_slice(k, 0, 6) == "resSt_" {
        return "%OoRes_St_" + ll_st_raw(str_slice(k, 6, chars_len(k)));
    }
    if chars_len(k) >= 6 && str_slice(k, 0, 6) == "optSt_" {
        return "%OoOpt_St_" + ll_st_raw(str_slice(k, 6, chars_len(k)));
    }
    return "i64";
}

pub fn ll_ir_val(kind: String) -> String {
    if ll_is_refk(kind) || kind == "optp" || kind == "resp" { return "ptr"; }
    if kind == "str" { return "{ ptr, i64 }"; }
    return ll_ir_alloc(kind);
}

pub fn ll_is_agg(kind: String) -> Bool {
    let k: String = ll_unp(kind);
    if k == "slist" || k == "ilist" || k == "flist" || k == "ll_i" || k == "ll_s" || k == "str" || k == "opti" || k == "opts" { return true; }
    if k == "ress" || k == "resi" || k == "resl" || k == "resil" { return true; }
    if chars_len(k) >= 3 && str_slice(k, 0, 3) == "St_" { return true; }
    if chars_len(k) >= 6 && (str_slice(k, 0, 6) == "olist_" || str_slice(k, 0, 6) == "resSt_" || str_slice(k, 0, 6) == "optSt_") { return true; }
    return false;
}
pub fn ll_is_mem(kind: String) -> Bool {
    let k: String = ll_unp(kind);
    if k == "slist" || k == "ilist" || k == "flist" || k == "ll_i" || k == "ll_s" || k == "opti" || k == "opts" { return true; }
    if k == "ress" || k == "resi" || k == "resl" || k == "resil" { return true; }
    if chars_len(k) >= 3 && str_slice(k, 0, 3) == "St_" { return true; }
    if chars_len(k) >= 6 && (str_slice(k, 0, 6) == "olist_" || str_slice(k, 0, 6) == "resSt_" || str_slice(k, 0, 6) == "optSt_") { return true; }
    return false;
}

pub fn ll_pass(kind: String) -> String {
    let k: String = ll_unp(kind);
    if chars_len(k) >= 3 && str_slice(k, 0, 3) == "St_" { return "ptr noalias nocapture noundef"; }
    if chars_len(k) >= 6 && (str_slice(k, 0, 6) == "olist_" || str_slice(k, 0, 6) == "resSt_" || str_slice(k, 0, 6) == "optSt_") { return "ptr noalias nocapture noundef"; }
    if ll_is_mem(k) {
        return "ptr noalias nocapture byval(" + ll_ir_alloc(k) + ") align 8";
    }
    if ll_is_refk(k) || k == "optp" || k == "resp" { return "ptr noalias nocapture noundef"; }
    if ll_range_is_bint(k) { return ll_range_param_pass(k); }
    if k == "i64" || k == "u64" || k == "i32" || k == "u32" || k == "i1" {
        return ll_ir_val(k) + " noundef";
    }
    return ll_ir_val(k);
}

pub fn ll_ensure_ptr(v: String, ssa0: Int, ir: &mut IrBuf) -> String {
    if ll_has_slot(v) { return ll_pack(ll_ppos(v), ssa0, ll_pk(v), ll_pptr(v)); }
    let a: String = ll_tmpa(ssa0 + 1); let s: Int = ssa0 + 1;
    ll_slot_ty(a, ll_ir_alloc(ll_pk(v)), ir);
    ll_ir_inst(ir, "store", ll_ir_val(ll_pk(v)), "", ll_opnd(v) + ", ptr " + a + ", align 8", 1, 1);
    return ll_pack(ll_ppos(v), s, ll_pk(v), a);
}

pub fn ll_as_val(v: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let p: String = ll_ensure_ptr(v, ssa0, ir); let s: Int = ll_pssa(p) + 1;
    ll_ir_inst(ir, "load", ll_ir_val(ll_pk(v)), ll_ssa(s), "ptr " + ll_pptr(p) + ", align 8", 1, 1);
    return ll_pack(ll_ppos(v), s, ll_pk(v), "");
}
