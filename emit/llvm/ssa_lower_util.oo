// # SSA Lowering Utility and Symbol Helper
//
// Logline: Provides token extraction, integer parsing, binary operator mapping, and symbol table lookup for AST-to-SSA lowering.
//
// Setup: Helper module for ssa_lower.oo and ssa_lower_simd.oo under openOODA compiler pipeline.
//
// Beats:
//   1. Extract arguments from AST node representations.
//   2. Parse decimal integers with optional negative signs.
//   3. Map AST binary operator strings to SSA opcodes.
//   4. Manage SSA symbol table bindings and lookups.

import "ssa_ir.oo";
import "ast/ANCHOR.oo";

type SsaLowerContext = struct {
    fn_data: SsaFunction,
    cur_block: Int,
    next_reg: Int,
    last_val: Int,
    var_names: List[String],
    var_slots: List[Int],
    var_count: Int
};

pub fn ssa_ctx_new(name: String, ret_type: Int) -> SsaLowerContext {
    let empty_s: List[String] = list_new();
    let empty_i: List[Int] = list_new();
    return SsaLowerContext { fn_data: ssa_fn_new(name, ret_type), cur_block: 0, next_reg: 1, last_val: 0, var_names: empty_s, var_slots: empty_i, var_count: 0 };
}

pub fn ssa_ctx_add_block(ctx: SsaLowerContext, name: String) -> SsaLowerContext {
    return SsaLowerContext { fn_data: ssa_fn_add_block(ctx.fn_data, name), cur_block: ctx.cur_block, next_reg: ctx.next_reg, last_val: ctx.last_val, var_names: ctx.var_names, var_slots: ctx.var_slots, var_count: ctx.var_count };
}

pub fn ssa_ctx_emit(ctx: SsaLowerContext, res_reg: Int, op: Int, imm: Int) -> SsaLowerContext {
    return SsaLowerContext { fn_data: ssa_fn_emit_inst(ctx.fn_data, ctx.cur_block, res_reg, op, imm), cur_block: ctx.cur_block, next_reg: ctx.next_reg, last_val: ctx.last_val, var_names: ctx.var_names, var_slots: ctx.var_slots, var_count: ctx.var_count };
}

pub fn ssa_ctx_emit_lhs(ctx: SsaLowerContext, res_reg: Int, op: Int, imm: Int, lhs_val: Int) -> SsaLowerContext {
    return SsaLowerContext { fn_data: ssa_fn_emit_inst_lhs(ctx.fn_data, ctx.cur_block, res_reg, op, imm, lhs_val), cur_block: ctx.cur_block, next_reg: ctx.next_reg, last_val: ctx.last_val, var_names: ctx.var_names, var_slots: ctx.var_slots, var_count: ctx.var_count };
}

pub fn ssa_ctx_set_block(ctx: SsaLowerContext, block_id: Int) -> SsaLowerContext {
    return SsaLowerContext { fn_data: ctx.fn_data, cur_block: block_id, next_reg: ctx.next_reg, last_val: ctx.last_val, var_names: ctx.var_names, var_slots: ctx.var_slots, var_count: ctx.var_count };
}

pub fn ssa_ctx_set_last(ctx: SsaLowerContext, reg: Int, val: Int) -> SsaLowerContext {
    return SsaLowerContext { fn_data: ctx.fn_data, cur_block: ctx.cur_block, next_reg: reg, last_val: val, var_names: ctx.var_names, var_slots: ctx.var_slots, var_count: ctx.var_count };
}

pub fn ssa_sym_lookup(ctx: SsaLowerContext, name: String) -> Int {
    let vnames: List[String] = ctx.var_names;
    let mut i: Int = ctx.var_count - 1;
    while i >= 0 {
        if list_get(vnames, i) == name { return list_get(ctx.var_slots, i); }
        i = i - 1;
    }
    return 0;
}

pub fn ssa_sym_bind(ctx: SsaLowerContext, name: String, slot: Int) -> SsaLowerContext {
    let mut vnames: List[String] = ctx.var_names;
    let names: List[String] = list_push(vnames, name);
    let slots: List[Int] = list_push(ctx.var_slots, slot);
    return SsaLowerContext { fn_data: ctx.fn_data, cur_block: ctx.cur_block, next_reg: ctx.next_reg, last_val: ctx.last_val, var_names: names, var_slots: slots, var_count: ctx.var_count + 1 };
}

pub fn ssa_lower_args_of(node: String) -> String {
    let n: Int = chars_len(node);
    let mut depth: Int = 0;
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut hit: Bool = false;
    while i < n {
        let c: String = char_at(node, i);
        if c == "(" { if depth == 0 { start = i + 1; hit = true; } depth = depth + 1; }
        if c == ")" { depth = depth - 1; if depth == 0 && hit { return str_slice(node, start, i); } }
        i = i + 1;
    }
    return "";
}

pub fn ssa_parse_int(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut v: Int = 0;
    let mut i: Int = 0;
    let mut sign: Int = 1;
    if n > 0 && char_at(s, 0) == "-" { sign = -1; i = 1; }
    while i < n {
        let c: String = char_at(s, i);
        if c == "0" { v = v * 10 + 0; } else if c == "1" { v = v * 10 + 1; }
        else if c == "2" { v = v * 10 + 2; } else if c == "3" { v = v * 10 + 3; }
        else if c == "4" { v = v * 10 + 4; } else if c == "5" { v = v * 10 + 5; }
        else if c == "6" { v = v * 10 + 6; } else if c == "7" { v = v * 10 + 7; }
        else if c == "8" { v = v * 10 + 8; } else if c == "9" { v = v * 10 + 9; }
        i = i + 1;
    }
    return v * sign;
}

pub fn ssa_map_binop(op: String) -> Int {
    if op == "Add" || op == "+" { return (0 + ssa_op_add()); }
    if op == "Sub" || op == "-" { return (0 + ssa_op_sub()); }
    if op == "Mul" || op == "*" { return (0 + ssa_op_mul()); }
    if op == "Div" || op == "/" { return (0 + ssa_op_sdiv()); }
    if op == "Mod" || op == "%" { return (0 + ssa_op_srem()); }
    if op == "And" || op == "&&" || op == "BitAnd" || op == "&" { return (0 + ssa_op_and()); }
    if op == "Or" || op == "||" || op == "BitOr" || op == "|" { return (0 + ssa_op_or()); }
    if op == "Xor" || op == "^" { return (0 + ssa_op_xor()); }
    if op == "Shl" || op == "<<" { return (0 + ssa_op_shl()); }
    if op == "Shr" || op == ">>" { return (0 + ssa_op_shr()); }
    if op == "Eq" || op == "==" { return (0 + ssa_op_icmp_eq()); }
    if op == "Lt" || op == "<" { return (0 + ssa_op_icmp_slt()); }
    if op == "Lte" || op == "<=" { return (0 + ssa_op_icmp_ule()); }
    if op == "Gt" || op == ">" { return (0 + ssa_op_icmp_sgt()); }
    if op == "Gte" || op == ">=" { return (0 + ssa_op_icmp_sge()); }
    if op == "Ne" || op == "Neq" || op == "!=" { return (0 + ssa_op_icmp_ne()); }
    return (0 + ssa_op_add());
}
