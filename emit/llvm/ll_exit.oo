// # LLVM terminator statements
//
// Logline: Lower return, break, and continue with block-end skipping.
//
// Setup: Called from ll_emit_stmts dispatch. Terminators mark packs done.
//
// Beats:
//   1. Bare return in void fns emits ret void.
//   2. Value returns follow resi/void/opt/mem kinds.
//   3. break and continue target loop labels or refuse.
import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_expr.oo";
import "ll_ctor.oo";
import "ll_contract.oo";
import "ll_call.oo";
import "ll_arc.oo";
import "ll_slot.oo";
import "types/types_core.oo";
import "ll_ir.oo";
import "ll_c_abi.oo";

pub fn ll_return_stmt(toks: List[String], p: Int, n: Int, ssa: Int, env: String, ret_kind: String, stab: String, ir: &mut IrBuf) -> String {
    let rl: Int = ll_line(toks, p);
    let rc: Int = ll_col(toks, p);
    ll_ir_set_loc(ir, rl, rc);
    if p + 1 < n && ll_k(toks, p + 1) == "SEMI" {
        if ret_kind == "main_i32" || ret_kind == "optim" || ret_kind == "optsm" {
            let ns: Int = ll_arc_exit_all(env, ssa, ir);
            ll_heap_end(ir);
            ll_ir_inst(ir, "ret", "i32", "", "0", 1, 1);
            let q: Int = ll_skip_to_rbrace(toks, p + 1, n);
            return ll_pack(q, ns, ret_kind, env) + "\t1";
        }
        if ret_kind != "void" {
            println("ERR\tllvm\tbare return needs void");
            process_exit(1);
        }
        let ns: Int = ll_arc_exit_all(env, ssa, ir);
        ll_heap_end(ir);
        ll_ir_inst(ir, "ret", "void", "", "", 1, 1);
        let q: Int = ll_skip_to_rbrace(toks, p + 1, n);
        return ll_pack(q, ns, ret_kind, env) + "\t1";
    }
    let mut exp_kind: String = "";
    if ret_kind == "optim" {
        exp_kind = "opti";
    } else if ret_kind == "optsm" {
        exp_kind = "opts";
    } else {
        exp_kind = str_slice(ret_kind, 0, chars_len(ret_kind));
    }
    let envx: String = type_env_put(env, "__e__", exp_kind);
    let v0: String = ll_expr(toks, p + 1, n, ssa, envx, ir);
    let v: String = ll_int_convert(v0, ll_pssa(v0), exp_kind, ir);
    let mut np: Int = ll_ppos(v); let mut ns: Int = ll_pssa(v);
    if np < n && ll_k(toks, np) == "SEMI" { np = np + 1; }
    if type_env_get(env, "__ens__") == "1" && ret_kind != "main_i32" && ret_kind != "void" && ret_kind != "optim" && ret_kind != "optsm" {
        ns = ll_contract_return(toks, v, env, ns, exp_kind, p, ir);
    }
    if ll_arc_owned(ll_pk(v)) && ll_pptr(v) != "" {
        ns = ll_arc_keep_ptr(ll_pk(v), ll_pptr(v), ns, ir);
    }
    ns = ll_arc_exit_all(env, ns, ir);
    ll_heap_end(ir);
    if ret_kind == "resim" {
        ns = ll_ret_resim(v, ns, ir);
    } else if ret_kind == "optim" || ret_kind == "optsm" {
        ll_ir_inst(ir, "ret", "i32", "", "0", 1, 1);
    } else if ret_kind == "resi" {
        ns = ll_ret_resi(v, ns, ir);
    } else if ret_kind == "resl" || ret_kind == "resil" || ret_kind == "ress" {
        ns = ll_ret_res(v, ret_kind, ns, ir);
    } else if ret_kind == "void" {
        ll_ir_inst(ir, "ret", "void", "", "", 1, 1);
    } else if ret_kind == "opti" || ret_kind == "opts" {
        ns = ll_ret_opt(v, ret_kind, ns, ir);
    } else if ret_kind == "main_i32" {
        let mut mval: String = ll_opnd(v);
        if ll_has_slot(v) {
            ns = ns + 1;
            ll_ir_inst(ir, "load", ll_ir_val(ll_pk(v)), ll_ssa(ns), "ptr " + ll_pptr(v) + ", align 8", 1, 1);
            mval = ll_ssa(ns);
        }
        if !ll_is_imm(v) && ll_pk(v) != "i32" && ll_pk(v) != "u32" {
            ns = ns + 1;
            if ll_pk(v) == "i1" {
                ll_ir_inst(ir, "zext", "i1", ll_ssa(ns), mval + " to i32", 1, 1);
            } else {
                ll_ir_inst(ir, "trunc", "i64", ll_ssa(ns), mval + " to i32", 1, 1);
            }
            mval = ll_ssa(ns);
        }
        ll_ir_inst(ir, "ret", "i32", "", mval, 1, 1);
    } else if type_env_get(env, "__export__") == "1" && ll_is_niche_ptr(ret_kind) {
        ns = ll_c_abi_pack_ret(v, "%ret", ns, ir);
        ll_ir_inst(ir, "ret", "void", "", "", 1, 1);
    } else if ll_is_niche_ptr(ret_kind) {
        let mut pval: String = ll_opnd(v);
        if ll_is_imm(v) {
            pval = str_slice(ll_pptr(v), 1, chars_len(ll_pptr(v)));
        } else if ll_pptr(v) != "" {
            pval = ll_pptr(v);
        }
        ll_ir_inst(ir, "ret", "ptr", "", pval, 1, 1);
    } else if ll_has_slot(v) {
        ns = ns + 1;
        ll_ir_inst(ir, "load", ll_ir_val(ret_kind), ll_ssa(ns), "ptr " + ll_pptr(v) + ", align 8", 1, 1);
        if ll_is_mem(ret_kind) {
            ll_ir_inst(ir, "store", ll_ir_val(ret_kind), "", ll_ssa(ns) + ", ptr %ret, align 8", 1, 1);
            ll_ir_inst(ir, "ret", "void", "", "", 1, 1);
        } else {
            ll_ir_inst(ir, "ret", ll_ir_val(ret_kind), "", ll_ssa(ns), 1, 1);
        }
    } else if ll_is_mem(ret_kind) {
        ll_ir_inst(ir, "store", ll_ir_val(ret_kind), "", ll_opnd(v) + ", ptr %ret, align 8", 1, 1);
        ll_ir_inst(ir, "ret", "void", "", "", 1, 1);
    } else {
        ll_ir_inst(ir, "ret", ll_ir_val(ret_kind), "", ll_opnd(v), 1, 1);
    }
    let rp: Int = ll_skip_to_rbrace(toks, np, n);
    return ll_pack(rp, ns, ret_kind, env) + "\t1";
}

pub fn ll_break_stmt(toks: List[String], p: Int, n: Int, ssa: Int, env: String, ret_kind: String, ir: &mut IrBuf) -> String {
    let bl: Int = ll_line(toks, p);
    let bc: Int = ll_col(toks, p);
    ll_ir_set_loc(ir, bl, bc);
    let is_brk: Bool = ll_t(toks, p) == "break";
    let mut dst: String = type_env_get(env, "__brk__");
    if !is_brk { dst = type_env_get(env, "__cont__"); }
    if dst == "" {
        println("ERR\tllvm\tbreak outside loop");
        process_exit(1);
    }
    let ssa2: Int = ll_arc_exit_loop(env, ssa, ir);
    ll_ir_inst(ir, "br", "label", "", "%" + dst, 1, 1);
    let mut np: Int = p + 1;
    if np < n && ll_k(toks, np) == "SEMI" { np = np + 1; }
    let rp: Int = ll_skip_to_rbrace(toks, np, n);
    return ll_pack(rp, ssa2, ret_kind, env) + "\t1";
}

pub fn ll_store_deref_stmt(toks: List[String], p0: Int, n: Int, ssa0: Int, env: String, ir: &mut IrBuf) -> String {
    ll_ir_set_loc(ir, ll_line(toks, p0), ll_col(toks, p0));
    let name: String = ll_t(toks, p0 + 1);
    let ty: String = type_env_get(env, name);
    if ty == "" || ll_is_agg(ty) {
        println("ERR\tllvm\tstore through bad ref, align 8");
        process_exit(1);
    }
    let mut val_ty: String = "i64";
    if ty == "ri32" || ty == "ru32" { val_ty = "i32"; }
    if ty == "rf64" { val_ty = "f64"; }
    if ty == "ri1" { val_ty = "i1"; }
    let mut vv: String = ll_expr(toks, p0 + 3, n, ssa0, type_env_put(env, "__e__", val_ty), ir);
    if ll_is_int(val_ty) && ll_is_int(ll_pk(vv)) && ll_pk(vv) != val_ty {
        vv = ll_int_convert(vv, ll_hw(ssa0, ll_pssa(vv)), val_ty, ir);
    }
    let la: String = ll_load_ident(name, env, ll_pssa(vv), ir);
    let ptr_target: String = ll_pptr(la);
    let mut cur_s: Int = ll_pssa(la);
    let mut target_ptr: String = "";
    if chars_len(ptr_target) < 3 || str_slice(ptr_target, 0, 3) != "%p_" {
        cur_s = cur_s + 1;
        ll_ir_inst(ir, "load", "ptr", ll_ssa(cur_s), "ptr " + ptr_target + ", align 8", 1, 1);
        target_ptr = ll_ssa(cur_s);
    } else {
        target_ptr = ptr_target;
    }
    ll_ir_inst(ir, "store", ll_ir_val(val_ty), "", ll_opnd(vv) + ", ptr " + target_ptr + ", align 8", 1, 1);
    let mut p: Int = ll_ppos(vv);
    if p < n && ll_k(toks, p) == "SEMI" { p = p + 1; }
    return ll_pack(p, cur_s, val_ty, "");
}

pub fn ll_ret_resi(v: String, ssa0: Int, ir: &mut IrBuf) -> Int {
    let p: String = ll_ensure_ptr(v, ssa0, ir);
    let s: Int = ll_pssa(p) + 1;
    ll_ir_inst(ir, "load", "%OoResI", ll_ssa(s), "ptr " + ll_pptr(p) + ", align 8", 1, 1);
    ll_ir_inst(ir, "store", "%OoResI", "", ll_ssa(s) + ", ptr %ret, align 8", 1, 1);
    ll_ir_inst(ir, "ret", "void", "", "", 1, 1);
    return s;
}

pub fn ll_ret_opt(v: String, kind: String, ssa0: Int, ir: &mut IrBuf) -> Int {
    let p: String = ll_ensure_ptr(v, ssa0, ir);
    let s: Int = ll_pssa(p) + 1;
    ll_ir_inst(ir, "load", ll_ir_alloc(kind), ll_ssa(s), "ptr " + ll_pptr(p) + ", align 8", 1, 1);
    ll_ir_inst(ir, "store", ll_ir_alloc(kind), "", ll_ssa(s) + ", ptr %ret, align 8", 1, 1);
    ll_ir_inst(ir, "ret", "void", "", "", 1, 1);
    return s;
}

pub fn ll_ret_resim(v: String, ssa0: Int, ir: &mut IrBuf) -> Int {
    let p: String = ll_ensure_ptr(v, ssa0, ir);
    let s: Int = ll_pssa(p) + 1;
    ll_ir_inst(ir, "getelementptr inbounds", "%OoResI", ll_ssa(s), "ptr " + ll_pptr(p) + ", i32 0, i32 0", 1, 1);
    let s2: Int = s + 1;
    ll_ir_inst(ir, "load", "i32", ll_ssa(s2), "ptr " + ll_ssa(s) + ", align 4", 1, 1);
    let s3: Int = s2 + 1;
    ll_ir_inst(ir, "icmp eq", "i32", ll_ssa(s3), ll_ssa(s2) + ", 0", 1, 1);
    let s4: Int = s3 + 1;
    ll_ir_inst(ir, "zext", "i1", ll_ssa(s4), ll_ssa(s3) + " to i32", 1, 1);
    ll_ir_inst(ir, "ret", "i32", "", ll_ssa(s4), 1, 1);
    return s4;
}

pub fn ll_ret_res(v: String, kind: String, ssa0: Int, ir: &mut IrBuf) -> Int {
    let p: String = ll_ensure_ptr(v, ssa0, ir);
    let s: Int = ll_pssa(p) + 1;
    ll_ir_inst(ir, "load", ll_ir_alloc(kind), ll_ssa(s), "ptr " + ll_pptr(p) + ", align 8", 1, 1);
    ll_ir_inst(ir, "store", ll_ir_alloc(kind), "", ll_ssa(s) + ", ptr %ret, align 8", 1, 1);
    ll_ir_inst(ir, "ret", "void", "", "", 1, 1);
    return s;
}

