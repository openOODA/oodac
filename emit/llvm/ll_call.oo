// # LLVM ctor, load, match, and binop lowering
//
// Logline: Methods on allocas. Binops on SSA. Some/None/Ok/Err constructors.
//
// Setup: Does not import ll_expr. Aggregates use sret/byval.
//
// Beats:
//   1. String concat and eq. Integer icmp including GTE/LTE.
//   2. is_some/is_ok load field 0. to_string uses oo_int_to_str.
//   3. Option Some/None as %OoOptI.
//   4. .val/.err load payload fields by kind. println(i1) prints 0/1 like C.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_float.oo";
import "ll_slot.oo";
import "types/types_core.oo";
import "ll_ir.oo";
import "ll_range.oo";


pub fn ll_str_gep(toks: List[String], pos: Int, ssa0: Int, ir: &mut IrBuf) -> String {
    let tx: String = ll_t(toks, pos);
    let ln: Int = bytes_len(tx) + 1;
    let n: Int = ssa0 + 1;
    ll_ir_inst(ir, "getelementptr inbounds", "[" + ln.to_string() + " x i8]", ll_ssa(n), "ptr @.s" + pos.to_string() + ", i64 0, i64 0", 1, 1);
    let n2: Int = n + 1;
    ll_ir_inst(ir, "call", "{ ptr, i64 }", ll_ssa(n2), "@oo_str_lit(ptr " + ll_ssa(n) + ")", 1, 1);
    return ll_pack(pos + 1, n2, "str", "");
}

pub fn ll_addr_ident(name: String, env: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let k: String = type_env_get(env, name);
    if k == "" {
        println("ERR\tllvm\tundefined " + name);
        process_exit(1);
    }
    let mut ptr: String = ll_var(name);
    let loc: String = type_env_get(env, "__l__" + name);
    if loc != "" { ptr = loc; }
    return ll_pack(0, ssa0, k, ptr);
}

pub fn ll_load_ident(name: String, env: String, ssa0: Int, ir: &mut IrBuf) -> String {
    let k: String = type_env_get(env, name);
    if k == "" {
        println("ERR\tllvm\tundefined " + name);
        process_exit(1);
    }
    let mut ptr: String = ll_var(name);
    let loc: String = type_env_get(env, "__l__" + name);
    if loc != "" { ptr = loc; }
    if ll_is_agg(k) {
        return ll_pack(0, ssa0, k, ptr);
    }
    if ll_is_refk(k) {
        return ll_pack(0, ssa0, k, ptr);
    }
    let n: Int = ssa0 + 1;
    let meta: String = if ll_range_is_bint(k) { ll_range_meta_load(k, env) } else { "" };
    ll_ir_inst(ir, "load", ll_ir_val(k), ll_ssa(n), "ptr " + ptr + ", align 8" + meta, 1, 1);
    return ll_pack(0, n, k, "");
}

pub fn ll_match_tag(sk: String, ptr: String, ssa0: Int, ir: &mut IrBuf) -> Int {
    let p: String = if ptr != "" { ptr } else { "%ret" };
    let s: Int = ssa0 + 1;
    ll_ir_inst(ir, "getelementptr inbounds", ll_ir_alloc(sk), ll_ssa(s), "ptr " + p + ", i32 0, i32 0", 1, 1);
    let s2: Int = s + 1;
    ll_ir_inst(ir, "load", "i32", ll_ssa(s2), "ptr " + ll_ssa(s) + ", align 4", 1, 1);
    let s3: Int = s2 + 1;
    ll_ir_inst(ir, "icmp ne", "i32", ll_ssa(s3), ll_ssa(s2) + ", 0", 1, 1);
    return s3;
}

pub fn ll_match_bind(sk: String, ptr: String, bn: String, ok: Int, id: Int, ssa0: Int, ir: &mut IrBuf) -> String {
    let mut bk: String = "str";
    let mut fi: String = "1";
    if sk == "opti" { bk = "i64"; }
    if sk == "opts" { bk = "str"; }
    if sk == "resi" && ok == 1 { bk = "i64"; }
    if sk == "resi" && ok == 0 { bk = "str"; fi = "2"; }
    if sk == "resl" && ok == 1 { bk = "slist"; }
    if sk == "resl" && ok == 0 { bk = "str"; fi = "2"; }
    if ll_is_resst(sk) && ok == 1 { bk = "St_" + str_slice(sk, 6, chars_len(sk)); }
    if ll_is_resst(sk) && ok == 0 { bk = "str"; fi = "2"; }
    if ll_is_optst(sk) && ok == 1 { bk = "St_" + str_slice(sk, 6, chars_len(sk)); }
    if bn == "_" || ((sk == "opti" || sk == "opts" || ll_is_optst(sk)) && ok == 0) {
        return ll_pack(0, ssa0, bk, "");
    }
    let locn: String = "%v_" + bn + "_" + id.to_string();
    ll_slot_ty(locn, ll_ir_alloc(bk), ir);
    let s: Int = ssa0 + 1;
    ll_ir_inst(ir, "getelementptr inbounds", ll_ir_alloc(sk), ll_ssa(s), "ptr " + ptr + ", i32 0, i32 " + fi, 1, 1);
    let s2: Int = s + 1;
    ll_ir_inst(ir, "load", ll_ir_val(bk), ll_ssa(s2), "ptr " + ll_ssa(s) + ", align 8", 1, 1);
    ll_ir_inst(ir, "store", ll_ir_val(bk), "", ll_ssa(s2) + ", ptr " + locn + ", align 8", 1, 1);
    return ll_pack(0, s2, bk, locn);
}

pub fn ll_apply_binop(op: String, lhs: String, rhs: String, ir: &mut IrBuf) -> String {
    let lk: String = ll_pk(lhs);
    let rk: String = ll_pk(rhs);
    let s0: Int = ll_hw(ll_pssa(lhs), ll_pssa(rhs));
    if ll_is_int(lk) && ll_is_int(rk) {
        return ll_apply_intop(op, lhs, rhs, ir);
    }
    if lk == "f64" && rk == "f64" {
        return ll_apply_floatop(op, lhs, rhs, ir);
    }
    if lk == "f64" || rk == "f64" {
        println("ERR\tllvm\tfloat-int mismatch");
        process_exit(1);
        return ll_pack(ll_ppos(rhs), s0, "f64", "");
    }
    if op == "PLUS" && lk == "str" && rk == "str" {
        let la: String = ll_as_val(lhs, s0, ir);
        let ra: String = ll_as_val(rhs, ll_pssa(la), ir);
        let s2: Int = ll_pssa(ra) + 1;
        ll_ir_inst(ir, "call", "{ ptr, i64 }", ll_ssa(s2), "@oo_str_concat({ ptr, i64 } " + ll_ssa(ll_pssa(la)) + ", { ptr, i64 } " + ll_ssa(ll_pssa(ra)) + ")", 1, 1);
        return ll_pack(ll_ppos(rhs), s2, "str", "");
    }
    if op == "PLUS" {
        let s: Int = s0 + 1;
        ll_ir_inst(ir, "add nsw", "i64", ll_ssa(s), ll_ssa(ll_pssa(lhs)) + ", " + ll_ssa(ll_pssa(rhs)), 1, 1);
        return ll_pack(ll_ppos(rhs), s, "i64", "");
    }
    if op == "MINUS" {
        let s: Int = s0 + 1;
        ll_ir_inst(ir, "sub nsw", "i64", ll_ssa(s), ll_ssa(ll_pssa(lhs)) + ", " + ll_ssa(ll_pssa(rhs)), 1, 1);
        return ll_pack(ll_ppos(rhs), s, "i64", "");
    }
    if op == "STAR" {
        let s: Int = s0 + 1;
        ll_ir_inst(ir, "mul nsw", "i64", ll_ssa(s), ll_ssa(ll_pssa(lhs)) + ", " + ll_ssa(ll_pssa(rhs)), 1, 1);
        return ll_pack(ll_ppos(rhs), s, "i64", "");
    }
    if op == "SLASH" {
        let s: Int = s0 + 1;
        ll_ir_inst(ir, "sdiv", "i64", ll_ssa(s), ll_ssa(ll_pssa(lhs)) + ", " + ll_ssa(ll_pssa(rhs)), 1, 1);
        return ll_pack(ll_ppos(rhs), s, "i64", "");
    }
    if op == "PERCENT" {
        let s: Int = s0 + 1;
        ll_ir_inst(ir, "srem", "i64", ll_ssa(s), ll_ssa(ll_pssa(lhs)) + ", " + ll_ssa(ll_pssa(rhs)), 1, 1);
        return ll_pack(ll_ppos(rhs), s, "i64", "");
    }
    if lk == "str" && (op == "EQEQ" || op == "NEQ") {
        let la: String = ll_as_val(lhs, s0, ir);
        let ra: String = ll_as_val(rhs, ll_pssa(la), ir);
        let s2: Int = ll_pssa(ra) + 1;
        ll_ir_inst(ir, "call", "i32", ll_ssa(s2), "@oo_str_eq({ ptr, i64 } " + ll_ssa(ll_pssa(la)) + ", { ptr, i64 } " + ll_ssa(ll_pssa(ra)) + ")", 1, 1);
        let s3: Int = s2 + 1;
        if op == "EQEQ" {
            ll_ir_inst(ir, "icmp ne", "i32", ll_ssa(s3), ll_ssa(s2) + ", 0", 1, 1);
        } else {
            ll_ir_inst(ir, "icmp eq", "i32", ll_ssa(s3), ll_ssa(s2) + ", 0", 1, 1);
        }
        return ll_pack(ll_ppos(rhs), s3, "i1", "");
    }
    let mut pred: String = "eq";
    if op == "NEQ" { pred = "ne"; }
    if op == "LT" { pred = "slt"; }
    if op == "GT" { pred = "sgt"; }
    if op == "LTE" { pred = "sle"; }
    if op == "GTE" { pred = "sge"; }
    if op == "EQEQ" { pred = "eq"; }
    let s: Int = s0 + 1;
    ll_ir_inst(ir, "icmp " + pred, "i64", ll_ssa(s), ll_ssa(ll_pssa(lhs)) + ", " + ll_ssa(ll_pssa(rhs)), 1, 1);
    return ll_pack(ll_ppos(rhs), s, "i1", "");
}

pub fn ll_store(name: String, kind: String, v: String, ssa0: Int, env: String, ir: &mut IrBuf) -> Int {
    let mut dst: String = ll_var(name);
    let loc: String = type_env_get(env, "__l__" + name);
    if loc != "" { dst = loc; }
    if ll_is_agg(kind) {
        if ll_has_slot(v) {
            let s: Int = ssa0 + 1;
            ll_ir_inst(ir, "load", ll_ir_val(kind), ll_ssa(s), "ptr " + ll_pptr(v) + ", align 8", 1, 1);
            ll_ir_inst(ir, "store", ll_ir_val(kind), "", ll_ssa(s) + ", ptr " + dst + ", align 8", 1, 1);
            return s;
        }
        ll_ir_inst(ir, "store", ll_ir_val(kind), "", ll_opnd(v) + ", ptr " + dst + ", align 8", 1, 1);
        return ssa0;
    }
    if ll_is_refk(kind) {
        let pval: String = if ll_pptr(v) != "" { ll_pptr(v) } else { ll_opnd(v) };
        ll_ir_inst(ir, "store", "ptr", "", pval + ", ptr " + dst + ", align 8", 1, 1);
        return ssa0;
    }
    if ll_is_int(kind) && ll_is_int(ll_pk(v)) && ll_pk(v) != kind {
        let cv: String = ll_int_convert(v, ll_hw(ssa0, ll_pssa(v)), kind, ir);
        ll_ir_inst(ir, "store", ll_ir_val(kind), "", ll_opnd(cv) + ", ptr " + dst + ", align 8", 1, 1);
        return ll_pssa(cv);
    }
    ll_ir_inst(ir, "store", ll_ir_val(kind), "", ll_opnd(v) + ", ptr " + dst + ", align 8", 1, 1);
    return ssa0;
}

pub fn ll_cond_i1(v: String, ssa0: Int, ir: &mut IrBuf) -> Int {
    if ll_pk(v) == "i1" {
        if !ll_is_imm(v) { return ll_pssa(v); }
        let s: Int = ssa0 + 1;
        ll_ir_inst(ir, "icmp ne", "i1", ll_ssa(s), ll_opnd(v) + ", 0", 1, 1);
        return s;
    }
    if ll_pk(v) == "f64" { return ll_float_cond(v, ssa0, ir); }
    if ll_is_int(ll_pk(v)) && ll_pk(v) != "i64" {
        let e: String = ll_int_convert(v, ssa0, "i64", ir);
        return ll_cond_i1(e, ll_pssa(e), ir);
    }
    let s: Int = ssa0 + 1;
    ll_ir_inst(ir, "icmp ne", "i64", ll_ssa(s), ll_opnd(v) + ", 0", 1, 1);
    return s;
}
