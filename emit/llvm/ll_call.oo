// # LLVM ctor, load, match, and binop lowering
//
// Logline: Methods on allocas. Binops on SSA. Some/None/Ok/Err constructors.
//
// Setup: Does not import ll_expr. Aggregates use sret/byval.
//
// Beats:
//   1. String concat and eq. Integer icmp including GTE/LTE.
//   2. is_some/is_ok load field 0. to_string uses oo_int_to_str.
//   3. Option Some/None as %OoOptI.
//   4. .val/.err load payload fields by kind. println(i1) prints 0/1 like C.

import "ll_tok.oo";
import "ll_ty.oo";
import "types/types_core.oo";

fn ll_field_tab(kind: String, m: String) -> String {
    if kind == "resi" && m == "val" { return "1:i64"; }
    if kind == "resi" && m == "err" { return "2:str"; }
    if kind == "ress" && (m == "val" || m == "err") { return "1:str"; }
    if kind == "opti" && m == "val" { return "1:i64"; }
    if kind == "opts" && m == "val" { return "1:str"; }
    return "";
}

fn ll_field_load(kind: String, ssa: Int, ptr: String, m: String, ssa0: Int) -> String {
    let tab: String = ll_field_tab(kind, m);
    if tab == "" {
        println("ERR\tllvm\tmethod " + m + " kind " + kind);
        process_exit(1);
    }
    let ci: Int = str_index_of(tab, ":");
    let idx: String = str_slice(tab, 0, ci); let fk: String = str_slice(tab, ci + 1, chars_len(tab));
    let base: String = ll_ensure_ptr(ll_pack(0, ssa, kind, ptr), ssa0);
    let s: Int = ll_pssa(base) + 1;
    println("  " + ll_ssa(s) + " = getelementptr " + ll_ir_alloc(kind) + ", ptr " + ll_pptr(base) + ", i32 0, i32 " + idx);
    let s2: Int = s + 1;
    println("  " + ll_ssa(s2) + " = load " + ll_ir_val(fk) + ", ptr " + ll_ssa(s));
    return ll_pack(0, s2, fk, "");
}

pub fn ll_print_val(kind: String, ssa: Int, ptr: String, ssa0: Int) -> Int {
    if kind == "i1" {
        let n2: Int = ssa0 + 1;
        println("  " + ll_ssa(n2) + " = zext i1 " + ll_ssa(ssa) + " to i64");
        return ll_print_val("i64", n2, "", n2);
    }
    if kind == "str" {
        let mut s: Int = ssa;
        if ptr != "" {
            s = ssa0 + 1;
            println("  " + ll_ssa(s) + " = load { ptr, i64 }, ptr " + ptr);
        }
        let p: Int = s + 1;
        let l: Int = s + 2;
        println("  " + ll_ssa(p) + " = extractvalue { ptr, i64 } " + ll_ssa(s) + ", 0");
        println("  " + ll_ssa(l) + " = extractvalue { ptr, i64 } " + ll_ssa(s) + ", 1");
        println("  call void @oo_print_str(ptr " + ll_ssa(p) + ", i64 " + ll_ssa(l) + ")");
        println("  call void @oo_println()");
        return l;
    }
    if kind == "i64" {
        let n2: Int = ssa0 + 1;
        println("  " + ll_ssa(n2) + " = call { ptr, i64 } @oo_int_to_str(i64 " + ll_ssa(ssa) + ")");
        return ll_print_val("str", n2, "", n2);
    }
    println("ERR\tllvm\tprint kind " + kind);
    process_exit(1);
    return ssa0;
}

pub fn ll_str_gep(toks: List[String], pos: Int, ssa0: Int) -> String {
    let tx: String = ll_t(toks, pos);
    let ln: Int = chars_len(tx) + 1;
    let n: Int = ssa0 + 1;
    println("  " + ll_ssa(n) + " = getelementptr [" + ln.to_string() + " x i8], ptr @.s" + pos.to_string() + ", i64 0, i64 0");
    let n2: Int = n + 1;
    println("  " + ll_ssa(n2) + " = call { ptr, i64 } @oo_str_lit(ptr " + ll_ssa(n) + ")");
    return ll_pack(pos + 1, n2, "str", "");
}

pub fn ll_load_ident(name: String, env: String, ssa0: Int) -> String {
    let k: String = type_env_get(env, name);
    if k == "" {
        println("ERR\tllvm\tundefined " + name);
        process_exit(1);
    }
    let mut ptr: String = ll_var(name);
    let loc: String = type_env_get(env, "__l__" + name);
    if loc != "" { ptr = loc; }
    if ll_is_agg(k) {
        return ll_pack(0, ssa0, k, ptr);
    }
    let n: Int = ssa0 + 1;
    println("  " + ll_ssa(n) + " = load " + ll_ir_val(k) + ", ptr " + ptr);
    return ll_pack(0, n, k, "");
}

pub fn ll_match_tag(sk: String, ptr: String, ssa0: Int) -> Int {
    let s: Int = ssa0 + 1;
    println("  " + ll_ssa(s) + " = getelementptr " + ll_ir_alloc(sk) + ", ptr " + ptr + ", i32 0, i32 0");
    let s2: Int = s + 1;
    println("  " + ll_ssa(s2) + " = load i32, ptr " + ll_ssa(s));
    let s3: Int = s2 + 1;
    println("  " + ll_ssa(s3) + " = icmp ne i32 " + ll_ssa(s2) + ", 0");
    return s3;
}

pub fn ll_match_bind(sk: String, ptr: String, bn: String, ok: Int, id: Int, ssa0: Int) -> String {
    let mut bk: String = "str";
    let mut fi: String = "1";
    if sk == "opti" { bk = "i64"; }
    if sk == "opts" { bk = "str"; }
    if sk == "resi" && ok == 1 { bk = "i64"; }
    if sk == "resi" && ok == 0 { bk = "str"; fi = "2"; }
    if bn == "_" || ((sk == "opti" || sk == "opts") && ok == 0) {
        return ll_pack(0, ssa0, bk, "");
    }
    let locn: String = "%v_" + bn + "_" + id.to_string();
    println("  " + locn + " = alloca " + ll_ir_alloc(bk) + ", align 8");
    let s: Int = ssa0 + 1;
    println("  " + ll_ssa(s) + " = getelementptr " + ll_ir_alloc(sk) + ", ptr " + ptr + ", i32 0, i32 " + fi);
    let s2: Int = s + 1;
    println("  " + ll_ssa(s2) + " = load " + ll_ir_val(bk) + ", ptr " + ll_ssa(s));
    println("  store " + ll_ir_val(bk) + " " + ll_ssa(s2) + ", ptr " + locn);
    return ll_pack(0, s2, bk, locn);
}

pub fn ll_apply_binop(op: String, lhs: String, rhs: String) -> String {
    let lk: String = ll_pk(lhs);
    let rk: String = ll_pk(rhs);
    let s0: Int = ll_hw(ll_pssa(lhs), ll_pssa(rhs));
    if op == "PLUS" && lk == "str" && rk == "str" {
        let la: String = ll_as_val(lhs, s0);
        let ra: String = ll_as_val(rhs, ll_pssa(la));
        let s2: Int = ll_pssa(ra) + 1;
        println("  " + ll_ssa(s2) + " = call { ptr, i64 } @oo_str_concat({ ptr, i64 } " + ll_ssa(ll_pssa(la)) + ", { ptr, i64 } " + ll_ssa(ll_pssa(ra)) + ")");
        return ll_pack(ll_ppos(rhs), s2, "str", "");
    }
    if op == "PLUS" {
        let s: Int = s0 + 1;
        println("  " + ll_ssa(s) + " = add i64 " + ll_ssa(ll_pssa(lhs)) + ", " + ll_ssa(ll_pssa(rhs)));
        return ll_pack(ll_ppos(rhs), s, "i64", "");
    }
    if op == "MINUS" {
        let s: Int = s0 + 1;
        println("  " + ll_ssa(s) + " = sub i64 " + ll_ssa(ll_pssa(lhs)) + ", " + ll_ssa(ll_pssa(rhs)));
        return ll_pack(ll_ppos(rhs), s, "i64", "");
    }
    if op == "STAR" {
        let s: Int = s0 + 1;
        println("  " + ll_ssa(s) + " = mul i64 " + ll_ssa(ll_pssa(lhs)) + ", " + ll_ssa(ll_pssa(rhs)));
        return ll_pack(ll_ppos(rhs), s, "i64", "");
    }
    if op == "SLASH" {
        let s: Int = s0 + 1;
        println("  " + ll_ssa(s) + " = sdiv i64 " + ll_ssa(ll_pssa(lhs)) + ", " + ll_ssa(ll_pssa(rhs)));
        return ll_pack(ll_ppos(rhs), s, "i64", "");
    }
    if op == "PERCENT" {
        let s: Int = s0 + 1;
        println("  " + ll_ssa(s) + " = srem i64 " + ll_ssa(ll_pssa(lhs)) + ", " + ll_ssa(ll_pssa(rhs)));
        return ll_pack(ll_ppos(rhs), s, "i64", "");
    }
    if (op == "EQEQ" || op == "NEQ") && lk == "str" {
        let la: String = ll_as_val(lhs, s0);
        let ra: String = ll_as_val(rhs, ll_pssa(la));
        let s2: Int = ll_pssa(ra) + 1;
        println("  " + ll_ssa(s2) + " = call i32 @oo_str_eq({ ptr, i64 } " + ll_ssa(ll_pssa(la)) + ", { ptr, i64 } " + ll_ssa(ll_pssa(ra)) + ")");
        let s3: Int = s2 + 1;
        if op == "EQEQ" {
            println("  " + ll_ssa(s3) + " = icmp ne i32 " + ll_ssa(s2) + ", 0");
        } else {
            println("  " + ll_ssa(s3) + " = icmp eq i32 " + ll_ssa(s2) + ", 0");
        }
        return ll_pack(ll_ppos(rhs), s3, "i1", "");
    }
    let mut pred: String = "eq";
    if op == "NEQ" { pred = "ne"; }
    if op == "LT" { pred = "slt"; }
    if op == "GT" { pred = "sgt"; }
    if op == "LTE" { pred = "sle"; }
    if op == "GTE" { pred = "sge"; }
    if op == "EQEQ" { pred = "eq"; }
    let s: Int = s0 + 1;
    println("  " + ll_ssa(s) + " = icmp " + pred + " i64 " + ll_ssa(ll_pssa(lhs)) + ", " + ll_ssa(ll_pssa(rhs)));
    return ll_pack(ll_ppos(rhs), s, "i1", "");
}

pub fn ll_store(name: String, kind: String, v: String, ssa0: Int, env: String) -> Int {
    let mut dst: String = ll_var(name);
    let loc: String = type_env_get(env, "__l__" + name);
    if loc != "" { dst = loc; }
    if ll_is_agg(kind) {
        if ll_pptr(v) != "" {
            let s: Int = ssa0 + 1;
            println("  " + ll_ssa(s) + " = load " + ll_ir_val(kind) + ", ptr " + ll_pptr(v));
            println("  store " + ll_ir_val(kind) + " " + ll_ssa(s) + ", ptr " + dst);
            return s;
        }
        println("  store " + ll_ir_val(kind) + " " + ll_ssa(ll_pssa(v)) + ", ptr " + dst);
        return ssa0;
    }
    println("  store " + ll_ir_val(kind) + " " + ll_ssa(ll_pssa(v)) + ", ptr " + dst);
    return ssa0;
}

pub fn ll_cond_i1(v: String, ssa0: Int) -> Int {
    if ll_pk(v) == "i1" { return ll_pssa(v); }
    let s: Int = ssa0 + 1;
    println("  " + ll_ssa(s) + " = icmp ne i64 " + ll_ssa(ll_pssa(v)) + ", 0");
    return s;
}
