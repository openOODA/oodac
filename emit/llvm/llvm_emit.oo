// # Stream a source file to LLVM IR
//
// Logline: Tokenizes source, refuses secret println sinks, scans fn return types and struct layouts, then emits each type decl, function, string pool, and DWARF debug info.
//
// Setup: tokenize_lines, check_secret_println_sinks, llvm_emit_preamble_target, llvm_emit_fn_dbg, llvm_emit_type_decl, llvm_emit_verify, skip_until_semi, llvm_emit_str_pool, llvm_emit_debug_pool, and llvm_ty_map exist.
//
// Beats:
//   1. Seed the fn table from builtins, imports, then this file.
//   2. Prefix string globals with a source digest so modules do not share @.str.0.
//   3. Walk tokens: emit type decls and fns with debug metadata, then emit string and DWARF pools.




import "llvm_emit_preamble.oo";

import "llvm_emit_shims.oo";

import "llvm_emit_ty.oo";

import "llvm_emit_struct.oo";

import "llvm_fntab.oo";

import "llvm_emit_env.oo";

import "llvm_emit_mem.oo";

import "llvm_emit_olist.oo";

import "llvm_emit_arc.oo";

import "llvm_emit_call.oo";

import "llvm_emit_list.oo";

import "llvm_emit_list_set.oo";

import "llvm_emit_assert.oo";

import "llvm_emit_method.oo";

import "llvm_emit_expr.oo";

import "llvm_emit_let.oo";

import "llvm_emit_control.oo";

import "llvm_emit_for.oo";

import "llvm_emit_for_list.oo";

import "llvm_emit_stmt.oo";

import "llvm_emit_match.oo";

import "llvm_emit_fn.oo";

import "llvm_emit_sret.oo";

import "llvm_emit_debug.oo";

import "llvm_emit_pgo.oo";

import "llvm_emit_trait.oo";

import "llvm_emit_trait_call.oo";

import "llvm_emit_simd.oo";

import "llvm_emit_secret_marker.oo";

pub fn llvm_emit_stream(src: String, no_preamble: Bool, extra_fntab: String) {
    llvm_emit_stream_full(src, no_preamble, extra_fntab, "", false, "");
}

pub fn llvm_emit_stream_target(src: String, no_preamble: Bool, extra_fntab: String, triple: String) {
    llvm_emit_stream_full(src, no_preamble, extra_fntab, "", false, triple);
}

// OPEN-70: emit a header-declare for `import_c("path.h")` so the LLVM IR
// can resolve external symbols pulled in by the C ABI. LLVM IR has no
// `#include`; the path is opaque here. When OODA_PATH_PREPROCESS=1, the
// build driver runs cpp and inlines the result. The IR we emit names the
// path as an external global so the linker still has a target. The runtime
// call site (function body) lowers to oo_import_c(...), unchanged.
//
// Two entry forms:
//   (a) import "foo.h" — caller is at KW_IMPORT, pos+1 is STRING.
//   (b) import_c("foo.h") / import_c(cap, "foo.h") — caller is at IDENT, pos+1 is LPAREN.
pub fn llvm_emit_import_c(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos + 1;
if p < n && c_tokk(toks, p) == "LPAREN" { p = p + 1;
}
    // Skip an optional cap first arg: AMP? IDENT ,?
    if p < n && c_tokk(toks, p) == "AMP" {
        p = p + 1;
    }
    if p < n && c_tokk(toks, p) == "IDENT" {
        let save: Int = p;
        p = p + 1;
        if p < n && c_tokk(toks, p) == "COMMA" {
            p = p + 1;
        } else {
            p = save;
        }
    }
    // Read STRING path. <path.h> is a bare IDENT in some lexers, so accept either.
    let mut path: String = "";
    if p < n && c_tokk(toks, p) == "STRING" {
        path = c_tokt(toks, p);
    } else if p < n && c_tokk(toks, p) == "LT" {
        // <path.h>: scan tokens until GT to recover the path.
        p = p + 1;
        let mut parts: String = "";
        while p < n && c_tokk(toks, p) != "GT" && c_tokk(toks, p) != "SEMI" {
            let mut tk: String = c_tokt(toks, p);
            if tk == "" { tk = c_tokk(toks, p);
            }
            if parts == "" { parts = tk;
            } else { parts = parts + tk;
            }
            p = p + 1;
        }
        path = parts;
    }
    // Advance to SEMI.
    while p < n && c_tokk(toks, p) != "SEMI" {
        p = p + 1;
    }
    if p < n && c_tokk(toks, p) == "SEMI" {
        p = p + 1;
    }
    if path != "" {
        println("; import_c: " + path);
        println("declare external global i8* @\"" + path + "\"");
        println("; (path-based imports require an external preprocessor pass: OODA_PATH_PREPROCESS=1)");
    } else {
        println("; import_c: (header path not parsed)");
    }
    return p;
}

pub fn llvm_emit_stream_full(src: String, no_preamble: Bool, extra_fntab: String, path: String, is_debug: Bool, triple: String) {
    if !no_preamble { llvm_emit_preamble_target(triple);
    }
    let toks: List[String] = tokenize_lines(src);
    check_secret_println_sinks(src, toks);
    // P3.27 SECRET/IFC marker surface: recognize secret directive and @secret
    // annotations. Stub — full IFC is a moonshot; this is the recognition
    // hook that future lattice work will plug into.
    llvm_emit_secret_marker_test(src);
    let n = list_len(toks);
    let used: String = llvm_fntab_used(extra_fntab, toks, n);
    let local_tab: String = llvm_scan_fn_rets(toks, n);
    let fntab: String = llvm_builtin_fntab() + used + local_tab + extra_fntab;
    llvm_emit_type_aliases(toks);
    llvm_emit_imported_struct_types(fntab, toks, n);
    llvm_emit_fntab_declares(llvm_builtin_fntab() + used, local_tab);
    let stab: String = llvm_scan_struct_fields(toks, n);
    let ttab: String = llvm_scan_traits(toks, n);
    let itab: String = llvm_scan_impls(toks, n);
    llvm_emit_trait_types(ttab);
    llvm_emit_trait_vtables(ttab, itab);
    let mut str_pfx: String = crypto_sha256_internal(src);
    if chars_len(str_pfx) >= 12 { str_pfx = str_slice(str_pfx, 0, 12);
    }
    let mut pos = 0;
    let mut str_c: String = "0";
    let mut str_t: String = "";
    let mut dbg_meta: String = "";
    let mut dbg_next: String = "20";
    while pos < n { let k: String = field_at(list_get(toks, pos), 0);
    if k == "EOF" { pos = n;
    } else if k == "KW_PUB" || k == "KW_FN" {
            let mut next_k = k;
            if k == "KW_PUB" && pos + 1 < n { next_k = field_at(list_get(toks, pos + 1), 0);
            }
            if next_k == "KW_TYPE" {
                pos = llvm_emit_type_decl(toks, pos, n);
            } else {
                let fn_res: List[String] = llvm_emit_fn_dbg(toks, pos, n, str_c, str_t, fntab, stab, str_pfx, dbg_meta, dbg_next, is_debug, path);
                pos = parse_int(list_get(fn_res, 0));
                str_c = list_get(fn_res, 1);
                str_t = list_get(fn_res, 2);
                if is_debug {
                    dbg_meta = list_get(fn_res, 3);
                    dbg_next = list_get(fn_res, 4);
                }
            }
        } else if k == "KW_TYPE" {
            pos = llvm_emit_type_decl(toks, pos, n);
        } else if k == "KW_TRAIT" {
            pos = llvm_skip_trait(toks, pos, n);
        } else if k == "KW_IMPL" {
            let ir: List[String] = llvm_emit_impl_methods(toks, pos, n, str_c, str_t, fntab, stab, str_pfx, dbg_meta, dbg_next, is_debug, path);
            pos = parse_int(list_get(ir, 0));
            str_c = list_get(ir, 1);
            str_t = list_get(ir, 2);
            if is_debug { dbg_meta = list_get(ir, 3);
            dbg_next = list_get(ir, 4);
            }
        } else if k == "IDENT" {
            let nm: String = field_at(list_get(toks, pos), 3);
            if nm == "trait" {
                pos = llvm_skip_trait(toks, pos, n);
            } else if nm == "impl" {
                let ir: List[String] = llvm_emit_impl_methods(toks, pos, n, str_c, str_t, fntab, stab, str_pfx, dbg_meta, dbg_next, is_debug, path);
                pos = parse_int(list_get(ir, 0));
                str_c = list_get(ir, 1);
                str_t = list_get(ir, 2);
                if is_debug { dbg_meta = list_get(ir, 3);
                dbg_next = list_get(ir, 4);
                }
            } else if nm == "import_c" {
                pos = llvm_emit_import_c(toks, pos, n);
            } else {
                pos = pos + 1;
            }
        } else if k == "KW_VERIFY" {
            let mut vp: Int = pos + 1;
            let mut vname: String = "anon";
            if vp < n && field_at(list_get(toks, vp), 0) == "IDENT" {
                vname = field_at(list_get(toks, vp), 3);
            }
            pos = llvm_emit_verify(toks, pos, n, vname);
        } else if k == "KW_IMPORT" {
            // Peek: import "foo.h" is a C header (string path), not an ooda module.
            // import "foo.oo" / import ident would be the ooda module form; skip.
            let mut is_hdr: Bool = false;
            if pos + 1 < n && c_tokk(toks, pos + 1) == "STRING" {
                let hp: String = c_tokt(toks, pos + 1);
                let hn: Int = chars_len(hp);
                if hn >= 2 && char_at(hp, hn - 2) == "." && char_at(hp, hn - 1) == "h" {
                    is_hdr = true;
                }
            }
            if is_hdr { pos = llvm_emit_import_c(toks, pos, n);
            } else {
                pos = skip_until_semi(toks, pos);
            }
        } else {
            pos = pos + 1;
        }
    }
    llvm_emit_str_pool(str_t);
    if is_debug { llvm_emit_debug_pool(path, dbg_meta);
    }
}
