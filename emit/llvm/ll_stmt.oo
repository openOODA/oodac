// # LLVM statement lowering
//
// Logline: Lower let, assign, if, while, for, match, return, println, and expression statements.
//
// Setup: Env maps names to kinds. Aggregates in %v_name allocas. No emit/c import.
//
// Beats:
//   1. let with annotation stores the expr into an alloca; shadow lets rebind loop/match slots.
//   2. if/while branch on i1. return Ok/Err for Result mains.
//   3. println walks the argument expression.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_expr.oo";
import "ll_call.oo";
import "ll_ctor.oo";
import "ll_match.oo";
import "ll_struct.oo";
import "ll_field.oo";
import "ll_exit.oo";
import "ll_arc.oo";
import "types/types_core.oo";

pub fn ll_emit_stmts(toks: List[String], pos: Int, n: Int, ret_kind: String, env0: String, ssa0: Int, stab: String) -> String {
    let mut p: Int = pos;
    let mut ssa: Int = ssa0;
    let mut env: String = ll_arc_push(env0);
    while p < n {
        let k: String = ll_k(toks, p);
        if k == "RBRACE" || k == "EOF" {
            return ll_pack(p, ll_arc_exit(env, ssa), ret_kind, ll_arc_pop(env));
        }
        if k == "KW_LET" {
            p = p + 1;
            if p < n && ll_k(toks, p) == "KW_MUT" { p = p + 1; }
            let name: String = ll_t(toks, p);
            let site: Int = p;
            p = p + 1;
            let mut ty: String = "i64";
            let mut ann: String = "";
            if p < n && ll_k(toks, p) == "COLON" {
                p = p + 1;
                ty = ll_ty_at(toks, p, n, stab);
                ann = ty;
                p = ll_skip_type(toks, p, n);
            }
            if p < n && ll_k(toks, p) == "EQ" { p = p + 1; }
            let envx: String = type_env_put(env, "__e__", ty);
            let v: String = ll_expr(toks, p, n, ssa, envx);
            p = ll_ppos(v);
            ssa = ll_pssa(v);
            if ll_pk(v) != "" && ll_pk(v) != "void" { ty = ll_pk(v); }
            if ll_is_int(ann) && ll_is_int(ty) && ann != ty { ty = ann; }
            let dst: String = ll_var(name) + "_s" + site.to_string();
            env = type_env_put(env, "__l__" + name, dst);
            println("  " + dst + " = alloca " + ll_ir_alloc(ty) + ", align 8");
            ssa = ll_store(name, ty, v, ssa, env);
            env = type_env_put(env, name, ty);
            if ll_pk(v) == "ilist" || ll_pk(v) == "slist" { env = type_env_put(env, name, ll_pk(v)); }
            if ll_arc_owned(ty) && ll_pptr(v) != "" { ssa = ll_arc_keep(name, ty, env, ssa); }
            if p < n && ll_k(toks, p) == "SEMI" { p = p + 1; }
        } else if k == "KW_IF" {
            let c: String = ll_expr(toks, p + 1, n, ssa, env);
            p = ll_ppos(c);
            ssa = ll_pssa(c);
            let cid: Int = ssa;
            let cv: Int = ll_cond_i1(c, ssa);
            ssa = cv;
            println("  br i1 " + ll_ssa(cv) + ", label %then" + cid.to_string() + ", label %else" + cid.to_string());
            if p < n && ll_k(toks, p) == "LBRACE" { p = p + 1; }
            println("then" + cid.to_string() + ":");
            let th: String = ll_emit_stmts(toks, p, n, ret_kind, type_env_put(env, "__one__", ""), ssa, stab);
            p = ll_ppos(th);
            ssa = ll_pssa(th);
            if p < n && ll_k(toks, p) == "RBRACE" { p = p + 1; }
            if ll_pterm(th) == 0 { println("  br label %end" + cid.to_string()); }
            println("else" + cid.to_string() + ":");
            let mut et: Int = 0;
            if p < n && ll_k(toks, p) == "KW_ELSE" {
                p = p + 1;
                let mut had_else_block: Bool = false;
                if p < n && ll_k(toks, p) == "LBRACE" { p = p + 1; had_else_block = true; }
                let el: String = if had_else_block {
                    ll_emit_stmts(toks, p, n, ret_kind, type_env_put(env, "__one__", ""), ssa, stab)
                } else {
                    ll_emit_stmts(toks, p, n, ret_kind, type_env_put(env, "__one__", "1"), ssa, stab)
                };
                p = ll_ppos(el); ssa = ll_pssa(el);
                if had_else_block && p < n && ll_k(toks, p) == "RBRACE" { p = p + 1; }
                et = ll_pterm(el);
            }
            if et == 0 { println("  br label %end" + cid.to_string()); }
            println("end" + cid.to_string() + ":");
            if ll_pterm(th) != 0 && et != 0 {
                println("  unreachable");
                p = ll_skip_to_rbrace(toks, p, n);
                return ll_pack(p, ssa, ret_kind, env) + "\t1";
            }
        } else if k == "KW_WHILE" {
            let wid: Int = ssa + 1;
            println("  br label %wcond" + wid.to_string());
            println("wcond" + wid.to_string() + ":");
            let c: String = ll_expr(toks, p + 1, n, ssa, env);
            p = ll_ppos(c);
            ssa = ll_pssa(c);
            let cv: Int = ll_cond_i1(c, ssa);
            ssa = cv;
            println("  br i1 " + ll_ssa(cv) + ", label %wbody" + wid.to_string() + ", label %wend" + wid.to_string());
            if p < n && ll_k(toks, p) == "LBRACE" { p = p + 1; }
            println("wbody" + wid.to_string() + ":");
            let envb: String = type_env_put(type_env_put(type_env_put(env, "__brk__", "wend" + wid.to_string()), "__cont__", "wcond" + wid.to_string()), "__one__", "");
            let bd: String = ll_emit_stmts(toks, p, n, ret_kind, envb, ssa, stab);
            p = ll_ppos(bd); ssa = ll_pssa(bd);
            if p < n && ll_k(toks, p) == "RBRACE" { p = p + 1; }
            if ll_pterm(bd) == 0 { println("  br label %wcond" + wid.to_string()); }
            println("wend" + wid.to_string() + ":");
        } else if k == "KW_FOR" {
            p = p + 1;
            if p >= n || ll_k(toks, p) != "IDENT" {
                println("ERR\tllvm\tfor residual (expected loop IDENT)");
                process_exit(1);
            }
            let fname: String = ll_t(toks, p);
            p = p + 1;
            if p >= n {
                println("ERR\tllvm\tfor residual (need 'in')");
                process_exit(1);
            }
            if ll_k(toks, p) == "KW_IN" { p = p + 1; } else {
                if ll_k(toks, p) != "IDENT" || ll_t(toks, p) != "in" {
                    println("ERR\tllvm\tfor residual (need 'in')");
                    process_exit(1);
                }
                p = p + 1;
            }
            let mut lo: String = ll_expr(toks, p, n, ssa, env);
            p = ll_ppos(lo);
            ssa = ll_pssa(lo);
            if p >= n || ll_k(toks, p) != "DOTDOT" {
                println("ERR\tllvm\tfor residual (expected .. between bounds)");
                process_exit(1);
            }
            p = p + 1;
            let mut hi: String = ll_expr(toks, p, n, ssa, env);
            p = ll_ppos(hi);
            ssa = ll_pssa(hi);
            if ll_is_int(ll_pk(lo)) && ll_pk(lo) != "i64" {
                lo = ll_int_convert(lo, ssa, "i64");
                ssa = ll_pssa(lo);
            }
            if ll_is_int(ll_pk(hi)) && ll_pk(hi) != "i64" {
                hi = ll_int_convert(hi, ssa, "i64");
                ssa = ll_pssa(hi);
            }
            if ll_pk(lo) != "i64" || ll_pk(hi) != "i64" {
                println("ERR\tllvm\tfor residual (i64 range bounds only)");
                process_exit(1);
            }
            let mut los: Int = ll_pssa(lo);
            if ll_pptr(lo) != "" {
                ssa = ssa + 1;
                println("  " + ll_ssa(ssa) + " = load i64, ptr " + ll_pptr(lo));
                los = ssa;
            }
            let mut his: Int = ll_pssa(hi);
            if ll_pptr(hi) != "" {
                ssa = ssa + 1;
                println("  " + ll_ssa(ssa) + " = load i64, ptr " + ll_pptr(hi));
                his = ssa;
            }
            let fid: Int = ssa + 1;
            let fvar: String = ll_var(fname) + "_" + fid.to_string();
            println("  " + fvar + " = alloca i64, align 8");
            println("  store i64 " + ll_ssa(los) + ", ptr " + fvar);
            let envf: String = type_env_put(type_env_put(type_env_put(type_env_put(type_env_put(env, fname, "i64"), "__l__" + fname, fvar), "__brk__", "fend" + fid.to_string()), "__cont__", "fcond" + fid.to_string()), "__one__", "");
            println("  br label %fcond" + fid.to_string());
            println("fcond" + fid.to_string() + ":");
            ssa = ssa + 1;
            println("  " + ll_ssa(ssa) + " = load i64, ptr " + fvar);
            ssa = ssa + 1;
            println("  " + ll_ssa(ssa) + " = icmp slt i64 " + ll_ssa(ssa - 1) + ", " + ll_ssa(his));
            println("  br i1 " + ll_ssa(ssa) + ", label %fbody" + fid.to_string() + ", label %fend" + fid.to_string());
            if p < n && ll_k(toks, p) == "LBRACE" { p = p + 1; }
            println("fbody" + fid.to_string() + ":");
            let fb: String = ll_emit_stmts(toks, p, n, ret_kind, envf, ssa, stab);
            p = ll_ppos(fb); ssa = ll_pssa(fb);
            if p < n && ll_k(toks, p) == "RBRACE" { p = p + 1; }
            if ll_pterm(fb) == 0 {
                ssa = ssa + 1;
                println("  " + ll_ssa(ssa) + " = load i64, ptr " + fvar);
                ssa = ssa + 1;
                println("  " + ll_ssa(ssa) + " = add i64 " + ll_ssa(ssa - 1) + ", 1");
                println("  store i64 " + ll_ssa(ssa) + ", ptr " + fvar);
                println("  br label %fcond" + fid.to_string());
            }
            println("fend" + fid.to_string() + ":");
        } else if k == "KW_MATCH" {
            let ms: String = ll_match_stmt(toks, p, n, ssa, env, ret_kind, stab);
            p = ll_ppos(ms); ssa = ll_pssa(ms);
            if ll_pterm(ms) != 0 {
                return ms;
            }
        } else if k == "KW_RETURN" {
            let rt: String = ll_return_stmt(toks, p, n, ssa, env, ret_kind, stab);
            return rt;
        } else if k == "IDENT" && ll_t(toks, p) == "println" {
            let v: String = ll_expr(toks, p + 2, n, ssa, env);
            p = ll_ppos(v);
            if p < n && ll_k(toks, p) == "RPAREN" { p = p + 1; }
            if p < n && ll_k(toks, p) == "SEMI" { p = p + 1; }
            ssa = ll_print_val(ll_pk(v), ll_pssa(v), ll_pptr(v), ll_pssa(v));
        } else if k == "IDENT" && (ll_t(toks, p) == "break" || ll_t(toks, p) == "continue") && p + 1 < n && (ll_k(toks, p + 1) == "SEMI" || ll_k(toks, p + 1) == "RBRACE") {
            let bk: String = ll_break_stmt(toks, p, n, ssa, env, ret_kind);
            return bk;
        } else if k == "IDENT" && p + 3 < n && ll_k(toks, p + 1) == "DOT" && ll_k(toks, p + 2) == "IDENT" && ll_k(toks, p + 3) == "EQ" && ll_is_struct(type_env_get(env, ll_t(toks, p))) {
            let sf: String = ll_store_field_stmt(toks, p, n, ssa, env, stab);
            p = ll_ppos(sf); ssa = ll_pssa(sf);
        } else if k == "STAR" && p + 2 < n && ll_k(toks, p + 1) == "IDENT" && ll_k(toks, p + 2) == "EQ" {
            let ds: String = ll_store_deref_stmt(toks, p, n, ssa, env);
            p = ll_ppos(ds); ssa = ll_pssa(ds);
        } else if k == "IDENT" && p + 1 < n && ll_k(toks, p + 1) == "EQ" {
            let name: String = ll_t(toks, p);
            let ty: String = type_env_get(env, name);
            let v: String = ll_expr(toks, p + 2, n, ssa, type_env_put(env, "__e__", ty));
            p = ll_ppos(v);
            ssa = ll_pssa(v);
            if ll_arc_owned(ty) {
                if ll_pptr(v) != "" { ssa = ll_arc_keep_ptr(ty, ll_pptr(v), ssa); }
                ssa = ll_arc_rel(name, ty, env, ssa);
            }
            ssa = ll_store(name, ty, v, ssa, env);
            if ll_pk(v) == "ilist" || ll_pk(v) == "slist" { env = type_env_put(env, name, ll_pk(v)); }
            if p < n && ll_k(toks, p) == "SEMI" { p = p + 1; }
        } else {
            let v: String = ll_expr(toks, p, n, ssa, env);
            p = ll_ppos(v);
            ssa = ll_pssa(v);
            if p < n && ll_k(toks, p) == "SEMI" { p = p + 1; }
            if ll_pk(v) == "noret" {
                p = ll_skip_to_rbrace(toks, p, n);
                return ll_pack(p, ssa, ret_kind, ll_arc_pop(env)) + "\t1";
            }
        }
        if type_env_get(env0, "__one__") != "" {
            return ll_pack(p, ssa, ret_kind, env);
        }
    }
    return ll_pack(p, ssa, ret_kind, env);
}
