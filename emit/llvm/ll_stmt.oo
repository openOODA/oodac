// # LLVM statement lowering
//
// Logline: Lower let, assign, if, while, for, match, return, println, and expression statements.
//
// Setup: Env maps names to kinds. Aggregates in %v_name allocas. No emit/c import.
//
// Beats:
//   1. let with annotation stores the expr into an alloca; shadow lets rebind loop/match slots.
//   2. if/while branch on i1. return Ok/Err for Result mains.
//   3. println walks the argument expression.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_expr.oo";
import "ll_call.oo";
import "ll_di.oo";
import "ll_match.oo";
import "ll_struct.oo";
import "ll_field.oo";
import "ll_stmt_for.oo";
import "ll_exit.oo";
import "ll_arc.oo";
import "ll_print.oo";
import "ll_slot.oo";
import "types/types_core.oo";
import "ll_ir.oo";

pub fn ll_emit_stmts(toks: List[String], pos: Int, n: Int, ret_kind: String, env0: String, ssa0: Int, stab: String, ir: &mut IrBuf) -> String {
    let mut p: Int = pos;
    let mut ssa: Int = ssa0;
    let mut env: String = ll_arc_push(env0);
    while p < n {
        let k: String = ll_k(toks, p);
        ll_ir_set_loc(ir, ll_line(toks, p), ll_col(toks, p));
        if k == "RBRACE" || k == "EOF" {
            return ll_pack(p, ll_arc_exit(env, ssa, ir), ret_kind, ll_arc_pop(env));
        }
        if k == "KW_LET" {
            p = p + 1;
            if p < n && ll_k(toks, p) == "KW_MUT" { p = p + 1; }
            let name: String = ll_t(toks, p);
            let site: Int = p;
            p = p + 1;
            let mut ty: String = "i64";
            let mut ann: String = "";
            if p < n && ll_k(toks, p) == "COLON" {
                p = p + 1;
                ty = ll_ty_at(toks, p, n, stab);
                ann = ty;
                p = ll_skip_type(toks, p, n);
            }
            if p < n && ll_k(toks, p) == "EQ" { p = p + 1; }
            let envx: String = type_env_put(env, "__e__", ty);
            let v: String = ll_expr(toks, p, n, ssa, envx, ir);
            p = ll_ppos(v);
            ssa = ll_pssa(v);
            if ll_pk(v) != "" && ll_pk(v) != "void" { ty = ll_pk(v); }
            if ll_is_int(ann) && ll_is_int(ty) && ann != ty { ty = ann; }
            let dst: String = ll_var(name) + "_s" + site.to_string();
            env = type_env_put(env, "__l__" + name, dst);
            ll_slot_ty(dst, ll_ir_alloc(ty), ir);
            ssa = ll_store(name, ty, v, ssa, env, ir);
            let vid: Int = ll_di_local_var(name, ir.scope_id, ll_line(toks, site), ll_di_type_id(ty), site);
            ll_ir_inst(ir, "call", "void", "", "@llvm.dbg.declare(metadata ptr " + dst + ", metadata !" + vid.to_string() + ", metadata !DIExpression())", ll_line(toks, site), ll_col(toks, site));
            env = type_env_put(env, name, ty);
            if ll_pk(v) == "ilist" || ll_pk(v) == "slist" { env = type_env_put(env, name, ll_pk(v)); }
            if ll_arc_owned(ty) && ll_is_var(ll_pptr(v)) { ssa = ll_arc_keep(name, ty, env, ssa, ir); }
            if p < n && ll_k(toks, p) == "SEMI" { p = p + 1; }
        } else if k == "KW_IF" {
            let p_sc: Int = ir.scope_id;
            let th_sc: Int = ll_di_lex_block(p_sc, ll_line(toks, p), ll_col(toks, p), p);
            let c: String = ll_expr(toks, p + 1, n, ssa, env, ir);
            p = ll_ppos(c);
            ssa = ll_pssa(c);
            let cid: Int = ssa;
            let cv: Int = ll_cond_i1(c, ssa, ir);
            ssa = cv;
            ll_ir_inst(ir, "br", "i1", "", ll_ssa(cv) + ", label %then" + cid.to_string() + ", label %else" + cid.to_string(), ll_line(toks, p), ll_col(toks, p));
            if p < n && ll_k(toks, p) == "LBRACE" { p = p + 1; }
            ll_ir_label(ir, "then" + cid.to_string());
            ll_ir_set_scope(ir, th_sc);
            let th: String = ll_emit_stmts(toks, p, n, ret_kind, type_env_put(env, "__one__", ""), ssa, stab, ir);
            p = ll_ppos(th);
            ssa = ll_pssa(th);
            if p < n && ll_k(toks, p) == "RBRACE" { p = p + 1; }
            if ll_pterm(th) == 0 { ll_ir_inst(ir, "br", "", "", "label %end" + cid.to_string(), 1, 1); }
            ll_ir_label(ir, "else" + cid.to_string());
            let mut et: Int = 0;
            if p < n && ll_k(toks, p) == "KW_ELSE" {
                let el_sc: Int = ll_di_lex_block(p_sc, ll_line(toks, p), ll_col(toks, p), p);
                ll_ir_set_scope(ir, el_sc);
                p = p + 1;
                let mut had_else_block: Bool = false;
                if p < n && ll_k(toks, p) == "LBRACE" { p = p + 1; had_else_block = true; }
                let el: String = if had_else_block {
                    ll_emit_stmts(toks, p, n, ret_kind, type_env_put(env, "__one__", ""), ssa, stab, ir)
                } else {
                    ll_emit_stmts(toks, p, n, ret_kind, type_env_put(env, "__one__", "1"), ssa, stab, ir)
                };
                p = ll_ppos(el); ssa = ll_pssa(el);
                if had_else_block && p < n && ll_k(toks, p) == "RBRACE" { p = p + 1; }
                et = ll_pterm(el);
            }
            ll_ir_set_scope(ir, p_sc);
            if et == 0 { ll_ir_inst(ir, "br", "", "", "label %end" + cid.to_string(), 1, 1); }
            ll_ir_label(ir, "end" + cid.to_string());
            if ll_pterm(th) != 0 && et != 0 {
                ll_ir_inst(ir, "unreachable", "", "", "", 1, 1);
                p = ll_skip_to_rbrace(toks, p, n);
                return ll_pack(p, ssa, ret_kind, env) + "\t1";
            }
        } else if k == "KW_WHILE" {
            let p_sc: Int = ir.scope_id;
            let wh_sc: Int = ll_di_lex_block(p_sc, ll_line(toks, p), ll_col(toks, p), p);
            let wid: Int = ssa + 1;
            ll_ir_inst(ir, "br", "", "", "label %wcond" + wid.to_string(), 1, 1);
            ll_ir_label(ir, "wcond" + wid.to_string());
            let c: String = ll_expr(toks, p + 1, n, ssa, env, ir);
            p = ll_ppos(c);
            ssa = ll_pssa(c);
            let cv: Int = ll_cond_i1(c, ssa, ir);
            ssa = cv;
            ll_ir_inst(ir, "br", "i1", "", ll_ssa(cv) + ", label %wbody" + wid.to_string() + ", label %wend" + wid.to_string(), 1, 1);
            if p < n && ll_k(toks, p) == "LBRACE" { p = p + 1; }
            ll_ir_label(ir, "wbody" + wid.to_string());
            ll_ir_set_scope(ir, wh_sc);
            let envb: String = type_env_put(type_env_put(type_env_put(env, "__brk__", "wend" + wid.to_string()), "__cont__", "wcond" + wid.to_string()), "__one__", "");
            let bd: String = ll_emit_stmts(toks, p, n, ret_kind, envb, ssa, stab, ir);
            p = ll_ppos(bd); ssa = ll_pssa(bd);
            if p < n && ll_k(toks, p) == "RBRACE" { p = p + 1; }
            if ll_pterm(bd) == 0 { ll_ir_inst(ir, "br", "", "", "label %wcond" + wid.to_string(), 1, 1); }
            ll_ir_set_scope(ir, p_sc);
            ll_ir_label(ir, "wend" + wid.to_string());
        } else if k == "KW_FOR" {
            let p_sc: Int = ir.scope_id;
            let for_sc: Int = ll_di_lex_block(p_sc, ll_line(toks, p), ll_col(toks, p), p);
            let fname: String = ll_t(toks, p + 1);
            let fi: String = ll_for_init(toks, p + 1, n, ssa, env, ir);
            p = ll_ppos(fi); ssa = ll_pssa(fi);
            let fid: String = ll_pk(fi);
            let fvar: String = ll_pptr(fi);
            let fvid: Int = ll_di_local_var(fname, for_sc, ll_line(toks, p + 1), 15, p + 1);
            ll_ir_inst(ir, "call", "void", "", "@llvm.dbg.declare(metadata ptr " + fvar + ", metadata !" + fvid.to_string() + ", metadata !DIExpression())", ll_line(toks, p + 1), ll_col(toks, p + 1));
            let envf: String = type_env_put(type_env_put(type_env_put(type_env_put(type_env_put(env, fname, "i64"), "__l__" + fname, fvar), "__brk__", "fend" + fid), "__cont__", "fstep" + fid), "__one__", "");
            if p < n && ll_k(toks, p) == "LBRACE" { p = p + 1; }
            ll_ir_label(ir, "fbody" + fid);
            ll_ir_set_scope(ir, for_sc);
            let fb: String = ll_emit_stmts(toks, p, n, ret_kind, envf, ssa, stab, ir);
            p = ll_ppos(fb); ssa = ll_pssa(fb);
            if p < n && ll_k(toks, p) == "RBRACE" { p = p + 1; }
            if ll_pterm(fb) == 0 {
                ll_ir_inst(ir, "br", "", "", "label %fstep" + fid, 1, 1);
            }
            ssa = ll_for_step(fid, fvar, ssa, ir);
            ll_ir_set_scope(ir, p_sc);
        } else if k == "LBRACE" {
            let p_sc: Int = ir.scope_id;
            let blk_sc: Int = ll_di_lex_block(p_sc, ll_line(toks, p), ll_col(toks, p), p);
            ll_ir_set_scope(ir, blk_sc);
            let blk: String = ll_emit_stmts(toks, p + 1, n, ret_kind, env, ssa, stab, ir);
            p = ll_ppos(blk); ssa = ll_pssa(blk);
            if p < n && ll_k(toks, p) == "RBRACE" { p = p + 1; }
            ll_ir_set_scope(ir, p_sc);

        } else if k == "KW_MATCH" {
            let ms: String = ll_match_stmt(toks, p, n, ssa, env, ret_kind, stab, ir);
            p = ll_ppos(ms); ssa = ll_pssa(ms);
            if ll_pterm(ms) != 0 {
                return ms;
            }
        } else if k == "KW_RETURN" {
            let rt: String = ll_return_stmt(toks, p, n, ssa, env, ret_kind, stab, ir);
            return rt;
        } else if k == "IDENT" && ll_t(toks, p) == "println" {
            let v: String = ll_expr(toks, p + 2, n, ssa, env, ir);
            p = ll_ppos(v);
            if p < n && ll_k(toks, p) == "RPAREN" { p = p + 1; }
            if p < n && ll_k(toks, p) == "SEMI" { p = p + 1; }
            ssa = ll_print_val(ll_pk(v), ll_pssa(v), ll_pptr(v), ll_pssa(v), ir);
        } else if k == "IDENT" && (ll_t(toks, p) == "break" || ll_t(toks, p) == "continue") && p + 1 < n && (ll_k(toks, p + 1) == "SEMI" || ll_k(toks, p + 1) == "RBRACE") {
            let bk: String = ll_break_stmt(toks, p, n, ssa, env, ret_kind, ir);
            return bk;
        } else if k == "IDENT" && p + 3 < n && ll_k(toks, p + 1) == "DOT" && ll_k(toks, p + 2) == "IDENT" && ll_k(toks, p + 3) == "EQ" && ll_is_struct(type_env_get(env, ll_t(toks, p))) {
            let sf: String = ll_store_field_stmt(toks, p, n, ssa, env, stab, ir);
            p = ll_ppos(sf); ssa = ll_pssa(sf);
        } else if k == "STAR" && p + 2 < n && ll_k(toks, p + 1) == "IDENT" && ll_k(toks, p + 2) == "EQ" {
            let ds: String = ll_store_deref_stmt(toks, p, n, ssa, env, ir);
            p = ll_ppos(ds); ssa = ll_pssa(ds);
        } else if k == "IDENT" && p + 1 < n && ll_k(toks, p + 1) == "EQ" {
            let name: String = ll_t(toks, p);
            let ty: String = type_env_get(env, name);
            let v: String = ll_expr(toks, p + 2, n, ssa, type_env_put(env, "__e__", ty), ir);
            p = ll_ppos(v);
            ssa = ll_pssa(v);
            if ll_arc_owned(ty) {
                if ll_is_var(ll_pptr(v)) { ssa = ll_arc_keep_ptr(ty, ll_pptr(v), ssa, ir); }
                ssa = ll_arc_rel(name, ty, env, ssa, ir);
            }
            ssa = ll_store(name, ty, v, ssa, env, ir);
            if ll_pk(v) == "ilist" || ll_pk(v) == "slist" { env = type_env_put(env, name, ll_pk(v)); }
            if p < n && ll_k(toks, p) == "SEMI" { p = p + 1; }
        } else {
            let v: String = ll_expr(toks, p, n, ssa, env, ir);
            p = ll_ppos(v);
            ssa = ll_pssa(v);
            if p < n && ll_k(toks, p) == "SEMI" { p = p + 1; }
            if ll_pk(v) == "noret" {
                p = ll_skip_to_rbrace(toks, p, n);
                return ll_pack(p, ssa, ret_kind, ll_arc_pop(env)) + "\t1";
            }
        }
        if type_env_get(env0, "__one__") != "" {
            return ll_pack(p, ssa, ret_kind, env);
        }
    }
    return ll_pack(p, ssa, ret_kind, env);
}

pub fn ll_store_field_stmt(toks: List[String], p0: Int, n: Int, ssa0: Int, env: String, stab: String, ir: &mut IrBuf) -> String {
    let p: Int = p0;
    let mut bk: String = type_env_get(env, ll_t(toks, p));
    let mut fi: String = ll_struct_field(bk, ll_t(toks, p + 2));
    if fi == "" && ll_is_struct(bk) {
        bk = ll_rich_of(env, str_slice(ll_st_basek(bk), 3, chars_len(ll_st_basek(bk))));
        fi = ll_struct_field(bk, ll_t(toks, p + 2));
    }
    if fi == "" || str_index_of(fi, ":") < 0 {
        println("ERR\tllvm\tunknown field " + ll_t(toks, p + 2));
        process_exit(1);
    }
    let ck: Int = str_index_of(fi, ":");
    let fk: String = str_slice(fi, ck + 1, chars_len(fi));
    let mut bptr: String = ll_var(ll_t(toks, p));
    let bloc: String = type_env_get(env, "__l__" + ll_t(toks, p));
    if bloc != "" { bptr = bloc; }
    let fp: String = ll_struct_field_ptr(bk, bptr, ll_t(toks, p + 2), ssa0, ir);
    let rhs0: String = ll_expr(toks, p + 4, n, ll_pssa(fp), type_env_put(env, "__e__", fk), ir);
    let rhs: String = ll_int_convert(rhs0, ll_pssa(rhs0), fk, ir);
    let mut np: Int = ll_ppos(rhs); let mut ns: Int = ll_pssa(rhs);
    let mut src: String = ll_opnd(rhs);
    if ll_has_slot(rhs) {
        ns = ns + 1;
        ll_ir_inst(ir, "load", ll_ir_val(fk), ll_ssa(ns), "ptr " + ll_pptr(rhs) + ", align 8", 1, 1);
        src = ll_ssa(ns);
    }
    ll_ir_inst(ir, "store", ll_ir_val(fk), "", src + ", ptr " + ll_pptr(fp) + ", align 8", 1, 1);
    if np < n && ll_k(toks, np) == "SEMI" { np = np + 1; }
    return ll_pack(np, ns, fk, "");
}
