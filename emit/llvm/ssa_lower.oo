// # AST-to-SSA Lowering Engine
//
// Logline: Lowers AST representation into Static Single Assignment (SSA) form.
//
// Setup: import sibling {ssa_ir, ssa_lower_util, ssa_lower_simd, ssa_lower_expr}.oo and oodac/ast/ANCHOR.oo.
//
// Beats:
//   1. Build SSA context, symbols, and basic blocks.
//   2. Lower AST expressions and statements to SSA instructions.
//   3. Lower typed 256-bit SIMD vector intrinsics without heuristics.

import "ssa_ir.oo";
import "ssa_lower_util.oo";
import "ssa_lower_simd.oo";
import "ssa_lower_expr.oo";
import "ast/ANCHOR.oo";

pub fn ssa_lower_expr(ctx: SsaLowerContext, expr: String) -> SsaLowerContext {
    let tag: String = ast_tag(expr);
    let args: String = ssa_lower_args_of(expr);
    if tag == "EMatch" {
        let scrut: String = list_get_str(args, 0);
        let arms_str: String = list_get_str(args, 1);
        let mut c1: SsaLowerContext = ssa_lower_expr(ctx, scrut);
        let sval: Int = c1.last_val;
        let cur_fn: SsaFunction = c1.fn_data;
        let merge_bid: Int = cur_fn.block_count;
        c1 = ssa_ctx_add_block(c1, "match.merge." + merge_bid.to_string());
        let n_arms: Int = (0 + list_len_str(arms_str));
        let mut i: Int = 0;
        while i < n_arms {
            let arm: String = list_get_str(arms_str, i);
            if arm != "" && !ast_is(arm, "SEmpty") {
                let cur_fn2: SsaFunction = c1.fn_data;
                let case_bid: Int = cur_fn2.block_count;
                c1 = ssa_ctx_add_block(c1, "match.case." + case_bid.to_string());
                let cmp_reg: Int = c1.next_reg;
                let c_cmp: SsaLowerContext = ssa_ctx_emit_lhs(c1, cmp_reg, (0 + ssa_op_icmp_eq()), sval, sval);
                let c_case: SsaLowerContext = ssa_ctx_set_block(ssa_ctx_emit_lhs(c_cmp, case_bid, (0 + ssa_op_cond_br()), merge_bid, cmp_reg), case_bid);
                c1 = ssa_ctx_emit(ssa_lower_any(c_case, list_get_str(ssa_lower_args_of(arm), 1)), 0, (0 + ssa_op_br()), merge_bid);
            }
            i = i + 1;
        }
        return ssa_ctx_set_block(c1, merge_bid);
    }
    if tag == "EIf" { return ssa_lower_if(ctx, list_get_str(args, 0), list_get_str(args, 1), list_get_str(args, 2)); }
    if tag == "AstBlock" { return ssa_lower_block(ctx, expr); }
    return ssa_lower_expr_node(ctx, expr);
}

fn ssa_lower_if(ctx: SsaLowerContext, cond: String, then_e: String, else_e: String) -> SsaLowerContext {
    let mut c1: SsaLowerContext = ssa_lower_expr(ctx, cond);
    let orig_bid: Int = c1.cur_block;
    let cond_val: Int = c1.last_val;
    let cur_fn1: SsaFunction = c1.fn_data;
    let then_bid: Int = cur_fn1.block_count;
    c1 = ssa_ctx_add_block(c1, "if.then." + then_bid.to_string());
    let cur_fn2: SsaFunction = c1.fn_data;
    let else_bid: Int = cur_fn2.block_count;
    c1 = ssa_ctx_add_block(c1, "if.else." + else_bid.to_string());
    let cur_fn3: SsaFunction = c1.fn_data;
    let merge_bid: Int = cur_fn3.block_count;
    c1 = ssa_ctx_add_block(c1, "if.merge." + merge_bid.to_string());
    c1 = ssa_ctx_emit_lhs(ssa_ctx_set_block(c1, orig_bid), then_bid, (0 + ssa_op_cond_br()), else_bid, cond_val);
    c1 = ssa_ctx_emit(ssa_lower_any(ssa_ctx_set_block(c1, then_bid), then_e), 0, (0 + ssa_op_br()), merge_bid);
    c1 = ssa_ctx_set_block(c1, else_bid);
    if else_e != "" && !ast_is(else_e, "SEmpty") { c1 = ssa_lower_any(c1, else_e); }
    c1 = ssa_ctx_emit(c1, 0, (0 + ssa_op_br()), merge_bid);
    return ssa_ctx_set_block(c1, merge_bid);
}

fn ssa_lower_any(ctx: SsaLowerContext, node: String) -> SsaLowerContext {
    let tag: String = ast_tag(node);
    if tag == "AstBlock" { return ssa_lower_block(ctx, node); }
    if tag == "SLet" || tag == "SLetMut" || tag == "SAssign" || tag == "SReturn" || tag == "SWhile" || tag == "SFor" || tag == "SExpr" { return ssa_lower_stmt(ctx, node); }
    return ssa_lower_expr(ctx, node);
}

pub fn ssa_lower_stmt(ctx: SsaLowerContext, stmt: String) -> SsaLowerContext {
    let tag: String = ast_tag(stmt);
    let args: String = ssa_lower_args_of(stmt);
    if tag == "SLet" || tag == "SLetMut" {
        let name: String = list_get_str(args, 0);
        let rhs: String = list_get_str(args, 2);
        let slot: Int = ctx.next_reg;
        let mut c1: SsaLowerContext = ssa_ctx_set_last(ctx, slot + 1, ctx.last_val);
        c1 = ssa_ctx_emit(c1, slot, (0 + ssa_op_alloca()), 0);
        c1 = ssa_sym_bind(c1, name, slot);
        if rhs != "" && !ast_is(rhs, "SEmpty") {
            c1 = ssa_lower_expr(c1, rhs);
            let val: Int = c1.last_val;
            c1 = ssa_ctx_emit_lhs(c1, 0, (0 + ssa_op_store()), slot, val);
        }
        return c1;
    }
    if tag == "SAssign" {
        let lhs_var: String = list_get_str(args, 0);
        let rhs: String = list_get_str(args, 1);
        let mut c1: SsaLowerContext = ssa_lower_expr(ctx, rhs);
        let val: Int = c1.last_val;
        let slot: Int = (0 + ssa_sym_lookup(c1, lhs_var));
        c1 = ssa_ctx_emit_lhs(c1, 0, (0 + ssa_op_store()), slot, val);
        return ssa_ctx_set_last(c1, c1.next_reg, val);
    }
    if tag == "SReturn" {
        let expr: String = list_get_str(args, 0);
        if expr != "" && !ast_is(expr, "SEmpty") {
            let c1: SsaLowerContext = ssa_lower_expr(ctx, expr);
            return ssa_ctx_emit_lhs(c1, 0, (0 + ssa_op_ret()), c1.last_val, c1.last_val);
        }
        return ssa_ctx_emit(ctx, 0, (0 + ssa_op_ret()), 0);
    }
    if tag == "SExpr" { return ssa_lower_expr(ctx, list_get_str(args, 0)); }
    if tag == "SWhile" { return ssa_lower_while(ctx, list_get_str(args, 0), list_get_str(args, 1)); }
    if tag == "SFor" { return ssa_lower_for(ctx, list_get_str(args, 0), list_get_str(args, 1), list_get_str(args, 2), list_get_str(args, 3)); }
    return ctx;
}

fn ssa_lower_while(ctx: SsaLowerContext, cond: String, body: String) -> SsaLowerContext {
    let orig_bid: Int = ctx.cur_block;
    let cur_fn1: SsaFunction = ctx.fn_data;
    let cond_bid: Int = cur_fn1.block_count;
    let mut c1: SsaLowerContext = ssa_ctx_add_block(ctx, "while.cond." + cond_bid.to_string());
    let cur_fn2: SsaFunction = c1.fn_data;
    let body_bid: Int = cur_fn2.block_count;
    c1 = ssa_ctx_add_block(c1, "while.body." + body_bid.to_string());
    let cur_fn3: SsaFunction = c1.fn_data;
    let exit_bid: Int = cur_fn3.block_count;
    c1 = ssa_ctx_add_block(c1, "while.exit." + exit_bid.to_string());
    c1 = ssa_ctx_emit(ssa_ctx_set_block(c1, orig_bid), 0, (0 + ssa_op_br()), cond_bid);
    c1 = ssa_lower_expr(ssa_ctx_set_block(c1, cond_bid), cond);
    c1 = ssa_ctx_emit_lhs(c1, body_bid, (0 + ssa_op_cond_br()), exit_bid, c1.last_val);
    c1 = ssa_ctx_emit(ssa_lower_any(ssa_ctx_set_block(c1, body_bid), body), 0, (0 + ssa_op_br()), cond_bid);
    return ssa_ctx_set_block(c1, exit_bid);
}

fn ssa_lower_for(ctx: SsaLowerContext, init: String, cond: String, step: String, body: String) -> SsaLowerContext {
    let mut c1: SsaLowerContext = ctx;
    if init != "" && !ast_is(init, "SEmpty") { c1 = ssa_lower_any(c1, init); }
    let orig_bid: Int = c1.cur_block;
    let cur_fn1: SsaFunction = c1.fn_data;
    let cond_bid: Int = cur_fn1.block_count;
    c1 = ssa_ctx_add_block(c1, "for.cond." + cond_bid.to_string());
    let cur_fn2: SsaFunction = c1.fn_data;
    let body_bid: Int = cur_fn2.block_count;
    c1 = ssa_ctx_add_block(c1, "for.body." + body_bid.to_string());
    let cur_fn3: SsaFunction = c1.fn_data;
    let step_bid: Int = cur_fn3.block_count;
    c1 = ssa_ctx_add_block(c1, "for.step." + step_bid.to_string());
    let cur_fn4: SsaFunction = c1.fn_data;
    let exit_bid: Int = cur_fn4.block_count;
    c1 = ssa_ctx_add_block(c1, "for.exit." + exit_bid.to_string());
    c1 = ssa_ctx_emit(ssa_ctx_set_block(c1, orig_bid), 0, (0 + ssa_op_br()), cond_bid);
    c1 = ssa_ctx_set_block(c1, cond_bid);
    if cond != "" && !ast_is(cond, "SEmpty") { c1 = ssa_lower_expr(c1, cond); }
    c1 = ssa_ctx_emit_lhs(c1, body_bid, (0 + ssa_op_cond_br()), exit_bid, c1.last_val);
    c1 = ssa_ctx_emit(ssa_lower_any(ssa_ctx_set_block(c1, body_bid), body), 0, (0 + ssa_op_br()), step_bid);
    c1 = ssa_ctx_set_block(c1, step_bid);
    if step != "" && !ast_is(step, "SEmpty") { c1 = ssa_lower_any(c1, step); }
    c1 = ssa_ctx_emit(c1, 0, (0 + ssa_op_br()), cond_bid);
    return ssa_ctx_set_block(c1, exit_bid);
}

pub fn ssa_lower_block(ctx: SsaLowerContext, block_ast: String) -> SsaLowerContext {
    let args: String = ssa_lower_args_of(block_ast);
    let mut c1: SsaLowerContext = ctx;
    let n_items: Int = (0 + list_len_str(args));
    let mut i: Int = 0;
    while i < n_items {
        let item: String = list_get_str(args, i);
        if item != "" && !ast_is(item, "SEmpty") { c1 = ssa_lower_any(c1, item); }
        i = i + 1;
    }
    return c1;
}

pub fn ssa_lower_fn(name: String, ret_type: Int, body_ast: String) -> SsaFunction {
    let mut ctx: SsaLowerContext = ssa_ctx_new(name, ret_type);
    ctx = ssa_ctx_add_block(ctx, "entry");
    ctx = ssa_lower_any(ctx, body_ast);
    let cur_fn: SsaFunction = ctx.fn_data;
    let n_insts: Int = (0 + ssa_fn_inst_count(cur_fn));
    let opcodes: List[Int] = cur_fn.inst_opcodes;
    let mut has_ret: Bool = if n_insts > 0 { list_get(opcodes, n_insts - 1) == (0 + ssa_op_ret()) } else { false };
    if !has_ret { ctx = ssa_ctx_emit_lhs(ctx, 0, (0 + ssa_op_ret()), ctx.last_val, ctx.last_val); }
    return ctx.fn_data;
}

fn ssa_lower_fn_node(fn_ast: String) -> SsaFunction {
    let args: String = ssa_lower_args_of(fn_ast);
    let n_args: Int = (0 + list_len_str(args));
    if n_args < 3 { return ssa_lower_fn("main", 1, ""); }
    let fn_name: String = list_get_str(args, 0);
    let body: String = if n_args >= 1 { list_get_str(args, n_args - 1) } else { "" };
    let ret: String = if n_args >= 3 { list_get_str(args, n_args - 3) } else { "" };
    let ret_ty: Int = if ret == "TyUnit" || ret == "" { 0 } else { 1 };
    let mut ctx: SsaLowerContext = ssa_ctx_new(fn_name, ret_ty);
    ctx = ssa_ctx_add_block(ctx, "entry");
    let mut i: Int = 1;
    let max_param_idx: Int = n_args - 3;
    while i < max_param_idx {
        let p_item: String = list_get_str(args, i);
        if p_item != "" && !ast_is(p_item, "SEmpty") {
            let p_args: String = ssa_lower_args_of(p_item);
            let p_name: String = if ast_is(p_item, "AstParam") { list_get_str(p_args, 0) } else { p_item };
            if p_name != "" {
                let p_slot: Int = ctx.next_reg;
                ctx = ssa_sym_bind(ssa_ctx_set_last(ssa_ctx_emit(ctx, p_slot, (0 + ssa_op_alloca()), 0), p_slot + 1, ctx.last_val), p_name, p_slot);
            }
        }
        i = i + 1;
    }
    ctx = ssa_lower_any(ctx, body);
    let cur_fn: SsaFunction = ctx.fn_data;
    let n_insts: Int = (0 + ssa_fn_inst_count(cur_fn));
    let opcodes: List[Int] = cur_fn.inst_opcodes;
    let mut has_ret: Bool = if n_insts > 0 { list_get(opcodes, n_insts - 1) == (0 + ssa_op_ret()) } else { false };
    if !has_ret { ctx = ssa_ctx_emit_lhs(ctx, 0, (0 + ssa_op_ret()), ctx.last_val, ctx.last_val); }
    return ctx.fn_data;
}

pub fn ssa_lower_ast(ast_str: String) -> SsaFunction {
    let tag: String = ast_tag(ast_str);
    if tag == "AstFile" {
        let items: String = ssa_lower_args_of(ast_str);
        let n: Int = 0 + list_len_str(items);
        let mut i: Int = 0;
        while i < n {
            let item: String = list_get_str(items, i);
            if ast_is(item, "AstFn") { return ssa_lower_fn_node(item); }
            i = i + 1;
        }
        return ssa_lower_fn("main", 1, "");
    }
    if tag == "AstFn" { return ssa_lower_fn_node(ast_str); }
    return ssa_lower_fn("main", 1, ast_str);
}

pub fn ssa_lower_program(ast_str: String) -> SsaFunction {
    return ssa_lower_ast(ast_str);
}
