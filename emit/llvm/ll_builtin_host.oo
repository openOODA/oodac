// # LLVM host-primitive builtin lowering
//
// Logline: Lower bytes, file, str, and crypto free calls to oo_* IR. Fail closed on bad arity.
//
// Setup: Args are packed expr results. Aggregates use sret/byval. No emit/c import.
//
// Beats:
//   1. byte_at and byte_slice mirror the char_at and str_slice SSA idiom.
//   2. read_file and write_file take an explicit i64 cap as the first arg.
//   3. bytes_new, bytes_push, and bytes_to_str use the ilist ABI.
//   4. oo_emit_tmp_* lower as no-ops (bind is identity); LLVM keeps no C temps.

import "ll_tok.oo";
import "ll_ty.oo";
import "ll_int.oo";
import "ll_builtin_fs.oo";
import "ll_builtin_sys.oo";
import "ll_builtin_tui.oo";

pub fn ll_builtin_host(name: String, args: List[String], ssa0: Int, expect: String) -> String {
    let na: Int = list_len(args);
    if (name == "byte_at" || name == "oo_byte_at") && na >= 2 {
        let a0: String = ll_as_val(list_get(args, 0), ssa0);
        let bx: String = ll_i64arg(args, 1, ll_pssa(a0));
        let s: Int = ll_hw(ll_pssa(a0), ll_pssa(bx)) + 1;
        println("  " + ll_ssa(s) + " = call i64 @oo_byte_at({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ", i64 " + ll_ssa(ll_pssa(bx)) + ")");
        return ll_pack(0, s, "i64", "");
    }
    if (name == "byte_slice" || name == "oo_byte_slice") && na >= 3 {
        let a0: String = ll_as_val(list_get(args, 0), ssa0);
        let b1: String = ll_i64arg(args, 1, ll_pssa(a0));
        let b2: String = ll_i64arg(args, 2, ll_pssa(b1));
        let s: Int = ll_hw(ll_hw(ll_pssa(a0), ll_pssa(b1)), ll_pssa(b2)) + 1;
        println("  " + ll_ssa(s) + " = call { ptr, i64 } @oo_byte_slice({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ", i64 " + ll_ssa(ll_pssa(b1)) + ", i64 " + ll_ssa(ll_pssa(b2)) + ")");
        return ll_pack(0, s, "str", "");
    }
    if (name == "char_is_digit" || name == "oo_char_is_digit" || name == "char_is_alpha" || name == "oo_char_is_alpha" || name == "char_is_space" || name == "oo_char_is_space") && na >= 1 {
        let mut callee: String = "oo_char_is_digit";
        if name == "char_is_alpha" || name == "oo_char_is_alpha" { callee = "oo_char_is_alpha"; }
        if name == "char_is_space" || name == "oo_char_is_space" { callee = "oo_char_is_space"; }
        let a0: String = ll_as_val(list_get(args, 0), ssa0);
        let s: Int = ll_pssa(a0) + 1;
        println("  " + ll_ssa(s) + " = call i32 @" + callee + "({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ")");
        let s2: Int = s + 1;
        println("  " + ll_ssa(s2) + " = icmp ne i32 " + ll_ssa(s) + ", 0");
        return ll_pack(0, s2, "i1", "");
    }
    if (name == "str_contains" || name == "oo_str_contains") && na >= 2 {
        let a0: String = ll_as_val(list_get(args, 0), ssa0);
        let a1: String = ll_as_val(list_get(args, 1), ll_pssa(a0));
        let s: Int = ll_pssa(a1) + 1;
        println("  " + ll_ssa(s) + " = call i32 @oo_str_contains({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")");
        let s2: Int = s + 1;
        println("  " + ll_ssa(s2) + " = icmp ne i32 " + ll_ssa(s) + ", 0");
        return ll_pack(0, s2, "i1", "");
    }
    if name == "str_split" && na >= 2 {
        let a0: String = ll_as_val(list_get(args, 0), ssa0);
        let a1: String = ll_as_val(list_get(args, 1), ll_pssa(a0));
        let s: Int = ll_pssa(a1) + 1;
        let out: String = ll_tmpa(s);
        println("  " + out + " = alloca " + ll_ir_alloc("slist") + ", align 8");
        println("  call void @str_split(ptr sret(%OoSList) align 8 " + out + ", { ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")");
        return ll_pack(0, s, "slist", out);
    }
    if (name == "str_trim" || name == "oo_str_trim") && na >= 1 {
        let a0: String = ll_as_val(list_get(args, 0), ssa0);
        let s: Int = ll_pssa(a0) + 1;
        println("  " + ll_ssa(s) + " = call { ptr, i64 } @oo_str_trim({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ")");
        return ll_pack(0, s, "str", "");
    }
    if name == "crypto_sha256_internal" && na >= 1 {
        let a0: String = ll_as_val(list_get(args, 0), ssa0);
        let s: Int = ll_pssa(a0) + 1;
        println("  " + ll_ssa(s) + " = call { ptr, i64 } @crypto_sha256_internal({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ")");
        return ll_pack(0, s, "str", "");
    }
    if name == "bytes_new" || name == "oo_bytes_new" {
        if na != 0 {
            println("ERR\tllvm\tbytes_new takes no args");
            process_exit(1);
        }
        let a: String = ll_tmpa(ssa0 + 1);
        println("  " + a + " = alloca " + ll_ir_alloc("ilist") + ", align 8");
        println("  call void @oo_bytes_new(ptr sret(%OoIList) align 8 " + a + ")");
        return ll_pack(0, ssa0 + 1, "ilist", a);
    }
    if (name == "bytes_push" || name == "oo_bytes_push") && na >= 2 {
        let a0: String = ll_ensure_ptr(list_get(args, 0), ssa0);
        if ll_pk(a0) != "ilist" {
            println("ERR\tllvm\tbytes_push needs List[Int]");
            process_exit(1);
        }
        let bp: String = ll_i64arg(args, 1, ll_pssa(a0));
        let s: Int = ll_hw(ll_pssa(a0), ll_pssa(bp)) + 1;
        let out: String = ll_tmpa(s);
        println("  " + out + " = alloca " + ll_ir_alloc("ilist") + ", align 8");
        println("  call void @oo_bytes_push(ptr sret(%OoIList) align 8 " + out + ", ptr byval(%OoIList) align 8 " + ll_pptr(a0) + ", i64 " + ll_ssa(ll_pssa(bp)) + ")");
        return ll_pack(0, s, "ilist", out);
    }
    if (name == "bytes_to_str" || name == "oo_bytes_to_str") && na >= 1 {
        let a0: String = ll_ensure_ptr(list_get(args, 0), ssa0);
        if ll_pk(a0) != "ilist" {
            println("ERR\tllvm\tbytes_to_str needs List[Int]");
            process_exit(1);
        }
        let s: Int = ll_pssa(a0) + 1;
        println("  " + ll_ssa(s) + " = call { ptr, i64 } @oo_bytes_to_str(ptr byval(%OoIList) align 8 " + ll_pptr(a0) + ")");
        return ll_pack(0, s, "str", "");
    }
    if (name == "read_file" || name == "oo_read_file") && na >= 2 {
        let a1: String = ll_as_val(list_get(args, 1), ssa0);
        let a: String = ll_tmpa(ll_pssa(a1) + 1);
        let s: Int = ll_pssa(a1) + 1;
        println("  " + a + " = alloca %OoResS, align 8");
        println("  call void @oo_read_file(ptr sret(%OoResS) align 8 " + a + ", i64 " + ll_ssa(ll_pssa(list_get(args, 0))) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")");
        return ll_pack(0, s, "ress", a);
    }
    if (name == "write_file" || name == "oo_write_file") && na >= 3 {        // OoResV shares the { i32, OoStr } layout with OoResS, so kind ress flows on.
        let a1: String = ll_as_val(list_get(args, 1), ssa0);
        let a2: String = ll_as_val(list_get(args, 2), ll_pssa(a1));
        let a: String = ll_tmpa(ll_pssa(a2) + 1);
        let s: Int = ll_pssa(a2) + 1;
        println("  " + a + " = alloca %OoResV, align 8");
        println("  call void @oo_write_file(ptr sret(%OoResV) align 8 " + a + ", i64 " + ll_ssa(ll_pssa(list_get(args, 0))) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a2)) + ")");
        return ll_pack(0, s, "ress", a);
    }
    if (name == "sleep_ms" || name == "oo_sleep_ms") && na >= 2 {
        let ms: String = ll_i64arg(args, 1, ll_pssa(list_get(args, 0)));
        println("  call void @oo_sleep_ms(i64 " + ll_ssa(ll_pssa(list_get(args, 0))) + ", i64 " + ll_ssa(ll_pssa(ms)) + ")");
        return ll_pack(0, ll_pssa(ms), "void", "");
    }
    if (name == "now_ms" || name == "oo_now_ms") && na >= 1 {
        let s: Int = ll_pssa(list_get(args, 0)) + 1;
        println("  " + ll_ssa(s) + " = call i64 @oo_now_ms(i64 " + ll_ssa(ll_pssa(list_get(args, 0))) + ")");
        return ll_pack(0, s, "i64", "");
    }
    if (name == "monotonic_us" || name == "oo_monotonic_us") && na >= 1 {
        let s: Int = ll_pssa(list_get(args, 0)) + 1;
        println("  " + ll_ssa(s) + " = call i64 @oo_monotonic_us()");
        return ll_pack(0, s, "i64", "");
    }
    if name == "oo_file_stamp" && na >= 2 {
        let a1: String = ll_as_val(list_get(args, 1), ssa0);
        let s: Int = ll_pssa(a1) + 1;
        println("  " + ll_ssa(s) + " = call { ptr, i64 } @oo_file_stamp(i64 " + ll_ssa(ll_pssa(list_get(args, 0))) + ", { ptr, i64 } " + ll_ssa(ll_pssa(a1)) + ")");
        return ll_pack(0, s, "str", "");
    }
    if name == "oo_emit_tmp_reset" || name == "oo_emit_tmp_enter" || name == "oo_emit_tmp_leave" || name == "oo_emit_tmp_release_print" || name == "oo_emit_tmp_release_all_print" || name == "oo_emit_tmp_own" {
        return ll_pack(0, ssa0, "void", "");
    }
    if name == "oo_emit_tmp_bind" && na >= 1 {
        return list_get(args, 0);
    }
    if (name == "alloc_bytes" || name == "oo_alloc_bytes") && na >= 2 {
        let s: Int = ll_hw(ll_pssa(list_get(args, 0)), ll_pssa(list_get(args, 1))) + 1;
        println("  " + ll_ssa(s) + " = call i64 @oo_alloc_bytes(i64 " + ll_ssa(ll_pssa(list_get(args, 0))) + ", i64 " + ll_ssa(ll_pssa(list_get(args, 1))) + ")");
        return ll_pack(0, s, "i64", "");
    }
    if (name == "hot_reload" || name == "oo_hot_reload") && na >= 1 {
        let a0: String = ll_as_val(list_get(args, 0), ssa0);
        let s: Int = ll_pssa(a0) + 1;
        println("  " + ll_ssa(s) + " = call i64 @oo_hot_reload({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ")");
        return ll_pack(0, s, "i64", "");
    }
    if (name == "int_to_str" || name == "oo_int_to_str" || name == "to_string") && na >= 1 {
        let a0: String = ll_i64arg(args, 0, ssa0);
        let s: Int = ll_pssa(a0) + 1;
        println("  " + ll_ssa(s) + " = call { ptr, i64 } @oo_int_to_str(i64 " + ll_ssa(ll_pssa(a0)) + ")");
        return ll_pack(0, s, "str", "");
    }
    if (name == "str_repeat" || name == "oo_str_repeat") && na >= 2 {
        let a0: String = ll_as_val(list_get(args, 0), ssa0);
        let n: String = ll_i64arg(args, 1, ll_pssa(a0));
        let s: Int = ll_hw(ll_pssa(a0), ll_pssa(n)) + 1;
        println("  " + ll_ssa(s) + " = call { ptr, i64 } @oo_str_repeat({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ", i64 " + ll_ssa(ll_pssa(n)) + ")");
        return ll_pack(0, s, "str", "");
    }
    if (name == "str_to_uppercase" || name == "oo_str_to_uppercase" || name == "to_uppercase") && na >= 1 {
        let a0: String = ll_as_val(list_get(args, 0), ssa0);
        let s: Int = ll_pssa(a0) + 1;
        println("  " + ll_ssa(s) + " = call { ptr, i64 } @oo_str_to_uppercase({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ")");
        return ll_pack(0, s, "str", "");
    }
    if (name == "str_to_lowercase" || name == "oo_str_to_lowercase" || name == "to_lowercase") && na >= 1 {
        let a0: String = ll_as_val(list_get(args, 0), ssa0);
        let s: Int = ll_pssa(a0) + 1;
        println("  " + ll_ssa(s) + " = call { ptr, i64 } @oo_str_to_lowercase({ ptr, i64 } " + ll_ssa(ll_pssa(a0)) + ")");
        return ll_pack(0, s, "str", "");
    }
    let fs: String = ll_builtin_fs(name, args, ssa0, expect);
    if fs != "" { return fs; }
    let sy: String = ll_builtin_sys(name, args, ssa0, expect);
    if sy != "" { return sy; }
    let tu: String = ll_builtin_tui(name, args, ssa0, expect);
    if tu != "" { return tu; }
    return "";
}
