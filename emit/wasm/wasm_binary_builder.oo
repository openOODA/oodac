// # WebAssembly Binary Module Builder
//
// Logline: Frame a standard WebAssembly 1.0 binary module with LEB128 section encoding.
//
// Setup: Import wasm_leb128.oo, wasm_opcodes.oo, wasm_types.oo before use.
//
// Beats:
//   1. Accept type, import, function, memory, export, code, and data section entries.
//   2. Encode each section with LEB128 framing and WebAssembly magic header.
//   3. Emit a valid flat byte sequence representing the complete module.
import "wasm_leb128.oo";
import "wasm_opcodes.oo";
import "wasm_types.oo";
pub type WasmModuleBuilder = struct {
    type_p_lens: List[Int], type_p_flat: List[Int], type_r_lens: List[Int], type_r_flat: List[Int], type_count: Int,
    import_mods: List[String], import_fields: List[String], import_kinds: List[Int], import_types: List[Int], func_types: List[Int],
    func_loc_offs: List[Int], func_loc_lens: List[Int], func_loc_flat: List[Int],
    func_bc_offs: List[Int], func_bc_lens: List[Int], func_bc_flat: List[Int], func_count: Int,
    memory_min: Int, memory_max: Int, has_memory: Bool,
    export_names: List[String], export_kinds: List[Int], export_indices: List[Int],
    data_offsets: List[Int], data_b_offs: List[Int], data_b_lens: List[Int], data_b_flat: List[Int]
};
pub fn wasm_builder_new() -> WasmModuleBuilder {
    return WasmModuleBuilder {
        type_p_lens: list_new(), type_p_flat: list_new(), type_r_lens: list_new(), type_r_flat: list_new(), type_count: 0,
        import_mods: list_new(), import_fields: list_new(), import_kinds: list_new(), import_types: list_new(), func_types: list_new(),
        func_loc_offs: list_new(), func_loc_lens: list_new(), func_loc_flat: list_new(), func_bc_offs: list_new(), func_bc_lens: list_new(), func_bc_flat: list_new(),
        func_count: 0, memory_min: 0, memory_max: -1, has_memory: false,
        export_names: list_new(), export_kinds: list_new(), export_indices: list_new(),
        data_offsets: list_new(), data_b_offs: list_new(), data_b_lens: list_new(), data_b_flat: list_new()
    };
}
pub fn wasm_builder_add_type(b: &mut WasmModuleBuilder, p: List[Int], r: List[Int]) -> Int {
    let np: Int = list_len(p); let nr: Int = list_len(r);
    let mut i: Int = 0; let mut poff: Int = 0; let mut roff: Int = 0;
    while i < (*b).type_count {
        let cur_np: Int = list_get((*b).type_p_lens, i); let cur_nr: Int = list_get((*b).type_r_lens, i);
        if cur_np == np && cur_nr == nr {
            let mut eq: Bool = true; let mut k: Int = 0;
            while k < np { if list_get((*b).type_p_flat, poff + k) != list_get(p, k) { eq = false; } k = k + 1; }
            k = 0;
            while k < nr { if list_get((*b).type_r_flat, roff + k) != list_get(r, k) { eq = false; } k = k + 1; }
            if eq { return i; }
        }
        poff = poff + cur_np; roff = roff + cur_nr; i = i + 1;
    }
    (*b).type_p_lens = list_push((*b).type_p_lens, np); (*b).type_p_flat = wasm_append((*b).type_p_flat, p);
    (*b).type_r_lens = list_push((*b).type_r_lens, nr); (*b).type_r_flat = wasm_append((*b).type_r_flat, r);
    (*b).type_count = (*b).type_count + 1; return (*b).type_count - 1;
}
pub fn wasm_builder_add_import_func(b: &mut WasmModuleBuilder, m: String, f: String, ty: Int) -> Int {
    let mut im: List[String] = (*b).import_mods; let mut ifields: List[String] = (*b).import_fields; let mut ikinds: List[Int] = (*b).import_kinds; let mut itypes: List[Int] = (*b).import_types; (*b).import_mods = list_push(im, m); (*b).import_fields = list_push(ifields, f); (*b).import_kinds = list_push(ikinds, 0); (*b).import_types = list_push(itypes, ty); return list_len((*b).import_kinds) - 1;
}
pub fn wasm_builder_add_func(b: &mut WasmModuleBuilder, type_idx: Int) -> Int {
    (*b).func_types = list_push((*b).func_types, type_idx); (*b).func_loc_offs = list_push((*b).func_loc_offs, list_len((*b).func_loc_flat)); (*b).func_loc_lens = list_push((*b).func_loc_lens, 0); (*b).func_bc_offs = list_push((*b).func_bc_offs, list_len((*b).func_bc_flat)); (*b).func_bc_lens = list_push((*b).func_bc_lens, 0); (*b).func_count = (*b).func_count + 1; return (*b).func_count - 1;
}
pub fn wasm_ilist_set(xs: List[Int], idx: Int, val: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = list_len(xs);
    let mut i: Int = 0;
    while i < n { if i == idx { out = list_push(out, val); } else {
            out = list_push(out, list_get(xs, i));
        }
        i = i + 1;
    }
    return out;
}
pub fn wasm_builder_set_code(b: &mut WasmModuleBuilder, f_idx: Int, locs: List[Int], bc: List[Int]) {
    let loc_off: Int = list_len((*b).func_loc_flat);
    (*b).func_loc_flat = wasm_append((*b).func_loc_flat, locs);
    (*b).func_loc_offs = wasm_ilist_set((*b).func_loc_offs, f_idx, loc_off);
    (*b).func_loc_lens = wasm_ilist_set((*b).func_loc_lens, f_idx, list_len(locs));
    let bc_off: Int = list_len((*b).func_bc_flat);
    (*b).func_bc_flat = wasm_append((*b).func_bc_flat, bc);
    (*b).func_bc_offs = wasm_ilist_set((*b).func_bc_offs, f_idx, bc_off);
    (*b).func_bc_lens = wasm_ilist_set((*b).func_bc_lens, f_idx, list_len(bc));
}
pub fn wasm_builder_set_memory(b: &mut WasmModuleBuilder, min_pages: Int, max_pages: Int) {
    (*b).has_memory = true; (*b).memory_min = min_pages; (*b).memory_max = max_pages;
}
pub fn wasm_builder_add_export(b: &mut WasmModuleBuilder, name: String, kind: Int, idx: Int) {
    let mut exp_names: List[String] = (*b).export_names;
    let mut exp_kinds: List[Int] = (*b).export_kinds;
    let mut exp_indices: List[Int] = (*b).export_indices;
    (*b).export_names = list_push(exp_names, name);
    (*b).export_kinds = list_push(exp_kinds, kind);
    (*b).export_indices = list_push(exp_indices, idx);
}
pub fn wasm_builder_add_data(b: &mut WasmModuleBuilder, offset: Int, data: List[Int]) {
    (*b).data_offsets = list_push((*b).data_offsets, offset);
    (*b).data_b_offs = list_push((*b).data_b_offs, list_len((*b).data_b_flat));
    (*b).data_b_lens = list_push((*b).data_b_lens, list_len(data));
    (*b).data_b_flat = wasm_append((*b).data_b_flat, data);
}
pub fn wasm_append(mut dst: List[Int], src: List[Int]) -> List[Int] {
    let n: Int = list_len(src); let mut i: Int = 0;
    while i < n { dst = list_push(dst, list_get(src, i)); i = i + 1; }
    return dst;
}
fn wasm_emit_str(s: String) -> List[Int] {
    let mut out: List[Int] = list_new(); let n: Int = chars_len(s);
    out = wasm_append(out, encode_u32_leb128(n)); let mut i: Int = 0;
    while i < n { out = list_push(out, byte_at(s, i)); i = i + 1; }
    return out;
}
fn wasm_frame_sec(sec_id: Int, payload: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new(); out = list_push(out, sec_id);
    out = wasm_append(out, encode_u32_leb128(list_len(payload)));
    return wasm_append(out, payload);
}
fn wasm_encode_locals_slice(all_locs: List[Int], off: Int, n: Int) -> List[Int] {
    if n == 0 { let mut out: List[Int] = list_new(); return list_push(out, 0); }
    let mut runs: List[Int] = list_new(); let mut run_count: Int = 0;
    let mut cur_type: Int = list_get(all_locs, off); let mut cur_len: Int = 1; let mut i: Int = 1;
    while i < n {
        let vt: Int = list_get(all_locs, off + i);
        if vt == cur_type { cur_len = cur_len + 1; }
        else {
            runs = wasm_append(runs, encode_u32_leb128(cur_len)); runs = list_push(runs, cur_type);
            run_count = run_count + 1; cur_type = vt; cur_len = 1;
        }
        i = i + 1;
    }
    runs = wasm_append(runs, encode_u32_leb128(cur_len)); runs = list_push(runs, cur_type);
    run_count = run_count + 1;
    let mut out: List[Int] = list_new(); out = wasm_append(out, encode_u32_leb128(run_count));
    return wasm_append(out, runs);
}
pub fn wasm_builder_emit(b: WasmModuleBuilder) -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 0); out = list_push(out, 97); out = list_push(out, 115); out = list_push(out, 109);
    out = list_push(out, 1); out = list_push(out, 0); out = list_push(out, 0); out = list_push(out, 0);
    let n_types: Int = b.type_count;
    if n_types > 0 {
        let mut py: List[Int] = encode_u32_leb128(n_types);
        let mut i: Int = 0; let mut poff: Int = 0; let mut roff: Int = 0;
        while i < n_types {
            let np: Int = list_get(b.type_p_lens, i); let nr: Int = list_get(b.type_r_lens, i);
            let mut p_sub: List[Int] = list_new(); let mut r_sub: List[Int] = list_new();
            let mut k: Int = 0;
            while k < np { p_sub = list_push(p_sub, list_get(b.type_p_flat, poff + k)); k = k + 1; }
            k = 0;
            while k < nr { r_sub = list_push(r_sub, list_get(b.type_r_flat, roff + k)); k = k + 1; }
            py = wasm_append(py, wasm_func_type(p_sub, r_sub));
            poff = poff + np; roff = roff + nr; i = i + 1;
        }
        out = wasm_append(out, wasm_frame_sec(wasm_sec_type(), py));
    }
    let n_imp: Int = list_len(b.import_kinds);
    if n_imp > 0 {
        let im_mods: List[String] = b.import_mods;
        let im_fields: List[String] = b.import_fields;
        let mut py: List[Int] = encode_u32_leb128(n_imp); let mut i: Int = 0;
        while i < n_imp {
            py = wasm_append(py, wasm_emit_str(list_get(im_mods, i)));
            py = wasm_append(py, wasm_emit_str(list_get(im_fields, i)));
            let kd: Int = list_get(b.import_kinds, i); py = list_push(py, kd);
            if kd == 0 { py = wasm_append(py, encode_u32_leb128(list_get(b.import_types, i))); }
            i = i + 1;
        }
        out = wasm_append(out, wasm_frame_sec(wasm_sec_import(), py));
    }
    let n_funcs: Int = b.func_count;
    if n_funcs > 0 {
        let mut py: List[Int] = encode_u32_leb128(n_funcs); let mut i: Int = 0;
        while i < n_funcs { py = wasm_append(py, encode_u32_leb128(list_get(b.func_types, i))); i = i + 1; }
        out = wasm_append(out, wasm_frame_sec(wasm_sec_function(), py));
    }
    if b.has_memory {
        let mut py: List[Int] = list_new(); py = list_push(py, 1);
        let mem_max: Int = b.memory_max;
        let mem_min: Int = b.memory_min;
        if mem_max < 0 { py = list_push(py, 0); py = wasm_append(py, encode_u32_leb128(mem_min)); }
        else {
            py = list_push(py, 1);
            py = wasm_append(py, encode_u32_leb128(b.memory_min));
            py = wasm_append(py, encode_u32_leb128(b.memory_max));
        }
        out = wasm_append(out, wasm_frame_sec(wasm_sec_memory(), py));
    }
    let ex_names: List[String] = b.export_names;
    let n_exp: Int = list_len(ex_names);
    if n_exp > 0 { let mut py: List[Int] = encode_u32_leb128(n_exp); let mut i: Int = 0; while i < n_exp { py = wasm_append(py, wasm_emit_str(list_get(ex_names, i))); py = list_push(py, list_get(b.export_kinds, i)); py = wasm_append(py, encode_u32_leb128(list_get(b.export_indices, i))); i = i + 1; }
        out = wasm_append(out, wasm_frame_sec(wasm_sec_export(), py));
    }
    if n_funcs > 0 {
        let mut py: List[Int] = encode_u32_leb128(n_funcs); let mut i: Int = 0;
        while i < n_funcs {
            let loc_off: Int = list_get(b.func_loc_offs, i); let loc_len: Int = list_get(b.func_loc_lens, i);
            let bc_off: Int = list_get(b.func_bc_offs, i); let bc_len: Int = list_get(b.func_bc_lens, i);
            let mut body: List[Int] = wasm_encode_locals_slice(b.func_loc_flat, loc_off, loc_len);
            let mut k: Int = 0;
            while k < bc_len { body = list_push(body, list_get(b.func_bc_flat, bc_off + k)); k = k + 1; }
            if bc_len == 0 || list_get(b.func_bc_flat, bc_off + bc_len - 1) != op_end() { body = list_push(body, op_end()); }
            py = wasm_append(py, encode_u32_leb128(list_len(body)));
            py = wasm_append(py, body);
            i = i + 1;
        }
        out = wasm_append(out, wasm_frame_sec(wasm_sec_code(), py));
    }
    let n_data: Int = list_len(b.data_offsets);
    if n_data > 0 {
        let mut py: List[Int] = encode_u32_leb128(n_data); let mut i: Int = 0;
        while i < n_data {
            py = list_push(py, 0); py = list_push(py, op_i32_const());
            py = wasm_append(py, encode_i32_leb128(list_get(b.data_offsets, i)));
            py = list_push(py, op_end());
            let blen: Int = list_get(b.data_b_lens, i); let boff: Int = list_get(b.data_b_offs, i);
            py = wasm_append(py, encode_u32_leb128(blen));
            let mut k: Int = 0;
            while k < blen { py = list_push(py, list_get(b.data_b_flat, boff + k)); k = k + 1; }
            i = i + 1; }
        out = wasm_append(out, wasm_frame_sec(wasm_sec_data(), py));
    }
    return out;
}
