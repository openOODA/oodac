// # WebAssembly LEB128 Codec
//
// Logline: Encode and decode LEB128 variable-length integers for WebAssembly binary emission.
//
// Setup: No capabilities required. Pure arithmetic codec.
//
// Beats:
//   1. Encode unsigned u32/u64 integers as LEB128 byte sequences.
//   2. Encode signed i32/i64 integers as LEB128 byte sequences.
//   3. Decode unsigned and signed LEB128 byte sequences to integers.

pub type LebDecodeResult = struct {
    value: Int,
    next_offset: Int
};

pub fn leb_decode_result_new(value: Int, next_offset: Int) -> LebDecodeResult {
    let res: LebDecodeResult = LebDecodeResult { value: value, next_offset: next_offset };
    return res;
}

pub fn encode_u32_leb128(val: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut v: Int = val;
    let mut more: Bool = true;
    while more { let byte: Int = v & 127; v = v / 128; if v == 0 { out = list_push(out, byte); more = false; } else {
            out = list_push(out, byte | 128);
        }
    }
    return out;
}

pub fn encode_u64_leb128(val: Int) -> List[Int] {
    return encode_u32_leb128(val);
}

pub fn encode_i32_leb128(val: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut v: Int = val & 4294967295;
    if (v & 2147483648) != 0 { v = v - 4294967296; }
    let mut more: Bool = true;
    let mut count: Int = 0;
    while more { let byte: Int = v & 127; v = v >> 7; let sign_bit: Int = byte & 64; count = count + 1; if count == 5 { out = list_push(out, byte & 127); more = false; } else if (v == 0 && sign_bit == 0) || (v == -1 && sign_bit != 0) {
            out = list_push(out, byte);
            more = false;
        } else {
            out = list_push(out, byte | 128);
        }
    }
    return out;
}

pub fn encode_i64_leb128(val: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut v: Int = val;
    let mut more: Bool = true;
    while more { let byte: Int = v & 127; v = v >> 7; let sign_bit: Int = byte & 64; if (v == 0 && sign_bit == 0) || (v == -1 && sign_bit != 0) { out = list_push(out, byte); more = false; } else {
            out = list_push(out, byte | 128);
        }
    }
    return out;
}

pub fn decode_u32_leb128(bytes: List[Int], offset: Int) -> LebDecodeResult {
    let mut result: Int = 0;
    let mut shift: Int = 0;
    let mut cur: Int = offset;
    let n: Int = list_len(bytes);
    let mut more: Bool = true;
    while more && cur < n {
        let b: Int = list_get(bytes, cur);
        cur = cur + 1;
        result = result | ((b & 127) << shift);
        shift = shift + 7;
        if (b & 128) == 0 { more = false; }
    }
    let res: LebDecodeResult = LebDecodeResult { value: result, next_offset: cur };
    return res;
}

pub fn decode_u64_leb128(bytes: List[Int], offset: Int) -> LebDecodeResult {
    return decode_u32_leb128(bytes, offset);
}

pub fn decode_i32_leb128(bytes: List[Int], offset: Int) -> LebDecodeResult {
    let mut result: Int = 0;
    let mut shift: Int = 0;
    let mut cur: Int = offset;
    let n: Int = list_len(bytes);
    let mut more: Bool = true;
    let mut last_byte: Int = 0;
    while more && cur < n {
        let b: Int = list_get(bytes, cur);
        cur = cur + 1;
        last_byte = b;
        result = result | ((b & 127) << shift);
        shift = shift + 7;
        if (b & 128) == 0 { more = false; }
    }
    if shift < 32 {
        if (last_byte & 64) != 0 { result = result | (-(1 << shift)); }
    } else {
        result = result & 4294967295;
        if (result & 2147483648) != 0 { result = result - 4294967296; }
    }
    let res: LebDecodeResult = LebDecodeResult { value: result, next_offset: cur };
    return res;
}

pub fn decode_i64_leb128(bytes: List[Int], offset: Int) -> LebDecodeResult {
    let mut result: Int = 0;
    let mut shift: Int = 0;
    let mut cur: Int = offset;
    let n: Int = list_len(bytes);
    let mut more: Bool = true;
    let mut last_byte: Int = 0;
    while more && cur < n {
        let b: Int = list_get(bytes, cur);
        cur = cur + 1;
        last_byte = b;
        result = result | ((b & 127) << shift);
        shift = shift + 7;
        if (b & 128) == 0 { more = false; }
    }
    if shift < 64 && (last_byte & 64) != 0 { result = result | (-(1 << shift)); }
    let res: LebDecodeResult = LebDecodeResult { value: result, next_offset: cur };
    return res;
}

pub fn wasm_parse_int(s: String) -> Int {
    let n: Int = chars_len(s); let mut v: Int = 0; let mut i: Int = 0; let mut sign: Int = 1;
    if n > 0 && char_at(s, 0) == "-" { sign = -1; i = 1; }
    while i < n {
        let c: String = char_at(s, i);
        if c == "0" { v = v * 10; } else if c == "1" { v = v * 10 + 1; } else if c == "2" { v = v * 10 + 2; } else if c == "3" { v = v * 10 + 3; } else if c == "4" { v = v * 10 + 4; } else if c == "5" { v = v * 10 + 5; } else if c == "6" { v = v * 10 + 6; } else if c == "7" { v = v * 10 + 7; } else if c == "8" { v = v * 10 + 8; } else if c == "9" { v = v * 10 + 9; }
        i = i + 1;
    }
    return v * sign;
}

pub fn wasm_encode_f64_lit(v_str: String) -> List[Int] {
    let mut out: List[Int] = list_new(); let n: Int = chars_len(v_str);
    let is_neg: Bool = (n > 0 && char_at(v_str, 0) == "-");
    let start_idx: Int = if is_neg { 1 } else { 0 };
    let clean_str: String = if is_neg { str_slice(v_str, 1, n) } else { v_str };
    if n == 0 || clean_str == "0" || clean_str == "0.0" || clean_str == "0.00" || clean_str == "0.000" {
        let mut i: Int = 0; while i < 7 { out = list_push(out, 0); i = i + 1; }
        if is_neg { out = list_push(out, 128); } else { out = list_push(out, 0); }
        return out;
    }
    let mut dot_idx: Int = -1; let mut i: Int = start_idx;
    while i < n { if char_at(v_str, i) == "." { dot_idx = i; } i = i + 1; }
    let mut int_p: Int = 0; let mut frac_p: Int = 0; let mut frac_div: Int = 1;
    if dot_idx < 0 { int_p = wasm_parse_int(str_slice(v_str, start_idx, n)); }
    else {
        if dot_idx > start_idx { int_p = wasm_parse_int(str_slice(v_str, start_idx, dot_idx)); }
        let f_str: String = str_slice(v_str, dot_idx + 1, n); let fn_len: Int = chars_len(f_str);
        if fn_len > 0 { frac_p = wasm_parse_int(f_str); let mut k: Int = 0; while k < fn_len && k < 12 { frac_div = frac_div * 10; k = k + 1; } }
    }
    if int_p == 0 && frac_p == 0 {
        let mut j: Int = 0; while j < 7 { out = list_push(out, 0); j = j + 1; }
        if is_neg { out = list_push(out, 128); } else { out = list_push(out, 0); }
        return out;
    }
    let mut exp: Int = 0; let mut cur_i: Int = int_p; let mut cur_f: Int = frac_p * 1000000; let scale_div: Int = frac_div * 1000000;
    if cur_i >= 1 { while cur_i >= 2 { cur_f = (cur_f + (cur_i & 1) * scale_div) / 2; cur_i = cur_i / 2; exp = exp + 1; } }
    else { while cur_i == 0 && exp > -1022 { cur_f = cur_f * 2; cur_i = cur_f / scale_div; cur_f = cur_f % scale_div; exp = exp - 1; } }
    let biased_exp: Int = exp + 1023; let mut mantissa: Int = 0; let mut bit: Int = 51;
    while bit >= 0 { cur_f = cur_f * 2; if cur_f >= scale_div { mantissa = mantissa | (1 << bit); cur_f = cur_f - scale_div; } bit = bit - 1; }
    let sign_bit: Int = if is_neg { 1 } else { 0 };
    let high_32: Int = (sign_bit << 31) | (biased_exp << 20) | ((mantissa >> 32) & 1048575); let low_32: Int = mantissa & 4294967295;
    out = list_push(out, low_32 & 255); out = list_push(out, (low_32 >> 8) & 255); out = list_push(out, (low_32 >> 16) & 255); out = list_push(out, (low_32 >> 24) & 255);
    out = list_push(out, high_32 & 255); out = list_push(out, (high_32 >> 8) & 255); out = list_push(out, (high_32 >> 16) & 255); out = list_push(out, (high_32 >> 24) & 255);
    return out;
}
