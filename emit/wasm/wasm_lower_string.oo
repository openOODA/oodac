// # WebAssembly UTF-8 String & RODATA Lowering Engine
//
// Logline: Lowers UTF-8 string layout, RODATA literals, length checks, equality, and concatenation.
//
// Setup: Import wasm_opcodes.oo, wasm_types.oo, wasm_leb128.oo, wasm_mem_layout.oo, wasm_lower_expr.oo, ast.oo.
//
// Beats:
//   1. Register static string literals into RODATA memory segment.
//   2. Lower string length and character byte access operations.
//   3. Lower string equality and lexicographical comparisons.
//   4. Lower dynamic string concatenation with heap allocation.

import "wasm_opcodes.oo";

import "wasm_types.oo";

import "wasm_leb128.oo";

import "wasm_mem_layout.oo";



pub fn wasm_flag_static() -> Int {
    return 1;
}
pub fn wasm_flag_heap() -> Int {
    return 0;
}
pub fn wasm_str_hdr_size() -> Int {
    return 12;
}
pub fn wasm_str_null_size() -> Int {
    return 1;
}

pub fn wasm_lower_str_lit(env: &mut WasmEnv, s: String, mem: WasmMemLayout) -> Int {
    let offset: Int = (0 + wasm_rodata_add_string(&mut mem, s)); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, offset); return wasm_val_type_i32();
}

pub fn wasm_emit_str_len_to_local(env: &mut WasmEnv, ptr_slot: Int, dst_slot: Int) {
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ptr_slot);
    wasm_env_emit(env, op_i32_load()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 8);
    wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, dst_slot);
}

pub fn wasm_emit_heap_bump_alloc(env: &mut WasmEnv, out_ptr_slot: Int, size_slot: Int, heap_base: Int) {
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, wasm_zone_heap_ptr_addr());
    wasm_env_emit(env, op_i32_load()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0);
    wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, out_ptr_slot);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, out_ptr_slot);
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1024); wasm_env_emit(env, op_i32_lt_u());
    wasm_env_emit(env, op_if()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, heap_base); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, out_ptr_slot);
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, wasm_zone_heap_ptr_addr());
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, out_ptr_slot);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, size_slot); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 16); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0);
}

pub fn wasm_emit_str_header_init(env: &mut WasmEnv, ptr_slot: Int, len_slot: Int, flags_val: Int) {
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ptr_slot);
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1);
    wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ptr_slot);
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, flags_val);
    wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 4);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ptr_slot);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, len_slot);
    wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 8);
}

pub fn wasm_emit_byte_copy(env: &mut WasmEnv, dst_ptr: Int, dst_add_slot: Int, dst_add_is_slot: Bool, src_ptr: Int, src_add_slot: Int, src_add_is_slot: Bool, count_slot: Int, i_slot: Int) {
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, i_slot);
    wasm_env_emit(env, op_block()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_loop()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_slot); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, count_slot);
    wasm_env_emit(env, op_i32_ge_u()); wasm_env_emit(env, op_br_if()); wasm_env_emit_u32(env, 1);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, dst_ptr);
    if dst_add_is_slot { wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, dst_add_slot); wasm_env_emit(env, op_i32_add()); }
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_slot); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, src_ptr);
    if src_add_is_slot { wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, src_add_slot); wasm_env_emit(env, op_i32_add()); }
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_slot); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_i32_load8_u()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 12);
    wasm_env_emit(env, op_i32_store8()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 12);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_slot); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1);
    wasm_env_emit(env, op_i32_add()); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, i_slot);
    wasm_env_emit(env, op_br()); wasm_env_emit_u32(env, 0);
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;
}

pub fn wasm_emit_str_eq(env: &mut WasmEnv, ptr1_slot: Int, ptr2_slot: Int, len1_slot: Int, len2_slot: Int, i_slot: Int) {
    wasm_env_emit(env, op_block()); wasm_env_emit_byte(env, wasm_val_type_i32()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ptr1_slot); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ptr2_slot);
    wasm_env_emit(env, op_i32_eq()); wasm_env_emit(env, op_if()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_br()); wasm_env_emit_u32(env, 1);
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ptr1_slot); wasm_env_emit(env, op_i32_eqz());
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ptr2_slot); wasm_env_emit(env, op_i32_eqz());
    wasm_env_emit(env, op_i32_or()); wasm_env_emit(env, op_if()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_br()); wasm_env_emit_u32(env, 1);
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;
    wasm_emit_str_len_to_local(env, ptr1_slot, len1_slot); wasm_emit_str_len_to_local(env, ptr2_slot, len2_slot);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, len1_slot); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, len2_slot);
    wasm_env_emit(env, op_i32_ne()); wasm_env_emit(env, op_if()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_br()); wasm_env_emit_u32(env, 1);
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, i_slot);
    wasm_env_emit(env, op_block()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_loop()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_slot); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, len1_slot);
    wasm_env_emit(env, op_i32_ge_u()); wasm_env_emit(env, op_br_if()); wasm_env_emit_u32(env, 1);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ptr1_slot); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_slot);
    wasm_env_emit(env, op_i32_add()); wasm_env_emit(env, op_i32_load8_u()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 12);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ptr2_slot); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_slot);
    wasm_env_emit(env, op_i32_add()); wasm_env_emit(env, op_i32_load8_u()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 12);
    wasm_env_emit(env, op_i32_ne()); wasm_env_emit(env, op_if()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_br()); wasm_env_emit_u32(env, 3);
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_slot); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1);
    wasm_env_emit(env, op_i32_add()); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, i_slot);
    wasm_env_emit(env, op_br()); wasm_env_emit_u32(env, 0);
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;
}

pub fn wasm_emit_str_ne(env: &mut WasmEnv, ptr1_slot: Int, ptr2_slot: Int, len1_slot: Int, len2_slot: Int, i_slot: Int) {
    wasm_emit_str_eq(env, ptr1_slot, ptr2_slot, len1_slot, len2_slot, i_slot);
    wasm_env_emit(env, op_i32_eqz());
}

pub fn wasm_emit_str_concat(env: &mut WasmEnv, ptr1_slot: Int, ptr2_slot: Int, new_ptr_slot: Int, len1_slot: Int, len2_slot: Int, tot_len_slot: Int, i_slot: Int, heap_base: Int) {
    wasm_emit_str_len_to_local(env, ptr1_slot, len1_slot);
    wasm_emit_str_len_to_local(env, ptr2_slot, len2_slot);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, len1_slot);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, len2_slot);
    wasm_env_emit(env, op_i32_add()); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, tot_len_slot);
    wasm_emit_heap_bump_alloc(env, new_ptr_slot, tot_len_slot, heap_base);
    wasm_emit_str_header_init(env, new_ptr_slot, tot_len_slot, 0);
    wasm_emit_byte_copy(env, new_ptr_slot, 0, false, ptr1_slot, 0, false, len1_slot, i_slot);
    wasm_emit_byte_copy(env, new_ptr_slot, len1_slot, true, ptr2_slot, 0, false, len2_slot, i_slot);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, new_ptr_slot);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, tot_len_slot); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0);
    wasm_env_emit(env, op_i32_store8()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 12);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, new_ptr_slot);
}

pub fn wasm_lower_to_string(env: &mut WasmEnv, recv_node: String) -> Int {
    let is_neg_slot: Int = (0 + wasm_env_bind_var(env, "__tsv_neg", wasm_val_type_i32())); let len_slot: Int = (0 + wasm_env_bind_var(env, "__tsv_len", wasm_val_type_i32())); let pos_slot: Int = (0 + wasm_env_bind_var(env, "__tsv_pos", wasm_val_type_i32())); let tmp_slot: Int = (0 + wasm_env_bind_var(env, "__tsv_tmp", wasm_val_type_i32())); let val_slot: Int = (0 + wasm_env_bind_var(env, "__tsv_val", wasm_val_type_i32())); let r_ty: Int = (0 + wasm_lower_expr(env, recv_node)); if r_ty == wasm_val_type_f64() { let f_slot: Int = (0 + wasm_env_bind_var(env, "__tsv_f", wasm_val_type_f64())); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, f_slot); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, f_slot); wasm_env_emit(env, op_i32_trunc_f64_s()); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, val_slot); } else {
        wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, val_slot);
    }
    let ptr_slot: Int = (0 + wasm_env_alloc(env, 32));

    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, is_neg_slot);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, val_slot);
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_i32_lt_s());
    wasm_env_emit(env, op_if()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, is_neg_slot);
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, val_slot); wasm_env_emit(env, op_i32_sub()); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, val_slot);
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;

    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, val_slot); wasm_env_emit(env, op_i32_eqz());
    wasm_env_emit(env, op_if()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ptr_slot); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, is_neg_slot); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 48); wasm_env_emit(env, op_i32_store8()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 12);
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, len_slot);
    wasm_env_emit(env, op_else());
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, val_slot); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, tmp_slot);
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, len_slot);
    wasm_env_emit(env, op_block()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_loop()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, tmp_slot); wasm_env_emit(env, op_i32_eqz()); wasm_env_emit(env, op_br_if()); wasm_env_emit_u32(env, 1);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, tmp_slot); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 10); wasm_env_emit(env, op_i32_div_u()); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, tmp_slot);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, len_slot); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_i32_add()); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, len_slot);
    wasm_env_emit(env, op_br()); wasm_env_emit_u32(env, 0);
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;

    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, is_neg_slot); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, len_slot); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_i32_sub()); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, pos_slot);
    wasm_env_emit(env, op_block()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_loop()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, val_slot); wasm_env_emit(env, op_i32_eqz()); wasm_env_emit(env, op_br_if()); wasm_env_emit_u32(env, 1);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ptr_slot); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, pos_slot); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, val_slot); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 10); wasm_env_emit(env, op_i32_rem_u()); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 48); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_i32_store8()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 12);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, val_slot); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 10); wasm_env_emit(env, op_i32_div_u()); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, val_slot);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, pos_slot); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_i32_sub()); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, pos_slot);
    wasm_env_emit(env, op_br()); wasm_env_emit_u32(env, 0);
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;
    wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1;

    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, is_neg_slot);
    wasm_env_emit(env, op_if()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1;
