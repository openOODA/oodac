// # WebAssembly Component Model Type System
//
// Logline: Component Model primitive, compound (record, variant, list, tuple), and resource handle type definitions.
//
// Setup: Import wasm_leb128.oo for type count prefixes and discriminant encoding.
//
// Beats:
//   1. Define Component Model primitive value types (s8..s64, u8..u64, f32, f64, char, string).
//   2. Define compound types (record, variant, list, tuple, flags, enum, option, result).
//   3. Define resource handle types (own, borrow).
//   4. Encode component interface function signatures and parameter lists.

import "wasm_leb128.oo";


pub fn comp_type_bool() -> Int {
    return 127;
} // 0x7F
pub fn comp_type_s8() -> Int {
    return 126;
}   // 0x7E
pub fn comp_type_u8() -> Int {
    return 125;
}   // 0x7D
pub fn comp_type_s16() -> Int {
    return 124;
}  // 0x7C
pub fn comp_type_u16() -> Int {
    return 123;
}  // 0x7B
pub fn comp_type_s32() -> Int {
    return 122;
}  // 0x7A
pub fn comp_type_u32() -> Int {
    return 121;
}  // 0x79
pub fn comp_type_s64() -> Int {
    return 120;
}  // 0x78
pub fn comp_type_u64() -> Int {
    return 119;
}  // 0x77
pub fn comp_type_f32() -> Int {
    return 118;
}  // 0x76
pub fn comp_type_f64() -> Int {
    return 117;
}  // 0x75
pub fn comp_type_char() -> Int {
    return 116;
} // 0x74
pub fn comp_type_string() -> Int {
    return 115;
} // 0x73

pub fn comp_type_record() -> Int {
    return 114;
} // 0x72
pub fn comp_type_variant() -> Int {
    return 113;
} // 0x71
pub fn comp_type_list() -> Int {
    return 112;
} // 0x70
pub fn comp_type_tuple() -> Int {
    return 111;
} // 0x6F
pub fn comp_type_flags() -> Int {
    return 110;
} // 0x6E
pub fn comp_type_enum() -> Int {
    return 109;
}  // 0x6D
pub fn comp_type_option() -> Int {
    return 107;
} // 0x6B
pub fn comp_type_result() -> Int {
    return 106;
} // 0x6A
pub fn comp_type_own() -> Int {
    return 105;
}   // 0x69
pub fn comp_type_borrow() -> Int {
    return 104;
} // 0x68

pub type CompRecord = struct {
    field_names: List[String],
    field_types: List[Int],
    field_count: Int
};

pub type CompFuncType = struct {
    param_names: List[String],
    param_types: List[Int],
    result_type: Int
};

pub fn comp_record_new() -> CompRecord {
    let empty_s: List[String] = list_new();
let empty_i: List[Int] = list_new();
let res: CompRecord = CompRecord { field_names: empty_s, field_types: empty_i, field_count: 0 };
    return res;
}

pub fn comp_record_add_field(mut rec: CompRecord, name: String, f_type: Int) -> CompRecord {
    let mut rec: CompRecord = rec;
let mut names: List[String] = rec.field_names;
names = list_push(names, name);
rec.field_names = names;
let mut types: List[Int] = rec.field_types;
types = list_push(types, f_type);
rec.field_types = types;
rec.field_count = rec.field_count + 1;
return rec;
}

pub fn comp_func_type_new(p_names: List[String], p_types: List[Int], res_type: Int) -> CompFuncType {
    let res: CompFuncType = CompFuncType { param_names: p_names, param_types: p_types, result_type: res_type };
    return res;
}

pub fn comp_func_res_type(f: CompFuncType) -> Int {
    return f.result_type;
}
pub fn comp_func_param_names(f: CompFuncType) -> List[String] {
    return f.param_names;
}
pub fn comp_func_param_types(f: CompFuncType) -> List[Int] {
    return f.param_types;
}
pub fn comp_record_field_names(r: CompRecord) -> List[String] {
    return r.field_names;
}
pub fn comp_record_field_types(r: CompRecord) -> List[Int] {
    return r.field_types;
}
