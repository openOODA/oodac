// # WebAssembly Struct Memory Lowering Engine
//
// Logline: Computes struct field layouts, generates heap allocation, and lowers field getters/setters.
//
// Setup: Import wasm_opcodes.oo, wasm_types.oo, wasm_leb128.oo, wasm_lower_expr.oo, ast.oo.
//
// Beats:
//   1. Calculate struct layout sizes and field offsets with ARC headers.
//   2. Lower struct instance creation and field initializers.
//   3. Lower struct field load getter operations.
//   4. Lower struct field store setter operations.

import "wasm_opcodes.oo";

import "wasm_types.oo";

import "wasm_leb128.oo";



pub fn wasm_lower_struct_inst(env: &mut WasmEnv, type_name: String, field_vals: List[String], n_fields: Int) -> Int {
    let struct_size: Int = 8 + (n_fields * 8);
let ptr_slot: Int = (0 + wasm_env_alloc(env, struct_size));
wasm_env_emit(env, op_local_get());
wasm_env_emit_u32(env, ptr_slot);
wasm_env_emit(env, op_i32_const());
wasm_env_emit_i32(env, 1);
wasm_env_emit(env, op_i32_store());
wasm_env_emit_u32(env, 2);
wasm_env_emit_u32(env, 0);
wasm_env_emit(env, op_local_get());
wasm_env_emit_u32(env, ptr_slot);
wasm_env_emit(env, op_i32_const());
wasm_env_emit_i32(env, 0);
wasm_env_emit(env, op_i32_store());
wasm_env_emit_u32(env, 2);
wasm_env_emit_u32(env, 4);
let mut i: Int = 0;
while i < n_fields { let f_val: String = list_get(field_vals, i);
if f_val != "" && !ast_is(f_val, "SEmpty") { let offset: Int = 8 + (i * 8);
let val_slot: Int = (0 + wasm_env_bind_var(env, "__si_v", wasm_val_type_i32()));
let f_slot: Int = (0 + wasm_env_bind_var(env, "__si_vf", wasm_val_type_f64()));
let f_ty: Int = (0 + wasm_lower_expr(env, f_val));
if f_ty == wasm_val_type_f64() { wasm_env_emit(env, op_local_set());
wasm_env_emit_u32(env, f_slot);
wasm_env_emit(env, op_local_get());
wasm_env_emit_u32(env, ptr_slot);
wasm_env_emit(env, op_local_get());
wasm_env_emit_u32(env, f_slot);
wasm_env_emit(env, op_f64_store());
wasm_env_emit_u32(env, 3);
wasm_env_emit_u32(env, offset);
} else if f_ty == wasm_val_type_i64() {
                wasm_env_emit(env, op_local_set());
                wasm_env_emit_u32(env, val_slot);
                wasm_env_emit(env, op_local_get());
                wasm_env_emit_u32(env, ptr_slot);
                wasm_env_emit(env, op_local_get());
                wasm_env_emit_u32(env, val_slot);
                wasm_env_emit(env, op_i64_store());
                wasm_env_emit_u32(env, 3);
                wasm_env_emit_u32(env, offset);
            } else {
                wasm_env_emit(env, op_local_set());
                wasm_env_emit_u32(env, val_slot);
                wasm_env_emit(env, op_local_get());
                wasm_env_emit_u32(env, ptr_slot);
                wasm_env_emit(env, op_local_get());
                wasm_env_emit_u32(env, val_slot);
                wasm_env_emit(env, op_i32_store());
                wasm_env_emit_u32(env, 2);
                wasm_env_emit_u32(env, offset);
            }
        }
        i = i + 1;
    }
    wasm_env_emit(env, op_local_get());
    wasm_env_emit_u32(env, ptr_slot);
    return wasm_val_type_i32();
}

pub fn wasm_lower_struct_expr(env: &mut WasmEnv, node: String) -> Int {
    let args: String = wasm_ast_args(node);
    let type_name: String = list_get_str(args, 0);
    let mut fields: List[String] = list_new();
    let n_args: Int = (0 + list_len_str(args));
    let mut i: Int = 1;
    while i < n_args {
        let f_item: String = list_get_str(args, i);
        if f_item != "" && !ast_is(f_item, "SEmpty") {
            let f_args: String = wasm_ast_args(f_item);
            let f_val: String = if ast_is(f_item, "AstField") { list_get_str(f_args, 1) } else { f_item };
            fields = list_push(fields, f_val);
        }
        i = i + 1;
    }
    return (0 + wasm_lower_struct_inst(env, type_name, fields, list_len(fields)));
}

pub fn wasm_lower_field_get(env: &mut WasmEnv, base_expr: String, field_offset: Int, val_type: Int) -> Int {
    let b_ty: Int = (0 + wasm_lower_expr(env, base_expr));
if val_type == wasm_val_type_f64() { wasm_env_emit(env, op_f64_load());
wasm_env_emit_u32(env, 3);
wasm_env_emit_u32(env, field_offset);
return wasm_val_type_f64();
}
    if val_type == wasm_val_type_i64() {
        wasm_env_emit(env, op_i64_load());
        wasm_env_emit_u32(env, 3); 
        wasm_env_emit_u32(env, field_offset);
        return wasm_val_type_i64();
    }
    wasm_env_emit(env, op_i32_load());
    wasm_env_emit_u32(env, 2);
    // align 4
    wasm_env_emit_u32(env, field_offset);
    return wasm_val_type_i32();
}

pub fn wasm_lower_field_set(env: &mut WasmEnv, base_expr: String, field_offset: Int, val_expr: String, val_type: Int) {
    let b_ty: Int = (0 + wasm_lower_expr(env, base_expr));
    let v_ty: Int = (0 + wasm_lower_expr(env, val_expr));
    if val_type == wasm_val_type_f64() {
        wasm_env_emit(env, op_f64_store());
        wasm_env_emit_u32(env, 3);
        wasm_env_emit_u32(env, field_offset);
        return;
    }
    if val_type == wasm_val_type_i64() {
        wasm_env_emit(env, op_i64_store());
        wasm_env_emit_u32(env, 3);
        wasm_env_emit_u32(env, field_offset);
        return;
    }
    wasm_env_emit(env, op_i32_store());
    wasm_env_emit_u32(env, 2);
    wasm_env_emit_u32(env, field_offset);
}
