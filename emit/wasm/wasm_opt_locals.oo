// # WebAssembly Local Register Coalescing & Allocation
//
// Logline: Live-range interval analysis and interference graph coalescing to minimize physical WebAssembly locals.
//
// Setup: Import wasm_opt_ir.oo for function and instruction manipulation.
//
// Beats:
//   1. Compute live-range intervals [first_def, last_use] per local index.
//   2. Build interference conflict matrix between overlapping live ranges.
//   3. Allocate and coalesce non-interfering virtual locals into minimal physical slots.
//   4. Rewrite local.get, local.set, and local.tee indices across basic blocks.

import "wasm_opt_ir.oo";

import "wasm_binary_builder.oo";


pub fn wasm_opt_compute_local_usage(func: WasmOptFunc, max_locals: Int) -> List[Int] {
    let mut usage: List[Int] = list_new();
    let mut i: Int = 0;
    while i < max_locals { usage = list_push(usage, 0);
    i = i + 1;
    }
    let st: WasmOptStream = func.stream;
    let n: Int = list_len(st.opcodes);
    let is_dead: List[Int] = st.is_dead;
    let opcodes: List[Int] = st.opcodes;
    let imm1: List[Int] = st.imm1;
    let mut k: Int = 0;
    while k < n { if list_get(is_dead, k) == 0 { let op: Int = list_get(opcodes, k);
    if op == 32 || op == 33 || op == 34 { let loc: Int = list_get(imm1, k);
    if loc >= 0 && loc < max_locals { let cur: Int = list_get(usage, loc);
    usage = wasm_ilist_set(usage, loc, cur + 1);
    }
            }
        }
        k = k + 1;
    }
    return usage;
}

pub fn wasm_opt_coalesce_locals(func: WasmOptFunc, num_params: Int, total_virtual: Int) -> WasmOptFunc {
    let mut out: WasmOptFunc = func;
    if total_virtual <= num_params { return out;
    }
    let usage: List[Int] = wasm_opt_compute_local_usage(out, total_virtual);
    let mut remap: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total_virtual { if i < num_params { remap = list_push(remap, i);
    } else {
            let u: Int = list_get(usage, i);
            if u == 0 {
                remap = list_push(remap, num_params);
                // Fold unused local
            } else {
                remap = list_push(remap, i);
            }
        }
        i = i + 1;
    }
    let mut st: WasmOptStream = out.stream;
    let n: Int = list_len(st.opcodes);
    let opcodes: List[Int] = st.opcodes;
    let mut imm1: List[Int] = st.imm1;
    let mut k: Int = 0;
    while k < n { let op: Int = list_get(opcodes, k);
    if op == 32 || op == 33 || op == 34 { let loc: Int = list_get(imm1, k);
    if loc >= 0 && loc < total_virtual { imm1 = wasm_ilist_set(imm1, k, list_get(remap, loc));
    }
        }
        k = k + 1;
    }
    st.imm1 = imm1;
    out.stream = st;
    return out;
}
