// # WebAssembly Binary and Unary Operations Lowering
//
// Logline: Lowering of binary arithmetic, bitwise, logic, comparisons, and unary operations for WebAssembly bytecode.
//
// Setup: wasm_opcodes, wasm_types, wasm_leb128, and wasm_lower_expr exist.
//
// Beats:
//   1. Lower boolean short-circuit logical operators (&&, ||).
//   2. Lower arithmetic, bitwise, and comparison operations for i32, i64, and f64.
//   3. Lower unary operators (negation, not).
// RULES.oot 1.7: Under 256 lines.

import "wasm_leb128.oo";

import "wasm_opcodes.oo";

import "wasm_types.oo";


import "wasm_lower_string.oo";


pub fn wasm_is_str_expr(env: &mut WasmEnv, expr: String) -> Bool {
    if expr == "" || ast_is(expr, "SEmpty") { return false; }
    let tag: String = ast_tag(expr);
    let args: String = wasm_ast_args(expr);
    if tag == "ELitStr" || tag == "EString" || tag == "EStr" || tag == "ELitString" {
        return true;
    }
    if tag == "ELit" {
        let lit_val: String = list_get_str(args, 0);
        if str_starts_with(lit_val, "str:") { return true; }
    }
    if tag == "EMethod" {
        let m_name: String = list_get_str(args, 1);
        if m_name == "to_string" || m_name == "str" || m_name == "format" {
            return true;
        }
    }
    if tag == "ECall" {
        let callee: String = list_get_str(args, 0);
        let fn_name: String = if ast_is(callee, "EVar") { list_get_str(wasm_ast_args(callee), 0) } else { callee };
        if fn_name == "to_string" || fn_name == "str" || fn_name == "format" || fn_name == "str_slice" || fn_name == "str_concat" || fn_name == "char_at" || fn_name == "list_get_str" {
            return true;
        }
    }
    if tag == "EBinop" {
        let op: String = list_get_str(args, 0);
        if op == "Add" || op == "+" {
            return wasm_is_str_expr(env, list_get_str(args, 1)) || wasm_is_str_expr(env, list_get_str(args, 2));
        }
    }
    if tag == "EVar" {
        let vname: String = list_get_str(args, 0);
        if wasm_env_lookup_is_str(env, vname) == 1 { return true; }
    }
    return false;
}

pub fn wasm_lower_str_node(env: &mut WasmEnv, node: String) -> Int {
    let tag: String = ast_tag(node); let args: String = wasm_ast_args(node); if tag == "ELitStr" || tag == "EString" || tag == "EStr" || tag == "ELitString" { let str_val: String = args; let slen: Int = chars_len(str_val); let ps: Int = (0 + wasm_env_alloc(env, 16 + slen)); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 4); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, slen); wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 8); let mut k: Int = 0; while k < slen { wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, byte_at(str_val, k)); wasm_env_emit(env, op_i32_store8()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 12 + k); k = k + 1;
}
        wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0);
        wasm_env_emit(env, op_i32_store8()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 12 + slen);
        wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps);
        return wasm_val_type_i32();
    }
    return (0 + wasm_lower_expr(env, node));
}

pub fn wasm_lower_binop(env: &mut WasmEnv, op: String, l_node: String, r_node: String) -> Int {
    if op == "Assign" || op == "=" {
        let vname: String = if ast_is(l_node, "EVar") { list_get_str(wasm_ast_args(l_node), 0) } else { l_node };
        let slot: Int = (0 + wasm_env_lookup_var(env, vname));
        wasm_lower_expr(env, r_node);
        if slot >= 0 { wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, slot); }
        else { wasm_env_emit(env, op_drop()); }
        return wasm_block_type_empty();
    }
    if op == "ANDAND" || op == "&&" || op == "And" {
        let l_ty: Int = (0 + wasm_lower_expr(env, l_node));
        if l_ty == wasm_val_type_i64() { wasm_env_emit(env, op_i64_eqz()); wasm_env_emit(env, op_i32_eqz()); }
        wasm_env_emit(env, op_if()); wasm_env_emit_byte(env, wasm_val_type_i32()); env.current_block_depth = env.current_block_depth + 1;
        let r_ty: Int = (0 + wasm_lower_expr(env, r_node));
        if r_ty == wasm_val_type_i64() { wasm_env_emit(env, op_i64_eqz()); wasm_env_emit(env, op_i32_eqz()); }
        wasm_env_emit(env, op_else()); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0);
        wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1; return wasm_val_type_i32();
    }
    if op == "OROR" || op == "||" || op == "Or" {
        let l_ty: Int = (0 + wasm_lower_expr(env, l_node));
        if l_ty == wasm_val_type_i64() { wasm_env_emit(env, op_i64_eqz()); wasm_env_emit(env, op_i32_eqz()); }
        wasm_env_emit(env, op_if()); wasm_env_emit_byte(env, wasm_val_type_i32()); env.current_block_depth = env.current_block_depth + 1;
        wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_else());
        let r_ty: Int = (0 + wasm_lower_expr(env, r_node));
        if r_ty == wasm_val_type_i64() { wasm_env_emit(env, op_i64_eqz()); wasm_env_emit(env, op_i32_eqz()); }
        wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1; return wasm_val_type_i32();
    }
    let is_str: Bool = wasm_is_str_expr(env, l_node) || wasm_is_str_expr(env, r_node);
    if (op == "Add" || op == "+") && is_str { let p1: Int = (0 + wasm_env_bind_var(env, "__strcat_p1", wasm_val_type_i32())); let p2: Int = (0 + wasm_env_bind_var(env, "__strcat_p2", wasm_val_type_i32())); let np: Int = (0 + wasm_env_bind_var(env, "__strcat_np", wasm_val_type_i32())); let l1: Int = (0 + wasm_env_bind_var(env, "__strcat_l1", wasm_val_type_i32())); let l2: Int = (0 + wasm_env_bind_var(env, "__strcat_l2", wasm_val_type_i32())); let tot: Int = (0 + wasm_env_bind_var(env, "__strcat_tot", wasm_val_type_i32())); let i_loc: Int = (0 + wasm_env_bind_var(env, "__strcat_i", wasm_val_type_i32())); wasm_lower_str_node(env, l_node); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, p1); wasm_lower_str_node(env, r_node); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, p2); wasm_emit_str_concat(env, p1, p2, np, l1, l2, tot, i_loc, 1024); return wasm_val_type_str(); }
    if (op == "Eq" || op == "==") && is_str { let p1: Int = (0 + wasm_env_bind_var(env, "__streq_p1", wasm_val_type_i32())); let p2: Int = (0 + wasm_env_bind_var(env, "__streq_p2", wasm_val_type_i32())); let l1: Int = (0 + wasm_env_bind_var(env, "__streq_l1", wasm_val_type_i32())); let l2: Int = (0 + wasm_env_bind_var(env, "__streq_l2", wasm_val_type_i32())); let i_loc: Int = (0 + wasm_env_bind_var(env, "__streq_i", wasm_val_type_i32())); wasm_lower_str_node(env, l_node); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, p1); wasm_lower_str_node(env, r_node); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, p2); wasm_emit_str_eq(env, p1, p2, l1, l2, i_loc); return wasm_val_type_i32(); }
    if (op == "Neq" || op == "!=") && is_str { let p1: Int = (0 + wasm_env_bind_var(env, "__streq_p1", wasm_val_type_i32())); let p2: Int = (0 + wasm_env_bind_var(env, "__streq_p2", wasm_val_type_i32())); let l1: Int = (0 + wasm_env_bind_var(env, "__streq_l1", wasm_val_type_i32())); let l2: Int = (0 + wasm_env_bind_var(env, "__streq_l2", wasm_val_type_i32())); let i_loc: Int = (0 + wasm_env_bind_var(env, "__streq_i", wasm_val_type_i32())); wasm_lower_str_node(env, l_node); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, p1); wasm_lower_str_node(env, r_node); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, p2); wasm_emit_str_ne(env, p1, p2, l1, l2, i_loc); return wasm_val_type_i32(); }
    let l_ty: Int = (0 + wasm_lower_expr(env, l_node));
    let r_ty: Int = (0 + wasm_lower_expr(env, r_node));
    let is_f64: Bool = (l_ty == wasm_val_type_f64()) || (r_ty == wasm_val_type_f64());
    let is_i64: Bool = (l_ty == wasm_val_type_i64()) || (r_ty == wasm_val_type_i64());
    if op == "Add" || op == "+" { if is_f64 { wasm_env_emit(env, op_f64_add()); return wasm_val_type_f64(); } if is_i64 { wasm_env_emit(env, op_i64_add()); return wasm_val_type_i64(); } wasm_env_emit(env, op_i32_add()); return wasm_val_type_i32(); }
    if op == "Sub" || op == "-" { if is_f64 { wasm_env_emit(env, op_f64_sub()); return wasm_val_type_f64(); } if is_i64 { wasm_env_emit(env, op_i64_sub()); return wasm_val_type_i64(); } wasm_env_emit(env, op_i32_sub()); return wasm_val_type_i32(); }
    if op == "Mul" || op == "*" { if is_f64 { wasm_env_emit(env, op_f64_mul()); return wasm_val_type_f64(); } if is_i64 { wasm_env_emit(env, op_i64_mul()); return wasm_val_type_i64(); } wasm_env_emit(env, op_i32_mul()); return wasm_val_type_i32(); }
    if op == "Div" || op == "/" { if is_f64 { wasm_env_emit(env, op_f64_div()); return wasm_val_type_f64(); } if is_i64 { wasm_env_emit(env, op_i64_div_s()); return wasm_val_type_i64(); } wasm_env_emit(env, op_i32_div_s()); return wasm_val_type_i32(); }
    if op == "Mod" || op == "%" { if is_i64 { wasm_env_emit(env, op_i64_rem_s()); return wasm_val_type_i64(); } wasm_env_emit(env, op_i32_rem_s()); return wasm_val_type_i32(); }
    if op == "BitAnd" || op == "&" { if is_i64 { wasm_env_emit(env, op_i64_and()); return wasm_val_type_i64(); } wasm_env_emit(env, op_i32_and()); return wasm_val_type_i32(); }
    if op == "BitOr" || op == "|" { if is_i64 { wasm_env_emit(env, op_i64_or()); return wasm_val_type_i64(); } wasm_env_emit(env, op_i32_or()); return wasm_val_type_i32(); }
    if op == "Xor" || op == "^" { if is_i64 { wasm_env_emit(env, op_i64_xor()); return wasm_val_type_i64(); } wasm_env_emit(env, op_i32_xor()); return wasm_val_type_i32(); }
    if op == "Shl" || op == "<<" { if is_i64 { wasm_env_emit(env, op_i64_shl()); return wasm_val_type_i64(); } wasm_env_emit(env, op_i32_shl()); return wasm_val_type_i32(); }
    if op == "Shr" || op == ">>" { if is_i64 { wasm_env_emit(env, op_i64_shr_s()); return wasm_val_type_i64(); } wasm_env_emit(env, op_i32_shr_s()); return wasm_val_type_i32(); }
    if op == "Eq" || op == "==" { if is_f64 { wasm_env_emit(env, op_f64_eq()); } else if is_i64 { wasm_env_emit(env, op_i64_eq()); } else { wasm_env_emit(env, op_i32_eq()); } return wasm_val_type_i32(); }
    if op == "Neq" || op == "!=" { if is_f64 { wasm_env_emit(env, op_f64_ne()); } else if is_i64 { wasm_env_emit(env, op_i64_ne()); } else { wasm_env_emit(env, op_i32_ne()); } return wasm_val_type_i32(); }
    if op == "Lt" || op == "<" { if is_f64 { wasm_env_emit(env, op_f64_lt()); } else if is_i64 { wasm_env_emit(env, op_i64_lt_s()); } else { wasm_env_emit(env, op_i32_lt_s()); } return wasm_val_type_i32(); }
    if op == "Lte" || op == "<=" { if is_f64 { wasm_env_emit(env, op_f64_le()); } else if is_i64 { wasm_env_emit(env, op_i64_le_s()); } else { wasm_env_emit(env, op_i32_le_s()); } return wasm_val_type_i32(); }
    if op == "Gt" || op == ">" { if is_f64 { wasm_env_emit(env, op_f64_gt()); } else if is_i64 { wasm_env_emit(env, op_i64_gt_s()); } else { wasm_env_emit(env, op_i32_gt_s()); } return wasm_val_type_i32(); }
    if op == "Gte" || op == ">=" { if is_f64 { wasm_env_emit(env, op_f64_ge()); } else if is_i64 { wasm_env_emit(env, op_i64_ge_s()); } else { wasm_env_emit(env, op_i32_ge_s()); } return wasm_val_type_i32(); }
    wasm_env_emit(env, op_i32_add()); return wasm_val_type_i32();
}

pub fn wasm_lower_unop(env: &mut WasmEnv, op: String, x_node: String) -> Int {
    if op == "Neg" || op == "-" {
        let ty: Int = (0 + wasm_lower_expr(env, x_node));
        if ty == wasm_val_type_f64() { wasm_env_emit(env, op_f64_neg()); return wasm_val_type_f64(); }
        if ty == wasm_val_type_i64() { wasm_env_emit(env, op_i64_const()); wasm_env_emit_i64(env, -1); wasm_env_emit(env, op_i64_mul()); return wasm_val_type_i64(); }
        wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, -1); wasm_env_emit(env, op_i32_mul()); return wasm_val_type_i32();
    }
    if op == "Not" || op == "!" {
        let ty: Int = (0 + wasm_lower_expr(env, x_node));
        if ty == wasm_val_type_i64() { wasm_env_emit(env, op_i64_eqz()); return wasm_val_type_i32(); }
        wasm_env_emit(env, op_i32_eqz()); return wasm_val_type_i32();
    }
    return (0 + wasm_lower_expr(env, x_node));
}

