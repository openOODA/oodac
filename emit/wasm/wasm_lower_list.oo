// # WebAssembly Dynamic List Lowering Engine
//
// Logline: Lowers dynamic List[T] creation, length queries, indexing, and appending.
//
// Setup: Import wasm_opcodes.oo, wasm_types.oo, wasm_leb128.oo, wasm_lower_expr.oo, ast.oo.
//
// Beats:
//   1. Lower list allocation and capacity tracking.
//   2. Lower list_len length queries.
//   3. Lower list_get and list_set indexed memory operations.
//   4. Lower list_push dynamic growth operations.

import "wasm_opcodes.oo";

import "wasm_types.oo";

import "wasm_leb128.oo";



pub fn wasm_lower_list_new(env: &mut WasmEnv) -> Int {
    let slot: Int = (0 + wasm_env_alloc(env, 1024));
wasm_env_emit(env, op_local_get());
wasm_env_emit_u32(env, slot);
wasm_env_emit(env, op_i32_const());
wasm_env_emit_i32(env, 1);
wasm_env_emit(env, op_i32_store());
wasm_env_emit_u32(env, 2);
wasm_env_emit_u32(env, 0);
wasm_env_emit(env, op_local_get());
wasm_env_emit_u32(env, slot);
wasm_env_emit(env, op_i32_const());
wasm_env_emit_i32(env, 120);
wasm_env_emit(env, op_i32_store());
wasm_env_emit_u32(env, 2);
wasm_env_emit_u32(env, 4);
wasm_env_emit(env, op_local_get());
wasm_env_emit_u32(env, slot);
wasm_env_emit(env, op_i32_const());
wasm_env_emit_i32(env, 0);
wasm_env_emit(env, op_i32_store());
wasm_env_emit_u32(env, 2);
wasm_env_emit_u32(env, 8);
wasm_env_emit(env, op_local_get());
wasm_env_emit_u32(env, slot);
return wasm_val_type_i32();
}

pub fn wasm_lower_list_len(env: &mut WasmEnv, l_expr: String) -> Int {
    let _l: Int = (0 + wasm_lower_expr(env, l_expr));
wasm_env_emit(env, op_i32_load());
wasm_env_emit_u32(env, 2);
wasm_env_emit_u32(env, 8);
return wasm_val_type_i32();
}

pub fn wasm_lower_list_get(env: &mut WasmEnv, l_expr: String, idx_expr: String, elem_type: Int) -> Int {
    let l_slot: Int = (0 + wasm_env_bind_var(env, "__lg_p", wasm_val_type_i32()));
let i_slot: Int = (0 + wasm_env_bind_var(env, "__lg_i", wasm_val_type_i32()));
let _l: Int = (0 + wasm_lower_expr(env, l_expr));
wasm_env_emit(env, op_local_set());
wasm_env_emit_u32(env, l_slot);
let _i: Int = (0 + wasm_lower_expr(env, idx_expr));
wasm_env_emit(env, op_local_set());
wasm_env_emit_u32(env, i_slot);
wasm_env_emit(env, op_local_get());
wasm_env_emit_u32(env, l_slot);
wasm_env_emit(env, op_local_get());
wasm_env_emit_u32(env, i_slot);
wasm_env_emit(env, op_i32_const());
wasm_env_emit_i32(env, 8);
wasm_env_emit(env, op_i32_mul());
wasm_env_emit(env, op_i32_add());
wasm_env_emit(env, op_i32_const());
wasm_env_emit_i32(env, 12);
wasm_env_emit(env, op_i32_add());
if elem_type == wasm_val_type_f64() { wasm_env_emit(env, op_f64_load());
wasm_env_emit_u32(env, 3);
wasm_env_emit_u32(env, 0);
return wasm_val_type_f64();
}
    if elem_type == wasm_val_type_i64() {
        wasm_env_emit(env, op_i64_load());
        wasm_env_emit_u32(env, 3);
        wasm_env_emit_u32(env, 0);
        return wasm_val_type_i64();
    }
    wasm_env_emit(env, op_i32_load());
    wasm_env_emit_u32(env, 2);
    wasm_env_emit_u32(env, 0);
    return wasm_val_type_i32();
}

pub fn wasm_lower_list_set(env: &mut WasmEnv, l_expr: String, idx_expr: String, val_expr: String, elem_type: Int) -> Int {
    let l_slot: Int = (0 + wasm_env_bind_var(env, "__ls_p", wasm_val_type_i32()));
let i_slot: Int = (0 + wasm_env_bind_var(env, "__ls_i", wasm_val_type_i32()));
let v_slot: Int = (0 + wasm_env_bind_var(env, "__ls_v", wasm_val_type_i32()));
let f_slot: Int = (0 + wasm_env_bind_var(env, "__ls_vf", wasm_val_type_f64()));
let _l: Int = (0 + wasm_lower_expr(env, l_expr));
wasm_env_emit(env, op_local_set());
wasm_env_emit_u32(env, l_slot);
let _i: Int = (0 + wasm_lower_expr(env, idx_expr));
wasm_env_emit(env, op_local_set());
wasm_env_emit_u32(env, i_slot);
let v_ty: Int = (0 + wasm_lower_expr(env, val_expr));
if v_ty == wasm_val_type_f64() { wasm_env_emit(env, op_local_set());
wasm_env_emit_u32(env, f_slot);
} else {
        wasm_env_emit(env, op_local_set());
        wasm_env_emit_u32(env, v_slot);
    }

    wasm_env_emit(env, op_local_get());
    wasm_env_emit_u32(env, l_slot);
    wasm_env_emit(env, op_local_get());
    wasm_env_emit_u32(env, i_slot);
    wasm_env_emit(env, op_i32_const());
    wasm_env_emit_i32(env, 8);
    wasm_env_emit(env, op_i32_mul());
    wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_i32_const());
    wasm_env_emit_i32(env, 12);
    wasm_env_emit(env, op_i32_add());

    if v_ty == wasm_val_type_f64() {
        wasm_env_emit(env, op_local_get());
        wasm_env_emit_u32(env, f_slot);
        wasm_env_emit(env, op_f64_store());
        wasm_env_emit_u32(env, 3);
        wasm_env_emit_u32(env, 0);
    } else if v_ty == wasm_val_type_i64() {
        wasm_env_emit(env, op_local_get());
        wasm_env_emit_u32(env, v_slot);
        wasm_env_emit(env, op_i64_store());
        wasm_env_emit_u32(env, 3);
        wasm_env_emit_u32(env, 0);
    } else {
        wasm_env_emit(env, op_local_get());
        wasm_env_emit_u32(env, v_slot);
        wasm_env_emit(env, op_i32_store());
        wasm_env_emit_u32(env, 2);
        wasm_env_emit_u32(env, 0);
    }

    wasm_env_emit(env, op_local_get());
    wasm_env_emit_u32(env, l_slot);
    return wasm_val_type_i32();
}

pub fn wasm_lower_list_push(env: &mut WasmEnv, l_expr: String, val_expr: String, elem_type: Int) -> Int {
    let l_slot: Int = (0 + wasm_env_bind_var(env, "__lp_p", wasm_val_type_i32()));
let len_slot: Int = (0 + wasm_env_bind_var(env, "__lp_len", wasm_val_type_i32()));
let v_slot: Int = (0 + wasm_env_bind_var(env, "__lp_v", wasm_val_type_i32()));
let f_slot: Int = (0 + wasm_env_bind_var(env, "__lp_vf", wasm_val_type_f64()));
let _l: Int = (0 + wasm_lower_expr(env, l_expr));
wasm_env_emit(env, op_local_set());
wasm_env_emit_u32(env, l_slot);
wasm_env_emit(env, op_local_get());
wasm_env_emit_u32(env, l_slot);
wasm_env_emit(env, op_i32_load());
wasm_env_emit_u32(env, 2);
wasm_env_emit_u32(env, 8);
wasm_env_emit(env, op_local_set());
wasm_env_emit_u32(env, len_slot);
let v_ty: Int = (0 + wasm_lower_expr(env, val_expr));
if v_ty == wasm_val_type_f64() { wasm_env_emit(env, op_local_set());
wasm_env_emit_u32(env, f_slot);
} else {
        wasm_env_emit(env, op_local_set());
        wasm_env_emit_u32(env, v_slot);
    }

    wasm_env_emit(env, op_local_get());
    wasm_env_emit_u32(env, l_slot);
    wasm_env_emit(env, op_local_get());
    wasm_env_emit_u32(env, len_slot);
    wasm_env_emit(env, op_i32_const());
    wasm_env_emit_i32(env, 8);
    wasm_env_emit(env, op_i32_mul());
    wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_i32_const());
    wasm_env_emit_i32(env, 12);
    wasm_env_emit(env, op_i32_add());

    if v_ty == wasm_val_type_f64() {
        wasm_env_emit(env, op_local_get());
        wasm_env_emit_u32(env, f_slot);
        wasm_env_emit(env, op_f64_store());
        wasm_env_emit_u32(env, 3);
        wasm_env_emit_u32(env, 0);
    } else if v_ty == wasm_val_type_i64() {
        wasm_env_emit(env, op_local_get());
        wasm_env_emit_u32(env, v_slot);
        wasm_env_emit(env, op_i64_store());
        wasm_env_emit_u32(env, 3);
        wasm_env_emit_u32(env, 0);
    } else {
        wasm_env_emit(env, op_local_get());
        wasm_env_emit_u32(env, v_slot);
        wasm_env_emit(env, op_i32_store());
        wasm_env_emit_u32(env, 2);
        wasm_env_emit_u32(env, 0);
    }

    wasm_env_emit(env, op_local_get());
    wasm_env_emit_u32(env, l_slot);
    wasm_env_emit(env, op_local_get());
    wasm_env_emit_u32(env, len_slot);
    wasm_env_emit(env, op_i32_const());
    wasm_env_emit_i32(env, 1);
    wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_i32_store());
    wasm_env_emit_u32(env, 2);
    wasm_env_emit_u32(env, 8);

    wasm_env_emit(env, op_local_get());
    wasm_env_emit_u32(env, l_slot);
    return wasm_val_type_i32();
}

