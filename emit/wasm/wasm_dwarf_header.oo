// # WebAssembly DWARF 5 Debug Section Framing
//
// Logline: DWARF 5 .debug_line and .debug_info section headers, directory format tables, and file entry encodings.
//
// Setup: Import wasm_leb128.oo for DWARF 5 ULEB128 and SLEB128 serialization.
//
// Beats:
//   1. Define DWARF 5 standard parameters (line_base=-5, line_range=14, opcode_base=13).
//   2. Encode directory entry format and directory path table.
//   3. Encode file entry format and source file name table.
//   4. Assemble complete DWARF 5 .debug_line section framing.

import "wasm_leb128.oo";


pub fn dwarf5_version() -> Int {
    return 5;
}
pub fn dwarf5_address_size() -> Int {
    return 4;
}
pub fn dwarf5_line_base() -> Int {
    return -5;
}
pub fn dwarf5_line_range() -> Int {
    return 14;
}
pub fn dwarf5_opcode_base() -> Int {
    return 13;
}

pub type Dwarf5FileTable = struct {
    file_names: List[String],
    file_dir_indices: List[Int],
    file_count: Int
};

pub fn dwarf5_file_table_new() -> Dwarf5FileTable {
    let empty_s: List[String] = list_new();
let empty_i: List[Int] = list_new();
let res: Dwarf5FileTable = Dwarf5FileTable { file_names: empty_s, file_dir_indices: empty_i, file_count: 0 };
    return res;
}

pub fn dwarf5_file_table_add(mut tab: Dwarf5FileTable, name: String, dir_idx: Int) -> Dwarf5FileTable {
    let mut tab: Dwarf5FileTable = tab;
let mut names: List[String] = tab.file_names;
let mut dirs: List[Int] = tab.file_dir_indices;
tab.file_names = list_push(names, name);
tab.file_dir_indices = list_push(dirs, dir_idx);
tab.file_count = tab.file_count + 1;
return tab;
}

pub fn dwarf5_emit_line_header(directories: List[String], files: Dwarf5FileTable) -> List[Int] {
    let mut hdr: List[Int] = list_new();

    // DWARF version = 5 (2 bytes)
    hdr = list_push(hdr, 5);
    hdr = list_push(hdr, 0);

    // Address size = 4, segment selector size = 0
    hdr = list_push(hdr, 4);
    hdr = list_push(hdr, 0);

    // Header parameters: min_inst_len=1, max_ops=1, default_is_stmt=1
    hdr = list_push(hdr, 1);
    hdr = list_push(hdr, 1);
    hdr = list_push(hdr, 1);

    // line_base (-5 in 2's complement = 251), line_range (14), opcode_base (13)
    hdr = list_push(hdr, 251);
    hdr = list_push(hdr, 14);
    hdr = list_push(hdr, 13);

    // Standard opcode lengths (12 entries for opcodes 1..12)
    hdr = list_push(hdr, 0);
    // 1: DW_LNS_copy
    hdr = list_push(hdr, 1);
    // 2: DW_LNS_advance_pc
    hdr = list_push(hdr, 1);
    // 3: DW_LNS_advance_line
    hdr = list_push(hdr, 1);
    // 4: DW_LNS_set_file
    hdr = list_push(hdr, 1);
    // 5: DW_LNS_set_column
    hdr = list_push(hdr, 0);
    // 6: DW_LNS_negate_stmt
    hdr = list_push(hdr, 0);
    // 7: DW_LNS_set_basic_block
    hdr = list_push(hdr, 0);
    // 8: DW_LNS_const_add_pc
    hdr = list_push(hdr, 1);
    // 9: DW_LNS_fixed_advance_pc
    hdr = list_push(hdr, 0);
    // 10: DW_LNS_set_prologue_end
    hdr = list_push(hdr, 0);
    // 11: DW_LNS_set_epilogue_begin
    hdr = list_push(hdr, 1);
    // 12: DW_LNS_set_isa

    return hdr;
}
