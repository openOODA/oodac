// # WebAssembly Bytecode Optimizer IR & CFG
//
// Logline: Linear instruction stream, basic block control flow graph, and analysis structures for WebAssembly bytecode optimization.
//
// Setup: Import wasm_leb128.oo for instruction immediate and label indexing.
//
// Beats:
//   1. Define WasmOptStream with parallel instruction attribute vectors.
//   2. Define WasmOptFunc representing function bytecode and block boundaries.
//   3. Convert raw WebAssembly bytecode streams into structured Opt IR.
//   4. Flatten optimized IR blocks back into binary byte sequences.

import "wasm_leb128.oo";


pub type WasmOptStream = struct {
    opcodes: List[Int],
    imm1: List[Int],
    imm2: List[Int],
    is_dead: List[Int],
    inst_count: Int
};

pub type WasmOptFunc = struct {
    func_index: Int,
    stream: WasmOptStream,
    param_types: List[Int],
    result_types: List[Int],
    local_types: List[Int]
};

pub fn wasm_opt_stream_new() -> WasmOptStream {
    let empty_ops: List[Int] = list_new();
let empty_i1: List[Int] = list_new();
let empty_i2: List[Int] = list_new();
let empty_d: List[Int] = list_new();
let res: WasmOptStream = WasmOptStream { opcodes: empty_ops, imm1: empty_i1, imm2: empty_i2, is_dead: empty_d, inst_count: 0 };
    return res;
}

pub fn wasm_opt_stream_push(mut st: WasmOptStream, op: Int, i1: Int, i2: Int) -> WasmOptStream {
    let mut st: WasmOptStream = st;
st.opcodes = list_push(st.opcodes, op);
st.imm1 = list_push(st.imm1, i1);
st.imm2 = list_push(st.imm2, i2);
st.is_dead = list_push(st.is_dead, 0);
st.inst_count = st.inst_count + 1;
return st;
}

pub fn wasm_opt_func_new(idx: Int, params: List[Int], results: List[Int]) -> WasmOptFunc {
    let empty_loc: List[Int] = list_new();
let res: WasmOptFunc = WasmOptFunc { func_index: idx, stream: wasm_opt_stream_new(), param_types: params, result_types: results, local_types: empty_loc };
    return res;
}

pub fn wasm_opt_emit_inst_bytes(op: Int, i1: Int, i2: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, op);
    if op == 32 || op == 33 || op == 34 || op == 16 || op == 18 {
        // local.get, local.set, local.tee, call, return_call
        let leb: List[Int] = encode_u32_leb128(i1);
        let mut i: Int = 0;
        while i < list_len(leb) { out = list_push(out, list_get(leb, i));
        i = i + 1;
        }
    } else if op == 65 {
        // i32.const
        let leb: List[Int] = encode_i32_leb128(i1);
        let mut i: Int = 0;
        while i < list_len(leb) { out = list_push(out, list_get(leb, i));
        i = i + 1;
        }
    } else if op == 66 {
        // i64.const
        let leb: List[Int] = encode_i64_leb128(i1);
        let mut i: Int = 0;
        while i < list_len(leb) { out = list_push(out, list_get(leb, i));
        i = i + 1;
        }
    } else if op == 2 || op == 3 || op == 4 { out = list_push(out, i1 & 127);
    } else if op == 12 || op == 13 {
        // br, br_if
        let leb: List[Int] = encode_u32_leb128(i1);
        let mut i: Int = 0;
        while i < list_len(leb) { out = list_push(out, list_get(leb, i));
        i = i + 1;
        }
    } else if op == 40 || op == 54 {
        // i32.load, i32.store (align, offset)
        let leb_a: List[Int] = encode_u32_leb128(i1);
        let mut i: Int = 0;
        while i < list_len(leb_a) { out = list_push(out, list_get(leb_a, i));
        i = i + 1;
        }
        let leb_o: List[Int] = encode_u32_leb128(i2);
        let mut j: Int = 0;
        while j < list_len(leb_o) { out = list_push(out, list_get(leb_o, j));
        j = j + 1;
        }
    }
    return out;
}

pub fn wasm_opt_func_flatten(func: WasmOptFunc) -> List[Int] {
    let mut out: List[Int] = list_new();
    let st: WasmOptStream = func.stream;
    let n: Int = st.inst_count;
    let is_dead: List[Int] = st.is_dead;
    let opcodes: List[Int] = st.opcodes;
    let imm1: List[Int] = st.imm1;
    let imm2: List[Int] = st.imm2;
    let mut i: Int = 0;
    while i < n { if list_get(is_dead, i) == 0 { let op: Int = list_get(opcodes, i);
    let i1: Int = list_get(imm1, i);
    let i2: Int = list_get(imm2, i);
    let ibytes: List[Int] = wasm_opt_emit_inst_bytes(op, i1, i2);
    let mut k: Int = 0;
    while k < list_len(ibytes) { out = list_push(out, list_get(ibytes, k));
    k = k + 1;
    }
        }
        i = i + 1;
    }
    return out;
}
