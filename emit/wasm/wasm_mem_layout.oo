// # WebAssembly Linear Memory Layout & Dynamic Bump Allocator
//
// Logline: Implements 4-tier linear memory model, string literal registration, malloc, and memcpy.
//
// Setup: Import wasm_opcodes.oo, wasm_types.oo, wasm_leb128.oo, wasm_binary_builder.oo, wasm_lower_expr.oo.
//
// Beats:
//   1. Frame scratch, rodata, shadow stack, and dynamic heap memory zones.
//   2. Register deduplicated string constants in rodata.
//   3. Emit dynamic bump allocator malloc with memory.grow and bounds checking.
//   4. Emit memory copy and memory fill byte loops.

import "wasm_opcodes.oo";
import "wasm_types.oo";
import "wasm_leb128.oo";
import "wasm_binary_builder.oo";

// Scratch Layout:
//   0..7:   IOVec 1 (buf_ptr: u32, buf_len: u32)
//   8..15:  IOVec 2 (buf_ptr: u32, buf_len: u32)
//   16..23: Syscall return scratch / nwritten
//   24..27: Newline buffer (0x0A)
//   32..35: Heap pointer (u32 address of dynamic bump allocator)
type WasmMemLayout = struct {
    scratch_base: Int,
    scratch_size: Int,
    rodata_base: Int,
    rodata_bytes: List[Int],
    str_keys: List[String],
    str_offsets: List[Int],
    shadow_stack_base: Int,
    shadow_stack_size: Int,
    heap_base: Int,
    heap_ptr_addr: Int
};

pub fn wasm_zone_scratch_base() -> Int { return 0; }
pub fn wasm_zone_scratch_size() -> Int { return 1024; }
pub fn wasm_zone_rodata_base() -> Int { return 1024; }
pub fn wasm_zone_shadow_stack_size() -> Int { return 8192; }
pub fn wasm_zone_heap_ptr_addr() -> Int { return 32; }

pub fn wasm_mem_layout_new() -> WasmMemLayout {
    return WasmMemLayout {
        scratch_base: 0,
        scratch_size: 4096,
        rodata_base: 4096,
        rodata_bytes: list_new(),
        str_keys: list_new(),
        str_offsets: list_new(),
        shadow_stack_base: 4096,
        shadow_stack_size: 8192,
        heap_base: 12288,
        heap_ptr_addr: 32
    };
}

pub fn wasm_rodata_add_string(mem: &mut WasmMemLayout, s: String) -> Int {
    let keys: List[String] = (*mem).str_keys;
    let offsets: List[Int] = (*mem).str_offsets;
    let n_strs: Int = list_len(keys);
    let mut i: Int = 0;
    while i < n_strs {
        if list_get(keys, i) == s { return list_get(offsets, i); }
        i = i + 1;
    }
    let offset: Int = (*mem).rodata_base + list_len((*mem).rodata_bytes);
    let slen: Int = chars_len(s);
    // 12-byte header: ref_count=1 (0..3), flags=OO_FLAG_STATIC=1 (4..7), length=slen (8..11)
    (*mem).rodata_bytes = list_push((*mem).rodata_bytes, 1); (*mem).rodata_bytes = list_push((*mem).rodata_bytes, 0);
    (*mem).rodata_bytes = list_push((*mem).rodata_bytes, 0); (*mem).rodata_bytes = list_push((*mem).rodata_bytes, 0);
    (*mem).rodata_bytes = list_push((*mem).rodata_bytes, 1); (*mem).rodata_bytes = list_push((*mem).rodata_bytes, 0);
    (*mem).rodata_bytes = list_push((*mem).rodata_bytes, 0); (*mem).rodata_bytes = list_push((*mem).rodata_bytes, 0);
    (*mem).rodata_bytes = list_push((*mem).rodata_bytes, slen & 255); (*mem).rodata_bytes = list_push((*mem).rodata_bytes, (slen >> 8) & 255);
    (*mem).rodata_bytes = list_push((*mem).rodata_bytes, (slen >> 16) & 255); (*mem).rodata_bytes = list_push((*mem).rodata_bytes, (slen >> 24) & 255);
    i = 0;
    while i < slen { (*mem).rodata_bytes = list_push((*mem).rodata_bytes, byte_at(s, i)); i = i + 1; }
    (*mem).rodata_bytes = list_push((*mem).rodata_bytes, 0);
    while (list_len((*mem).rodata_bytes) % 8) != 0 {
        let mut pad_bytes: List[Int] = (*mem).rodata_bytes;
        pad_bytes = list_push(pad_bytes, 0);
        (*mem).rodata_bytes = pad_bytes;
    }
    let mut cur_keys: List[String] = (*mem).str_keys;
    cur_keys = list_push(cur_keys, s);
    (*mem).str_keys = cur_keys;
    let mut cur_offsets: List[Int] = (*mem).str_offsets;
    cur_offsets = list_push(cur_offsets, offset);
    (*mem).str_offsets = cur_offsets;
    let r_end: Int = (*mem).rodata_base + list_len((*mem).rodata_bytes);
    (*mem).shadow_stack_base = ((r_end + 7) / 8) * 8;
    (*mem).heap_base = (*mem).shadow_stack_base + (*mem).shadow_stack_size;
    return offset;
}

pub fn wasm_rodata_lookup_string(mem: &WasmMemLayout, s: String) -> Int {
    let keys: List[String] = (*mem).str_keys;
    let offsets: List[Int] = (*mem).str_offsets;
    let n_strs: Int = list_len(keys);
    let mut i: Int = 0;
    while i < n_strs {
        if list_get(keys, i) == s { return list_get(offsets, i); }
        i = i + 1;
    }
    return -1;
}

pub fn wasm_mem_init(builder: &mut WasmModuleBuilder, initial_pages: Int, max_pages: Int) {
    wasm_builder_set_memory(builder, initial_pages, max_pages);
    wasm_builder_add_export(builder, "memory", wasm_external_memory(), 0);
}

pub fn wasm_mem_emit_data_section(builder: &mut WasmModuleBuilder, mem: &WasmMemLayout) {
    let hb: Int = (*mem).heap_base;
    let mut heap_init: List[Int] = list_new();
    heap_init = list_push(heap_init, hb & 255); heap_init = list_push(heap_init, (hb >> 8) & 255);
    heap_init = list_push(heap_init, (hb >> 16) & 255); heap_init = list_push(heap_init, (hb >> 24) & 255);
    wasm_builder_add_data(builder, (*mem).heap_ptr_addr, heap_init);
    if list_len((*mem).rodata_bytes) > 0 {
        wasm_builder_add_data(builder, (*mem).rodata_base, (*mem).rodata_bytes);
    }
}

pub fn wasm_emit_malloc(env: &mut WasmEnv, size_bytes_local: Int) {
    let cur_ptr: Int = (0 + wasm_env_bind_var(env, "__malloc_cur", wasm_val_type_i32()));
    let new_ptr: Int = (0 + wasm_env_bind_var(env, "__malloc_new", wasm_val_type_i32()));
    let al_sz: Int = (0 + wasm_env_bind_var(env, "__malloc_sz", wasm_val_type_i32()));

    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, size_bytes_local);
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 7); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, -8); wasm_env_emit(env, op_i32_and());
    wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, al_sz);

    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, wasm_zone_heap_ptr_addr());
    wasm_env_emit(env, op_i32_load()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0);
    wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, cur_ptr);

    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, cur_ptr);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, al_sz);
    wasm_env_emit(env, op_i32_add()); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, new_ptr);

    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, new_ptr);
    wasm_env_emit(env, op_memory_size()); wasm_env_emit_byte(env, 0);
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 16); wasm_env_emit(env, op_i32_shl());
    wasm_env_emit(env, op_i32_gt_u());

    wasm_env_emit(env, op_if()); wasm_env_emit_byte(env, wasm_block_type_empty()); (*env).current_block_depth = (*env).current_block_depth + 1;
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, new_ptr);
    wasm_env_emit(env, op_memory_size()); wasm_env_emit_byte(env, 0);
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 16); wasm_env_emit(env, op_i32_shl()); wasm_env_emit(env, op_i32_sub());
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 65535); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 16); wasm_env_emit(env, op_i32_shr_u());
    wasm_env_emit(env, op_memory_grow()); wasm_env_emit_byte(env, 0); wasm_env_emit(env, op_drop());
    wasm_env_emit(env, op_end()); (*env).current_block_depth = (*env).current_block_depth - 1;

    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, wasm_zone_heap_ptr_addr());
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, new_ptr);
    wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, cur_ptr);
}

pub fn wasm_emit_memcpy(env: &mut WasmEnv, dest_ptr: Int, src_ptr: Int, len: Int) {
    let i_loc: Int = (0 + wasm_env_bind_var(env, "__memcpy_i", wasm_val_type_i32()));
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, i_loc);
    wasm_env_emit(env, op_block()); wasm_env_emit_byte(env, wasm_block_type_empty()); (*env).current_block_depth = (*env).current_block_depth + 1;
    wasm_env_emit(env, op_loop()); wasm_env_emit_byte(env, wasm_block_type_empty()); (*env).current_block_depth = (*env).current_block_depth + 1;

    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_loc);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, len);
    wasm_env_emit(env, op_i32_ge_u()); wasm_env_emit(env, op_br_if()); wasm_env_emit_u32(env, 1);

    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, dest_ptr);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_loc); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, src_ptr);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_loc); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_i32_load8_u()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 0);
    wasm_env_emit(env, op_i32_store8()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 0);

    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_loc);
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, i_loc);
    wasm_env_emit(env, op_br()); wasm_env_emit_u32(env, 0);
    wasm_env_emit(env, op_end()); (*env).current_block_depth = (*env).current_block_depth - 1;
    wasm_env_emit(env, op_end()); (*env).current_block_depth = (*env).current_block_depth - 1;
}

pub fn wasm_emit_memset(env: &mut WasmEnv, dest_ptr: Int, val_byte: Int, len: Int) {
    let i_loc: Int = (0 + wasm_env_bind_var(env, "__memset_i", wasm_val_type_i32()));
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, i_loc);
    wasm_env_emit(env, op_block()); wasm_env_emit_byte(env, wasm_block_type_empty()); (*env).current_block_depth = (*env).current_block_depth + 1;
    wasm_env_emit(env, op_loop()); wasm_env_emit_byte(env, wasm_block_type_empty()); (*env).current_block_depth = (*env).current_block_depth + 1;

    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_loc);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, len);
    wasm_env_emit(env, op_i32_ge_u()); wasm_env_emit(env, op_br_if()); wasm_env_emit_u32(env, 1);

    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, dest_ptr);
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_loc); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, val_byte);
    wasm_env_emit(env, op_i32_store8()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 0);

    wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, i_loc);
    wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_i32_add());
    wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, i_loc);
    wasm_env_emit(env, op_br()); wasm_env_emit_u32(env, 0);
    wasm_env_emit(env, op_end()); (*env).current_block_depth = (*env).current_block_depth - 1;
    wasm_env_emit(env, op_end()); (*env).current_block_depth = (*env).current_block_depth - 1;
}
