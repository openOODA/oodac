// # WebAssembly Component WIT IDL Generator
//
// Logline: Generate official WIT (WebAssembly Interface Types) IDL definitions from openOODA module ASTs.
//
// Setup: Inspects exported structs, types, functions, and WASI imports to format WIT documents.
//
// Beats:
//   1. Generate package namespace, name, and semver headers.
//   2. Format records, variants, enums, and flags into WIT schemas.
//   3. Format function exports with parameter and return signatures.
//   4. Package complete world definitions with imports and exports.

import "wasm_component_types.oo";


pub fn wit_format_type_name(comp_type: Int) -> String {
    if comp_type == comp_type_bool() { return "bool";
    }
    if comp_type == comp_type_s8() { return "s8";
    }
    if comp_type == comp_type_u8() { return "u8";
    }
    if comp_type == comp_type_s16() { return "s16";
    }
    if comp_type == comp_type_u16() { return "u16";
    }
    if comp_type == comp_type_s32() { return "s32";
    }
    if comp_type == comp_type_u32() { return "u32";
    }
    if comp_type == comp_type_s64() { return "s64";
    }
    if comp_type == comp_type_u64() { return "u64";
    }
    if comp_type == comp_type_f32() { return "f32";
    }
    if comp_type == comp_type_f64() { return "f64";
    }
    if comp_type == comp_type_char() { return "char";
    }
    if comp_type == comp_type_string() { return "string";
    }
    return "u32";
}

pub fn wit_format_record(name: String, rec: CompRecord) -> String {
    let mut out: String = "    record " + name + " {\n";
let fnames: List[String] = comp_record_field_names(rec);
let ftypes: List[Int] = comp_record_field_types(rec);
let count: Int = list_len(fnames);
let mut i: Int = 0;
while i < count { let fname: String = list_get(fnames, i);
let ftype: Int = list_get(ftypes, i);
out = out + "        " + fname + ": " + wit_format_type_name(ftype) + ",\n";
i = i + 1;
}
    out = out + "    }\n";
    return out;
}

pub fn wit_format_func(name: String, ftype: CompFuncType) -> String {
    let mut out: String = "    export " + name + ": func(";
    let pnames: List[String] = comp_func_param_names(ftype);
    let ptypes: List[Int] = comp_func_param_types(ftype);
    let n: Int = list_len(pnames);
    let mut i: Int = 0;
    while i < n {
        let pname: String = list_get(pnames, i);
        let ptype: Int = list_get(ptypes, i);
        out = out + pname + ": " + wit_format_type_name(ptype);
        if i < n - 1 { out = out + ", ";
        }
        i = i + 1;
    }
    out = out + ")";
    let res_ty: Int = comp_func_res_type(ftype);
    if res_ty > 0 { out = out + " -> " + wit_format_type_name(res_ty);
    }
    out = out + ";\n";
    return out;
}

pub fn wit_format_world(pkg_ns: String, pkg_name: String, version: String, world_name: String, body: String) -> String {
    let mut out: String = "package " + pkg_ns + ":" + pkg_name + "@" + version + ";\n\n";
    out = out + "world " + world_name + " {\n";
    out = out + "    import wasi:cli/environment@0.2.0;\n";
    out = out + "    import wasi:cli/stdout@0.2.0;\n";
    out = out + body;
    out = out + "}\n";
    return out;
}
