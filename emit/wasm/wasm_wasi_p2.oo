// # WASI Preview 2 Host Interface & Adapter Bridge
//
// Logline: WASI Preview 2 component imports (wasi:cli, wasi:io/streams, wasi:filesystem) and Preview 1 compatibility adapter.
//
// Setup: Import wasm_component_types.oo and wasm_component_canonical.oo for interface bindings.
//
// Beats:
//   1. Declare wasi:cli/environment and wasi:cli/exit component imports.
//   2. Declare wasi:io/streams input and output stream handles.
//   3. Declare wasi:filesystem/types descriptor and file operations.
//   4. Synthesize Preview 1 fd_write shim wrapping Preview 2 output-stream write.

import "wasm_component_types.oo";

import "wasm_component_canonical.oo";


pub type WasiP2Import = struct {
    interface_name: String,
    function_name: String,
    param_types: List[Int],
    result_type: Int
};

pub fn wasi_p2_import_new(iface: String, fn_name: String, params: List[Int], res: Int) -> WasiP2Import {
    let res: WasiP2Import = WasiP2Import { interface_name: iface, function_name: fn_name, param_types: params, result_type: res };
    return res;
}

pub fn wasi_p2_standard_imports() -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, "wasi:cli/exit@0.2.0:exit");
    out = list_push(out, "wasi:cli/stdout@0.2.0:get-stdout");
    out = list_push(out, "wasi:io/streams@0.2.0:blocking-write-and-flush");
    return out;
}
