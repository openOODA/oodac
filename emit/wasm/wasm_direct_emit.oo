// # WebAssembly Direct Binary Emitter
//
// Logline: Writes compiled WebAssembly binary bytecode and dual-mode loader packages directly to disk via FsCap.
//
// Setup: Import wasm_backend_driver.oo and wasm_js_glue_gen.oo before direct emission.
//
// Beats:
//   1. Compile and emit standalone linear WebAssembly binary.
//   2. Compile and emit standalone Wasm-GC WebAssembly binary.
//   3. Compile and emit unified dual package (.gc.wasm, .linear.wasm, .js, .d.ts).
//   4. Return operation success status.

import "wasm_backend_driver.oo";

import "wasm_js_glue_gen.oo";


fn path_strip_ext(p: String) -> String {
    let n: Int = chars_len(p);
    if n >= 5 && str_slice(p, n - 5, n) == ".wasm" { return str_slice(p, 0, n - 5);
    }
    if n >= 4 && str_slice(p, n - 4, n) == ".bin" { return str_slice(p, 0, n - 4);
    }
    return p;
}

fn path_file_basename(p: String) -> String {
    let n: Int = chars_len(p);
    let mut last_slash: Int = -1;
    let mut i: Int = 0;
    while i < n {
        if byte_at(p, i) == 47 { last_slash = i;
        }
        i = i + 1;
    }
    if last_slash >= 0 && last_slash + 1 < n { return str_slice(p, last_slash + 1, n);
    }
    return p;
}

fn make_js_module_name(raw: String) -> String {
    let clean: String = path_file_basename(path_strip_ext(raw));
    let n: Int = chars_len(clean);
    if n == 0 { return "Module";
    }
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n { let b: Int = byte_at(clean, i);
    if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) { out = out + str_slice(clean, i, i + 1);
    } else {
            out = out + "_";
        }
        i = i + 1;
    }
    return out;
}

fn wasm_write_bin_file(fs: &FsWriteCap, sys: &ProcessCap, out_path: String, bin: List[Int]) -> Bool {
    let s: String = bytes_to_str(bin);
    let r: Result[Void, String] = write_file(fs, out_path, s);
    if r.is_ok() { return true;
    }
    let n: Int = list_len(bin);
    let mut oct: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n { let b: Int = list_get(bin, i) & 255;
    oct = list_push(oct, 92);
    oct = list_push(oct, 48 + ((b / 64) % 8));
    oct = list_push(oct, 48 + ((b / 8) % 8));
    oct = list_push(oct, 48 + (b % 8));
    i = i + 1;
    }
    let oct_str: String = bytes_to_str(oct);
    let on: Int = chars_len(oct_str);
    if on <= 32768 { let cmd: String = "printf '" + oct_str + "' > " + out_path;
    let res: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    return res.is_ok();
    }
    let cl_res: Result[String, String] = sys_exec(sys, "sh", "-c", ": > " + out_path);
    if cl_res.is_err() { return false;
    }
    let mut k: Int = 0;
    while k < on {
        let mut j: Int = k + 16384;
        if j > on { j = on;
        }
        let chunk: String = str_slice(oct_str, k, j);
        let ap_res: Result[String, String] = sys_exec(sys, "sh", "-c", "printf '" + chunk + "' >> " + out_path);
        if ap_res.is_err() { return false;
        }
        k = j;
    }
    return true;
}

fn wasm_write_text_file(fs: &FsWriteCap, sys: &ProcessCap, out_path: String, text: String) -> Bool {
    let r: Result[Void, String] = write_file(fs, out_path, text);
    if r.is_ok() { return true;
    }
    let n: Int = chars_len(text);
    let mut oct: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n { let b: Int = byte_at(text, i) & 255;
    oct = list_push(oct, 92);
    oct = list_push(oct, 48 + ((b / 64) % 8));
    oct = list_push(oct, 48 + ((b / 8) % 8));
    oct = list_push(oct, 48 + (b % 8));
    i = i + 1;
    }
    let oct_str: String = bytes_to_str(oct);
    let cmd: String = "printf '" + oct_str + "' > " + out_path;
    let res: Result[String, String] = sys_exec(sys, "sh", "-c", cmd);
    return res.is_ok();
}

pub fn wasm_emit_direct_binary(fs: &FsWriteCap, sys: &ProcessCap, src: String, out_path: String) -> Bool {
    let bin: List[Int] = wasm_driver_compile_source(src, "wasi");
    if list_len(bin) == 0 { return false;
    }
    return wasm_write_bin_file(fs, sys, out_path, bin);
}

pub fn wasm_emit_direct_gc_binary(fs: &FsWriteCap, sys: &ProcessCap, src: String, out_path: String) -> Bool {
    let bin: List[Int] = wasm_driver_compile_source(src, "wasm-gc");
    if list_len(bin) == 0 { return false;
    }
    return wasm_write_bin_file(fs, sys, out_path, bin);
}

pub fn wasm_emit_direct_dual_package(fs: &FsWriteCap, sys: &ProcessCap, src: String, out_path: String) -> Bool {
    let base: String = path_strip_ext(out_path);
    let gc_wasm_path: String = base + ".gc.wasm";
    let linear_wasm_path: String = base + ".linear.wasm";
    let js_path: String = base + ".js";
    let dts_path: String = base + ".d.ts";

    let gc_bin: List[Int] = wasm_driver_compile_source(src, "wasm-gc");
    if list_len(gc_bin) == 0 { return false;
    }
    let ok_gc: Bool = wasm_write_bin_file(fs, sys, gc_wasm_path, gc_bin);
    if !ok_gc { return false;
    }

    let lin_bin: List[Int] = wasm_driver_compile_source(src, "wasm-linear");
    if list_len(lin_bin) == 0 { return false;
    }
    let ok_lin: Bool = wasm_write_bin_file(fs, sys, linear_wasm_path, lin_bin);
    if !ok_lin { return false;
    }

    let mod_name: String = make_js_module_name(base);
    let gc_fname: String = path_file_basename(gc_wasm_path);
    let lin_fname: String = path_file_basename(linear_wasm_path);

    let js_src: String = js_glue_generate_dual_esm(mod_name, gc_fname, lin_fname);
    let ok_js: Bool = wasm_write_text_file(fs, sys, js_path, js_src);
    if !ok_js { return false;
    }

    let fns: List[String] = wasm_driver_extract_exported_fns(src);
    let dts_src: String = js_glue_generate_dts(mod_name, fns);
    let ok_dts: Bool = wasm_write_text_file(fs, sys, dts_path, dts_src);
    if !ok_dts { return false;
    }

    if out_path != gc_wasm_path && out_path != linear_wasm_path { let _w_main: Bool = wasm_write_bin_file(fs, sys, out_path, lin_bin);
    }
    return true;
}
