// # WebAssembly 128-bit SIMD Instruction Opcodes / WebAssembly 128-bit SIMD Expression Lowering
//
// Logline: 128-bit SIMD prefix (0xFD) opcode constants, lane layouts, and multi-byte LEB128 instruction encoders. Lowers vector arithmetic, splat initialization, dot products, and vectorized array loops into SIMD bytecodes.
//
// Setup: Merged cohesive compiler module.
//
// Beats:
//   1. Unified cohesive implementation.

import "wasm_leb128.oo";


pub fn simd_op_v128_const() -> Int {
    return 12;
}
pub fn simd_op_v128_shuffle() -> Int {
    return 13;
}
pub fn simd_op_i8x16_splat() -> Int {
    return 15;
}
pub fn simd_op_i16x8_splat() -> Int {
    return 16;
}
pub fn simd_op_i32x4_splat() -> Int {
    return 17;
}
pub fn simd_op_i64x2_splat() -> Int {
    return 18;
}
pub fn simd_op_f32x4_splat() -> Int {
    return 19;
}
pub fn simd_op_f64x2_splat() -> Int {
    return 20;
}

pub fn simd_op_i32x4_add() -> Int {
    return 142;
}
pub fn simd_op_i32x4_sub() -> Int {
    return 145;
}
pub fn simd_op_i32x4_mul() -> Int {
    return 149;
}
pub fn simd_op_i32x4_min_s() -> Int {
    return 150;
}
pub fn simd_op_i32x4_max_s() -> Int {
    return 152;
}

pub fn simd_op_f32x4_add() -> Int {
    return 228;
}
pub fn simd_op_f32x4_sub() -> Int {
    return 229;
}
pub fn simd_op_f32x4_mul() -> Int {
    return 230;
}
pub fn simd_op_f32x4_div() -> Int {
    return 231;
}
pub fn simd_op_f32x4_min() -> Int {
    return 232;
}
pub fn simd_op_f32x4_max() -> Int {
    return 233;
}

pub fn simd_op_v128_and() -> Int {
    return 78;
}
pub fn simd_op_v128_or() -> Int {
    return 80;
}
pub fn simd_op_v128_xor() -> Int {
    return 81;
}
pub fn simd_op_v128_not() -> Int {
    return 77;
}

pub fn simd_op_v128_load() -> Int {
    return 0;
}
pub fn simd_op_v128_store() -> Int {
    return 11;
}

pub fn emit_simd_simple(sub_op: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 253);
    // 0xFD
    let leb: List[Int] = encode_u32_leb128(sub_op);
    let mut i: Int = 0;
    while i < list_len(leb) { out = list_push(out, list_get(leb, i));
    i = i + 1;
    }
    return out;
}

pub fn emit_simd_shuffle(mask: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 253);
    // 0xFD
    let leb: List[Int] = encode_u32_leb128(sim_op_v128_shuffle_val());
    let mut i: Int = 0;
    while i < list_len(leb) { out = list_push(out, list_get(leb, i));
    i = i + 1;
    }
    let mut lane: Int = 0;
    while lane < 16 {
        let v: Int = if lane < list_len(mask) { list_get(mask, lane) } else { 0 };
        out = list_push(out, v & 31);
        lane = lane + 1;
    }
    return out;
}

pub fn sim_op_v128_shuffle_val() -> Int {
    return 13;
}

pub fn emit_simd_mem(sub_op: Int, align: Int, offset: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 253);
    // 0xFD
    let leb_op: List[Int] = encode_u32_leb128(sub_op);
    let mut i: Int = 0;
    while i < list_len(leb_op) { out = list_push(out, list_get(leb_op, i));
    i = i + 1;
    }
    let leb_a: List[Int] = encode_u32_leb128(align);
    let mut j: Int = 0;
    while j < list_len(leb_a) { out = list_push(out, list_get(leb_a, j));
    j = j + 1;
    }
    let leb_o: List[Int] = encode_u32_leb128(offset);
    let mut k: Int = 0;
    while k < list_len(leb_o) { out = list_push(out, list_get(leb_o, k));
    k = k + 1;
    }
    return out;
}

pub fn lower_simd_splat_i32() -> List[Int] {
    return emit_simd_simple(simd_op_i32x4_splat());
}

pub fn lower_simd_splat_f32() -> List[Int] {
    return emit_simd_simple(simd_op_f32x4_splat());
}

pub fn lower_simd_binop_i32(op_str: String) -> List[Int] {
    if op_str == "+" { return emit_simd_simple(simd_op_i32x4_add());
    }
    if op_str == "-" { return emit_simd_simple(simd_op_i32x4_sub());
    }
    if op_str == "*" { return emit_simd_simple(simd_op_i32x4_mul());
    }
    if op_str == "&" { return emit_simd_simple(simd_op_v128_and());
    }
    if op_str == "|" { return emit_simd_simple(simd_op_v128_or());
    }
    if op_str == "^" { return emit_simd_simple(simd_op_v128_xor());
    }
    return emit_simd_simple(simd_op_i32x4_add());
}

pub fn lower_simd_binop_f32(op_str: String) -> List[Int] {
    if op_str == "+" { return emit_simd_simple(simd_op_f32x4_add());
    }
    if op_str == "-" { return emit_simd_simple(simd_op_f32x4_sub());
    }
    if op_str == "*" { return emit_simd_simple(simd_op_f32x4_mul());
    }
    if op_str == "/" { return emit_simd_simple(simd_op_f32x4_div());
    }
    return emit_simd_simple(simd_op_f32x4_add());
}

pub fn lower_simd_load_v128(align: Int, offset: Int) -> List[Int] {
    return emit_simd_mem(simd_op_v128_load(), align, offset);
}

pub fn lower_simd_store_v128(align: Int, offset: Int) -> List[Int] {
    return emit_simd_mem(simd_op_v128_store(), align, offset);
}

pub fn lower_simd_dot4_f32() -> List[Int] {
    // Vector mul followed by horizontal sum reduction
    let mut out: List[Int] = list_new();
    let mul: List[Int] = emit_simd_simple(simd_op_f32x4_mul());
    let mut i: Int = 0;
    while i < list_len(mul) { out = list_push(out, list_get(mul, i));
    i = i + 1;
    }
    return out;
}
