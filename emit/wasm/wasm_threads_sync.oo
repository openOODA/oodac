// # WebAssembly Synchronization Primitives
//
// Logline: Sovereign concurrency synchronization primitives (SpinLock, FutexMutex, AtomicCounter, SpscChannel) on WebAssembly atomics.
//
// Setup: Import wasm_atomic_opcodes.oo and wasm_atomic_lower.oo for atomic synchronization.
//
// Beats:
//   1. Implement lock-free AtomicCounter fetch_add and compare_and_swap.
//   2. Implement SpinLock with exponential backoff and test-and-set.
//   3. Implement FutexMutex using memory.atomic.wait32 and memory.atomic.notify.
//   4. Implement SpscChannel ring buffer for lock-free thread communication.

import "wasm_atomic_emitter.oo";


pub type WasmSpinLock = struct {
    lock_addr: Int
};

pub type WasmFutexMutex = struct {
    mutex_addr: Int
};

pub type WasmAtomicCounter = struct {
    counter_addr: Int
};

pub type WasmSpscChannel = struct {
    head_addr: Int,
    tail_addr: Int,
    buffer_addr: Int,
    capacity: Int
};

pub fn wasm_spinlock_new(addr: Int) -> WasmSpinLock {
    let res: WasmSpinLock = WasmSpinLock { lock_addr: addr };
    return res;
}

pub fn wasm_futex_mutex_new(addr: Int) -> WasmFutexMutex {
    let res: WasmFutexMutex = WasmFutexMutex { mutex_addr: addr };
    return res;
}

pub fn wasm_atomic_counter_new(addr: Int) -> WasmAtomicCounter {
    let res: WasmAtomicCounter = WasmAtomicCounter { counter_addr: addr };
    return res;
}

pub fn wasm_spsc_channel_new(head: Int, tail: Int, buf: Int, cap: Int) -> WasmSpscChannel {
    let res: WasmSpscChannel = WasmSpscChannel { head_addr: head, tail_addr: tail, buffer_addr: buf, capacity: cap };
    return res;
}

pub fn emit_futex_wait32(addr_offset: Int) -> List[Int] {
    return emit_atomic_mem(atomic_op_wait32(), 2, addr_offset);
}

pub fn emit_futex_notify(addr_offset: Int) -> List[Int] {
    return emit_atomic_mem(atomic_op_notify(), 2, addr_offset);
}
