// # WebAssembly Canonical ABI Lowering & Lifting
//
// Logline: Canonical ABI type flattening rules, memory layout calculations, string encoding, and cabi_realloc hooks.
//
// Setup: Import wasm_component_types.oo and wasm_leb128.oo for Canonical ABI encoding.
//
// Beats:
//   1. Implement the 16-parameter flattening rule for component function boundaries.
//   2. Compute byte alignment and size for compound record and variant layouts.
//   3. Emit cabi_realloc memory allocation helper for string/buffer marshalling.
//   4. Emit canon lift and canon lower canonical options (memory, realloc, post-return).

import "wasm_component_types.oo";

import "wasm_leb128.oo";


pub fn cabi_max_flat_params() -> Int {
    return 16;
}
pub fn cabi_max_flat_results() -> Int {
    return 1;
}

pub fn cabi_type_size(comp_type: Int) -> Int {
    if comp_type == comp_type_bool() || comp_type == comp_type_s8() || comp_type == comp_type_u8() { return 1;
    }
    if comp_type == comp_type_s16() || comp_type == comp_type_u16() { return 2;
    }
    if comp_type == comp_type_s32() || comp_type == comp_type_u32() || comp_type == comp_type_f32() || comp_type == comp_type_char() { return 4;
    }
    if comp_type == comp_type_s64() || comp_type == comp_type_u64() || comp_type == comp_type_f64() { return 8;
    }
    if comp_type == comp_type_string() || comp_type == comp_type_list() { return 8;
    } // [ptr: i32, len: i32]
    return 4;
}

pub fn cabi_type_align(comp_type: Int) -> Int {
    return cabi_type_size(comp_type);
}

pub fn cabi_flatten_type(comp_type: Int) -> List[Int] {
    let mut flat: List[Int] = list_new();
    if comp_type == comp_type_string() || comp_type == comp_type_list() {
        flat = list_push(flat, 127);
        // i32 ptr
        flat = list_push(flat, 127);
        // i32 len
    } else if comp_type == comp_type_s64() || comp_type == comp_type_u64() {
        flat = list_push(flat, 126);
        // i64
    } else if comp_type == comp_type_f64() {
        flat = list_push(flat, 124);
        // f64
    } else if comp_type == comp_type_f32() {
        flat = list_push(flat, 125);
        // f32
    } else {
        flat = list_push(flat, 127);
        // i32
    }
    return flat;
}

pub fn cabi_flatten_params(param_types: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = list_len(param_types);
    let mut i: Int = 0;
    while i < n { let ft: List[Int] = cabi_flatten_type(list_get(param_types, i));
    let mut j: Int = 0;
    while j < list_len(ft) { out = list_push(out, list_get(ft, j));
    j = j + 1;
    }
        i = i + 1;
    }
    if list_len(out) > cabi_max_flat_params() {
        // Flattening rule overflow: pass single pointer to linear memory tuple
        let mut ptr_only: List[Int] = list_new();
        ptr_only = list_push(ptr_only, 127);
        // i32 arg_ptr
        return ptr_only;
    }
    return out;
}

pub fn emit_cabi_canon_lift(core_func_idx: Int, type_idx: Int, mem_idx: Int, realloc_idx: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 0);
    // 0x00 = canon lift
    let leb_f: List[Int] = encode_u32_leb128(core_func_idx);
    let mut i: Int = 0;
    while i < list_len(leb_f) { out = list_push(out, list_get(leb_f, i));
    i = i + 1;
    }
    let leb_t: List[Int] = encode_u32_leb128(type_idx);
    let mut j: Int = 0;
    while j < list_len(leb_t) { out = list_push(out, list_get(leb_t, j));
    j = j + 1;
    }
    // Canonical options
    out = list_push(out, 2);
    // 2 options: memory + realloc
    out = list_push(out, 0);
    // memory option
    let leb_m: List[Int] = encode_u32_leb128(mem_idx);
    let mut k: Int = 0;
    while k < list_len(leb_m) { out = list_push(out, list_get(leb_m, k));
    k = k + 1;
    }
    out = list_push(out, 1);
    // realloc option
    let leb_r: List[Int] = encode_u32_leb128(realloc_idx);
    let mut l: Int = 0;
    while l < list_len(leb_r) { out = list_push(out, list_get(leb_r, l));
    l = l + 1;
    }
    return out;
}
