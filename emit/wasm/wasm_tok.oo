// # WASM token row walkers
//
// Logline: Kind and text reads plus brace, type, and fn skips for WASM lowering.
//
// Setup: Rows are TSV from tokenize_lines. field_at decodes text escapes.
//
// Beats:
//   1. ws_k and ws_t read kind and text with a bounds guard.
//   2. ws_skip_balanced walks brace pairs for fn and block skips.
//   3. ws_skip_type and ws_read_ty walk one annotated type per scan.

import "lex/token_fmt.oo";
import "lex/token_parse_int.oo";

pub fn ws_k(toks: List[String], i: Int) -> String {
    if i < 0 || i >= list_len(toks) { return ""; }
    return field_at(list_get(toks, i), 0);
}

pub fn ws_t(toks: List[String], i: Int) -> String {
    if i < 0 || i >= list_len(toks) { return ""; }
    return field_at(list_get(toks, i), 3);
}

pub fn ws_skip_balanced(toks: List[String], pos0: Int) -> Int {
    let n: Int = list_len(toks);
    let mut pos: Int = pos0 + 1;
    let mut depth: Int = 1;
    while pos < n {
        if depth == 0 { return pos; }
        let k: String = ws_k(toks, pos);
        if k == "LBRACE" { depth = depth + 1; }
        if k == "RBRACE" { depth = depth - 1; }
        pos = pos + 1;
    }
    return pos;
}

pub fn ws_skip_type(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    if p < n && ws_k(toks, p) == "AMP" { p = p + 1; }
    if p < n && ws_k(toks, p) == "KW_MUT" { p = p + 1; }
    if p >= n || ws_k(toks, p) != "IDENT" { return p; }
    p = p + 1;
    if p < n && ws_k(toks, p) == "LBRACKET" {
        let mut d: Int = 1;
        p = p + 1;
        while p < n && d > 0 {
            let k: String = ws_k(toks, p);
            if k == "LBRACKET" || k == "LPAREN" || k == "LBRACE" { d = d + 1; }
            if k == "RBRACKET" || k == "RPAREN" || k == "RBRACE" { d = d - 1; }
            p = p + 1;
        }
    }
    return p;
}

pub fn ws_skip_fn(toks: List[String], pos: Int, n: Int) -> Int {
    let mut p: Int = pos;
    while p < n && ws_k(toks, p) == "KW_PUB" { p = p + 1; }
    if p >= n || ws_k(toks, p) != "KW_FN" { return p + 1; }
    while p < n && ws_k(toks, p) != "LBRACE" {
        if ws_k(toks, p) == "SEMI" { return p + 1; }
        p = p + 1;
    }
    if p < n && ws_k(toks, p) == "LBRACE" { return ws_skip_balanced(toks, p); }
    return p;
}

pub fn ws_fn_name_at(toks: List[String], pos: Int, n: Int) -> String {
    let mut p: Int = pos;
    while p < n && ws_k(toks, p) == "KW_PUB" { p = p + 1; }
    if p < n && ws_k(toks, p) == "KW_FN" { p = p + 1; }
    if p < n && ws_k(toks, p) == "IDENT" { return ws_t(toks, p); }
    return "";
}

pub fn ws_read_ty(toks: List[String], pos: Int, n: Int) -> String {
    let mut p: Int = pos;
    if p < n && ws_k(toks, p) == "AMP" { p = p + 1; }
    if p < n && ws_k(toks, p) == "KW_MUT" { p = p + 1; }
    if p >= n || ws_k(toks, p) != "IDENT" { return ws_skip_type(toks, pos, n).to_string() + "\ti"; }
    let base: String = ws_t(toks, p);
    p = p + 1;
    let mut args: String = "";
    if p < n && ws_k(toks, p) == "LBRACKET" {
        p = p + 1;
        let mut first: Bool = true;
        while p < n && ws_k(toks, p) != "RBRACKET" {
            if ws_k(toks, p) == "COMMA" {
                args = args + ",";
                p = p + 1;
            } else {
                let inner: String = ws_read_ty(toks, p, n);
                if first { first = false; }
                args = args + ws_un_ty(inner);
                p = ws_un_pos(inner);
            }
        }
        if p < n && ws_k(toks, p) == "RBRACKET" { p = p + 1; }
    }
    if base == "Int" || base == "Bool" { return p.to_string() + "\ti"; }
    if base == "String" { return p.to_string() + "\ts"; }
    if base == "Void" { return p.to_string() + "\tv"; }
    if base == "List" { return p.to_string() + "\tl[" + args + "]"; }
    if base == "Result" || base == "Option" { return p.to_string() + "\tr[" + args + "]"; }
    return p.to_string() + "\tt:" + base;
}

pub fn ws_elem(code: String) -> String {
    let o: Int = str_index_of(code, "[");
    let c: Int = str_index_of(code, "]");
    if o < 0 || c < 0 || c <= o + 1 { return "?"; }
    return str_slice(code, o + 1, c);
}

pub fn ws_res_ok(code: String) -> String {
    let o: Int = str_index_of(code, "[");
    let c: Int = str_index_of(code, ",");
    if o < 0 || c < 0 { return "?"; }
    return str_slice(code, o + 1, c);
}

pub fn ws_res_err(code: String) -> String {
    let c: Int = str_index_of(code, ",");
    let e: Int = str_index_of(code, "]");
    if c < 0 || e < 0 { return "?"; }
    return str_slice(code, c + 1, e);
}

pub fn ws_un_pos(pack: String) -> Int {
    let t: Int = str_index_of(pack, "\t");
    return parse_int(str_slice(pack, 0, t));
}

pub fn ws_un_ty(pack: String) -> String {
    let t: Int = str_index_of(pack, "\t");
    return str_slice(pack, t + 1, chars_len(pack));
}

pub fn ws_fail(line: Int, msg: String) {
    println("ERR\twasm\t" + msg + " at line " + line.to_string());
    process_exit(1);
}

pub fn ws_line(toks: List[String], i: Int) -> Int {
    if i < 0 || i >= list_len(toks) { return 1; }
    let v: Int = parse_int(field_at(list_get(toks, i), 1));
    return if v < 1 { 1 } else { v };
}
