// # WebAssembly Expression Lowering Engine
//
// Logline: Lower openOODA AST expressions to WebAssembly stack opcodes.
//
// Setup: Import wasm_leb128.oo, wasm_opcodes.oo, wasm_types.oo, ast.oo before use.
//
// Beats:
//   1. Map variable names and types to local indices.
//   2. Emit typed integer, float, boolean, and string literals.
//   3. Lower arithmetic, bitwise, logic, comparison, and unary operations.

import "wasm_leb128.oo";

import "wasm_opcodes.oo";

import "wasm_types.oo";

import "wasm_mem_layout.oo";


import "wasm_lower_ops.oo";
import "wasm_lower_string.oo";
import "wasm_lower_struct.oo";
import "wasm_lower_list.oo";
import "wasm_lower_adt.oo";
pub fn wasm_ast_args(node: String) -> String {
    let n: Int = bytes_len(node); let mut depth: Int = 0; let mut start: Int = 0; let mut i: Int = 0; let mut hit: Bool = false;
    while i < n {
        let c: Int = byte_at(node, i);
        if c == 40 { if depth == 0 { start = i + 1; hit = true; } depth = depth + 1; }
        if c == 41 { depth = depth - 1; if depth == 0 && hit { return byte_slice(node, start, i); } }
        i = i + 1;
    }
    return "";
}
pub fn wasm_ast_last_is_expr(node: String) -> Bool {
    if node == "" || ast_is(node, "SEmpty") { return false; }
    let tag: String = ast_tag(node);
    if tag == "SExpr" { return wasm_ast_last_is_expr(list_get_str(wasm_ast_args(node), 0)); }
    if tag == "AstBlock" {
        let args: String = wasm_ast_args(node); let n: Int = (0 + list_len_str(args)); let mut i: Int = n - 1;
        while i >= 0 {
            let item: String = list_get_str(args, i);
            if item != "" && !ast_is(item, "SEmpty") { return wasm_ast_last_is_expr(item); }
            i = i - 1;
        }
        return false;
    }
    if tag == "EIf" {
        let args: String = wasm_ast_args(node); let n_if: Int = (0 + list_len_str(args));
        let then_e: String = if n_if >= 2 { list_get_str(args, 1) } else { "" };
        let else_e: String = if n_if >= 3 { list_get_str(args, 2) } else { "" };
        let has_else: Bool = (else_e != "" && !ast_is(else_e, "SEmpty") && !ast_is(else_e, "EEmpty") && else_e != "EEmpty" && else_e != "SEmpty");
        return has_else && wasm_ast_last_is_expr(then_e) && wasm_ast_last_is_expr(else_e);
    }
    if tag == "EMatch" {
        let args: String = wasm_ast_args(node);
        if (0 + list_len_str(args)) < 2 { return false; }
        return wasm_ast_last_is_expr(list_get_str(wasm_ast_args(list_get_str(args, 1)), 1));
    }
    if tag == "EBinop" || tag == "EUnop" || tag == "ELitInt" || tag == "ELitFloat" || tag == "ELitBool" || tag == "EVar" || tag == "ECall" || tag == "EMethod" || tag == "ELitStr" || tag == "EString" || tag == "EStr" || tag == "ELitString" || tag == "ELit" || tag == "EStructLit" || tag == "EField" || tag == "EIndex" {
        if tag == "ECall" {
            let args: String = wasm_ast_args(node); let callee: String = list_get_str(args, 0);
            let fn_name: String = if ast_is(callee, "EVar") { list_get_str(wasm_ast_args(callee), 0) } else { callee };
            if fn_name == "println" || fn_name == "print" || fn_name == "eprintln" { return false; }
        }
        return true;
    }
    return false;
}
pub fn wasm_env_alloc(env: &mut WasmEnv, sz: Int) -> Int {
    let loc_types: List[Int] = env.local_types; let n_locs: Int = list_len(loc_types); let s_n: String = n_locs.to_string(); let vname: String = "__ha_" + s_n; let slot: Int = (0 + wasm_env_bind_var(env, vname, wasm_val_type_i32())); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, wasm_zone_heap_ptr_addr()); wasm_env_emit(env, op_i32_load()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, slot); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, slot); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1024); wasm_env_emit(env, op_i32_lt_u()); wasm_env_emit(env, op_if()); wasm_env_emit_byte(env, wasm_block_type_empty()); env.current_block_depth = env.current_block_depth + 1; wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1024); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, slot); wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1; wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, wasm_zone_heap_ptr_addr()); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, slot); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, sz); wasm_env_emit(env, op_i32_add()); wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0); return slot;
}
pub fn wasm_lower_expr(env: &mut WasmEnv, expr: String) -> Int {
    let tag: String = ast_tag(expr); let args: String = wasm_ast_args(expr);
    if tag == "ELit" {
        let lit_val: String = list_get_str(args, 0);
        if str_starts_with(lit_val, "int:") {
            let v: Int = (0 + wasm_parse_int(str_slice(lit_val, 4, chars_len(lit_val))));
            if env.default_int_type == wasm_val_type_i64() { wasm_env_emit(env, op_i64_const()); wasm_env_emit_i64(env, v); return wasm_val_type_i64(); }
            wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, v); return wasm_val_type_i32();
        }
        if str_starts_with(lit_val, "str:") {
            let str_val: String = str_slice(lit_val, 4, chars_len(lit_val)); let slen: Int = chars_len(str_val);
            let ps: Int = (0 + wasm_env_alloc(env, 16 + slen));
            wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0);
            wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 4);
            wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, slen); wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 8);
            let mut k: Int = 0; while k < slen { wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, byte_at(str_val, k)); wasm_env_emit(env, op_i32_store8()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 12 + k); k = k + 1; }
            wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_i32_store8()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 12 + slen);
            wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); return wasm_val_type_i32();
        }
        if str_starts_with(lit_val, "bool:") { wasm_env_emit(env, op_i32_const()); let mut b_val: Int = 0; if str_slice(lit_val, 5, chars_len(lit_val)) == "true" { b_val = 1; } wasm_env_emit_i32(env, b_val); return wasm_val_type_i32(); }
        if str_starts_with(lit_val, "float:") { wasm_env_emit(env, op_f64_const()); wasm_env_emit_bytes(env, wasm_encode_f64_lit(str_slice(lit_val, 6, chars_len(lit_val)))); return wasm_val_type_f64(); }
    }
    if tag == "ELitInt" {
        let v: Int = (0 + wasm_parse_int(list_get_str(args, 0)));
        if env.default_int_type == wasm_val_type_i64() { wasm_env_emit(env, op_i64_const()); wasm_env_emit_i64(env, v); return wasm_val_type_i64(); }
        wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, v); return wasm_val_type_i32();
    }
    if tag == "ELitStr" || tag == "EString" || tag == "EStr" || tag == "ELitString" {
        let str_val: String = list_get_str(args, 0); let slen: Int = chars_len(str_val);
        let ps: Int = (0 + wasm_env_alloc(env, 16 + slen));
        wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0);
        wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 4);
        wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, slen); wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 8);
        let mut k: Int = 0; while k < slen { wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, byte_at(str_val, k)); wasm_env_emit(env, op_i32_store8()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 12 + k); k = k + 1; }
        wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_i32_store8()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 12 + slen);
        wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); return wasm_val_type_i32();
    }
    if tag == "ELitFloat" { wasm_env_emit(env, op_f64_const()); wasm_env_emit_bytes(env, wasm_encode_f64_lit(list_get_str(args, 0))); return wasm_val_type_f64(); }
    if tag == "ELitBool" { wasm_env_emit(env, op_i32_const()); let mut b_val2: Int = 0; if list_get_str(args, 0) == "true" { b_val2 = 1; } wasm_env_emit_i32(env, b_val2); return wasm_val_type_i32(); }
    if tag == "EVar" {
        let vname: String = list_get_str(args, 0);
        let var_idx: Int = (0 + wasm_env_lookup_var(env, vname));
        let ty: Int = (0 + wasm_env_lookup_type(env, vname));
        if var_idx >= 0 { wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, var_idx); return ty; }
        if vname == "None" {
            let ps: Int = (0 + wasm_env_alloc(env, 16));
            wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0);
            wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 4);
            wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, ps); return wasm_val_type_i32();
        }
        wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); return ty;
    }
    if tag == "EBinop" { return wasm_lower_binop(env, list_get_str(args, 0), list_get_str(args, 1), list_get_str(args, 2)); }
    if tag == "EUnop" { return wasm_lower_unop(env, list_get_str(args, 0), list_get_str(args, 1)); }
    if tag == "EIf" {
        let n_if_args: Int = (0 + list_len_str(args)); let cond: String = list_get_str(args, 0);
        let then_e: String = if n_if_args >= 2 { list_get_str(args, 1) } else { "" };
        let else_e: String = if n_if_args >= 3 { list_get_str(args, 2) } else { "" };
        let has_else: Bool = (else_e != "" && !ast_is(else_e, "SEmpty") && !ast_is(else_e, "EEmpty") && else_e != "EEmpty" && else_e != "SEmpty");
        let is_val: Bool = has_else && wasm_ast_last_is_expr(then_e) && wasm_ast_last_is_expr(else_e);
        let eff_res_ty: Int = if is_val { env.default_int_type } else { wasm_block_type_empty() };
        let _c: Int = (0 + wasm_lower_expr(env, cond)); wasm_env_emit(env, op_if()); wasm_env_emit_byte(env, eff_res_ty);
        env.current_block_depth = env.current_block_depth + 1;
        let _th: Int = (0 + wasm_lower_expr(env, then_e));
        if !is_val && wasm_ast_last_is_expr(then_e) { wasm_env_emit(env, op_drop()); }
        if has_else {
            wasm_env_emit(env, op_else());
            let _el: Int = (0 + wasm_lower_expr(env, else_e));
            if !is_val && wasm_ast_last_is_expr(else_e) { wasm_env_emit(env, op_drop()); }
        }
        wasm_env_emit(env, op_end()); env.current_block_depth = env.current_block_depth - 1; return eff_res_ty;
    }
    if tag == "EStructLit" { return (0 + wasm_lower_struct_expr(env, expr)); }
    if tag == "EField" {
        let recv: String = list_get_str(args, 0); let fname: String = list_get_str(args, 1);
        let offset: Int = (0 + wasm_env_field_offset(env, fname)); let fty: Int = (0 + wasm_env_field_type(env, fname));
        return (0 + wasm_lower_field_get(env, recv, offset, fty));
    }
    if tag == "EIndex" {
        let base: String = list_get_str(args, 0); let index_expr: String = list_get_str(args, 1);
        return (0 + wasm_lower_list_get(env, base, index_expr, wasm_val_type_i32()));
    }
    if tag == "EMatch" { return (0 + wasm_lower_match(env, expr, env.default_int_type)); }
    if tag == "SExpr" { return (0 + wasm_lower_expr(env, list_get_str(args, 0))); }
    if tag == "AstBlock" {
        let n_stmts: Int = (0 + list_len_str(args)); let mut last_idx: Int = -1; let mut j: Int = n_stmts - 1;
        while j >= 0 { let it: String = list_get_str(args, j); if it != "" && !ast_is(it, "SEmpty") && it != "SEmpty" { last_idx = j; j = -1; } else { j = j - 1; } }
        if last_idx < 0 { return env.default_int_type; }
        let mut last_ty: Int = env.default_int_type; let mut i: Int = 0;
        while i <= last_idx {
            let item: String = list_get_str(args, i);
            if item != "" && !ast_is(item, "SEmpty") && item != "SEmpty" { if i == last_idx { last_ty = (0 + wasm_lower_expr(env, item)); } else { wasm_lower_stmt(env, item); } }
            i = i + 1;
        }
        return last_ty;
    }
    if tag == "EMethod" {
        let recv_node: String = list_get_str(args, 0); let m_name: String = list_get_str(args, 1);
        if m_name == "is_ok" || m_name == "is_some" {
            let _r: Int = (0 + wasm_lower_expr(env, recv_node)); wasm_env_emit(env, op_i32_load()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0); wasm_env_emit(env, op_i32_eqz()); return wasm_val_type_i32();
        }
        if m_name == "is_err" || m_name == "is_none" {
            let _r: Int = (0 + wasm_lower_expr(env, recv_node)); wasm_env_emit(env, op_i32_load()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_i32_ne()); return wasm_val_type_i32();
        }
        if m_name == "unwrap" {
            let _r: Int = (0 + wasm_lower_expr(env, recv_node)); wasm_env_emit(env, op_i32_load()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 4); return wasm_val_type_i32();
        }
        if m_name == "to_string" { return (0 + wasm_lower_to_string(env, recv_node)); }
    }
    if tag == "ECall" {
        let callee: String = list_get_str(args, 0);
        let fn_name: String = if ast_is(callee, "EVar") { list_get_str(wasm_ast_args(callee), 0) } else { callee };
        if fn_name == ".to_string" || fn_name == "to_string" { return (0 + wasm_lower_to_string(env, list_get_str(args, 1))); }
        if fn_name == ".is_ok" || fn_name == "is_ok" || fn_name == ".is_some" || fn_name == "is_some" { let _r: Int = (0 + wasm_lower_expr(env, list_get_str(args, 1))); wasm_env_emit(env, op_i32_load()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0); wasm_env_emit(env, op_i32_eqz()); return wasm_val_type_i32(); }
        if fn_name == ".is_err" || fn_name == "is_err" || fn_name == ".is_none" || fn_name == "is_none" { let _r: Int = (0 + wasm_lower_expr(env, list_get_str(args, 1))); wasm_env_emit(env, op_i32_load()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_i32_ne()); return wasm_val_type_i32(); }
        if fn_name == ".unwrap" || fn_name == "unwrap" { let _r: Int = (0 + wasm_lower_expr(env, list_get_str(args, 1))); wasm_env_emit(env, op_i32_load()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 4); return wasm_val_type_i32(); }
        if fn_name == "list_new" { return (0 + wasm_lower_list_new(env)); }
        if fn_name == "list_len" { return (0 + wasm_lower_list_len(env, list_get_str(args, 1))); }
        if fn_name == "list_get" || fn_name == "list_get_str" { return (0 + wasm_lower_list_get(env, list_get_str(args, 1), list_get_str(args, 2), wasm_val_type_i32())); }
        if fn_name == "list_push" { return (0 + wasm_lower_list_push(env, list_get_str(args, 1), list_get_str(args, 2), wasm_val_type_i32())); }
        if fn_name == "list_set" { return (0 + wasm_lower_list_set(env, list_get_str(args, 1), list_get_str(args, 2), list_get_str(args, 3), wasm_val_type_i32())); }
        if fn_name == "println" || fn_name == "print" || fn_name == "eprintln" {
            let str_arg: String = if list_len_str(args) >= 2 { list_get_str(args, 1) } else { "" };
            let p_slot: Int = (0 + wasm_env_bind_var(env, "__pr_p", wasm_val_type_i32()));
            let _s: Int = (0 + wasm_lower_expr(env, str_arg)); wasm_env_emit(env, op_local_set()); wasm_env_emit_u32(env, p_slot);
            wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, p_slot); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 12); wasm_env_emit(env, op_i32_add()); wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0);
            wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 4); wasm_env_emit(env, op_local_get()); wasm_env_emit_u32(env, p_slot); wasm_env_emit(env, op_i32_load()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 8); wasm_env_emit(env, op_i32_store()); wasm_env_emit_u32(env, 2); wasm_env_emit_u32(env, 0);
            let fd_val: Int = if fn_name == "eprintln" { 2 } else { 1 };
            let w_idx: Int = (0 + wasm_env_lookup_func(env, "fd_write")); let f_idx: Int = if w_idx >= 0 { w_idx } else { 0 };
            wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, fd_val); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 0); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 1); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 16);
            wasm_env_emit(env, op_call()); wasm_env_emit_u32(env, f_idx); wasm_env_emit(env, op_drop());
            if fn_name == "println" || fn_name == "eprintln" {
                wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 24); wasm_env_emit(env, op_i32_const()); wasm_env_emit_i32(env, 10); wasm_env_emit(env, op_i32_store8()); wasm_env_emit_u32(env, 0); wasm_env_emit_u32(env, 0);
