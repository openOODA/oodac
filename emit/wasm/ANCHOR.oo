// ──▓▓ Public WebAssembly Emitter API ──▓▓──

pub fn emit_wasm_driver(src: String, target_mode: String) -> List[Int] {
    return wasm_driver_compile_source(src, target_mode);
}

pub fn emit_wasm_module(ast_str: String, target_mode: String) -> List[Int] {
    return wasm_compile_ast_to_binary(ast_str, target_mode);
}
