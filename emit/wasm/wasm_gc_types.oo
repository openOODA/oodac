// # WebAssembly GC Type System & Descriptors
//
// Logline: Wasm-GC recursive type group section (0xFB) encoding for structs, arrays, subtyping, and storage types.
//
// Setup: Import wasm_leb128.oo for type vector count prefixes and type indices.
//
// Beats:
//   1. Define Wasm-GC storage types (i8, i16, i32, i64, f32, f64, ref, ref null).
//   2. Encode struct type field lists with mutability descriptors (0x5E).
//   3. Encode array element types with mutability descriptors (0x5D).
//   4. Package recursive type groups with sub and sub_final prefixes (0x4E, 0x4F, 0x5F).

import "wasm_leb128.oo";

pub fn wasm_gc_type_struct() -> Int { return 94; } // 0x5E
pub fn wasm_gc_type_array() -> Int { return 93; } // 0x5D
pub fn wasm_gc_type_sub() -> Int { return 78; } // 0x4E
pub fn wasm_gc_type_sub_final() -> Int { return 79; } // 0x4F
pub fn wasm_gc_type_rec() -> Int { return 95; } // 0x5F

type WasmGcStructDef = struct {
    type_index: Int,
    super_type_index: Int,
    is_final: Int,
    field_storage_types: List[Int],
    field_mutabilities: List[Int],
    field_count: Int
};

type WasmGcArrayDef = struct {
    type_index: Int,
    element_type: Int,
    is_mutable: Int,
    is_final: Int
};

pub fn wasm_gc_storage_i8() -> Int { return 120; }
pub fn wasm_gc_storage_i16() -> Int { return 119; }
pub fn wasm_gc_storage_i32() -> Int { return 127; }
pub fn wasm_gc_storage_i64() -> Int { return 126; }
pub fn wasm_gc_storage_f32() -> Int { return 125; }
pub fn wasm_gc_storage_f64() -> Int { return 124; }
pub fn wasm_gc_ref_exact() -> Int { return 107; }
pub fn wasm_gc_ref_array() -> Int { return 106; }
pub fn wasm_gc_ref_eq() -> Int { return 109; }
pub fn wasm_gc_ref_i31() -> Int { return 108; }
pub fn canvas_gc_ref_any() -> Int { return 110; }
pub fn wasm_gc_ref_null() -> Int { return 100; }

pub fn wasm_gc_struct_def_new(type_idx: Int, super_idx: Int, is_fin: Int) -> WasmGcStructDef {
    return WasmGcStructDef { type_index: type_idx, super_type_index: super_idx, is_final: is_fin, field_storage_types: list_new(), field_mutabilities: list_new(), field_count: 0 };
}

pub fn wasm_gc_struct_add_field(mut def: WasmGcStructDef, st: Int, is_mut: Int) -> WasmGcStructDef {
    let mut def: WasmGcStructDef = def;
    let mut sts: List[Int] = def.field_storage_types;
    sts = list_push(sts, st);
    def.field_storage_types = sts;
    let mut muts: List[Int] = def.field_mutabilities;
    muts = list_push(muts, is_mut);
    def.field_mutabilities = muts;
    def.field_count = def.field_count + 1;
    return def;
}

pub fn encode_wasm_gc_struct(def: WasmGcStructDef) -> List[Int] {
    let mut out: List[Int] = list_new();
    let super_idx: Int = def.super_type_index;
    let is_fin: Int = def.is_final;
    let fc: Int = def.field_count;
    let f_tys: List[Int] = def.field_storage_types;
    let f_muts: List[Int] = def.field_mutabilities;
    if super_idx >= 0 {
        if is_fin == 1 { out = list_push(out, wasm_gc_type_sub_final()); }
        else { out = list_push(out, wasm_gc_type_sub()); }
        out = list_push(out, 1); // 1 supertype
        let s_leb: List[Int] = encode_u32_leb128(super_idx);
        let mut s: Int = 0;
        while s < list_len(s_leb) { out = list_push(out, list_get(s_leb, s)); s = s + 1; }
    }
    out = list_push(out, wasm_gc_type_struct());
    let f_leb: List[Int] = encode_u32_leb128(fc);
    let mut i: Int = 0;
    while i < list_len(f_leb) { out = list_push(out, list_get(f_leb, i)); i = i + 1; }
    i = 0;
    while i < fc {
        out = list_push(out, list_get(f_tys, i));
        if list_get(f_muts, i) == 1 { out = list_push(out, 1); }
        else { out = list_push(out, 0); }
        i = i + 1;
    }
    return out;
}

pub fn encode_wasm_gc_array(def: WasmGcArrayDef) -> List[Int] {
    let mut out: List[Int] = list_new();
    let is_fin: Int = def.is_final;
    let elem_ty: Int = def.element_type;
    let is_mut: Int = def.is_mutable;
    if is_fin == 1 {
        out = list_push(out, wasm_gc_type_sub_final());
        out = list_push(out, 0); // 0 supertypes
    }
    out = list_push(out, wasm_gc_type_array());
    out = list_push(out, elem_ty);
    if is_mut == 1 { out = list_push(out, 1); }
    else { out = list_push(out, 0); }
    return out;
}
