pub fn emit_gc_array_len() -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 251);
    // 0xFB
    out = list_push(out, 15);
    // array.len
    return out;
}

pub fn emit_gc_array_fill(type_idx: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 251);
    // 0xFB
    out = list_push(out, 16);
    // array.fill
    let leb: List[Int] = encode_u32_leb128(type_idx);
    let mut i: Int = 0;
    while i < list_len(leb) { out = list_push(out, list_get(leb, i));
    i = i + 1;
    }
    return out;
}

pub fn emit_gc_array_copy(dst_type: Int, src_type: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 251);
    // 0xFB
    out = list_push(out, 17);
    // array.copy
    let leb_d: List[Int] = encode_u32_leb128(dst_type);
    let mut i: Int = 0;
    while i < list_len(leb_d) { out = list_push(out, list_get(leb_d, i));
    i = i + 1;
    }
    let leb_s: List[Int] = encode_u32_leb128(src_type);
    let mut j: Int = 0;
    while j < list_len(leb_s) { out = list_push(out, list_get(leb_s, j));
    j = j + 1;
    }
    return out;
}
