// # WASM module section assembly
//
// Logline: Stitch header, types, imports, and payload sections into bytes.
//
// Setup: Helper funcs are indices 2 to 8. User fns follow. _start is last.
//
// Beats:
//   1. Fixed types cover arities 0 to 2; the rest ride a dynamic list.
//   2. Type, import, func, memory, global, export, code, data in order.
//   3. Code wraps each body with size plus locals; data packs literals.

import "lex/token_fmt.oo";
import "wasm_buf.oo";
import "wasm_op.oo";
import "wasm_tok.oo";
import "lex/token_parse_int.oo";

pub fn ws_magic(b: &mut WasmBuf) {
    ws_u8(b, 0);
    ws_u8(b, 97);
    ws_u8(b, 115);
    ws_u8(b, 109);
    ws_u8(b, 1);
    ws_u8(b, 0);
    ws_u8(b, 0);
    ws_u8(b, 0);
}

pub fn ws_is_fixed(arity: Int, ret: String) -> Bool {
    if arity == 0 {
        return true;
    }
    if arity == 1 {
        return true;
    }
    if arity == 2 && ret == "i" {
        return true;
    }
    return false;
}

pub fn ws_type_idx(arity: Int, ret: String, dyn: String) -> Int {
    if arity == 0 && ret == "v" {
        return 1;
    }
    if arity == 0 {
        return 5;
    }
    if arity == 1 && ret == "v" {
        return 3;
    }
    if arity == 1 {
        return 2;
    }
    if arity == 2 && ret == "i" {
        return 4;
    }
    let key: String = arity.to_string() + "\t" + ret + "\n";
    let at: Int = str_index_of(dyn, key);
    if at < 0 {
        return 1;
    }
    let mut idx: Int = 0;
    let mut pos: Int = 0;
    while pos < at {
        if str_slice(dyn, pos, pos + 1) == "\n" {
            idx = idx + 1;
        }
        pos = pos + 1;
    }
    return 6 + idx;
}

pub fn ws_dyn_types(fns: String) -> String {
    let mut out: String = "";
    let mut rest: String = fns;
    while rest != "" {
        let at: Int = str_index_of(rest, "\n");
        let row: String = if at < 0 { rest } else { str_slice(rest, 0, at) };
        let arity: Int = parse_int(field_at(row, 1));
        let ret: String = field_at(row, 2);
        if !ws_is_fixed(arity, ret) {
            let key: String = arity.to_string() + "\t" + ret + "\n";
            if str_index_of(out, key) < 0 {
                out = out + key;
            }
        }
        if at < 0 {
            rest = "";
        } else {
            rest = str_slice(rest, at + 1, chars_len(rest));
        }
    }
    return out;
}

pub fn ws_type_entry(b: &mut WasmBuf, arity: Int, ret: String) {
    ws_u8(b, 96);
    ws_uleb(b, arity);
    let mut i: Int = 0;
    while i < arity {
        ws_u8(b, 127);
        i = i + 1;
    }
    if ret == "v" {
        ws_uleb(b, 0);
    } else {
        ws_uleb(b, 1);
        ws_u8(b, 127);
    }
}

pub fn ws_type_sec(m: &mut WasmBuf, dyn: String) {
    let mut pay: WasmBuf = ws_buf_new();
    ws_uleb(pay, 6 + ws_dyn_count(dyn));
    ws_type_entry(pay, 4, "i");
    ws_type_entry(pay, 0, "v");
    ws_type_entry(pay, 1, "i");
    ws_type_entry(pay, 1, "v");
    ws_type_entry(pay, 2, "i");
    ws_type_entry(pay, 0, "i");
    let mut rest: String = dyn;
    while rest != "" {
        let at: Int = str_index_of(rest, "\n");
        let row: String = if at < 0 { rest } else { str_slice(rest, 0, at) };
        ws_type_entry(pay, parse_int(field_at(row, 0)), field_at(row, 1));
        if at < 0 {
            rest = "";
        } else {
            rest = str_slice(rest, at + 1, chars_len(rest));
        }
    }
    ws_section(m, 1, pay.bytes);
}

pub fn ws_dyn_count(dyn: String) -> Int {
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < chars_len(dyn) {
        if str_slice(dyn, i, i + 1) == "\n" {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

pub fn ws_wrap(pay: &mut WasmBuf, nloc: Int, code: List[Int]) {
    let mut tmp: WasmBuf = ws_buf_new();
    if nloc > 0 {
        ws_uleb(tmp, 1);
        ws_uleb(tmp, nloc);
        ws_u8(tmp, 127);
    } else {
        ws_uleb(tmp, 0);
    }
    ws_raw(tmp, code);
    ws_uleb(pay, list_len(tmp.bytes));
    ws_raw(pay, tmp.bytes);
}

pub fn ws_import_sec(m: &mut WasmBuf) {
    let mut pay: WasmBuf = ws_buf_new();
    ws_uleb(pay, 2);
    ws_name(pay, "wasi_snapshot_preview1");
    ws_name(pay, "fd_write");
    ws_u8(pay, 0);
    ws_uleb(pay, 0);
    ws_name(pay, "wasi_snapshot_preview1");
    ws_name(pay, "proc_exit");
    ws_u8(pay, 0);
    ws_uleb(pay, 3);
    ws_section(m, 2, pay.bytes);
}

pub fn ws_func_sec(m: &mut WasmBuf, fns: String, dyn: String) {
    let mut pay: WasmBuf = ws_buf_new();
    ws_uleb(pay, 7 + ws_dyn_count(fns) + 1);
    ws_uleb(pay, 2);
    ws_uleb(pay, 3);
    ws_uleb(pay, 3);
    ws_uleb(pay, 4);
    ws_uleb(pay, 4);
    ws_uleb(pay, 5);
    ws_uleb(pay, 4);
    let mut rest: String = fns;
    while rest != "" {
        let at: Int = str_index_of(rest, "\n");
        let row: String = if at < 0 { rest } else { str_slice(rest, 0, at) };
        ws_uleb(pay, ws_type_idx(parse_int(field_at(row, 1)), field_at(row, 2), dyn));
        if at < 0 {
            rest = "";
        } else {
            rest = str_slice(rest, at + 1, chars_len(rest));
        }
    }
    ws_uleb(pay, 1);
    ws_section(m, 3, pay.bytes);
}

pub fn ws_mem_sec(m: &mut WasmBuf) {
    let mut pay: WasmBuf = ws_buf_new();
    ws_uleb(pay, 1);
    ws_u8(pay, 0);
    ws_uleb(pay, 1);
    ws_section(m, 5, pay.bytes);
}

pub fn ws_global_sec(m: &mut WasmBuf, heap: Int) {
    let mut pay: WasmBuf = ws_buf_new();
    ws_uleb(pay, 1);
    ws_u8(pay, 127);
    ws_u8(pay, 1);
    ws_const(pay, heap);
    ws_end(pay);
    ws_section(m, 6, pay.bytes);
}

pub fn ws_export_sec(m: &mut WasmBuf, start: Int) {
    let mut pay: WasmBuf = ws_buf_new();
    ws_uleb(pay, 2);
    ws_name(pay, "memory");
    ws_u8(pay, 2);
    ws_uleb(pay, 0);
    ws_name(pay, "_start");
    ws_u8(pay, 0);
    ws_uleb(pay, start);
    ws_section(m, 7, pay.bytes);
}
