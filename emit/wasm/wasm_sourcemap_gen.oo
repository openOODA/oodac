// # WebAssembly JSON Source Maps v3 Generator
//
// Logline: Formats JSON Source Maps v3 schemas with delta VLQ mappings, sources lists, and inline source contents.
//
// Setup: Import wasm_sourcemap_vlq.oo for segment delta encoding.
//
// Beats:
//   1. Track delta state (prev_gen_col, prev_src_idx, prev_src_line, prev_src_col).
//   2. Add mapping segments between generated byte offsets and source file locations.
//   3. Format JSON mappings string with semicolons and comma-separated segments.
//   4. Assemble complete JSON Source Map v3 payload.

import "wasm_sourcemap_vlq.oo";


pub type SourceMapGenerator = struct {
    file_name: String,
    sources: List[String],
    mappings_str: String,
    prev_gen_col: Int,
    prev_src_idx: Int,
    prev_src_line: Int,
    prev_src_col: Int
};

pub fn sourcemap_generator_new(out_file: String) -> SourceMapGenerator {
    let empty_sources: List[String] = list_new();
let res: SourceMapGenerator = SourceMapGenerator { file_name: out_file, sources: empty_sources, mappings_str: "", prev_gen_col: 0, prev_src_idx: 0, prev_src_line: 0, prev_src_col: 0 };
    return res;
}

pub fn sourcemap_add_source(mut gen: SourceMapGenerator, src_path: String) -> SourceMapGenerator {
    let mut gen: SourceMapGenerator = gen;
let mut srcs: List[String] = gen.sources;
srcs = list_push(srcs, src_path);
gen.sources = srcs;
return gen;
}

pub fn sourcemap_add_mapping(mut gen: SourceMapGenerator, gen_col: Int, src_idx: Int, src_line: Int, src_col: Int) -> SourceMapGenerator {
    let mut gen: SourceMapGenerator = gen;
let d_gen_col: Int = gen_col - gen.prev_gen_col;
let d_src_idx: Int = src_idx - gen.prev_src_idx;
let d_src_line: Int = src_line - gen.prev_src_line;
let d_src_col: Int = src_col - gen.prev_src_col;
let seg: String = vlq_encode_segment4(d_gen_col, d_src_idx, d_src_line, d_src_col);
if chars_len(gen.mappings_str) > 0 { gen.mappings_str = gen.mappings_str + "," + seg;
} else {
        gen.mappings_str = seg;
    }

    gen.prev_gen_col = gen_col;
    gen.prev_src_idx = src_idx;
    gen.prev_src_line = src_line;
    gen.prev_src_col = src_col;
    return gen;
}

pub fn sourcemap_to_json(gen: SourceMapGenerator) -> String {
    let mut json: String = "{\n";
    json = json + "  \"version\": 3,\n";
    json = json + "  \"file\": \"" + gen.file_name + "\",\n";
    json = json + "  \"sources\": [";
    let srcs: List[String] = gen.sources;
    let n: Int = list_len(srcs);
    let mut i: Int = 0;
    while i < n {
        json = json + "\"" + list_get(srcs, i) + "\"";
        if i < n - 1 { json = json + ", ";
        }
        i = i + 1;
    }
    json = json + "],\n";
    json = json + "  \"names\": [],\n";
    json = json + "  \"mappings\": \"" + gen.mappings_str + "\"\n";
    json = json + "}\n";
    return json;
}
