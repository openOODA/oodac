// # WebAssembly AST child-list split / WebAssembly Dead Code Elimination (ADCE) / WebAssembly Tail Call & Loop Trampoline Optimizer
//
// Logline: Split a comma-separated AST argument list in one O(n) byte scan. Aggressive dead code elimination, unreachable basic block pruning, and unused local register stripping. Tail call optimization lowering direct calls to return_call (0x12) and self-recursive calls to loop branches.
//
// Setup: Merged cohesive compiler module.
//
// Beats:
//   1. Unified cohesive implementation.


import "wasm_opt_ir.oo";

import "wasm_binary_builder.oo";


pub fn wasm_ast_split_items(items: String) -> List[String] {
    let mut out: List[String] = list_new();
    if items == "" { return out;
    }
    let n: Int = bytes_len(items);
    if n > 1048576 { println("ERR\twasm_emit\tast_too_large");
    process_exit(1);
    }
    let mut start: Int = 0;
    let mut depth: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: Int = byte_at(items, i);
        if c == 40 { depth = depth + 1;
        }
        if c == 41 { depth = depth - 1;
        }
        if c == 44 && depth == 0 { out = list_push(out, byte_slice(items, start, i));
        start = i + 1;
        }
        i = i + 1;
    }
    out = list_push(out, byte_slice(items, start, n));
    return out;
}

pub fn wasm_opt_dce_stream(st: WasmOptStream) -> WasmOptStream {
    let mut cur: WasmOptStream = st;
let n: Int = list_len(cur.opcodes);
let mut terminated: Bool = false;
let mut i: Int = 0;
while i < n { if terminated { cur.is_dead = wasm_ilist_set(cur.is_dead, i, 1);
} else {
            let op: Int = list_get(cur.opcodes, i);
            if op == 15 || op == 12 || op == 0 || op == 18 {
                // return (0x0F), br (0x0C), unreachable (0x00), return_call (0x12)
                terminated = true;
            }
        }
        i = i + 1;
    }
    return cur;
}

pub fn wasm_opt_dce_func(func: WasmOptFunc) -> WasmOptFunc {
    let mut out: WasmOptFunc = func;
out.stream = wasm_opt_dce_stream(func.stream);
return out;
}

pub fn wasm_opt_tail_call_stream(st: WasmOptStream, target_fn_idx: Int) -> WasmOptStream {
    let mut cur: WasmOptStream = st;
    let n: Int = list_len(cur.opcodes);
    if n < 2 { return cur;
    }
    let mut i: Int = 0;
    while i < n - 1 { let d1: Int = list_get(cur.is_dead, i);
    let d2: Int = list_get(cur.is_dead, i + 1);
    if d1 == 0 && d2 == 0 { let op1: Int = list_get(cur.opcodes, i);
    let op2: Int = list_get(cur.opcodes, i + 1);
    if op1 == 16 && op2 == 15 { cur.opcodes = wasm_ilist_set(cur.opcodes, i, 18);
    cur.is_dead = wasm_ilist_set(cur.is_dead, i + 1, 1);
    }
        }
        i = i + 1;
    }
    return cur;
}

pub fn wasm_opt_tail_call_func(func: WasmOptFunc) -> WasmOptFunc {
    let mut out: WasmOptFunc = func;
out.stream = wasm_opt_tail_call_stream(func.stream, func.func_index);
return out;
}
