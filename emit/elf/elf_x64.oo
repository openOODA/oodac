// # x86-64 sys_write + sys_exit image
//
// Logline: Write a decimal line to stdout then exit 0. No libc. No clang.
//
// Setup: RIP-relative lea to the message immediately after the syscalls.
//
// Beats:
//   1. mov rax/rdi/rdx immediates. syscall write then exit.
//   2. Message is ASCII digits plus newline.

import "elf_u.oo";

fn elf_ch(c: String) -> Int {
    if c == "0" { return 48; }
    if c == "1" { return 49; }
    if c == "2" { return 50; }
    if c == "3" { return 51; }
    if c == "4" { return 52; }
    if c == "5" { return 53; }
    if c == "6" { return 54; }
    if c == "7" { return 55; }
    if c == "8" { return 56; }
    if c == "9" { return 57; }
    if c == "-" { return 45; }
    if c == "\n" { return 10; }
    println("ERR\temit\telf: bad msg char");
    process_exit(1);
    return 0;
}

fn elf_push_msg(b: List[Int], s: String) -> List[Int] {
    let mut out: List[Int] = b;
    let mut i: Int = 0;
    while i < chars_len(s) {
        out = elf_u8(out, elf_ch(char_at(s, i)));
        i = i + 1;
    }
    return out;
}

pub fn elf_x64_write_exit(msg: String) -> List[Int] {
    let mut b: List[Int] = bytes_new();
    b = elf_u8(b, 72); b = elf_u8(b, 199); b = elf_u8(b, 192); b = elf_u32(b, 1);
    b = elf_u8(b, 72); b = elf_u8(b, 199); b = elf_u8(b, 199); b = elf_u32(b, 1);
    b = elf_u8(b, 72); b = elf_u8(b, 141); b = elf_u8(b, 53); b = elf_u32(b, 21);
    b = elf_u8(b, 72); b = elf_u8(b, 199); b = elf_u8(b, 194); b = elf_u32(b, chars_len(msg));
    b = elf_u8(b, 15); b = elf_u8(b, 5);
    b = elf_u8(b, 72); b = elf_u8(b, 199); b = elf_u8(b, 192); b = elf_u32(b, 60);
    b = elf_u8(b, 72); b = elf_u8(b, 49); b = elf_u8(b, 255);
    b = elf_u8(b, 15); b = elf_u8(b, 5);
    return elf_push_msg(b, msg);
}
