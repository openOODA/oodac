// # x86-64 Machine Code Instruction Lowering and Syscalls
//
// Logline: Low-level x86-64 byte encodings for prologue, epilogue, registers, spills, and exit.
//
// Setup: Emits raw machine bytes for ET_EXEC PT_LOAD execution without libc or clang.
//
// Beats:
//   1. Function prologue and epilogue stack frame management.
//   2. Immediate register moves, zeroing idiom, ALU ops, and stack spills.
//   3. Control flow branches, calls, and standalone write/exit execution images.

import "elf_u.oo";

pub fn elf_x64_prologue(b: List[Int], stack_size: Int) -> List[Int] {
    let mut out: List[Int] = elf_u8(b, 85);
    out = elf_u8(out, 72); out = elf_u8(out, 137); out = elf_u8(out, 229);
    if stack_size > 0 {
        out = elf_u8(out, 72); out = elf_u8(out, 129); out = elf_u8(out, 236);
        out = elf_u32(out, stack_size);
    }
    return out;
}

pub fn elf_x64_epilogue(b: List[Int]) -> List[Int] {
    let mut out: List[Int] = elf_u8(b, 72);
    out = elf_u8(out, 137); out = elf_u8(out, 236);
    out = elf_u8(out, 93);
    return elf_u8(out, 195);
}

pub fn elf_x64_mov_imm(b: List[Int], phys_reg: Int, imm: Int) -> List[Int] {
    let reg: Int = phys_reg % 8;
    if imm == 0 {
        let mut out_z: List[Int] = elf_u8(b, 49);
        return elf_u8(out_z, 192 + reg * 8 + reg);
    }
    let mut out: List[Int] = elf_u8(b, 72);
    out = elf_u8(out, 199);
    out = elf_u8(out, 192 + reg);
    return elf_i32(out, imm);
}

pub fn elf_x64_alu_reg(b: List[Int], opc: Int, dst_reg: Int, src_reg: Int) -> List[Int] {
    let mut out: List[Int] = elf_u8(b, 72);
    out = elf_u8(out, opc);
    let modrm: Int = 192 + (src_reg % 8) * 8 + (dst_reg % 8);
    return elf_u8(out, modrm);
}

pub fn elf_x64_spill_op(b: List[Int], is_store: Bool, phys_reg: Int, slot: Int) -> List[Int] {
    let disp: Int = 0 - (slot + 1) * 8;
    let mut out: List[Int] = elf_u8(b, 72);
    let opc: Int = if is_store { 137 } else { 139 };
    out = elf_u8(out, opc);
    let modrm: Int = 133 + (phys_reg % 8) * 8;
    out = elf_u8(out, modrm);
    return elf_i32(out, disp);
}

pub fn elf_x64_sib_op(b: List[Int], is_store: Bool, reg: Int, base: Int, index: Int, scale_pwr: Int, disp: Int) -> List[Int] {
    let mut out: List[Int] = elf_u8(b, 72);
    out = elf_u8(out, if is_store { 137 } else { 139 });
    let modrm: Int = 128 + (reg % 8) * 8 + 4;
    out = elf_u8(out, modrm);
    let sib: Int = (scale_pwr % 4) * 64 + (index % 8) * 8 + (base % 8);
    out = elf_u8(out, sib);
    return elf_i32(out, disp);
}

pub fn elf_x64_branch(b: List[Int], cond: Int, rel: Int) -> List[Int] {
    let force_near: Bool = cond >= 100;
    let c: Int = if force_near { cond - 100 } else { cond };
    if !force_near && rel >= 0 - 128 && rel <= 127 {
        let opc: Int = if c == 0 { 235 } else { 112 + c };
        let mut out: List[Int] = elf_u8(b, opc);
        let b8: Int = if rel >= 0 { rel } else { 256 + rel };
        return elf_u8(out, b8);
    }
    if c == 0 {
        let mut out2: List[Int] = elf_u8(b, 233);
        return elf_i32(out2, rel);
    }
    let mut out3: List[Int] = elf_u8(b, 15);
    out3 = elf_u8(out3, 128 + c);
    return elf_i32(out3, rel);
}

pub fn elf_x64_call(b: List[Int], rel32: Int) -> List[Int] {
    let mut out: List[Int] = elf_u8(b, 232);
    return elf_i32(out, rel32);
}
