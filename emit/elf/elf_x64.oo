// # x86-64 Machine Code Instruction Lowering and Syscalls
//
// Logline: Low-level x86-64 byte encodings for prologue, epilogue, registers, spills, and exit.
//
// Setup: Emits raw machine bytes for ET_EXEC PT_LOAD execution without libc or clang.
//
// Beats:
//   1. Function prologue and epilogue stack frame management.
//   2. Immediate register moves, register-to-register addition, and stack spill operations.
//   3. Standalone sys_write and sys_exit execution image generation.

import "elf_u.oo";

fn elf_ch(c: String) -> Int {
    if c == "0" { return 48; }
    if c == "1" { return 49; }
    if c == "2" { return 50; }
    if c == "3" { return 51; }
    if c == "4" { return 52; }
    if c == "5" { return 53; }
    if c == "6" { return 54; }
    if c == "7" { return 55; }
    if c == "8" { return 56; }
    if c == "9" { return 57; }
    if c == "-" { return 45; }
    if c == "\n" { return 10; }
    println("ERR\temit\telf: bad msg char");
    process_exit(1);
    return 0;
}

fn elf_push_msg(b: List[Int], s: String) -> List[Int] {
    let mut out: List[Int] = b;
    let mut i: Int = 0;
    while i < chars_len(s) {
        out = elf_u8(out, elf_ch(char_at(s, i)));
        i = i + 1;
    }
    return out;
}

pub fn elf_x64_prologue(b: List[Int], stack_size: Int) -> List[Int] {
    let mut out: List[Int] = elf_u8(b, 85);
    out = elf_u8(out, 72); out = elf_u8(out, 137); out = elf_u8(out, 229);
    if stack_size > 0 {
        out = elf_u8(out, 72); out = elf_u8(out, 129); out = elf_u8(out, 236);
        out = elf_u32(out, stack_size);
    }
    return out;
}

pub fn elf_x64_epilogue(b: List[Int]) -> List[Int] {
    let mut out: List[Int] = elf_u8(b, 72);
    out = elf_u8(out, 137); out = elf_u8(out, 236);
    out = elf_u8(out, 93);
    return elf_u8(out, 195);
}

pub fn elf_x64_mov_imm(b: List[Int], phys_reg: Int, imm: Int) -> List[Int] {
    let mut out: List[Int] = elf_u8(b, 72);
    out = elf_u8(out, 199);
    out = elf_u8(out, 192 + (phys_reg % 8));
    return elf_i32(out, imm);
}

pub fn elf_x64_add_reg(b: List[Int], dst_reg: Int, src_reg: Int) -> List[Int] {
    let mut out: List[Int] = elf_u8(b, 72);
    out = elf_u8(out, 1);
    let modrm: Int = 192 + (src_reg % 8) * 8 + (dst_reg % 8);
    return elf_u8(out, modrm);
}

pub fn elf_x64_spill_op(b: List[Int], is_store: Bool, phys_reg: Int, slot: Int) -> List[Int] {
    let disp: Int = 0 - (slot + 1) * 8;
    let mut out: List[Int] = elf_u8(b, 72);
    let opc: Int = if is_store { 137 } else { 139 };
    out = elf_u8(out, opc);
    let modrm: Int = 133 + (phys_reg % 8) * 8;
    out = elf_u8(out, modrm);
    return elf_i32(out, disp);
}

pub fn elf_x64_write_exit(msg: String) -> List[Int] {
    let mut b: List[Int] = bytes_new();
    b = elf_u8(b, 72); b = elf_u8(b, 199); b = elf_u8(b, 192); b = elf_u32(b, 1);
    b = elf_u8(b, 72); b = elf_u8(b, 199); b = elf_u8(b, 199); b = elf_u32(b, 1);
    b = elf_u8(b, 72); b = elf_u8(b, 141); b = elf_u8(b, 53); b = elf_u32(b, 21);
    b = elf_u8(b, 72); b = elf_u8(b, 199); b = elf_u8(b, 194); b = elf_u32(b, chars_len(msg));
    b = elf_u8(b, 15); b = elf_u8(b, 5);
    b = elf_u8(b, 72); b = elf_u8(b, 199); b = elf_u8(b, 192); b = elf_u32(b, 60);
    b = elf_u8(b, 72); b = elf_u8(b, 49); b = elf_u8(b, 255);
    b = elf_u8(b, 15); b = elf_u8(b, 5);
    return elf_push_msg(b, msg);
}
