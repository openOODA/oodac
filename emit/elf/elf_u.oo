// # Little-endian byte append and string encoding for ELF
//
// Logline: Push u8/u16/u32/u64/i32 and ASCII strings onto a List[Int] byte buffer.
//
// Setup: Low byte first. Bytes returned in a new list. Non-negative width unpacking.
//
// Beats:
//   1. Unpack integer primitives (u8, u16, u32, u64, i32) into little-endian bytes.
//   2. Validate and convert ASCII characters to numeric byte codes.
//   3. Append string buffers to byte streams for headers and payloads.

pub fn elf_u8(b: List[Int], n: Int) -> List[Int] {
    let lo: Int = n - (n / 256) * 256;
    return bytes_push(b, lo);
}

pub fn elf_u16(b: List[Int], n: Int) -> List[Int] {
    let b1: List[Int] = elf_u8(b, n);
    return elf_u8(b1, n / 256);
}

pub fn elf_u32(b: List[Int], n: Int) -> List[Int] {
    let mut x: Int = n;
    let mut out: List[Int] = b;
    let mut i: Int = 0;
    while i < 4 {
        out = elf_u8(out, x);
        x = x / 256;
        i = i + 1;
    }
    return out;
}

pub fn elf_u64(b: List[Int], n: Int) -> List[Int] {
    let mut x: Int = n;
    let mut out: List[Int] = b;
    let mut i: Int = 0;
    while i < 8 {
        out = elf_u8(out, x);
        x = x / 256;
        i = i + 1;
    }
    return out;
}

pub fn elf_i32(b: List[Int], n: Int) -> List[Int] {
    if n >= 0 { return elf_u32(b, n); }
    return elf_u32(b, 4294967296 + n);
}

pub fn elf_pad(b: List[Int], align: Int) -> List[Int] {
    let mut out: List[Int] = b;
    while (list_len(out) % align) != 0 {
        out = bytes_push(out, 0);
    }
    return out;
}

pub fn elf_ch(c: String) -> Int {
    if bytes_len(c) == 0 { return 0; }
    return byte_at(c, 0);
}

pub fn elf_push_msg(b: List[Int], s: String) -> List[Int] {
    let mut out: List[Int] = b;
    let mut i: Int = 0;
    let n: Int = bytes_len(s);
    while i < n {
        out = elf_u8(out, byte_at(s, i));
        i = i + 1;
    }
    return out;
}
