// # Mangle a C function name by source file
//
// Logline: Return a C identifier for a function name, preserving global names for multi-module calls.
//
// Setup: C emitter naming shims.
//
// Beats:
//   1. Return unmodified function name for C identifier resolution.
//   2. Compare two source paths normalizing leading dot-slash prefixes.

fn c_file_stem(path: String) -> String {
    let a: String = c_strip_dot_slash(path);
    let n: Int = chars_len(a);
    if n == 0 { return ""; }
    let mut last_slash: Int = 0 - 1;
    let mut i: Int = 0;
    while i < n {
        if char_at(a, i) == "/" { last_slash = i; }
        i = i + 1;
    }
    let mut start: Int = 0;
    if last_slash >= 0 { start = last_slash + 1; }
    let mut end: Int = n;
    if end >= start + 3 && str_slice(a, end - 3, end) == ".oo" {
        end = end - 3;
    }
    let stem: String = str_slice(a, start, end);
    let mut out: String = "";
    let sn: Int = chars_len(stem);
    let mut j: Int = 0;
    while j < sn {
        let ch: String = char_at(stem, j);
        if ch == "-" || ch == "." { out = out + "_"; }
        else { out = out + ch; }
        j = j + 1;
    }
    return out;
}

pub fn c_mangle_fn_name(name: String, path: String) -> String {
    if name == "main" { return name; }
    let stem: String = c_file_stem(path);
    if stem != "" { return "_oo_" + stem + "_" + name; }
    return "_oo_" + name;
}

fn c_strip_dot_slash(p: String) -> String {
    let n: Int = chars_len(p);
    if n >= 2 && char_at(p, 0) == "." && char_at(p, 1) == "/" {
        return str_slice(p, 2, n);
    }
    return p;
}

pub fn c_same_file(p1: String, p2: String) -> Bool {
    let a: String = c_strip_dot_slash(p1);
    let b: String = c_strip_dot_slash(p2);
    if a == b { return true; }
    let na: Int = chars_len(a);
    let nb: Int = chars_len(b);
    if na == 0 || nb == 0 { return false; }
    if na >= nb {
        if str_slice(a, na - nb, na) != b { return false; }
        if na == nb { return true; }
        return char_at(a, na - nb - 1) == "/";
    }
    if str_slice(b, nb - na, nb) != a { return false; }
    return char_at(b, nb - na - 1) == "/";
}
