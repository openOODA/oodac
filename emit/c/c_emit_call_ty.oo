pub fn c_is_i64_call(name: String) -> Bool {
    if name == "chars_len" || name == "list_len" || name == "parse_int" || name == "file_size" { return true;
    }
    if name == "oo_slist_len" || name == "oo_ilist_len" || name == "oo_flist_len" || name == "oo_chars_len" { return true;
    }
    if name == "byte_at" || name == "oo_byte_at" || name == "str_byte_at" || name == "oo_str_byte_at" { return true;
    }
    if name == "bytes_len" || name == "oo_bytes_len" || name == "bytes_get" || name == "oo_bytes_get" { return true;
    }
    if name == "str_index_of" || name == "oo_str_index_of" || name == "alloc_bytes" || name == "oo_alloc_bytes" { return true;
    }
    if name == "now_ms" || name == "oo_now_ms" || name == "monotonic_us" || name == "oo_monotonic_us" || name == "random" || name == "oo_random" || name == "ord" || name == "oo_ord" { return true;
    }
    if name == "proc_mem_read" || name == "oo_proc_mem_read" { return true;
    }
    if name == "meta_epoch" || name == "oo_meta_epoch" || name == "meta_mix" || name == "oo_meta_mix" { return true;
    }
    if name == "soa_layout" || name == "dod_layout" || name == "checkpoint" || name == "rollback" { return true;
    }
    if name == "import_c" || name == "oo_import_c" || name == "ffi_gen" || name == "oo_ffi_gen" || name == "lto_xlang_link" || name == "oo_lto_xlang_link" { return true;
    }
    if name == "c_count_top_args" || name == "method_call_end" || name == "operand_end" || name == "c_binop_prec" { return true;
    }
    if name == "skip_until_semi" || name == "skip_balanced" || name == "skip_primary" || name == "c_emit_fn" || name == "c_emit_skip_type" || name == "c_emit_skip_braces" { return true;
    }
    if name == "x86_runtime_count" || name == "c_env_scope_depth" || name == "poly_ineq_eval" || name == "poly_domain_count_points_bounded" || name == "c_skip_amp_mut" || name == "wasm_zone_rodata_base" || name == "wasm_zone_shadow_stack_size" || name == "wasm_zone_scratch_base" || name == "wasm_zone_scratch_size" || name == "wasm_zone_heap_ptr_addr" || name == "wasm_rodata_add_string" || name == "wasm_env_bind_var" || name == "wasm_env_bind_var_ext" || name == "wasm_lower_expr" || name == "wasm_env_alloc" || name == "wasm_env_lookup_var" || name == "wasm_env_lookup_type" || name == "wasm_lower_struct_inst" || name == "list_len_str" || name == "wasm_adt_alloc" || name == "wasm_parse_int" || name == "wasm_env_field_offset" || name == "wasm_env_field_type" || name == "wasm_env_lookup_func" || name == "wasm_map_type_str" || name == "wasm_lower_expr_or_block" || name == "wasm_builder_add_type" || name == "wasm_builder_add_func" || name == "wasm_builder_add_import_func" || name == "slab_class_for_size" || name == "slab_class_size" || name == "slab_pool_alloc" || name == "buddy_order_for_size" || name == "buddy_block_size" || name == "buddy_alloc" || name == "x86_bind_idx" || name == "x86_struct_field_count" || name == "x86_struct_field_offset" || name == "eval_env_heap_alloc" || name == "eval_env_heap_read" || name == "eval_env_list_len" || name == "eval_env_list_new" || name == "eval_env_alloc_struct" || name == "eval_env_find_var" || name == "parse_dec_str" || name == "eval_op_prec" || name == "a64_lookup_parse" { return true;
    }
    let n_len: Int = chars_len(name);
    if n_len >= 7 && str_slice(name, 0, 7) == "ssa_op_" { return true;
    }
    if n_len >= 8 && str_slice(name, 0, 8) == "wasm_op_" { return true;
    }
    if n_len >= 9 && str_slice(name, 0, 9) == "wasm_sec_" { return true;
    }
    if n_len >= 9 && str_slice(name, 0, 9) == "wasm_val_" { return true;
    }
    if n_len >= 11 && str_slice(name, 0, 11) == "wasm_block_" { return true;
    }
    return false;
}

pub fn c_is_f64_call(name: String) -> Bool {
    if name == "sin" || name == "cos" || name == "ln" || name == "exp" || name == "sqrt" || name == "pow" { return true;
    }
    if name == "oo_sin" || name == "oo_cos" || name == "oo_ln" || name == "oo_exp" || name == "oo_sqrt" || name == "oo_pow" { return true;
    }
    return false;
}

