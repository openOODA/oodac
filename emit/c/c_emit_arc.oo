// # Emit ARC scope releases
//
// Logline: Tracks {; scope frames in the C env and prints oo_*_release calls on scope exit.
//
// Setup: Backend-C floor. env is {; frames and name=kind; T S I LF release; LL_* and multi-char user lists release; F never; __no_arc__ and __formal__ suppress.
//
// Beats:
//   1. c_env_push_scope appends a {; frame; c_env_pop_scope strips the top frame.
//   2. c_arc_kind_release and c_arc_kind_retain map kind symbols and types to ARC runtime calls.
//   3. c_emit_env_releases scans an env slice backward and emits unique non-formal releases.
//   4. c_emit_scope_exit pops the top frame; c_emit_all_scope_releases and c_emit_local_releases handle full/body scopes.

import "c_emit_env.oo";



pub fn c_env_push_scope(env: String) -> String {
    return env + "{;";
}

// Pop the most recent scope pushed by c_env_push_scope. Strips everything from
// the last "{;" marker to the end of the env string. This is called after
// c_emit_local_releases so the next function does not re-release the previous
// function's local variables.
pub fn c_env_pop_scope(env: String) -> String {
    let elen = bytes_len(env); let mut i = elen - 1; while i >= 1 { if byte_at(env, i - 1) == 123 && byte_at(env, i) == 59 { return str_slice(env, 0, i - 1);
}
        i = i - 1;
    }
    return env;
}

pub fn c_is_formal_param(env: String, name: String) -> Int {
    if c_env_get(env, "__formal__" + name) == "1" { return 1;
}
    return 0;
}

// Read kind text after `=` through `;`. Returns [pos_after_semi, kind].
pub fn c_env_take_kind(s: String, p0: Int) -> List[String] {
    let n: Int = bytes_len(s);
    let mut p: Int = p0;
    while p < n && byte_at(s, p) != 59 { p = p + 1; }
    let kind: String = str_slice(s, p0, p);
    if p < n { p = p + 1; }
    let mut o: List[String] = list_new();
    o = list_push(o, p.to_string());
    o = list_push(o, kind);
    return o;
}

pub fn c_arc_kind_release(kind: String, name: String) -> String {
    if kind == "T" || kind == "OoStr" { return "oo_str_release(" + name + "); "; }
    if kind == "S" || kind == "OoSList" || kind == "OoL_S" { return "oo_slist_release(" + name + "); "; }
    if kind == "LF" || kind == "OoFList" || kind == "OoL_F" { return "oo_flist_release(" + name + "); "; }
    if kind == "I" || kind == "F" || kind == "B" || kind == "V" || kind == "long long" || kind == "double" || kind == "int" { return ""; }
    if kind == "R" || kind == "OoResS" || kind == "OoRes_S" { return "oo_str_release(" + name + ".val); "; }
    if kind == "RI" || kind == "OoResI" || kind == "OoRes_I" { return "if (!" + name + ".ok) { oo_str_release(" + name + ".err); } "; }
    if kind == "OoResV" { return "if (!" + name + ".ok) { oo_str_release(" + name + ".err); } "; }
    if kind == "RII" || kind == "OoResII" { return ""; }
    if kind == "RLI" || kind == "OoResLI" || kind == "OoRes_OoL_I" { return "if (" + name + ".ok) { oo_ilist_release(" + name + ".val); } else { oo_str_release(" + name + ".err); } "; }
    if kind == "RLS" || kind == "OoResLS" || kind == "OoRes_OoL_S" { return "if (" + name + ".ok) { oo_slist_release(" + name + ".val); } else { oo_str_release(" + name + ".err); } "; }
    if kind == "RLF" || kind == "OoResLF" || kind == "OoRes_OoL_F" { return "if (" + name + ".ok) { oo_flist_release(" + name + ".val); } else { oo_str_release(" + name + ".err); } "; }
    if kind == "RB" || kind == "OoResB" || kind == "OoRes_B" { return "if (!" + name + ".ok) { oo_str_release(" + name + ".err); } "; }
    if kind == "RF" || kind == "OoResF" || kind == "OoRes_F" { return "if (!" + name + ".ok) { oo_str_release(" + name + ".err); } "; }
    if kind == "OoIList" || kind == "OoL_I" { return "oo_ilist_release(" + name + "); "; }
    if kind == "LL_I" || kind == "OoLL_I" { return "oo_ll_I_release(" + name + "); "; }
    if kind == "LL_S" || kind == "OoLL_S" { return "oo_ll_S_release(" + name + "); "; }
    if kind == "LL_F" || kind == "OoLL_F" { return "oo_ll_F_release(" + name + "); "; }
    if kind == "LLL_I" || kind == "OoLLL_I" { return "oo_lll_I_release(" + name + "); "; }
    if kind == "LLL_S" || kind == "OoLLL_S" { return "oo_lll_S_release(" + name + "); "; }
    if kind == "LLL_F" || kind == "OoLLL_F" { return "oo_lll_F_release(" + name + "); "; }
    if kind == "LLLL_I" || kind == "OoLLLL_I" { return "oo_llll_I_release(" + name + "); "; }
    if kind == "LLLL_S" || kind == "OoLLLL_S" { return "oo_llll_S_release(" + name + "); "; }
    if kind == "LLLL_F" || kind == "OoLLLL_F" { return "oo_llll_F_release(" + name + "); "; }
    let kn = bytes_len(kind);
    if kn >= 4 && str_slice(kind, 0, 4) == "OoL_" { return "oo_release_" + kind + "(" + name + "); "; }
    if kn >= 6 && str_slice(kind, 0, 6) == "OoOpt_" { return "oo_release_" + kind + "(" + name + "); "; }
    if kn >= 6 && str_slice(kind, 0, 6) == "OoRes_" { return "oo_release_" + kind + "(" + name + "); "; }
    if kn >= 7 && str_slice(kind, 0, 7) == "OoRes2_" { return "oo_release_" + kind + "(" + name + "); "; }
    if kn >= 5 && str_slice(kind, 0, 5) == "LLLL_" { let suf = str_slice(kind, 5, kn); return "oo_llll_" + suf + "_release(" + name + "); "; }
    if kn >= 4 && str_slice(kind, 0, 4) == "LLL_" { let suf = str_slice(kind, 4, kn); return "oo_lll_" + suf + "_release(" + name + "); "; }
    if kn >= 3 && str_slice(kind, 0, 3) == "LL_" { let suf = str_slice(kind, 3, kn); return "oo_ll_" + suf + "_release(" + name + "); "; }
    if kn > 1 && byte_at(kind, 0) >= 65 && byte_at(kind, 0) <= 90 { return "oo_release_" + kind + "(" + name + "); "; }
    return "";
}

pub fn c_arc_kind_retain(kind: String, name: String) -> String {
    if kind == "T" || kind == "OoStr" { return "oo_str_retain(" + name + "); "; }
    if kind == "S" || kind == "OoSList" || kind == "OoL_S" { return "oo_slist_retain(" + name + "); "; }
    if kind == "LF" || kind == "OoFList" || kind == "OoL_F" { return "oo_flist_retain(" + name + "); "; }
    if kind == "I" || kind == "F" || kind == "B" || kind == "V" || kind == "long long" || kind == "double" || kind == "int" { return ""; }
    if kind == "R" || kind == "OoResS" || kind == "OoRes_S" { return "oo_str_retain(" + name + ".val); "; }
    if kind == "RI" || kind == "OoResI" || kind == "OoRes_I" { return "if (!" + name + ".ok) { oo_str_retain(" + name + ".err); } "; }
    if kind == "OoResV" { return "if (!" + name + ".ok) { oo_str_retain(" + name + ".err); } "; }
    if kind == "RII" || kind == "OoResII" { return ""; }
    if kind == "RLI" || kind == "OoResLI" || kind == "OoRes_OoL_I" { return "if (" + name + ".ok) { oo_ilist_retain(" + name + ".val); } else { oo_str_retain(" + name + ".err); } "; }
    if kind == "RLS" || kind == "OoResLS" || kind == "OoRes_OoL_S" { return "if (" + name + ".ok) { oo_slist_retain(" + name + ".val); } else { oo_str_retain(" + name + ".err); } "; }
    if kind == "RLF" || kind == "OoResLF" || kind == "OoRes_OoL_F" { return "if (" + name + ".ok) { oo_flist_retain(" + name + ".val); } else { oo_str_retain(" + name + ".err); } "; }
    if kind == "RB" || kind == "OoResB" || kind == "OoRes_B" { return "if (!" + name + ".ok) { oo_str_retain(" + name + ".err); } "; }
    if kind == "RF" || kind == "OoResF" || kind == "OoRes_F" { return "if (!" + name + ".ok) { oo_str_retain(" + name + ".err); } "; }
    if kind == "OoIList" || kind == "OoL_I" { return "oo_ilist_retain(" + name + "); "; }
    if kind == "LL_I" || kind == "OoLL_I" { return "oo_ll_I_retain(" + name + "); "; }
    if kind == "LL_S" || kind == "OoLL_S" { return "oo_ll_S_retain(" + name + "); "; }
    if kind == "LL_F" || kind == "OoLL_F" { return "oo_ll_F_retain(" + name + "); "; }
    if kind == "LLL_I" || kind == "OoLLL_I" { return "oo_lll_I_retain(" + name + "); "; }
    if kind == "LLL_S" || kind == "OoLLL_S" { return "oo_lll_S_retain(" + name + "); "; }
    if kind == "LLL_F" || kind == "OoLLL_F" { return "oo_lll_F_retain(" + name + "); "; }
    if kind == "LLLL_I" || kind == "OoLLLL_I" { return "oo_llll_I_retain(" + name + "); "; }
    if kind == "LLLL_S" || kind == "OoLLLL_S" { return "oo_llll_S_retain(" + name + "); "; }
    if kind == "LLLL_F" || kind == "OoLLLL_F" { return "oo_llll_F_retain(" + name + "); "; }
    let kn = bytes_len(kind);
    if kn >= 4 && str_slice(kind, 0, 4) == "OoL_" { return "oo_retain_" + kind + "(" + name + "); "; }
    if kn >= 6 && str_slice(kind, 0, 6) == "OoOpt_" { return "oo_retain_" + kind + "(" + name + "); "; }
    if kn >= 6 && str_slice(kind, 0, 6) == "OoRes_" { return "oo_retain_" + kind + "(" + name + "); "; }
    if kn >= 7 && str_slice(kind, 0, 7) == "OoRes2_" { return "oo_retain_" + kind + "(" + name + "); "; }
    if kn >= 5 && str_slice(kind, 0, 5) == "LLLL_" { let suf = str_slice(kind, 5, kn); return "oo_llll_" + suf + "_retain(" + name + "); "; }
    if kn >= 4 && str_slice(kind, 0, 4) == "LLL_" { let suf = str_slice(kind, 4, kn); return "oo_lll_" + suf + "_retain(" + name + "); "; }
    if kn >= 3 && str_slice(kind, 0, 3) == "LL_" { let suf = str_slice(kind, 3, kn); return "oo_ll_" + suf + "_retain(" + name + "); "; }
    if kn > 1 && byte_at(kind, 0) >= 65 && byte_at(kind, 0) <= 90 { return "oo_retain_" + kind + "(" + name + "); "; }
    return "";
}

pub fn c_emit_env_releases(slice: String, env: String) {
    let elen = bytes_len(slice);
    let mut p = 0;
    let mut seen = "";
    let mut names: List[String] = list_new();
    let mut kinds: List[String] = list_new();
    while p < elen { let b = byte_at(slice, p); if b == 123 { p = p + 1; if p < elen && byte_at(slice, p) == 59 { p = p + 1; }
        } else if b == 59 { p = p + 1; } else {
            let name_start = p;
            while p < elen && byte_at(slice, p) != 61 && byte_at(slice, p) != 123 && byte_at(slice, p) != 59 {
                p = p + 1;
            }
            if p < elen && byte_at(slice, p) == 61 { let name_var = str_slice(slice, name_start, p); let tk: List[String] = c_env_take_kind(slice, p + 1); p = parse_int(list_get(tk, 0)); names = list_push(names, name_var); kinds = list_push(kinds, list_get(tk, 1)); }
        }
    }

    let mut i_name = list_len(names) - 1;
    let mut out = "  ";
    while i_name >= 0 { let name_var = list_get(names, i_name); let kind = list_get(kinds, i_name); let is_internal = bytes_len(name_var) >= 2 && byte_at(name_var, 0) == 95 && byte_at(name_var, 1) == 95; if !is_internal && c_env_get(seen, name_var) == "" { seen = c_env_put(seen, name_var, "1"); let is_formal = 0 + c_is_formal_param(env, name_var); if is_formal == 1 { } else if c_env_get(env, "__no_arc__") != "1" {
                let mut use_k: String = kind;
                let precise_ty: String = c_env_get(env, "__ty__" + name_var);
                if precise_ty != "" { use_k = precise_ty; }
                out = out + c_arc_kind_release(use_k, name_var);
            }
        }
        i_name = i_name - 1;
    }
    if bytes_len(out) > 2 { println(out); }
}

pub fn c_emit_all_scope_releases(env: String) {
    c_emit_env_releases(env, env);
}

pub fn c_emit_scope_exit(env: String) -> String {
    let elen = bytes_len(env); let mut last_idx = -1; let mut i = 0; while i + 1 < elen { if byte_at(env, i) == 123 && byte_at(env, i + 1) == 59 { last_idx = i;
}
        i = i + 1;
    }
    if last_idx < 0 { return env; }
    c_emit_env_releases(str_slice(env, last_idx + 2, elen), env);
    return str_slice(env, 0, last_idx);
}

// Body locals only: skip pre-scope params/meta (first `{;`). Safe for early return.
pub fn c_emit_local_releases(env: String) {
    let elen = bytes_len(env);
    let mut i = 0;
    let mut start = -1;
    while i + 1 < elen { if byte_at(env, i) == 123 && byte_at(env, i + 1) == 59 { start = i; i = elen; } else {
            i = i + 1;
        }
    }
    if start < 0 { return; }
    c_emit_env_releases(str_slice(env, start, elen), env);
}
