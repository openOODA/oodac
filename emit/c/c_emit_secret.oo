// # Refuse secret sinks
//
// Logline: Tag SECRET values and refuse println, write_file, fetch, sys_exec, process_exec, env_get.
//
// Setup: Secret variables and sink definitions are tagged in the emission environment.
//
// Beats:
//   1. Track secret tags in env.
//   2. Refuse listed sinks.
//   3. Fail closed.

import "c_emit_env.oo";
import "lex/token_fmt.oo";

// Line-start secret directive: tag ident produces env fragment
pub fn c_parse_secret_env(src: String) -> String {
    let needle = "// " + "SECRET:";
    let nn = chars_len(needle);
    let sn = chars_len(src);
    let mut env = "";
    let mut i = 0;
    while i + nn <= sn {
        let mut at_line = false;
        if i == 0 || char_at(src, i - 1) == "\n" {
            at_line = true;
        }
        if at_line {
            let mut ok = true;
            let mut j = 0;
            while j < nn {
                if char_at(src, i + j) != char_at(needle, j) {
                    ok = false;
                    j = nn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                let mut k = i + nn;
                while k < sn {
                    let c = char_at(src, k);
                    if c == " " || c == "\t" {
                        k = k + 1;
                    } else {
                        break;
                    }
                }
                let start = k;
                while k < sn {
                    let c = char_at(src, k);
                    let is_al = c == "_" || c == "a" || c == "b" || c == "c" || c == "d" || c == "e"
                        || c == "f" || c == "g" || c == "h" || c == "i" || c == "j" || c == "k"
                        || c == "l" || c == "m" || c == "n" || c == "o" || c == "p" || c == "q"
                        || c == "r" || c == "s" || c == "t" || c == "u" || c == "v" || c == "w"
                        || c == "x" || c == "y" || c == "z" || c == "A" || c == "B" || c == "C"
                        || c == "D" || c == "E" || c == "F" || c == "G" || c == "H" || c == "I"
                        || c == "J" || c == "K" || c == "L" || c == "M" || c == "N" || c == "O"
                        || c == "P" || c == "Q" || c == "R" || c == "S" || c == "T" || c == "U"
                        || c == "V" || c == "W" || c == "X" || c == "Y" || c == "Z" || c == "0"
                        || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6"
                        || c == "7" || c == "8" || c == "9";
                    if is_al {
                        k = k + 1;
                    } else {
                        break;
                    }
                }
                let name = str_slice(src, start, k);
                if name == "" {
                    println("ERR\tsecret\tinvalid name (need ident after SECRET directive)");
                    process_exit(1);
                }
                env = c_env_put(env, "__sec__" + name, "1");
                // Directive root: sticky-clear must not wipe secret directive identifiers.
                env = c_env_put(env, "__secref__" + name, "1");
                i = k;
            } else {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return env;
}

pub fn c_secret_name_is_tainted(env: String, name: String) -> Bool {
    if c_env_get(env, "__sec__" + name) == "1" { return true; }
    if c_env_get(env, "__fr_secret__" + name) == "1" { return true; }
    // Any dotted prefix that is tainted makes the whole path tainted.
    let n: Int = chars_len(name);
    let mut i: Int = n - 1;
    while i > 0 {
        if char_at(name, i) == "." {
            let prefix: String = str_slice(name, 0, i);
            if c_env_get(env, "__sec__" + prefix) == "1" { return true; }
            if c_env_get(env, "__fr_secret__" + prefix) == "1" { return true; }
        }
        i = i - 1;
    }
    return false;
}

pub fn c_secret_refuse_println_ident(env: String, name: String) {
    if c_secret_name_is_tainted(env, name) {
        println("ERR\tsecret\tprintln sink refuses SECRET " + name);
        process_exit(1);
    }
}

// sink = write_file | fetch | sys_exec
pub fn c_secret_refuse_sink_ident(env: String, sink: String, name: String) {
    if c_secret_name_is_tainted(env, name) {
        println("ERR\tsecret\t" + sink + " sink refuses SECRET " + name);
        process_exit(1);
    }
}

pub fn c_secret_refuse_sink_resolved(env: String, t: String, name: String) {
    let cur: String = c_secret_resolve_alias(env, name);
    c_secret_refuse_sink_ident(env, t, cur);
}

// eq_only: refuse only when argi == want; else refuse any argi >= want (sys_exec argv).
// Require LPAREN — bare `let w = write_file` must not scan the rest of the file.
pub fn c_secret_scan_call(env: String, toks: List[String], start: Int, n: Int, want: Int, eq_only: Bool, sink: String) {
    let mut p = start;
    if p >= n || c_tokk(toks, p) != "LPAREN" {
        return;
    }
    p = p + 1;
    let mut argi = 0;
    let mut in_args = true;
    let mut depth = 1;
    while in_args && p < n {
        let kk: String = c_tokk(toks, p);
        if kk == "LPAREN" {
            depth = depth + 1;
            p = p + 1;
        } else if kk == "RPAREN" {
            depth = depth - 1;
            if depth <= 0 {
                in_args = false;
            }
            p = p + 1;
        } else if kk == "COMMA" {
            if depth == 1 {
                argi = argi + 1;
            }
            p = p + 1;
        } else if kk == "IDENT" {
            let mut full_path: String = c_tokt(toks, p);
            let mut q: Int = p + 1;
            while q + 1 < n && c_tokk(toks, q) == "DOT"
                && c_tokk(toks, q + 1) == "IDENT" {
                full_path = full_path + "." + c_tokt(toks, q + 1);
                q = q + 2;
            }
            if eq_only {
                if argi == want {
                    c_secret_refuse_sink_resolved(env, sink, full_path);
                }
            } else {
                if argi >= want {
                    c_secret_refuse_sink_resolved(env, sink, full_path);
                }
            }
            p = q;
        } else {
            p = p + 1;
        }
    }
}

// check_secret_println_sinks lives in c_emit_secret_check.oo
// c_secret_prop_from_rhs + c_secret_mark_returning_fns live in c_emit_secret_prop.oo

pub fn c_secret_is_sink_name(name: String) -> Bool {
    if name == "println" || name == "eprintln" || name == "print_err" || name == "log" || name == "fprintf" || name == "syslog" { return true; }
    if name == "write_file" || name == "fetch" || name == "sys_exec" || name == "sys_exec_wait" || name == "process_exec" { return true; }
    if name == "env_get" || name == "env_set" || name == "setenv" || name == "unsetenv" { return true; }
    if name == "read_file" || name == "path_exists" || name == "file_size" || name == "process_exit" || name == "sleep_ms" || name == "seed" { return true; }
    if name == "alloc_bytes" || name == "free_bytes" || name == "malloc" || name == "free" || name == "realloc" { return true; }
    if name == "mmap" || name == "mprotect" || name == "shmat" || name == "pwrite" || name == "sendfile" || name == "splice" || name == "tee" { return true; }
    if name == "tcp_write" || name == "net_tcp_write" || name == "net_send" || name == "http_post" || name == "tcp_read" || name == "udp_recv" || name == "udp_send" { return true; }
    if name == "dlopen" || name == "dlsym" || name == "dlclose" || name == "ffi_call" || name == "ffi_prep_cif" || name == "import_c" || name == "ffi_gen" || name == "lto_xlang_link" { return true; }
    return false;
}

pub fn c_secret_resolve_alias(env: String, name: String) -> String {
    let mut cur: String = name;
    let mut i: Int = 0;
    while i < 16 {
        let next: String = c_env_get(env, "__alias__" + cur);
        if next != "" { cur = next; i = i + 1; } else { i = 16; }
    }
    return cur;
}

pub fn c_secret_record_alias_let(env: String, dest: String, rhs: String) -> String {
    if dest == "" || rhs == "" || dest == rhs { return env; }
    let mut should: Bool = false;
    if c_secret_is_sink_name(rhs) {
        should = true;
    } else {
        let al: String = c_env_get(env, "__alias__" + rhs);
        if al != "" || c_secret_is_sink_name(c_secret_resolve_alias(env, rhs)) { should = true; }
    }
    if should { return c_env_put(env, "__alias__" + dest, rhs); }
    return env;
}

pub fn c_secret_clear_alias(env: String, dest: String) -> String {
    if dest == "" { return env; }
    if c_env_get(env, "__alias__" + dest) != "" { return c_env_put(env, "__alias__" + dest, ""); }
    return env;
}

pub fn c_secret_try_record_alias_rhs(toks: List[String], pos: Int, n: Int, env: String, dest: String) -> String {
    if pos < n && c_tokk(toks, pos) == "IDENT" {
        let rhs: String = c_tokt(toks, pos);
        let mut bare: Bool = true;
        if pos + 1 < n {
            let nk: String = c_tokk(toks, pos + 1);
            if nk == "LPAREN" || nk == "DOT" || nk == "LBRACKET" || nk == "COLON" || nk == "PLUS" || nk == "MINUS"
                || nk == "STAR" || nk == "SLASH" || nk == "EQ" || nk == "EQEQ" || nk == "NE" || nk == "LT"
                || nk == "GT" || nk == "AMP" || nk == "PIPE" || nk == "QUESTION" {
                bare = false;
            }
        }
        if bare {
            let mut should: Bool = false;
            if c_secret_is_sink_name(rhs) || c_env_get(env, "__alias__" + rhs) != ""
                || c_secret_is_sink_name(c_secret_resolve_alias(env, rhs)) {
                should = true;
            }
            if should { return c_secret_record_alias_let(env, dest, rhs); }
            return c_secret_clear_alias(env, dest);
        }
    }
    return c_secret_clear_alias(env, dest);
}

pub fn c_secret_note_bare_alias(toks: List[String], pos: Int, n: Int, env: String, dest: String) -> String {
    return c_secret_try_record_alias_rhs(toks, pos, n, env, dest);
}

pub fn c_secret_is_user_sink(env: String, name: String) -> Bool {
    if c_env_get(env, "__sec_sink__" + name) == "1" { return true; }
    if chars_len(name) >= 12 && str_slice(name, 0, 12) == "__sec_sink__" { return true; }
    return false;
}

