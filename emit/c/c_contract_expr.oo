// # Translate contract tokens to C expression strings
//
// Logline: Maps contract token spans to valid ANSI C expression strings, lowering result and method calls.
//
// Setup: token_fmt helpers in scope; returns ERROR on unsupported residual tokens.
//
// Beats:
//   1. Map IDENT, result, and .len() calls to C expressions.
//   2. Lower numeric, boolean, string, and relational operators.
//   3. Return concatenated C expression or ERROR.



pub fn c_contract_expr(toks: List[String], start: Int, end: Int) -> String {
    let mut out = "";
let mut i = start;
while i < end { let tok = list_get(toks, i);
let k: String = field_at(tok, 0);
let v: String = field_at(tok, 3);
let mut adv: Int = 1;
if k == "IDENT" { if v == "result" { if i + 4 < end && c_tokk(toks, i + 1) == "DOT" && c_tokk(toks, i + 2) == "IDENT" && c_tokt(toks, i + 2) == "len" && c_tokk(toks, i + 3) == "LPAREN" && c_tokk(toks, i + 4) == "RPAREN" { out = out + "oo_chars_len(result) ";
adv = 5;
} else {
                    out = out + "result ";
                }
            } else {
                if i + 4 < end && c_tokk(toks, i + 1) == "DOT" && c_tokk(toks, i + 2) == "IDENT" && c_tokk(toks, i + 3) == "LPAREN" && c_tokk(toks, i + 4) == "RPAREN" {
                    let m_name: String = c_tokt(toks, i + 2);
                    if m_name == "len" {
                        out = out + "oo_chars_len(" + v + ") ";
                        adv = 5;
                    } else {
                        return "ERROR";
                    }
                } else {
                    out = out + v + " ";
                }
            }
        } else if k == "INT" || k == "FLOAT" { out = out + v + " ";
        } else if k == "STRING" { out = out + "oo_str_lit(" + v + ") ";
        } else if k == "KW_TRUE" { out = out + "1 ";
        } else if k == "KW_FALSE" { out = out + "0 ";
        } else if k == "LPAREN" { out = out + "( ";
        } else if k == "RPAREN" { out = out + ") ";
        } else if k == "LBRACK" { out = out + "[";
        } else if k == "RBRACK" { out = out + "]";
        } else if k == "DOT" { out = out + ".";
        } else if k == "COMMA" { out = out + ", ";
        } else if k == "AMP" { out = out + "& ";
        } else if k == "PIPE" { out = out + "| ";
        } else if k == "HAT" { out = out + "^ ";
        } else if k == "SHL" { out = out + "<< ";
        } else if k == "SHR" { out = out + ">> ";
        } else if k == "ANDAND" { out = out + "&& ";
        } else if k == "PIPEPIPE" || k == "OROR" { out = out + "|| ";
        } else if k == "BANG" { out = out + "! ";
        } else if k == "EQEQ" { out = out + "== ";
        } else if k == "NEQ" { out = out + "!= ";
        } else if k == "GT" { out = out + "> ";
        } else if k == "LT" { out = out + "< ";
        } else if k == "GTE" { out = out + ">= ";
        } else if k == "LTE" { out = out + "<= ";
        } else if k == "PLUS" { out = out + "+ ";
        } else if k == "MINUS" { out = out + "- ";
        } else if k == "STAR" { out = out + "* ";
        } else if k == "SLASH" { out = out + "/ ";
        } else if k == "PERCENT" { out = out + "% ";
        } else {
            return "ERROR";
        }
        i = i + adv;
    }
    return "(" + out + ")";
}
