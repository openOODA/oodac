// ──▓▓ Public C Emitter API ──▓▓──

pub fn emit_c(src: String) -> String {
    return c_emit_stream(src);
}

pub fn emit_c_stream(src: String) -> String {
    return c_emit_stream(src);
}

pub fn emit_c_headers(src: String) -> String {
    return c_emit_c_headers(src);
}

pub fn emit_c_mono(reg: List[String]) -> String {
    return c_mono_unit_emit_source(reg);
}

