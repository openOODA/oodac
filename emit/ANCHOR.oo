// # Compiler Backend Registry
//
// Logline: Same typed artifact in. C out today. A later backend does not import emit/c lowering.
//
// Setup: C is the reference backend. Residual names exit 2. Shared type names live in types/.
//
// Beats:
//   1. Import emit/c (reference) and emit/llvm (second consumer).
//   2. emit_backend consumes toks from the artifact. It does not lex.
//   3. Unknown backend names fail closed.

import "c/ANCHOR.oo";
import "llvm/ANCHOR.oo";

pub fn emit_backend(backend: String, src: String, toks: List[String], mode: String, path: String, is_plain: Bool) {
    if list_len(toks) < 1 {
        println("ERR\temit\tempty artifact");
        process_exit(1);
    }
    if backend == "c" {
        c_emit_stream_toks_at(src, toks, mode, path, is_plain);
        return;
    }
    if backend == "llvm" {
        ll_emit_stream_toks(toks);
        return;
    }
    println("ERR\temit\tresidual: " + backend);
    process_exit(2);
}
