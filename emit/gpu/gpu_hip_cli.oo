// # HIP Diagnostic Standalone CLI
//
// Logline: Emits standalone executable HIP translation units and kernels from command-line arguments.
//
// Setup: Parses CLI arguments to configure kernel emission, source lowering, and target architecture.
//
// Beats:
//   1. Parse target kernel name, operation type, and optional source file path from arguments.
//   2. Load source file with imports and lower AST into unified GpuKernelIR.
//   3. Emit complete HIP C++ kernel code with runtime headers and device function definitions.
//   4. Output generated HIP code or fail-closed error diagnostic to standard output.

import "gpu_hip.oo";

import "gpu_ast_lower.oo";

import "gpu_kernel_ir.oo";



pub fn gpu_hip_cli_main(fs: &FsReadCap, sys: &ProcessCap, args: List[String]) {
    let argc: Int = list_len(args);
    if argc == 0 { let default_code: String = hip_emit_vec_add_program("k_main");
    println(default_code);
    return;
    }
    let mut kname: String = "k_main";
    let mut op_type: String = "vec_add";
    let mut src_file: String = "";
    let mut i: Int = 0;
    while i < argc { let arg: String = list_get(args, i);
    if arg == "--help" || arg == "-h" { println("hip_cli: usage: hip_cli [--kernel <name>] [--op <type>] [<source.oo>]");
    return;
    }
        if (arg == "--kernel" || arg == "-k") && i + 1 < argc { kname = list_get(args, i + 1);
        i = i + 1;
        } else if arg == "--op" && i + 1 < argc { op_type = list_get(args, i + 1);
        i = i + 1;
        } else {
            let dash_idx: Int = str_index_of(arg, "-");
            if dash_idx != 0 {
                src_file = arg;
            }
        }
        i = i + 1;
    }
    if src_file != "" {
        let src: String = load_source_with_imports(fs, src_file);
        if chars_len(src) == 0 { println("ERR\tgpu_emit\tunreadable or empty source: " + src_file);
        process_exit(1);
        }
        let ir_res: Result[GpuKernelIR, String] = gpu_lower_source_to_ir(src, kname);
        match ir_res { Ok(ir) => { let hip_code: String = hip_emit_from_ir(ir);
        println(hip_code);
        },
            Err(e) => {
                let err_idx: Int = str_index_of(e, "ERR\tgpu_emit\t");
                if err_idx == 0 { println(e);
                } else {
                    println("ERR\tgpu_emit\t" + e);
                }
                process_exit(1);
            }
        }
        return;
    }
    if op_type == "matmul" || op_type == "gemm" {
        let matmul_code: String = hip_emit_matmul_source(kname);
        println(matmul_code);
    } else if op_type == "rms_norm" || op_type == "rmsnorm" {
        let norm_code: String = hip_emit_rms_norm_source(kname);
        println(norm_code);
    } else if op_type == "attention" || op_type == "flash_attention" {
        let attn_code: String = hip_emit_attention_source(kname);
        println(attn_code);
    } else {
        let vec_code: String = hip_emit_vec_add_program(kname);
        println(vec_code);
    }
}
