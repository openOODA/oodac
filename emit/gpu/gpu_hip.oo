// # AMD HIP and ROCm Kernel Emitter
//
// Logline: Generates HIP C++ translation units for AMD RDNA3 and CDNA3 architectures.
//
// Setup: Converts GpuKernelIR into vector, tiled LDS, AI, and stencil HIP C++ compute code.
//
// Beats:
//   1. Emit standard HIP headers, error check wrappers, and Wave32/Wave64 support macros.
//   2. Route GpuKernelIR opcodes across Vector, Tiled GEMM, AI, and Physics sub-emitters.
//   3. Implement single-kernel and full-module translation unit emitters.
//   4. Export standalone runnable test programs with bit-exact CPU validation.

import "gpu_kernel_ir.oo";

import "gpu_hip_vec.oo";

import "gpu_hip_kernels.oo";

import "gpu_hip_ai.oo";


pub fn hip_header() -> String {
    return "#include <hip/hip_runtime.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n\n";
}

pub fn hip_emit_vec_add_program(kernel_name: String) -> String {
    let mut kn: String = kernel_name;
    if kn == "" { kn = "k_add";
    }
    return hip_header() + hip_emit_vec_binop_kernel(kn, "+") + hip_emit_vec_binop_host(kn, "+");
}

pub fn hip_emit_matmul_source(kernel_name: String) -> String {
    return hip_header() + hip_emit_tiled_sgemm_kernel(kernel_name);
}

pub fn hip_emit_rms_norm_source(kernel_name: String) -> String {
    return hip_header() + hip_emit_rms_norm_wave32_kernel(kernel_name);
}

pub fn hip_emit_attention_source(kernel_name: String) -> String {
    return hip_header() + hip_emit_flash_attention_kernel(kernel_name);
}

fn hip_vec_op_from_ir(ir: GpuKernelIR) -> String {
    let ops: List[String] = ir.body_ops;
    let op_count: Int = list_len(ops);
    let mut i: Int = 0;
    while i < op_count {
        let op: String = list_get(ops, i);
        if str_index_of(op, "MUL_GLOBAL_F32") >= 0 { return "*";
        }
        if str_index_of(op, "SUB_GLOBAL_F32") >= 0 { return "-";
        }
        if str_index_of(op, "DIV_GLOBAL_F32") >= 0 { return "/";
        }
        if str_index_of(op, "ADD_GLOBAL_F32") >= 0 { return "+";
        }
        i = i + 1;
    }
    return "";
}

pub fn gpu_hip_emit_kernel(ir: GpuKernelIR) -> String {
    let ops: List[String] = ir.body_ops;
let op_count: Int = list_len(ops);
let mut i: Int = 0;
while i < op_count { let op: String = list_get(ops, i);
if str_index_of(op, "TILED_GEMM") >= 0 || str_index_of(op, "MATMUL") >= 0 { return hip_emit_tiled_sgemm_kernel(ir.name);
}
        if str_index_of(op, "DGEMM") >= 0 { return hip_emit_tiled_dgemm_kernel(ir.name);
        }
        if str_index_of(op, "RMS_NORM") >= 0 { return hip_emit_rms_norm_wave32_kernel(ir.name);
        }
        if str_index_of(op, "FLASH_ATTENTION") >= 0 { return hip_emit_flash_attention_kernel(ir.name);
        }
        if str_index_of(op, "ROPE") >= 0 { return hip_emit_rope_kernel(ir.name);
        }
        if str_index_of(op, "STENCIL_3D") >= 0 { return hip_emit_stencil_3d_kernel(ir.name);
        }
        if str_index_of(op, "PARTICLE") >= 0 { return hip_emit_particle_advection_kernel(ir.name);
        }
        if str_index_of(op, "VEC4_FMA") >= 0 { return hip_emit_vec4_fma_kernel(ir.name);
        }
        if str_index_of(op, "VEC4") >= 0 || str_index_of(op, "FLOAT4") >= 0 { return hip_emit_vec4_add_kernel(ir.name);
        }
        if str_index_of(op, "INT4") >= 0 { return hip_emit_int4_add_kernel(ir.name);
        }
        if str_index_of(op, "REDUCE_SUM") >= 0 || str_index_of(op, "DOT_PRODUCT") >= 0 { return hip_emit_reduce_sum_kernel(ir.name);
        }
        if str_index_of(op, "MUL_GLOBAL_F32") >= 0 { return hip_emit_vec_mul_kernel(ir.name);
        }
        if str_index_of(op, "SUB_GLOBAL_F32") >= 0 { return hip_emit_vec_sub_kernel(ir.name);
        }
        if str_index_of(op, "DIV_GLOBAL_F32") >= 0 { return hip_emit_vec_div_kernel(ir.name);
        }
        if str_index_of(op, "ADD_GLOBAL_F32") >= 0 { return hip_emit_vec_binop_kernel(ir.name, "+");
        }
        if str_index_of(op, "RETURN") >= 0 || str_index_of(op, "NOP") >= 0 { return hip_emit_empty_kernel(ir.name, ir.params);
        }
        i = i + 1;
    }
    return hip_emit_empty_kernel(ir.name, ir.params);
}

pub fn hip_emit_from_ir(ir: GpuKernelIR) -> String {
    let kern: String = gpu_hip_emit_kernel(ir);
let op: String = hip_vec_op_from_ir(ir);
if op != "" { return hip_header() + kern + hip_emit_vec_binop_host(ir.name, op);
}
    return hip_header() + kern;
}

pub fn gpu_hip_emit_module(kernels: List[GpuKernelIR]) -> String {
    let mut out: String = hip_header();
let k_count: Int = list_len(kernels);
let mut i: Int = 0;
while i < k_count { let ir: GpuKernelIR = list_get(kernels, i);
out = out + gpu_hip_emit_kernel(ir) + "\n";
i = i + 1;
}
    return out;
}
