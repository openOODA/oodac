// # HIP AI Acceleration Kernel Emitter
//
// Logline: Generates RMSNorm, Fused FlashAttention, and RoPE embedding kernels for ROCm.
//
// Setup: Emits Wave32 warp-shuffle parallel reduction trees, online softmax tracking, and rotary coordinate rotation.
//
// Beats:
//   1. Emit multi-warp RMSNorm kernel utilizing Wave32 __shfl_down and shared memory reduction trees.
//   2. Emit bounded Fused FlashAttention kernel with fail-closed bounds checking and online softmax.
//   3. Emit Rotary Position Embedding (RoPE) kernel for transformer token sequences.
//   4. Provide helper intrinsics for logarithmic parallel summation and attention bounds validation.

import "gpu_kernel_ir.oo";


pub fn hip_validate_attention_bounds(head_dim: Int) -> Result[Int, String] {
    if head_dim <= 0 || head_dim > 256 { return Err("ERR\tgpu_emit\thead_dim exceeds maximum 256");
    }
    return Ok(head_dim);
}

pub fn hip_emit_rms_norm_wave32_kernel(kernel_name: String) -> String {
    return "__inline__ __device__ float hip_warp_reduce_sum(float val) {\n"
        + "    val += __shfl_down(val, 16, 32);\n"
        + "    val += __shfl_down(val, 8, 32);\n"
        + "    val += __shfl_down(val, 4, 32);\n"
        + "    val += __shfl_down(val, 2, 32);\n"
        + "    val += __shfl_down(val, 1, 32);\n"
        + "    return val;\n"
        + "}\n\n"
        + "__global__ void " + kernel_name + "(const float* restrict__ x, const float* restrict__ gamma, float* restrict__ out, int batch_size, int dim, float eps) {\n"
        + "    int row = (int)blockIdx.x;\n"
        + "    if (row >= batch_size) return;\n"
        + "    int tid = (int)threadIdx.x;\n"
        + "    const float* row_x = x + (size_t)row * dim;\n"
        + "    float* row_out = out + (size_t)row * dim;\n"
        + "    float sum_sq = 0.0f;\n"
        + "    for (int i = tid; i < dim; i += blockDim.x) {\n"
        + "        float v = row_x[i];\n"
        + "        sum_sq += v * v;\n"
        + "    }\n"
        + "    __shared__ float s_warp_sums[32];\n"
        + "    int lane = tid % 32;\n"
        + "    int warp_id = tid / 32;\n"
        + "    float warp_val = hip_warp_reduce_sum(sum_sq);\n"
        + "    if (lane == 0) s_warp_sums[warp_id] = warp_val;\n"
        + "    __syncthreads();\n"
        + "    int num_warps = (blockDim.x + 31) / 32;\n"
        + "    __shared__ float s_inv_rms;\n"
        + "    if (tid < 32) {\n"
        + "        float v = (tid < num_warps) ? s_warp_sums[tid] : 0.0f;\n"
        + "        float block_sum = hip_warp_reduce_sum(v);\n"
        + "        if (tid == 0) {\n"
        + "            s_inv_rms = rsqrtf(block_sum / (float)dim + eps);\n"
        + "        }\n"
        + "    }\n"
        + "    __syncthreads();\n"
        + "    float inv_rms = s_inv_rms;\n"
        + "    for (int i = tid; i < dim; i += blockDim.x) {\n"
        + "        row_out[i] = row_x[i] * inv_rms * (gamma ? gamma[i] : 1.0f);\n"
        + "    }\n"
        + "}\n";
}

pub fn hip_emit_flash_attention_kernel(kernel_name: String) -> String {
    return "__global__ void " + kernel_name + "(const float* restrict__ q, const float* restrict__ k, const float* restrict__ v, float* restrict__ out, int seq_len, int head_dim, float scale) {\n"
        + "    int row = (int)(blockIdx.x * blockDim.x + threadIdx.x);\n"
        + "    if (row >= seq_len) return;\n"
        + "    const float* q_row = q + (size_t)row * head_dim;\n"
        + "    float* out_row = out + (size_t)row * head_dim;\n"
        + "    float m_prev = -1e30f;\n"
        + "    float l_prev = 0.0f;\n"
        + "    float acc[256];\n"
        + "    for (int d = 0; d < head_dim; d++) { acc[d] = 0.0f; }\n"
        + "    for (int j = 0; j <= row; j++) {\n"
        + "        const float* k_row = k + (size_t)j * head_dim;\n"
        + "        const float* v_row = v + (size_t)j * head_dim;\n"
        + "        float score = 0.0f;\n"
        + "        for (int d = 0; d < head_dim; d++) {\n"
        + "            score += q_row[d] * k_row[d];\n"
        + "        }\n"
        + "        score = score * scale;\n"
        + "        float m_curr = score > m_prev ? score : m_prev;\n"
        + "        float alpha = expf(m_prev - m_curr);\n"
        + "        float p = expf(score - m_curr);\n"
        + "        l_prev = l_prev * alpha + p;\n"
        + "        for (int d = 0; d < head_dim; d++) {\n"
        + "            acc[d] = acc[d] * alpha + p * v_row[d];\n"
        + "        }\n"
        + "        m_prev = m_curr;\n"
        + "    }\n"
        + "    float inv_l = l_prev > 0.0f ? 1.0f / l_prev : 0.0f;\n"
        + "    for (int d = 0; d < head_dim; d++) {\n"
        + "        out_row[d] = acc[d] * inv_l;\n"
        + "    }\n"
        + "}\n";
}

pub fn hip_emit_attention_kernel(kernel_name: String) -> String {
    return hip_emit_flash_attention_kernel(kernel_name);
}

pub fn hip_emit_rope_kernel(kernel_name: String) -> String {
    return "__global__ void " + kernel_name + "(const float* restrict__ in_vec, float* restrict__ out_vec, int seq_len, int head_dim, float theta_base) {\n"
        + "    if (head_dim <= 0 || (head_dim % 2) != 0) return;\n"
        + "    int idx = (int)(blockIdx.x * blockDim.x + threadIdx.x);\n"
        + "    int total_pairs = (seq_len * head_dim) / 2;\n"
        + "    if (idx >= total_pairs) return;\n"
        + "    int pair_idx = idx % (head_dim / 2);\n"
        + "    int token_pos = idx / (head_dim / 2);\n"
        + "    float freq = 1.0f / powf(theta_base, (float)(2 * pair_idx) / (float)head_dim);\n"
        + "    float angle = (float)token_pos * freq;\n"
        + "    float cos_a = cosf(angle);\n"
        + "    float sin_a = sinf(angle);\n"
        + "    int base_i = token_pos * head_dim + 2 * pair_idx;\n"
        + "    float v0 = in_vec[base_i];\n"
        + "    float v1 = in_vec[base_i + 1];\n"
        + "    out_vec[base_i]     = v0 * cos_a - v1 * sin_a;\n"
        + "    out_vec[base_i + 1] = v0 * sin_a + v1 * cos_a;\n"
        + "}\n";
}

pub fn hip_emit_reduce_sum_kernel(kernel_name: String) -> String {
    return "__global__ void " + kernel_name + "(const float* restrict__ in_vec, float* restrict__ out_val, int n) {\n"
        + "    int idx = (int)(blockIdx.x * blockDim.x + threadIdx.x);\n"
        + "    if (idx < n) {\n"
        + "        atomicAdd(out_val, in_vec[idx]);\n"
        + "    }\n"
        + "}\n";
}

pub fn hip_emit_simple_attention_kernel(kernel_name: String) -> String {
    return "__global__ void " + kernel_name + "(const float* restrict__ q, const float* restrict__ k, const float* restrict__ v, float* restrict__ out, int n) {\n"
        + "    int i = (int)(blockIdx.x * blockDim.x + threadIdx.x);\n"
        + "    if (i < n) {\n"
        + "        out[i] = q[i] * k[i] + v[i];\n"
        + "    }\n"
        + "}\n";
}

fn param_field_ai(s: String, idx: Int) -> String {
    let n: Int = chars_len(s);
    let mut f: Int = 0;
    let mut st: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(s, i) == ":" {
            if f == idx { return str_slice(s, st, i);
            }
            f = f + 1;
            st = i + 1;
        }
        i = i + 1;
    }
    if f == idx && st <= n { return str_slice(s, st, n);
    }
    return "";
}

pub fn hip_emit_empty_kernel(kernel_name: String, params: List[String]) -> String {
    let mut kn: String = kernel_name;
    if kn == "" { kn = "k_kernel";
    }
    let mut param_str: String = "";
    let n: Int = list_len(params);
    let mut i: Int = 0;
    while i < n {
        let p: String = list_get(params, i);
        let name: String = param_field_ai(p, 0);
        let ty: String = param_field_ai(p, 1);
        let ptr_tag: String = param_field_ai(p, 3);
        let const_tag: String = param_field_ai(p, 4);
        let mut p_decl: String = "";
        if const_tag == "const" && ptr_tag == "ptr" { p_decl = p_decl + "const ";
        }
        if ty == "float" || ty == "Float" { p_decl = p_decl + "float";
        }
        else if ty == "float4" || ty == "Float4" { p_decl = p_decl + "float4";
        }
        else if ty == "int4" || ty == "Int4" { p_decl = p_decl + "int4";
        }
        else { p_decl = p_decl + "int";
        }
        if ptr_tag == "ptr" { p_decl = p_decl + "* restrict__";
        }
        p_decl = p_decl + " " + name;
        if i > 0 { param_str = param_str + ", ";
        }
        param_str = param_str + p_decl;
        i = i + 1;
    }
    return "__global__ void " + kn + "(" + param_str + ") {\n    return;\n}\n";
}

