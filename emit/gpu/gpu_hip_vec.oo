// # HIP 128-Bit Vector Compute Emitter
//
// Logline: Generates float4 and int4 SIMT vector kernel code for AMD RDNA3 and CDNA3 architectures.
//
// Setup: Emits packed 128-bit load and store instructions with FMA acceleration.
//
// Beats:
//   1. Emit float4 elementwise addition, subtraction, multiplication, and division kernels.
//   2. Emit float4 fused multiply-add (FMA) compute kernels with restrict pointers.
//   3. Emit int4 128-bit integer vector compute kernels for high-throughput indexing.
//   4. Provide vector kernel generation dispatch based on IR opcodes.

import "gpu_kernel_ir.oo";


pub fn hip_emit_vec4_add_kernel(kernel_name: String) -> String {
    return "__global__ void " + kernel_name + "(const float4* restrict__ a, const float4* restrict__ b, float4* restrict__ c, int n_vec4) {\n"
        + "    int idx = (int)(blockIdx.x * blockDim.x + threadIdx.x);\n"
        + "    if (idx < n_vec4) {\n"
        + "        float4 va = a[idx];\n"
        + "        float4 vb = b[idx];\n"
        + "        float4 vc;\n"
        + "        vc.x = va.x + vb.x;\n"
        + "        vc.y = va.y + vb.y;\n"
        + "        vc.z = va.z + vb.z;\n"
        + "        vc.w = va.w + vb.w;\n"
        + "        c[idx] = vc;\n"
        + "    }\n"
        + "}\n";
}

pub fn hip_emit_vec4_sub_kernel(kernel_name: String) -> String {
    return "__global__ void " + kernel_name + "(const float4* restrict__ a, const float4* restrict__ b, float4* restrict__ c, int n_vec4) {\n"
        + "    int idx = (int)(blockIdx.x * blockDim.x + threadIdx.x);\n"
        + "    if (idx < n_vec4) {\n"
        + "        float4 va = a[idx];\n"
        + "        float4 vb = b[idx];\n"
        + "        float4 vc;\n"
        + "        vc.x = va.x - vb.x;\n"
        + "        vc.y = va.y - vb.y;\n"
        + "        vc.z = va.z - vb.z;\n"
        + "        vc.w = va.w - vb.w;\n"
        + "        c[idx] = vc;\n"
        + "    }\n"
        + "}\n";
}

pub fn hip_emit_vec4_mul_kernel(kernel_name: String) -> String {
    return "__global__ void " + kernel_name + "(const float4* restrict__ a, const float4* restrict__ b, float4* restrict__ c, int n_vec4) {\n"
        + "    int idx = (int)(blockIdx.x * blockDim.x + threadIdx.x);\n"
        + "    if (idx < n_vec4) {\n"
        + "        float4 va = a[idx];\n"
        + "        float4 vb = b[idx];\n"
        + "        float4 vc;\n"
        + "        vc.x = va.x * vb.x;\n"
        + "        vc.y = va.y * vb.y;\n"
        + "        vc.z = va.z * vb.z;\n"
        + "        vc.w = va.w * vb.w;\n"
        + "        c[idx] = vc;\n"
        + "    }\n"
        + "}\n";
}

pub fn hip_emit_vec4_div_kernel(kernel_name: String) -> String {
    return "__global__ void " + kernel_name + "(const float4* restrict__ a, const float4* restrict__ b, float4* restrict__ c, int n_vec4) {\n"
        + "    int idx = (int)(blockIdx.x * blockDim.x + threadIdx.x);\n"
        + "    if (idx < n_vec4) {\n"
        + "        float4 va = a[idx];\n"
        + "        float4 vb = b[idx];\n"
        + "        float4 vc;\n"
        + "        vc.x = va.x / vb.x;\n"
        + "        vc.y = va.y / vb.y;\n"
        + "        vc.z = va.z / vb.z;\n"
        + "        vc.w = va.w / vb.w;\n"
        + "        c[idx] = vc;\n"
        + "    }\n"
        + "}\n";
}

pub fn hip_emit_vec4_fma_kernel(kernel_name: String) -> String {
    return "__global__ void " + kernel_name + "(const float4* restrict__ a, const float4* restrict__ b, const float4* restrict__ bias, float4* restrict__ out, int n_vec4) {\n"
        + "    int idx = (int)(blockIdx.x * blockDim.x + threadIdx.x);\n"
        + "    if (idx < n_vec4) {\n"
        + "        float4 va = a[idx];\n"
        + "        float4 vb = b[idx];\n"
        + "        float4 vbias = bias[idx];\n"
        + "        float4 vout;\n"
        + "        vout.x = fmaf(va.x, vb.x, vbias.x);\n"
        + "        vout.y = fmaf(va.y, vb.y, vbias.y);\n"
        + "        vout.z = fmaf(va.z, vb.z, vbias.z);\n"
        + "        vout.w = fmaf(va.w, vb.w, vbias.w);\n"
        + "        out[idx] = vout;\n"
        + "    }\n"
        + "}\n";
}

pub fn hip_emit_int4_add_kernel(kernel_name: String) -> String {
    return "__global__ void " + kernel_name + "(const int4* restrict__ a, const int4* restrict__ b, int4* restrict__ c, int n_vec4) {\n"
        + "    int idx = (int)(blockIdx.x * blockDim.x + threadIdx.x);\n"
        + "    if (idx < n_vec4) {\n"
        + "        int4 va = a[idx];\n"
        + "        int4 vb = b[idx];\n"
        + "        int4 vc;\n"
        + "        vc.x = va.x + vb.x;\n"
        + "        vc.y = va.y + vb.y;\n"
        + "        vc.z = va.z + vb.z;\n"
        + "        vc.w = va.w + vb.w;\n"
        + "        c[idx] = vc;\n"
        + "    }\n"
        + "}\n";
}

pub fn hip_emit_vec_binop_kernel(kernel_name: String, op: String) -> String {
    let mut kn: String = kernel_name;
    if kn == "" { kn = "k_kernel";
    }
    return "__global__ void " + kn + "(const float* restrict__ a, const float* restrict__ b, float* restrict__ c, int n) {\n"
        + "    int i = (int)(blockIdx.x * blockDim.x + threadIdx.x);\n"
        + "    if (i < n) {\n"
        + "        c[i] = a[i] " + op + " b[i];\n"
        + "    }\n"
        + "}\n";
}

pub fn hip_emit_vec_scalar_kernel(kernel_name: String) -> String {
    return hip_emit_vec_binop_kernel(kernel_name, "+");
}

pub fn hip_emit_vec_mul_kernel(kernel_name: String) -> String {
    return hip_emit_vec_binop_kernel(kernel_name, "*");
}

pub fn hip_emit_vec_sub_kernel(kernel_name: String) -> String {
    return hip_emit_vec_binop_kernel(kernel_name, "-");
}

pub fn hip_emit_vec_div_kernel(kernel_name: String) -> String {
    return hip_emit_vec_binop_kernel(kernel_name, "/");
}

pub fn hip_emit_vec_binop_host(kernel_name: String, op: String) -> String {
    let mut kn: String = kernel_name;
    if kn == "" { kn = "k_kernel";
    }
    let mut tag: String = "hip_vec_add";
    if op == "*" { tag = "hip_vec_mul";
    }
    if op == "-" { tag = "hip_vec_sub";
    }
    if op == "/" { tag = "hip_vec_div";
    }
    return "static void hip_ck(hipError_t e, const char* w) {\n"
        + "    if (e != hipSuccess) { fprintf(stderr, \"ERR\\thip\\t%s\\t%s\\n\", w, hipGetErrorString(e)); exit(1); }\n"
        + "}\n"
        + "int main(void) {\n"
        + "    const int n = 64;\n"
        + "    size_t bytes = (size_t)n * sizeof(float);\n"
        + "    float *ha = (float*)malloc(bytes); float *hb = (float*)malloc(bytes); float *hc = (float*)malloc(bytes);\n"
        + "    int i;\n"
        + "    if (!ha || !hb || !hc) { fprintf(stderr, \"ERR\\thip\\thost_alloc\\n\"); return 1; }\n"
        + "    for (i = 0; i < n; i++) { ha[i] = (float)(i + 1); hb[i] = 2.0f; hc[i] = 0.0f; }\n"
        + "    float *da = 0; float *db = 0; float *dc = 0;\n"
        + "    hip_ck(hipMalloc((void**)&da, bytes), \"malloc_a\");\n"
        + "    hip_ck(hipMalloc((void**)&db, bytes), \"malloc_b\");\n"
        + "    hip_ck(hipMalloc((void**)&dc, bytes), \"malloc_c\");\n"
        + "    hip_ck(hipMemcpy(da, ha, bytes, hipMemcpyHostToDevice), \"h2d_a\");\n"
        + "    hip_ck(hipMemcpy(db, hb, bytes, hipMemcpyHostToDevice), \"h2d_b\");\n"
        + "    hipLaunchKernelGGL(" + kn + ", dim3((unsigned)((n + 63) / 64), 1, 1), dim3(64, 1, 1), 0, 0, da, db, dc, n);\n"
        + "    hip_ck(hipGetLastError(), \"launch\");\n"
        + "    hip_ck(hipDeviceSynchronize(), \"sync\");\n"
        + "    hip_ck(hipMemcpy(hc, dc, bytes, hipMemcpyDeviceToHost), \"d2h\");\n"
        + "    int bad = 0;\n"
        + "    for (i = 0; i < n; i++) { if (hc[i] != (ha[i] " + op + " hb[i])) bad = bad + 1; }\n"
        + "    (void)hipFree(da); (void)hipFree(db); (void)hipFree(dc); free(ha); free(hb); free(hc);\n"
        + "    if (bad != 0) { printf(\"%s: FAIL mismatches=%d\\n\", \"" + tag + "\", bad); return 1; }\n"
        + "    printf(\"%s: MATCH n=%d gfx1100\\n\", \"" + tag + "\", n); return 0;\n"
        + "}\n";
}
