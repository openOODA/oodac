// # Compiler Backend Registry
//
// Logline: Same typed artifact in. LLVM IR out. Residual backends exit 2.
//
// Setup: LLVM is the only backend. Shared type names live in types/.
//
// Beats:
//   1. Import emit/llvm. C emit is gone.
//   2. emit_backend consumes toks from the artifact. It does not lex.
//   3. Unknown backend names fail closed.

import "llvm/anchor.oo";

pub fn emit_backend(backend: String, src: String, toks: List[String], mode: String, path: String, is_plain: Bool) {
    let mut n: Int = 0;
    n = list_len(toks);
    if n < 1 {
        println("ERR\temit\tempty artifact");
        process_exit(1);
    }
    if backend == "llvm" || backend == "" {
        ll_emit_stream_toks(toks);
        return;
    }
    println("ERR\temit\tresidual: " + backend);
    process_exit(2);
}
