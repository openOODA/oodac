// # AArch64 first-fn struct library GAS
//
// Logline: Lowers a first-fn struct constructor or 4-wide NEON binop to AAPCS64 GAS.
//
// Setup: tokenize_lines, a64_tok_k, a64_tok_t. Heap via _oo_heap_alloc. Not xzr stubs.
//
// Beats:
//   1. Vec4f a.x OP b.x ... is fadd/fsub/fmul/fdiv v0.4s.
//   2. Struct { fields } allocates n*8 and stores literals, bools, params, list_new.
//   3. Empty string when the first return is not a struct literal.


import "aarch64_emit_const_harvest.oo";


fn a64_st_head(nm: String) -> String {
    return "    .text\n    .globl " + nm + "\n    .p2align 2\n" + nm + ":\n";
}

fn a64_st_fn_end(toks: List[String], n: Int, i: Int) -> Int {
    let mut p: Int = i;
    while p < n && a64_tok_k(toks, p) != "LBRACE" { p = p + 1;
    }
    let mut d: Int = 0;
    while p < n {
        if a64_tok_k(toks, p) == "LBRACE" { d = d + 1;
        }
        if a64_tok_k(toks, p) == "RBRACE" {
            d = d - 1;
            if d == 0 { return p;
            }
        }
        p = p + 1;
    }
    return p;
}

fn a64_st_has(toks: List[String], a: Int, b: Int, text: String) -> Bool {
    let mut i: Int = a;
    while i < b {
        if a64_tok_t(toks, i) == text { return true;
        }
        i = i + 1;
    }
    return false;
}

fn a64_st_neon(nm: String, toks: List[String], ri: Int, n: Int) -> String {
    if ri + 8 >= n { return "";
    }
    if a64_tok_k(toks, ri + 1) != "IDENT" || a64_tok_k(toks, ri + 2) != "LBRACE" { return "";
    }
    let mut p: Int = ri + 3;
    if p + 6 >= n { return "";
    }
    if a64_tok_k(toks, p) != "IDENT" { return "";
    }
    p = p + 1;
    if a64_tok_k(toks, p) == "COLON" { p = p + 1;
    }
    if a64_tok_k(toks, p) != "IDENT" || a64_tok_k(toks, p + 1) != "DOT" { return "";
    }
    let op: String = a64_tok_k(toks, p + 3);
    if op != "PLUS" && op != "MINUS" && op != "STAR" && op != "SLASH" { return "";
    }
    let mut ins: String = "fadd";
    if op == "MINUS" { ins = "fsub";
    }
    if op == "STAR" { ins = "fmul";
    }
    if op == "SLASH" { ins = "fdiv";
    }
    return a64_st_head(nm) + "    " + ins + " v0.4s, v0.4s, v1.4s\n    ret\n";
}

pub fn aarch64_emit_lib_struct(src: String) -> String {
    let toks: List[String] = tokenize_lines(src);
let n: Int = list_len(toks);
let mut fi: Int = -1;
let mut i: Int = 0;
while i + 1 < n { if a64_tok_k(toks, i) == "KW_FN" && a64_tok_k(toks, i + 1) == "IDENT" { fi = i;
i = n;
} else { i = i + 1;
}
    }
    if fi < 0 { return "";
    }
    let nm: String = a64_tok_t(toks, fi + 1);
    if nm == "main" { return "";
    }
    let en: Int = a64_st_fn_end(toks, n, fi);
    let mut ri: Int = -1;
    i = fi;
    while i < en {
        if a64_tok_k(toks, i) == "KW_RETURN" { ri = i;
        i = en;
        } else { i = i + 1;
        }
    }
    if ri < 0 { return "";
    }
    let neon: String = a64_st_neon(nm, toks, ri, n);
    if chars_len(neon) > 0 { return neon;
    }
    if a64_tok_k(toks, ri + 1) != "IDENT" || a64_tok_k(toks, ri + 2) != "LBRACE" { return "";
    }
    let mut p0: String = "";
    i = fi;
    while i < en { if a64_tok_k(toks, i) == "LPAREN" && i + 1 < n && a64_tok_k(toks, i + 1) == "IDENT" { p0 = a64_tok_t(toks, i + 1);
    i = en;
    } else { i = i + 1;
    }
    }
    let mut kinds: List[String] = list_new();
    let mut vals: List[String] = list_new();
    let mut p: Int = ri + 3;
    while p < en && a64_tok_k(toks, p) != "RBRACE" {
        if a64_tok_k(toks, p) == "IDENT" && p + 1 < n && a64_tok_k(toks, p + 1) == "COLON" {
            p = p + 2;
            let kk: String = a64_tok_k(toks, p);
            let tt: String = a64_tok_t(toks, p);
            kinds = list_push(kinds, kk);
            vals = list_push(vals, tt);
            p = p + 1;
            if p < n && a64_tok_k(toks, p) == "LPAREN" {
                while p < en && a64_tok_k(toks, p) != "RPAREN" { p = p + 1;
                }
            }
        } else { p = p + 1;
        }
    }
    let nf: Int = list_len(kinds);
    if nf <= 0 { return "";
    }
    let sz: Int = nf * 8;
    let mut s: String = a64_st_head(nm);
    s = s + "    stp x29, x30, [sp, #-32]!\n    mov x29, sp\n";
    if a64_st_has(toks, fi, en, "list_new") {
        s = s + "    bl list_new\n";
        if a64_st_has(toks, fi, en, "list_push") {
            s = s + "    mov x1, #0\n    bl list_push\n";
        }
        s = s + "    mov x19, x0\n";
    }
    let mut ro: String = "";
    let mut fc: Int = 0;
    i = 0;
    while i < nf { if list_get(kinds, i) == "FLOAT" { ro = ro + ".Lf" + nm + fc.to_string() + ":\n    .double " + list_get(vals, i) + "\n";
    fc = fc + 1;
    }
        i = i + 1;
    }
    if chars_len(ro) > 0 { s = "    .section .rodata\n    .p2align 3\n" + ro + s;
    }
    s = s + "    mov x0, #" + sz.to_string() + "\n    bl _oo_heap_alloc\n    mov x20, x0\n";
    fc = 0;
    i = 0;
    while i < nf { let off: String = (i * 8).to_string();
    let kk: String = list_get(kinds, i);
    let tt: String = list_get(vals, i);
    if kk == "KW_FALSE" || tt == "false" { s = s + "    str xzr, [x20, #" + off + "]\n";
    } else if kk == "KW_TRUE" || tt == "true" {
            s = s + "    mov x1, #1\n    str x1, [x20, #" + off + "]\n";
        } else if kk == "INT" {
            s = s + "    mov x1, #" + tt + "\n    str x1, [x20, #" + off + "]\n";
        } else if kk == "FLOAT" {
            s = s + "    adrp x1, .Lf" + nm + fc.to_string() + "\n    add x1, x1, :lo12:.Lf" + nm + fc.to_string() + "\n    ldr x1, [x1]\n    str x1, [x20, #" + off + "]\n";
            fc = fc + 1;
        } else if kk == "IDENT" {
            if tt == p0 { s = s + "    str x0, [x20, #" + off + "]\n";
            } else {
                s = s + "    str x19, [x20, #" + off + "]\n";
            }
        } else {
            s = s + "    str xzr, [x20, #" + off + "]\n";
        }
        i = i + 1;
    }
    s = s + "    mov x0, x20\n    ldp x29, x30, [sp], #32\n    ret\n";
    return s;
}
