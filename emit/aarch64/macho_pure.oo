// # Pure In-Process Mach-O 64-bit Binary Packager
//
// Logline: Builds a 64-bit MH_EXECUTE image with LC_SEGMENT_64 text coverage and LC_MAIN bound to _start.
//
// Setup: Pure byte transform. Caller supplies machine-code bytes. No GNU as or ld. No ambient I/O.
//
// Beats:
//   1. Encode MH_MAGIC_64 header with MH_EXECUTE filetype and architecture CPU type.
//   2. Emit LC_SEGMENT_64 for __PAGEZERO and __TEXT, with a __text section holding the payload.
//   3. Bind LC_MAIN entryoff to _start at the text file offset.
//   4. Fail closed on empty text.

import "types/byte_out.oo";

fn mp_le32(b: List[Int], v: Int) -> List[Int] {
    let mut o: List[Int] = list_push(b, v & 255);
    o = list_push(o, (v / 256) & 255);
    o = list_push(o, (v / 65536) & 255);
    return list_push(o, (v / 16777216) & 255);
}

fn mp_le64(b: List[Int], v: Int) -> List[Int] {
    let mut o: List[Int] = b;
    let mut x: Int = v;
    let mut i: Int = 0;
    while i < 8 { o = list_push(o, x & 255);
    x = x / 256;
    i = i + 1;
    }
    return o;
}

fn mp_name16(b: List[Int], s: String) -> List[Int] {
    let slen: Int = chars_len(s);
    let mut o: List[Int] = b;
    let mut i: Int = 0;
    while i < 16 { if i < slen { o = list_push(o, byte_at(s, i));
    } else {
            o = list_push(o, 0);
        }
        i = i + 1;
    }
    return o;
}

fn mp_cat(a: List[Int], src: List[Int]) -> List[Int] {
    let n: Int = list_len(src);
    let mut o: List[Int] = a;
    let mut i: Int = 0;
    while i < n { o = list_push(o, list_get(src, i) & 255);
    i = i + 1;
    }
    return o;
}



pub fn macho_pure_cputype_arm64() -> Int {
    return 16777228;
}

pub fn macho_pure_cputype_x86_64() -> Int {
    return 16777223;
}

pub fn macho_pure_text_off() -> Int {
    return 280;
}

pub fn macho_pure_base_vaddr() -> Int {
    return 4294967296;
}

fn mp_header(cputype: Int, ncmds: Int, sizeofcmds: Int) -> List[Int] {
    let mut b: List[Int] = list_new();
    b = list_push(b, 207);
    b = list_push(b, 250);
    b = list_push(b, 237);
    b = list_push(b, 254);
    b = mp_le32(b, cputype);
    let mut sub: Int = 0;
    if cputype == 16777223 { sub = 3;
    }
    b = mp_le32(b, sub);
    b = mp_le32(b, 2);
    b = mp_le32(b, ncmds);
    b = mp_le32(b, sizeofcmds);
    b = mp_le32(b, 1);
    b = mp_le32(b, 0);
    return b;
}

fn mp_pagezero() -> List[Int] {
    let mut b: List[Int] = list_new();
    b = mp_le32(b, 25);
    b = mp_le32(b, 72);
    b = mp_name16(b, "__PAGEZERO");
    b = mp_le64(b, 0);
    b = mp_le64(b, 4294967296);
    b = mp_le64(b, 0);
    b = mp_le64(b, 0);
    b = mp_le32(b, 0);
    b = mp_le32(b, 0);
    b = mp_le32(b, 0);
    b = mp_le32(b, 0);
    return b;
}

fn mp_text_seg(code_off: Int, code_len: Int, file_sz: Int) -> List[Int] {
    let base: Int = 4294967296;
    let vmsz: Int = ((file_sz + 4095) / 4096) * 4096;
    let mut b: List[Int] = list_new();
    b = mp_le32(b, 25);
    b = mp_le32(b, 152);
    b = mp_name16(b, "__TEXT");
    b = mp_le64(b, base);
    b = mp_le64(b, vmsz);
    b = mp_le64(b, 0);
    b = mp_le64(b, file_sz);
    b = mp_le32(b, 7);
    b = mp_le32(b, 5);
    b = mp_le32(b, 1);
    b = mp_le32(b, 0);
    b = mp_name16(b, "__text");
    b = mp_name16(b, "__TEXT");
    b = mp_le64(b, base + code_off);
    b = mp_le64(b, code_len);
    b = mp_le32(b, code_off);
    b = mp_le32(b, 2);
    b = mp_le32(b, 0);
    b = mp_le32(b, 0);
    b = mp_le32(b, 2147484672);
    b = mp_le32(b, 0);
    b = mp_le32(b, 0);
    b = mp_le32(b, 0);
    return b;
}

fn mp_main(entryoff: Int) -> List[Int] {
    let mut b: List[Int] = list_new();
    b = mp_le32(b, 2147483688);
    b = mp_le32(b, 24);
    b = mp_le64(b, entryoff);
    b = mp_le64(b, 0);
    return b;
}

pub fn macho_pure_package_cputype(cputype: Int, code: List[Int]) -> ByteOut {
    let n: Int = list_len(code);
if n == 0 { return byte_out_err("macho_pure: empty text");
}
    let ncmds: Int = 3;
    let sizeofcmds: Int = 248;
    let code_off: Int = 280;
    let file_sz: Int = code_off + n;
    let mut img: List[Int] = mp_header(cputype, ncmds, sizeofcmds);
    img = mp_cat(img, mp_pagezero());
    img = mp_cat(img, mp_text_seg(code_off, n, file_sz));
    img = mp_cat(img, mp_main(code_off));
    img = mp_cat(img, code);
    return byte_out_ok(img);
}

pub fn macho_pure_package(code: List[Int]) -> ByteOut {
    return macho_pure_package_cputype(16777228, code);
}

pub fn macho_pure_write(fs: &FsWriteCap, path: String, img: List[Int]) -> Result[Int, String] {
    if path == "" {
        return Err("macho_pure: empty path");
    }
    if list_len(img) == 0 { return Err("macho_pure: empty image");
    }
    let binary: String = bytes_to_str(img);
    let r: Result[Void, String] = write_file(fs, path, binary);
    match r { Ok(_) => { return Ok(list_len(img));
    }
        Err(e) => {
            return Err(e);
        }
    }
}
