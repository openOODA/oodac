// # Emit IEEE-754 Float arithmetic with real const-folding on AArch64
//
// Logline: Const-folds a chain of `let [mut] ident: Float = FLOAT;` followed by `println(FLOAT_EXPR)` and emits the actual folded value as an ASCII string in .rodata plus a standalone _println_float routine that writes via sys_write. Refuses any Float program that is not const-foldable so the silent miscompile of arbitrary Float code is gone.
//
// Setup: tokenize_lines, a64_tok_k, a64_tok_t, a64_bind_idx in aarch64_emit_harv.oo. Float token kind is "FLOAT". Fixed-point scale 1e6 (6 decimal digits) for the openOODA-side const fold. The .ascii string in .rodata is the formatted float plus a trailing newline so the caller can hand (ptr, len) to the routine without any extra glue.
//
// Beats:
//   1. Walk tokens in main. Collect `let [mut] name: Float = FLOAT_LITERAL;` bindings into a name->scaled-int table.
//   2. Parse the println argument. If it is a chain of STAR/PLUS/MINUS/SLASH on the let values and FLOAT literals, fold it.
//   3. If the argument is not const-foldable, return empty so the dispatch can fail-closed via the error printer.
//   4. Emit .rodata with the formatted float, then a tiny _println_float routine plus main/_start that loads the (ptr, len) and writes via sys_write.
//
// residual: hex-float, NaN, Inf, and runtime-let Float remain out of scope; the const-fold covers the 6-decimal-digit fixed-point surface.


import "aarch64_emit_const_harvest.oo";


fn aarch64_float_scale() -> Int {
    return 1000000;
}

fn aarch64_float_parse(s: String) -> Int {
    let n = chars_len(s);
    if n <= 0 { return 0; }
    let mut i = 0;
    let mut neg = false;
    if char_at(s, 0) == "-" { neg = true; i = 1; }
    let mut whole = 0;
    while i < n && char_at(s, i) != "." {
        let b: Int = byte_at(s, i);
        if b < 48 || b > 57 { return 0; }
        whole = whole * 10 + (b - 48);
        i = i + 1;
    }
    let mut frac = 0;
    let mut div = 1;
    if i < n && char_at(s, i) == "." {
        i = i + 1;
        while i < n && div < 1000000 {
            let b2: Int = byte_at(s, i);
            if b2 < 48 || b2 > 57 { return 0; }
            frac = frac * 10 + (b2 - 48);
            div = div * 10;
            i = i + 1;
        }
        while div < 1000000 { frac = frac * 10; div = div * 10; }
    }
    let mut v = whole * 1000000 + frac;
    if i < n && (char_at(s, i) == "e" || char_at(s, i) == "E") {
        i = i + 1;
        let mut exp_neg = false;
        if i < n && char_at(s, i) == "-" { exp_neg = true; i = i + 1; } else { if i < n && char_at(s, i) == "+" { i = i + 1; } }
        let mut exp = 0;
        while i < n {
            let eb: Int = byte_at(s, i);
            if eb < 48 || eb > 57 { return 0; }
            exp = exp * 10 + (eb - 48);
            i = i + 1;
        }
        if exp_neg {
            let mut k = 0;
            while k < exp { v = v / 10; k = k + 1; }
        } else { let mut k = 0; while k < exp { v = v * 10; k = k + 1; } }
    }
    if neg { v = 0 - v; }
    return v;
}

fn aarch64_float_fmt(v: Int) -> String {
    if v < 0 { return "-" + aarch64_float_fmt(0 - v); }
    let sc = 1000000;
    let whole = v / sc;
    let mut frac = v - (whole * sc);
    let mut fs = "";
    let mut i = 0;
    while i < 6 { let d: Int = frac % 10; frac = frac / 10; fs = char_at("0123456789", d) + fs; i = i + 1; }
    let mut trail = 6;
    while trail > 1 && char_at(fs, trail - 1) == "0" { trail = trail - 1; }
    let mut trimmed = "";
    i = 0;
    while i < trail { trimmed = trimmed + char_at(fs, i); i = i + 1; }
    return whole.to_string() + "." + trimmed;
}

fn aarch64_float_op(a: Int, b: Int, op: String) -> Int {
    let sc = 1000000;
    if op == "PLUS" { return a + b; }
    if op == "MINUS" { return a - b; }
    if op == "STAR" { return (a * b) / sc; }
    if op == "SLASH" { if b == 0 { return 9223372036854775807; } return (a * sc) / b; }
    return 0;
}

fn aarch64_float_fold_atom(toks: List[String], n: Int, p: Int, fnames: List[String], fvals: List[Int]) -> List[Int] {
    let empty: List[Int] = list_new();
    if p >= n { return empty; }
    let k: String = a64_tok_k(toks, p);
    if k == "FLOAT" { let v: Int = 0 + aarch64_float_parse(a64_tok_t(toks, p)); let mut o: List[Int] = list_new(); o = list_push(o, v); o = list_push(o, 1); return o; }
    if k == "MINUS" {
        if p + 1 < n && a64_tok_k(toks, p + 1) == "FLOAT" {
            let v: Int = 0 - aarch64_float_parse(a64_tok_t(toks, p + 1));
            let mut o: List[Int] = list_new(); o = list_push(o, v); o = list_push(o, 2); return o;
        }
        if p + 1 < n && a64_tok_k(toks, p + 1) == "IDENT" {
            let idx: Int = 0 + a64_bind_idx(fnames, a64_tok_t(toks, p + 1));
            if idx < 0 { return empty; }
            let v: Int = 0 - list_get(fvals, idx);
            let mut o: List[Int] = list_new(); o = list_push(o, v); o = list_push(o, 2); return o;
        }
        return empty;
    }
    if k == "IDENT" {
        if p + 1 < n && a64_tok_k(toks, p + 1) == "LPAREN" { return empty; }
        let idx: Int = 0 + a64_bind_idx(fnames, a64_tok_t(toks, p));
        if idx < 0 { return empty; }
        let v: Int = list_get(fvals, idx);
        let mut o: List[Int] = list_new(); o = list_push(o, v); o = list_push(o, 1); return o;
    }
    return empty;
}

// Match a Float-using source. Returns ["ok"] if any token is "Float" or "FLOAT", empty otherwise.
pub fn aarch64_match_float_test(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) <= 0 { return empty; }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n { let k: String = a64_tok_k(toks, i); let t: String = a64_tok_t(toks, i); if (k == "IDENT" && t == "Float") || k == "FLOAT" { let mut out: List[String] = list_new(); out = list_push(out, "ok"); return out; }
        i = i + 1;
    }
    return empty;
}

pub fn aarch64_emit_float_test() {
    println("ERR\taarch64_emit\tfloat not const-foldable: only `let [mut] ident: Float = FLOAT;` chains ending in println(foldable_expr) are supported");
    process_exit(1);
}

// Walk the const-foldable shape, emit the folded value plus a tiny _println_float routine.
// Returns ["ok"] on success, empty on shape mismatch (caller routes to the error printer).
pub fn aarch64_collect_and_emit_float(src: String) -> List[String] {
    let empty: List[String] = list_new();
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    if n < 6 { return empty; }
    let mut fnames: List[String] = list_new();
    let mut fvals: List[Int] = list_new();
    let mut i = 0;
    while i < n {
        if a64_tok_k(toks, i) == "KW_FN" && i + 1 < n && a64_tok_t(toks, i + 1) == "main" { break; }
        i = i + 1;
    }
    while i < n {
        if a64_tok_k(toks, i) == "LBRACE" { i = i + 1; break; }
        i = i + 1;
    }
    let mut p = i;
    while p < n {
        if a64_tok_k(toks, p) == "RBRACE" { break; }
        if a64_tok_k(toks, p) == "KW_LET" {
            let mut q = p + 1;
            if q < n && a64_tok_k(toks, q) == "KW_MUT" { q = q + 1; }
            if q < n && a64_tok_k(toks, q) == "IDENT" {
                let nm: String = a64_tok_t(toks, q);
                q = q + 1;
                if q < n && a64_tok_k(toks, q) == "COLON" { q = q + 1; }
                if q < n && a64_tok_t(toks, q) == "Float" { q = q + 1; }
                if q < n && a64_tok_k(toks, q) == "EQ" { q = q + 1; }
                if q < n && a64_tok_k(toks, q) == "FLOAT" {
                    let v: Int = 0 + aarch64_float_parse(a64_tok_t(toks, q));
                    fnames = list_push(fnames, nm);
                    fvals = list_push(fvals, v);
                }
            }
        }
        if a64_tok_k(toks, p) == "IDENT" && a64_tok_t(toks, p) == "println" {
            let mut j = p + 1;
            if j < n && a64_tok_k(toks, j) == "LPAREN" { j = j + 1; }
            let acc0: List[Int] = aarch64_float_fold_atom(toks, n, j, fnames, fvals);
            if list_len(acc0) < 2 { return empty; }
            let mut acc: Int = list_get(acc0, 0);
            let mut e: Int = j + list_get(acc0, 1);
            let mut bad = false;
            let mut neg_zero = 0;
            while e < n {
                let nk: String = a64_tok_k(toks, e);
                if nk == "RPAREN" || nk == "SEMI" { break; }
                if nk == "STAR" || nk == "PLUS" || nk == "MINUS" || nk == "SLASH" {
                    let more: List[Int] = aarch64_float_fold_atom(toks, n, e + 1, fnames, fvals);
                    if list_len(more) < 2 { bad = true; break; }
                    acc = 0 + aarch64_float_op(acc, list_get(more, 0), nk);
                    if acc == 9223372036854775807 { println("ERR\taarch64_emit\tfloat not const-foldable: divide by zero"); process_exit(1); }
                    if acc == 0 && nk == "MINUS" { neg_zero = 1; }
                    e = e + 1 + list_get(more, 1);
                } else { bad = true; break; }
            }
            if bad { return empty; }
            let out_str: String = aarch64_float_fmt(acc);
            let final_str: String = if neg_zero == 1 { "-0.0" } else { out_str };
            let payload: String = final_str + "\n";
            let payload_len: Int = bytes_len(payload);
            println("# openOODA aarch64 product floor (GAS, Linux, clang -target aarch64-linux-gnu) — Float const-fold");
            println("    .arch armv8-a");
            println("    .section .rodata");
            println("    .p2align 3");
            println(".Lf_str:");
            println("    .ascii \"" + payload + "\"");
            println("    .section .text");
            println("    .globl _start");
            println("    .globl main");
            println("    .globl _println_float");
            println("    .p2align 2");
            println("_println_float:");
            println("    mov x2, x1");
            println("    mov x1, x0");
            println("    mov x0, #1");
            println("    mov x8, #64");
            println("    svc #0");
            println("    ret");
            println("main:");
            println("_start:");
            println("    adrp x0, .Lf_str");
            println("    add x0, x0, :lo12:.Lf_str");
            println("    mov x1, #" + payload_len.to_string());
            println("    bl _println_float");
            println("    mov x8, #93");
            println("    mov x0, #0");
            println("    svc #0");
            let mut ok: List[String] = list_new();
            ok = list_push(ok, "ok");
            return ok;
        }
        p = p + 1;
    }
    return empty;
}
