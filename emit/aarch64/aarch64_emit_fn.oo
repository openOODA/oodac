// # Emit one-arg AAPCS64 identity String call
//
// Logline: Matches identity String passthrough plus println(fn(STRING)) and emits an x0-based call plus svc write and svc exit.
//
// Setup: tokenize_lines, a64_tok_k, a64_tok_t, and aarch64_ascii_esc exist. Fold already missed.
//
// Beats:
//   1. Find one fn whose body is return of its String param.
//   2. Require main to be only println of that fn on a STRING.
//   3. Emit identity mov x0,x0; caller adrp/add of .Lstr, bl fn, svc write, svc exit.
//
// residual: Int args, 2+arg, and stack spills stay later.


import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_sys.oo";


fn aarch64_id_shape(toks: List[String], n: Int, i: Int) -> List[String] {
    let empty: List[String] = list_new();
    if i + 12 >= n { return empty;
    }
    if a64_tok_k(toks, i) != "KW_FN" {
        return empty;
    }
    if a64_tok_k(toks, i + 1) != "IDENT" {
        return empty;
    }
    let nm: String = a64_tok_t(toks, i + 1);
    if nm == "main" {
        return empty;
    }
    if a64_tok_k(toks, i + 2) != "LPAREN" {
        return empty;
    }
    if a64_tok_k(toks, i + 3) != "IDENT" {
        return empty;
    }
    let pn: String = a64_tok_t(toks, i + 3);
    if a64_tok_k(toks, i + 4) != "COLON" {
        return empty;
    }
    if a64_tok_k(toks, i + 5) != "IDENT" {
        return empty;
    }
    if a64_tok_t(toks, i + 5) != "String" {
        return empty;
    }
    if a64_tok_k(toks, i + 6) != "RPAREN" {
        return empty;
    }
    if a64_tok_k(toks, i + 7) != "ARROW" {
        return empty;
    }
    if a64_tok_k(toks, i + 8) != "IDENT" {
        return empty;
    }
    if a64_tok_t(toks, i + 8) != "String" {
        return empty;
    }
    if a64_tok_k(toks, i + 9) != "LBRACE" {
        return empty;
    }
    if a64_tok_k(toks, i + 10) != "KW_RETURN" {
        return empty;
    }
    if a64_tok_k(toks, i + 11) != "IDENT" {
        return empty;
    }
    if a64_tok_t(toks, i + 11) != pn { return empty;
    }
    let mut p = i + 12;
    if p < n && a64_tok_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || a64_tok_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, nm);
    o = list_push(o, pn);
    return o;
}

fn aarch64_id_main_body(toks: List[String], n: Int, i: Int, fname: String) -> List[String] {
    let empty: List[String] = list_new();
    if i + 12 >= n { return empty;
    }
    if a64_tok_k(toks, i + 2) != "LPAREN" {
        return empty;
    }
    if a64_tok_k(toks, i + 3) != "RPAREN" {
        return empty;
    }
    if a64_tok_k(toks, i + 4) != "LBRACE" {
        return empty;
    }
    if a64_tok_k(toks, i + 5) != "IDENT" {
        return empty;
    }
    if a64_tok_t(toks, i + 5) != "println" {
        return empty;
    }
    if a64_tok_k(toks, i + 6) != "LPAREN" {
        return empty;
    }
    if a64_tok_k(toks, i + 7) != "IDENT" {
        return empty;
    }
    if a64_tok_t(toks, i + 7) != fname { return empty;
    }
    if a64_tok_k(toks, i + 8) != "LPAREN" {
        return empty;
    }
    if a64_tok_k(toks, i + 9) != "STRING" {
        return empty;
    }
    let arg: String = a64_tok_t(toks, i + 9);
    if a64_tok_k(toks, i + 10) != "RPAREN" {
        return empty;
    }
    if a64_tok_k(toks, i + 11) != "RPAREN" {
        return empty;
    }
    let mut p = i + 12;
    if p < n && a64_tok_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || a64_tok_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, fname);
    o = list_push(o, arg);
    return o;
}

pub fn aarch64_match_id_call(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) <= 0 { return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut fname = "";
    let mut i = 0;
    while i < n { if a64_tok_k(toks, i) == "KW_FN" { if i + 1 >= n || a64_tok_k(toks, i + 1) != "IDENT" { return empty;
    }
            let nm: String = a64_tok_t(toks, i + 1);
            if nm != "main" {
                let idn: List[String] = aarch64_id_shape(toks, n, i);
                if list_len(idn) < 2 { return empty;
                }
                if chars_len(fname) > 0 { return empty;
                }
                fname = list_get(idn, 0);
            }
        }
        i = i + 1;
    }
    if chars_len(fname) <= 0 { return empty;
    }
    let mut found: List[String] = list_new();
    i = 0;
    while i < n { if a64_tok_k(toks, i) == "KW_FN" { if i + 1 < n && a64_tok_k(toks, i + 1) == "IDENT" { if a64_tok_t(toks, i + 1) == "main" { if list_len(found) >= 1 { return empty;
    }
                    found = aarch64_id_main_body(toks, n, i, fname);
                    if list_len(found) < 2 { return empty;
                    }
                }
            }
        }
        i = i + 1;
    }
    return found;
}

pub fn aarch64_emit_id_call(fname: String, arg: String) {
    let ln = chars_len(arg) + 1;
    println("# openOODA aarch64 product floor (GAS, Linux, clang -target aarch64-linux-gnu)");
    println("    .arch armv8-a");
    println("    .section .rodata");
    println("    .p2align 3");
    println(".Lstr0:");
    println("    .ascii \"" + aarch64_ascii_esc(arg) + "\\n\"");
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    println("    .globl " + fname);
    println("    .p2align 2");
    println(fname + ":");
    println("    stp x29, x30, [sp, #-16]!");
    println("    mov x29, sp");
    println("    mov x0, x0");
    println("    ldp x29, x30, [sp], #16");
    println("    ret");
    println("main:");
    println("_start:");
    println("    stp x29, x30, [sp, #-16]!");
    println("    mov x29, sp");
    println("    adrp x0, .Lstr0");
    println("    add x0, x0, :lo12:.Lstr0");
    println("    bl " + fname);
    println("    mov x1, x0");
    println("    mov x8, #64");
    println("    mov x0, #1");
    println("    mov x2, #" + ln.to_string());
    println("    svc #0");
    println("    mov x8, #93");
    println("    mov x0, #0");
    println("    svc #0");
}
