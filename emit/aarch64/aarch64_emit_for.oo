// # Emit native for-range loop for AArch64
//
// Logline: Lowers `for IDENT in 0..N { BODY }` to a while loop with x9-backed counter, single comparison, body stmts, and backward jmp. Each iteration prints the body messages in order.
//
// Setup: tokenize_lines, a64_tok_k, a64_tok_t exist in aarch64_emit_harv.oo; aarch64_emit_while_loop exists in aarch64_emit_loop.oo.
//
// Beats:
//   1. Match `for IDENT in 0..INT_LIT { BODY }`. The lo bound must be the literal 0; the hi bound must be an INT literal.
//   2. BODY is 0..N `println(STRING);` stmts in any order. Empty body is allowed.
//   3. Refuse-don't-miscompile: missing `for`, non-zero lo, non-literal hi, no `..`, body containing KW_FOR/KW_MATCH, or non-println stmt — return empty.
//   4. Lower to the existing aarch64_emit_while_loop path: init=0, bound=hi, op=<, incr=1, msgs=BODY.
//
// residual: typed-AST path (Tier 5 #24) handles arbitrary bodies; this is the refuse-safe shape.


import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_loop.oo";


pub fn aarch64_match_for_test(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) == 0 { return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if a64_tok_k(toks, i) == "KW_FN" && i + 1 < n && a64_tok_t(toks, i + 1) == "main" {
            let mut p = i + 2;
            if p + 2 >= n || a64_tok_k(toks, p) != "LPAREN" || a64_tok_k(toks, p + 1) != "RPAREN" || a64_tok_k(toks, p + 2) != "LBRACE" { return empty;
            }
            p = p + 3;
            if p >= n || a64_tok_k(toks, p) != "KW_FOR" { return empty;
            }
            p = p + 1;
            if p >= n || a64_tok_k(toks, p) != "IDENT" { return empty;
            }
            let ident: String = a64_tok_t(toks, p);
            p = p + 1;
            if p >= n || a64_tok_k(toks, p) != "IDENT" || a64_tok_t(toks, p) != "in" { return empty;
            }
            p = p + 1;
            if p >= n || a64_tok_k(toks, p) != "INT" || a64_tok_t(toks, p) != "0" { return empty;
            }
            p = p + 1;
            if p >= n || a64_tok_k(toks, p) != "DOTDOT" { return empty;
            }
            p = p + 1;
            if p >= n || a64_tok_k(toks, p) != "INT" { return empty;
            }
            let hi: String = a64_tok_t(toks, p);
            p = p + 1;
            if p >= n || a64_tok_k(toks, p) != "LBRACE" { return empty;
            }
            p = p + 1;

            // Body: 0..16 println(STRING); stmts. Refuse if body has KW_FOR or KW_MATCH.
            let mut msgs: List[String] = list_new();
            let mut stmt_count = 0;
            while p < n && a64_tok_k(toks, p) != "RBRACE" {
                stmt_count = stmt_count + 1;
                if stmt_count > 16 { return empty;
                }
                if a64_tok_k(toks, p) == "KW_FOR" || a64_tok_k(toks, p) == "KW_MATCH" { return empty;
                }
                if p + 3 < n && a64_tok_k(toks, p) == "IDENT" && a64_tok_t(toks, p) == "println"
                    && a64_tok_k(toks, p + 1) == "LPAREN"
                    && a64_tok_k(toks, p + 2) == "STRING"
                    && a64_tok_k(toks, p + 3) == "RPAREN" {
                    msgs = list_push(msgs, a64_tok_t(toks, p + 2));
                    p = p + 4;
                    if p < n && a64_tok_k(toks, p) == "SEMI" { p = p + 1;
                    }
                    continue;
                }
                return empty;
            }
            if p >= n || a64_tok_k(toks, p) != "RBRACE" { return empty;
            }

            // Return: [ident, hi, msg1, msg2, ...]
            let mut out: List[String] = list_new();
            out = list_push(out, ident);
            out = list_push(out, hi);
            let mut mi = 0;
            while mi < list_len(msgs) {
                out = list_push(out, list_get(msgs, mi));
                mi = mi + 1;
            }
            return out;
        }
        i = i + 1;
    }
    return empty;
}

pub fn aarch64_emit_for_test(spec: List[String]) {
    let ident: String = list_get(spec, 0);
    let hi: String = list_get(spec, 1);
    let n_msgs = list_len(spec) - 2;

    // Build a while-loop spec: [init=0, bound=hi, op=<, incr=1, msg1, msg2, ...]
    let mut while_spec: List[String] = list_new();
    while_spec = list_push(while_spec, "0");
    while_spec = list_push(while_spec, hi);
    while_spec = list_push(while_spec, "<");
    while_spec = list_push(while_spec, "1");
    let mut mi = 0;
    while mi < n_msgs { while_spec = list_push(while_spec, list_get(spec, 2 + mi));
    mi = mi + 1;
    }
    // Emit a comment marking the for-loop origin so the asm is greppable.
    println("# for " + ident + " in 0.." + hi);
    aarch64_emit_while_loop(while_spec);
}
