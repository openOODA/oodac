// # AArch64 AST-Based ELF Driver
//
// Logline: Reads one .oo path and writes a runnable Linux AArch64 ELF64 binary using the in-process AST-based codegen pipeline, without touching the product oodac dispatch or the GAS-text path.
//
// Setup: Built to oodac/oodac.aarch64.ast via product emit-c + gcc. Calls aarch64_emit_direct_elf_binary from aarch64_emit_elf.oo.
//
// Beats:
//   1. Parse --ast-emit-aarch64 <file.oo> <out.bin> or --backend aarch64 --ast <file.oo> <out.bin>.
//   2. Refuse a missing, unreadable, or oversized source.
//   3. Write the ELF64 binary via aarch64_emit_direct_elf_binary.
//   4. Exit 0 on success, 1 on any compiler or I/O error.
//
// residual: The Tier 1 unification of aarch64_main.oo to also call this path is reserved for the next worker.

import "aarch64_emit_elf.oo";


fn a64_ast_usage() {
    println("oodac: usage: --ast-emit-aarch64 <file.oo> <out.bin>");
    println("       or:    --backend aarch64 --ast <file.oo> <out.bin>");
    process_exit(2);
}

fn a64_ast_parse(args: List[String]) -> List[String] {
    let n: Int = list_len(args);
    if n < 1 { a64_ast_usage();
    }
    let a0: String = list_get(args, 0);
    if a0 == "--ast-emit-aarch64" {
        if n != 3 { println("oodac: --ast-emit-aarch64 takes exactly 2 arguments");
        process_exit(2);
        }
        let mut r: List[String] = list_new();
        r = list_push(r, list_get(args, 1));
        r = list_push(r, list_get(args, 2));
        return r;
    }
    if a0 == "--backend" {
        if n < 4 { a64_ast_usage();
        }
        if list_get(args, 1) != "aarch64" {
            println("ERR\tbackend\t" + list_get(args, 1) + " residual");
            process_exit(2);
        }
        if list_get(args, 2) != "--ast" {
            a64_ast_usage();
        }
        if n != 5 { println("oodac: --backend aarch64 --ast takes exactly 2 arguments");
        process_exit(2);
        }
        let mut r: List[String] = list_new();
        r = list_push(r, list_get(args, 3));
        r = list_push(r, list_get(args, 4));
        return r;
    }
    a64_ast_usage();
    let mut empty: List[String] = list_new();
    return empty;
}

pub fn main(sys: &ProcessCap, fs: &FsReadCap, args: List[String]) {
    let pair: List[String] = a64_ast_parse(args);
    let path: String = list_get(pair, 0);
    let out_path: String = list_get(pair, 1);
    if !path_exists(fs, path) {
        println("ERR\tast-emit-aarch64\tunreadable file: " + path);
        process_exit(1);
    }
    let fsz: Int = file_size(fs, path);
    if fsz > 65536 { println("ERR\tload\tsource exceeds 64KiB per-file limit");
    process_exit(1);
    }
    let src_r: Result[String, String] = read_file(fs, path);
    if src_r.is_err() {
        println("ERR\tload\tunreadable file: " + path);
        process_exit(1);
    }
    let src: String = match src_r { Ok(s) => s, Err(e) => e };
    let ok: Bool = aarch64_emit_direct_elf_binary(sys, src, out_path);
    if !ok { println("ERR\tast-emit-aarch64\tcompile failed");
    process_exit(1);
    }
    println("ast-emit-aarch64: wrote " + out_path);
}
