// # Emit zero-libc sys_mmap native heap allocator
//
// Logline: Emits standalone AArch64 dynamic heap allocator using Linux syscall 222 (mmap) and the AAPCS64 frame convention.
//
// Setup: tokenize_lines, a64_tok_k, a64_tok_t, and aarch64_emit_int_routine exist.
//
// Beats:
//   1. Emit .Lheap_ptr and .Lheap_end in .bss.
//   2. Emit oo_aarch64_alloc routine (8-byte alignment, 64KB page expansion via sys_mmap).
//   3. Provide aarch64_emit_heap_allocator() for inclusion in generated assembly.
//   4. Match heap_alloc_test source shape and emit a standalone product floor.


import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_int.oo";


pub fn aarch64_emit_heap_allocator() {
    println("    .globl oo_aarch64_alloc");
    println("    .p2align 4");
    println("oo_aarch64_alloc:");
    println("    stp x29, x30, [sp, #-16]!");
    println("    mov x29, sp");
    println("    bic x0, x0, #7");
    println("    adrp x1, .Lheap_ptr");
    println("    add x1, x1, :lo12:.Lheap_ptr");
    println("    ldr x2, [x1]");
    println("    adrp x3, .Lheap_end");
    println("    add x3, x3, :lo12:.Lheap_end");
    println("    ldr x4, [x3]");
    println("    add x5, x2, x0");
    println("    cmp x5, x4");
    println("    b.ls .Lalloc_fit");
    println("    str x0, [sp, #-16]!");
    println("    mov x8, #222");
    println("    mov x0, #0");
    println("    mov x1, #65536");
    println("    mov x2, #3");
    println("    mov x3, #34");
    println("    movn x4, #0");
    println("    mov x5, #0");
    println("    svc #0");
    println("    ldr x0, [sp], #16");
    println("    adrp x1, .Lheap_ptr");
    println("    add x1, x1, :lo12:.Lheap_ptr");
    println("    str x0, [x1]");
    println("    add x3, x0, #65536");
    println("    adrp x4, .Lheap_end");
    println("    add x4, x4, :lo12:.Lheap_end");
    println("    str x3, [x4]");
    println("    adrp x1, .Lheap_ptr");
    println("    add x1, x1, :lo12:.Lheap_ptr");
    println("    ldr x2, [x1]");
    println("    add x5, x2, x0");
    println(".Lalloc_fit:");
    println("    adrp x1, .Lheap_ptr");
    println("    add x1, x1, :lo12:.Lheap_ptr");
    println("    str x5, [x1]");
    println("    mov x0, x2");
    println("    ldp x29, x30, [sp], #16");
    println("    ret");
}

pub fn aarch64_emit_heap_bss() {
    println("    .section .bss");
    println("    .p2align 3");
    println(".Lheap_ptr:");
    println("    .quad 0");
    println(".Lheap_end:");
    println("    .quad 0");
}

pub fn aarch64_match_heap_test(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) <= 0 { return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n { if a64_tok_k(toks, i) == "IDENT" && a64_tok_t(toks, i) == "heap_alloc_test" { let mut out: List[String] = list_new();
    out = list_push(out, "heap_alloc_test");
    return out;
    }
        i = i + 1;
    }
    return empty;
}

pub fn aarch64_emit_heap_test() {
    println("# openOODA aarch64 product floor (GAS, Linux, clang -target aarch64-linux-gnu)");
    println("    .arch armv8-a");
    aarch64_emit_heap_bss();
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    aarch64_emit_heap_allocator();
    aarch64_emit_int_routine();
    println("main:");
    println("_start:");
    println("    mov x0, #16");
    println("    bl oo_aarch64_alloc");
    println("    mov x1, #77");
    println("    str x1, [x0]");
    println("    mov x1, #88");
    println("    str x1, [x0, #8]");
    println("    ldr x0, [x0]");
    println("    bl _println_int");
    println("    mov x8, #93");
    println("    mov x0, #0");
    println("    svc #0");
}
