// # aarch64 contract enforcement (requires / ensures / spec / verify)
//
// Logline: Mirrors x86_emit_contract.oo for the aarch64 path: collect every requires/ensures/spec/verify clause as "<fn>:<kind>:<body>", const-fold the literal-int-comparison subset, and return error messages for anything we can't fold. The full SMT proof is out of scope here; only the const-fold case is checked in this pass.
//
// Setup: tokenize_lines lives in token_fmt.oo; a64_tok_k / a64_tok_t live in aarch64_emit_harv.oo. The x86 path uses x86_emit_contract.oo for the same job; the aarch64 path previously had no equivalent and silently dropped contracts.
//
// Beats:
//   1. aarch64_contract_walk_records walks the source and returns one "<fn>:<kind>:<body>:<eval>" record per clause.
//   2. aarch64_collect_contracts returns one "<fn>:<kind>:<body>" per clause and refuses (returns []) if any requires/ensures is not a const-foldable literal INT OP INT.
//   3. aarch64_check_contracts const-folds the literal-int-comparison subset and returns one error per non-passing clause.
//   4. aarch64_emit_contract_test is the public entry point the dispatch in aarch64_emit.oo will call first; on empty source or shape mismatch, returns [] so the dispatch can fall through to its own ERR.
//
// residual: full SMT proof, verify-block body parse, pre/post hooks, capabilities — these live in the C emit and are not mirrored here.


import "aarch64_emit_const_harvest.oo";


// Find the first relation-op token (GT, GTE, LT, LTE, EQEQ, NEQ) in
// [start, end). Returns its index, or -1 if no relation op is present.
fn aarch64_contract_find_rel_op(toks: List[String], start: Int, end: Int) -> Int {
    let mut i: Int = start;
while i < end { let k: String = a64_tok_k(toks, i);
if k == "GT" || k == "GTE" || k == "LT" || k == "LTE" || k == "EQEQ" || k == "NEQ" { return i;
}
        i = i + 1;
    }
    return -1;
}

// Evaluate a const-foldable literal-int comparison in [start, end).
// Returns "TRUE" if the comparison holds, "FALSE" if it does not, or
// "" if the body is not a literal INT OP INT.
fn aarch64_contract_eval_literal_cmp(toks: List[String], start: Int, end: Int) -> String {
    let op_i: Int = 0 + aarch64_contract_find_rel_op(toks, start, end);
    if op_i <= start || op_i + 1 >= end { return "";
    }
    let lk: String = a64_tok_k(toks, op_i - 1);
    let rk: String = a64_tok_k(toks, op_i + 1);
    if lk != "INT" || rk != "INT" { return "";
    }
    let lv: Int = parse_int(a64_tok_t(toks, op_i - 1));
    let rv: Int = parse_int(a64_tok_t(toks, op_i + 1));
    let op: String = a64_tok_k(toks, op_i);
    let mut ok: Bool = false;
    if op == "GT" { ok = lv > rv;
    }
    if op == "GTE" { ok = lv >= rv;
    }
    if op == "LT" { ok = lv < rv;
    }
    if op == "LTE" { ok = lv <= rv;
    }
    if op == "EQEQ" { ok = lv == rv;
    }
    if op == "NEQ" { ok = lv != rv;
    }
    if ok { return "TRUE";
    }
    return "FALSE";
}

// Concatenate token text in [start, end) with single-space separators.
// Empty text fields are skipped.
fn aarch64_contract_body_concat(toks: List[String], start: Int, end: Int) -> String {
    let mut body: String = "";
    let mut i: Int = start;
    while i < end {
        let t: String = a64_tok_t(toks, i);
        if chars_len(t) > 0 {
            if chars_len(body) > 0 { body = body + " ";
            }
            body = body + t;
        }
        i = i + 1;
    }
    return body;
}

// Walk the source and return one record per clause. Record format is
// "fn_name\tkind\tbody\teval" where eval is "TRUE", "FALSE", or "".
// "" means the body is not a const-foldable literal INT OP INT. spec
// and verify clauses always have eval "".
fn aarch64_contract_walk_records(src: String) -> List[String] {
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut out: List[String] = list_new();
    let mut fn_name: String = "";
    let mut i: Int = 0;
    while i < n { let k: String = a64_tok_k(toks, i);
    let t: String = a64_tok_t(toks, i);
    if k == "KW_FN" { if i + 1 < n && a64_tok_k(toks, i + 1) == "IDENT" { fn_name = a64_tok_t(toks, i + 1);
    } else {
                fn_name = "";
            }
            i = i + 1;
        } else if k == "KW_REQUIRES" || k == "KW_ENSURES" {
            let mut kind_eff: String = "requires";
            if k == "KW_ENSURES" { kind_eff = "ensures";
            }
            let start: Int = i + 1;
            let mut j: Int = start;
            while j < n { let jk: String = a64_tok_k(toks, j);
            if jk == "SEMI" || jk == "LBRACE" || jk == "KW_REQUIRES" || jk == "KW_ENSURES" || jk == "KW_FN" { break;
            }
                j = j + 1;
            }
            let body: String = aarch64_contract_body_concat(toks, start, j);
            let ev: String = aarch64_contract_eval_literal_cmp(toks, start, j);
            out = list_push(out, fn_name + "\t" + kind_eff + "\t" + body + "\t" + ev);
            i = j;
        } else if k == "IDENT" && t == "spec" {
            let start: Int = i + 1;
            let mut j: Int = start;
            while j < n { let jk: String = a64_tok_k(toks, j);
            if jk == "SEMI" || jk == "LBRACE" || jk == "KW_FN" || jk == "KW_REQUIRES" || jk == "KW_ENSURES" { break;
            }
                j = j + 1;
            }
            let body: String = aarch64_contract_body_concat(toks, start, j);
            out = list_push(out, fn_name + "\tspec\t" + body + "\t");
            i = j;
        } else if k == "KW_VERIFY" {
            let start: Int = i + 1;
            let mut j: Int = i + 1;
            let mut depth: Int = 0;
            let mut saw_open: Bool = false;
            while j < n { let jk: String = a64_tok_k(toks, j);
            if jk == "LBRACE" { depth = depth + 1;
            saw_open = true;
            j = j + 1;
            } else if jk == "RBRACE" {
                    depth = depth - 1;
                    j = j + 1;
                    if depth == 0 && saw_open { break;
                    }
                } else {
                    j = j + 1;
                }
            }
            let body: String = aarch64_contract_body_concat(toks, start, j);
            out = list_push(out, fn_name + "\tverify\t" + body + "\t");
            i = j;
        } else {
            i = i + 1;
        }
    }
    return out;
}

// Walk and return one "<fn>:<kind>:<body>" string per clause. Refuses
// (returns []) if any requires/ensures has a body that is not a
// const-foldable literal INT OP INT.
pub fn aarch64_collect_contracts(src: String) -> List[String] {
    let total: Int = chars_len(src);
    if total == 0 { let mut empty: List[String] = list_new();
    return empty;
    }
    let records: List[String] = aarch64_contract_walk_records(src);
    let rn: Int = list_len(records);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < rn { let r: String = list_get(records, i);
    let kind: String = field_at(r, 1);
    let ev: String = field_at(r, 3);
    if kind == "requires" || kind == "ensures" { if chars_len(ev) == 0 { let mut empty: List[String] = list_new();
    return empty;
    }
        }
        let clause: String = field_at(r, 0) + ":" + kind + ":" + field_at(r, 2);
        out = list_push(out, clause);
        i = i + 1;
    }
    return out;
}

// Try to verify every contract clause. For requires/ensures with a
// const-foldable literal-int comparison, evaluate the body and accept
// when the comparison is true. For anything else (non-foldable
// requires/ensures, spec, verify) return one error per clause. Empty
// list means the source is clean.
pub fn aarch64_check_contracts(src: String) -> List[String] {
    let total: Int = chars_len(src);
    if total == 0 { let mut empty: List[String] = list_new();
    return empty;
    }
    let _clauses: List[String] = aarch64_collect_contracts(src);
    let records: List[String] = aarch64_contract_walk_records(src);
    let rn: Int = list_len(records);
    let mut errs: List[String] = list_new();
    let mut i: Int = 0;
    while i < rn { let r: String = list_get(records, i);
    let fn_name: String = field_at(r, 0);
    let kind: String = field_at(r, 1);
    let body: String = field_at(r, 2);
    let ev: String = field_at(r, 3);
    let clause: String = fn_name + ":" + kind + ":" + body;
    if kind == "requires" || kind == "ensures" { if ev == "" || ev == "FALSE" { errs = list_push(errs, "ERR\taarch64_emit\tcontract not folded: " + clause);
    }
        } else if kind == "verify" || kind == "spec" {
            // verify/spec are not runtime; do not steal foldable programs
        } else {
            errs = list_push(errs, "ERR\taarch64_emit\tcontract not folded: " + clause);
        }
        i = i + 1;
    }
    return errs;
}

// Public entry point the dispatch in aarch64_emit.oo will call before
// any matcher. Honors the refuse-don't-miscompile policy: on empty
// source or shape mismatch, return an empty list so the dispatch can
// fall through to its own ERR. Never fabricate error output.
pub fn aarch64_emit_contract_test(src: String) -> List[String] {
    let total: Int = chars_len(src);
    if total == 0 { let mut empty: List[String] = list_new();
    return empty;
    }
    return aarch64_check_contracts(src);
}
