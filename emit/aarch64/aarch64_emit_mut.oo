// # Emit mutable local in stack frame
//
// Logline: Lowers let mut x: Int = V1, reassignment x = V2, and println(x) into a stack-slot store, store, reload, and tail call to aarch64_emit_int_routine.
//
// Setup: tokenize_lines, a64_tok_k, and a64_tok_t exist in aarch64_emit_harv.oo; aarch64_emit_int_routine exists in aarch64_emit_int.oo.
//
// Beats:
//   1. Match fn main() { let mut IDENT: Int = V1; IDENT = V2; println(IDENT); }.
//   2. Allocate a 16-byte stack slot via the frame, store V1, store V2, and reload the slot into x0.
//   3. Tail-call aarch64_emit_int_routine, then exit 0 via SYS_exit (93).
//
// residual: typed-AST path (Tier 5 #25) handles arbitrary mut shapes; this is the refuse-safe floor for the let mut / reassign / println program shape.


import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_int.oo";


pub fn aarch64_match_mut_local(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) == 0 { return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    if n < 16 { return empty;
    }
    let mut i = 0;
    while i < n {
        if a64_tok_k(toks, i) == "KW_FN" && i + 1 < n && a64_tok_t(toks, i + 1) == "main" {
            let mut p = i + 2;
            if p + 3 < n && a64_tok_k(toks, p) == "LPAREN" && a64_tok_k(toks, p + 1) == "RPAREN" && a64_tok_k(toks, p + 2) == "LBRACE" && a64_tok_k(toks, p + 3) == "KW_LET" {
                p = p + 4;
                if p >= n || a64_tok_k(toks, p) != "KW_MUT" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "IDENT" { return empty;
                }
                let var_name: String = a64_tok_t(toks, p);
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "COLON" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "IDENT" || a64_tok_t(toks, p) != "Int" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "EQ" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "INT" { return empty;
                }
                let v1: String = a64_tok_t(toks, p);
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "SEMI" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "IDENT" || a64_tok_t(toks, p) != var_name { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "EQ" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "INT" { return empty;
                }
                let v2: String = a64_tok_t(toks, p);
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "SEMI" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "IDENT" || a64_tok_t(toks, p) != "println" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "LPAREN" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "IDENT" || a64_tok_t(toks, p) != var_name { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "RPAREN" { return empty;
                }
                p = p + 1;
                if p < n && a64_tok_k(toks, p) == "SEMI" { p = p + 1;
                }
                if p >= n || a64_tok_k(toks, p) != "RBRACE" { return empty;
                }
                let mut out: List[String] = list_new();
                out = list_push(out, v1);
                out = list_push(out, v2);
                return out;
            }
        }
        i = i + 1;
    }
    return empty;
}

pub fn aarch64_emit_mut_local(v1: String, v2: String) {
    println("# openOODA aarch64 product floor (GAS, Linux, clang -target aarch64-linux-gnu)");
    println("    .arch armv8-a");
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    aarch64_emit_int_routine();
    println("main:");
    println("_start:");
    println("    stp x29, x30, [sp, #-32]!");
    println("    mov x29, sp");
    println("    mov x0, #" + v1);
    println("    str x0, [x29, #16]");
    println("    mov x0, #" + v2);
    println("    str x0, [x29, #16]");
    println("    ldr x0, [x29, #16]");
    println("    bl _println_int");
    println("    mov x8, #93");
    println("    mov x0, #0");
    println("    svc #0");
}
