// # AArch64 SSA function lower
//
// Logline: Lowers one SsaFunction to AAPCS64 GAS with per-vreg x29 slots.
//
// Setup: Import oodac/emit/llvm/ssa_ir.oo. Parallel inst arrays; skip when i >= len.
//
// Beats:
//   1. aarch64_ssa_slot: [x29, #-(8*(reg+1))] after stp/sub-sp.
//   2. aarch64_ssa_sanitize_label: keep [A-Za-z0-9_], else "fn".
//   3. aarch64_ssa_emit_function: prologue, per-block labels, const/add/sub/ret/br/cond_br.
//   4. Short block_names is typed ERR. Unknown ops store xzr. No _start unless name is main.

import "emit/llvm/ssa_ir.oo";

pub fn aarch64_ssa_slot(reg: Int) -> String {
    let r: Int = if reg < 0 { 0 } else { reg };
    let off: Int = 0 - (8 * (r + 1));
    return "[x29, #" + off.to_string() + "]";
}

pub fn aarch64_ssa_sanitize_label(s: String) -> String {
    let n: Int = chars_len(s);
let mut out: String = "";
let mut i: Int = 0;
while i < n { let b: Int = byte_at(s, i);
if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95 { out = out + char_at(s, i);
}
        i = i + 1;
    }
    if chars_len(out) == 0 { return "fn";
    }
    return out;
}

fn a64_ssa_imm(imm: Int) -> String {
    if imm >= 0 && imm <= 65535 { return "    mov x9, #" + imm.to_string() + "\n";
}
    return "    ldr x9, =" + imm.to_string() + "\n";
}

fn a64_ssa_blab(fn_label: String, names: List[String], bid: Int) -> String {
    if bid < 0 || bid >= list_len(names) { return ".L" + fn_label + "_fn";
    }
    return ".L" + fn_label + "_" + aarch64_ssa_sanitize_label(list_get(names, bid));
}

fn a64_ssa_format_inst(op: Int, res: Int, imm: Int, lh: Int, fn_label: String, names: List[String], n_blocks: Int, frame: Int) -> String {
    let s: String = aarch64_ssa_slot(res);
if op == 20 || op == 22 { return a64_ssa_imm(imm) + "    str x9, " + s + "\n";
}
    if op == 1 { return "    ldr x9, " + aarch64_ssa_slot(lh) + "\n    ldr x10, " + aarch64_ssa_slot(imm) + "\n    add x9, x9, x10\n    str x9, " + s + "\n";
    }
    if op == 2 { return "    ldr x9, " + aarch64_ssa_slot(lh) + "\n    ldr x10, " + aarch64_ssa_slot(imm) + "\n    sub x9, x9, x10\n    str x9, " + s + "\n";
    }
    if op == 19 {
        let mut line: String = "    ldr x0, " + aarch64_ssa_slot(imm) + "\n";
        if frame > 0 { line = line + "    add sp, sp, #" + frame.to_string() + "\n";
        }
        return line + "    ldp x29, x30, [sp], #16\n    ret\n";
    }
    if op == 14 { return "";
    }
    if op == 17 { if imm >= 0 && imm < n_blocks { return "    b " + a64_ssa_blab(fn_label, names, imm) + "\n";
    }
        return "";
    }
    if op == 18 { let mut line: String = "    ldr x9, " + aarch64_ssa_slot(lh) + "\n";
    if res >= 0 && res < n_blocks { line = line + "    cbnz x9, " + a64_ssa_blab(fn_label, names, res) + "\n";
    } else if (0 - res) >= 0 && (0 - res) < n_blocks { let then_id: Int = 0 - res;
    line = line + "    cbz x9, " + a64_ssa_blab(fn_label, names, then_id) + "\n";
    }
        if imm >= 0 && imm < n_blocks { line = line + "    b " + a64_ssa_blab(fn_label, names, imm) + "\n";
        }
        return line;
    }
    return "    mov x9, xzr\n    str x9, " + s + "\n";
}

pub fn aarch64_ssa_emit_function(fn_data: SsaFunction) -> String {
    let fn_label: String = aarch64_ssa_sanitize_label(fn_data.name);
let n_insts: Int = ssa_fn_inst_count(fn_data);
let n_blocks: Int = fn_data.block_count;
let names: List[String] = fn_data.block_names;
if n_blocks > list_len(names) { println("ERR\taarch64_ssa\tblock_names short");
process_exit(1);
}
    let opcodes: List[Int] = fn_data.inst_opcodes;
    let results: List[Int] = fn_data.inst_results;
    let imms: List[Int] = fn_data.inst_imm_vals;
    let lhs_vals: List[Int] = fn_data.inst_lhs_vals;
    let bids: List[Int] = fn_data.inst_block_ids;
    let n_op: Int = list_len(opcodes);
    let n_res: Int = list_len(results);
    let n_imm: Int = list_len(imms);
    let n_lh: Int = list_len(lhs_vals);
    let n_bid: Int = list_len(bids);
    let mut max_reg: Int = 0;
    let mut i: Int = 0;
    while i < n_insts {
        if i < n_res {
            let r: Int = list_get(results, i);
            if r > max_reg { max_reg = r;
            }
        }
        if i < n_lh {
            let r2: Int = list_get(lhs_vals, i);
            if r2 > max_reg { max_reg = r2;
            }
        }
        i = i + 1;
    }
    let mut frame: Int = (max_reg + 1) * 8;
    frame = (frame + 15) & -16;
    let mut out: String = "    .text\n    .globl " + fn_label + "\n    .p2align 2\n" + fn_label + ":\n";
    out = out + "    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n";
    if frame > 0 { out = out + "    sub sp, sp, #" + frame.to_string() + "\n";
    }
    let mut b: Int = 0;
    while b < n_blocks { let bname: String = aarch64_ssa_sanitize_label(list_get(names, b));
    out = out + ".L" + fn_label + "_" + bname + ":\n";
    let mut ii: Int = 0;
    while ii < n_insts { if ii < n_op && ii < n_res && ii < n_imm && ii < n_lh && ii < n_bid { if list_get(bids, ii) == b { let op: Int = list_get(opcodes, ii);
    let res: Int = list_get(results, ii);
    let imm: Int = list_get(imms, ii);
    let lh: Int = list_get(lhs_vals, ii);
    out = out + a64_ssa_format_inst(op, res, imm, lh, fn_label, names, n_blocks, frame);
    }
            }
            ii = ii + 1;
        }
        b = b + 1;
    }
    if fn_label == "main" {
        out = out + "    .globl _start\n_start:\n    bl main\n    mov x8, #93\n    svc #0\n";
    }
    return out;
}
