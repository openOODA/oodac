// # Side driver for emit-aarch64 and --ast-emit-aarch64 (Tier 1 wired)
//
// Logline: Reads one .oo path and either prints Linux AArch64 GAS (text path) or shells out to oodac/oodac.aarch64.ast to write a runnable ELF64 binary (AST path). Does not touch product oodac dispatch.
//
// Setup: Built to oodac/oodac.aarch64 via product emit-c + gcc. Does not overwrite oodac/oodac. The AST path is reached by spawning oodac/oodac.aarch64.ast (built separately from oodac/aarch64_ast_main.oo) as a subprocess, avoiding the C-emit OoSList/OoIList type collision that would arise from linking the AST path into this translation unit.
//
// Beats:
//   1. Parse three CLI forms: emit-aarch64 <file>, --backend aarch64 emit-aarch64 <file>, --ast-emit-aarch64 <file> <out.bin>, --backend aarch64 --ast <file> <out.bin>.
//   2. Refuse a missing, unreadable, or oversized source.
//   3. Stream AArch64 assembly to stdout (text path) or shell out to oodac/oodac.aarch64.ast (AST path).

import "aarch64_emit.oo";

import "aarch64_emit_elf.oo";

import "std/core/cli/sh.oo";

fn a64_usage() {
    println("oodac: usage: emit-aarch64 <file>");
    println("       or:    --ast-emit-aarch64 <file> <out.bin>");
    println("       or:    --backend aarch64 emit-aarch64 <file>");
    println("       or:    --backend aarch64 --ast <file> <out.bin>");
    process_exit(2);
}

// Returns [mode, path, out_path] where mode is "text" or "ast".
// For "text", out_path is unused.
fn a64_parse(args: List[String]) -> List[String] {
    let n = list_len(args);
    if n < 1 { a64_usage();
    }
    let a0: String = list_get(args, 0);
    if a0 == "emit-aarch64" {
        if n < 2 { a64_usage();
        }
        if n > 2 { println("oodac: too many arguments");
        process_exit(2);
        }
        let mut r: List[String] = list_new();
        r = list_push(r, "text");
        r = list_push(r, list_get(args, 1));
        r = list_push(r, "");
        return r;
    }
    if a0 == "--ast-emit-aarch64" {
        if n != 3 { println("oodac: --ast-emit-aarch64 takes exactly 2 arguments");
        process_exit(2);
        }
        let mut r2: List[String] = list_new();
        r2 = list_push(r2, "ast");
        r2 = list_push(r2, list_get(args, 1));
        r2 = list_push(r2, list_get(args, 2));
        return r2;
    }
    if a0 == "--backend" {
        if n < 3 { a64_usage();
        }
        if list_get(args, 1) != "aarch64" {
            println("ERR\tbackend\t" + list_get(args, 1) + " residual");
            process_exit(2);
        }
        if list_get(args, 2) == "emit-aarch64" {
            if n < 4 { a64_usage();
            }
            if n > 4 { println("oodac: too many arguments");
            process_exit(2);
            }
            let mut r3: List[String] = list_new();
            r3 = list_push(r3, "text");
            r3 = list_push(r3, list_get(args, 3));
            r3 = list_push(r3, "");
            return r3;
        }
        if list_get(args, 2) == "--ast" {
            if n != 5 { println("oodac: --backend aarch64 --ast takes exactly 2 arguments");
            process_exit(2);
            }
            let mut r4: List[String] = list_new();
            r4 = list_push(r4, "ast");
            r4 = list_push(r4, list_get(args, 3));
            r4 = list_push(r4, list_get(args, 4));
            return r4;
        }
        a64_usage();
    }
    if n > 1 { println("oodac: too many arguments");
    process_exit(2);
    }
    let mut r5: List[String] = list_new();
    r5 = list_push(r5, "text");
    r5 = list_push(r5, a0);
    r5 = list_push(r5, "");
    return r5;
}

// Find the directory containing this binary by walking up from the current
// working directory. The oodac.aarch64.ast binary lives next to oodac.aarch64.
fn a64_self_dir(fs: &FsReadCap, sys: &ProcessCap) -> String {
    let cwd: String = match sh_realpath(fs, ".") { Ok(s) => s, Err(_) => "." };
    let mut i: Int = 0;
    while i < 10 { let cand: String = cwd + "/oodac/oodac.aarch64.ast";
    if path_exists(fs, cand) { return cwd + "/oodac";
    }
        if cwd == "/" { return "";
        }
        let parent: String = match sh_realpath(fs, cwd + "/..") { Ok(s) => s, Err(_) => "" };
        if parent == cwd || parent == "" { return "";
        }
        // can't reassign cwd as String without let mut; use shell to compute
        let _ = parent;
        return "";
    }
    return "";
}

pub fn main(sys: &ProcessCap, fs: &FsReadCap, args: List[String]) {
    let parsed: List[String] = a64_parse(args);
    let mode: String = list_get(parsed, 0);
    let path: String = list_get(parsed, 1);
    let out_path: String = list_get(parsed, 2);
    if !path_exists(fs, path) {
        println("ERR\temit-aarch64\tunreadable file: " + path);
        process_exit(1);
    }
    let fsz: Int = file_size(fs, path);
    if fsz > 65536 { println("ERR\tload\tsource exceeds 64KiB per-file limit");
    process_exit(1);
    }
    let src_r: Result[String, String] = read_file(fs, path);
    if src_r.is_err() {
        println("ERR\tload\tunreadable file: " + path);
        process_exit(1);
    }
    let src: String = match src_r { Ok(s) => s, Err(e) => e };
    if mode == "ast" {
        let ok: Bool = aarch64_emit_direct_elf_binary(sys, src, out_path);
        if !ok { println("ERR\tast-emit-aarch64\tcompile failed");
        process_exit(1);
        }
        println("ast-emit-aarch64: wrote " + out_path);
        return;
    }
    aarch64_emit_stream(src);
}
