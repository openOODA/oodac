// # Emit AArch64 GAS bump concat of two STRING args
//
// Logline: Matches return a+b and println(cat(STRING, STRING)) then copies into a 4096-byte .bss bump.
//
// Setup: tokenize_lines, a64_tok_k, aarch64_ascii_esc, and AAPCS64 frame helpers exist. Fold already missed.
//
// Beats:
//   1. Find one fn whose body is return of param1 plus param2.
//   2. Require main to be only println of that fn on two STRING args.
//   3. Copy both strings plus newline into .Lbuf; overflow above 4096 ERRs.
//
// residual: 3-arg, heap beyond 4096, and rodata printable-quote gate stay later.


import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_sys.oo";



fn aarch64_cat_shape(toks: List[String], n: Int, i: Int) -> List[String] {
    let empty: List[String] = list_new();
    if i + 17 >= n { return empty;
    }
    if a64_tok_k(toks, i) != "KW_FN" || a64_tok_k(toks, i + 1) != "IDENT" {
        return empty;
    }
    let nm: String = a64_tok_t(toks, i + 1);
    if nm == "main" {
        return empty;
    }
    if a64_tok_k(toks, i + 2) != "LPAREN" || a64_tok_k(toks, i + 3) != "IDENT" {
        return empty;
    }
    let p1: String = a64_tok_t(toks, i + 3);
    if a64_tok_k(toks, i + 4) != "COLON" || a64_tok_k(toks, i + 5) != "IDENT" {
        return empty;
    }
    if a64_tok_t(toks, i + 5) != "String" {
        return empty;
    }
    if a64_tok_k(toks, i + 6) != "COMMA" || a64_tok_k(toks, i + 7) != "IDENT" {
        return empty;
    }
    let p2: String = a64_tok_t(toks, i + 7);
    if a64_tok_k(toks, i + 8) != "COLON" || a64_tok_k(toks, i + 9) != "IDENT" {
        return empty;
    }
    if a64_tok_t(toks, i + 9) != "String" {
        return empty;
    }
    if a64_tok_k(toks, i + 10) != "RPAREN" || a64_tok_k(toks, i + 11) != "ARROW" {
        return empty;
    }
    if a64_tok_k(toks, i + 12) != "IDENT" || a64_tok_t(toks, i + 12) != "String" {
        return empty;
    }
    if a64_tok_k(toks, i + 13) != "LBRACE" || a64_tok_k(toks, i + 14) != "KW_RETURN" {
        return empty;
    }
    if a64_tok_k(toks, i + 15) != "IDENT" || a64_tok_t(toks, i + 15) != p1 { return empty;
    }
    if a64_tok_k(toks, i + 16) != "PLUS" || a64_tok_k(toks, i + 17) != "IDENT" {
        return empty;
    }
    if a64_tok_t(toks, i + 17) != p2 { return empty;
    }
    let mut p = i + 18;
    if p < n && a64_tok_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || a64_tok_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, nm);
    return o;
}

fn aarch64_cat_main(toks: List[String], n: Int, i: Int, fname: String) -> List[String] {
    let empty: List[String] = list_new();
    if i + 13 >= n { return empty;
    }
    if a64_tok_k(toks, i + 2) != "LPAREN" || a64_tok_k(toks, i + 3) != "RPAREN" {
        return empty;
    }
    if a64_tok_k(toks, i + 4) != "LBRACE" || a64_tok_k(toks, i + 5) != "IDENT" {
        return empty;
    }
    if a64_tok_t(toks, i + 5) != "println" || a64_tok_k(toks, i + 6) != "LPAREN" {
        return empty;
    }
    if a64_tok_k(toks, i + 7) != "IDENT" || a64_tok_t(toks, i + 7) != fname { return empty;
    }
    if a64_tok_k(toks, i + 8) != "LPAREN" || a64_tok_k(toks, i + 9) != "STRING" {
        return empty;
    }
    let a: String = a64_tok_t(toks, i + 9);
    if a64_tok_k(toks, i + 10) != "COMMA" || a64_tok_k(toks, i + 11) != "STRING" {
        return empty;
    }
    let b: String = a64_tok_t(toks, i + 11);
    if a64_tok_k(toks, i + 12) != "RPAREN" || a64_tok_k(toks, i + 13) != "RPAREN" {
        return empty;
    }
    let mut p = i + 14;
    if p < n && a64_tok_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || a64_tok_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, fname);
    o = list_push(o, a);
    o = list_push(o, b);
    return o;
}

pub fn aarch64_match_str_call(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) <= 0 { return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut fname = "";
    let mut i = 0;
    while i < n { if a64_tok_k(toks, i) == "KW_FN" { if i + 1 >= n || a64_tok_k(toks, i + 1) != "IDENT" { return empty;
    }
            let nm: String = a64_tok_t(toks, i + 1);
            if nm != "main" {
                let idn: List[String] = aarch64_cat_shape(toks, n, i);
                if list_len(idn) < 1 { return empty;
                }
                if chars_len(fname) > 0 { return empty;
                }
                fname = list_get(idn, 0);
            }
        }
        i = i + 1;
    }
    if chars_len(fname) <= 0 { return empty;
    }
    let mut found: List[String] = list_new();
    i = 0;
    while i < n { if a64_tok_k(toks, i) == "KW_FN" { if i + 1 < n && a64_tok_k(toks, i + 1) == "IDENT" { if a64_tok_t(toks, i + 1) == "main" { if list_len(found) >= 1 { return empty;
    }
                    found = aarch64_cat_main(toks, n, i, fname);
                    if list_len(found) < 3 { return empty;
                    }
                }
            }
        }
        i = i + 1;
    }
    return found;
}

pub fn aarch64_emit_str_call(fname: String, a: String, b: String) {
    let la = bytes_len(a);
    let lb = bytes_len(b);
    if la + lb + 1 > 4096 { println("ERR\taarch64_emit\tstr buf");
    process_exit(1);
    }
    println("# openOODA aarch64 product floor (GAS, Linux, clang -target aarch64-linux-gnu)");
    println("    .arch armv8-a");
    println("    .section .rodata");
    println("    .p2align 3");
    println(".Lstr0:");
    println("    .ascii \"" + aarch64_ascii_esc(a) + "\"");
    println(".Lstr1:");
    println("    .ascii \"" + aarch64_ascii_esc(b) + "\"");
    println("    .section .bss");
    println("    .p2align 3");
    println(".Lbuf:");
    println("    .skip 4096");
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    println("    .globl " + fname);
    println("    .p2align 2");
    println(".Lcpy:");
    println("    cbz x2, .Lcpy_done");
    println(".Lcpy_loop:");
    println("    ldrb w3, [x0], #1");
    println("    strb w3, [x1], #1");
    println("    sub x2, x2, #1");
    println("    cbnz x2, .Lcpy_loop");
    println(".Lcpy_done:");
    println("    ret");
    println(fname + ":");
    println("    stp x29, x30, [sp, #-16]!");
    println("    mov x29, sp");
    println("    mov x4, x0\n    mov x5, x1\n    mov x6, x2\n    mov x7, x3");
    println("    adrp x0, .Lstr0\n    add x0, x0, :lo12:.Lstr0");
    println("    adrp x1, .Lbuf\n    add x1, x1, :lo12:.Lbuf");
    println("    mov x2, x6");
    println("    bl .Lcpy");
    println("    adrp x0, .Lstr1\n    add x0, x0, :lo12:.Lstr1");
    println("    adrp x1, .Lbuf\n    add x1, x1, :lo12:.Lbuf");
    println("    add x1, x1, x6");
    println("    mov x2, x7");
    println("    bl .Lcpy");
    println("    adrp x0, .Lbuf\n    add x0, x0, :lo12:.Lbuf");
    println("    add x0, x0, x6\n    add x0, x0, x7");
    println("    mov w1, #10\n    strb w1, [x0]");
    println("    mov x0, x4");
    println("    mov x1, x5");
    println("    ldp x29, x30, [sp], #16");
    println("    ret");
    println("main:");
    println("    stp x29, x30, [sp, #-16]!");
    println("    mov x29, sp");
    println("    adrp x0, .Lstr0\n    add x0, x0, :lo12:.Lstr0");
    println("    adrp x1, .Lstr1\n    add x1, x1, :lo12:.Lstr1");
    println("    mov x2, #" + la.to_string() + "\n    mov x3, #" + lb.to_string());
    println("    bl " + fname);
    println("    mov x1, x0\n    mov x0, #1");
    println("    mov x2, #" + i2s(la + lb + 1) + "\n    mov x8, #64");
    println("    svc #0");
    println("    mov x0, #0\n    ldp x29, x30, [sp], #16\n    ret");
    println("_start:\n    mov x0, #0\n    mov x8, #93\n    svc #0");
}
