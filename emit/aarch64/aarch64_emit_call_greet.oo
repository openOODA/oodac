// # Emit AAPCS64 one-arg greet concat call
//
// Logline: Matches return STRING plus param plus STRING plus println(fn(STRING)) then copies into the AAPCS64 .bss bump.
//
// Setup: tokenize_lines, a64_tok_k, a64_tok_t, and aarch64_ascii_esc exist. Hello fold already missed.
//
// Beats:
//   1. Find one fn whose body is prefix plus param plus suffix.
//   2. Require main to be only println of that fn on one STRING.
//   3. adrp/add the name into x0, bl fn, then svc write plus svc exit.
//
// residual: Int args, stack spills, and 2+arg greet shapes stay later.


import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_sys.oo";



fn aarch64_greet_shape(toks: List[String], n: Int, i: Int) -> List[String] {
    let empty: List[String] = list_new();
    if i + 15 >= n { return empty;
    }
    if a64_tok_k(toks, i) != "KW_FN" || a64_tok_k(toks, i + 1) != "IDENT" {
        return empty;
    }
    let nm: String = a64_tok_t(toks, i + 1);
    if nm == "main" {
        return empty;
    }
    if a64_tok_k(toks, i + 2) != "LPAREN" || a64_tok_k(toks, i + 3) != "IDENT" {
        return empty;
    }
    let pn: String = a64_tok_t(toks, i + 3);
    if a64_tok_k(toks, i + 4) != "COLON" || a64_tok_k(toks, i + 5) != "IDENT" {
        return empty;
    }
    if a64_tok_t(toks, i + 5) != "String" {
        return empty;
    }
    if a64_tok_k(toks, i + 6) != "RPAREN" || a64_tok_k(toks, i + 7) != "ARROW" {
        return empty;
    }
    if a64_tok_k(toks, i + 8) != "IDENT" || a64_tok_t(toks, i + 8) != "String" {
        return empty;
    }
    if a64_tok_k(toks, i + 9) != "LBRACE" || a64_tok_k(toks, i + 10) != "KW_RETURN" {
        return empty;
    }
    if a64_tok_k(toks, i + 11) != "STRING" || a64_tok_k(toks, i + 12) != "PLUS" {
        return empty;
    }
    if a64_tok_k(toks, i + 13) != "IDENT" || a64_tok_t(toks, i + 13) != pn { return empty;
    }
    if a64_tok_k(toks, i + 14) != "PLUS" || a64_tok_k(toks, i + 15) != "STRING" {
        return empty;
    }
    let pre: String = a64_tok_t(toks, i + 11);
    let suf: String = a64_tok_t(toks, i + 15);
    let mut p = i + 16;
    if p < n && a64_tok_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || a64_tok_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, nm);
    o = list_push(o, pre);
    o = list_push(o, suf);
    return o;
}

fn aarch64_greet_main(toks: List[String], n: Int, i: Int, fname: String) -> List[String] {
    let empty: List[String] = list_new();
    if i + 12 >= n { return empty;
    }
    if a64_tok_k(toks, i + 2) != "LPAREN" || a64_tok_k(toks, i + 3) != "RPAREN" {
        return empty;
    }
    if a64_tok_k(toks, i + 4) != "LBRACE" || a64_tok_k(toks, i + 5) != "IDENT" {
        return empty;
    }
    if a64_tok_t(toks, i + 5) != "println" || a64_tok_k(toks, i + 6) != "LPAREN" {
        return empty;
    }
    if a64_tok_k(toks, i + 7) != "IDENT" || a64_tok_t(toks, i + 7) != fname { return empty;
    }
    if a64_tok_k(toks, i + 8) != "LPAREN" || a64_tok_k(toks, i + 9) != "STRING" {
        return empty;
    }
    let arg: String = a64_tok_t(toks, i + 9);
    if a64_tok_k(toks, i + 10) != "RPAREN" || a64_tok_k(toks, i + 11) != "RPAREN" {
        return empty;
    }
    let mut p = i + 12;
    if p < n && a64_tok_k(toks, p) == "SEMI" {
        p = p + 1;
    }
    if p >= n || a64_tok_k(toks, p) != "RBRACE" {
        return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, arg);
    return o;
}

pub fn aarch64_match_greet_call(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) <= 0 { return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut fname = "";
    let mut pre = "";
    let mut suf = "";
    let mut i = 0;
    while i < n { if a64_tok_k(toks, i) == "KW_FN" { if i + 1 >= n || a64_tok_k(toks, i + 1) != "IDENT" { return empty;
    }
            let nm: String = a64_tok_t(toks, i + 1);
            if nm != "main" {
                let idn: List[String] = aarch64_greet_shape(toks, n, i);
                if list_len(idn) < 3 { return empty;
                }
                if chars_len(fname) > 0 { return empty;
                }
                fname = list_get(idn, 0);
                pre = list_get(idn, 1);
                suf = list_get(idn, 2);
            }
        }
        i = i + 1;
    }
    if chars_len(fname) <= 0 { return empty;
    }
    let mut arg = "";
    let mut saw = false;
    i = 0;
    while i < n { if a64_tok_k(toks, i) == "KW_FN" { if i + 1 < n && a64_tok_k(toks, i + 1) == "IDENT" { if a64_tok_t(toks, i + 1) == "main" { if saw { return empty;
    }
                    let mb: List[String] = aarch64_greet_main(toks, n, i, fname);
                    if list_len(mb) < 1 { return empty;
                    }
                    arg = list_get(mb, 0);
                    saw = true;
                }
            }
        }
        i = i + 1;
    }
    if !saw { return empty;
    }
    let mut o: List[String] = list_new();
    o = list_push(o, fname);
    o = list_push(o, pre);
    o = list_push(o, arg);
    o = list_push(o, suf);
    return o;
}

pub fn aarch64_emit_greet_call(fname: String, pre: String, name: String, suf: String) {
    let lp = bytes_len(pre);
    let ln = bytes_len(name);
    let ls = bytes_len(suf);
    if lp + ln + ls + 1 > 4096 { println("ERR\taarch64_emit\tgreet buf");
    process_exit(1);
    }
    println("# openOODA aarch64 product floor (GAS, Linux, clang -target aarch64-linux-gnu)");
    println("    .arch armv8-a");
    println("    .section .rodata\n    .p2align 3");
    println(".Lpre:\n    .ascii \"" + aarch64_ascii_esc(pre) + "\"");
    println(".Lnm:\n    .ascii \"" + aarch64_ascii_esc(name) + "\"");
    println(".Lsuf:\n    .ascii \"" + aarch64_ascii_esc(suf) + "\"");
    println("    .section .bss\n    .p2align 3\n.Lbuf:\n    .skip 4096");
    println("    .section .text\n    .globl _start\n    .globl main\n    .globl " + fname + "\n    .p2align 2");
    println(".Lcpy:\n    cbz x2, .Lcpy_done");
    println(".Lcpy_loop:\n    ldrb w3, [x0], #1\n    strb w3, [x1], #1\n    sub x2, x2, #1\n    cbnz x2, .Lcpy_loop");
    println(".Lcpy_done:\n    ret");
    println(fname + ":\n    stp x29, x30, [sp, #-16]!\n    mov x29, sp");
    println("    mov x4, x0");
    println("    adrp x0, .Lpre\n    add x0, x0, :lo12:.Lpre");
    println("    adrp x1, .Lbuf\n    add x1, x1, :lo12:.Lbuf");
    println("    mov x2, #" + lp.to_string() + "\n    bl .Lcpy");
    println("    mov x0, x4");
    println("    adrp x1, .Lbuf\n    add x1, x1, :lo12:.Lbuf\n    add x1, x1, #" + lp.to_string());
    println("    mov x2, #" + ln.to_string() + "\n    bl .Lcpy");
    println("    adrp x0, .Lsuf\n    add x0, x0, :lo12:.Lsuf");
    println("    adrp x1, .Lbuf\n    add x1, x1, :lo12:.Lbuf\n    add x1, x1, #" + i2s(lp + ln));
    println("    mov x2, #" + ls.to_string() + "\n    bl .Lcpy");
    println("    adrp x0, .Lbuf\n    add x0, x0, :lo12:.Lbuf\n    add x0, x0, #" + i2s(lp + ln + ls));
    println("    mov w1, #10\n    strb w1, [x0]");
    println("    adrp x0, .Lbuf\n    add x0, x0, :lo12:.Lbuf");
    println("    ldp x29, x30, [sp], #16\n    ret");
    println("main:\n    stp x29, x30, [sp, #-16]!\n    mov x29, sp");
    println("    adrp x0, .Lnm\n    add x0, x0, :lo12:.Lnm");
    println("    bl " + fname);
    println("    mov x1, x0\n    mov x0, #1");
    println("    mov x2, #" + i2s(lp + ln + ls + 1) + "\n    mov x8, #64");
    println("    svc #0");
    println("    mov x0, #0\n    ldp x29, x30, [sp], #16\n    ret");
    println("_start:\n    mov x0, #0\n    mov x8, #93\n    svc #0");
}
