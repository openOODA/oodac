// # aarch64 SECRET taint enforcement
//
// Logline: Mirrors C emit secret taint check for the aarch64 path: parse secret directives, walk tokens for sink calls, and refuse any tainted arguments.
//
// Setup: tokenize_lines lives in token_fmt.oo; a64_tok_k / a64_tok_t live in aarch64_emit_harv.oo. Closes the same gap as x86_emit_secret.oo so the aarch64 path refuses the 58 fixtures today silently compiled.
//
// Beats:
//   1. aarch64_collect_secret_env parses line-start secret directives and returns a flat env of `__sec__<name>=1;` entries.
//   2. aarch64_collect_secret_uses walks tokens and finds tainted ident args in println / write_file / fetch / sys_exec / process_exec / env_get.
//   3. aarch64_check_secret_sinks combines 1 + 2; returns error messages.
//   4. aarch64_emit_secret_test is the public entry point the dispatch will call.
//
// residual: net/FFI sinks, __alias__ rebinds, sticky-clear protection, #[Secret] attr, full IFC — these live in the C emit and are not mirrored here.

import "aarch64_emit_const_harvest.oo";

// Parse line-start secret directives. Verbatim of c_parse_secret_env
// (oodac/c_emit_secret.oo:14-86), but returns a flat env string of the form
// `__sec__<name>=1;__sec__<name2>=1;...` instead of going through c_env_put, so
// the taint-presence check is a single str_contains.
pub fn aarch64_collect_secret_env(src: String) -> String {
    let needle: String = "// " + "SECRET:";
    let nn: Int = chars_len(needle);
    let sn: Int = chars_len(src);
    let mut env: String = "";
    let mut i: Int = 0;
    while i + nn <= sn {
        let mut at_line: Bool = false;
        if i == 0 || char_at(src, i - 1) == "\n" {
            at_line = true;
        }
        if at_line {
            let mut ok: Bool = true;
            let mut j: Int = 0;
            while j < nn {
                if char_at(src, i + j) != char_at(needle, j) {
                    ok = false;
                    j = nn;
                } else {
                    j = j + 1;
                }
            }
            if ok {
                let mut k: Int = i + nn;
                while k < sn {
                    let c: String = char_at(src, k);
                    if c == " " || c == "\t" {
                        k = k + 1;
                    } else {
                        break;
                    }
                }
                let start: Int = k;
                while k < sn {
                    let c: String = char_at(src, k);
                    let is_al: Bool = c == "_" || c == "a" || c == "b" || c == "c" || c == "d"
                        || c == "e" || c == "f" || c == "g" || c == "h" || c == "i"
                        || c == "j" || c == "k" || c == "l" || c == "m" || c == "n"
                        || c == "o" || c == "p" || c == "q" || c == "r" || c == "s"
                        || c == "t" || c == "u" || c == "v" || c == "w" || c == "x"
                        || c == "y" || c == "z" || c == "A" || c == "B" || c == "C"
                        || c == "D" || c == "E" || c == "F" || c == "G" || c == "H"
                        || c == "I" || c == "J" || c == "K" || c == "L" || c == "M"
                        || c == "N" || c == "O" || c == "P" || c == "Q" || c == "R"
                        || c == "S" || c == "T" || c == "U" || c == "V" || c == "W"
                        || c == "X" || c == "Y" || c == "Z" || c == "0" || c == "1"
                        || c == "2" || c == "3" || c == "4" || c == "5" || c == "6"
                        || c == "7" || c == "8" || c == "9";
                    if is_al {
                        k = k + 1;
                    } else {
                        break;
                    }
                }
                let name: String = str_slice(src, start, k);
                if name == "" {
                    // Mirrors C: empty ident is a hard error.
                    return "__secret_err__" + "empty ident after secret directive";
                }
                env = env + "__sec__" + name + "=1;";
                i = k;
            } else {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return env;
}

// True when the flat env marks `name` as tainted (`__sec__<name>=1;`).
fn aarch64_secret_is_tainted(env: String, name: String) -> Bool {
    let needle: String = "__sec__" + name + "=1;";
    return str_contains(env, needle);
}

// Walk tokens for sink calls. Records each (kind, ident) pair as
// "<sink> <ident>" where ident is a tainted bare IDENT in the sink's args.
// Covers println (arg 0), write_file (any arg), fetch (arg 0),
// sys_exec / process_exec (any arg), env_get (arg 0). Bare LPAREN at i+1
// required (a bare `let w = write_file` must not scan the rest of the file).
pub fn aarch64_collect_secret_uses(src: String, toks: List[String]) -> List[String] {
    let env: String = aarch64_collect_secret_env(src);
    if str_starts_with(env, "__secret_err__") {
        let mut errs: List[String] = list_new();
        errs = list_push(errs, env);
        return errs;
    }
    let mut out: List[String] = list_new();
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i < n {
        let k: String = a64_tok_k(toks, i);
        if k == "IDENT" {
            let name: String = a64_tok_t(toks, i);
            if name == "println" || name == "write_file" || name == "fetch"
                || name == "sys_exec" || name == "process_exec" || name == "env_get" {
                if i + 1 < n && a64_tok_k(toks, i + 1) == "LPAREN" {
                    let mut p: Int = i + 2;
                    let mut depth: Int = 1;
                    while p < n && depth > 0 {
                        let kk: String = a64_tok_k(toks, p);
                        if kk == "LPAREN" {
                            depth = depth + 1;
                            p = p + 1;
                        } else if kk == "RPAREN" {
                            depth = depth - 1;
                            p = p + 1;
                        } else if kk == "IDENT" && depth == 1 {
                            let arg_name: String = a64_tok_t(toks, p);
                            if aarch64_secret_is_tainted(env, arg_name) {
                                out = list_push(out, name + " " + arg_name);
                            }
                            p = p + 1;
                        } else {
                            p = p + 1;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return out;
}

// Tokenize, walk, and return error messages for every (kind, ident) leak.
// Empty list means the source is clean under the SECRET taint rule.
// Honors the refuse-don't-miscompile policy: on shape mismatch (empty src or
// non-list token), return an empty list so the dispatch can fall through to
// its own ERR. Never fabricate error output.
pub fn aarch64_check_secret_sinks(src: String) -> List[String] {
    let total: Int = chars_len(src);
    if total == 0 {
        let mut empty: List[String] = list_new();
        return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    if n == 0 {
        let mut empty: List[String] = list_new();
        return empty;
    }
    let uses: List[String] = aarch64_collect_secret_uses(src, toks);
    let m: Int = list_len(uses);
    if m == 0 {
        let mut empty: List[String] = list_new();
        return empty;
    }
    let mut errs: List[String] = list_new();
    let mut i: Int = 0;
    while i < m {
        let u: String = list_get(uses, i);
        let ulen: Int = chars_len(u);
        let mut space_at: Int = -1;
        let mut j: Int = 0;
        while j < ulen {
            if char_at(u, j) == " " {
                space_at = j;
                j = ulen;
            } else {
                j = j + 1;
            }
        }
        if space_at > 0 {
            let kind: String = str_slice(u, 0, space_at);
            let ident: String = str_slice(u, space_at + 1, ulen);
            errs = list_push(errs, "ERR\tsecret\t" + kind + " sink refuses SECRET " + ident);
        }
        i = i + 1;
    }
    return errs;
}

// Public entry point the dispatch in aarch64_emit.oo calls before the
// dispatch ladder. If the list is non-empty, the dispatch prints each
// message and exits.
pub fn aarch64_emit_secret_test(src: String) -> List[String] {
    return aarch64_check_secret_sinks(src);
}
