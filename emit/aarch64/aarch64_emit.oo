// # Emit Linux AArch64 GAS assembly
//
// Logline: Parses OpenOODA source and writes freestanding Linux AArch64 GAS assembly.
//
// Setup: tokenize_lines, harvest helpers, and aarch64_emit_linux exist. No x86/wasm/llvm/c_emit import.
//
// Beats:
//   1. Tokenize source into token stream.
//   2. Collect println STRING/ident/int consts inside fn main.
//   3. Refuse leftover println forms and write the Linux AArch64 assembly program.


import "aarch64_emit_sys.oo";

import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_if.oo";

import "aarch64_emit_cond.oo";

import "aarch64_emit_bind.oo";

import "aarch64_emit_take.oo";

import "aarch64_emit_diag.oo";

import "aarch64_emit_secret.oo";

import "aarch64_emit_contract.oo";

import "aarch64_emit_let.oo";

import "aarch64_emit_typed_let.oo";

import "aarch64_emit_int.oo";

import "aarch64_emit_alu.oo";

import "aarch64_emit_float.oo";

import "aarch64_emit_struct.oo";

import "aarch64_emit_match.oo";

import "aarch64_emit_str.oo";

import "aarch64_emit_fn.oo";

import "aarch64_emit_multi.oo";

import "aarch64_emit_opt.oo";

import "aarch64_emit_loop.oo";

import "aarch64_emit_free.oo";

import "aarch64_emit_for.oo";

import "aarch64_emit_frame.oo";

import "aarch64_emit_fold.oo";

import "aarch64_emit_heap.oo";

import "aarch64_emit_mut.oo";

import "aarch64_emit_rec.oo";

import "aarch64_emit_walk.oo";

import "aarch64_emit_list.oo";

import "aarch64_abi_helpers.oo";


fn a64_collect_prints(toks: List[String]) -> List[String] {
    let n: Int = list_len(toks);
    let mut msgs: List[String] = list_new();
    let mut bnames: List[String] = list_new();
    let mut bvals: List[String] = list_new();
    let mut inames: List[String] = list_new();
    let mut ivals: List[String] = list_new();
    let mut saw_main: Bool = false;
    let mut leftover: Bool = false;
    let mut await_main_brace: Bool = false;
    let mut in_main: Bool = false;
    let mut depth: Int = 0;
    let mut skip_ats: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let k: String = a64_tok_k(toks, i);
        if k == "KW_FN" {
            if i + 1 < n && a64_tok_k(toks, i + 1) == "IDENT" {
                bnames = list_new(); bvals = list_new(); inames = list_new(); ivals = list_new();
                if a64_tok_t(toks, i + 1) == "main" { saw_main = true; await_main_brace = true; }
            }
        }
        if in_main && k == "KW_IF" {
            let cond: String = a64_if_cond(toks, n, i, inames, ivals, bnames, bvals);
            if cond == "other" { leftover = true; i = a64_skip_if(toks, n, i); }
            else if cond == "false" { i = a64_after_false_then(toks, n, i); }
            else { skip_ats = list_push(skip_ats, depth); i = a64_after_if_head(toks, n, i); }
        } else if in_main && k == "KW_LET" {
            let typed: List[String] = aarch64_match_let(toks, n, i);
            if list_len(typed) == 2 { inames = list_push(inames, list_get(typed, 0)); ivals = list_push(ivals, list_get(typed, 1)); } else {
                let rec: List[String] = a64_record_let(toks, n, i, bnames, bvals, inames, ivals);
                if list_len(rec) == 3 {
                    if list_get(rec, 0) == "s" { bnames = list_push(bnames, list_get(rec, 1)); bvals = list_push(bvals, list_get(rec, 2)); }
                    else { inames = list_push(inames, list_get(rec, 1)); ivals = list_push(ivals, list_get(rec, 2)); }
                } else {
                    let bind: List[String] = aarch64_apply_let(toks, n, i, bnames, bvals, inames, ivals);
                    if list_len(bind) == 3 {
                        if list_get(bind, 0) == "S" { bnames = list_push(bnames, list_get(bind, 1)); bvals = list_push(bvals, list_get(bind, 2)); }
                        else { inames = list_push(inames, list_get(bind, 1)); ivals = list_push(ivals, list_get(bind, 2)); }
                    }
                }
            }
            i = i + 1;
        } else if await_main_brace && k == "LBRACE" {
            in_main = true; depth = 1; await_main_brace = false; i = i + 1;
        } else {
            let mut hop: Bool = false;
            if in_main {
                if k == "LBRACE" { depth = depth + 1; }
                if k == "RBRACE" {
                    depth = depth - 1;
                    if list_len(skip_ats) >= 1 {
                        if depth == a64_ilist_last(skip_ats) {
                            skip_ats = a64_ilist_pop(skip_ats);
                            if i + 1 < n && a64_tok_k(toks, i + 1) == "KW_ELSE" { i = a64_skip_else(toks, n, i + 1); hop = true; }
                        }
                    }
                    if depth <= 0 { in_main = false; depth = 0; }
                }
                if k == "KW_LET" {
                    let rec: List[String] = a64_record_let(toks, n, i, bnames, bvals, inames, ivals);
                    if list_len(rec) == 3 {
                        if list_get(rec, 0) == "s" { bnames = list_push(bnames, list_get(rec, 1)); bvals = list_push(bvals, list_get(rec, 2)); }
                        else { inames = list_push(inames, list_get(rec, 1)); ivals = list_push(ivals, list_get(rec, 2)); }
                    }
                }
            }
            if k == "IDENT" && a64_tok_t(toks, i) == "println" {
                if in_main {
                    let got: List[String] = a64_take_println(toks, n, i, bnames, bvals, inames, ivals);
                    if list_len(got) >= 1 { msgs = list_push(msgs, list_get(got, 0)); } else { leftover = true; }
                } else { leftover = true; }
            }
            if !hop { i = i + 1; }
        }
    }
    if !saw_main { println("ERR\taarch64_emit\tresidual: need fn main"); process_exit(1); }
    if leftover { println("ERR\taarch64_emit\tleftover println"); process_exit(1); }
    return msgs;
}

pub fn aarch64_emit_stream(src: String) {
    let contract_errs: List[String] = aarch64_emit_contract_test(src);
    if list_len(contract_errs) > 0 {
        let mut i: Int = 0; while i < list_len(contract_errs) { println(list_get(contract_errs, i)); i = i + 1; }
        process_exit(1);
    }
    let diag_errs: List[String] = aarch64_emit_diag_test(src);
    if list_len(diag_errs) > 0 {
        let mut i: Int = 0; while i < list_len(diag_errs) { println(list_get(diag_errs, i)); i = i + 1; }
        process_exit(1);
    }
    if chars_len(src) == 0 { println("ERR\taarch64_emit\tempty"); process_exit(1); }
    let toks: List[String] = tokenize_lines(src);
    let secret_errs: List[String] = aarch64_emit_secret_test(src);
    if list_len(secret_errs) > 0 {
        let mut i: Int = 0; while i < list_len(secret_errs) { println(list_get(secret_errs, i)); i = i + 1; }
        process_exit(1);
    }
    let if_errs: List[String] = aarch64_emit_if_test(src);
    if list_len(if_errs) > 0 {
        let mut i: Int = 0; while i < list_len(if_errs) { println(list_get(if_errs, i)); i = i + 1; }
        process_exit(1);
    }
    let lib: String = aarch64_emit_library(src);
    if chars_len(lib) > 0 { println(lib); return; }
    let iw: List[String] = aarch64_match_int_write(src); if list_len(iw) >= 1 { aarch64_emit_int_write(list_get(iw, 0)); return; }
    let al: List[String] = aarch64_match_alu(src); if list_len(al) >= 1 { aarch64_emit_alu(list_get(al, 0)); return; }
    let fl: List[String] = aarch64_match_float_test(src);
    if list_len(fl) >= 1 {
        let fr_fl: List[String] = aarch64_collect_and_emit_float(src); if list_len(fr_fl) >= 1 { return; }
        // empty collect: do not steal-fail; fall through
    }
    let sw: List[String] = aarch64_match_str_call(src); if list_len(sw) >= 3 { aarch64_emit_str_call(list_get(sw, 0), list_get(sw, 1), list_get(sw, 2)); return; }
    let ic: List[String] = aarch64_match_id_call(src); if list_len(ic) >= 2 { aarch64_emit_id_call(list_get(ic, 0), list_get(ic, 1)); return; }
    let mm: List[String] = aarch64_match_match(src); if list_len(mm) >= 1 { aarch64_emit_match(mm); return; }
    let wl: List[String] = aarch64_match_while_loop(src); if list_len(wl) >= 4 { aarch64_emit_while_loop(wl); return; }
    let fz: List[String] = aarch64_match_for_test(src); if list_len(fz) >= 2 { aarch64_emit_for_test(fz); return; }
    let fr: List[String] = aarch64_match_free_test(src); if list_len(fr) >= 2 { aarch64_emit_free_test(list_get(fr, 0), list_get(fr, 1)); return; }
    let hp: List[String] = aarch64_match_heap_test(src); if list_len(hp) >= 1 { aarch64_emit_heap_test(); return; }
    let opt: List[String] = aarch64_match_opt(src); if list_len(opt) >= 2 { aarch64_emit_opt_program(list_get(opt, 0), list_get(opt, 1)); return; }
    let m_m: List[String] = aarch64_match_multi_main(src); if list_len(m_m) >= 3 { aarch64_emit_multi_main(list_get(m_m, 0), list_get(m_m, 1), list_get(m_m, 2)); return; }
    let ml: List[String] = aarch64_match_mut_local(src); if list_len(ml) >= 2 { aarch64_emit_mut_local(list_get(ml, 0), list_get(ml, 1)); return; }
    let fold: String = aarch64_fold_hello(src); if chars_len(fold) > 0 { let mut one: List[String] = list_new(); one = list_push(one, fold); aarch64_emit_linux(one); return; }
    let st: List[String] = aarch64_match_struct(src); if list_len(st) >= 1 { aarch64_emit_struct(src); return; }
    let rec: List[String] = aarch64_match_rec(src); if list_len(rec) >= 5 { aarch64_emit_rec(list_get(rec, 0), list_get(rec, 1), list_get(rec, 2), list_get(rec, 3), list_get(rec, 4)); return; }
    let tl: List[String] = aarch64_match_typed_let(src); if list_len(tl) == 2 { aarch64_emit_typed_let(list_get(tl, 0), list_get(tl, 1)); return; }
    let lt: List[String] = aarch64_match_list(src); if list_len(lt) >= 2 { aarch64_emit_list_program(src); return; }
    let fr_t: List[String] = aarch64_match_frame_test(src); if list_len(fr_t) >= 1 { aarch64_emit_frame_test(); return; }
    let wk: List[String] = aarch64_collect_prints(src); if list_len(wk) >= 1 { aarch64_emit_walk(wk); return; }
    let msgs: List[String] = a64_collect_prints(toks);
    if list_len(msgs) >= 1 { aarch64_emit_linux(msgs); return; }
    println("ERR\taarch64_emit\tresidual");
    process_exit(1);
}
