// # Emit AArch64 recursive function calls and stack spilling
//
// Logline: Lowers recursive function definitions and call trees with stack frame allocation and register spilling for AArch64 GAS.
//
// Setup: tokenize_lines, a64_tok_k, a64_tok_t, and aarch64_emit_int_routine exist.
//
// Beats:
//   1. Match recursive function fn fib(n: Int) -> Int with base condition and dual recursive call.
//   2. Match caller in main invoking fib(N) and printing integer result.
//   3. Emit stack frame preserving x0 at [x29, #16], spilling first call result at [x29, #24], adding calls.
//   4. Emit main calling fib and _println_int.


import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_int.oo";


fn aarch64_match_rec_fn(toks: List[String], n: Int, i: Int) -> List[String] {
    let empty: List[String] = list_new();
    if i + 25 >= n || a64_tok_k(toks, i) != "KW_FN" || a64_tok_k(toks, i + 1) != "IDENT" { return empty;
    }
    let fname: String = a64_tok_t(toks, i + 1);
    if fname == "main" || a64_tok_k(toks, i + 2) != "LPAREN" || a64_tok_k(toks, i + 3) != "IDENT" { return empty;
    }
    let pname: String = a64_tok_t(toks, i + 3);
    if a64_tok_k(toks, i + 4) != "COLON" || a64_tok_k(toks, i + 5) != "IDENT" || a64_tok_t(toks, i + 5) != "Int" { return empty;
    }
    if a64_tok_k(toks, i + 6) != "RPAREN" || a64_tok_k(toks, i + 7) != "ARROW" || a64_tok_k(toks, i + 8) != "IDENT" { return empty;
    }
    if a64_tok_t(toks, i + 8) != "Int" || a64_tok_k(toks, i + 9) != "LBRACE" { return empty;
    }
    let mut p = i + 10;
    while p < n && a64_tok_k(toks, p) != "KW_IF" && a64_tok_k(toks, p) != "RBRACE" { p = p + 1;
    }
    if p >= n || a64_tok_k(toks, p) != "KW_IF" { return empty;
    }
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "IDENT" || a64_tok_t(toks, p) != pname { return empty;
    }
    p = p + 1;
    if p >= n { return empty;
    }
    let cmp_op: String = a64_tok_k(toks, p);
    if cmp_op != "LTE" && cmp_op != "LT" && cmp_op != "EQEQ" && cmp_op != "LE" { return empty;
    }
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "INT" { return empty;
    }
    let base_thresh: String = a64_tok_t(toks, p);
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "LBRACE" { return empty;
    }
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "KW_RETURN" { return empty;
    }
    p = p + 1;
    if p >= n || (a64_tok_k(toks, p) != "IDENT" && a64_tok_k(toks, p) != "INT") { return empty;
    }
    p = p + 1;
    if p < n && a64_tok_k(toks, p) == "SEMI" { p = p + 1;
    }
    if p >= n || a64_tok_k(toks, p) != "RBRACE" { return empty;
    }
    p = p + 1;
    while p < n && a64_tok_k(toks, p) != "KW_RETURN" && a64_tok_k(toks, p) != "RBRACE" { p = p + 1;
    }
    if p >= n || a64_tok_k(toks, p) != "KW_RETURN" { return empty;
    }
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "IDENT" || a64_tok_t(toks, p) != fname { return empty;
    }
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "LPAREN" { return empty;
    }
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "IDENT" || a64_tok_t(toks, p) != pname { return empty;
    }
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "MINUS" { return empty;
    }
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "INT" { return empty;
    }
    let off1: String = a64_tok_t(toks, p);
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "RPAREN" || p + 1 >= n || a64_tok_k(toks, p + 1) != "PLUS" { return empty;
    }
    p = p + 2;
    if p >= n || a64_tok_k(toks, p) != "IDENT" || a64_tok_t(toks, p) != fname { return empty;
    }
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "LPAREN" { return empty;
    }
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "IDENT" || a64_tok_t(toks, p) != pname { return empty;
    }
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "MINUS" { return empty;
    }
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "INT" { return empty;
    }
    let off2: String = a64_tok_t(toks, p);
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "RPAREN" { return empty;
    }
    p = p + 1;
    if p < n && a64_tok_k(toks, p) == "SEMI" { p = p + 1;
    }
    if p >= n || a64_tok_k(toks, p) != "RBRACE" { return empty;
    }
    let mut out: List[String] = list_new();
    out = list_push(out, fname);
    out = list_push(out, base_thresh);
    out = list_push(out, off1);
    out = list_push(out, off2);
    return out;
}

fn aarch64_match_rec_main(toks: List[String], n: Int, fname: String) -> String {
    let mut i = 0;
    while i < n {
        if a64_tok_k(toks, i) == "KW_FN" && i + 1 < n && a64_tok_t(toks, i + 1) == "main" {
            let mut p = i + 2;
            while p < n && a64_tok_k(toks, p) != "LBRACE" { p = p + 1;
            }
            if p < n { p = p + 1;
            }
            while p < n && a64_tok_k(toks, p) != "RBRACE" {
                if a64_tok_k(toks, p) == "IDENT" && a64_tok_t(toks, p) == fname { if p + 2 < n && a64_tok_k(toks, p + 1) == "LPAREN" && a64_tok_k(toks, p + 2) == "INT" { return a64_tok_t(toks, p + 2);
                }
                }
                p = p + 1;
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn aarch64_match_rec(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) == 0 { return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n { if a64_tok_k(toks, i) == "KW_FN" { let fn_info: List[String] = aarch64_match_rec_fn(toks, n, i);
    if list_len(fn_info) >= 4 { let fname: String = list_get(fn_info, 0);
    let arg: String = aarch64_match_rec_main(toks, n, fname);
    if chars_len(arg) > 0 { let mut out: List[String] = list_new();
    out = list_push(out, fname);
    out = list_push(out, arg);
    out = list_push(out, list_get(fn_info, 1));
    out = list_push(out, list_get(fn_info, 2));
    out = list_push(out, list_get(fn_info, 3));
    return out;
    }
            }
        }
        i = i + 1;
    }
    return empty;
}

pub fn aarch64_match_fib_test(src: String) -> List[String] {
    let rec: List[String] = aarch64_match_rec(src);
    if list_len(rec) >= 2 { let mut out: List[String] = list_new();
    out = list_push(out, list_get(rec, 1));
    return out;
    }
    return list_new();
}

pub fn aarch64_emit_fib_test(arg: String) {
    aarch64_emit_rec("fib", arg, "1", "1", "2");
}

pub fn aarch64_emit_rec(fname: String, arg: String, base_thresh: String, off1: String, off2: String) {
    println("# openOODA aarch64 product floor (GAS, Linux, clang -target aarch64-linux-gnu)");
    println("    .arch armv8-a");
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    println("    .globl " + fname);
    aarch64_emit_int_routine();
    println("    .p2align 4");
    println(fname + ":");
    println("    stp x29, x30, [sp, #-32]!");
    println("    mov x29, sp");
    println("    str x0, [x29, #16]");
    println("    cmp x0, #" + base_thresh);
    println("    b.gt .L" + fname + "_rec");
    println("    ldr x0, [x29, #16]");
    println("    ldp x29, x30, [sp], #32");
    println("    ret");
    println(".L" + fname + "_rec:");
    println("    ldr x0, [x29, #16]");
    println("    sub x0, x0, #" + off1);
    println("    bl " + fname);
    println("    str x0, [x29, #24]");
    println("    ldr x0, [x29, #16]");
    println("    sub x0, x0, #" + off2);
    println("    bl " + fname);
    println("    ldr x9, [x29, #24]");
    println("    add x0, x9, x0");
    println("    ldp x29, x30, [sp], #32");
    println("    ret");
    println("main:");
    println("_start:");
    println("    mov x0, #" + arg);
    println("    bl " + fname);
    println("    bl _println_int");
    println("    mov x8, #93");
    println("    mov x0, #0");
    println("    svc #0");
}
