// # AArch64 println const harvest walker
//
// Logline: Walks tokens to harvest println consts from a println-using source, or returns [] on shape mismatch.
//
// Setup: tokenize_lines, a64_tok_k, a64_record_let, a64_take_println, a64_if_cond, and aarch64_emit_linux exist.
//
// Beats:
//   1. Shape match: require fn main and at least one println; return [] otherwise.
//   2. Walk tokens to record same-fn lets and lower println consts.
//   3. Return msgs on match, [] on shape mismatch (no fn main, no println, leftover, or empty msgs).
//
// residual: looping while and helper-call minus stay leftover.


import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_take.oo";

import "aarch64_emit_if.oo";

import "aarch64_emit_cond.oo";

import "aarch64_emit_let.oo";

import "aarch64_emit_sys.oo";


// Public matcher: shape-match the source for any println-using form, then walk.
// Returns the const write list on match, [] on shape mismatch (no fn main, no println, leftover, or empty msgs).
pub fn aarch64_collect_prints(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) == 0 { return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    if n < 1 { return empty;
    }
    // Pre-shape match: must have fn main and at least one println.
    let mut saw_main = false;
    let mut saw_println = false;
    let mut i = 0;
    while i < n { let k: String = a64_tok_k(toks, i);
    if k == "KW_FN" && i + 1 < n && a64_tok_k(toks, i + 1) == "IDENT" && a64_tok_t(toks, i + 1) == "main" { saw_main = true;
    }
        if k == "IDENT" && a64_tok_t(toks, i) == "println" {
            saw_println = true;
        }
        i = i + 1;
    }
    if !saw_main || !saw_println { return empty;
    }
    // Walk: accumulate same-fn let binds and println consts.
    let mut msgs: List[String] = list_new();
    let mut bnames: List[String] = list_new();
    let mut bvals: List[String] = list_new();
    let mut inames: List[String] = list_new();
    let mut ivals: List[String] = list_new();
    let mut await_main_brace = false;
    let mut in_main = false;
    let mut depth = 0;
    let mut skip_ats: List[Int] = list_new();
    let mut leftover = false;
    i = 0;
    while i < n { let k: String = a64_tok_k(toks, i);
    if k == "KW_FN" { if i + 1 < n && a64_tok_k(toks, i + 1) == "IDENT" { bnames = list_new();
    bvals = list_new();
    inames = list_new();
    ivals = list_new();
    if a64_tok_t(toks, i + 1) == "main" { await_main_brace = true;
    }
            }
        }
        if in_main && k == "KW_IF" {
            let cond: String = a64_if_cond(toks, n, i, inames, ivals, bnames, bvals);
            if cond == "other" {
                leftover = true;
                i = a64_skip_if(toks, n, i);
            } else if cond == "false" {
                i = a64_after_false_then(toks, n, i);
            } else {
                skip_ats = list_push(skip_ats, depth);
                i = a64_after_if_head(toks, n, i);
            }
        } else if in_main && k == "KW_LET" {
            // Typed-let shape arm (aarch64_emit_let.oo): tries let ident: Int = INT; println(ident).
            // Falls back to a64_record_let for the other let shapes (no type annotation, etc.).
            let typed: List[String] = aarch64_match_let(toks, n, i);
            if list_len(typed) == 2 { inames = list_push(inames, list_get(typed, 0));
            ivals = list_push(ivals, list_get(typed, 1));
            } else {
                let rec: List[String] = a64_record_let(toks, n, i, bnames, bvals, inames, ivals);
                if list_len(rec) == 3 {
                    if list_get(rec, 0) == "s" {
                        bnames = list_push(bnames, list_get(rec, 1));
                        bvals = list_push(bvals, list_get(rec, 2));
                    } else {
                        inames = list_push(inames, list_get(rec, 1));
                        ivals = list_push(ivals, list_get(rec, 2));
                    }
                }
            }
            i = i + 1;
        } else if await_main_brace && k == "LBRACE" {
            in_main = true;
            depth = 1;
            await_main_brace = false;
            i = i + 1;
        } else {
            let mut hop = false;
            if in_main {
                if k == "LBRACE" {
                    depth = depth + 1;
                }
                if k == "RBRACE" {
                    depth = depth - 1;
                    if list_len(skip_ats) >= 1 { if depth == a64_ilist_last(skip_ats) { skip_ats = a64_ilist_pop(skip_ats);
                    if i + 1 < n && a64_tok_k(toks, i + 1) == "KW_ELSE" { i = a64_skip_else(toks, n, i + 1);
                    hop = true;
                    }
                        }
                    }
                    if depth <= 0 { in_main = false;
                    depth = 0;
                    }
                }
                if k == "KW_LET" {
                    let rec: List[String] = a64_record_let(toks, n, i, bnames, bvals, inames, ivals);
                    if list_len(rec) == 3 { if list_get(rec, 0) == "s" { bnames = list_push(bnames, list_get(rec, 1));
                    bvals = list_push(bvals, list_get(rec, 2));
                    } else {
                            inames = list_push(inames, list_get(rec, 1));
                            ivals = list_push(ivals, list_get(rec, 2));
                        }
                    }
                }
            }
            if k == "IDENT" && a64_tok_t(toks, i) == "println" {
                if in_main { let got: List[String] = a64_take_println(toks, n, i, bnames, bvals, inames, ivals);
                if list_len(got) >= 1 { msgs = list_push(msgs, list_get(got, 0));
                } else {
                        leftover = true;
                    }
                } else {
                    leftover = true;
                }
            }
            if !hop { i = i + 1;
            }
        }
    }
    if leftover { return empty;
    }
    if list_len(msgs) < 1 { return empty;
    }
    return msgs;
}

// Public emitter: route the harvested msgs list to aarch64_emit_linux.
pub fn aarch64_emit_walk(msgs: List[String]) {
    aarch64_emit_linux(msgs);
}
