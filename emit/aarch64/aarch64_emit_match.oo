// # AArch64 native pattern match lowering
//
// Logline: Lowers match on tagged union [tag 8B, payload 8B] into AArch64 branches. 2..8 arms of `IDENT [LPAREN IDENT RPAREN] => println(...)`.
//
// Setup: tokenize_lines, a64_tok_k, a64_tok_t, aarch64_emit_int_routine, aarch64_emit_linux.
//
// Beats:
//   1. Match tagged-union construction and N arms (2 <= N <= 8).
//   2. Branch on tag at sp+0 to .Lmatch_case_1..N / default; print payload.
//   3. Refuse malformed arms (return empty). Bound spec list_get (nspec vs 3+2*N).
//

import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_int.oo";


fn aarch64_skip_type(toks: List[String], n: Int, p: Int) -> Int {
    let mut i = p;
    if i < n && a64_tok_k(toks, i) == "COLON" {
        i = i + 1;
        let mut depth = 0;
        while i < n {
            let k: String = a64_tok_k(toks, i);
            if k == "LBRACKET" || k == "LT" { depth = depth + 1; }
            else if k == "RBRACKET" || k == "GT" {
                depth = depth - 1;
                if depth == 0 { return i + 1; }
            } else if depth == 0 && (k == "EQ" || k == "SEMI" || k == "LBRACE" || k == "RPAREN" || k == "COMMA") { return i; }
            i = i + 1;
        }
    }
    return i;
}

fn aarch64_match_one_arm(toks: List[String], n: Int, p: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut q = p;
    if q >= n || a64_tok_k(toks, q) != "IDENT" { return empty; }
    q = q + 1;
    let mut has_payload = false;
    if q < n && a64_tok_k(toks, q) == "LPAREN" {
        q = q + 1;
        if q < n && a64_tok_k(toks, q) == "IDENT" { q = q + 1; }
        if q >= n || a64_tok_k(toks, q) != "RPAREN" { return empty; }
        q = q + 1;
        has_payload = true;
    }
    if q >= n || a64_tok_k(toks, q) != "FATARROW" { return empty; }
    q = q + 1;
    let mut arm_val = "0";
    if q < n && a64_tok_t(toks, q) == "println" {
        q = q + 1;
        if q < n && a64_tok_k(toks, q) == "LPAREN" { q = q + 1; }
        let mut sign = "";
        if q < n && a64_tok_k(toks, q) == "MINUS" { sign = "-"; q = q + 1; }
        if q < n && a64_tok_k(toks, q) == "INT" {
            arm_val = sign + a64_tok_t(toks, q);
            q = q + 1;
        }
        if q < n && a64_tok_k(toks, q) == "RPAREN" { q = q + 1; }
    } else if q < n && (a64_tok_k(toks, q) == "INT" || a64_tok_k(toks, q) == "IDENT") {
        let mut sign = "";
        if q < n && a64_tok_k(toks, q) == "MINUS" { sign = "-"; q = q + 1; }
        if q < n && (a64_tok_k(toks, q) == "INT" || a64_tok_k(toks, q) == "IDENT") {
            arm_val = sign + a64_tok_t(toks, q);
            q = q + 1;
        }
    }
    let mut out: List[String] = list_new();
    if has_payload { out = list_push(out, "P"); out = list_push(out, ""); } else {
        out = list_push(out, "V");
        out = list_push(out, arm_val);
    }
    out = list_push(out, q.to_string());
    return out;
}

pub fn aarch64_match_match(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) == 0 { return empty; }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if a64_tok_k(toks, i) == "KW_FN" && i + 1 < n && a64_tok_t(toks, i + 1) == "main" {
            let mut p = i + 2;
            if p + 2 >= n || a64_tok_k(toks, p) != "LPAREN" || a64_tok_k(toks, p + 1) != "RPAREN" || a64_tok_k(toks, p + 2) != "LBRACE" { return empty; }
            p = p + 3;
            if p + 1 >= n || a64_tok_k(toks, p) != "KW_LET" || a64_tok_k(toks, p + 1) != "IDENT" { return empty; }
            let subj_name: String = a64_tok_t(toks, p + 1);
            p = aarch64_skip_type(toks, n, p + 2);
            if p + 1 >= n || a64_tok_k(toks, p) != "EQ" || a64_tok_k(toks, p + 1) != "IDENT" { return empty; }
            let ctor: String = a64_tok_t(toks, p + 1);
            p = p + 2;
            let mut v1 = "0";
            if ctor == "Some" || ctor == "Ok" {
                if p >= n || a64_tok_k(toks, p) != "LPAREN" { return empty; }
                p = p + 1;
                let mut sign = "";
                if p < n && a64_tok_k(toks, p) == "MINUS" { sign = "-"; p = p + 1; }
                if p >= n || a64_tok_k(toks, p) != "INT" { return empty; }
                v1 = sign + a64_tok_t(toks, p);
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "RPAREN" { return empty; }
                p = p + 1;
            } else if ctor == "None" {
                if p < n && a64_tok_k(toks, p) == "LPAREN" { p = p + 1; if p < n && a64_tok_k(toks, p) == "RPAREN" { p = p + 1; } }
            } else if ctor == "Err" {
                if p >= n || a64_tok_k(toks, p) != "LPAREN" { return empty; }
                p = p + 1;
                if p < n && a64_tok_k(toks, p) == "INT" { v1 = a64_tok_t(toks, p); p = p + 1; }
                if p >= n || a64_tok_k(toks, p) != "RPAREN" { return empty; }
                p = p + 1;
            } else { return empty; }
            if p < n && a64_tok_k(toks, p) == "SEMI" { p = p + 1; }

            if p < n && a64_tok_k(toks, p) == "KW_LET" {
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "IDENT" { return empty; }
                p = aarch64_skip_type(toks, n, p + 1);
                if p >= n || a64_tok_k(toks, p) != "EQ" { return empty; }
                p = p + 1;
            }
            if p + 2 >= n || a64_tok_k(toks, p) != "KW_MATCH" || a64_tok_t(toks, p + 1) != subj_name || a64_tok_k(toks, p + 2) != "LBRACE" { return empty; }
            p = p + 3;
            let mut arm_kinds: List[String] = list_new();
            let mut arm_values: List[String] = list_new();
            let mut default_val = "0";
            let mut arm_count = 0;
            while p < n && a64_tok_k(toks, p) != "RBRACE" {
                let arm: List[String] = aarch64_match_one_arm(toks, n, p);
                if list_len(arm) < 3 { return empty; }
                let kind: String = list_get(arm, 0);
                let val: String = list_get(arm, 1);
                let new_p = parse_int(list_get(arm, 2));
                arm_kinds = list_push(arm_kinds, kind);
                arm_values = list_push(arm_values, val);
                if kind == "V" { default_val = val; }
                arm_count = arm_count + 1;
                if arm_count > 8 { return empty; }
                p = new_p;
                if p < n && (a64_tok_k(toks, p) == "COMMA" || a64_tok_k(toks, p) == "SEMI") { p = p + 1; }
            }
            if arm_count < 2 { return empty; }
            if p >= n || a64_tok_k(toks, p) != "RBRACE" { return empty; }
            p = p + 1;
            if p < n && a64_tok_k(toks, p) == "SEMI" { p = p + 1; }
            if p + 2 < n && a64_tok_k(toks, p) == "IDENT" && a64_tok_t(toks, p) == "println"
                && a64_tok_k(toks, p + 1) == "LPAREN" && a64_tok_k(toks, p + 2) == "IDENT" {
                p = p + 3;
                if p < n && a64_tok_k(toks, p) == "RPAREN" { p = p + 1; }
                if p < n && a64_tok_k(toks, p) == "SEMI" { p = p + 1; }
            }
            if p >= n || a64_tok_k(toks, p) != "RBRACE" { return empty; }
            let mut out: List[String] = list_new();
            out = list_push(out, v1);
            out = list_push(out, arm_count.to_string());
            let mut k = 0;
            while k < arm_count { out = list_push(out, list_get(arm_kinds, k)); out = list_push(out, list_get(arm_values, k)); k = k + 1; }
            out = list_push(out, default_val);
            return out;
        }
        i = i + 1;
    }
    return empty;
}

fn aarch64_emit_mov_x0_match(num_str: String) {
    let v: Int = parse_int(num_str);
    if v >= 0 && v <= 65535 { println("    mov x0, #" + v.to_string()); return; }
    let mut u: Int = v;
    let mut neg = false;
    if u < 0 { neg = true; u = 0 - u; }
    let lo = u % 65536;
    let hi = u / 65536;
    if neg { println("    mov x0, #0"); println("    movk x0, #" + i2s(65536 - lo) + ", lsl #0"); if hi > 0 { println("    movk x0, #" + i2s(65536 - hi) + ", lsl #16"); }
        return;
    }
    println("    movz x0, #" + lo.to_string() + ", lsl #0");
    if hi > 0 { println("    movk x0, #" + hi.to_string() + ", lsl #16"); }
}
pub fn aarch64_emit_match(spec: List[String]) {
    let nspec: Int = list_len(spec);
    if nspec < 7 { println("ERR\taarch64_emit\tmatch: spec too short"); process_exit(1); }
    let mut wrote: Int = 0;
    let v1: String = list_get(spec, 0);
    let arm_count = parse_int(list_get(spec, 1));
    if arm_count < 2 || arm_count > 8 || nspec < 3 + 2 * arm_count { println("ERR\taarch64_emit\tmatch: spec too short"); process_exit(1); }
    let default_val: String = list_get(spec, 2 + 2 * arm_count);
    println("# openOODA aarch64 product floor (GAS, Linux, clang -target aarch64-linux-gnu)");
    println("    .arch armv8-a\n    .section .text\n    .globl _start\n    .globl main\n    .p2align 2");
    aarch64_emit_int_routine();
    println("main:\n_start:\n    stp x29, x30, [sp, #-48]!\n    mov x29, sp");
    aarch64_emit_mov_x0_match(v1);
    println("    str x0, [sp, #8]\n    mov x0, #1\n    str x0, [sp, #0]\n    add x0, sp, #0\n    ldr x1, [x0]");
    let mut c = 0;
    while c < arm_count { let tag = c + 1; println("    cmp x1, #" + tag.to_string() + "\n    b.eq .Lmatch_case_" + tag.to_string()); c = c + 1; }
    println("    b .Lmatch_default");
    c = 0;
    while c < arm_count { let kind: String = list_get(spec, 2 + 2 * c); let val: String = list_get(spec, 2 + 2 * c + 1); let tag = c + 1; if kind == "P" { println(".Lmatch_case_" + tag.to_string() + ":\n    ldr x0, [sp, #8]\n    str x0, [sp, #16]\n    ldr x0, [sp, #16]\n    b .Lmatch_end"); } else {
            println(".Lmatch_case_" + tag.to_string() + ":");
            aarch64_emit_mov_x0_match(val);
            println("    b .Lmatch_end");
        }
        c = c + 1;
    }
    println(".Lmatch_default:");
    aarch64_emit_mov_x0_match(default_val);
    println("    b .Lmatch_end");
    wrote = wrote + 1;
    println(".Lmatch_end:\n    str x0, [sp, #24]\n    ldr x0, [sp, #24]\n    bl _println_int");
    if wrote == 0 { println("ERR\taarch64_emit\tmatch: body produced no write syscall; add a match arm that observes the subject value"); process_exit(1); }
    println("    ldp x29, x30, [sp], #48\n    mov x8, #93\n    mov x0, #0\n    svc #0");
}
