// # Leftover / need-fn-main gate for emit-aarch64 (Phase D)
//
// Logline: KW_FN+IDENT main required; leftover println (outside main, or ident not a literal bind) is typed ERR.
//
// Setup: tokenize_lines + a64_tok_k/t. fold_hello is a handled greet-concat shape, not leftover.
//
// Beats:
//   1. No fn main → need fn main with --> / ^.
//   2. println outside main or println of a non-literal ident → leftover.
//   3. Empty string means the unit may lower.


import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_diag.oo";

import "aarch64_emit_fold.oo";


fn a64_td_int(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut v: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "0" { v = v * 10 + 0;
        } else if c == "1" { v = v * 10 + 1;
        }
        else if c == "2" { v = v * 10 + 2;
        } else if c == "3" { v = v * 10 + 3;
        }
        else if c == "4" { v = v * 10 + 4;
        } else if c == "5" { v = v * 10 + 5;
        }
        else if c == "6" { v = v * 10 + 6;
        } else if c == "7" { v = v * 10 + 7;
        }
        else if c == "8" { v = v * 10 + 8;
        } else if c == "9" { v = v * 10 + 9;
        }
        i = i + 1;
    }
    return v;
}

fn a64_gate_diag(kind: String, path: String, src: String, toks: List[String], i: Int, msg: String) -> String {
    let line: Int = a64_td_int(field_at(list_get(toks, i), 1));
let col: Int = a64_td_int(field_at(list_get(toks, i), 2));
return aarch64_diag_emit_with_src(kind, path, line, col, msg, aarch64_diag_src_line(src, line));
}

pub fn aarch64_src_has_main_e(src: String) -> Bool {
    let toks: List[String] = tokenize_lines(src);
let n: Int = list_len(toks);
let mut i: Int = 0;
while i + 1 < n { if a64_tok_k(toks, i) == "KW_FN" && a64_tok_k(toks, i + 1) == "IDENT" && a64_tok_t(toks, i + 1) == "main" { return true;
}
        i = i + 1;
    }
    return false;
}

pub fn aarch64_leftover_gate_e(src: String, path: String) -> String {
    if chars_len(aarch64_fold_hello(src)) > 0 { return "";
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut in_main: Bool = false;
    let mut await_main: Bool = false;
    let mut depth: Int = 0;
    let mut i: Int = 0;
    while i < n { let k: String = a64_tok_k(toks, i);
    if k == "KW_FN" && i + 1 < n && a64_tok_k(toks, i + 1) == "IDENT" { await_main = a64_tok_t(toks, i + 1) == "main";
    in_main = false;
    depth = 0;
    }
        if await_main && k == "LBRACE" { in_main = true;
        await_main = false;
        depth = 1;
        i = i + 1;
        }
        else {
            if in_main && k == "LBRACE" { depth = depth + 1;
            }
            if in_main && k == "RBRACE" { depth = depth - 1;
            if depth <= 0 { in_main = false;
            } }
            if k == "KW_IF" && in_main {
                let mut j: Int = i + 1;
                while j < n && a64_tok_k(toks, j) != "LBRACE" && a64_tok_k(toks, j) != "SEMI" {
                    let tk: String = a64_tok_k(toks, j);
                    if tk == "ANDAND" || tk == "OROR" { return a64_gate_diag("aarch64_emit", path, src, toks, i, "leftover if");
                    }
                    j = j + 1;
                }
                if i + 2 < n && (a64_tok_k(toks, i + 1) == "KW_TRUE" || a64_tok_k(toks, i + 1) == "KW_FALSE") && a64_tok_k(toks, i + 2) != "LBRACE" {
                    return a64_gate_diag("aarch64_emit", path, src, toks, i, "leftover if");
                }
            }
            if k == "FLOAT" && in_main { return a64_gate_diag("aarch64_emit", path, src, toks, i, "leftover float");
            }
            if k == "IDENT" && a64_tok_t(toks, i) == "println" && i + 1 < n && a64_tok_k(toks, i + 1) == "LPAREN" {
                if !in_main { return a64_gate_diag("aarch64_emit", path, src, toks, i, "leftover println");
                }
                if i + 3 < n && a64_tok_k(toks, i + 2) == "MINUS" && a64_tok_k(toks, i + 3) == "IDENT" && i + 4 < n && a64_tok_k(toks, i + 4) == "LPAREN" {
                    return a64_gate_diag("aarch64_emit", path, src, toks, i, "leftover println");
                }
                let mut j: Int = i + 2;
                while j < n && a64_tok_k(toks, j) != "RPAREN" && a64_tok_k(toks, j) != "SEMI" {
                    if a64_tok_k(toks, j) == "FLOAT" { return a64_gate_diag("aarch64_emit", path, src, toks, i, "leftover float");
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }
    return "";
}

pub fn aarch64_leftover_gate_f(src: String, path: String) -> String {
    return aarch64_leftover_gate_e(src, path);
}
