// # AArch64 IEEE-754 scalar encodings
//
// Logline: Returns 32-bit AArch64 words for FADD, FSUB, FMUL, FDIV, FSQRT, FCMP, and FMOV.
//
// Setup: Pure integer encodings. No GNU as or ld.
//
// Beats:
//   1. Encode FADD/FSUB/FMUL/FDIV on D registers.
//   2. Encode FSQRT, FCMP, and FMOV D,D.
//   3. Encode FMOV from GPR, SCVTF, and FCVTZS.

pub fn a64_enc_fadd(rd: Int, rn: Int, rm: Int) -> Int {
    let hi: Int = 30 * 16777216;
let mid: Int = 96 * 65536;
let opc: Int = 40 * 256;
let w_rm: Int = rm * 65536;
let w_rn: Int = rn * 32;
return hi + mid + opc + w_rm + w_rn + rd;
}

pub fn a64_enc_fsub(rd: Int, rn: Int, rm: Int) -> Int {
    let hi: Int = 30 * 16777216;
let mid: Int = 96 * 65536;
let opc: Int = 56 * 256;
let w_rm: Int = rm * 65536;
let w_rn: Int = rn * 32;
return hi + mid + opc + w_rm + w_rn + rd;
}

pub fn a64_enc_fmul(rd: Int, rn: Int, rm: Int) -> Int {
    let hi: Int = 30 * 16777216;
let mid: Int = 96 * 65536;
let opc: Int = 8 * 256;
let w_rm: Int = rm * 65536;
let w_rn: Int = rn * 32;
return hi + mid + opc + w_rm + w_rn + rd;
}

pub fn a64_enc_fdiv(rd: Int, rn: Int, rm: Int) -> Int {
    let hi: Int = 30 * 16777216;
let mid: Int = 96 * 65536;
let opc: Int = 24 * 256;
let w_rm: Int = rm * 65536;
let w_rn: Int = rn * 32;
return hi + mid + opc + w_rm + w_rn + rd;
}

pub fn a64_enc_fsqrt(rd: Int, rn: Int) -> Int {
    let hi: Int = 30 * 16777216;
let mid: Int = 97 * 65536;
let opc: Int = 192 * 256;
let w_rn: Int = rn * 32;
return hi + mid + opc + w_rn + rd;
}

pub fn a64_enc_fmov_d(rd: Int, rn: Int) -> Int {
    let hi: Int = 30 * 16777216;
let mid: Int = 96 * 65536;
let opc: Int = 64 * 256;
let w_rn: Int = rn * 32;
return hi + mid + opc + w_rn + rd;
}

pub fn a64_enc_fcmp(rn: Int, rm: Int) -> Int {
    let hi: Int = 30 * 16777216;
let mid: Int = 96 * 65536;
let opc: Int = 32 * 256;
let w_rm: Int = rm * 65536;
let w_rn: Int = rn * 32;
return hi + mid + opc + w_rm + w_rn;
}

pub fn a64_enc_fmov_from_x(rd: Int, rn: Int) -> Int {
    let hi: Int = 158 * 16777216;
let mid: Int = 103 * 65536;
let w_rn: Int = rn * 32;
return hi + mid + w_rn + rd;
}

pub fn a64_enc_fcvtzs(rd: Int, rn: Int) -> Int {
    let hi: Int = 158 * 16777216;
let mid: Int = 120 * 65536;
let w_rn: Int = rn * 32;
return hi + mid + w_rn + rd;
}

pub fn a64_enc_scvtf(rd: Int, rn: Int) -> Int {
    let hi: Int = 158 * 16777216;
let mid: Int = 98 * 65536;
let w_rn: Int = rn * 32;
return hi + mid + w_rn + rd;
}
