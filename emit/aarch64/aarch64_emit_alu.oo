// # Const-int ALU for emit-aarch64
//
// Logline: Folds decimal plus, minus, times, divide, percent, and one paren group for println and let RHS on aarch64.
//
// Setup: a64_tok_k, a64_tok_t, a64_bind_idx, a64_neg_dec, a64_int_digits, a64_is_alu, and a64_alu_i exist in aarch64_emit_harv.oo and aarch64_emit_num.oo.
//
// Beats:
//   1. Parse a signed decimal to Int; chain PLUS/MINUS/STAR/SLASH/PERCENT.
//   2. Refuse divide by zero and bad decimal digits.
//   3. Fold a parenthesized const-int group as one atom.
//   4. Stop at RPAREN or SEMI so mix concat stays leftover.
//
// residual: IDENT lookups, mut locals, and AAPCS calls stay later.

import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_num.oo";

import "aarch64_emit_int.oo";



pub fn aarch64_is_alu_op(k: String) -> Bool {
    return a64_is_alu(k);
}

pub fn aarch64_parse_dec(s: String) -> List[Int] {
    let empty: List[Int] = list_new();
    let n: Int = bytes_len(s);
    if n <= 0 { return empty;
    }
    let mut i: Int = 0;
    let mut neg: Bool = false;
    if byte_at(s, 0) == 45 { neg = true;
    i = 1;
    }
    if i >= n { return empty;
    }
    let v: Int = 0 + a64_int_digits(byte_slice(s, i, n));
    if v < 0 { return empty;
    }
    let mut acc: Int = v;
    if neg { acc = 0 - acc;
    }
    let mut one: List[Int] = list_new();
    one = list_push(one, acc);
    return one;
}

pub fn aarch64_dec_op(a: String, b: String, op: String) -> List[String] {
    let empty: List[String] = list_new();
    let pa: List[Int] = aarch64_parse_dec(a);
    let pb: List[Int] = aarch64_parse_dec(b);
    if list_len(pa) < 1 { return empty;
    }
    if list_len(pb) < 1 { return empty;
    }
    let r: String = a64_alu_i(op, list_get(pa, 0), list_get(pb, 0));
    if r == "" { return empty;
    }
    let mut one: List[String] = list_new();
    one = list_push(one, r);
    return one;
}

pub fn aarch64_alu_atom(toks: List[String], n: Int, p: Int, inames: List[String], ivals: List[String]) -> List[String] {
    let empty: List[String] = list_new();
    if p >= n { return empty;
    }
    let k: String = a64_tok_k(toks, p);
    if k == "INT" {
        let mut o: List[String] = list_new();
        o = list_push(o, a64_tok_t(toks, p));
        o = list_push(o, "1");
        return o;
    }
    if k == "MINUS" {
        if p + 1 < n && a64_tok_k(toks, p + 1) == "INT" {
            let mut o: List[String] = list_new();
            o = list_push(o, a64_neg_dec(a64_tok_t(toks, p + 1)));
            o = list_push(o, "2");
            return o;
        }
        return empty;
    }
    if k == "LPAREN" {
        let inner: List[String] = aarch64_alu_atom(toks, n, p + 1, inames, ivals);
        if list_len(inner) < 2 { return empty;
        }
        let w0: List[Int] = aarch64_parse_dec(list_get(inner, 1));
        if list_len(w0) < 1 { return empty;
        }
        let mut acc: String = list_get(inner, 0);
        let mut e: Int = p + 1 + list_get(w0, 0);
        while e < n { let nk: String = a64_tok_k(toks, e);
        if nk == "RPAREN" { let mut o: List[String] = list_new();
        o = list_push(o, acc);
        o = list_push(o, i2s(e + 1 - p));
        return o;
        }
            if !aarch64_is_alu_op(nk) { return empty;
            }
            let more: List[String] = aarch64_alu_atom(toks, n, e + 1, inames, ivals);
            if list_len(more) < 2 { return empty;
            }
            let wm: List[Int] = aarch64_parse_dec(list_get(more, 1));
            if list_len(wm) < 1 { return empty;
            }
            let nxt: List[String] = aarch64_dec_op(acc, list_get(more, 0), nk);
            if list_len(nxt) < 1 { return empty;
            }
            acc = list_get(nxt, 0);
            e = e + 1 + list_get(wm, 0);
        }
        return empty;
    }
    if k == "IDENT" {
        if p + 1 < n && a64_tok_k(toks, p + 1) == "LPAREN" { return empty;
        }
        let idx: Int = 0 + a64_bind_idx(inames, a64_tok_t(toks, p));
        if idx < 0 { return empty;
        }
        let mut o: List[String] = list_new();
        o = list_push(o, list_get(ivals, idx));
        o = list_push(o, "1");
        return o;
    }
    return empty;
}

pub fn aarch64_alu_until(toks: List[String], n: Int, j: Int, inames: List[String], ivals: List[String], stop: String) -> List[String] {
    let empty: List[String] = list_new();
    let left: List[String] = aarch64_alu_atom(toks, n, j, inames, ivals);
    if list_len(left) < 2 { return empty;
    }
    let w: List[Int] = aarch64_parse_dec(list_get(left, 1));
    if list_len(w) < 1 { return empty;
    }
    let p: Int = j + list_get(w, 0);
    if p >= n { return empty;
    }
    let op: String = a64_tok_k(toks, p);
    if !aarch64_is_alu_op(op) {
        if a64_tok_k(toks, j) == "LPAREN" && op == stop { let mut one: List[String] = list_new();
        one = list_push(one, list_get(left, 0));
        return one;
        }
        return empty;
    }
    let right: List[String] = aarch64_alu_atom(toks, n, p + 1, inames, ivals);
    if list_len(right) < 2 { return empty;
    }
    let w2: List[Int] = aarch64_parse_dec(list_get(right, 1));
    if list_len(w2) < 1 { return empty;
    }
    let got: List[String] = aarch64_dec_op(list_get(left, 0), list_get(right, 0), op);
    if list_len(got) < 1 { return empty;
    }
    let mut acc: String = list_get(got, 0);
    let mut e: Int = p + 1 + list_get(w2, 0);
    while e < n { let nk: String = a64_tok_k(toks, e);
    if nk == stop { let mut one: List[String] = list_new();
    one = list_push(one, acc);
    return one;
    }
        if !aarch64_is_alu_op(nk) { return empty;
        }
        let more: List[String] = aarch64_alu_atom(toks, n, e + 1, inames, ivals);
        if list_len(more) < 2 { return empty;
        }
        let wm: List[Int] = aarch64_parse_dec(list_get(more, 1));
        if list_len(wm) < 1 { return empty;
        }
        let nxt: List[String] = aarch64_dec_op(acc, list_get(more, 0), nk);
        if list_len(nxt) < 1 { return empty;
        }
        acc = list_get(nxt, 0);
        e = e + 1 + list_get(wm, 0);
    }
    return empty;
}

pub fn aarch64_alu_try(toks: List[String], n: Int, j: Int, inames: List[String], ivals: List[String]) -> List[String] {
    return aarch64_alu_until(toks, n, j, inames, ivals, "RPAREN");
}

pub fn aarch64_match_alu(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) <= 0 { return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    if n < 9 { return empty;
    }
    let mut i: Int = 0;
    while i < n {
        if a64_tok_k(toks, i) == "KW_FN" && i + 1 < n && a64_tok_t(toks, i + 1) == "main" {
            let p: Int = i + 2;
            if p + 5 < n && a64_tok_k(toks, p) == "LPAREN" && a64_tok_k(toks, p + 1) == "RPAREN" && a64_tok_k(toks, p + 2) == "LBRACE" && a64_tok_k(toks, p + 3) == "IDENT" && a64_tok_t(toks, p + 3) == "println" && a64_tok_k(toks, p + 4) == "LPAREN" {
                let mut q: Int = p + 5;
                let mut neg: Bool = false;
                if a64_tok_k(toks, q) == "MINUS" { neg = true;
                q = q + 1;
                }
                if q >= n || a64_tok_k(toks, q) != "INT" { return empty;
                }
                let a_t: String = a64_tok_t(toks, q);
                let a_v: Int = 0 + a64_int_digits(a_t);
                if a_v < 0 { return empty;
                }
                q = q + 1;
                let mut acc_v: Int = a_v;
                while q < n && a64_is_alu(a64_tok_k(toks, q)) {
                    let op: String = a64_tok_k(toks, q);
                    if q + 1 >= n || a64_tok_k(toks, q + 1) != "INT" { return empty;
                    }
                    let b_v: Int = 0 + a64_int_digits(a64_tok_t(toks, q + 1));
                    if b_v < 0 { return empty;
                    }
                    let step: String = a64_alu_i(op, acc_v, b_v);
                    if step == "" { return empty;
                    }
                    acc_v = 0 + a64_int_digits(step);
                    q = q + 2;
                }
                if q >= n || a64_tok_k(toks, q) != "RPAREN" { return empty;
                }
                q = q + 1;
                if q < n && a64_tok_k(toks, q) == "SEMI" { q = q + 1;
                }
                if q < n && a64_tok_k(toks, q) == "RBRACE" {
                    let mut out: List[String] = list_new();
                    if neg { out = list_push(out, a64_neg_dec(acc_v.to_string()));
                    }
                    else { out = list_push(out, acc_v.to_string());
                    }
                    return out;
                }
            }
        }
        i = i + 1;
    }
    return empty;
}

pub fn aarch64_emit_alu(folded: String) {
    aarch64_emit_int_write(folded);
}
