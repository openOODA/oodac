// # AArch64 per-shape matcher for Option[T] write floor
//
// Logline: Validates the let n: Option[T] = opt_some(STRING); println(opt_unwrap_or(n, STRING)) shape and emits a freestanding AArch64 GAS program with a fixed 4096-byte arena and a per-arm wrote counter.
//
// Setup: tokenize_lines, a64_tok_k, a64_tok_t, aarch64_ascii_esc exist. AAPCS64 frame helpers live in aarch64_emit_sys.oo.
//
// Beats:
//   1. aarch64_match_opt walks the source for opt_some and opt_unwrap_or tokens and returns [some, default].
//   2. aarch64_emit_opt_runtime emits the arena allocator plus opt_some, opt_none, opt_is_some, opt_unwrap_or.
//   3. aarch64_emit_opt_program uses a per-arm wrote counter and ERRs when no write syscall was emitted.
//
// residual: nested Option, is_some-only floor, and heap growth past 4088 bytes stay later.


import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_sys.oo";


// Shape walked left-to-right. Returns [some_str, default_str] on a full match, else empty.
pub fn aarch64_match_opt(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) <= 0 { return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut saw_some = false;
    let mut saw_unwrap = false;
    let mut some_str = "";
    let mut default_str = "";
    let mut i = 0;
    while i < n {
        let k: String = a64_tok_k(toks, i);
        let t: String = a64_tok_t(toks, i);
        if k == "IDENT" {
            if t == "opt_some" { saw_some = true;
            }
            if t == "opt_unwrap_or" { saw_unwrap = true;
            }
            if t == "opt_some" && i + 2 < n && a64_tok_k(toks, i + 2) == "STRING" {
                some_str = a64_tok_t(toks, i + 2);
            }
            if t == "opt_unwrap_or" && i + 4 < n && a64_tok_k(toks, i + 4) == "STRING" {
                default_str = a64_tok_t(toks, i + 4);
            }
        }
        i = i + 1;
    }
    if !saw_some || !saw_unwrap { return empty;
    }
    if chars_len(some_str) == 0 || chars_len(default_str) == 0 { return empty;
    }
    let mut out: List[String] = list_new();
    out = list_push(out, some_str);
    out = list_push(out, default_str);
    return out;
}

// Fixed 4088-byte arena in .bss (.Lopt_heap) plus an 8-byte cur pointer (.Lopt_heap_cur).
// opt_alloc returns a 16-byte aligned slot or 0 on overflow.
pub fn aarch64_emit_opt_runtime() {
    println("    .section .bss");
    println("    .p2align 3");
    println(".Lopt_heap_cur:");
    println("    .quad 0");
    println(".Lopt_heap:");
    println("    .skip 4088");
    println("    .section .text");
    println("    .globl opt_alloc");
    println("    .p2align 4");
    println("opt_alloc:");
    println("    adrp x1, .Lopt_heap_cur");
    println("    add x1, x1, :lo12:.Lopt_heap_cur");
    println("    ldr x2, [x1]");
    println("    add x0, x0, #15");
    println("    and x0, x0, #-16");
    println("    add x3, x2, x0");
    println("    cmp x3, #4088");
    println("    b.ls .Lopt_alloc_ok");
    println("    mov x0, #0");
    println("    ret");
    println(".Lopt_alloc_ok:");
    println("    str x3, [x1]");
    println("    adrp x4, .Lopt_heap");
    println("    add x4, x4, :lo12:.Lopt_heap");
    println("    add x0, x4, x2");
    println("    ret");
    println("    .globl opt_some");
    println("    .p2align 4");
    println("opt_some:");
    println("    stp x29, x30, [sp, #-16]!");
    println("    mov x29, sp");
    println("    mov x19, x0");
    println("    mov x0, #16");
    println("    bl opt_alloc");
    println("    cbz x0, .Lopt_fail");
    println("    mov x20, x0");
    println("    mov x0, #1");
    println("    str x0, [x20]");
    println("    str x19, [x20, #8]");
    println("    mov x0, x20");
    println("    ldp x29, x30, [sp], #16");
    println("    ret");
    println("    .globl opt_none");
    println("    .p2align 4");
    println("opt_none:");
    println("    stp x29, x30, [sp, #-16]!");
    println("    mov x29, sp");
    println("    mov x0, #16");
    println("    bl opt_alloc");
    println("    cbz x0, .Lopt_fail");
    println("    mov x1, #0");
    println("    str x1, [x0]");
    println("    str x1, [x0, #8]");
    println("    ldp x29, x30, [sp], #16");
    println("    ret");
    println("    .globl opt_is_some");
    println("    .p2align 4");
    println("opt_is_some:");
    println("    ldr x0, [x0]");
    println("    ret");
    println("    .globl opt_unwrap_or");
    println("    .p2align 4");
    println("opt_unwrap_or:");
    println("    ldr x2, [x0]");
    println("    cbnz x2, .Lopt_unwrap_some");
    println("    mov x0, x1");
    println("    ret");
    println(".Lopt_unwrap_some:");
    println("    ldr x0, [x0, #8]");
    println("    ret");
    println(".Lopt_fail:");
    println("    mov x0, #0");
    println("    ldp x29, x30, [sp], #16");
    println("    ret");
}

// Per-arm wrote counter. wrote increments once for each svc #0 SYS_write that survives a cbnz skip.
// ERRs and process_exit(1) when wrote == 0 so a silent opt_none-only body cannot pass.
pub fn aarch64_emit_opt_program(some_str: String, default_str: String) {
    let mut wrote: Int = 0;
    println("# openOODA aarch64 product floor (GAS, Linux, clang -target aarch64-linux-gnu)");
    println("    .arch armv8-a");
    println("    .section .rodata");
    println("    .p2align 3");
    println(".Lopt_str_some:");
    println("    .ascii \"" + aarch64_ascii_esc(some_str) + "\"");
    println(".Lopt_str_default:");
    println("    .ascii \"" + aarch64_ascii_esc(default_str) + "\"");
    aarch64_emit_opt_runtime();
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    println("    .p2align 2");
    println("main:");
    println("_start:");
    println("    stp x29, x30, [sp, #-16]!");
    println("    mov x29, sp");
    println("    sub sp, sp, #32");
    println("    adrp x0, .Lopt_str_some");
    println("    add x0, x0, :lo12:.Lopt_str_some");
    println("    bl opt_some");
    println("    str x0, [sp, #16]");
    println("    bl opt_none");
    println("    str x0, [sp, #8]");
    println("    ldr x0, [sp, #16]");
    println("    bl opt_is_some");
    println("    cbz x0, .Lopt_skip_some");
    println("    ldr x0, [sp, #16]");
    println("    adrp x1, .Lopt_str_default");
    println("    add x1, x1, :lo12:.Lopt_str_default");
    println("    bl opt_unwrap_or");
    println("    mov x1, x0");
    println("    mov x8, #64");
    println("    mov x0, #1");
    let l_some = chars_len(some_str) + 1;
    println("    mov x2, #" + l_some.to_string());
    println("    svc #0");
    wrote = wrote + 1;
    println(".Lopt_skip_some:");
    println("    ldr x0, [sp, #8]");
    println("    bl opt_is_some");
    println("    cbz x0, .Lopt_skip_none");
    println("    ldr x0, [sp, #8]");
    println("    adrp x1, .Lopt_str_default");
    println("    add x1, x1, :lo12:.Lopt_str_default");
    println("    bl opt_unwrap_or");
    println("    mov x1, x0");
    println("    mov x8, #64");
    println("    mov x0, #1");
    let l_def = chars_len(default_str) + 1;
    println("    mov x2, #" + l_def.to_string());
    println("    svc #0");
    wrote = wrote + 1;
    println(".Lopt_skip_none:");
    if wrote == 0 { println("ERR\taarch64_emit\topt: body produced no write syscall; add an opt_* call that observes the Option value");
    process_exit(1);
    }
    println("    add sp, sp, #32");
    println("    ldp x29, x30, [sp], #16");
    println("    mov x8, #93");
    println("    mov x0, #0");
    println("    svc #0");
}
