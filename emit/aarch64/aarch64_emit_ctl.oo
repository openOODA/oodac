// # Const if and no-arg return scan for emit-aarch64
//
// Logline: Folds if KW_TRUE or KW_FALSE or const-int compare to one println const, and records a no-arg const-return fn name plus value.
//
// Setup: a64_tok_k, a64_tok_t, a64_bind_idx exist in aarch64_emit_harv.oo; a64_read_int, a64_is_cmp, a64_cmp_num exist in aarch64_emit_num.oo.
//
// Beats:
//   1. Scan a brace for println(STRING) or println(INT).
//   2. Take then or else when KW_TRUE, KW_FALSE, or int-ident compare; allow else if and no else.
//   3. Record fn name and return STRING or INT for a no-arg fn.
//
// residual: rsi/frame and while stay later.

import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_num.oo";

// Scan a brace for println(STRING) or println(INT). Returns 1-element list on match, empty on no match.
fn aarch64_scan_print(toks: List[String], n: Int, p: Int) -> List[String] {
    let empty: List[String] = list_new();
    let mut i = p;
    while i < n { let k: String = a64_tok_k(toks, i);
    if k == "RBRACE" { return empty;
    }
        if k == "IDENT" && a64_tok_t(toks, i) == "println" {
            if i + 2 < n && a64_tok_k(toks, i + 1) == "LPAREN" {
                if a64_tok_k(toks, i + 2) == "STRING" || a64_tok_k(toks, i + 2) == "INT" {
                    if i + 3 < n && a64_tok_k(toks, i + 3) == "RPAREN" {
                        let mut one: List[String] = list_new();
                        one = list_push(one, a64_tok_t(toks, i + 2));
                        return one;
                    }
                }
            }
        }
        i = i + 1;
    }
    return empty;
}

// Return the LBRACE position after the if cond, or -1.
fn aarch64_if_lbrace(toks: List[String], n: Int, i: Int) -> Int {
    let mut p = i + 1;
while p < n { if a64_tok_k(toks, p) == "LBRACE" { return p;
}
        p = p + 1;
    }
    return -1;
}

// Return the position after the RBRACE matched from p (or just past p if no LBRACE).
fn aarch64_after_brace(toks: List[String], n: Int, p: Int) -> Int {
    let mut i = p;
if i < n && a64_tok_k(toks, i) == "LBRACE" { i = i + 1;
}
    while i < n { if a64_tok_k(toks, i) == "RBRACE" { return i + 1;
    }
        i = i + 1;
    }
    return i;
}

// Take then or else when cond is KW_TRUE, KW_FALSE, or const INT op INT (with int-ident).
// Returns 2-element [mark, val] on success, empty on shape mismatch.
pub fn aarch64_if_taken_print(toks: List[String], n: Int, i: Int, inames: List[String], ivals: List[String]) -> List[String] {
    let empty: List[String] = list_new();
    if i + 1 >= n { return empty;
    }
    let mut take_then = false;
    let mut lb = -1;
    let k1: String = a64_tok_k(toks, i + 1);
    if k1 == "KW_TRUE" || k1 == "KW_FALSE" {
        take_then = k1 == "KW_TRUE";
        lb = i + 2;
        if lb >= n || a64_tok_k(toks, lb) != "LBRACE" {
            return empty;
        }
    } else {
        let lhs: List[String] = a64_read_int(toks, n, i + 1, inames, ivals);
        if list_len(lhs) < 3 || list_get(lhs, 1) != "ok" {
            return empty;
        }
        let mut p = parse_int(list_get(lhs, 0));
        let ak: String = list_get(lhs, 1);
        let av: String = list_get(lhs, 2);
        if p >= n || !a64_is_cmp(a64_tok_k(toks, p)) {
            return empty;
        }
        let ck: String = a64_tok_k(toks, p);
        let rhs: List[String] = a64_read_int(toks, n, p + 1, inames, ivals);
        if list_len(rhs) < 3 || list_get(rhs, 1) != "ok" {
            return empty;
        }
        let bk: String = list_get(rhs, 1);
        let bv: String = list_get(rhs, 2);
        let rv: String = a64_cmp_num(ck, ak, av, bk, bv);
        if rv != "true" && rv != "false" {
            return empty;
        }
        take_then = rv == "true";
        lb = aarch64_if_lbrace(toks, n, i);
        if lb < 0 { return empty;
        }
    }
    let th: List[String] = aarch64_scan_print(toks, n, lb + 1);
    let after_then = aarch64_after_brace(toks, n, lb);
    let mut mark: List[String] = list_new();
    mark = list_push(mark, "1");
    if after_then < n && a64_tok_k(toks, after_then) == "KW_ELSE" {
        if after_then + 1 < n && a64_tok_k(toks, after_then + 1) == "KW_IF" {
            if take_then { if list_len(th) < 1 { return empty;
            }
                mark = list_push(mark, list_get(th, 0));
                return mark;
            }
            return aarch64_if_taken_print(toks, n, after_then + 1, inames, ivals);
        }
        if after_then + 1 >= n || a64_tok_k(toks, after_then + 1) != "LBRACE" {
            return empty;
        }
        let el: List[String] = aarch64_scan_print(toks, n, after_then + 2);
        if list_len(th) < 1 || list_len(el) < 1 { return empty;
        }
        if take_then { mark = list_push(mark, list_get(th, 0));
        } else {
            mark = list_push(mark, list_get(el, 0));
        }
        return mark;
    }
    if list_len(th) < 1 { return empty;
    }
    if take_then { mark = list_push(mark, list_get(th, 0));
    } else {
        mark = list_push(mark, "");
    }
    return mark;
}

// Return the position after the if/else tree starting at i.
pub fn aarch64_if_after(toks: List[String], n: Int, i: Int) -> Int {
    let lb = aarch64_if_lbrace(toks, n, i);
if lb < 0 { return i + 1;
}
    let after_then = aarch64_after_brace(toks, n, lb);
    if after_then + 1 >= n { return after_then;
    }
    if a64_tok_k(toks, after_then) == "KW_ELSE" {
        if after_then + 1 < n && a64_tok_k(toks, after_then + 1) == "KW_IF" {
            return aarch64_if_after(toks, n, after_then + 1);
        }
        return aarch64_after_brace(toks, n, after_then + 1);
    }
    return after_then;
}

// Record a no-arg fn returning a STRING or INT literal. Returns [fn_name, val] or empty.
pub fn aarch64_fn_const_ret(toks: List[String], n: Int, i: Int) -> List[String] {
    let empty: List[String] = list_new();
    if i + 1 >= n || a64_tok_k(toks, i + 1) != "IDENT" {
        return empty;
    }
    let nm: String = a64_tok_t(toks, i + 1);
    if nm == "main" {
        return empty;
    }
    let mut p = i + 2;
    if p + 1 >= n || a64_tok_k(toks, p) != "LPAREN" {
        return empty;
    }
    if a64_tok_k(toks, p + 1) != "RPAREN" {
        return empty;
    }
    p = p + 2;
    if p < n && a64_tok_k(toks, p) == "ARROW" {
        p = p + 1;
        if p < n && a64_tok_k(toks, p) == "IDENT" {
            p = p + 1;
        }
    }
    if p >= n || a64_tok_k(toks, p) != "LBRACE" {
        return empty;
    }
    p = p + 1;
    if p >= n || a64_tok_k(toks, p) != "KW_RETURN" {
        return empty;
    }
    p = p + 1;
    if p >= n { return empty;
    }
    if a64_tok_k(toks, p) != "STRING" && a64_tok_k(toks, p) != "INT" {
        return empty;
    }
    let val: String = a64_tok_t(toks, p);
    let mut o: List[String] = list_new();
    o = list_push(o, nm);
    o = list_push(o, val);
    return o;
}

// Wire-point gate for the aarch64_emit dispatch. Walks the token stream to detect
// const-if or no-arg const-return shapes; on a match, returns a single ERR line so the
// dispatch can exit. On shape mismatch, returns an empty list. Honors the
// refuse-don't-miscompile policy: never fabricate error output.
pub fn aarch64_emit_ctl_test(src: String) -> List[String] {
    let empty: List[String] = list_new();
    let total: Int = chars_len(src);
    if total == 0 { return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    if n < 1 { return empty;
    }
    let inames: List[String] = list_new();
    let ivals: List[String] = list_new();
    let mut i: Int = 0;
    while i < n { let k: String = a64_tok_k(toks, i);
    if k == "KW_IF" { let got: List[String] = aarch64_if_taken_print(toks, n, i, inames, ivals);
    if list_len(got) >= 2 { let mut out: List[String] = list_new();
    out = list_push(out, "ERR\taarch64_emit_ctl\tconst if not folded");
    return out;
    }
        } else if k == "KW_FN" {
            let got: List[String] = aarch64_fn_const_ret(toks, n, i);
            if list_len(got) >= 2 { let mut out: List[String] = list_new();
            out = list_push(out, "ERR\taarch64_emit_ctl\tno-arg const return not folded: " + list_get(got, 0));
            return out;
            }
        }
        i = i + 1;
    }
    return empty;
}
