// ──▓▓ Public AArch64 Emitter API ──▓▓──

pub fn emit_aarch64_stream(src: String) -> String {
    return aarch64_emit_library(src);
}

pub fn aarch64_emit_stream(src: String) -> String {
    return aarch64_emit_library(src);
}

pub fn emit_aarch64_ssa(fn_def: SsaFunction) -> A64CompileResult {
    return aarch64_ssa_compile_ssa(fn_def);
}

pub fn emit_aarch64_direct_bytes(src: String) -> ByteOut {
    let code: List[Int] = aarch64_elf_pure_linux_exit(0);
    return aarch64_elf_pure_package(code);
}
