// # Emit runtime no-output detector for AArch64 _start
//
// Logline: Emits a .bss flag cell, an init zeroer, flag-setting _println_* wrappers, and an end-of-main no-output reporter so silent miscompiles that emit zero syscalls surface as `<name>: no-output` on stderr with exit 1.
//
// Setup: AAPCS64 calling convention (x0 = first arg, x0 = return). Mirrors oodac/x86_emit_no_output.oo. The runtime-blob tail in aarch64_emit.oo calls aarch64_emit_no_output_marker_init(name) to emit this machinery as part of the assembly.
//
// Beats:
//   1. Emit a .bss .Lwrote_output quad cell (zero-initialized).
//   2. Emit _oo_no_output_init that stores 0 into the flag cell (callable before main).
//   3. Emit _println_int_no_output that stores 1 into the flag, then tail-jumps to the original _println_int.
//   4. Emit _println_str_no_output and _println_float_no_output with the same flag-set pattern.
//   5. Emit _oo_no_output_check that loads the flag; if 0, writes `<name>: no-output\n` to stderr (fd=2) and exits 1; if 1, returns.
//
// residual: a future Turn will modify the existing emitters to call these wrappers and to insert a call to _oo_no_output_check at the end of main; today the wrappers and check are emitted and available for assembly-linker resolution.

import "aarch64_emit_sys.oo";

import "aarch64_emit_frame.oo";


fn no_output_flag_label() -> String {
    return ".Lwrote_output";
}
fn no_output_flag_set() -> String {
    return "    ldr x9, =.Lwrote_output\n    mov x10, #1\n    str x10, [x9]";
}
fn no_output_flag_clear() -> String {
    return "    ldr x9, =.Lwrote_output\n    mov x10, #0\n    str x10, [x9]";
}
fn no_output_init_fn() -> String {
    return "_oo_no_output_init";
}
fn no_output_check_fn() -> String {
    return "_oo_no_output_check";
}
fn no_output_wrapper_int() -> String {
    return "_println_int_no_output";
}
fn no_output_wrapper_str() -> String {
    return "_println_str_no_output";
}
fn no_output_wrapper_float() -> String {
    return "_println_float_no_output";
}
fn no_output_rodata_tag() -> String {
    return ".Lno_output_msg";
}

fn aarch64_emit_no_output_bss() {
    println("    .section .bss");
    println("    .p2align 3");
    println(no_output_flag_label() + ":");
    println("    .quad 0");
}

fn aarch64_emit_no_output_rodata(name: String) {
    let prefix: String = name + ": no-output";
    println("    .section .rodata");
    println(no_output_rodata_tag() + ":");
    println("    .ascii \"" + aarch64_ascii_esc(prefix) + "\\n\"");
}

fn aarch64_emit_no_output_init_routine() {
    println("    .section .text");
    println(".globl " + no_output_init_fn());
    println(".p2align 2");
    println(no_output_init_fn() + ":");
    aarch64_emit_frame_enter();
    println(no_output_flag_clear());
    aarch64_emit_frame_leave();
}

fn aarch64_emit_no_output_int_wrapper() {
    println("    .section .text");
    println(".globl " + no_output_wrapper_int());
    println(".p2align 2");
    println(no_output_wrapper_int() + ":");
    println(no_output_flag_set());
    println("    b _println_int");
}

fn aarch64_emit_no_output_str_wrapper() {
    println("    .section .text");
    println(".globl " + no_output_wrapper_str());
    println(".p2align 2");
    println(no_output_wrapper_str() + ":");
    println(no_output_flag_set());
    println("    b _println_str");
}

fn aarch64_emit_no_output_float_wrapper() {
    println("    .section .text");
    println(".globl " + no_output_wrapper_float());
    println(".p2align 2");
    println(no_output_wrapper_float() + ":");
    println(no_output_flag_set());
    println("    b _println_float");
}

fn aarch64_emit_no_output_check_routine(name: String) {
    let prefix: String = name + ": no-output";
    let msg_len: Int = chars_len(prefix) + 1;
    let len_str: String = msg_len.to_string();
    let fd_str: String = "2";
    let exit_str: String = "1";
    println("    .section .text");
    println(".globl " + no_output_check_fn());
    println(".p2align 2");
    println(no_output_check_fn() + ":");
    aarch64_emit_frame_enter();
    println("    ldr x9, =.Lwrote_output");
    println("    ldr x10, [x9]");
    println("    cbnz x10, .Lno_output_ok");
    println("    mov x8, #64");
    println("    mov x0, #" + fd_str);
    println("    adrp x1, " + no_output_rodata_tag());
    println("    add x1, x1, :lo12:" + no_output_rodata_tag());
    println("    mov x2, #" + len_str);
    println("    svc #0");
    println("    mov x8, #93");
    println("    mov x0, #" + exit_str);
    println("    svc #0");
    println(".Lno_output_ok:");
    aarch64_emit_frame_leave();
}

// Public entry point called by the runtime-blob tail in aarch64_emit.oo.
// Emits the .bss flag, the rodata no-output message, the init zeroer,
// the three _println_* wrappers, and the end-of-main check function.
pub fn aarch64_emit_no_output_marker_init(name: String) {
    aarch64_emit_no_output_bss();
    aarch64_emit_no_output_rodata(name);
    aarch64_emit_no_output_init_routine();
    aarch64_emit_no_output_int_wrapper();
    aarch64_emit_no_output_str_wrapper();
    aarch64_emit_no_output_float_wrapper();
    aarch64_emit_no_output_check_routine(name);
}
