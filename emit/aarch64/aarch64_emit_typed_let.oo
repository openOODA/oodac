// # AArch64 typed const-int let with println(ident) emitter
//
// Logline: Lowers let n: Int = V; println(n) into AArch64 GAS that stores V on the stack, loads it back into x0, calls _println_int, and exits with svc #0.
//
// Setup: tokenize_lines, a64_tok_k, and a64_tok_t exist in aarch64_emit_harv.oo; aarch64_emit_int_routine and aarch64_emit_mov_x0 exist in aarch64_emit_int.oo.
//
// Beats:
//   1. Match main body containing let ident: Int = INT; println(ident).
//   2. Allocate 16 bytes on the stack, store V into the slot, load the slot into x0.
//   3. Call _println_int, deallocate the stack frame, and exit 0 via svc #0.


import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_int.oo";


pub fn aarch64_match_typed_let(src: String) -> List[String] {
    let empty: List[String] = list_new();
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if a64_tok_k(toks, i) == "KW_FN" && i + 1 < n && a64_tok_t(toks, i + 1) == "main" {
            let mut p = i + 2;
            if p + 3 < n && a64_tok_k(toks, p) == "LPAREN" && a64_tok_k(toks, p + 1) == "RPAREN" && a64_tok_k(toks, p + 2) == "LBRACE" && a64_tok_k(toks, p + 3) == "KW_LET" {
                p = p + 4;
                if p >= n || a64_tok_k(toks, p) != "IDENT" { return empty;
                }
                let var_name: String = a64_tok_t(toks, p);
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "COLON" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "IDENT" || a64_tok_t(toks, p) != "Int" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "EQ" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "INT" { return empty;
                }
                let v1: String = a64_tok_t(toks, p);
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "SEMI" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_t(toks, p) != "println" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "LPAREN" { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "IDENT" || a64_tok_t(toks, p) != var_name { return empty;
                }
                p = p + 1;
                if p >= n || a64_tok_k(toks, p) != "RPAREN" { return empty;
                }
                p = p + 1;
                if p < n && a64_tok_k(toks, p) == "SEMI" { p = p + 1;
                }
                if p >= n || a64_tok_k(toks, p) != "RBRACE" { return empty;
                }
                let mut out: List[String] = list_new();
                out = list_push(out, var_name);
                out = list_push(out, v1);
                return out;
            }
        }
        i = i + 1;
    }
    return empty;
}

pub fn aarch64_emit_typed_let(var_name: String, v1: String) {
    let mut wrote: Int = 0;
    println("# openOODA aarch64 product floor (GAS, Linux, clang -target aarch64-linux-gnu)");
    println("    .arch armv8-a");
    println("    .section .text");
    println("    .globl _start");
    println("    .globl main");
    aarch64_emit_int_routine();
    println("main:");
    println("_start:");
    println("    sub sp, sp, #16");
    aarch64_emit_mov_x0(v1);
    println("    str x0, [sp, #8]");
    println("    ldr x0, [sp, #8]");
    wrote = wrote + 1;
    println("    bl _println_int");
    if wrote == 0 { println("ERR\taarch64_emit\ttyped_let: body produced no write syscall; add println(ident) that observes the let binding");
    process_exit(1);
    }
    println("    add sp, sp, #16");
    println("    mov x8, #93");
    println("    mov x0, #0");
    println("    svc #0");
}
