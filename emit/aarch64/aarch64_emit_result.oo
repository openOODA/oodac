// # AArch64 tagged-union Result lower
//
// Logline: Lower the first function that returns Ok(atom) or Err(atom) to AAPCS64 GAS.
//
// Setup: tokenize_lines lives in token_fmt.oo. a64_tok_k and a64_tok_t live in aarch64_emit_const_harvest.oo. The x86 path is x86_ssa_emit_result_program.
//
// Beats:
//   1. First KW_FN IDENT is the function name.
//   2. First `return Ok(` or `return Err(` with IDENT, STRING, or INT, then RPAREN, sets the constructor.
//   3. Ok tag is 1. Err tag is 0. Copy the first argument from x0 to x1, then put the tag in x0.
//   4. If the source has more than one function, still emit only the first function.
//   5. Return an empty string when the shape does not match. Do not print ERR.

import "aarch64_emit_const_harvest.oo";

// Honest Result lower: tagged union {tag:i64 in x0, payload:i64 in x1}.
// Ok = tag 1, Err = tag 0. Only the first fn, and only `return Ok(atom)` / `return Err(atom)`.
pub fn aarch64_ssa_emit_result_program(src: String) -> String {
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i = 0;
    let mut fn_name = "";
    let mut ctor = "";
    let mut fn_count = 0;
    while i < n {
        if a64_tok_k(toks, i) == "KW_FN" && i + 1 < n && a64_tok_k(toks, i + 1) == "IDENT" {
            fn_count = fn_count + 1;
            if fn_count == 1 { fn_name = a64_tok_t(toks, i + 1);
            }
            if fn_count > 1 { break;
            }
        }
        if a64_tok_k(toks, i) == "KW_RETURN" && i + 3 < n { let t: String = a64_tok_t(toks, i + 1);
        if (t == "Ok" || t == "Err") && a64_tok_k(toks, i + 2) == "LPAREN" { let pk: String = a64_tok_k(toks, i + 3);
        if (pk == "IDENT" || pk == "STRING" || pk == "INT") && i + 4 < n && a64_tok_k(toks, i + 4) == "RPAREN" { ctor = t;
        break;
        }
            }
        }
        i = i + 1;
    }
    if chars_len(fn_name) == 0 || chars_len(ctor) == 0 { return "";
    }
    let tag: String = if ctor == "Ok" { "1" } else { "0" };
    let mut s: String = "    .text\n    .globl " + fn_name + "\n    .p2align 2\n" + fn_name + ":\n";
    s = s + "    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n";
    s = s + "    mov x1, x0\n    mov x0, #" + tag + "\n";
    s = s + "    ldp x29, x30, [sp], #16\n    ret\n";
    return s;
}
