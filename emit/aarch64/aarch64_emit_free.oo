// # Emit zero-libc freelist memory manager and deallocation (AArch64)
//
// Logline: Emits standalone AArch64 GAS freelist allocator, free, and realloc routines with zero libc.
//
// Setup: Chunk header [size (8B), is_free (8B), next_free_ptr (8B)]. Pure AArch64 Linux AAPCS64.
//
// Beats:
//   1. Emit .Lfreelist_head and heap pointers in .bss.
//   2. Emit oo_aarch64_alloc, oo_aarch64_free, oo_aarch64_realloc.
//   3. Match and emit freelist recycle verification.
//
// residual: thread-safety, large mmap growth, and rodata print fold stay later.


import "aarch64_emit_const_harvest.oo";

import "aarch64_emit_int.oo";


pub fn aarch64_emit_free_bss() {
    println("    .section .bss\n    .p2align 3\n.Lfree_heap_ptr:\n    .quad 0\n.Lfree_heap_end:\n    .quad 0\n.Lfreelist_head:\n    .quad 0");
}

pub fn aarch64_emit_free_routines() {
    // oo_aarch64_alloc: x0 = size; returns x0 = usable pointer (chunk+24).
    // Stack frame 48: x29/x30 pair, x19/x20, x21/x22. x19 = size, x20 = prev, x21 = curr, x22 = next.
    println("    .section .text\n    .globl oo_aarch64_alloc\n    .p2align 4\noo_aarch64_alloc:\n    stp x29, x30, [sp, #-48]!\n    mov x29, sp\n    stp x19, x20, [sp, #16]\n    stp x21, x22, [sp, #32]\n    add x0, x0, #7\n    and x0, x0, #-8\n    cbnz x0, .Lalloc_sz_ok\n    mov x0, #8");
    println(".Lalloc_sz_ok:\n    mov x19, x0\n    mov x20, #0\n    adrp x9, .Lfreelist_head\n    add x9, x9, :lo12:.Lfreelist_head\n    ldr x21, [x9]\n    b .Lfreelist_loop");
    println(".Lfreelist_loop:\n    cbz x21, .Lalloc_expand\n    ldr x0, [x21]\n    cmp x0, x19\n    bge .Lfound_free_chunk\n    mov x20, x21\n    ldr x21, [x21, #16]\n    b .Lfreelist_loop");
    println(".Lfound_free_chunk:\n    ldr x22, [x21, #16]\n    cbz x20, .Lunlink_head\n    str x22, [x20, #16]\n    b .Lunlink_done");
    println(".Lunlink_head:\n    adrp x9, .Lfreelist_head\n    add x9, x9, :lo12:.Lfreelist_head\n    str x22, [x9]");
    println(".Lunlink_done:\n    str xzr, [x21, #8]\n    str xzr, [x21, #16]\n    add x0, x21, #24\n    b .Lalloc_done");
    println(".Lalloc_expand:\n    mov x0, #0\n    mov x1, #65536\n    mov x2, #3\n    mov x3, #0x22\n    mov x4, #-1\n    mov x5, #0\n    mov x8, #222\n    svc #0");
    println("    adrp x9, .Lfree_heap_ptr\n    add x9, x9, :lo12:.Lfree_heap_ptr\n    str x0, [x9]\n    add x0, x0, #65536\n    adrp x9, .Lfree_heap_end\n    add x9, x9, :lo12:.Lfree_heap_end\n    str x0, [x9]\n    adrp x9, .Lfree_heap_ptr\n    add x9, x9, :lo12:.Lfree_heap_ptr\n    ldr x0, [x9]");
    println(".Lalloc_bump_fit:\n    mov x21, x0\n    add x0, x0, x19\n    add x0, x0, #24\n    adrp x9, .Lfree_heap_ptr\n    add x9, x9, :lo12:.Lfree_heap_ptr\n    str x0, [x9]\n    str x19, [x21]\n    str xzr, [x21, #8]\n    str xzr, [x21, #16]\n    add x0, x21, #24");
    println(".Lalloc_done:\n    ldp x21, x22, [sp, #32]\n    ldp x19, x20, [sp, #16]\n    ldp x29, x30, [sp], #48\n    ret");

    // oo_aarch64_free: x0 = ptr; marks chunk free and inserts at freelist head.
    println("    .globl oo_aarch64_free\n    .p2align 4\noo_aarch64_free:\n    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n    cbz x0, .Lfree_ret\n    sub x0, x0, #24\n    ldr x1, [x0, #8]\n    cmp x1, #1\n    b.eq .Lfree_ret");
    println("    mov x1, #1\n    str x1, [x0, #8]\n    ldr x1, [x0]\n    adrp x9, .Lfreelist_head\n    add x9, x9, :lo12:.Lfreelist_head\n    ldr x2, [x9]\n    str x2, [x0, #16]\n    str x0, [x9]");
    println(".Lfree_ret:\n    ldp x29, x30, [sp], #16\n    ret");

    // oo_aarch64_realloc: x0 = ptr (nullable), x1 = new size (nullable); returns x0 = new ptr.
    println("    .globl oo_aarch64_realloc\n    .p2align 4\noo_aarch64_realloc:\n    stp x29, x30, [sp, #-48]!\n    mov x29, sp\n    stp x19, x20, [sp, #16]\n    stp x21, x22, [sp, #32]\n    cbz x0, .Lrealloc_null_ptr\n    cbz x1, .Lrealloc_null_sz");
    println("    mov x19, x0\n    add x1, x1, #7\n    and x1, x1, #-8\n    mov x20, x1\n    sub x21, x19, #24\n    ldr x22, [x21]\n    cmp x22, x20\n    bge .Lrealloc_same_blk");
    println("    mov x0, x20\n    bl oo_aarch64_alloc\n    mov x21, x0\n    mov x2, x22\n    mov x0, x19\n    mov x1, x21\n    b .Lrealloc_copy_check");
    println(".Lrealloc_copy_loop:\n    ldrb w3, [x0], #1\n    strb w3, [x1], #1\n    sub x2, x2, #1\n.Lrealloc_copy_check:\n    cbnz x2, .Lrealloc_copy_loop");
    println("    mov x0, x19\n    bl oo_aarch64_free\n    mov x0, x21\n    b .Lrealloc_done");
    println(".Lrealloc_same_blk:\n    mov x0, x19\n    b .Lrealloc_done");
    println(".Lrealloc_null_ptr:\n    mov x0, x1\n    bl oo_aarch64_alloc\n    b .Lrealloc_done");
    println(".Lrealloc_null_sz:\n    bl oo_aarch64_free\n    mov x0, #0\n.Lrealloc_done:\n    ldp x21, x22, [sp, #32]\n    ldp x19, x20, [sp, #16]\n    ldp x29, x30, [sp], #48\n    ret");
}

pub fn aarch64_match_free_test(src: String) -> List[String] {
    let empty: List[String] = list_new();
    if chars_len(src) == 0 { return empty;
    }
    let toks: List[String] = tokenize_lines(src);
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        if a64_tok_k(toks, i) == "IDENT" && (a64_tok_t(toks, i) == "oo_alloc" || a64_tok_t(toks, i) == "heap_free_test") {
            let mut v1 = "";
            let mut v2 = "";
            let mut p = 0;
            while p < n {
                if a64_tok_k(toks, p) == "IDENT" && a64_tok_t(toks, p) == "oo_write_int" {
                    if p + 4 < n && a64_tok_k(toks, p + 4) == "INT" {
                        if chars_len(v1) == 0 { v1 = a64_tok_t(toks, p + 4);
                        }
                        else if chars_len(v2) == 0 { v2 = a64_tok_t(toks, p + 4);
                        }
                    }
                }
                p = p + 1;
            }
            if chars_len(v1) == 0 || chars_len(v2) == 0 { return empty;
            }
            let mut out: List[String] = list_new();
            out = list_push(out, v1);
            out = list_push(out, v2);
            return out;
        }
        i = i + 1;
    }
    return empty;
}

pub fn aarch64_emit_free_test(v1: String, v2: String) {
    let mut wrote: Int = 0;
    println("# openOODA aarch64 product floor (GAS, Linux, clang -target aarch64-linux-gnu)");
    println("    .arch armv8-a");
    aarch64_emit_free_bss();
    aarch64_emit_free_routines();
    aarch64_emit_int_routine();
    println("    .section .text\n    .globl _start\n    .globl main\nmain:\n_start:\n    stp x29, x30, [sp, #-32]!\n    mov x29, sp");
    println("    mov x0, #32\n    bl oo_aarch64_alloc\n    add x9, sp, #24\n    str x0, [x9]\n    ldr x9, [x9]\n    mov x10, #" + v1 + "\n    str x10, [x9]");
    println("    add x9, sp, #24\n    ldr x0, [x9]\n    bl oo_aarch64_free");
    println("    mov x0, #32\n    bl oo_aarch64_alloc\n    add x9, sp, #16\n    str x0, [x9]\n    ldr x9, [x9]\n    mov x10, #" + v2 + "\n    str x10, [x9]");
    println("    add x9, sp, #16\n    ldr x0, [x9]\n    mov x1, #64\n    bl oo_aarch64_realloc\n    add x9, sp, #8\n    str x0, [x9]");
    wrote = wrote + 1;
    println("    add x9, sp, #8\n    ldr x9, [x9]\n    ldr x0, [x9]\n    bl _println_int");
    if wrote == 0 { println("ERR\taarch64_emit\tfree: body produced no write syscall; add oo_write_int that observes the realloc value");
    process_exit(1);
    }
    println("    add x9, sp, #8\n    ldr x0, [x9]\n    bl oo_aarch64_free\n    mov x0, #0\n    mov x8, #93\n    svc #0");
}
