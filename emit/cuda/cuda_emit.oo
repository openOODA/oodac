// # CUDA CUDA program stitch
//
// Logline: Typed fn walk plus prelude, device code, and host main stitch.
//
// Setup: Check runs first in the driver. Main plus typed helpers lower.
//
// Beats:
//   1. Prescan selects device kernels and host helpers by token idents.
//   2. Each fn body lowers through the typed statement walker.
//   3. Includes, structs, helpers, kernels, fns, and main stitch one TU.

import "cuda_tok.oo";
import "cuda_ty.oo";
import "cuda_buf.oo";
import "cuda_scan.oo";
import "cuda_stmt.oo";
import "cuda_kernel.oo";
import "cuda_device.oo";
import "lex/token_fmt.oo";
import "lex/token_parse_int.oo";

pub fn cuda_emit_program(src: String) -> String {
    return cuda_emit_toks(tokenize_lines(src));
}

pub fn cuda_emit_toks(toks: List[String]) -> String {
    let n: Int = list_len(toks);
    if n < 1 {
        cu_fail(1, "empty artifact");
        return "";
    }
    let fns: String = cu_scan_fns(toks);
    let mrow: String = cu_fn_row(fns, "main");
    if mrow == "" {
        cu_fail(1, "no main");
        return "";
    }
    let needs: String = cu_kernel_needs(toks, n);
    let mut lines: List[String] = list_new();
    lines = cu_prelude(lines, needs);
    let mut pos: Int = 0;
    while pos < n {
        let k: String = cu_k(toks, pos);
        if k == "KW_FN" || k == "KW_PUB" {
            let nm: String = cu_fn_name_at(toks, pos, n);
            if nm != "main" {
                lines = cu_emit_fn(toks, pos, n, fns, nm, lines);
            }
            pos = cu_skip_fn(toks, pos, n);
        } else {
            pos = pos + 1;
        }
    }
    lines = cu_emit_main(toks, n, fns, mrow, lines);
    return cu_join(lines);
}

fn cu_prelude(lines: List[String], needs: String) -> List[String] {
    let mut o: List[String] = lines;
    o = list_push(o, "// generated by oodac --backend cuda");
    o = list_push(o, "#include <cuda_runtime.h>");
    o = list_push(o, "#include <cstdio>");
    o = list_push(o, "#include <cstdlib>");
    o = list_push(o, "#include <cstring>");
    o = list_push(o, "#include <string>");
    o = list_push(o, "#include <vector>");
    o = list_push(o, "#include <climits>");
    o = list_push(o, "extern \"C\" {");
    o = list_push(o, "#include \"oodar.h\"");
    o = list_push(o, "}");
    o = list_push(o, "struct oo_cuda_ResS { int ok; std::string val; };");
    o = list_push(o, "struct oo_cuda_ResLi { int ok; std::vector<long long> vec; std::string err; };");
    o = list_push(o, "struct oo_cuda_OptI { int ok; long long val; };");
    o = list_push(o, "struct oo_cuda_OptS { int ok; std::string val; };");
    o = list_push(o, "static oo_cuda_ResS oo_cuda_ress(OoResS r) {");
    o = list_push(o, "  oo_cuda_ResS o;");
    o = list_push(o, "  o.ok = r.ok;");
    o = list_push(o, "  if (r.val.data && r.val.len > 0) { o.val.assign(r.val.data, (size_t)r.val.len); }");
    o = list_push(o, "  return o;");
    o = list_push(o, "}");
    if char_at(needs, 0) == "1" { o = list_push(o, cu_help_try()); }
    if char_at(needs, 1) == "1" { o = list_push(o, cu_help_vec()); }
    if char_at(needs, 3) == "1" { o = list_push(o, cu_kern_hello()); }
    if char_at(needs, 2) == "1" { o = list_push(o, cu_kern_int()); }
    if char_at(needs, 4) == "1" { o = list_push(o, cu_help_copy()); }
    return o;
}

fn cu_emit_fn(toks: List[String], pos: Int, n: Int, fns: String, nm: String, lines: List[String]) -> List[String] {
    let mut o: List[String] = lines;
    let row: String = cu_fn_row(fns, nm);
    let ret: String = cu_row_ret(row);
    let params: String = cu_row_params(row);
    if cu_ctype(ret) == "" {
        cu_fail(cu_line(toks, pos), "fn return unsupported");
        return o;
    }
    let penv: String = cu_param_env(params);
    let capv: String = cu_cap_of(params);
    let sig: String = "static " + cu_ctype(ret) + " oo_u_" + nm + "(" + cu_param_sig(params) + ") {";
    o = list_push(o, sig);
    let rng: String = cu_fn_body(toks, pos, n);
    let body: String = cu_stmts(toks, cu_range_start(rng), cu_range_end(rng), n, penv, fns, capv, false, ret, "  ");
    o = list_push(o, cu_s_text(body));
    if ret != "v" {
        o = list_push(o, "  return " + cu_default(ret) + ";");
    }
    o = list_push(o, "}");
    return o;
}

fn cu_param_env(params: String) -> String {
    if params == "" { return ""; }
    let mut env: String = "";
    let mut rest: String = params;
    while rest != "" {
        let c: Int = str_index_of(rest, ",");
        let item: String = if c < 0 { rest } else { str_slice(rest, 0, c) };
        let d: Int = str_index_of(item, ":");
        env = cu_env_put(env, str_slice(item, 0, d), str_slice(item, d + 1, chars_len(item)));
        if c < 0 {
            rest = "";
        } else {
            rest = str_slice(rest, c + 1, chars_len(rest));
        }
    }
    return env;
}

fn cu_param_sig(params: String) -> String {
    if params == "" { return ""; }
    let mut o: String = "";
    let mut rest: String = params;
    let mut first: Bool = true;
    while rest != "" {
        let c: Int = str_index_of(rest, ",");
        let item: String = if c < 0 { rest } else { str_slice(rest, 0, c) };
        let d: Int = str_index_of(item, ":");
        let pn: String = str_slice(item, 0, d);
        let pc: String = str_slice(item, d + 1, chars_len(item));
        if cu_ctype(pc) == "" {
            cu_fail(1, "fn param unsupported");
            return "";
        }
        if !first { o = o + ", "; }
        first = false;
        o = o + cu_ctype(pc) + " " + cu_var(pn);
        if c < 0 {
            rest = "";
        } else {
            rest = str_slice(rest, c + 1, chars_len(rest));
        }
    }
    return o;
}

fn cu_cap_of(params: String) -> String {
    if params == "" { return ""; }
    let mut rest: String = params;
    while rest != "" {
        let c: Int = str_index_of(rest, ",");
        let item: String = if c < 0 { rest } else { str_slice(rest, 0, c) };
        let d: Int = str_index_of(item, ":");
        if str_slice(item, d + 1, chars_len(item)) == "cap" {
            return cu_var(str_slice(item, 0, d));
        }
        if c < 0 {
            rest = "";
        } else {
            rest = str_slice(rest, c + 1, chars_len(rest));
        }
    }
    return "";
}

fn cu_emit_main(toks: List[String], n: Int, fns: String, mrow: String, lines: List[String]) -> List[String] {
    let mut o: List[String] = lines;
    let ret: String = cu_row_ret(mrow);
    if ret != "v" && ret != "i" {
        cu_fail(1, "main return unsupported");
        return o;
    }
    let params: String = cu_row_params(mrow);
    if params != "" && !cu_params_all_cap(params) {
        cu_fail(1, "main args unsupported");
        return o;
    }
    let mpos: Int = cu_fn_pos(toks, n, "main");
    o = list_push(o, "int main(int argc, char** argv) {");
    o = list_push(o, "  (void)argc;");
    o = list_push(o, "  (void)argv;");
    let mut env: String = "";
    let mut capv: String = "";
    let mut rest: String = params;
    while rest != "" {
        let c: Int = str_index_of(rest, ",");
        let item: String = if c < 0 { rest } else { str_slice(rest, 0, c) };
        let d: Int = str_index_of(item, ":");
        let pn: String = str_slice(item, 0, d);
        let cn: String = cu_cap_name_at(toks, mpos, n, pn);
        if cn != "GpuCap" {
            cu_fail(1, "main cap unsupported");
            return o;
        }
        o = list_push(o, "  long long " + cu_var(pn) + " = oo_cap_grant_gpu();");
        env = cu_env_put(env, pn, "cap");
        if capv == "" { capv = cu_var(pn); }
        if c < 0 {
            rest = "";
        } else {
            rest = str_slice(rest, c + 1, chars_len(rest));
        }
    }
    let rng: String = cu_fn_body(toks, mpos, n);
    let body: String = cu_stmts(toks, cu_range_start(rng), cu_range_end(rng), n, env, fns, capv, true, ret, "  ");
    o = list_push(o, cu_s_text(body));
    o = list_push(o, "  return 0;");
    o = list_push(o, "}");
    return o;
}

fn cu_params_all_cap(params: String) -> Bool {
    let mut rest: String = params;
    while rest != "" {
        let c: Int = str_index_of(rest, ",");
        let item: String = if c < 0 { rest } else { str_slice(rest, 0, c) };
        let d: Int = str_index_of(item, ":");
        if str_slice(item, d + 1, chars_len(item)) != "cap" { return false; }
        if c < 0 {
            rest = "";
        } else {
            rest = str_slice(rest, c + 1, chars_len(rest));
        }
    }
    return true;
}

fn cu_cap_name_at(toks: List[String], fnpos: Int, n: Int, want: String) -> String {
    let mut p: Int = fnpos;
    while p < n && cu_k(toks, p) != "LPAREN" { p = p + 1; }
    p = p + 1;
    while p < n && cu_k(toks, p) != "RPAREN" {
        if (cu_k(toks, p) == "IDENT" || cu_k(toks, p) == "KW_GPU") && cu_t(toks, p) == want {
            if cu_k(toks, p + 1) == "COLON" && cu_k(toks, p + 2) == "AMP" && cu_k(toks, p + 3) == "IDENT" {
                return cu_t(toks, p + 3);
            }
            return "";
        }
        p = p + 1;
    }
    return "";
}
