// # CUDA call and println statements
//
// Logline: User, list, constructor, gpu, device, and string calls plus println.
//
// Setup: Args arrive pre-lowered as tab packs. Hints thread let annotations
//   into nested constructors. String ops lower through std::string.
//
// Beats:
//   1. cu_call routes nine call kinds with fail-closed arity and types.
//   2. Constructor hints derive from the outer result or option annotation.
//   3. cu_println covers int, float, string, and bool payloads.

import "cuda_tok.oo";
import "cuda_ty.oo";
import "cuda_buf.oo";
import "cuda_call.oo";
import "cuda_kernel.oo";
import "cuda_device.oo";
import "cuda_str.oo";
import "lex/token_parse_int.oo";

pub fn cu_call(toks: List[String], pos: Int, n: Int, env: String, fns: String, hint: String, capv: String) -> String {
    let name: String = cu_t(toks, pos);
    let line: Int = cu_line(toks, pos);
    let info: String = cu_arg_spans(toks, pos, n);
    let endp: Int = cu_span_end(info);
    let nargs: Int = cu_span_nargs(info);
    let kind: Int = cu_call_kind(name);
    if kind == 1 {
        if nargs == 0 && hint == "li" { return cu_e_pack(endp + 1, "li", "std::vector<long long>()"); }
        if nargs == 0 && hint == "lf" { return cu_e_pack(endp + 1, "lf", "std::vector<double>()"); }
        cu_fail(line, "list_new needs a typed let");
        return "0\t?\t";
    }
    if kind == 2 {
        cu_fail(line, "push is a statement");
        return "0\t?\t";
    }
    let mut argstr: String = "";
    let mut i: Int = 0;
    while i < nargs {
        let mut h: String = cu_arg_hint(name, i, fns);
        if name == "Ok" && hint == "rss" { h = "s"; }
        if name == "Ok" && hint == "rli" { h = "li"; }
        if name == "Err" { h = "s"; }
        if name == "Some" && hint == "oi" { h = "i"; }
        if name == "Some" && hint == "os" { h = "s"; }
        let a: String = cu_expr(toks, cu_span_start(info, i), n, env, fns, h, capv);
        if i > 0 { argstr = argstr + "\t"; }
        argstr = argstr + cu_e_pos(a).to_string() + "\t" + cu_e_ty(a) + "\t" + cu_e_code(a);
        i = i + 1;
    }
    if kind == 3 {
        let r: String = cu_apply_list(name, argstr, nargs, line);
        return cu_e_pack(endp + 1, cu_e_ty(r), cu_e_code(r));
    }
    if kind == 4 {
        let r2: String = cu_apply_ctor(name, argstr, nargs, hint, line);
        return cu_e_pack(endp + 1, cu_e_ty(r2), cu_e_code(r2));
    }
    if kind == 5 {
        if name == "gpu_cuda_vec_add" && cu_k(toks, cu_span_start(info, 3)) != "IDENT" {
            cu_fail(line, "vec_add output needs a variable");
            return "0\t?\t";
        }
        if name == "gpu_copy_d2h" && cu_k(toks, cu_span_start(info, 1)) != "IDENT" {
            cu_fail(line, "copy_d2h output needs a variable");
            return "0\t?\t";
        }
        let r3: String = cu_gpu_call(name, argstr, nargs, capv, line);
        return cu_e_pack(endp + 1, cu_e_ty(r3), cu_e_code(r3));
    }
    if kind == 6 {
        let r4: String = cu_dev_call(name, argstr, nargs, capv, line);
        return cu_e_pack(endp + 1, cu_e_ty(r4), cu_e_code(r4));
    }
    if kind == 8 {
        let r5: String = cu_apply_str(name, argstr, nargs, line);
        return cu_e_pack(endp + 1, cu_e_ty(r5), cu_e_code(r5));
    }
    let r6: String = cu_apply_user(name, argstr, nargs, fns, line);
    return cu_e_pack(endp + 1, cu_e_ty(r6), cu_e_code(r6));
}

pub fn cu_println(toks: List[String], pos: Int, n: Int, env: String, fns: String, capv: String, ind: String) -> String {
    let info: String = cu_arg_spans(toks, pos, n);
    if cu_span_nargs(info) != 1 {
        cu_fail(cu_line(toks, pos), "println takes one arg");
        return cu_s_pack(pos + 1, env, "");
    }
    let a: String = cu_expr(toks, cu_span_start(info, 0), n, env, fns, "", capv);
    let q: Int = cu_span_end(info) + 1;
    let qq: Int = if q < n && cu_k(toks, q) == "SEMI" { q + 1 } else { q };
    let at: String = cu_e_ty(a);
    let ac: String = cu_e_code(a);
    if at == "i" { return cu_s_pack(qq, env, ind + "printf(\"%lld\\n\", (long long)(" + ac + "));\n"); }
    if at == "f" { return cu_s_pack(qq, env, ind + "printf(\"%g\\n\", (double)(" + ac + "));\n"); }
    if at == "s" { return cu_s_pack(qq, env, ind + "{ std::string oo_t = (" + ac + "); fwrite(oo_t.data(), 1, oo_t.size(), stdout); putchar(10); }\n"); }
    if at == "b" { return cu_s_pack(qq, env, ind + "printf(\"%lld\\n\", (long long)(" + ac + "));\n"); }
    cu_fail(cu_line(toks, pos), "println type unsupported");
    return cu_s_pack(qq, env, "");
}
