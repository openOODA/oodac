// # CUDA call applicators over lowered args
//
// Logline: Arg span walk plus list, constructor, and user applicators.
//
// Setup: Args arrive as tab packs. No expression import keeps layers acyclic.
//
// Beats:
//   1. cu_arg_spans records each argument start with a depth walk.
//   2. cu_apply_list lowers len and get with fail-closed bounds.
//   3. cu_apply_ctor and cu_apply_user check payloads and signatures.

import "cuda_tok.oo";
import "cuda_ty.oo";
import "cuda_scan.oo";
import "lex/token_parse_int.oo";

pub fn cu_arg_spans(toks: List[String], pos: Int, n: Int) -> String {
    let mut p: Int = pos + 2;
    let mut starts: String = "";
    let mut first: Bool = true;
    if p < n && cu_k(toks, p) == "RPAREN" { return p.to_string() + "\t"; }
    let mut depth: Int = 0;
    let mut need_start: Bool = true;
    while p < n {
        let k: String = cu_k(toks, p);
        if depth == 0 && need_start {
            if !first { starts = starts + ","; }
            first = false;
            starts = starts + p.to_string();
            need_start = false;
        }
        if k == "LPAREN" || k == "LBRACKET" || k == "LBRACE" {
            depth = depth + 1;
        } else if k == "RPAREN" || k == "RBRACKET" || k == "RBRACE" {
            if depth == 0 {
                if k == "RPAREN" { return p.to_string() + "\t" + starts; }
                cu_fail(cu_line(toks, p), "unbalanced call");
                return "0\t";
            }
            depth = depth - 1;
        } else if k == "COMMA" && depth == 0 {
            need_start = true;
        }
        p = p + 1;
    }
    cu_fail(cu_line(toks, pos), "unterminated call");
    return "0\t";
}

pub fn cu_span_end(info: String) -> Int {
    let t: Int = str_index_of(info, "\t");
    return parse_int(str_slice(info, 0, t));
}

pub fn cu_span_nargs(info: String) -> Int {
    let t: Int = str_index_of(info, "\t");
    let s: String = str_slice(info, t + 1, chars_len(info));
    if s == "" { return 0; }
    let mut c: Int = 1;
    let mut i: Int = 0;
    while i < chars_len(s) {
        if char_at(s, i) == "," { c = c + 1; }
        i = i + 1;
    }
    return c;
}

pub fn cu_span_start(info: String, i: Int) -> Int {
    let t: Int = str_index_of(info, "\t");
    let mut rest: String = str_slice(info, t + 1, chars_len(info));
    let mut k: Int = 0;
    while k < i {
        let c: Int = str_index_of(rest, ",");
        rest = str_slice(rest, c + 1, chars_len(rest));
        k = k + 1;
    }
    let c2: Int = str_index_of(rest, ",");
    let num: String = if c2 < 0 { rest } else { str_slice(rest, 0, c2) };
    return parse_int(num);
}

pub fn cu_call_kind(name: String) -> Int {
    if name == "list_new" { return 1; }
    if name == "list_push" { return 2; }
    if name == "chars_len" || name == "char_at" || name == "str_slice" { return 8; }
    if name == "list_len" || name == "list_get" { return 3; }
    if name == "Some" || name == "None" || name == "Ok" || name == "Err" { return 4; }
    if name == "gpu_cuda_try_launch" || name == "gpu_cuda_vec_add" || name == "gpu_buffer_alloc" || name == "gpu_buffer_free" || name == "gpu_copy_h2d" || name == "gpu_copy_d2h" || name == "gpu_sync" || name == "gpu_init" { return 5; }
    if name == "gpu_cuda_hello" || name == "gpu_cuda_int_add" { return 6; }
    return 7;
}

pub fn cu_arg_hint(name: String, i: Int, fns: String) -> String {
    if name == "list_get" && i == 1 { return "i"; }
    if name == "gpu_cuda_try_launch" && i == 1 { return "s"; }
    if name == "gpu_cuda_vec_add" && i >= 1 && i <= 3 { return "lf"; }
    if name == "gpu_cuda_vec_add" && i == 4 { return "i"; }
    if name == "gpu_cuda_int_add" && (i == 1 || i == 2) { return "li"; }
    if name == "gpu_buffer_alloc" && (i == 1 || i == 2) { return "i"; }
    if name == "gpu_buffer_free" && i == 1 { return "i"; }
    if name == "gpu_copy_h2d" && (i == 1 || i == 3) { return "i"; }
    if name == "gpu_copy_d2h" && (i == 2 || i == 3) { return "i"; }
    let row: String = cu_fn_row(fns, name);
    if row == "" { return ""; }
    let params: String = cu_row_params(row);
    if cu_param_count(params) <= i { return ""; }
    return cu_param_at(params, i);
}

pub fn cu_apply_list(name: String, argstr: String, nargs: Int, line: Int) -> String {
    if name == "list_len" {
        if nargs != 1 {
            cu_fail(line, "list_len takes one list");
            return "0\t?\t";
        }
        let t0: String = cu_tab_field(argstr, 1);
        if t0 != "li" && t0 != "lf" {
            cu_fail(line, "list_len needs a list");
            return "0\t?\t";
        }
        return cu_e_pack(0, "i", "((long long)((" + cu_tab_field(argstr, 2) + ").size()))");
    }
    if name == "list_get" {
        if nargs != 2 {
            cu_fail(line, "list_get takes a list and an index");
            return "0\t?\t";
        }
        let t0: String = cu_tab_field(argstr, 1);
        if t0 != "li" && t0 != "lf" {
            cu_fail(line, "list_get needs a list");
            return "0\t?\t";
        }
        if cu_tab_field(argstr, 4) != "i" {
            cu_fail(line, "list_get needs an int index");
            return "0\t?\t";
        }
        let x: String = cu_tab_field(argstr, 2);
        let idx: String = cu_tab_field(argstr, 5);
        let guard: String = "((long long)(" + idx + ") < 0 || (long long)(" + idx + ") >= (long long)((" + x + ").size()))";
        let bad: String = "(fprintf(stderr, \"ERR\\tcuda\\tlist_get OOB\\n\"), exit(1), (" + x + ")[0])";
        return cu_e_pack(0, if t0 == "li" { "i" } else { "f" }, "(" + guard + " ? " + bad + " : (" + x + ")[(size_t)(" + idx + ")])");
    }
    cu_fail(line, "unsupported list op " + name);
    return "0\t?\t";
}

pub fn cu_apply_ctor(name: String, argstr: String, nargs: Int, hint: String, line: Int) -> String {
    if name == "Some" {
        if nargs != 1 {
            cu_fail(line, "Some takes one value");
            return "0\t?\t";
        }
        let vt: String = cu_tab_field(argstr, 1);
        let vc: String = cu_tab_field(argstr, 2);
        if hint == "oi" && vt == "i" { return cu_e_pack(0, "oi", "oo_cuda_OptI{1, (" + vc + ")}"); }
        if hint == "os" && vt == "s" { return cu_e_pack(0, "os", "oo_cuda_OptS{1, (" + vc + ")}"); }
        cu_fail(line, "Some needs an option hint");
        return "0\t?\t";
    }
    if name == "None" {
        if nargs != 0 {
            cu_fail(line, "None takes no value");
            return "0\t?\t";
        }
        if hint == "oi" { return cu_e_pack(0, "oi", "oo_cuda_OptI{0, 0}"); }
        if hint == "os" { return cu_e_pack(0, "os", "oo_cuda_OptS{0, {}}"); }
        cu_fail(line, "None needs an option hint");
        return "0\t?\t";
    }
    if name == "Ok" {
        if nargs != 1 {
            cu_fail(line, "Ok takes one value");
            return "0\t?\t";
        }
        let vt: String = cu_tab_field(argstr, 1);
        let vc: String = cu_tab_field(argstr, 2);
        if hint == "rss" && vt == "s" { return cu_e_pack(0, "rss", "oo_cuda_ResS{1, (" + vc + ")}"); }
        if hint == "rli" && vt == "li" { return cu_e_pack(0, "rli", "oo_cuda_ResLi{1, (" + vc + "), {}}"); }
        cu_fail(line, "Ok needs a result hint");
        return "0\t?\t";
    }
    if name == "Err" {
        if nargs != 1 {
            cu_fail(line, "Err takes one value");
            return "0\t?\t";
        }
        let vt: String = cu_tab_field(argstr, 1);
        let vc: String = cu_tab_field(argstr, 2);
        if vt == "s" && hint == "rss" { return cu_e_pack(0, "rss", "oo_cuda_ResS{0, (" + vc + ")}"); }
        if vt == "s" && hint == "rli" { return cu_e_pack(0, "rli", "oo_cuda_ResLi{0, {}, (" + vc + ")}"); }
        cu_fail(line, "Err needs a string and a result hint");
        return "0\t?\t";
    }
    cu_fail(line, "unsupported constructor " + name);
    return "0\t?\t";
}

pub fn cu_apply_user(name: String, argstr: String, nargs: Int, fns: String, line: Int) -> String {
    let row: String = cu_fn_row(fns, name);
    if row == "" {
        cu_fail(line, "unknown call " + name);
        return "0\t?\t";
    }
    let params: String = cu_row_params(row);
    let want: Int = cu_param_count(params);
    if want != nargs {
        cu_fail(line, "arity mismatch for " + name);
        return "0\t?\t";
    }
    let mut code: String = "oo_u_" + name + "(";
    let mut i: Int = 0;
    while i < nargs {
        let pc: String = cu_param_at(params, i);
        let at: String = cu_tab_field(argstr, i * 3 + 1);
        if at != pc {
            cu_fail(line, "arg type mismatch for " + name);
            return "0\t?\t";
        }
        if i > 0 { code = code + ", "; }
        code = code + cu_tab_field(argstr, i * 3 + 2);
        i = i + 1;
    }
    code = code + ")";
    return cu_e_pack(0, cu_row_ret(row), code);
}
