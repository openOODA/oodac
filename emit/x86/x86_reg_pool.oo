// # x86-64 Hardware Register Pool & ABI Classification
//
// Logline: Hardware register definitions, caller/callee-saved classification, allocation order, and System V AMD64 argument mappings across 12 GPRs.
//
// Setup: Pure hardware architecture mapping module for the openOODA sovereign x86-64 linear scan register allocator.
//
// Beats:
//   1. Enumerate 12 allocatable general-purpose registers (RAX..R15 excluding RSP, RBP, R10, R11).
//   2. Provide 64-bit, 32-bit, 16-bit, and 8-bit register string names.
//   3. Classify registers into caller-saved (0..6), scratch (7..8), and callee-saved (9..13).
//   4. Map System V AMD64 parameter registers (RDI, RSI, RDX, RCX, R8, R9) and allocation priority.

pub fn x86_reg_count() -> Int { return 12; }

pub fn x86_reg_name(id: Int) -> String {
    if id == 0 { return "%rax";
    }
    if id == 1 { return "%rcx";
    }
    if id == 2 { return "%rdx";
    }
    if id == 3 { return "%rsi";
    }
    if id == 4 { return "%rdi";
    }
    if id == 5 { return "%r8";
    }
    if id == 6 { return "%r9";
    }
    if id == 7 { return "%r10";
    }
    if id == 8 { return "%r11";
    }
    if id == 9 { return "%rbx";
    }
    if id == 10 { return "%r12";
    }
    if id == 11 { return "%r13";
    }
    if id == 12 { return "%r14";
    }
    if id == 13 { return "%r15";
    }
    return "%rax";
}

pub fn x86_reg_name_32(id: Int) -> String {
    if id == 0 { return "%eax";
    }
    if id == 1 { return "%ecx";
    }
    if id == 2 { return "%edx";
    }
    if id == 3 { return "%esi";
    }
    if id == 4 { return "%edi";
    }
    if id == 5 { return "%r8d";
    }
    if id == 6 { return "%r9d";
    }
    if id == 7 { return "%r10d";
    }
    if id == 8 { return "%r11d";
    }
    if id == 9 { return "%ebx";
    }
    if id == 10 { return "%r12d";
    }
    if id == 11 { return "%r13d";
    }
    if id == 12 { return "%r14d";
    }
    if id == 13 { return "%r15d";
    }
    return "%eax";
}

pub fn x86_reg_name_16(id: Int) -> String {
    if id == 0 { return "%ax";
    }
    if id == 1 { return "%cx";
    }
    if id == 2 { return "%dx";
    }
    if id == 3 { return "%si";
    }
    if id == 4 { return "%di";
    }
    if id == 5 { return "%r8w";
    }
    if id == 6 { return "%r9w";
    }
    if id == 7 { return "%r10w";
    }
    if id == 8 { return "%r11w";
    }
    if id == 9 { return "%bx";
    }
    if id == 10 { return "%r12w";
    }
    if id == 11 { return "%r13w";
    }
    if id == 12 { return "%r14w";
    }
    if id == 13 { return "%r15w";
    }
    return "%ax";
}

pub fn x86_reg_name_8(id: Int) -> String {
    if id == 0 { return "%al";
    }
    if id == 1 { return "%cl";
    }
    if id == 2 { return "%dl";
    }
    if id == 3 { return "%sil";
    }
    if id == 4 { return "%dil";
    }
    if id == 5 { return "%r8b";
    }
    if id == 6 { return "%r9b";
    }
    if id == 7 { return "%r10b";
    }
    if id == 8 { return "%r11b";
    }
    if id == 9 { return "%bl";
    }
    if id == 10 { return "%r12b";
    }
    if id == 11 { return "%r13b";
    }
    if id == 12 { return "%r14b";
    }
    if id == 13 { return "%r15b";
    }
    return "%al";
}

pub fn x86_reg_is_callee_saved(id: Int) -> Bool { return id >= 9 && id <= 13; }

pub fn x86_reg_is_caller_saved(id: Int) -> Bool { return id >= 0 && id <= 6; }

pub fn x86_scratch_reg_1() -> Int { return 7; }

pub fn x86_scratch_reg_2() -> Int { return 8; }

pub fn x86_is_scratch_reg(id: Int) -> Bool { return id == 7 || id == 8; }

pub fn x86_reg_arg_index(id: Int) -> Int {
    if id == 4 { return 0;
    }
    if id == 3 { return 1;
    }
    if id == 2 { return 2;
    }
    if id == 1 { return 3;
    }
    if id == 5 { return 4;
    }
    if id == 6 { return 5;
    }
    return -1;
}

pub fn x86_arg_to_reg(arg_idx: Int) -> Int {
    if arg_idx == 0 { return 4;
    }
    if arg_idx == 1 { return 3;
    }
    if arg_idx == 2 { return 2;
    }
    if arg_idx == 3 { return 1;
    }
    if arg_idx == 4 { return 5;
    }
    if arg_idx == 5 { return 6;
    }
    return -1;
}

pub fn x86_all_reg_ids() -> List[Int] {
    let mut xs: List[Int] = list_new();
    let mut i: Int = 0;
    while i <= 6 { xs = list_push(xs, i);
    i = i + 1;
    }
    i = 9;
    while i <= 13 { xs = list_push(xs, i);
    i = i + 1;
    }
    return xs;
}

pub fn x86_caller_saved_reg_ids() -> List[Int] {
    let mut xs: List[Int] = list_new();
    let mut i: Int = 0;
    while i <= 6 { xs = list_push(xs, i);
    i = i + 1;
    }
    return xs;
}

pub fn x86_callee_saved_reg_ids() -> List[Int] {
    let mut xs: List[Int] = list_new();
    let mut i: Int = 9;
    while i <= 13 { xs = list_push(xs, i);
    i = i + 1;
    }
    return xs;
}

pub fn x86_reg_alloc_order() -> List[Int] {
    let mut xs: List[Int] = list_new();
    // Prioritize argument and caller-saved registers first
    xs = list_push(xs, 1);
    // %rcx
    xs = list_push(xs, 2);
    // %rdx
    xs = list_push(xs, 3);
    // %rsi
    xs = list_push(xs, 4);
    // %rdi
    xs = list_push(xs, 5);
    // %r8
    xs = list_push(xs, 6);
    // %r9
    // Next callee-saved registers
    xs = list_push(xs, 9);
    // %rbx
    xs = list_push(xs, 10);
    // %r12
    xs = list_push(xs, 11);
    // %r13
    xs = list_push(xs, 12);
    // %r14
    xs = list_push(xs, 13);
    // %r15
    // Reserve %rax as last resort for unconstrained registers
    xs = list_push(xs, 0);
    // %rax
    return xs;
}

pub fn x86_spill_offset(n_callee: Int, slot: Int) -> Int { return (n_callee + slot + 1) * -8; }
