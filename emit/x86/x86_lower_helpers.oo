// # Shared sys_write digit loop for %rax (zero-libc println_int) / x86-64 sys_mmap bump pages / SysV stack frame for emit-x86 callees / System V aggregate return lowering
//
// Logline: Formats the signed integer in %rax and writes it plus a newline via sys_write. Returns cap-gated anonymous mmap bytes for a bump arena. Prints AT&T enter as push/mov and leave as pop/ret for SysV callees. Classifies struct and Result returns as register-pair or hidden-pointer SRet.
//
// Setup: Merged cohesive compiler module.
//
// Beats:
//   1. Unified cohesive implementation.

import "std/hw/bare_metal/mmap_arena.oo";

pub fn x86_sysv_print_rax_d() -> String {
    return "    subq $40, %rsp\n    movb $10, 39(%rsp)\n    lea 39(%rsp), %rcx\n    mov $1, %r8\n    mov $0, %r9\n    test %rax, %rax\n    jnz .Lx86_pr_nz\n    dec %rcx\n    movb $48, (%rcx)\n    inc %r8\n    jmp .Lx86_pr_w\n.Lx86_pr_nz:\n    test %rax, %rax\n    jns .Lx86_pr_pos\n    neg %rax\n    mov $1, %r9\n.Lx86_pr_pos:\n.Lx86_pr_lp:\n    xor %rdx, %rdx\n    mov $10, %rbx\n    div %rbx\n    addb $48, %dl\n    dec %rcx\n    movb %dl, (%rcx)\n    inc %r8\n    test %rax, %rax\n    jnz .Lx86_pr_lp\n    test %r9, %r9\n    jz .Lx86_pr_w\n    dec %rcx\n    movb $45, (%rcx)\n    inc %r8\n.Lx86_pr_w:\n    mov $1, %rax\n    mov $1, %rdi\n    mov %rcx, %rsi\n    mov %r8, %rdx\n    syscall\n    addq $40, %rsp\n";
}

pub fn x86_rt_mmap_code(tag: Int, len: Int) -> ByteOut {
    return bare_mmap_len(tag, len);
}

pub fn x86_rt_mmap_sysno() -> Int {
    return 9;
}

pub fn x86_emit_frame_enter() {
    println("    push %rbp");
    println("    mov %rsp, %rbp");
}

pub fn x86_emit_frame_leave() {
    println("    pop %rbp");
    println("    ret");
}

pub fn x86_ssa_agg_bytes(nbytes: Int) -> Int {
    if nbytes <= 0 { return 8;
}
    return nbytes;
}

pub fn x86_ssa_needs_sret(nbytes: Int) -> Int {
    let n: Int = x86_ssa_agg_bytes(nbytes);
if n > 16 { return 1;
}
    return 0;
}

pub fn x86_ssa_sret_reg() -> Int {
    return 7;
}
