// # Option and Result pattern match lower for emit-x86
//
// Logline: Lowers 2-to-8 arm Option and Result pattern matches from typed AST to x86-64 SSA control-flow branches.
//
// Setup: import token_fmt.oo and ast_parse.oo. Tag mapping: None=0, Some=1, Err=2, Ok=3, V4..V8=4..8.
//
// Beats:
//   1. Parse typed AST and extract Option / Result constructors and match arms.
//   2. Store discriminant tag at -16(%rbp) and payload at -8(%rbp).
//   3. Lower 2-8 arm conditional branch cascades with strict tag validation (cmpq, je, jmp).
//   4. Bind payload into arm execution bodies and emit fail-closed handlers.
//



fn x86_ma_print_rax() -> String {
    return "    subq $40, %rsp\n    movb $10, 39(%rsp)\n    lea 39(%rsp), %rcx\n    mov $1, %r8\n    mov $0, %r9\n    test %rax, %rax\n    jnz .Lp_nz\n    dec %rcx\n    movb $48, (%rcx)\n    inc %r8\n    jmp .Lp_pr\n.Lp_nz:\n    test %rax, %rax\n    jns .Lp_pos\n    neg %rax\n    mov $1, %r9\n.Lp_pos:\n.Lp_lp:\n    xor %rdx, %rdx\n    mov $10, %rbx\n    div %rbx\n    addb $48, %dl\n    dec %rcx\n    movb %dl, (%rcx)\n    inc %r8\n    test %rax, %rax\n    jnz .Lp_lp\n    test %r9, %r9\n    jz .Lp_pr\n    dec %rcx\n    movb $45, (%rcx)\n    inc %r8\n.Lp_pr:\n    mov $1, %rax\n    mov $1, %rdi\n    mov %rcx, %rsi\n    mov %r8, %rdx\n    syscall\n    addq $40, %rsp\n";
}

fn x86_ma_args(node: String) -> String {
    let n: Int = chars_len(node);
    let mut depth: Int = 0; let mut start: Int = 0; let mut i: Int = 0; let mut hit: Bool = false;
    while i < n {
        let c: String = char_at(node, i);
        if c == "(" { if depth == 0 { start = i + 1; hit = true; } depth = depth + 1; }
        if c == ")" { depth = depth - 1; if depth == 0 && hit { return str_slice(node, start, i); } }
        i = i + 1;
    }
    return "";
}

fn x86_ma_arg_at(args: String, idx: Int) -> String {
    let n: Int = chars_len(args);
    let mut depth: Int = 0; let mut cur: Int = 0; let mut start: Int = 0; let mut i: Int = 0;
    while i < n {
        let c: String = char_at(args, i);
        if c == "(" || c == "{" || c == "[" { depth = depth + 1; }
        else if c == ")" || c == "}" || c == "]" { depth = depth - 1; }
        else if c == "," && depth == 0 {
            if cur == idx { return str_slice(args, start, i); }
            cur = cur + 1; start = i + 1;
        }
        i = i + 1;
    }
    if cur == idx && start <= n { return str_slice(args, start, n); }
    return "";
}

fn x86_ma_arg_count(args: String) -> Int {
    if chars_len(args) == 0 { return 0; }
    let n: Int = chars_len(args);
    let mut depth: Int = 0; let mut count: Int = 1; let mut i: Int = 0;
    while i < n {
        let c: String = char_at(args, i);
        if c == "(" || c == "{" || c == "[" { depth = depth + 1; }
        else if c == ")" || c == "}" || c == "]" { depth = depth - 1; }
        else if c == "," && depth == 0 { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn x86_match_tag_id(name: String) -> Int {
    if name == "None" || name == "V0" || name == "Arm0" { return 0; }
    if name == "Some" || name == "V1" || name == "Arm1" { return 1; }
    if name == "Err" || name == "V2" || name == "Arm2" { return 2; }
    if name == "Ok" || name == "V3" || name == "Arm3" { return 3; }
    if name == "V4" || name == "Arm4" { return 4; }
    if name == "V5" || name == "Arm5" { return 5; }
    if name == "V6" || name == "Arm6" { return 6; }
    if name == "V7" || name == "Arm7" { return 7; }
    if name == "V8" || name == "Arm8" { return 8; }
    let n: Int = chars_len(name);
    if n > 1 {
        let b: Int = byte_at(name, n - 1);
        if b >= 48 && b <= 57 { return b - 48; }
    }
    if name == "BadTag" || name == "Invalid" || name == "Unmatched" { return 99; }
    return -1;
}

fn x86_ma_extract_val(expr: String, snames: List[String], svals: List[String]) -> String {
    let tag: String = ast_tag(expr);
    let args: String = x86_ma_args(expr);
    if tag == "ELitInt" || tag == "ELitBool" { return x86_ma_arg_at(args, 0); }
    if tag == "EVar" {
        let vname: String = x86_ma_arg_at(args, 0);
        let idx: Int = 0 + x86_bind_idx(snames, vname);
        if idx >= 0 { return list_get(svals, idx); }
        return "0";
    }
    if tag == "EField" {
        let bnode: String = x86_ma_arg_at(args, 0);
        let bname: String = if ast_tag(bnode) == "EVar" { x86_ma_arg_at(x86_ma_args(bnode), 0) } else { bnode };
        let fname: String = x86_ma_arg_at(args, 1);
        let key: String = bname + "." + fname;
        let idx: Int = 0 + x86_bind_idx(snames, key);
        if idx >= 0 { return list_get(svals, idx); }
        return "0";
    }
    if tag == "EUnop" {
        let op: String = x86_ma_arg_at(args, 0);
        let inner: String = x86_ma_extract_val(x86_ma_arg_at(args, 1), snames, svals);
        if op == "Neg" { return "-" + inner; }
        return inner;
    }
    return "0";
}

pub fn x86_ssa_match_main_asm_d(src: String) -> String {
    let toks: List[String] = tokenize_lines(src);
    if list_len(toks) == 0 { return ""; }
    let ast_str: String = ast_parse_b(toks);
    if chars_len(ast_str) == 0 { return ""; }
    let file_args: String = x86_ma_args(ast_str);
    let n_items: Int = x86_ma_arg_count(file_args);
    let mut fn_body_node: String = "";
    let mut it: Int = 0;
    while it < n_items { let item: String = x86_ma_arg_at(file_args, it); if ast_tag(item) == "AstFn" { let iargs: String = x86_ma_args(item); if x86_ma_arg_at(iargs, 0) == "main" { fn_body_node = x86_ma_arg_at(iargs, x86_ma_arg_count(iargs) - 1); }
        }
        it = it + 1;
    }
    if chars_len(fn_body_node) == 0 { return ""; }
    let body_args: String = x86_ma_args(fn_body_node);
    let n_stmts: Int = x86_ma_arg_count(body_args);
    let mut snames: List[String] = list_new();
    let mut svals: List[String] = list_new();
    let mut ctor: String = "";
    let mut pay: String = "0";
    let mut match_stmt_node: String = "";
    let mut si: Int = 0;
    while si < n_stmts { let stmt: String = x86_ma_arg_at(body_args, si); let stag: String = ast_tag(stmt); let sargs: String = x86_ma_args(stmt); if stag == "SLet" || stag == "SLetMut" { let vname: String = x86_ma_arg_at(sargs, 0); let rhs: String = x86_ma_arg_at(sargs, 2); let rtag: String = ast_tag(rhs); let rargs: String = x86_ma_args(rhs); if rtag == "EStructLit" { let ni: Int = x86_ma_arg_count(rargs); let mut ii: Int = 1; while ii < ni { let fi_node: String = x86_ma_arg_at(rargs, ii); if ast_tag(fi_node) == "AstField" { let fi_args: String = x86_ma_args(fi_node); let fnm: String = x86_ma_arg_at(fi_args, 0); let fval: String = x86_ma_extract_val(x86_ma_arg_at(fi_args, 1), snames, svals); snames = list_push(snames, vname + "." + fnm); svals = list_push(svals, fval); }
                    ii = ii + 1;
                }
            } else if rtag == "ECall" {
                let callee: String = x86_ma_arg_at(rargs, 0);
                let cname: String = if ast_tag(callee) == "EVar" { x86_ma_arg_at(x86_ma_args(callee), 0) } else { callee };
                let tid: Int = x86_match_tag_id(cname);
                if tid >= 0 { ctor = cname; pay = x86_ma_extract_val(x86_ma_arg_at(rargs, 1), snames, svals); }
            } else if rtag == "EVar" {
                let vn: String = x86_ma_arg_at(rargs, 0);
                if vn == "None" { ctor = "None"; pay = "0"; }
            }
        }
        if stag == "SExpr" {
            let expr: String = x86_ma_arg_at(sargs, 0);
            if ast_tag(expr) == "EMatch" {
                match_stmt_node = expr;
            }
        }
        si = si + 1;
    }
    if chars_len(match_stmt_node) == 0 { return ""; }
    let margs: String = x86_ma_args(match_stmt_node);
    let total_margs: Int = x86_ma_arg_count(margs);
    if total_margs <= 1 { return ""; }
    let num_arms: Int = total_margs - 1;
    let mut arm_tags: List[String] = list_new();
    let mut arm_bind: List[Int] = list_new();
    let mut a: Int = 0;
    while a < num_arms { let arm_node: String = x86_ma_arg_at(margs, a + 1); let arm_data: String = x86_ma_args(arm_node); let pat_node: String = x86_ma_arg_at(arm_data, 0); let ptag: String = ast_tag(pat_node); let pargs: String = x86_ma_args(pat_node); let mut tag_name: String = ""; let mut uses_b: Int = 0; if ptag == "ECall" { let callee_n: String = x86_ma_arg_at(pargs, 0); if ast_tag(callee_n) == "EVar" { tag_name = x86_ma_arg_at(x86_ma_args(callee_n), 0); } else {
                tag_name = callee_n;
            }
            uses_b = 1;
        } else if ptag == "EVar" {
            tag_name = x86_ma_arg_at(pargs, 0);
            uses_b = 0;
        }
        arm_tags = list_push(arm_tags, tag_name);
        arm_bind = list_push(arm_bind, uses_b);
        a = a + 1;
    }
    let actual_tid: Int = x86_match_tag_id(ctor);
    let mut out: String = "    .text\n    .globl main\n    .globl _start\nmain:\n_start:\n    push %rbp\n    mov %rsp, %rbp\n    subq $48, %rsp\n";
    out = out + "    movq $" + actual_tid.to_string() + ", -16(%rbp)\n    movq $" + pay + ", -8(%rbp)\n";
    a = 0;
    while a < num_arms { let tname: String = list_get(arm_tags, a); let tid: Int = x86_match_tag_id(tname); out = out + "    cmpq $" + tid.to_string() + ", -16(%rbp)\n    je .Larm_" + a.to_string() + "\n"; a = a + 1; }
    out = out + "    jmp .Lmfail\n";
    a = 0;
    while a < num_arms { out = out + ".Larm_" + a.to_string() + ":\n"; if list_get(arm_bind, a) == 1 { out = out + "    movq -8(%rbp), %rax\n"; } else {
            out = out + "    movq $0, %rax\n";
        }
        out = out + "    jmp .Lmprint\n";
        a = a + 1;
    }
    out = out + ".Lmfail:\n    mov $60, %rax\n    mov $1, %rdi\n    syscall\n.Lmprint:\n" + x86_ma_print_rax() + "    leave\n    mov $60, %rax\n    xor %rdi, %rdi\n    syscall\n";
    return out;
}

pub fn x86_ssa_match_main_asm(src: String) -> String {
    return x86_ssa_match_main_asm_d(src);
}
pub fn x86_ssa_match_main_asm_e(src: String) -> String {
    return x86_ssa_match_main_asm_d(src);
}
