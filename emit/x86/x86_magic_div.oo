// # x86-64 Reciprocal Magic Multiplier Calculation
//
// Logline: Computes Granlund-Montgomery magic multipliers, post-shifts, and add-indicators for fast 64-bit integer division and modulo without hardware idivq.
//
// Setup: Pure algorithmic arithmetic module following Granlund-Montgomery and Hacker's Delight.
//
// Beats:
//   1. Identify powers of two and calculate arithmetic sign-bias shift parameters.
//   2. Compute signed 64-bit Granlund-Montgomery magic multipliers, shifts, and add indicators.
//   3. Compute unsigned 64-bit Granlund-Montgomery reciprocal multipliers and high-add indicators.
//   4. Provide fast LEA-multiplier and modulo synthesis helpers for constant strength reduction.

pub type X86MagicDiv = struct {
    magic: Int,
    shift: Int,
    add_indicator: Int
};

pub fn x86_magic_div_new(magic: Int, shift: Int, add_indicator: Int) -> X86MagicDiv {
    let res: X86MagicDiv = X86MagicDiv { magic: magic, shift: shift, add_indicator: add_indicator };
    return res;
}

pub fn x86_abs_s64(v: Int) -> Int {
    if v < 0 { return 0 - v;
    }
    return v;
}

pub fn x86_is_power_of_two(d: Int) -> Bool {
    let ad: Int = 0 + x86_abs_s64(d);
    if ad <= 0 { return false;
    }
    return (ad & (ad - 1)) == 0;
}

pub fn x86_power_of_two_shift(d: Int) -> Int {
    let ad: Int = 0 + x86_abs_s64(d);
let mut shift: Int = 0;
let mut tmp: Int = ad;
while tmp > 1 { shift = shift + 1;
tmp = tmp >> 1;
}
    return shift;
}

pub fn x86_power_of_two_exp(d: Int) -> Int {
    return 0 + x86_power_of_two_shift(d);
}

pub fn x86_compute_magic_s64(d: Int) -> X86MagicDiv {
    let ad: Int = 0 + x86_abs_s64(d);
    if ad <= 1 { return x86_magic_div_new(0, 0, 0);
    }
    if x86_is_power_of_two(ad) {
        return x86_magic_div_new(0, 0 + x86_power_of_two_shift(ad), 0);
    }
    let two_63_m1: Int = 9223372036854775807;
    let t_m1: Int = two_63_m1;
    let anc: Int = t_m1 - (t_m1 % ad);
    let mut p: Int = 63;
    let mut q1: Int = two_63_m1 / anc;
    let mut r1: Int = (two_63_m1 % anc) + 1;
    if r1 >= anc { q1 = q1 + 1;
    r1 = r1 - anc;
    }
    let mut q2: Int = two_63_m1 / ad;
    let mut r2: Int = (two_63_m1 % ad) + 1;
    if r2 >= ad { q2 = q2 + 1;
    r2 = r2 - ad;
    }
    let mut more: Bool = true;
    while more {
        p = p + 1;
        q1 = q1 + q1;
        if r1 >= anc - r1 { q1 = q1 + 1;
        r1 = r1 - (anc - r1);
        }
        else { r1 = r1 + r1;
        }
        q2 = q2 + q2;
        if r2 >= ad - r2 { q2 = q2 + 1;
        r2 = r2 - (ad - r2);
        }
        else { r2 = r2 + r2;
        }
        let delta: Int = ad - r2;
        if q1 > delta || (q1 == delta && r1 > 0) { more = false;
        }
    }
    let m: Int = q2 + 1;
    let add_ind: Int = if m < 0 { 1 } else { 0 };
    let shift: Int = p - 64;
    return x86_magic_div_new(m, shift, add_ind);
}

pub fn x86_compute_magic_u64(d: Int) -> X86MagicDiv {
    if d <= 1 { return x86_magic_div_new(0, 0, 0);
    }
    if x86_is_power_of_two(d) {
        return x86_magic_div_new(0, 0 + x86_power_of_two_shift(d), 0);
    }
    let mut l: Int = 0;
    let mut cur: Int = 1;
    while cur < d && l < 62 { l = l + 1;
    cur = cur << 1;
    }
    let two_63_m1: Int = 9223372036854775807;
    let mut q0: Int = (two_63_m1 / d) * 2;
    let mut r0: Int = ((two_63_m1 % d) + 1) * 2;
    if r0 >= d { q0 = q0 + (r0 / d);
    r0 = r0 % d;
    }
    let mut q_acc: Int = q0;
    let mut r_acc: Int = r0;
    let mut step: Int = 0;
    while step < l {
        q_acc = q_acc * 2;
        r_acc = r_acc * 2;
        if r_acc >= d { q_acc = q_acc + (r_acc / d);
        r_acc = r_acc % d;
        }
        step = step + 1;
    }
    let mut low: Int = q_acc;
    let scale_pow: Int = 1 << l;
    let mut high: Int = q_acc + ((r_acc + scale_pow) / d);
    let mut cur_l: Int = l;
    while (low >> 1) < (high >> 1) && cur_l > 0 { low = low >> 1;
    high = high >> 1;
    cur_l = cur_l - 1;
    }
    let add_ind: Int = if high < 0 { 1 } else { 0 };
    return x86_magic_div_new(high, cur_l, add_ind);
}

pub fn x86_can_fold_lea_multiplier(d: Int) -> Bool {
    let ad: Int = 0 + x86_abs_s64(d);
return ad == 3 || ad == 5 || ad == 6 || ad == 7 || ad == 9 || ad == 10 || ad == 11;
}

pub fn x86_emit_lea_multiplier(dst_reg: String, src_reg: String, d: Int) -> List[String] {
    let mut lines: List[String] = list_new();
    let ad: Int = 0 + x86_abs_s64(d);
    if ad == 3 { lines = list_push(lines, "    leaq (" + src_reg + "," + src_reg + ",2), " + dst_reg + "\n");
    } else if ad == 5 { lines = list_push(lines, "    leaq (" + src_reg + "," + src_reg + ",4), " + dst_reg + "\n");
    } else if ad == 6 { lines = list_push(lines, "    leaq (" + src_reg + "," + src_reg + ",2), " + dst_reg + "\n");
    lines = list_push(lines, "    addq " + dst_reg + ", " + dst_reg + "\n");
    } else if ad == 7 { lines = list_push(lines, "    leaq 0(," + src_reg + ",8), " + dst_reg + "\n");
    lines = list_push(lines, "    subq " + src_reg + ", " + dst_reg + "\n");
    } else if ad == 9 { lines = list_push(lines, "    leaq (" + src_reg + "," + src_reg + ",8), " + dst_reg + "\n");
    } else if ad == 10 { lines = list_push(lines, "    leaq (" + src_reg + "," + src_reg + ",4), " + dst_reg + "\n");
    lines = list_push(lines, "    addq " + dst_reg + ", " + dst_reg + "\n");
    } else if ad == 11 { lines = list_push(lines, "    leaq (" + src_reg + "," + src_reg + ",4), " + dst_reg + "\n");
    lines = list_push(lines, "    leaq (" + src_reg + "," + dst_reg + ",2), " + dst_reg + "\n");
    }
    return lines;
}
