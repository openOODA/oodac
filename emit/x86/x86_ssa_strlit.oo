// # Rewire SSA println_int of string literals to println_str
//
// Logline: Token-walk println STRING sites and rewrite matching SSA op 23 to op 24 with intern ids plus rodata.
//
// Setup: Used by x86_ssa_compile_program after mem2reg. STRING text is token field 3.
//
// Beats:
//   1. Collect println STRING texts in source order.
//   2. Pair 1:1 with SSA println_int ops; rewrite to println_str.
//   3. Return intern pool for .Lstr_N rodata.

import "emit/llvm/ssa_ir.oo";
import "x86_emit_const_harvest.oo";


pub fn x86_collect_println_strs(src: String) -> List[String] {
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i + 2 < n { if x86_tok_k(toks, i) == "IDENT" && x86_tok_t(toks, i) == "println" && x86_tok_k(toks, i + 1) == "LPAREN" && x86_tok_k(toks, i + 2) == "STRING" { out = list_push(out, x86_tok_t(toks, i + 2));
    }
        i = i + 1;
    }
    return out;
}

fn x86_str_intern(pool: List[String], s: String) -> List[String] {
    let n: Int = list_len(pool);
    let mut i: Int = 0;
    while i < n {
        if list_get(pool, i) == s { return pool;
        }
        i = i + 1;
    }
    return list_push(pool, s);
}

fn x86_str_id(pool: List[String], s: String) -> Int {
    let n: Int = list_len(pool);
    let mut i: Int = 0;
    while i < n {
        if list_get(pool, i) == s { return i;
        }
        i = i + 1;
    }
    return 0;
}

pub fn x86_rewire_println_str(fn_data: SsaFunction, strs: List[String]) -> SsaFunction {
    let ns: Int = list_len(strs);
    if ns == 0 { return fn_data;
    }
    let n: Int = list_len(fn_data.inst_opcodes);
    let mut npi: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if list_get(fn_data.inst_opcodes, i) == 23 { npi = npi + 1;
        }
        i = i + 1;
    }
    if npi != ns { return fn_data;
    }
    let mut pool: List[String] = list_new();
    let mut si: Int = 0;
    while si < ns { pool = x86_str_intern(pool, list_get(strs, si));
    si = si + 1;
    }
    let mut out_ops: List[Int] = list_new();
    let mut out_res: List[Int] = list_new();
    let mut out_imms: List[Int] = list_new();
    let mut out_lhss: List[Int] = list_new();
    let mut out_bids: List[Int] = list_new();
    i = 0;
    let mut site: Int = 0;
    while i < n { let op: Int = list_get(fn_data.inst_opcodes, i);
    let mut nop: Int = op;
    let mut nimm: Int = list_get(fn_data.inst_imm_vals, i);
    if op == 23 && site < ns { nop = 24;
    nimm = x86_str_id(pool, list_get(strs, site));
    site = site + 1;
    }
        out_ops = list_push(out_ops, nop);
        out_res = list_push(out_res, list_get(fn_data.inst_results, i));
        out_imms = list_push(out_imms, nimm);
        out_lhss = list_push(out_lhss, list_get(fn_data.inst_lhs_vals, i));
        out_bids = list_push(out_bids, list_get(fn_data.inst_block_ids, i));
        i = i + 1;
    }
    return SsaFunction { name: fn_data.name, return_type: fn_data.return_type, block_count: fn_data.block_count, block_names: fn_data.block_names, inst_opcodes: out_ops, inst_results: out_res, inst_imm_vals: out_imms, inst_lhs_vals: out_lhss, inst_block_ids: out_bids };
}

pub fn x86_src_leftover_unhandled(src: String) -> Bool {
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    let mut in_while: Bool = false;
    let mut wdepth: Int = 0;
    while i + 1 < n {
        let k: String = x86_tok_k(toks, i);
        if k == "KW_ELSE" && x86_tok_k(toks, i + 1) == "KW_IF" { return true;
        }
        if k == "KW_WHILE" { in_while = true;
        wdepth = 0;
        }
        if in_while && k == "LBRACE" { wdepth = wdepth + 1;
        }
        if in_while && k == "RBRACE" { wdepth = wdepth - 1;
        if wdepth <= 0 { in_while = false;
        } }
        if in_while && k == "KW_IF" { return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn x86_println_str_pool(strs: List[String]) -> List[String] {
    let n: Int = list_len(strs);
    let mut pool: List[String] = list_new();
    let mut i: Int = 0;
    while i < n { pool = x86_str_intern(pool, list_get(strs, i));
    i = i + 1;
    }
    return pool;
}
