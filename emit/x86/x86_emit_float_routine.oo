// # Standalone zero-libc _println_float routine
//
// Logline: Prints a 64-bit IEEE-754 double as integer.frac (always 2 decimal places) via sys_write.
//
// Setup: imports nothing. Caller emits `.globl _println_float` and the routine body.
//
// Beats:
//   1. Receive double in %xmm0, extract sign, integer part via cvttsd2si, fractional part by 100x round.
//   2. Format the digits in a stack buffer, prepend minus if sign.
//   3. sys_write the buffer.

pub fn x86_emit_float_routine() {
    println(".globl _println_float");
    println(".p2align 4");
    println("_println_float:");
    println("    push %rbp");
    println("    mov %rsp, %rbp");
    println("    sub $64, %rsp");
    println("    movq %xmm0, %rax");
    println("    mov $0, %r8");
    println("    test %rax, %rax");
    println("    jns .Lp_nonneg");
    println("    mov $1, %r8");
    println("    mov $0x7FFFFFFFFFFFFFFF, %rcx");
    println("    and %rcx, %rax");
    println("    movq %rax, %xmm0");
    println(".Lp_nonneg:");
    println("    cvttsd2si %xmm0, %rax");
    println("    cvtsi2sd %rax, %xmm1");
    println("    subsd %xmm1, %xmm0");
    println("    mulsd .Lconst_100(%rip), %xmm0");
    println("    addsd .Lconst_half(%rip), %xmm0");
    println("    cvttsd2si %xmm0, %rcx");
    println("    cmp $100, %rcx");
    println("    jl .Lp_fmt");
    println("    inc %rax");
    println("    xor %rcx, %rcx");
    println(".Lp_fmt:");
    println("    mov %rax, %r9");
    println("    lea -1(%rbp), %rdi");
    println("    movb $10, (%rdi)");
    println("    mov %rcx, %rax");
    println("    xor %rdx, %rdx");
    println("    mov $10, %r10");
    println("    div %r10");
    println("    dec %rdi");
    println("    add $48, %dl");
    println("    movb %dl, (%rdi)");
    println("    dec %rdi");
    println("    add $48, %al");
    println("    movb %al, (%rdi)");
    println("    dec %rdi");
    println("    movb $46, (%rdi)");
    println("    mov %r9, %rax");
    println("    test %rax, %rax");
    println("    jnz .Lp_int_loop");
    println("    dec %rdi");
    println("    movb $48, (%rdi)");
    println("    jmp .Lp_sign");
    println(".Lp_int_loop:");
    println("    test %rax, %rax");
    println("    jz .Lp_sign");
    println("    xor %rdx, %rdx");
    println("    mov $10, %r10");
    println("    div %r10");
    println("    dec %rdi");
    println("    add $48, %dl");
    println("    movb %dl, (%rdi)");
    println("    jmp .Lp_int_loop");
    println(".Lp_sign:");
    println("    test %r8, %r8");
    println("    jz .Lp_write");
    println("    dec %rdi");
    println("    movb $45, (%rdi)");
    println(".Lp_write:");
    println("    mov %rbp, %rdx");
    println("    sub %rdi, %rdx");
    println("    mov %rdi, %rsi");
    println("    mov $1, %rax");
    println("    mov $1, %rdi");
    println("    syscall");
    println("    mov %rbp, %rsp");
    println("    pop %rbp");
    println("    ret");
}
