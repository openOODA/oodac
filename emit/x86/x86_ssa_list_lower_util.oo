// # AST helpers for x86-64 List[T] lowering
//
// Logline: Shared argument parsing, variable-slot, and expression lowering helpers for x86_ssa_list_lower.
//
// Setup: import token_fmt.oo and ast_parse.oo. Used by x86_ssa_list_lower.oo.
//
// Beats:
//   1. Extract arguments from AST s-expressions.
//   2. Map variable names to stack slots.
//   3. Lower literals, variables, binary ops, and list runtime calls to x86-64 assembly.
//   4. Emit a digit-printing helper for println integer output.




pub fn x86_li_args(node: String) -> String {
    let n: Int = chars_len(node);
    let mut depth: Int = 0;
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut hit: Bool = false;
    while i < n {
        let c: String = char_at(node, i);
        if c == "(" {
            if depth == 0 { start = i + 1;
            hit = true;
            }
            depth = depth + 1;
        }
        if c == ")" {
            depth = depth - 1;
            if depth == 0 && hit { return str_slice(node, start, i);
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn x86_li_arg_at(args: String, idx: Int) -> String {
    let n: Int = chars_len(args);
    let mut depth: Int = 0;
    let mut cur: Int = 0;
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(args, i);
        if c == "(" || c == "{" || c == "[" { depth = depth + 1;
        }
        else if c == ")" || c == "}" || c == "]" { depth = depth - 1;
        }
        else if c == "," && depth == 0 {
            if cur == idx { return str_slice(args, start, i);
            }
            cur = cur + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if cur == idx && start <= n { return str_slice(args, start, n);
    }
    return "";
}

pub fn x86_li_arg_count(args: String) -> Int {
    if chars_len(args) == 0 { return 0;
    }
    let n: Int = chars_len(args);
    let mut depth: Int = 0;
    let mut count: Int = 1;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(args, i);
        if c == "(" || c == "{" || c == "[" { depth = depth + 1;
        }
        else if c == ")" || c == "}" || c == "]" { depth = depth - 1;
        }
        else if c == "," && depth == 0 { count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn x86_li_env_slot(vars: List[String], name: String) -> String {
    let n: Int = list_len(vars);
let mut i: Int = 0;
while i < n { if list_get(vars, i) == name { let off: Int = (i + 1) * -8;
return off.to_string() + "(%rbp)";
}
        i = i + 1;
    }
    return "-8(%rbp)";
}

pub fn x86_li_print_rax(id: String) -> String {
    return "    subq $40, %rsp\n    movb $10, 39(%rsp)\n    lea 39(%rsp), %rcx\n    mov $1, %r8\n    mov $0, %r9\n    test %rax, %rax\n    jnz .Lx86_lst_nz_" + id + "\n    dec %rcx\n    movb $48, (%rcx)\n    inc %r8\n    jmp .Lx86_lst_pr_" + id + "\n.Lx86_lst_nz_" + id + ":\n    test %rax, %rax\n    jns .Lx86_lst_pos_" + id + "\n    neg %rax\n    mov $1, %r9\n.Lx86_lst_pos_" + id + ":\n.Lx86_lst_lp_" + id + ":\n    xor %rdx, %rdx\n    mov $10, %rbx\n    div %rbx\n    addb $48, %dl\n    dec %rcx\n    movb %dl, (%rcx)\n    inc %r8\n    test %rax, %rax\n    jnz .Lx86_lst_lp_" + id + "\n    test %r9, %r9\n    jz .Lx86_lst_pr_" + id + "\n    dec %rcx\n    movb $45, (%rcx)\n    inc %r8\n.Lx86_lst_pr_" + id + ":\n    mov $1, %rax\n    mov $1, %rdi\n    mov %rcx, %rsi\n    mov %r8, %rdx\n    syscall\n    addq $40, %rsp\n";
}

pub fn x86_li_callee_name(callee: String) -> String {
    let tag: String = ast_tag(callee);
    if tag == "EVar" { return x86_li_arg_at(x86_li_args(callee), 0);
    }
    return callee;
}

pub fn x86_li_lower_expr(expr: String, vars: List[String], pid: Int) -> String {
    let tag: String = ast_tag(expr);
    let args: String = x86_li_args(expr);
    if tag == "ELitInt" { return "    movq $" + x86_li_arg_at(args, 0) + ", %rax\n";
    }
    if tag == "ELitBool" { let bval: String = if x86_li_arg_at(args, 0) == "true" { "1" } else { "0" };
    return "    movq $" + bval + ", %rax\n";
    }
    if tag == "EVar" { return "    movq " + x86_li_env_slot(vars, x86_li_arg_at(args, 0)) + ", %rax\n";
    }
    if tag == "EBinop" {
        let op: String = x86_li_arg_at(args, 0);
        let l_node: String = x86_li_arg_at(args, 1);
        let r_node: String = x86_li_arg_at(args, 2);
        if op == "Assign" {
            let r_code: String = x86_li_lower_expr(r_node, vars, pid);
            let vname: String = if ast_tag(l_node) == "EVar" { x86_li_arg_at(x86_li_args(l_node), 0) } else { l_node };
            return r_code + "    movq %rax, " + x86_li_env_slot(vars, vname) + "\n";
        }
        let mut code: String = x86_li_lower_expr(l_node, vars, pid);
        code = code + "    pushq %rax\n" + x86_li_lower_expr(r_node, vars, pid + 1);
        code = code + "    movq %rax, %r10\n    popq %rax\n";
        if op == "Add" || op == "+" { code = code + "    addq %r10, %rax\n";
        }
        else if op == "Sub" || op == "-" { code = code + "    subq %r10, %rax\n";
        }
        else if op == "Mul" || op == "*" { code = code + "    imulq %r10, %rax\n";
        }
        else if op == "Div" || op == "/" { code = code + "    cqto\n    idivq %r10\n";
        }
        else if op == "Mod" || op == "%" { code = code + "    cqto\n    idivq %r10\n    movq %rdx, %rax\n";
        }
        else if op == "Lt" || op == "<" { code = code + "    cmpq %r10, %rax\n    setl %al\n    movzbq %al, %rax\n";
        }
        else if op == "Lte" || op == "<=" { code = code + "    cmpq %r10, %rax\n    setle %al\n    movzbq %al, %rax\n";
        }
        else if op == "Gt" || op == ">" { code = code + "    cmpq %r10, %rax\n    setg %al\n    movzbq %al, %rax\n";
        }
        else if op == "Gte" || op == ">=" { code = code + "    cmpq %r10, %rax\n    setge %al\n    movzbq %al, %rax\n";
        }
        else if op == "Eq" || op == "==" { code = code + "    cmpq %r10, %rax\n    sete %al\n    movzbq %al, %rax\n";
        }
        else if op == "Ne" || op == "Neq" || op == "!=" { code = code + "    cmpq %r10, %rax\n    setne %al\n    movzbq %al, %rax\n";
        }
        return code;
    }
    if tag == "ECall" {
        let callee: String = x86_li_callee_name(x86_li_arg_at(args, 0));
        let cargs: String = x86_li_arg_at(args, 1);
        if callee == "list_new" { return "    call list_new\n";
        }
        if callee == "list_len" { return x86_li_lower_expr(x86_li_arg_at(cargs, 0), vars, pid) + "    movq %rax, %rdi\n    call list_len\n";
        }
        if callee == "list_push" {
            let mut code: String = x86_li_lower_expr(x86_li_arg_at(cargs, 0), vars, pid);
            code = code + "    pushq %rax\n" + x86_li_lower_expr(x86_li_arg_at(cargs, 1), vars, pid + 1);
            code = code + "    movq %rax, %rsi\n    popq %rdi\n    call list_push\n";
            return code;
        }
        if callee == "list_get" {
            let mut code: String = x86_li_lower_expr(x86_li_arg_at(cargs, 0), vars, pid);
            code = code + "    pushq %rax\n" + x86_li_lower_expr(x86_li_arg_at(cargs, 1), vars, pid + 1);
            code = code + "    movq %rax, %rsi\n    popq %rdi\n    call list_get\n";
            return code;
        }
        if callee == "list_set" {
            let mut code: String = x86_li_lower_expr(x86_li_arg_at(cargs, 0), vars, pid);
            code = code + "    pushq %rax\n" + x86_li_lower_expr(x86_li_arg_at(cargs, 1), vars, pid + 1);
            code = code + "    pushq %rax\n" + x86_li_lower_expr(x86_li_arg_at(cargs, 2), vars, pid + 2);
            code = code + "    movq %rax, %rdx\n    popq %rsi\n    popq %rdi\n    call list_set\n";
            return code;
        }
        if callee == "println" {
            let p_code: String = x86_li_lower_expr(x86_li_arg_at(cargs, 0), vars, pid);
            return p_code + x86_li_print_rax(pid.to_string());
        }
    }
    return "";
}
