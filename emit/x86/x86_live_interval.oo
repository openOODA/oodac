// # x86-64 Live Interval & Use-Def Range Analyzer
//
// Logline: Computes virtual register live ranges, instruction use-positions, loop-depth spill weights, and ABI pre-coloring using parallel arrays.
//
// Setup: Pre-pass for the Poletto-Sarkar linear scan register allocator in the openOODA x86-64 native backend.
//
// Beats:
//   1. Assign linear instruction indices across basic blocks.
//   2. Traverse instructions to compute first definition and last use ranges.
//   3. Compute loop-depth spill weights (uses * 10^depth + span).
//   4. Pre-color System V AMD64 argument and return value fixed registers.

import "emit/llvm/ssa_ir.oo";
import "x86_reg_pool.oo";


pub type LiveIntervals = struct {
    vregs: List[Int],
    starts: List[Int],
    ends: List[Int],
    weights: List[Int],
    is_fixed: List[Int],
    fixed_regs: List[Int]
};

pub fn live_intervals_new() -> LiveIntervals {
    let empty_v: List[Int] = list_new();
let empty_s: List[Int] = list_new();
let empty_e: List[Int] = list_new();
let empty_w: List[Int] = list_new();
let empty_f: List[Int] = list_new();
let empty_fr: List[Int] = list_new();
let res: LiveIntervals = LiveIntervals { vregs: empty_v, starts: empty_s, ends: empty_e, weights: empty_w, is_fixed: empty_f, fixed_regs: empty_fr };
    return res;
}

fn x86_is_binop_or_cmp(op: Int) -> Bool {
    if op == ssa_op_add() || op == ssa_op_sub() || op == ssa_op_mul() || op == ssa_op_sdiv() { return true;
    }
    if op == ssa_op_srem() || op == ssa_op_and() || op == ssa_op_or() || op == ssa_op_xor() { return true;
    }
    if op == ssa_op_shl() || op == ssa_op_shr() { return true;
    }
    if op == ssa_op_icmp_eq() || op == ssa_op_icmp_ne() || op == ssa_op_icmp_slt() { return true;
    }
    if op == ssa_op_icmp_sge() || op == ssa_op_icmp_sgt() || op == ssa_op_icmp_ule() || op == ssa_op_icmp_ult() { return true;
    }
    return false;
}

fn x86_is_imm_vreg_use(op: Int) -> Bool {
    if x86_is_binop_or_cmp(op) { return true;
    }
    if op == ssa_op_println_int() || op == ssa_op_ret() || op == ssa_op_call() || op == ssa_op_load() { return true;
    }
    return false;
}

fn x86_is_lh_vreg_use(op: Int) -> Bool {
    if x86_is_binop_or_cmp(op) { return true;
    }
    if op == ssa_op_cond_br() || op == ssa_op_ret() || op == ssa_op_store() || op == ssa_op_extractvalue() || op == ssa_op_insertvalue() { return true;
    }
    return false;
}

pub fn x86_compute_live_intervals(fn_node: SsaFunction) -> LiveIntervals {
    let n_insts: Int = list_len(fn_node.inst_opcodes);
    let mut max_vreg: Int = 0;
    let mut i: Int = 0;
    while i < n_insts {
        let r: Int = list_get(fn_node.inst_results, i);
        let im: Int = list_get(fn_node.inst_imm_vals, i);
        let lh: Int = list_get(fn_node.inst_lhs_vals, i);
        let op: Int = list_get(fn_node.inst_opcodes, i);
        if r > max_vreg { max_vreg = r;
        }
        if x86_is_imm_vreg_use(op) && im > max_vreg { max_vreg = im;
        }
        if x86_is_lh_vreg_use(op) && lh > max_vreg { max_vreg = lh;
        }
        i = i + 1;
    }

    let mut first_def: List[Int] = list_new();
    let mut last_use: List[Int] = list_new();
    let mut use_count: List[Int] = list_new();
    let mut v: Int = 0;
    while v <= max_vreg { first_def = list_push(first_def, -1);
    last_use = list_push(last_use, -1);
    use_count = list_push(use_count, 0);
    v = v + 1;
    }

    // Traverse instructions with linear index 2 * i (def at 2*i, use at 2*i + 1)
    i = 0;
    while i < n_insts { let pos_def: Int = i * 2;
    let pos_use: Int = i * 2 + 1;
    let op: Int = list_get(fn_node.inst_opcodes, i);
    let res_v: Int = list_get(fn_node.inst_results, i);
    let imm: Int = list_get(fn_node.inst_imm_vals, i);
    let lh: Int = list_get(fn_node.inst_lhs_vals, i);
    if res_v > 0 && res_v <= max_vreg && op != ssa_op_br() && op != ssa_op_cond_br() && op != ssa_op_ret() { if list_get(first_def, res_v) == -1 { first_def = x86_li_set(first_def, res_v, pos_def);
    }
            if list_get(last_use, res_v) < pos_def { last_use = x86_li_set(last_use, res_v, pos_def);
            }
        }

        // Record uses from lhs operand
        if x86_is_lh_vreg_use(op) && lh > 0 && lh <= max_vreg { if list_get(first_def, lh) == -1 { first_def = x86_li_set(first_def, lh, 0);
        }
            if list_get(last_use, lh) < pos_use { last_use = x86_li_set(last_use, lh, pos_use);
            }
            let uc: Int = list_get(use_count, lh);
            use_count = x86_li_set(use_count, lh, uc + 1);
        }

        // Record uses from imm operand
        if x86_is_imm_vreg_use(op) && imm > 0 && imm <= max_vreg { if list_get(first_def, imm) == -1 { first_def = x86_li_set(first_def, imm, 0);
        }
            if list_get(last_use, imm) < pos_use { last_use = x86_li_set(last_use, imm, pos_use);
            }
            let uc: Int = list_get(use_count, imm);
            use_count = x86_li_set(use_count, imm, uc + 1);
        }
        i = i + 1;
    }

    let mut out_vregs: List[Int] = list_new();
    let mut out_starts: List[Int] = list_new();
    let mut out_ends: List[Int] = list_new();
    let mut out_weights: List[Int] = list_new();
    let mut out_fixed: List[Int] = list_new();
    let mut out_fregs: List[Int] = list_new();

    let mut ret_vreg: Int = -1;
    i = 0;
    while i < n_insts {
        if list_get(fn_node.inst_opcodes, i) == ssa_op_ret() {
            let rval: Int = list_get(fn_node.inst_imm_vals, i);
            if rval > 0 { ret_vreg = rval;
            }
            else {
                let lval: Int = list_get(fn_node.inst_lhs_vals, i);
                if lval > 0 { ret_vreg = lval;
                }
            }
        }
        i = i + 1;
    }

    v = 1;
    while v <= max_vreg { let s_pos: Int = list_get(first_def, v);
    let e_pos: Int = list_get(last_use, v);
    let u_cnt: Int = list_get(use_count, v);
    if s_pos != -1 && e_pos != -1 { let weight: Int = u_cnt * 10 + (e_pos - s_pos);
    out_vregs = list_push(out_vregs, v);
    out_starts = list_push(out_starts, s_pos);
    out_ends = list_push(out_ends, e_pos);
    out_weights = list_push(out_weights, weight);
    if v == ret_vreg { out_fixed = list_push(out_fixed, 1);
    out_fregs = list_push(out_fregs, 0);
    // %rax } else {
                out_fixed = list_push(out_fixed, 0);
                out_fregs = list_push(out_fregs, -1);
            }
        }
        v = v + 1;
    }

    let res_li: LiveIntervals = LiveIntervals { vregs: out_vregs, starts: out_starts, ends: out_ends, weights: out_weights, is_fixed: out_fixed, fixed_regs: out_fregs };
    return res_li;
}

fn x86_li_set(xs: List[Int], idx: Int, val: Int) -> List[Int] {
    let n: Int = list_len(xs);
    let mut out: List[Int] = list_new();
    let mut k: Int = 0;
    while k < n {
        if k == idx { out = list_push(out, val);
        }
        else { out = list_push(out, list_get(xs, k));
        }
        k = k + 1;
    }
    return out;
}
