// # Pure In-Process x86-64 ELF64 Binary Packager
//
// Logline: Builds a 64-bit ET_EXEC ELF image with one RX PT_LOAD text segment and a bound _start entry.
//
// Setup: Pure byte transform. Caller supplies machine-code bytes. No GNU as or ld. No ambient I/O.
//
// Beats:
//   1. Encode little-endian ELF64 header fields and one 56-byte PT_LOAD.
//   2. Place supplied machine code in the loadable text segment after the headers.
//   3. Bind e_entry to _start at the text virtual address.
//   4. Fail closed on empty text.

import "types/byte_out.oo";

fn x86p_le_byte(v: Int, k: Int) -> Int {
    if k == 0 { return v & 255;
    }
    if k == 1 { return (v / 256) & 255;
    }
    if k == 2 { return (v / 65536) & 255;
    }
    if k == 3 { return (v / 16777216) & 255;
    }
    return 0;
}

fn x86p_ehdr_byte(i: Int, entry: Int) -> Int {
    if i == 0 { return 127;
    }
    if i == 1 { return 69;
    }
    if i == 2 { return 76;
    }
    if i == 3 { return 70;
    }
    if i == 4 { return 2;
    }
    if i == 5 { return 1;
    }
    if i == 6 { return 1;
    }
    if i == 16 { return 2;
    }
    if i == 18 { return 62;
    }
    if i == 20 { return 1;
    }
    if i == 24 { return x86p_le_byte(entry, 0);
    }
    if i == 25 { return x86p_le_byte(entry, 1);
    }
    if i == 26 { return x86p_le_byte(entry, 2);
    }
    if i == 27 { return x86p_le_byte(entry, 3);
    }
    if i == 32 { return 64;
    }
    if i == 52 { return 64;
    }
    if i == 54 { return 56;
    }
    if i == 56 { return 1;
    }
    return 0;
}

fn x86p_phdr_byte(i: Int, filesz: Int) -> Int {
    if i == 0 { return 1;
    }
    if i == 4 { return 5;
    }
    if i == 16 { return x86p_le_byte(4194304, 0);
    }
    if i == 17 { return x86p_le_byte(4194304, 1);
    }
    if i == 18 { return x86p_le_byte(4194304, 2);
    }
    if i == 19 { return x86p_le_byte(4194304, 3);
    }
    if i == 24 { return x86p_le_byte(4194304, 0);
    }
    if i == 25 { return x86p_le_byte(4194304, 1);
    }
    if i == 26 { return x86p_le_byte(4194304, 2);
    }
    if i == 27 { return x86p_le_byte(4194304, 3);
    }
    if i == 32 { return x86p_le_byte(filesz, 0);
    }
    if i == 33 { return x86p_le_byte(filesz, 1);
    }
    if i == 34 { return x86p_le_byte(filesz, 2);
    }
    if i == 35 { return x86p_le_byte(filesz, 3);
    }
    if i == 40 { return x86p_le_byte(filesz, 0);
    }
    if i == 41 { return x86p_le_byte(filesz, 1);
    }
    if i == 42 { return x86p_le_byte(filesz, 2);
    }
    if i == 43 { return x86p_le_byte(filesz, 3);
    }
    if i == 49 { return 16;
    }
    return 0;
}

fn x86p_ehdr(entry: Int) -> List[Int] {
    let mut h: List[Int] = list_new();
    let mut ehdr_i: Int = 0;
    while ehdr_i < 64 { h = list_push(h, x86p_ehdr_byte(ehdr_i, entry));
    ehdr_i = ehdr_i + 1;
    }
    return h;
}

fn x86p_phdr(filesz: Int) -> List[Int] {
    let mut p: List[Int] = list_new();
    let mut phdr_i: Int = 0;
    while phdr_i < 56 { p = list_push(p, x86p_phdr_byte(phdr_i, filesz));
    phdr_i = phdr_i + 1;
    }
    return p;
}

fn x86p_cat(a: List[Int], src: List[Int]) -> List[Int] {
    let n: Int = list_len(src);
    let mut o: List[Int] = a;
    let mut cat_i: Int = 0;
    while cat_i < n { o = list_push(o, list_get(src, cat_i) & 255);
    cat_i = cat_i + 1;
    }
    return o;
}

pub fn x86_elf_pure_text_off() -> Int {
    return 120;
}

pub fn x86_elf_pure_base_vaddr() -> Int {
    return 4194304;
}

pub fn x86_elf_pure_align() -> Int {
    return 4096;
}

pub fn x86_elf_pure_rx_flags() -> Int {
    return 5;
}

fn x86p_exit_byte(i: Int, st: Int) -> Int {
    if i == 0 { return 184;
    }
    if i == 1 { return 60;
    }
    if i == 5 { return 191;
    }
    if i == 6 { return st;
    }
    if i == 10 { return 15;
    }
    if i == 11 { return 5;
    }
    return 0;
}

pub fn x86_elf_pure_linux_exit(status: Int) -> List[Int] {
    let st: Int = status & 255;
    let mut b: List[Int] = list_new();
    let mut exit_i: Int = 0;
    while exit_i < 12 { b = list_push(b, x86p_exit_byte(exit_i, st));
    exit_i = exit_i + 1;
    }
    return b;
}

pub fn x86_elf_pure_package(code: List[Int]) -> ByteOut {
    let n: Int = list_len(code);
if n == 0 { return byte_out_err("x86_elf_pure: empty text");
}
    let off: Int = 120;
    let filesz: Int = off + n;
    let entry: Int = 4194304 + off;
    let mut img: List[Int] = x86p_ehdr(entry);
    img = x86p_cat(img, x86p_phdr(filesz));
    img = x86p_cat(img, code);
    return byte_out_ok(img);
}

pub fn x86_elf_pure_write(fs: &FsWriteCap, path: String, img: List[Int]) -> Result[Int, String] {
    if path == "" {
        return Err("x86_elf_pure: empty path");
    }
    if list_len(img) == 0 { return Err("x86_elf_pure: empty image");
    }
    let binary: String = bytes_to_str(img);
    let r: Result[Void, String] = write_file(fs, path, binary);
    match r { Ok(_) => { return Ok(list_len(img));
    }
        Err(e) => {
            return Err(e);
        }
    }
}
