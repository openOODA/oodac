// # Pure OpenOODA In-Process ELF64 Header & Section Synthesis
//
// Logline: Generates 64-bit ELF headers, PT_LOAD program headers, section headers, symbol tables, and string tables entirely in-process.
//
// Setup: Pure bytecode and structural ELF64 emitter for the openOODA sovereign x86-64 backend with zero external dependencies.
//
// Beats:
//   1. Encode little-endian byte streams for u8, u16, u32, and u64 primitive fields.
//   2. Synthesize 64-byte Elf64_Ehdr header with ET_EXEC and EM_X86_64 target configuration.
//   3. Synthesize 56-byte Elf64_Phdr program headers for RX text and RW data segments.
//   4. Synthesize 64-byte Elf64_Shdr section headers and 24-byte Elf64_Sym symbol entries.



pub type StringPool = struct {
    bytes: List[Int],
    names: List[String],
    offsets: List[Int],
    count: Int
};

pub fn string_pool_new() -> StringPool {
    let mut b: List[Int] = list_new();
    b = list_push(b, 0);
    let mut names: List[String] = list_new();
    names = list_push(names, "");
    let mut offsets: List[Int] = list_new();
    offsets = list_push(offsets, 0);
    let res: StringPool = StringPool { bytes: b, names: names, offsets: offsets, count: 1 };
    return res;
}

pub fn string_pool_add(pool: StringPool, str: String) -> StringPool {
    let mut i: Int = 0;
while i < pool.count { if list_get(pool.names, i) == str { return pool;
}
        i = i + 1;
    }
    let off: Int = list_len(pool.bytes);
    let slen: Int = chars_len(str);
    let mut b: List[Int] = pool.bytes;
    let mut j: Int = 0;
    while j < slen { b = list_push(b, byte_at(str, j));
    j = j + 1;
    }
    b = list_push(b, 0);
    let mut names: List[String] = list_push(pool.names, str);
    let mut offsets: List[Int] = list_push(pool.offsets, off);
    let res: StringPool = StringPool { bytes: b, names: names, offsets: offsets, count: pool.count + 1 };
    return res;
}

pub fn string_pool_offset(pool: StringPool, str: String) -> Int {
    let mut i: Int = 0;
while i < pool.count { if list_get(pool.names, i) == str { return list_get(pool.offsets, i);
}
        i = i + 1;
    }
    return 0;
}

pub fn string_pool_get_bytes(pool: StringPool) -> List[Int] {
    return pool.bytes;
}

pub fn elf_append_u8(bytes: List[Int], val: Int) -> List[Int] {
    return list_push(bytes, val & 255);
}

pub fn elf_append_le16(bytes: List[Int], val: Int) -> List[Int] {
    let mut b: List[Int] = list_push(bytes, val & 255);
    return list_push(b, (val / 256) & 255);
}

pub fn elf_append_le32(bytes: List[Int], val: Int) -> List[Int] {
    let mut b: List[Int] = list_push(bytes, val & 255);
    b = list_push(b, (val / 256) & 255);
    b = list_push(b, (val / 65536) & 255);
    return list_push(b, (val / 16777216) & 255);
}

pub fn elf_append_le64(bytes: List[Int], val: Int) -> List[Int] {
    let mut b: List[Int] = elf_append_le32(bytes, val);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, 0);
    return list_push(b, 0);
}

pub fn elf_append_bytes(dest: List[Int], src: List[Int]) -> List[Int] {
    let n: Int = list_len(src);
    let mut mut_dest: List[Int] = dest;
    let mut i: Int = 0;
    while i < n { mut_dest = list_push(mut_dest, list_get(src, i));
    i = i + 1;
    }
    return mut_dest;
}

pub fn elf_append_str_z(dest: List[Int], s: String) -> List[Int] {
    let n: Int = chars_len(s);
    let mut d: List[Int] = dest;
    let mut i: Int = 0;
    while i < n { d = list_push(d, byte_at(s, i));
    i = i + 1;
    }
    return list_push(d, 0);
}

pub fn elf_build_default_shstrtab() -> List[Int] {
    let mut b: List[Int] = list_new();
    b = list_push(b, 0);
    b = elf_append_str_z(b, ".text");
    b = elf_append_str_z(b, ".rodata");
    b = elf_append_str_z(b, ".debug_line");
    b = elf_append_str_z(b, ".debug_info");
    b = elf_append_str_z(b, ".debug_abbrev");
    b = elf_append_str_z(b, ".debug_str");
    b = elf_append_str_z(b, ".symtab");
    b = elf_append_str_z(b, ".strtab");
    b = elf_append_str_z(b, ".shstrtab");
    return b;
}

pub fn elf_build_ehdr64(entry_vaddr: Int, ph_off: Int, sh_off: Int, ph_num: Int, sh_num: Int, sh_str_idx: Int) -> List[Int] {
    let mut h: List[Int] = list_new();
    h = list_push(h, 127);
    h = list_push(h, 69);
    h = list_push(h, 76);
    h = list_push(h, 70);
    h = list_push(h, 2);
    h = list_push(h, 1);
    h = list_push(h, 1);
    h = list_push(h, 0);
    let mut p: Int = 0;
    while p < 8 { h = list_push(h, 0);
    p = p + 1;
    }
    h = elf_append_le16(h, 2);
    h = elf_append_le16(h, 62);
    h = elf_append_le32(h, 1);
    h = elf_append_le64(h, entry_vaddr);
    h = elf_append_le64(h, ph_off);
    h = elf_append_le64(h, sh_off);
    h = elf_append_le32(h, 0);
    h = elf_append_le16(h, 64);
    h = elf_append_le16(h, 56);
    h = elf_append_le16(h, ph_num);
    h = elf_append_le16(h, 64);
    h = elf_append_le16(h, sh_num);
    h = elf_append_le16(h, sh_str_idx);
    return h;
}

pub fn elf_build_phdr64(p_type: Int, p_flags: Int, p_offset: Int, p_vaddr: Int, p_filesz: Int, p_memsz: Int, p_align: Int) -> List[Int] {
    let mut ph: List[Int] = list_new();
    ph = elf_append_le32(ph, p_type);
    ph = elf_append_le32(ph, p_flags);
    ph = elf_append_le64(ph, p_offset);
    ph = elf_append_le64(ph, p_vaddr);
    ph = elf_append_le64(ph, p_vaddr);
    ph = elf_append_le64(ph, p_filesz);
    ph = elf_append_le64(ph, p_memsz);
    ph = elf_append_le64(ph, p_align);
    return ph;
}

pub fn elf_build_shdr64(name_idx: Int, sh_type: Int, flags: Int, addr: Int, offset: Int, size: Int, link: Int, info: Int, align: Int, entsize: Int) -> List[Int] {
    let mut sh: List[Int] = list_new();
    sh = elf_append_le32(sh, name_idx);
    sh = elf_append_le32(sh, sh_type);
    sh = elf_append_le64(sh, flags);
    sh = elf_append_le64(sh, addr);
    sh = elf_append_le64(sh, offset);
    sh = elf_append_le64(sh, size);
    sh = elf_append_le32(sh, link);
    sh = elf_append_le32(sh, info);
    sh = elf_append_le64(sh, align);
    sh = elf_append_le64(sh, entsize);
    return sh;
}

pub fn elf_emit_sym64(st_name: Int, st_info: Int, st_other: Int, st_shndx: Int, st_value: Int, st_size: Int) -> List[Int] {
    let mut b: List[Int] = list_new();
    b = elf_append_le32(b, st_name);
    b = elf_append_u8(b, st_info);
    b = elf_append_u8(b, st_other);
    b = elf_append_le16(b, st_shndx);
    b = elf_append_le64(b, st_value);
    b = elf_append_le64(b, st_size);
    return b;
}

pub fn elf64_build_executable_image(text_bytes: List[Int], rodata_bytes: List[Int], data_bytes: List[Int], entry_offset: Int) -> List[Int] {
    let header_size: Int = 64 + 56;
    let text_len: Int = list_len(text_bytes);
    let rodata_len: Int = list_len(rodata_bytes);
    let data_len: Int = list_len(data_bytes);
    let total_file_size: Int = header_size + text_len + rodata_len + data_len;
    let base_vaddr: Int = 4194304;
    let entry_vaddr: Int = base_vaddr + header_size + entry_offset;

    let ehdr: List[Int] = elf_build_ehdr64(entry_vaddr, 64, 0, 1, 0, 0);
    let phdr: List[Int] = elf_build_phdr64(1, 7, 0, base_vaddr, total_file_size, total_file_size, 4096);

    let mut img: List[Int] = list_new();
    img = elf_append_bytes(img, ehdr);
    img = elf_append_bytes(img, phdr);
    img = elf_append_bytes(img, text_bytes);
    img = elf_append_bytes(img, rodata_bytes);
    img = elf_append_bytes(img, data_bytes);
    return img;
}
