// ──▓▓ Public x86-64 Emitter API ──▓▓──

pub fn emit_x86_stream(src: String) -> String {
    return x86_emit_stream_b(src);
}

pub fn x86_emit_stream(src: String) -> String {
    return x86_emit_stream_b(src);
}

pub fn emit_x86_ssa(fn_data: SsaFunction) -> X86CompileResult {
    return x86_ssa_compile_ssa(fn_data);
}

pub fn emit_x86_elf_bytes(src: String) -> ByteOut {
    return x86_elf_pure_from_source(src);
}
