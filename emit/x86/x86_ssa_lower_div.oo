// # x86-64 SSA Division & Modulo Strength Reduction Lowerer
//
// Logline: Lowers signed/unsigned division and remainder instructions into reciprocal multiplication and shifts.
//
// Setup: Connects x86_magic_div.oo to SSA register allocation and machine code emission.
//
// Beats:
//   1. Lower division by power-of-2 constants with branch-free bias arithmetic.
//   2. Lower division by arbitrary constants with Granlund-Montgomery magic reciprocal multiplication.
//   3. Lower modulo by constants via quotient multiply-and-subtract reduction.
//   4. Fall back to hardware idivq/divq for runtime variable divisors.

import "emit/llvm/ssa_ir.oo";
import "x86_magic_div.oo";


pub fn x86_lower_div_const(op: Int, s_lh: String, divisor: Int, s_r: String) -> List[String] {
    let mut lines: List[String] = list_new();
    if divisor == 0 { lines = list_push(lines, "    movq " + s_lh + ", %rax\n    cqto\n    xorq %r10, %r10\n    idivq %r10\n");
    return lines;
    }
    if divisor == 1 { lines = list_push(lines, "    movq " + s_lh + ", " + s_r + "\n");
    return lines;
    }
    if divisor == -1 { lines = list_push(lines, "    movq " + s_lh + ", %rax\n    negq %rax\n    movq %rax, " + s_r + "\n");
    return lines;
    }

    let ad: Int = 0 + x86_abs_s64(divisor);
    if x86_is_power_of_two(ad) {
        let k: Int = 0 + x86_power_of_two_shift(ad);
        lines = list_push(lines, "    movq " + s_lh + ", %rax\n");
        if k == 1 { lines = list_push(lines, "    movq %rax, %r10\n    shrq $63, %r10\n    addq %r10, %rax\n    sarq $1, %rax\n");
        } else {
            let shift_diff: Int = 64 - k;
            lines = list_push(lines, "    movq %rax, %r10\n    sarq $63, %r10\n    shrq $" + shift_diff.to_string() + ", %r10\n    addq %r10, %rax\n    sarq $" + k.to_string() + ", %rax\n");
        }
        if divisor < 0 { lines = list_push(lines, "    negq %rax\n");
        }
        lines = list_push(lines, "    movq %rax, " + s_r + "\n");
        return lines;
    }

    let magic_info: X86MagicDiv = x86_compute_magic_s64(ad);
    let mag_val: Int = magic_info.magic;
    let post_s: Int = magic_info.shift;
    let add_ind: Int = magic_info.add_indicator;

    lines = list_push(lines, "    movabsq $" + mag_val.to_string() + ", %rdx\n");
    lines = list_push(lines, "    movq " + s_lh + ", %rax\n");
    lines = list_push(lines, "    imulq %rdx\n");

    if add_ind == 1 { lines = list_push(lines, "    addq " + s_lh + ", %rdx\n");
    }
    if post_s > 0 { lines = list_push(lines, "    sarq $" + post_s.to_string() + ", %rdx\n");
    }
    lines = list_push(lines, "    movq " + s_lh + ", %rax\n    shrq $63, %rax\n    addq %rax, %rdx\n");
    if divisor < 0 { lines = list_push(lines, "    negq %rdx\n");
    }
    lines = list_push(lines, "    movq %rdx, " + s_r + "\n");
    return lines;
}

pub fn x86_lower_mod_const(op: Int, s_lh: String, divisor: Int, s_r: String) -> List[String] {
    let mut lines: List[String] = list_new();
    if divisor == 0 || divisor == 1 || divisor == -1 { lines = list_push(lines, "    movq $0, " + s_r + "\n");
    return lines;
    }

    let div_lines: List[String] = x86_lower_div_const(ssa_op_sdiv(), s_lh, divisor, "%rdx");
    let mut i: Int = 0;
    while i < list_len(div_lines) {
        lines = list_push(lines, list_get(div_lines, i));
        i = i + 1;
    }

    let ad: Int = 0 + x86_abs_s64(divisor);
    if x86_can_fold_lea_multiplier(divisor) {
        let lea_lines: List[String] = x86_emit_lea_multiplier("%r10", "%rdx", divisor);
        let mut li: Int = 0;
        while li < list_len(lea_lines) {
            lines = list_push(lines, list_get(lea_lines, li));
            li = li + 1;
        }
        if divisor < 0 { lines = list_push(lines, "    negq %r10\n");
        }
    } else if divisor >= -2147483648 && divisor <= 2147483647 { lines = list_push(lines, "    imulq $" + divisor.to_string() + ", %rdx, %r10\n");
    } else {
        lines = list_push(lines, "    movabsq $" + divisor.to_string() + ", %r10\n    imulq %rdx, %r10\n");
    }
    lines = list_push(lines, "    movq " + s_lh + ", %r11\n    subq %r10, %r11\n    movq %r11, " + s_r + "\n");
    return lines;
}

pub fn x86_lower_div_var(op: Int, s_lh: String, s_imm: String, s_r: String) -> List[String] {
    let mut lines: List[String] = list_new();
    lines = list_push(lines, "    movq " + s_lh + ", %rax\n    cqto\n    idivq " + s_imm + "\n");
    if op == ssa_op_sdiv() {
        lines = list_push(lines, "    movq %rax, " + s_r + "\n");
    } else {
        lines = list_push(lines, "    movq %rdx, " + s_r + "\n");
    }
    return lines;
}
