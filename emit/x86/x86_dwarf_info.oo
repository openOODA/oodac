// # Pure openOODA DWARF 5 DIE Tree & Symbol Metadata Emitter
//
// Logline: Emits DWARF 5 .debug_abbrev tables, compilation unit headers, and subprogram DIE trees directly in-process.
//
// Setup: Pure bytecode serialization module with zero external assembler or linker dependencies.
//
// Beats:
//   1. Encode DWARF 5 .debug_abbrev abbreviation tables for compile units and subprograms.
//   2. Encode DWARF 5 12-byte .debug_info compilation unit header.
//   3. Serialize compilation unit DIE with producer, language, name, stmt_list, low_pc, and high_pc.
//   4. Serialize subprogram DIEs for entry points and functions with DW_FORM_flag_present external tags.
//   5. Assemble complete in-process .debug_info bytecode units with child termination.

import "x86_leb128.oo";

import "x86_elf_sections.oo";


pub fn x86_dwarf_append_str(dest: List[Int], s: String) -> List[Int] {
    let n: Int = chars_len(s);
    let mut d: List[Int] = dest;
    let mut i: Int = 0;
    while i < n { d = list_push(d, byte_at(s, i));
    i = i + 1;
    }
    return list_push(d, 0);
}

pub fn x86_dwarf5_emit_abbrev_table() -> List[Int] {
    let mut b: List[Int] = list_new();

    // Abbrev 1: DW_TAG_compile_unit (17), DW_CHILDREN_yes (1)
    b = elf_append_bytes(b, x86_encode_u32_leb128(1));
    b = elf_append_bytes(b, x86_encode_u32_leb128(17));
    b = list_push(b, 1);
    // DW_AT_producer (37) -> DW_FORM_string (8)
    b = elf_append_bytes(b, x86_encode_u32_leb128(37));
    b = elf_append_bytes(b, x86_encode_u32_leb128(8));
    // DW_AT_language (19) -> DW_FORM_data2 (5)
    b = elf_append_bytes(b, x86_encode_u32_leb128(19));
    b = elf_append_bytes(b, x86_encode_u32_leb128(5));
    // DW_AT_name (3) -> DW_FORM_string (8)
    b = elf_append_bytes(b, x86_encode_u32_leb128(3));
    b = elf_append_bytes(b, x86_encode_u32_leb128(8));
    // DW_AT_stmt_list (16) -> DW_FORM_sec_offset (23)
    b = elf_append_bytes(b, x86_encode_u32_leb128(16));
    b = elf_append_bytes(b, x86_encode_u32_leb128(23));
    // DW_AT_low_pc (17) -> DW_FORM_addr (1)
    b = elf_append_bytes(b, x86_encode_u32_leb128(17));
    b = elf_append_bytes(b, x86_encode_u32_leb128(1));
    // DW_AT_high_pc (18) -> DW_FORM_data8 (7)
    b = elf_append_bytes(b, x86_encode_u32_leb128(18));
    b = elf_append_bytes(b, x86_encode_u32_leb128(7));
    // End of Abbrev 1 attributes
    b = list_push(b, 0);
    b = list_push(b, 0);

    // Abbrev 2: DW_TAG_subprogram (46), DW_CHILDREN_no (0)
    b = elf_append_bytes(b, x86_encode_u32_leb128(2));
    b = elf_append_bytes(b, x86_encode_u32_leb128(46));
    b = list_push(b, 0);
    // DW_AT_name (3) -> DW_FORM_string (8)
    b = elf_append_bytes(b, x86_encode_u32_leb128(3));
    b = elf_append_bytes(b, x86_encode_u32_leb128(8));
    // DW_AT_low_pc (17) -> DW_FORM_addr (1)
    b = elf_append_bytes(b, x86_encode_u32_leb128(17));
    b = elf_append_bytes(b, x86_encode_u32_leb128(1));
    // DW_AT_high_pc (18) -> DW_FORM_data8 (7)
    b = elf_append_bytes(b, x86_encode_u32_leb128(18));
    b = elf_append_bytes(b, x86_encode_u32_leb128(7));
    // DW_AT_external (63) -> DW_FORM_flag_present (25)
    b = elf_append_bytes(b, x86_encode_u32_leb128(63));
    b = elf_append_bytes(b, x86_encode_u32_leb128(25));
    // End of Abbrev 2 attributes
    b = list_push(b, 0);
    b = list_push(b, 0);

    // Table terminator
    b = list_push(b, 0);
    return b;
}

pub fn x86_dwarf5_emit_cu_header(unit_length: Int, abbrev_offset: Int) -> List[Int] {
    let mut hdr: List[Int] = list_new();
    hdr = elf_append_le32(hdr, unit_length);
    hdr = elf_append_le16(hdr, 5);
    hdr = list_push(hdr, 1);
    hdr = list_push(hdr, 8);
    hdr = elf_append_le32(hdr, abbrev_offset);
    return hdr;
}

pub fn x86_dwarf5_emit_subprogram_die(fn_name: String, fn_vaddr: Int, fn_size: Int) -> List[Int] {
    let mut die: List[Int] = list_new();
    die = elf_append_bytes(die, x86_encode_u32_leb128(2));
    die = x86_dwarf_append_str(die, fn_name);
    die = elf_append_le64(die, fn_vaddr);
    die = elf_append_le64(die, fn_size);
    return die;
}

pub fn x86_dwarf5_emit_info_unit_full(
    cu_name: String,
    producer: String,
    text_vaddr: Int,
    text_size: Int,
    fn_names: List[String],
    fn_vaddrs: List[Int],
    fn_sizes: List[Int]
) -> List[Int] {
    let mut cu_body: List[Int] = list_new();

    // 1. Compilation Unit DIE (Abbrev 1)
    cu_body = elf_append_bytes(cu_body, x86_encode_u32_leb128(1));
    cu_body = x86_dwarf_append_str(cu_body, producer);
    cu_body = elf_append_le16(cu_body, 12);
    cu_body = x86_dwarf_append_str(cu_body, cu_name);
    cu_body = elf_append_le32(cu_body, 0);
    cu_body = elf_append_le64(cu_body, text_vaddr);
    cu_body = elf_append_le64(cu_body, text_size);

    // 2. Subprogram DIEs (Children)
    let n_fns: Int = list_len(fn_names);
    let mut i: Int = 0;
    while i < n_fns { let fn_name: String = list_get(fn_names, i);
    let fn_vaddr: Int = list_get(fn_vaddrs, i);
    let fn_size: Int = list_get(fn_sizes, i);
    let sub_die: List[Int] = x86_dwarf5_emit_subprogram_die(fn_name, fn_vaddr, fn_size);
    cu_body = elf_append_bytes(cu_body, sub_die);
    i = i + 1;
    }

    // 3. End of CU Children (null DIE byte)
    cu_body = list_push(cu_body, 0);

    // 4. Calculate unit length and assemble full unit
    let hdr_rem_size: Int = 8;
    let unit_len: Int = hdr_rem_size + list_len(cu_body);

    let mut unit: List[Int] = list_new();
    let hdr: List[Int] = x86_dwarf5_emit_cu_header(unit_len, 0);
    unit = elf_append_bytes(unit, hdr);
    unit = elf_append_bytes(unit, cu_body);
    return unit;
}

pub fn x86_dwarf5_emit_info_unit(
    cu_name: String,
    fn_names: List[String],
    fn_vaddrs: List[Int],
    fn_sizes: List[Int]
) -> List[Int] {
    let producer: String = "openOODA sovereign x86-64 compiler 0.220.0";
    let n_fns: Int = list_len(fn_names);
    let mut min_vaddr: Int = 0;
    let mut total_size: Int = 0;
    if n_fns > 0 {
        min_vaddr = list_get(fn_vaddrs, 0);
        let mut i: Int = 0;
        while i < n_fns {
            let v: Int = list_get(fn_vaddrs, i);
            let s: Int = list_get(fn_sizes, i);
            if v < min_vaddr { min_vaddr = v;
            }
            total_size = total_size + s;
            i = i + 1;
        }
    }
    return x86_dwarf5_emit_info_unit_full(cu_name, producer, min_vaddr, total_size, fn_names, fn_vaddrs, fn_sizes);
}
