// # x86-64 SSA Register-Allocated Machine Instruction Lowerer
//
// Logline: Lowers SSA IR with assigned hardware registers into low-drag x86-64 machine assembly, managing frame alignment and callee-saved preservation.
//
// Setup: Code emission pass following linear scan register allocation for the openOODA sovereign x86-64 backend.
//
// Beats:
//   1. Lower ALU, bitwise, comparison, and constant instructions to hardware registers with zero memory drag.
//   2. Handle conditional branches and jumps with dual-target branch synthesis.
//   3. Emit function prologue preserving used callee-saved registers with non-colliding spill offsets.
//   4. Emit function epilogue with return value coalescing to %rax and callee-saved restoration.

import "emit/llvm/ssa_ir.oo";
import "x86_reg_pool.oo";

import "x86_live_interval.oo";

import "x86_regalloc_scan.oo";

import "x86_abi_classify.oo";

import "x86_abi_sret.oo";

import "x86_ssa_lower_ops.oo";

import "x86_ssa_lower_simd.oo";

import "x86_ymm_reg_pool.oo";

import "x86_ssa_lower_fn.oo";


pub fn x86_println_int_routine() -> String {
    let mut s: String = "\n.globl _println_int\n.p2align 4\n_println_int:\n"; s = s + "    push %rbp\n    mov %rsp, %rbp\n    sub $64, %rsp\n"; s = s + "    movq %rdi, %rax\n    mov $0, %r8\n    testq %rax, %rax\n    jns .Lp_nonneg\n"; s = s + "    mov $1, %r8\n    negq %rax\n.Lp_nonneg:\n"; s = s + "    lea -1(%rbp), %rdi\n    movb $10, (%rdi)\n"; s = s + "    mov $10, %r10\n.Lp_int_loop:\n"; s = s + "    xor %rdx, %rdx\n    divq %r10\n    decq %rdi\n    addb $48, %dl\n    movb %dl, (%rdi)\n"; s = s + "    testq %rax, %rax\n    jnz .Lp_int_loop\n"; s = s + "    testq %r8, %r8\n    jz .Lp_write\n    decq %rdi\n    movb $45, (%rdi)\n"; s = s + ".Lp_write:\n    mov %rbp, %rdx\n    sub %rdi, %rdx\n    mov %rdi, %rsi\n    mov $1, %rax\n    mov $1, %rdi\n    syscall\n"; s = s + "    mov %rbp, %rsp\n    pop %rbp\n    ret\n"; return s;
}

pub fn x86_emit_allocated_instructions(fn_node: SsaFunction, alloc_res: LinearScanResult) -> List[String] {
    let mut lines: List[String] = list_new();
    let n_callee: Int = list_len(alloc_res.used_callee_saved);
    let n: Int = list_len(fn_node.inst_opcodes);
    let mut i: Int = 0;
    while i < n {
        let op: Int = list_get(fn_node.inst_opcodes, i);
        let r: Int = list_get(fn_node.inst_results, i);
        let imm: Int = list_get(fn_node.inst_imm_vals, i);
        let lh: Int = list_get(fn_node.inst_lhs_vals, i);
        let s_r: String = x86_lr_operand(r, alloc_res, n_callee);
        let s_lh: String = x86_lr_operand(lh, alloc_res, n_callee);
        let s_imm: String = x86_lr_operand(imm, alloc_res, n_callee);
        let r_is_mem: Bool = x86_is_vreg_spilled(alloc_res, r);

        if op == ssa_op_add() || op == ssa_op_sub() || op == ssa_op_mul() || op == ssa_op_and() || op == ssa_op_or() || op == ssa_op_xor() {
            let alu_l: List[String] = x86_lower_alu_op(op, s_lh, s_imm, s_r, imm, r_is_mem);
            let mut j: Int = 0; while j < list_len(alu_l) { lines = list_push(lines, list_get(alu_l, j)); j = j + 1; }
        } else if op == ssa_op_shl() || op == ssa_op_shr() {
            let sh_l: List[String] = x86_lower_shift_op(op, s_lh, s_imm, s_r);
            let mut j: Int = 0; while j < list_len(sh_l) { lines = list_push(lines, list_get(sh_l, j)); j = j + 1; }
        } else if op == ssa_op_const() || op == ssa_op_const_forced() {
            let c_l: List[String] = x86_lower_const_op(imm, s_r, r_is_mem);
            let mut j: Int = 0; while j < list_len(c_l) { lines = list_push(lines, list_get(c_l, j)); j = j + 1; }
        } else if op == ssa_op_icmp_eq() || op == ssa_op_icmp_slt() || op == ssa_op_icmp_sgt() || op == ssa_op_icmp_sge() || op == ssa_op_icmp_ule() || op == ssa_op_icmp_ult() || op == ssa_op_icmp_ne() {
            let ic_l: List[String] = x86_lower_icmp_op(op, s_lh, s_imm, s_r, x86_is_vreg_spilled(alloc_res, lh), x86_is_vreg_spilled(alloc_res, imm), r_is_mem);
            let mut j: Int = 0; while j < list_len(ic_l) { lines = list_push(lines, list_get(ic_l, j)); j = j + 1; }
        } else if op >= ssa_op_fadd() && op <= ssa_op_frem() {
            let falu_l: List[String] = x86_lower_falu_op(op, s_lh, s_imm, s_r);
            let mut j: Int = 0; while j < list_len(falu_l) { lines = list_push(lines, list_get(falu_l, j)); j = j + 1; }
        } else if op >= ssa_op_fcmp_oeq() && op <= ssa_op_fcmp_une() {
            let fcmp_l: List[String] = x86_lower_fcmp_op(op, s_lh, s_imm, s_r);
            let mut j: Int = 0; while j < list_len(fcmp_l) { lines = list_push(lines, list_get(fcmp_l, j)); j = j + 1; }
        } else if op == ssa_op_sitofp() {
            let sfp_l: List[String] = x86_lower_sitofp_op(s_lh, s_r);
            let mut j: Int = 0; while j < list_len(sfp_l) { lines = list_push(lines, list_get(sfp_l, j)); j = j + 1; }
        } else if op == ssa_op_fptosi() {
            let fps_l: List[String] = x86_lower_fptosi_op(s_lh, s_r);
            let mut j: Int = 0; while j < list_len(fps_l) { lines = list_push(lines, list_get(fps_l, j)); j = j + 1; }
        } else if op == ssa_op_println_int() {
            lines = list_push(lines, "    movq " + s_imm + ", %rdi\n    call _println_int\n");
        } else if x86_is_simd_op(op) {
            let simd_l: List[String] = x86_lower_simd_inst(op, s_r, s_lh, s_imm);
            let mut j: Int = 0; while j < list_len(simd_l) { lines = list_push(lines, list_get(simd_l, j)); j = j + 1; }
        }
        i = i + 1;
    }
    return lines;
}

pub fn x86_lower_function_with_regalloc(fn_node: SsaFunction, is_entry: Int) -> String {
    let fn_label: String = fn_node.name;
    let alloc_res: LinearScanResult = x86_linear_scan_allocate(fn_node, x86_all_reg_ids());
    let callee_list: List[Int] = alloc_res.used_callee_saved;
    let n_callee: Int = list_len(callee_list);

    let mut out: String = "    .text\n    .globl " + fn_label + "\n";
    if is_entry == 1 { out = out + "    .globl _start\n    .p2align 4\n" + fn_label + ":\n_start:\n"; }
    else { out = out + "    .p2align 4\n" + fn_label + ":\n"; }
    out = out + "    push %rbp\n    mov %rsp, %rbp\n";

    let mut c_idx: Int = 0;
    while c_idx < n_callee { let cr: Int = list_get(callee_list, c_idx); out = out + "    pushq " + x86_reg_name(cr) + "\n"; c_idx = c_idx + 1; }

    let frame_size: Int = (alloc_res.spill_count * 8 + 15) & -16;
    if frame_size > 0 { out = out + "    subq $" + frame_size.to_string() + ", %rsp\n"; }

    let param_lines: List[String] = x86_emit_param_bindings(fn_node, alloc_res, n_callee);
    let mut pli: Int = 0;
    while pli < list_len(param_lines) {
        out = out + list_get(param_lines, pli);
        pli = pli + 1;
    }

    let n_blocks: Int = fn_node.block_count;
    let n_insts: Int = list_len(fn_node.inst_opcodes);
    let bnames: List[String] = fn_node.block_names;
    if n_blocks > list_len(bnames) {
        println("ERR\tx86_ssa\tblock_names short");
        process_exit(1);
    }
    if list_len(fn_node.inst_block_ids) < n_insts || list_len(fn_node.inst_results) < n_insts || list_len(fn_node.inst_imm_vals) < n_insts || list_len(fn_node.inst_lhs_vals) < n_insts { println("ERR\tx86_ssa\tinst arrays short"); process_exit(1); }
    let mut b: Int = 0;
    while b < n_blocks {
        let bname: String = list_get(bnames, b);
        out = out + ".L" + fn_label + "_" + bname + ":\n";
        let mut i: Int = 0;
        while i < n_insts {
            if list_get(fn_node.inst_block_ids, i) == b {
                let op: Int = list_get(fn_node.inst_opcodes, i);
                let r: Int = list_get(fn_node.inst_results, i);
                let imm: Int = list_get(fn_node.inst_imm_vals, i);
                let lh: Int = list_get(fn_node.inst_lhs_vals, i);
                let s_r: String = x86_lr_operand(r, alloc_res, n_callee);
                let s_lh: String = x86_lr_operand(lh, alloc_res, n_callee);
                let s_imm: String = x86_lr_operand(imm, alloc_res, n_callee);
                let r_is_mem: Bool = x86_is_vreg_spilled(alloc_res, r);

                if op == ssa_op_add() || op == ssa_op_sub() || op == ssa_op_mul() || op == ssa_op_and() || op == ssa_op_or() || op == ssa_op_xor() {
                    let sub_l: List[String] = x86_lower_alu_op(op, s_lh, s_imm, s_r, imm, r_is_mem);
                    let mut j: Int = 0; while j < list_len(sub_l) { out = out + list_get(sub_l, j); j = j + 1; }
                } else if op == ssa_op_shl() || op == ssa_op_shr() {
                    let sub_l: List[String] = x86_lower_shift_op(op, s_lh, s_imm, s_r);
                    let mut j: Int = 0; while j < list_len(sub_l) { out = out + list_get(sub_l, j); j = j + 1; }
                } else if op == ssa_op_sdiv() || op == ssa_op_srem() {
                    let sub_l: List[String] = x86_lower_div_op(op, s_lh, s_imm, s_r);
                    let mut j: Int = 0; while j < list_len(sub_l) { out = out + list_get(sub_l, j); j = j + 1; }
                } else if op == ssa_op_const() || op == ssa_op_const_forced() {
                    let sub_l: List[String] = x86_lower_const_op(imm, s_r, r_is_mem);
                    let mut j: Int = 0; while j < list_len(sub_l) { out = out + list_get(sub_l, j); j = j + 1; }
                } else if op == ssa_op_icmp_eq() || op == ssa_op_icmp_slt() || op == ssa_op_icmp_sgt() || op == ssa_op_icmp_sge() || op == ssa_op_icmp_ule() || op == ssa_op_icmp_ult() || op == ssa_op_icmp_ne() {
                    let sub_l: List[String] = x86_lower_icmp_op(op, s_lh, s_imm, s_r, x86_is_vreg_spilled(alloc_res, lh), x86_is_vreg_spilled(alloc_res, imm), r_is_mem);
                    let mut j: Int = 0; while j < list_len(sub_l) { out = out + list_get(sub_l, j); j = j + 1; }
                } else if op == ssa_op_br() {
                    if imm >= 0 && imm < n_blocks { let tbname: String = list_get(bnames, imm); out = out + "    jmp .L" + fn_label + "_" + tbname + "\n"; }
                } else if op == ssa_op_cond_br() {
                    let tbname: String = if r >= 0 && r < n_blocks { list_get(bnames, r) } else { "" };
                    let fbname: String = if imm >= 0 && imm < n_blocks { list_get(bnames, imm) } else { "" };
                    if x86_is_vreg_spilled(alloc_res, lh) {
                        out = out + "    movq " + s_lh + ", %r10\n    testq %r10, %r10\n    jnz .L" + fn_label + "_" + tbname + "\n    jmp .L" + fn_label + "_" + fbname + "\n";
                    } else {
                        out = out + "    testq " + s_lh + ", " + s_lh + "\n    jnz .L" + fn_label + "_" + tbname + "\n    jmp .L" + fn_label + "_" + fbname + "\n";
                    }
                } else if op == ssa_op_call() {
                    let sub_l: List[String] = x86_lower_call_op(lh, s_imm, s_r);
                    let mut j: Int = 0; while j < list_len(sub_l) { out = out + list_get(sub_l, j); j = j + 1; }
                } else if op == ssa_op_load() || op == ssa_op_store() || op == ssa_op_store_lit() || op == ssa_op_extractvalue() || op == ssa_op_insertvalue() {
                    let sub_l: List[String] = x86_lower_mem_op(op, s_r, s_lh, s_imm, imm);
                    let mut j: Int = 0; while j < list_len(sub_l) { out = out + list_get(sub_l, j); j = j + 1; }
                } else if op == ssa_op_ret() {
                    let mut s_ret: String = "";
                    if imm > 0 { s_ret = x86_lr_operand(imm, alloc_res, n_callee); }
                    else if lh > 0 { s_ret = x86_lr_operand(lh, alloc_res, n_callee); }
                    let sub_l: List[String] = x86_lower_ret_op(s_ret, fn_label, fn_node.return_type, 0);
                    let mut j: Int = 0; while j < list_len(sub_l) { out = out + list_get(sub_l, j); j = j + 1; }
                } else if op == ssa_op_println_int() {
                    out = out + "    movq " + s_imm + ", %rdi\n    call _println_int\n";
                } else if x86_is_simd_op(op) {
                    let simd_l: List[String] = x86_lower_simd_inst(op, s_r, s_lh, s_imm);
                    let mut j: Int = 0; while j < list_len(simd_l) { out = out + list_get(simd_l, j); j = j + 1; }
                }
            }
            i = i + 1;
        }
        b = b + 1;
    }

    out = out + ".L" + fn_label + "_end:\n";
    if frame_size > 0 { out = out + "    addq $" + frame_size.to_string() + ", %rsp\n"; }
    let mut pop_idx: Int = n_callee - 1;
    while pop_idx >= 0 { let pop_r: Int = list_get(callee_list, pop_idx); out = out + "    popq " + x86_reg_name(pop_r) + "\n"; pop_idx = pop_idx - 1; }
    if is_entry == 1 { out = out + "    movq %rax, %rdi\n    leave\n    mov $60, %rax\n    syscall\n"; out = out + x86_println_int_routine(); } else {
        out = out + "    leave\n    ret\n";
    }
    return out;
}
