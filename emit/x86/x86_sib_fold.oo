// # x86-64 Scale-Index-Base (SIB) Addressing Mode & LEA Synthesizer
//
// Logline: Folds array indexing and pointer arithmetic expressions into x86-64 SIB operands and emits optimized LEA instructions.
//
// Setup: Pure code generation and address synthesis module for the sovereign x86-64 backend.
//
// Beats:
//   1. Define X86SibOperand data structure and validation predicates.
//   2. Match base, index, scale, and displacement arithmetic patterns.
//   3. Format AT&T assembly SIB memory reference strings.
//   4. Emit high-throughput leaq, movq load, and movq store instructions.

import "x86_reg_pool.oo";


pub type X86SibOperand = struct {
    base_reg: String,
    index_reg: String,
    scale: Int,
    disp: Int
};

pub fn x86_is_valid_scale(scale: Int) -> Bool {
    return scale == 1 || scale == 2 || scale == 4 || scale == 8;
}

pub fn x86_scale_from_shift(shift: Int) -> Int {
    if shift == 0 { return 1;
    }
    if shift == 1 { return 2;
    }
    if shift == 2 { return 4;
    }
    if shift == 3 { return 8;
    }
    return 0;
}

pub fn x86_shift_from_scale(scale: Int) -> Int {
    if scale == 1 { return 0;
    }
    if scale == 2 { return 1;
    }
    if scale == 4 { return 2;
    }
    if scale == 8 { return 3;
    }
    return -1;
}

pub fn x86_sib_new(base: String, index: String, scale: Int, disp: Int) -> X86SibOperand {
    let mut s: Int = scale;
    if !x86_is_valid_scale(s) { s = 1;
    }
    let mut b: String = base;
    let mut idx: String = index;
    if idx == "%rsp" && s == 1 && b != "%rsp" && chars_len(b) > 0 { let tmp: String = b;
    b = idx;
    idx = tmp;
    }
    let res: X86SibOperand = X86SibOperand { base_reg: b, index_reg: idx, scale: s, disp: disp };
    return res;
}

pub fn x86_sib_base_disp(base: String, disp: Int) -> X86SibOperand {
    return x86_sib_new(base, "", 1, disp);
}

pub fn x86_sib_base_index(base: String, index: String, scale: Int) -> X86SibOperand {
    return x86_sib_new(base, index, scale, 0);
}

pub fn x86_sib_index_disp(index: String, scale: Int, disp: Int) -> X86SibOperand {
    return x86_sib_new("", index, scale, disp);
}

pub fn x86_sib_full(base: String, index: String, scale: Int, disp: Int) -> X86SibOperand {
    return x86_sib_new(base, index, scale, disp);
}

pub fn x86_sib_has_base(sib: X86SibOperand) -> Bool {
    return chars_len(sib.base_reg) > 0;
}

pub fn x86_sib_has_index(sib: X86SibOperand) -> Bool {
    return chars_len(sib.index_reg) > 0;
}

pub fn x86_match_sib_pattern(base_val: Int, index_val: Int, scale: Int, disp: Int) -> X86SibOperand {
    let b_str: String = if base_val >= 0 && base_val <= 13 { x86_reg_name(base_val) } else { "" };
    let i_str: String = if index_val >= 0 && index_val <= 13 { x86_reg_name(index_val) } else { "" };
    let norm_scale: Int = if x86_is_valid_scale(scale) { scale } else { 1 };
    return x86_sib_new(b_str, i_str, norm_scale, disp);
}

pub fn x86_match_array_index(base_reg: String, index_reg: String, elem_size: Int, offset: Int) -> X86SibOperand {
    let scale: Int = if x86_is_valid_scale(elem_size) { elem_size } else { 1 };
    return x86_sib_new(base_reg, index_reg, scale, offset);
}

pub fn x86_match_struct_field(base_reg: String, field_offset: Int) -> X86SibOperand {
    return x86_sib_base_disp(base_reg, field_offset);
}

pub fn x86_format_sib(sib: X86SibOperand) -> String {
    let has_b: Bool = chars_len(sib.base_reg) > 0;
    let has_i: Bool = chars_len(sib.index_reg) > 0;
    let d: Int = sib.disp;
    let sc: Int = sib.scale;
    let sc_s: String = if sc > 1 { ", " + sc.to_string() } else { "" };
    let d_s: String = if d != 0 { d.to_string() } else { "" };

    if has_b && has_i { return d_s + "(" + sib.base_reg + ", " + sib.index_reg + sc_s + ")";
    }
    if has_b && !has_i {
        if d != 0 { return d_s + "(" + sib.base_reg + ")";
        }
        return "(" + sib.base_reg + ")";
    }
    if !has_b && has_i { return d_s + "(, " + sib.index_reg + sc_s + ")";
    }
    return d.to_string();
}

pub fn x86_emit_lea_sib(dst_reg: String, sib: X86SibOperand) -> String {
    return "    leaq " + x86_format_sib(sib) + ", " + dst_reg + "\n";
}

pub fn x86_emit_mov_load_sib(dst_reg: String, sib: X86SibOperand) -> String {
    return "    movq " + x86_format_sib(sib) + ", " + dst_reg + "\n";
}

pub fn x86_emit_mov_store_sib(src_reg: String, sib: X86SibOperand) -> String {
    return "    movq " + src_reg + ", " + x86_format_sib(sib) + "\n";
}

pub fn x86_emit_add_mem_sib(src_reg: String, sib: X86SibOperand) -> String {
    return "    addq " + src_reg + ", " + x86_format_sib(sib) + "\n";
}

pub fn x86_emit_sub_mem_sib(src_reg: String, sib: X86SibOperand) -> String {
    return "    subq " + src_reg + ", " + x86_format_sib(sib) + "\n";
}
