// # x86-64 LEB128 Variable-Length Integer Codec
//
// Logline: Encode and decode signed and unsigned LEB128 variable-length integers for x86-64 DWARF 5 debug sections.
//
// Setup: Pure algorithmic codec module with zero external runtime dependencies.
//
// Beats:
//   1. Encode unsigned 32-bit and 64-bit integers to ULEB128 byte sequences.
//   2. Encode signed 32-bit and 64-bit integers to SLEB128 byte sequences.
//   3. Decode ULEB128 and SLEB128 byte sequences back to integer values.

pub type X86LebDecodeResult = struct {
    value: Int,
    next_offset: Int
};

pub fn x86_leb_decode_result_new(value: Int, next_offset: Int) -> X86LebDecodeResult {
    let res: X86LebDecodeResult = X86LebDecodeResult { value: value, next_offset: next_offset };
    return res;
}

pub fn x86_encode_u32_leb128(val: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut v: Int = val;
    let mut more: Bool = true;
    while more { let byte: Int = v & 127;
    v = v / 128;
    if v == 0 { out = list_push(out, byte);
    more = false;
    } else {
            out = list_push(out, byte | 128);
        }
    }
    return out;
}

pub fn x86_encode_u64_leb128(val: Int) -> List[Int] {
    return x86_encode_u32_leb128(val);
}

pub fn x86_encode_i64_leb128(val: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut v: Int = val;
    let mut more: Bool = true;
    while more { let byte: Int = v & 127;
    v = v >> 7;
    let sign_bit: Int = byte & 64;
    if (v == 0 && sign_bit == 0) || (v == -1 && sign_bit != 0) { out = list_push(out, byte);
    more = false;
    } else {
            out = list_push(out, byte | 128);
        }
    }
    return out;
}

pub fn x86_encode_i32_leb128(val: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut v: Int = val & 4294967295;
    if (v & 2147483648) != 0 { v = v - 4294967296;
    }
    let mut more: Bool = true;
    let mut count: Int = 0;
    while more { let byte: Int = v & 127;
    v = v >> 7;
    let sign_bit: Int = byte & 64;
    count = count + 1;
    if count == 5 { out = list_push(out, byte & 127);
    more = false;
    } else if (v == 0 && sign_bit == 0) || (v == -1 && sign_bit != 0) {
            out = list_push(out, byte);
            more = false;
        } else {
            out = list_push(out, byte | 128);
        }
    }
    return out;
}

pub fn x86_decode_u32_leb128(bytes: List[Int], offset: Int) -> X86LebDecodeResult {
    let mut result: Int = 0;
let mut shift: Int = 0;
let mut cur: Int = offset;
let n: Int = list_len(bytes);
let mut more: Bool = true;
while more && cur < n { let b: Int = list_get(bytes, cur);
cur = cur + 1;
result = result | ((b & 127) << shift);
shift = shift + 7;
if (b & 128) == 0 { more = false;
}
    }
    let res: X86LebDecodeResult = X86LebDecodeResult { value: result, next_offset: cur };
    return res;
}

pub fn x86_decode_u64_leb128(bytes: List[Int], offset: Int) -> X86LebDecodeResult {
    return x86_decode_u32_leb128(bytes, offset);
}

pub fn x86_decode_i64_leb128(bytes: List[Int], offset: Int) -> X86LebDecodeResult {
    let mut result: Int = 0;
let mut shift: Int = 0;
let mut cur: Int = offset;
let n: Int = list_len(bytes);
let mut more: Bool = true;
let mut last_byte: Int = 0;
while more && cur < n { let b: Int = list_get(bytes, cur);
cur = cur + 1;
last_byte = b;
result = result | ((b & 127) << shift);
shift = shift + 7;
if (b & 128) == 0 { more = false;
}
    }
    if shift < 64 && (last_byte & 64) != 0 { result = result | (0 - (1 << shift));
    }
    let res: X86LebDecodeResult = X86LebDecodeResult { value: result, next_offset: cur };
    return res;
}

pub fn x86_decode_i32_leb128(bytes: List[Int], offset: Int) -> X86LebDecodeResult {
    let mut result: Int = 0;
let mut shift: Int = 0;
let mut cur: Int = offset;
let n: Int = list_len(bytes);
let mut more: Bool = true;
let mut last_byte: Int = 0;
while more && cur < n { let b: Int = list_get(bytes, cur);
cur = cur + 1;
last_byte = b;
result = result | ((b & 127) << shift);
shift = shift + 7;
if (b & 128) == 0 { more = false;
}
    }
    if shift < 32 { if (last_byte & 64) != 0 { result = result | (0 - (1 << shift));
    }
    } else {
        result = result & 4294967295;
        if (result & 2147483648) != 0 {
            result = result - 4294967296;
        }
    }
    let res: X86LebDecodeResult = X86LebDecodeResult { value: result, next_offset: cur };
    return res;
}
