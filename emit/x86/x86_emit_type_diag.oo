// # Typed let mismatch reporter for emit-x86
//
// Logline: Scans KW_LET COLON type EQ literal and returns --> / ^ type-mismatch at the let site.
//
// Setup: tokenize_lines + x86_tok_k/t + x86_diag_emit_with_src. Called from x86_emit_stream_c.
//
// Beats:
//   1. let x: Int = "hi" (and String = INT) emit type-mismatch with path and caret.
//   2. Empty list means no annotated literal clash.


import "x86_emit_const_harvest.oo";

import "x86_emit_diag.oo";


fn x86_td_int(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut v: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "0" { v = v * 10 + 0;
        } else if c == "1" { v = v * 10 + 1;
        }
        else if c == "2" { v = v * 10 + 2;
        } else if c == "3" { v = v * 10 + 3;
        }
        else if c == "4" { v = v * 10 + 4;
        } else if c == "5" { v = v * 10 + 5;
        }
        else if c == "6" { v = v * 10 + 6;
        } else if c == "7" { v = v * 10 + 7;
        }
        else if c == "8" { v = v * 10 + 8;
        } else if c == "9" { v = v * 10 + 9;
        }
        i = i + 1;
    }
    return v;
}

pub fn x86_emit_type_mismatch_e(src: String, path: String) -> List[String] {
    let mut errs: List[String] = list_new();
    let toks: List[String] = tokenize_lines(src);
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i < n {
        if x86_tok_k(toks, i) == "KW_LET" {
            let mut j: Int = i + 1;
            if j < n && x86_tok_k(toks, j) == "KW_MUT" { j = j + 1;
            }
            if j < n && x86_tok_k(toks, j) == "IDENT" { j = j + 1;
            }
            if j < n && x86_tok_k(toks, j) == "COLON" && j + 1 < n && x86_tok_k(toks, j + 1) == "IDENT" {
                let ty: String = x86_tok_t(toks, j + 1);
                let mut k: Int = j + 2;
                while k < n && x86_tok_k(toks, k) != "EQ" && x86_tok_k(toks, k) != "SEMI" { k = k + 1;
                }
                if k < n && x86_tok_k(toks, k) == "EQ" && k + 1 < n {
                    let vk: String = x86_tok_k(toks, k + 1);
                    let mut bad: Bool = false;
                    if ty == "Int" && (vk == "STRING" || vk == "FLOAT") { bad = true;
                    }
                    if ty == "String" && (vk == "INT" || vk == "FLOAT") { bad = true;
                    }
                    if bad { let line: Int = x86_td_int(field_at(list_get(toks, i), 1));
                    let col: Int = x86_td_int(field_at(list_get(toks, i), 2));
                    let sl: String = x86_diag_src_line(src, line);
                    let d: String = x86_diag_emit_with_src("type-mismatch", path, line, col, "let type vs literal", sl);
                    errs = list_push(errs, d);
                    }
                }
            }
        }
        i = i + 1;
    }
    return errs;
}
