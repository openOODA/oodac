// # x86_64 SSA emitter base helpers
//
// Logline: Pure slot, label, and rodata helpers used by the x86 SSA emitter and instruction formatter.
//
// Setup: Imported by x86_ssa_emit.oo and x86_ssa_emit_inst.oo. Uses ssa_ir.oo and standard string primitives.
//
// Beats:
//   1. Provide per-vreg 8-byte and 32-byte SIMD slot strings.
//   2. Detect SIMD use and sanitize function/label names.
//   3. Provide rodata string emission and struct field init helpers.

import "emit/llvm/ssa_ir.oo";

pub fn x86_ssa_slot(reg: Int) -> String {
    let r: Int = if reg <= 0 { 1 } else { reg };
    let off: Int = r * -8;
    return off.to_string() + "(%rbp)";
}

pub fn x86_ssa_simd_slot(reg: Int) -> String {
    let r: Int = if reg <= 0 { 1 } else { reg };
    let off: Int = 0 - (32 * r);
    return off.to_string() + "(%rbp)";
}

pub fn x86_ssa_simd_align_check(addr_reg: String, label: String) -> String {
    return "    movq " + addr_reg + ", %r10\n" + "    testb $0x1F, %r10b\n" + "    jz .Lsimd_aligned_" + label + "\n" + "    lea .Ltrap_0x20_simd_alignment_fault(%rip), %rdi\n" + "    mov $38, %eax\n" + "    call __ooda_trap\n" + ".Lsimd_aligned_" + label + ":\n";
}

fn x86_ssa_uses_simd(opcodes: List[Int], n_insts: Int) -> Int {
    // Returns 1 if any SIMD opcode (56-78 per x86_ssa_lower_simd.oo) is
    // present, else 0. The frame is then sized to 32 bytes per slot
    // instead of 8, and a `andq $-32, %rsp` is inserted into the prologue.
    let mut i: Int = 0;
    while i < n_insts {
        if i < list_len(opcodes) {
            let op: Int = list_get(opcodes, i);
            if op >= 56 && op <= 78 { return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn x86_ssa_sanitize_label(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95 { out = out + char_at(s, i);
        }
        i = i + 1;
    }
    if chars_len(out) == 0 { return "fn";
    }
    return out;
}
pub fn x86_ssa_emit_function(fn_data: SsaFunction) -> String {
    return "";
}

pub fn x86_ssa_emit_println_int(arg_slot: Int, fn_name: String) -> String {
    let s: String = x86_ssa_slot(arg_slot);
    return "    movq " + s + ", %rdi\n    call _println_int\n";
}

pub fn x86_ssa_emit_println_str(arg_slot: Int, fn_name: String) -> String {
    let id: String = arg_slot.to_string();
return "lea .Lstr_" + id + "(%rip), %rsi\n    mov $.Lstr_" + id + "_end-.Lstr_" + id + ", %rdx\n    mov $1, %rdi\n    mov $1, %rax\n    syscall";
}

pub fn x86_ssa_emit_rodata_strings(strings: List[String]) -> String {
    let mut out: String = "    .section .rodata\n";
let n: Int = list_len(strings);
let mut i: Int = 0;
while i < n { let s: String = list_get(strings, i);
out = out + ".Lstr_" + i.to_string() + ":\n    .ascii \"" + s + "\\n\"\n.Lstr_" + i.to_string() + "_end:\n";
i = i + 1;
}
    return out;
}

pub fn x86_ssa_emit_println_str_routine() -> String {
    return ".globl _println_str\n.p2align 4\n_println_str:\n    push %rbp\n    mov %rsp, %rbp\n    mov %rsi, %rsi\n    mov $1, %rax\n    mov $1, %rdi\n    syscall\n    pop %rbp\n    ret\n";
}

pub fn x86_ssa_emit_struct_field_init(field_offset: Int, value_reg: Int, base_reg: String) -> String {
    return "    movq " + x86_ssa_slot(value_reg) + ", " + field_offset.to_string() + "(" + base_reg + ")\n";
}
pub fn x86_ssa_emit_struct_field_inits(fn_data: SsaFunction, base_reg: String) -> String {
    // Walk the IR and emit a field-init for every store_lit (opcode 21) whose imm is non-zero. Field offset = result_reg * 8. Minimal "struct lit" lower — not yet wired into x86_ssa_emit_function.
    let mut out: String = "";
    let n: Int = ssa_fn_inst_count(fn_data);
    let opcodes: List[Int] = fn_data.inst_opcodes;
    let results: List[Int] = fn_data.inst_results;
    let imm_vals: List[Int] = fn_data.inst_imm_vals;
    let mut i: Int = 0;
    while i < n {
        if list_get(opcodes, i) == 21 {
            let res: Int = list_get(results, i);
            if list_get(imm_vals, i) != 0 { out = out + x86_ssa_emit_struct_field_init(res * 8, res, base_reg);
            }
        }
        i = i + 1;
    }
    return out;
}
