// # Real Float const-fold lower for the SSA path (Tier 4 #21)
//
// Logline: Tokenize source, fold let/println chains at scale 1e6, emit .rodata + main + _println_float.
//
// Setup: Token helpers from x86_emit_harv.oo. Follows standard openOODA module conventions.
//
// Beats:
//   1. parse_v / fmt_v / op_v / fold_v / x86_ssa_float_atom: const-fold helpers (scale 1e6).
//   2. x86_ssa_emit_float_routine_text: returns the verbatim _println_float routine text.
//   3. x86_ssa_emit_float_op: returns one SSE instruction sequence per float binop.
//   4. x86_ssa_emit_float_program: tokenizes, builds let table, emits .rodata + main.


import "x86_emit_const_harvest.oo";


fn x86_ssa_float_slot(reg: Int) -> String {
    if reg <= 0 { return "0(%rbp)"; }
    let off: Int = reg * -8;
    return off.to_string() + "(%rbp)";
}

fn x86_ssa_float_atom(toks: List[String], n: Int, p: Int, fnames: List[String], fvals: List[Int]) -> List[Int] {
    let bad: List[Int] = list_new();
    if p >= n { return bad; }
    let k: String = x86_tok_k(toks, p);
    if k == "FLOAT" {
        let v: Int = 0 + parse_v(x86_tok_t(toks, p));
        let mut o: List[Int] = list_new();
        o = list_push(o, v);
        o = list_push(o, 1);
        return o;
    }
    if k == "IDENT" {
        let idx: Int = 0 + x86_bind_idx(fnames, x86_tok_t(toks, p));
        if idx < 0 { return bad; }
        let mut o: List[Int] = list_new();
        o = list_push(o, list_get(fvals, idx));
        o = list_push(o, 1);
        return o;
    }
    return bad;
}

fn parse_v(s: String) -> Int {
    let n = chars_len(s);
    if n <= 0 { return 0; }
    let mut i = 0; let mut neg = false;
    if char_at(s, 0) == "-" { neg = true; i = 1; }
    let mut w = 0;
    while i < n && char_at(s, i) != "." {
        let b: Int = byte_at(s, i);
        if b < 48 || b > 57 { return 0; }
        w = w * 10 + (b - 48);
        i = i + 1;
    }
    let mut f = 0; let mut d = 1;
    if i < n && char_at(s, i) == "." {
        i = i + 1;
        while i < n && d < 1000000 {
            let b: Int = byte_at(s, i);
            if b < 48 || b > 57 { return 0; }
            f = f * 10 + (b - 48);
            d = d * 10;
            i = i + 1;
        }
        while d < 1000000 { f = f * 10; d = d * 10; }
    }
    let mut v = w * 1000000 + f;
    if i < n && (char_at(s, i) == "e" || char_at(s, i) == "E") {
        i = i + 1; let mut exp_neg = false;
        if i < n && char_at(s, i) == "-" { exp_neg = true; i = i + 1; }
        else if i < n && char_at(s, i) == "+" { i = i + 1; }
        let mut exp = 0;
        while i < n {
            let eb: Int = byte_at(s, i);
            if eb < 48 || eb > 57 { return 0; }
            exp = exp * 10 + (eb - 48);
            i = i + 1;
        }
        if exp_neg {
            let mut k = 0; while k < exp { v = v / 10; k = k + 1; }
        } else {
            let mut k = 0; while k < exp { v = v * 10; k = k + 1; }
        }
    }
    if neg { v = 0 - v; }
    return v;
}

fn fmt_v(v: Int) -> String {
    if v < 0 { return "-" + fmt_v(0 - v); }
    let whole = v / 1000000;
    let mut frac = v - (whole * 1000000);
    let digits = "0123456789";
    let mut fs = ""; let mut i = 0;
    while i < 6 { fs = char_at(digits, frac % 10) + fs; frac = frac / 10; i = i + 1; }
    let mut trail = 6;
    while trail > 1 && char_at(fs, trail - 1) == "0" { trail = trail - 1; }
    let mut trimmed = ""; i = 0;
    while i < trail { trimmed = trimmed + char_at(fs, i); i = i + 1; }
    return whole.to_string() + "." + trimmed;
}

fn op_v(a: Int, b: Int, op: String) -> Int {
    let sc = 1000000;
    if op == "PLUS" { return a + b; }
    if op == "MINUS" { return a - b; }
    if op == "STAR" { return (a * b) / sc; }
    if op == "SLASH" {
        if b == 0 { return 9223372036854775807; }
        return (a * sc) / b;
    }
    return 0;
}

fn fold_v(toks: List[String], n: Int, j: Int, fnames: List[String], fvals: List[Int]) -> List[Int] {
    let a0: List[Int] = x86_ssa_float_atom(toks, n, j, fnames, fvals);
    if list_len(a0) < 2 { return a0; }
    let mut acc_val: Int = list_get(a0, 0); let mut e: Int = j + 1;
    while e < n {
        let ek: String = x86_tok_k(toks, e);
        if ek == "SEMI" || ek == "RPAREN" { break; }
        if ek == "STAR" || ek == "PLUS" || ek == "MINUS" || ek == "SLASH" {
            let a: List[Int] = x86_ssa_float_atom(toks, n, e + 1, fnames, fvals);
            if list_len(a) < 2 { return a; }
            acc_val = 0 + op_v(acc_val, list_get(a, 0), ek);
            e = e + 2;
        } else { return a0; }
    }
    let mut r: List[Int] = list_new(); r = list_push(r, acc_val); r = list_push(r, e - j); return r;
}

pub fn x86_ssa_emit_float_routine_text() -> String {
    let mut s: String = "    .section .text\n.globl _println_float\n.p2align 4\n_println_float:\n    push %rbp\n    mov %rsp, %rbp\n    sub $64, %rsp\n"; s = s + "    movq %xmm0, %rax\n    movq %rax, %rcx\n    movabsq $0x7FF0000000000000, %rdx\n    andq %rdx, %rcx\n    cmpq %rdx, %rcx\n    jne .Lp_finite\n"; s = s + "    movabsq $0x000FFFFFFFFFFFFF, %rdx\n    testq %rdx, %rax\n    jnz .Lp_nan\n"; s = s + "    testq %rax, %rax\n    js .Lp_neginf\n"; s = s + "    movb $10, -1(%rbp)\n    movb $102, -2(%rbp)\n    movb $110, -3(%rbp)\n    movb $105, -4(%rbp)\n"; s = s + "    lea -4(%rbp), %rsi\n    mov $4, %rdx\n    mov $1, %rax\n    mov $1, %rdi\n    syscall\n    mov %rbp, %rsp\n    pop %rbp\n    ret\n"; s = s + ".Lp_neginf:\n    movb $10, -1(%rbp)\n    movb $102, -2(%rbp)\n    movb $110, -3(%rbp)\n    movb $105, -4(%rbp)\n    movb $45, -5(%rbp)\n"; s = s + "    lea -5(%rbp), %rsi\n    mov $5, %rdx\n    mov $1, %rax\n    mov $1, %rdi\n    syscall\n    mov %rbp, %rsp\n    pop %rbp\n    ret\n"; s = s + ".Lp_nan:\n    movb $10, -1(%rbp)\n    movb $110, -2(%rbp)\n    movb $97, -3(%rbp)\n    movb $110, -4(%rbp)\n"; s = s + "    lea -4(%rbp), %rsi\n    mov $4, %rdx\n    mov $1, %rax\n    mov $1, %rdi\n    syscall\n    mov %rbp, %rsp\n    pop %rbp\n    ret\n"; s = s + ".Lp_finite:\n    mov $0, %r8\n    test %rax, %rax\n    jns .Lp_nonneg\n    mov $1, %r8\n    movabsq $0x7FFFFFFFFFFFFFFF, %rcx\n    and %rcx, %rax\n    movq %rax, %xmm0\n"; s = s + ".Lp_nonneg:\n    cvttsd2si %xmm0, %rax\n    cvtsi2sd %rax, %xmm1\n    subsd %xmm1, %xmm0\n    mulsd .Lconst_100(%rip), %xmm0\n    addsd .Lconst_half(%rip), %xmm0\n    cvttsd2si %xmm0, %rcx\n    cmp $100, %rcx\n    jl .Lp_fmt\n    inc %rax\n    xor %rcx, %rcx\n"; s = s + ".Lp_fmt:\n    mov %rax, %r9\n    lea -1(%rbp), %rdi\n    movb $10, (%rdi)\n    mov %rcx, %rax\n    xor %rdx, %rdx\n    mov $10, %r10\n    div %r10\n    dec %rdi\n    add $48, %dl\n    movb %dl, (%rdi)\n    dec %rdi\n    add $48, %al\n    movb %al, (%rdi)\n    dec %rdi\n    movb $46, (%rdi)\n    mov %r9, %rax\n    test %rax, %rax\n    jnz .Lp_int_loop\n    dec %rdi\n    movb $48, (%rdi)\n    jmp .Lp_sign\n"; s = s + ".Lp_int_loop:\n    test %rax, %rax\n    jz .Lp_sign\n    xor %rdx, %rdx\n    mov $10, %r10\n    div %r10\n    dec %rdi\n    add $48, %dl\n    movb %dl, (%rdi)\n    jmp .Lp_int_loop\n"; s = s + ".Lp_sign:\n    test %r8, %r8\n    jz .Lp_write\n    dec %rdi\n    movb $45, (%rdi)\n"; s = s + ".Lp_write:\n    mov %rbp, %rdx\n    sub %rdi, %rdx\n    mov %rdi, %rsi\n    mov $1, %rax\n    mov $1, %rdi\n    syscall\n    mov %rbp, %rsp\n    pop %rbp\n    ret\n"; return s;
}

pub fn x86_ssa_emit_float_op(op_name: String, lhs_slot: Int, rhs_slot: Int, dst_slot: Int) -> String {
    if op_name == "PLUS" { return "    movsd " + x86_ssa_float_slot(lhs_slot) + ", %xmm0\n    movsd " + x86_ssa_float_slot(rhs_slot) + ", %xmm1\n    addsd %xmm1, %xmm0\n    movsd %xmm0, " + x86_ssa_float_slot(dst_slot) + "\n"; }
    if op_name == "MINUS" { return "    movsd " + x86_ssa_float_slot(lhs_slot) + ", %xmm0\n    movsd " + x86_ssa_float_slot(rhs_slot) + ", %xmm1\n    subsd %xmm1, %xmm0\n    movsd %xmm0, " + x86_ssa_float_slot(dst_slot) + "\n"; }
    if op_name == "STAR" { return "    movsd " + x86_ssa_float_slot(lhs_slot) + ", %xmm0\n    movsd " + x86_ssa_float_slot(rhs_slot) + ", %xmm1\n    mulsd %xmm1, %xmm0\n    movsd %xmm0, " + x86_ssa_float_slot(dst_slot) + "\n"; }
    if op_name == "SLASH" { return "    movsd " + x86_ssa_float_slot(lhs_slot) + ", %xmm0\n    movsd " + x86_ssa_float_slot(rhs_slot) + ", %xmm1\n    divsd %xmm1, %xmm0\n    movsd %xmm0, " + x86_ssa_float_slot(dst_slot) + "\n"; }
    if op_name == "I2F" { return "    cvtsi2sd " + x86_ssa_float_slot(lhs_slot) + ", %xmm0\n    movsd %xmm0, " + x86_ssa_float_slot(dst_slot) + "\n"; }
    if op_name == "F2I" { return "    movsd " + x86_ssa_float_slot(lhs_slot) + ", %xmm0\n    cvttsd2si %xmm0, " + x86_ssa_float_slot(dst_slot) + "\n"; }
    return "";
}

pub fn x86_ssa_emit_float_program(src: String) -> String {
    let toks: List[String] = tokenize_lines(src); let n: Int = list_len(toks);
    let mut fnames: List[String] = list_new(); let mut fvals: List[Int] = list_new();
    let mut rv: Int = 0; let mut fnd = false; let mut ret_only = false;
    let mut fn_name = "fn"; let mut lit = ""; let mut i = 0;
    while i < n {
        let k: String = x86_tok_k(toks, i);
        if k == "KW_FN" && i + 1 < n && x86_tok_k(toks, i + 1) == "IDENT" { fn_name = x86_tok_t(toks, i + 1); }
        if k == "KW_LET" {
            let mut j = i + 1; if j < n && x86_tok_k(toks, j) == "KW_MUT" { j = j + 1; }
            if j + 3 < n && x86_tok_t(toks, j + 2) == "Float" && x86_tok_k(toks, j + 3) == "EQ" {
                let acc_res: List[Int] = fold_v(toks, n, j + 4, fnames, fvals);
                if list_len(acc_res) >= 2 { fnames = list_push(fnames, x86_tok_t(toks, j)); fvals = list_push(fvals, list_get(acc_res, 0)); }
            }
        }
        if k == "IDENT" && x86_tok_t(toks, i) == "println" {
            let mut j = i + 1; if j < n && x86_tok_k(toks, j) == "LPAREN" { j = j + 1; }
            let acc_res: List[Int] = fold_v(toks, n, j, fnames, fvals);
            if list_len(acc_res) >= 2 { rv = list_get(acc_res, 0); fnd = true; ret_only = false; }
        }
        if k == "KW_RETURN" && !fnd && i + 1 < n {
            let acc_res: List[Int] = fold_v(toks, n, i + 1, fnames, fvals);
            if list_len(acc_res) >= 2 { rv = list_get(acc_res, 0); fnd = true; ret_only = true; }
        }
        i = i + 1;
    }
    if !fnd { return ""; }
    let rs: String = if chars_len(lit) > 0 { lit } else { fmt_v(rv) };
    if ret_only { return "    .section .rodata\n    .p2align 3\n.Lf_result:\n    .double " + rs + "\n    .section .text\n    .globl " + fn_name + "\n    .p2align 4\n" + fn_name + ":\n    movsd .Lf_result(%rip), %xmm0\n    ret\n"; }
    return "    .section .rodata\n    .p2align 3\n.Lconst_100:\n    .double 100.0\n.Lconst_half:\n    .double 0.5\n.Lf_result:\n    .double " + rs + "\n    .section .text\n    .globl _start\n    .globl main\n" + x86_ssa_emit_float_routine_text() + "main:\n_start:\n    push %rbp\n    mov %rsp, %rbp\n    sub $32, %rsp\n    movsd .Lf_result(%rip), %xmm0\n    call _println_float\n    add $32, %rsp\n    pop %rbp\n    mov $60, %rax\n    xor %rdi, %rdi\n    syscall\n";
}
