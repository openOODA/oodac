// # x86-64 SSA Instruction Lowering & System V AMD64 Calling Lowerer
//
// Logline: Lowers individual SSA IR instructions into x86-64 machine assembly using assigned physical registers and System V AMD64 ABI.
//
// Setup: Pairs with oodac/x86_ssa_lower_reg.oo, oodac/x86_abi_classify.oo, and oodac/x86_abi_sret.oo.
//
// Beats:
//   1. Lower arithmetic, bitwise, shift, and comparison instructions with scratch staging.
//   2. Lower division and remainder operations with reciprocal multiplication delegation.
//   3. Lower memory operations with SIB address mode synthesis.
//   4. Lower System V AMD64 function calls and returns with SRet hidden pointer support.

import "emit/llvm/ssa_ir.oo";
import "x86_reg_pool.oo";

import "x86_regalloc_scan.oo";

import "x86_abi_classify.oo";

import "x86_abi_sret.oo";

import "x86_sib_fold.oo";

import "x86_ssa_lower_div.oo";

import "x86_ssa_lower_simd.oo";


pub fn x86_lr_operand(vreg: Int, res: LinearScanResult, n_callee: Int) -> String {
    let preg: Int = 0 + x86_get_assigned_reg(res, vreg);
    if preg >= 0 && preg < 14 { return x86_reg_name(preg);
    }
    let slot: Int = 0 + x86_get_spill_slot(res, vreg);
    let off: Int = (n_callee + slot + 1) * -8;
    return off.to_string() + "(%rbp)";
}

pub fn x86_lower_alu_op(op: Int, s_lh: String, s_imm: String, s_r: String, imm: Int, r_is_mem: Bool) -> List[String] {
    let mut lines: List[String] = list_new();
    let mnem: String = if op == ssa_op_add() { "addq" } else if op == ssa_op_sub() { "subq" } else if op == ssa_op_mul() { "imulq" } else if op == ssa_op_and() { "andq" } else if op == ssa_op_or() { "orq" } else { "xorq" };
    if r_is_mem {
        lines = list_push(lines, "    movq " + s_lh + ", %r10\n");
        if imm != 0 || op != ssa_op_add() { lines = list_push(lines, "    " + mnem + " " + s_imm + ", %r10\n");
        }
        lines = list_push(lines, "    movq %r10, " + s_r + "\n");
    } else {
        lines = list_push(lines, "    movq " + s_lh + ", " + s_r + "\n");
        if imm != 0 || op != ssa_op_add() { lines = list_push(lines, "    " + mnem + " " + s_imm + ", " + s_r + "\n");
        }
    }
    return lines;
}

pub fn x86_lower_shift_op(op: Int, s_lh: String, s_imm: String, s_r: String) -> List[String] {
    let mut lines: List[String] = list_new();
    let sh_mnem: String = if op == ssa_op_shl() { "shlq" } else { "sarq" };
    lines = list_push(lines, "    movq " + s_lh + ", %r10\n");
    if s_imm == "%rcx" {
        lines = list_push(lines, "    " + sh_mnem + " %cl, %r10\n");
    } else {
        if s_r != "%rcx" { lines = list_push(lines, "    movq %rcx, %r11\n");
        }
        lines = list_push(lines, "    movq " + s_imm + ", %rcx\n");
        lines = list_push(lines, "    " + sh_mnem + " %cl, %r10\n");
        if s_r != "%rcx" { lines = list_push(lines, "    movq %r11, %rcx\n");
        }
    }
    lines = list_push(lines, "    movq %r10, " + s_r + "\n");
    return lines;
}

pub fn x86_lower_div_op(op: Int, s_lh: String, s_imm: String, s_r: String) -> List[String] {
    return x86_lower_div_var(op, s_lh, s_imm, s_r);
}

pub fn x86_lower_div_const_op(op: Int, s_lh: String, divisor: Int, s_r: String) -> List[String] {
    if op == ssa_op_sdiv() {
        return x86_lower_div_const(op, s_lh, divisor, s_r);
    }
    return x86_lower_mod_const(op, s_lh, divisor, s_r);
}

pub fn x86_lower_const_op(imm: Int, s_r: String, r_is_mem: Bool) -> List[String] {
    let mut lines: List[String] = list_new();
    let val_s: String = imm.to_string();
    if r_is_mem {
        if imm >= -2147483648 && imm <= 2147483647 { lines = list_push(lines, "    movq $" + val_s + ", %r10\n    movq %r10, " + s_r + "\n");
        }
        else { lines = list_push(lines, "    movabsq $" + val_s + ", %r10\n    movq %r10, " + s_r + "\n");
        }
    } else {
        if imm >= -2147483648 && imm <= 2147483647 { lines = list_push(lines, "    movq $" + val_s + ", " + s_r + "\n");
        }
        else { lines = list_push(lines, "    movabsq $" + val_s + ", " + s_r + "\n");
        }
    }
    return lines;
}

pub fn x86_lower_icmp_op(op: Int, s_lh: String, s_imm: String, s_r: String, lh_spill: Bool, imm_spill: Bool, r_is_mem: Bool) -> List[String] {
    let mut lines: List[String] = list_new();
    let set_op: String = if op == ssa_op_icmp_eq() { "sete" } else if op == ssa_op_icmp_slt() { "setl" } else if op == ssa_op_icmp_sgt() { "setg" } else if op == ssa_op_icmp_sge() { "setge" } else if op == ssa_op_icmp_ule() { "setbe" } else if op == ssa_op_icmp_ult() { "setb" } else { "setne" };
    if lh_spill && imm_spill { lines = list_push(lines, "    movq " + s_lh + ", %r10\n    cmpq " + s_imm + ", %r10\n    " + set_op + " %r10b\n");
    } else {
        lines = list_push(lines, "    cmpq " + s_imm + ", " + s_lh + "\n    " + set_op + " %r10b\n");
    }
    if r_is_mem { lines = list_push(lines, "    movzbq %r10b, %r10\n    movq %r10, " + s_r + "\n");
    }
    else { lines = list_push(lines, "    movzbq %r10b, " + s_r + "\n");
    }
    return lines;
}

pub fn x86_lower_mem_op_sib(op: Int, s_r: String, sib: X86SibOperand) -> List[String] {
    let mut lines: List[String] = list_new();
    if op == ssa_op_load() {
        lines = list_push(lines, x86_emit_mov_load_sib(s_r, sib));
    } else if op == ssa_op_store() || op == ssa_op_store_lit() {
        lines = list_push(lines, x86_emit_mov_store_sib(s_r, sib));
    }
    return lines;
}

pub fn x86_lower_mem_op(op: Int, s_r: String, s_lh: String, s_imm: String, imm: Int) -> List[String] {
    let mut lines: List[String] = list_new();
    if op == ssa_op_load() {
        lines = list_push(lines, "    movq " + s_imm + ", %r10\n    movq %r10, " + s_r + "\n");
    } else if op == ssa_op_store() || op == ssa_op_store_lit() {
        lines = list_push(lines, "    movq " + s_lh + ", %r10\n    movq %r10, " + s_r + "\n");
    } else if op == ssa_op_extractvalue() {
        let sib: X86SibOperand = x86_sib_new(s_lh, "", 1, imm * 8);
        lines = list_push(lines, "    movq " + x86_format_sib(sib) + ", %r10\n    movq %r10, " + s_r + "\n");
    } else if op == ssa_op_insertvalue() {
        let sib: X86SibOperand = x86_sib_new(s_lh, "", 1, imm * 8);
        lines = list_push(lines, "    movq " + s_imm + ", %r10\n    movq %r10, " + x86_format_sib(sib) + "\n");
    }
    return lines;
}

pub fn x86_lower_call_op(n_args: Int, arg_reg_str: String, s_r: String) -> List[String] {
    let mut lines: List[String] = list_new();
    if n_args > 0 && chars_len(arg_reg_str) > 0 {
        if arg_reg_str != "%rdi" { lines = list_push(lines, "    movq " + arg_reg_str + ", %rdi\n");
        }
    }
    if s_r != "%rax" { lines = list_push(lines, "    movq %rax, " + s_r + "\n");
    }
    return lines;
}

pub fn x86_lower_ret_op(s_ret: String, fn_label: String, ret_type: Int, sret_offset: Int) -> List[String] {
    let mut lines: List[String] = list_new();
    if sret_offset < 0 {
        let sret_lines: List[String] = x86_sret_callee_epilogue(sret_offset);
        let mut sli: Int = 0;
        while sli < list_len(sret_lines) { lines = list_push(lines, list_get(sret_lines, sli));
        sli = sli + 1;
        }
    } else if chars_len(s_ret) > 0 {
        if s_ret != "%rax" { lines = list_push(lines, "    movq " + s_ret + ", %rax\n");
        }
    }
    lines = list_push(lines, "    jmp .L" + fn_label + "_end\n");
    return lines;
}

pub fn x86_lower_ret_pair(s_ret0: String, s_ret1: String, fn_label: String) -> List[String] {
    let mut lines: List[String] = list_new();
    if chars_len(s_ret0) > 0 && s_ret0 != "%rax" { lines = list_push(lines, "    movq " + s_ret0 + ", %rax\n");
    }
    if chars_len(s_ret1) > 0 && s_ret1 != "%rdx" { lines = list_push(lines, "    movq " + s_ret1 + ", %rdx\n");
    }
    lines = list_push(lines, "    jmp .L" + fn_label + "_end\n");
    return lines;
}

pub fn x86_lower_falu_op(op: Int, s_lh: String, s_imm: String, s_r: String) -> List[String] {
    let mut lines: List[String] = list_new();
    let mnem: String = if op == ssa_op_fadd() { "addsd" } else if op == ssa_op_fsub() { "subsd" } else if op == ssa_op_fmul() { "mulsd" } else { "divsd" };
    lines = list_push(lines, "    movsd " + s_lh + ", %xmm0\n");
    lines = list_push(lines, "    " + mnem + " " + s_imm + ", %xmm0\n");
    lines = list_push(lines, "    movsd %xmm0, " + s_r + "\n");
    return lines;
}

pub fn x86_lower_fcmp_op(op: Int, s_lh: String, s_imm: String, s_r: String) -> List[String] {
    let mut lines: List[String] = list_new();
    lines = list_push(lines, "    movsd " + s_lh + ", %xmm0\n");
    lines = list_push(lines, "    ucomisd " + s_imm + ", %xmm0\n");
    let set_op: String = if op == ssa_op_fcmp_oeq() { "sete" } else if op == ssa_op_fcmp_olt() { "setb" } else if op == ssa_op_fcmp_ole() { "setbe" } else if op == ssa_op_fcmp_ogt() { "seta" } else if op == ssa_op_fcmp_oge() { "setae" } else { "setne" };
    lines = list_push(lines, "    " + set_op + " %r10b\n");
    if op == ssa_op_fcmp_une() {
        lines = list_push(lines, "    setp %r11b\n");
        lines = list_push(lines, "    orb %r11b, %r10b\n");
    } else {
        lines = list_push(lines, "    setnp %r11b\n");
        lines = list_push(lines, "    andb %r11b, %r10b\n");
    }
    lines = list_push(lines, "    movzbq %r10b, %r10\n");
    lines = list_push(lines, "    movq %r10, " + s_r + "\n");
    return lines;
}

pub fn x86_lower_sitofp_op(s_lh: String, s_r: String) -> List[String] {
    let mut lines: List[String] = list_new();
    lines = list_push(lines, "    cvtsi2sd " + s_lh + ", %xmm0\n");
    lines = list_push(lines, "    movsd %xmm0, " + s_r + "\n");
    return lines;
}

pub fn x86_lower_fptosi_op(s_lh: String, s_r: String) -> List[String] {
    let mut lines: List[String] = list_new();
    lines = list_push(lines, "    movsd " + s_lh + ", %xmm0\n");
    lines = list_push(lines, "    cvttsd2si %xmm0, %rax\n");
    lines = list_push(lines, "    movq %rax, " + s_r + "\n");
    return lines;
}

pub fn x86_lower_simd_op(op: Int, s_r: String, s_lh: String, s_imm: String) -> List[String] {
    return x86_lower_simd_inst(op, s_r, s_lh, s_imm);
}

