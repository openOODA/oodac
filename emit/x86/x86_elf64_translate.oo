// # ELF64 text plus rodata image
//
// Logline: Builds an ET_EXEC ELF64 with RX PT_LOAD text and R PT_LOAD rodata plus section headers.
//
// Setup: Pure byte transform. No GNU as or ld. ByteOut fail-closed.
//
// Beats:
//   1. Write ehdr with two program headers and four section headers.
//   2. Place text then rodata after 176-byte headers.
//   3. Bind e_entry to the text virtual address.
//   4. Fail closed on empty text.

import "types/byte_out.oo";

fn tr_le16(b: List[Int], v: Int) -> List[Int] {
    let mut o: List[Int] = list_push(b, v & 255);
    return list_push(o, (v / 256) & 255);
}

fn tr_le32(b: List[Int], v: Int) -> List[Int] {
    let mut o: List[Int] = list_push(b, v & 255);
    o = list_push(o, (v / 256) & 255);
    o = list_push(o, (v / 65536) & 255);
    return list_push(o, (v / 16777216) & 255);
}

fn tr_le64(b: List[Int], v: Int) -> List[Int] {
    let mut o: List[Int] = b;
    let mut x: Int = v;
    let mut i: Int = 0;
    while i < 8 { o = list_push(o, x & 255);
    x = x / 256;
    i = i + 1;
    }
    return o;
}

fn tr_cat(a: List[Int], src: List[Int]) -> List[Int] {
    let n: Int = list_len(src);
    let mut o: List[Int] = a;
    let mut i: Int = 0;
    while i < n { o = list_push(o, list_get(src, i) & 255);
    i = i + 1;
    }
    return o;
}

pub fn elf64_tr_hdr_len() -> Int {
    return 176;
}

pub fn elf64_tr_base() -> Int {
    return 4194304;
}

fn tr_ehdr(entry: Int, shoff: Int) -> List[Int] {
    let mut h: List[Int] = list_new();
    h = list_push(h, 127);
    h = list_push(h, 69);
    h = list_push(h, 76);
    h = list_push(h, 70);
    h = list_push(h, 2);
    h = list_push(h, 1);
    h = list_push(h, 1);
    let mut z: Int = 0;
    while z < 9 { h = list_push(h, 0);
    z = z + 1;
    }
    h = tr_le16(h, 2);
    h = tr_le16(h, 62);
    h = tr_le32(h, 1);
    h = tr_le64(h, entry);
    h = tr_le64(h, 64);
    h = tr_le64(h, shoff);
    h = tr_le32(h, 0);
    h = tr_le16(h, 64);
    h = tr_le16(h, 56);
    h = tr_le16(h, 2);
    h = tr_le16(h, 64);
    h = tr_le16(h, 4);
    h = tr_le16(h, 3);
    return h;
}

fn tr_phdr(off: Int, vaddr: Int, sz: Int, flags: Int, align: Int) -> List[Int] {
    let mut p: List[Int] = list_new();
    p = tr_le32(p, 1);
    p = tr_le32(p, flags);
    p = tr_le64(p, off);
    p = tr_le64(p, vaddr);
    p = tr_le64(p, vaddr);
    p = tr_le64(p, sz);
    p = tr_le64(p, sz);
    p = tr_le64(p, align);
    return p;
}

fn tr_shdr(name: Int, typ: Int, flags: Int, addr: Int, off: Int, sz: Int, align: Int) -> List[Int] {
    let mut s: List[Int] = list_new();
    s = tr_le32(s, name);
    s = tr_le32(s, typ);
    s = tr_le64(s, flags);
    s = tr_le64(s, addr);
    s = tr_le64(s, off);
    s = tr_le64(s, sz);
    s = tr_le32(s, 0);
    s = tr_le32(s, 0);
    s = tr_le64(s, align);
    s = tr_le64(s, 0);
    return s;
}

fn tr_shstr() -> List[Int] {
    let mut b: List[Int] = list_new();
    b = list_push(b, 0);
    b = list_push(b, 46);
    b = list_push(b, 116);
    b = list_push(b, 101);
    b = list_push(b, 120);
    b = list_push(b, 116);
    b = list_push(b, 0);
    b = list_push(b, 46);
    b = list_push(b, 114);
    b = list_push(b, 111);
    b = list_push(b, 100);
    b = list_push(b, 97);
    b = list_push(b, 116);
    b = list_push(b, 97);
    b = list_push(b, 0);
    b = list_push(b, 46);
    b = list_push(b, 115);
    b = list_push(b, 104);
    b = list_push(b, 115);
    b = list_push(b, 116);
    b = list_push(b, 114);
    b = list_push(b, 116);
    b = list_push(b, 97);
    b = list_push(b, 98);
    b = list_push(b, 0);
    return b;
}

fn tr_pad(b: List[Int], to: Int) -> List[Int] {
    let mut o: List[Int] = b;
    while list_len(o) < to { o = list_push(o, 0);
    }
    return o;
}

pub fn elf64_tr_package(text: List[Int], rodata: List[Int]) -> ByteOut {
    return elf64_tr_package_entry(text, rodata, 0);
}

pub fn elf64_tr_package_entry(text: List[Int], rodata: List[Int], entry_off: Int) -> ByteOut {
    let tn: Int = list_len(text);
if tn == 0 { return byte_out_err("elf64_tr: empty text");
}
    let rn: Int = list_len(rodata);
    let page: Int = 4096;
    let hdr: Int = 176;
    let base: Int = 4194304;
    let text_off: Int = page;
    let text_end: Int = text_off + tn;
    let ro_off: Int = ((text_end + page - 1) / page) * page;
    let text_va: Int = base + text_off;
    let entry: Int = text_va + entry_off;
    let ro_va: Int = base + ro_off;
    let str_off: Int = ro_off + rn;
    let shstr: List[Int] = tr_shstr();
    let sn: Int = list_len(shstr);
    let shoff: Int = str_off + sn;
    let text_filesz: Int = text_end;
    let mut img: List[Int] = tr_ehdr(entry, shoff);
    img = tr_cat(img, tr_phdr(0, base, text_filesz, 5, page));
    img = tr_cat(img, tr_phdr(ro_off, ro_va, rn, 4, page));
    img = tr_pad(img, text_off);
    img = tr_cat(img, text);
    img = tr_pad(img, ro_off);
    img = tr_cat(img, rodata);
    img = tr_cat(img, shstr);
    img = tr_cat(img, tr_shdr(0, 0, 0, 0, 0, 0, 0));
    img = tr_cat(img, tr_shdr(1, 1, 6, text_va, text_off, tn, 16));
    img = tr_cat(img, tr_shdr(7, 1, 2, ro_va, ro_off, rn, 1));
    img = tr_cat(img, tr_shdr(15, 3, 0, 0, str_off, sn, 1));
    return byte_out_ok(img);
}
