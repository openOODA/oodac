// # Poletto-Sarkar Linear Scan Register Allocator
//
// Logline: Allocates hardware registers RAX..R15 with active interval expiration, loop spill heuristics, and callee-saved preservation using parallel arrays.
//
// Setup: Core register allocator for the sovereign x86-64 native backend.
//
// Beats:
//   1. Sort live interval indices by start position.
//   2. Expire old active intervals whose end positions precede current start.
//   3. Allocate free physical registers prioritizing caller-saved scratch registers.
//   4. Spill to 16-byte aligned stack slots on register exhaustion with active eviction.

import "emit/llvm/ssa_ir.oo";
import "x86_reg_pool.oo";

import "x86_live_interval.oo";


pub type LinearScanResult = struct {
    vregs: List[Int],
    assigned_regs: List[Int],
    spill_slots: List[Int],
    spill_count: Int,
    used_callee_saved: List[Int]
};

fn x86_reg_contains(xs: List[Int], v: Int) -> Bool {
    let n: Int = list_len(xs); let mut i: Int = 0;
    while i < n { if list_get(xs, i) == v { return true; } i = i + 1; }
    return false;
}

pub fn x86_linear_scan_allocate(fn_node: SsaFunction, reg_pool: List[Int]) -> LinearScanResult {
    let ivs: LiveIntervals = x86_compute_live_intervals(fn_node);
    let n: Int = list_len(ivs.vregs);
    if n == 0 {
        let empty_v: List[Int] = list_new(); let empty_r: List[Int] = list_new();
        let empty_s: List[Int] = list_new(); let empty_c: List[Int] = list_new();
        let res: LinearScanResult = LinearScanResult { vregs: empty_v, assigned_regs: empty_r, spill_slots: empty_s, spill_count: 0, used_callee_saved: empty_c };
        return res;
    }

    let default_order: List[Int] = x86_reg_alloc_order();
    let mut alloc_order: List[Int] = default_order;
    if list_len(reg_pool) > 0 {
        let mut ordered_pool: List[Int] = list_new();
        let mut di: Int = 0;
        while di < list_len(default_order) {
            let dr: Int = list_get(default_order, di);
            if x86_reg_contains(reg_pool, dr) { ordered_pool = list_push(ordered_pool, dr); }
            di = di + 1;
        }
        alloc_order = ordered_pool;
    }

    // Sort interval indices by start position
    let mut sorted_indices: List[Int] = list_new(); let mut i: Int = 0;
    while i < n {
        let cur_start: Int = list_get(ivs.starts, i);
        let mut inserted: Bool = false; let mut new_sorted: List[Int] = list_new(); let mut j: Int = 0;
        while j < list_len(sorted_indices) {
            let item_idx: Int = list_get(sorted_indices, j);
            let item_start: Int = list_get(ivs.starts, item_idx);
            if !inserted && cur_start < item_start { new_sorted = list_push(new_sorted, i); inserted = true; }
            new_sorted = list_push(new_sorted, item_idx);
            j = j + 1;
        }
        if !inserted { new_sorted = list_push(new_sorted, i); }
        sorted_indices = new_sorted;
        i = i + 1;
    }

    let mut assigned: List[Int] = list_new(); let mut spills: List[Int] = list_new();
    i = 0; while i < n { assigned = list_push(assigned, -1); spills = list_push(spills, -1); i = i + 1; }

    let mut free_regs: List[Int] = list_new();
    let mut r: Int = 0; while r < 14 { free_regs = list_push(free_regs, 1); r = r + 1; }

    let mut active_indices: List[Int] = list_new();
    let mut used_callee: List[Int] = list_new();
    let mut next_spill_slot: Int = 0;

    let mut k: Int = 0;
    while k < n {
        let idx: Int = list_get(sorted_indices, k);
        let cur_start: Int = list_get(ivs.starts, idx);
        let cur_end: Int = list_get(ivs.ends, idx);
        let is_fix: Int = list_get(ivs.is_fixed, idx);
        let fix_r: Int = list_get(ivs.fixed_regs, idx);

        // 1. Expire old active intervals
        let mut new_active: List[Int] = list_new(); let mut a: Int = 0;
        while a < list_len(active_indices) {
            let act_idx: Int = list_get(active_indices, a);
            let act_end: Int = list_get(ivs.ends, act_idx);
            if act_end <= cur_start {
                let act_reg: Int = list_get(assigned, act_idx);
                if act_reg >= 0 && act_reg < 14 { free_regs = x86_rs_set(free_regs, act_reg, 1); }
            } else { new_active = list_push(new_active, act_idx); }
            a = a + 1;
        }
        active_indices = new_active;

        // 2. Allocate or spill
        if is_fix == 1 {
            // Evict conflicting active occupant if needed
            let mut a_fix: Int = 0; let mut evicted_act: Int = -1;
            while a_fix < list_len(active_indices) {
                let act_idx: Int = list_get(active_indices, a_fix);
                if list_get(assigned, act_idx) == fix_r { evicted_act = act_idx; }
                a_fix = a_fix + 1;
            }
            if evicted_act != -1 { let mut alt_reg: Int = -1; let mut order_i: Int = 0; while order_i < list_len(alloc_order) { let cand_r: Int = list_get(alloc_order, order_i); if cand_r != fix_r && cand_r >= 0 && cand_r < 14 && list_get(free_regs, cand_r) == 1 { alt_reg = cand_r; break; }
                    order_i = order_i + 1;
                }
                if alt_reg != -1 { assigned = x86_rs_set(assigned, evicted_act, alt_reg); free_regs = x86_rs_set(free_regs, alt_reg, 0); if x86_reg_is_callee_saved(alt_reg) && !x86_reg_contains(used_callee, alt_reg) { used_callee = list_push(used_callee, alt_reg); }
                } else {
                    assigned = x86_rs_set(assigned, evicted_act, -1);
                    spills = x86_rs_set(spills, evicted_act, next_spill_slot);
                    next_spill_slot = next_spill_slot + 1;
                    active_indices = x86_rs_remove(active_indices, evicted_act);
                }
            }
            assigned = x86_rs_set(assigned, idx, fix_r);
            if fix_r >= 0 && fix_r < 14 { free_regs = x86_rs_set(free_regs, fix_r, 0); if x86_reg_is_callee_saved(fix_r) && !x86_reg_contains(used_callee, fix_r) { used_callee = list_push(used_callee, fix_r); }
            }
            active_indices = list_push(active_indices, idx);
        } else {
            let mut allocated_reg: Int = -1; let mut order_i: Int = 0;
            while order_i < list_len(alloc_order) {
                let cand_r: Int = list_get(alloc_order, order_i);
                if cand_r >= 0 && cand_r < 14 && list_get(free_regs, cand_r) == 1 {
                    allocated_reg = cand_r;
                    break;
                }
                order_i = order_i + 1;
            }
            if allocated_reg != -1 { assigned = x86_rs_set(assigned, idx, allocated_reg); free_regs = x86_rs_set(free_regs, allocated_reg, 0); if x86_reg_is_callee_saved(allocated_reg) && !x86_reg_contains(used_callee, allocated_reg) { used_callee = list_push(used_callee, allocated_reg); }
                active_indices = list_push(active_indices, idx);
            } else {
                // Poletto-Sarkar spill_at_interval eviction
                let mut worst_act_idx: Int = -1; let mut worst_end: Int = cur_end; let mut wi: Int = 0;
                while wi < list_len(active_indices) {
                    let act_idx: Int = list_get(active_indices, wi);
                    let act_is_fixed: Int = list_get(ivs.is_fixed, act_idx);
                    let act_end: Int = list_get(ivs.ends, act_idx);
                    if act_is_fixed == 0 && act_end > worst_end { worst_end = act_end; worst_act_idx = act_idx; }
                    wi = wi + 1;
                }
                if worst_act_idx != -1 { let stolen_reg: Int = list_get(assigned, worst_act_idx); assigned = x86_rs_set(assigned, worst_act_idx, -1); spills = x86_rs_set(spills, worst_act_idx, next_spill_slot); next_spill_slot = next_spill_slot + 1; active_indices = x86_rs_remove(active_indices, worst_act_idx); assigned = x86_rs_set(assigned, idx, stolen_reg); if x86_reg_is_callee_saved(stolen_reg) && !x86_reg_contains(used_callee, stolen_reg) { used_callee = list_push(used_callee, stolen_reg); }
                    active_indices = list_push(active_indices, idx);
                } else {
                    assigned = x86_rs_set(assigned, idx, -1);
                    spills = x86_rs_set(spills, idx, next_spill_slot);
                    next_spill_slot = next_spill_slot + 1;
                }
            }
        }
        k = k + 1;
    }

    let res: LinearScanResult = LinearScanResult { vregs: ivs.vregs, assigned_regs: assigned, spill_slots: spills, spill_count: next_spill_slot, used_callee_saved: used_callee };
    return res;
}

pub fn x86_get_assigned_reg(res: LinearScanResult, vreg: Int) -> Int {
    let n: Int = list_len(res.vregs); let mut i: Int = 0;
    while i < n { if list_get(res.vregs, i) == vreg { return list_get(res.assigned_regs, i); } i = i + 1; }
    return -1;
}

pub fn x86_get_spill_slot(res: LinearScanResult, vreg: Int) -> Int {
    let n: Int = list_len(res.vregs); let mut i: Int = 0;
    while i < n { if list_get(res.vregs, i) == vreg { return list_get(res.spill_slots, i); } i = i + 1; }
    return -1;
}

pub fn x86_is_vreg_spilled(res: LinearScanResult, vreg: Int) -> Bool {
    return x86_get_assigned_reg(res, vreg) == -1;
}

fn x86_rs_set(xs: List[Int], idx: Int, val: Int) -> List[Int] {
    let n: Int = list_len(xs); let mut out: List[Int] = list_new(); let mut k: Int = 0;
    while k < n { if k == idx { out = list_push(out, val); } else { out = list_push(out, list_get(xs, k)); } k = k + 1; }
    return out;
}

fn x86_rs_remove(xs: List[Int], item: Int) -> List[Int] {
    let n: Int = list_len(xs); let mut out: List[Int] = list_new(); let mut k: Int = 0;
    while k < n { let v: Int = list_get(xs, k); if v != item { out = list_push(out, v); } k = k + 1; }
    return out;
}
