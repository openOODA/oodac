// # x86_64 SSA Compile Driver — Sovereign Direct
//
// Logline: Compiles .oo source to SysV AMD64 ELF64 assembly via tokenize, typed AST, SSA lowering, mem2reg, phi resolve, and register-allocated emission.
//
// Setup: Pure string transform, zero ambient caps. Imports token_fmt, ast_parse, ssa_ir/lower/mem2reg/opt, phi_resolve, ssa_fold_emit, ssa_strlit, ssa_emit. No filesystem or process authority.
//
// Beats:
//   1. Lower one SsaFunction with mem2reg and const-fold to AT&T assembly.
//   2. Compile single-function source via tokenize to SSA.
//   3. Compile program source via typed main lowering with fail-closed leftover and unhandled-call gates.
//   4. Expose string helpers for emit-x86 driver.
//



import "emit/llvm/ssa_ir.oo";
import "emit/llvm/ssa_lower.oo";
import "emit/llvm/ssa_mem2reg.oo";
import "emit/llvm/ssa_opt.oo";
import "x86_phi_resolve.oo";

import "x86_ssa_fold_emit.oo";

import "x86_ssa_strlit.oo";

import "x86_ssa_emit.oo";


pub type X86CompileResult = struct {
  ok: Bool,
  asm_code: String,
  err_msg: String
};

pub fn x86_compile_ok(asm_text: String) -> X86CompileResult {
  let res: X86CompileResult = X86CompileResult { ok: true, asm_code: asm_text, err_msg: "" };
  return res;
}

pub fn x86_compile_err(err: String) -> X86CompileResult {
  let res: X86CompileResult = X86CompileResult { ok: false, asm_code: "", err_msg: err };
  return res;
}

pub fn x86_ssa_compile_ssa(fn_data: SsaFunction) -> X86CompileResult {
    if fn_data.block_count == 0 { return x86_compile_err("ERR\tx86_ssa_compile\tssa_lowering_failed");
}
  let promoted: SsaFunction = ssa_mem2reg_promote(fn_data);
  let optimized: SsaFunction = ssa_opt_const_fold(promoted);
  let asm_text: String = x86_ssa_emit_function(optimized);
  if chars_len(asm_text) == 0 { return x86_compile_err("ERR\tx86_ssa_compile\tempty_asm");
  }
  return x86_compile_ok(asm_text);
}

pub fn x86_ssa_compile_source(src: String) -> X86CompileResult {
    if chars_len(src) == 0 { return x86_compile_err("ERR\tx86_ssa_compile\tempty_source");
}
  if chars_len(src) > 4194304 { return x86_compile_err("ERR\tx86_ssa_compile\tsource_too_large");
  }
  let toks: List[String] = tokenize_lines(src);
  if list_len(toks) == 0 { return x86_compile_err("ERR\tx86_ssa_compile\ttoken_collection_failed");
  }
  let ast_str: String = ast_parse_b(toks);
  if chars_len(ast_str) == 0 { return x86_compile_err("ERR\tx86_ssa_compile\tast_parse_empty");
  }
  let ssa_fn: SsaFunction = ssa_lower_ast(ast_str);
  return x86_ssa_compile_ssa(ssa_fn);
}

pub fn x86_ssa_compile_program(src: String) -> X86CompileResult {
    if chars_len(src) == 0 { return x86_compile_err("ERR\tx86_ssa_compile\tempty_source");
}
  if chars_len(src) > 4194304 { return x86_compile_err("ERR\tx86_ssa_compile\tsource_too_large");
  }
  let toks: List[String] = tokenize_lines(src);
  let ast_str: String = ast_parse_b(toks);
  if chars_len(ast_str) == 0 { return x86_compile_err("ERR\tx86_ssa_compile\tast_parse_empty");
  }
  if x86_src_leftover_unhandled(src) {
    return x86_compile_err("ERR\tx86_emit\tleftover");
  }
  let raw: SsaFunction = x86_ssa_lower_main_b(ast_str);
  if raw.block_count == 0 { return x86_compile_err("ERR\tx86_ssa_compile\tssa_lowering_failed");
  }
  if x86_ssa_has_unhandled_call_b(raw) {
    return x86_compile_err("ERR\tx86_emit\tunhandled_call");
  }
  let mut cur: SsaFunction = ssa_mem2reg_promote(raw);
  cur = x86_resolve_phi_nodes_with_raw(cur, raw);
  cur = ssa_opt_const_fold(cur);
  let pstrs: List[String] = x86_collect_println_strs(src);
  cur = x86_rewire_println_str(cur, pstrs);
  let mut acc: List[SsaFunction] = list_new();
  acc = list_push(acc, cur);
  let mut asm_text: String = x86_ssa_emit_program(acc);
  if list_len(pstrs) > 0 { asm_text = asm_text + x86_ssa_emit_rodata_strings(x86_println_str_pool(pstrs));
  }
  if chars_len(asm_text) == 0 { return x86_compile_err("ERR\tx86_ssa_compile\tempty_asm");
  }
  return x86_compile_ok(asm_text);
}

pub fn x86_ssa_compile_source_asm(src: String) -> String {
  let r: X86CompileResult = x86_ssa_compile_source(src);
  if r.ok { return r.asm_code;
  }
  return "";
}

pub fn x86_ssa_compile_program_asm(src: String) -> String {
  let r: X86CompileResult = x86_ssa_compile_program(src);
  if r.ok { return r.asm_code;
  }
  return "";
}
