// # Direct In-Process x86-64 ELF64 Binary Generator
//
// Logline: Generates raw executable Linux ELF64 binary files directly with zero external assembler or linker. Pure in-process: bytes are written through `write_file`, not through `sh`+`printf`.
//
// Setup: Pure OpenOODA byte stream generation; builds standalone ELF64 ET_EXEC executable. The pure path takes &FsWriteCap and uses write_file.
//
// Beats:
//   1. Build 64-byte ELF64 Header and 56-byte Program Header (PT_LOAD) — lane-only, no sh.
//   2. Encode raw x86_64 machine code (mov $1, %rax; mov $1, %rdi; mov $addr, %rsi; mov $len, %rdx; syscall).
//   3. Append rodata string payload and write executable binary directly to disk via write_file.
//   4. Pure in-process. No sh, no printf, no sys_exec.


import "x86_ssa_strlit.oo";


fn hex_byte(b: Int) -> String {
    let hex_chars: String = "0123456789abcdef";
let hi: Int = (b / 16) % 16;
let lo: Int = b % 16;
return char_at(hex_chars, hi) + char_at(hex_chars, lo);
}

fn hex_le32(n: Int) -> String {
    let b0: Int = n % 256;
let b1: Int = (n / 256) % 256;
let b2: Int = (n / 65536) % 256;
let b3: Int = (n / 16777216) % 256;
return hex_byte(b0) + hex_byte(b1) + hex_byte(b2) + hex_byte(b3);
}

fn hex_le64(n: Int) -> String {
    return hex_le32(n) + "00000000";
}

fn str_to_hex_nl(s: String) -> String {
    let n: Int = chars_len(s);
let mut out_hex: String = "";
let mut i: Int = 0;
while i < n { let b: Int = byte_at(s, i);
out_hex = out_hex + hex_byte(b);
i = i + 1;
}
    return out_hex + "0a";
}

fn x86_hex_to_octal(hex: String) -> String {
    let n: Int = chars_len(hex);
    let mut hs: List[Int] = list_new();
    let mut i: Int = 0;
    while i + 1 < n {
        let c0: Int = byte_at(hex, i);
        let c1: Int = byte_at(hex, i + 1);
        let hi: Int = if c0 >= 48 && c0 <= 57 { c0 - 48 } else if c0 >= 97 && c0 <= 102 { 10 + (c0 - 97) } else if c0 >= 65 && c0 <= 70 { 10 + (c0 - 65) } else { 0 };
        let lo: Int = if c1 >= 48 && c1 <= 57 { c1 - 48 } else if c1 >= 97 && c1 <= 102 { 10 + (c1 - 97) } else if c1 >= 65 && c1 <= 70 { 10 + (c1 - 65) } else { 0 };
        let b: Int = (hi * 16) + lo;
        hs = list_push(hs, 92);
        hs = list_push(hs, 48 + (((b / 64) % 8) & 7));
        hs = list_push(hs, 48 + (((b / 8) % 8) & 7));
        hs = list_push(hs, 48 + ((b % 8) & 7));
        i = i + 2;
    }
    return bytes_to_str(hs);
}

fn x86_hex_to_bytes(hex: String) -> List[Int] {
    let n: Int = chars_len(hex);
    let mut out_bytes: List[Int] = list_new();
    let mut i: Int = 0;
    while i + 1 < n {
        let c0: Int = byte_at(hex, i);
        let c1: Int = byte_at(hex, i + 1);
        let hi: Int = if c0 >= 48 && c0 <= 57 { c0 - 48 } else if c0 >= 97 && c0 <= 102 { 10 + (c0 - 97) } else if c0 >= 65 && c0 <= 70 { 10 + (c0 - 65) } else { 0 };
        let lo: Int = if c1 >= 48 && c1 <= 57 { c1 - 48 } else if c1 >= 97 && c1 <= 102 { 10 + (c1 - 97) } else if c1 >= 65 && c1 <= 70 { 10 + (c1 - 65) } else { 0 };
        out_bytes = list_push(out_bytes, (hi * 16) + lo);
        i = i + 2;
    }
    return out_bytes;
}

pub fn x86_match_direct_elf(src: String) -> Bool {
    let toks: List[String] = tokenize_lines(src);
let n = list_len(toks);
let mut i = 0;
while i < n { if x86_tok_k(toks, i) == "STRING" && x86_tok_t(toks, i) == "Direct ELF OK" { return true;
}
        i = i + 1;
    }
    return false;
}

pub fn x86_emit_direct_elf_binary_pure(fs: &FsWriteCap, src: String, out_path: String) -> Bool {
    let mut msgs: List[String] = x86_collect_println_strs(src);
    if list_len(msgs) == 0 { msgs = list_push(msgs, "");
    }
    let n_msgs: Int = list_len(msgs);
    let code_per_msg: Int = 27;
    let exit_code_len: Int = 10;
    let total_code_len: Int = (n_msgs * code_per_msg) + exit_code_len;
    let mut data_hex: String = "";
    let mut data_len: Int = 0;
    let mut str_offsets: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n_msgs { str_offsets = list_push(str_offsets, data_len);
    let s: String = list_get(msgs, i);
    let slen: Int = chars_len(s) + 1;
    data_len = data_len + slen;
    data_hex = data_hex + str_to_hex_nl(s);
    i = i + 1;
    }
    let total_file_size: Int = 120 + total_code_len + data_len;
    let data_base_vaddr: Int = 4194304 + 120 + total_code_len;
    let ehdr: String = "7f454c4602010100000000000000000002003e000100000078004000000000004000000000000000000000000000000000000000400038000100000000000000";
    let filesz_hex: String = hex_le64(total_file_size);
    let memsz_hex: String = hex_le64(total_file_size);
    let phdr: String = "0100000007000000000000000000000000004000000000000000400000000000" + filesz_hex + memsz_hex + "0010000000000000";
    let mut code_hex: String = "";
    i = 0;
    while i < n_msgs { let s: String = list_get(msgs, i);
    let slen: Int = chars_len(s) + 1;
    let str_vaddr: Int = data_base_vaddr + list_get(str_offsets, i);
    let str_vaddr_hex: String = hex_le64(str_vaddr);
    let slen_hex: String = hex_le32(slen);
    code_hex = code_hex + "b801000000bf0100000048be" + str_vaddr_hex + "ba" + slen_hex + "0f05";
    i = i + 1;
    }
    code_hex = code_hex + "b83c0000004831ff0f05";
    let all_hex: String = ehdr + phdr + code_hex + data_hex;
    let bytes: List[Int] = x86_hex_to_bytes(all_hex);
    let binary: String = bytes_to_str(bytes);
    let r: Result[Void, String] = write_file(fs, out_path, binary);
    if r.is_err() { return false;
    }
    return true;
}

pub fn x86_emit_direct_elf_binary_pure_e(fs: &FsWriteCap, src: String, out_path: String) -> Bool {
    return x86_emit_direct_elf_binary_pure(fs, src, out_path);
}

pub fn x86_emit_direct_elf(out_path: String) {
    println("# openOODA direct ELF64 generator");
}
