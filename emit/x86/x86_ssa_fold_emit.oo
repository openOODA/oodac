// # SSA builders for x86-64 lowering
//
// Logline: Lowers AstFn main and detects leftover call opcode 46.
//
// Setup: ssa_lower builders with self-contained AST helpers. Imported by x86_ssa_compile.
//
// Beats:
//   1. x86_ssa_lower_main finds main not first AstFn.
//   2. x86_ssa_has_unhandled_call is leftover fail-closed.
//   3. Maintain <= 256 lines limit.

import "emit/llvm/ssa_ir.oo";
import "emit/llvm/ssa_lower.oo";

fn ast_tag(node: String) -> String {
    let n: Int = chars_len(node);
    let mut i: Int = 0;
    while i < n {
        if char_at(node, i) == "(" {
            return str_slice(node, 0, i);
        }
        i = i + 1;
    }
    return node;
}

fn ast_is(node: String, tag: String) -> Bool {
    return ast_tag(node) == tag;
}

fn x86_ast_inner(node: String) -> String {
    let n: Int = chars_len(node);
    let mut depth: Int = 0;
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut hit: Bool = false;
    while i < n {
        let c: String = char_at(node, i);
        if c == "(" {
            if depth == 0 { start = i + 1; hit = true; }
            depth = depth + 1;
        }
        if c == ")" {
            depth = depth - 1;
            if depth == 0 && hit { return str_slice(node, start, i); }
        }
        i = i + 1;
    }
    return "";
}

fn x86_ast_collect_fns(ast_str: String) -> List[String] {
    let mut fns: List[String] = list_new();
    if ast_tag(ast_str) != "AstFile" { return fns; }
    let items: String = x86_ast_inner(ast_str);
    let n: Int = 0 + list_len_str(items);
    let mut i: Int = 0;
    while i < n {
        let item: String = list_get_str(items, i);
        if ast_is(item, "AstFn") { fns = list_push(fns, item); }
        i = i + 1;
    }
    return fns;
}

fn x86_ast_fn_by_name(fns: List[String], name: String) -> String {
    let n: Int = list_len(fns);
    let mut i: Int = 0;
    while i < n {
        let f: String = list_get(fns, i);
        if list_get_str(x86_ast_inner(f), 0) == name { return f; }
        i = i + 1;
    }
    return "";
}

pub fn x86_ssa_lower_main_b(ast_str: String) -> SsaFunction {
    if ast_tag(ast_str) != "AstFile" {
        return ssa_lower_ast(ast_str);
    }
    let fns: List[String] = x86_ast_collect_fns(ast_str);
    let main_fn: String = x86_ast_fn_by_name(fns, "main");
    if main_fn == "" {
        return ssa_lower_fn("main", 0, "");
    }
    let fargs: String = x86_ast_inner(main_fn);
    let n_f: Int = 0 + list_len_str(fargs);
    let body: String = if n_f >= 1 { list_get_str(fargs, n_f - 1) } else { "" };
    return ssa_lower_fn("main", 1, body);
}

pub fn x86_ssa_has_unhandled_call_b(fn_data: SsaFunction) -> Bool {
    let ops: List[Int] = fn_data.inst_opcodes;
    let n: Int = list_len(ops);
    let mut i: Int = 0;
    while i < n {
        if list_get(ops, i) == 46 {
            return true;
        }
        i = i + 1;
    }
    return false;
}
