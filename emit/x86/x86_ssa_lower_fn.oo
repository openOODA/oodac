// # x86-64 SSA Function & System V AMD64 Parameter Lowerer
//
// Logline: Binds incoming System V AMD64 ABI argument registers (RDI..R9) to alloca parameter slots and lowers multi-argument function calls.
//
// Setup: Integrates with oodac/x86_ssa_lower_ops.oo, oodac/x86_abi_classify.oo, and oodac/x86_abi_sret.oo.
//
// Beats:
//   1. Identify function parameters and bind incoming RDI..R9 registers into alloca slots.
//   2. Lower multi-argument function calls into System V AMD64 register setups and call instructions.
//   3. Manage caller and callee SRet hidden pointer mechanisms for aggregate returns.
//   4. Export x86 SSA function lowering and parameter setup routines.

import "emit/llvm/ssa_ir.oo";
import "x86_reg_pool.oo";

import "x86_regalloc_scan.oo";

import "x86_abi_classify.oo";

import "x86_abi_sret.oo";

import "x86_ssa_lower_ops.oo";


pub fn x86_sysv_arg_reg(i: Int) -> String {
    if i == 0 { return "%rdi";
    }
    if i == 1 { return "%rsi";
    }
    if i == 2 { return "%rdx";
    }
    if i == 3 { return "%rcx";
    }
    if i == 4 { return "%r8";
    }
    if i == 5 { return "%r9";
    }
    return "";
}

pub fn x86_bind_incoming_params_sret(param_count: Int, param_slots: List[String], has_sret: Bool) -> List[String] {
    let mut lines: List[String] = list_new();
    let offset: Int = if has_sret { 1 } else { 0 };
    let mut i: Int = 0;
    while i < param_count && (i + offset) < 6 && i < list_len(param_slots) {
        let r_name: String = x86_sysv_arg_reg(i + offset);
        let dest_slot: String = list_get(param_slots, i);
        if chars_len(dest_slot) > 0 && dest_slot != r_name { lines = list_push(lines, "    movq " + r_name + ", " + dest_slot + "\n");
        }
        i = i + 1;
    }
    return lines;
}

pub fn x86_bind_incoming_params(param_count: Int, param_slots: List[String]) -> List[String] {
    return x86_bind_incoming_params_sret(param_count, param_slots, false);
}

pub fn x86_lower_call_symbol_sret(callee_name: String, arg_slots: List[String], ret_slot: String, has_sret: Bool, sret_buf: String) -> List[String] {
    let mut lines: List[String] = list_new();
    let offset: Int = if has_sret { 1 } else { 0 };
    if has_sret && chars_len(sret_buf) > 0 { lines = list_push(lines, "    leaq " + sret_buf + ", %rdi\n");
    }
    let n_args: Int = list_len(arg_slots);
    let mut i: Int = 0;
    while i < n_args && (i + offset) < 6 { let arg_src: String = list_get(arg_slots, i);
    let target_reg: String = x86_sysv_arg_reg(i + offset);
    if arg_src != target_reg && chars_len(arg_src) > 0 { lines = list_push(lines, "    movq " + arg_src + ", " + target_reg + "\n");
    }
        i = i + 1;
    }
    if chars_len(callee_name) > 0 { lines = list_push(lines, "    call " + callee_name + "\n");
    }
    if chars_len(ret_slot) > 0 && ret_slot != "%rax" {
        lines = list_push(lines, "    movq %rax, " + ret_slot + "\n");
    }
    return lines;
}

pub fn x86_lower_call_symbol(callee_name: String, arg_slots: List[String], ret_slot: String) -> List[String] {
    return x86_lower_call_symbol_sret(callee_name, arg_slots, ret_slot, false, "");
}

fn x86_fn_slot_offset(spill_idx: Int, n_callee: Int) -> Int {
    let callee_bytes: Int = n_callee * 8;
return -8 - callee_bytes - (spill_idx * 8);
}

pub fn x86_param_operand(r: Int, alloc_res: LinearScanResult, n_callee: Int) -> String {
    if r <= 0 { return "";
    }
    let v_list: List[Int] = alloc_res.vregs;
    let n: Int = list_len(v_list);
    let mut i: Int = 0;
    while i < n {
        if list_get(v_list, i) == r {
            let pr: Int = list_get(alloc_res.assigned_regs, i);
            if pr >= 0 { return x86_reg_name(pr);
            }
            let sp: Int = list_get(alloc_res.spill_slots, i);
            if sp >= 0 { let off: Int = 0 + x86_fn_slot_offset(sp, n_callee);
            return off.to_string() + "(%rbp)";
            }
        }
        i = i + 1;
    }
    let default_off: Int = -8 - (n_callee * 8) - (r * 8);
    return default_off.to_string() + "(%rbp)";
}

pub fn x86_count_entry_allocas(fn_node: SsaFunction) -> Int {
    let n: Int = list_len(fn_node.inst_opcodes);
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if list_get(fn_node.inst_block_ids, i) == 0 {
            let op: Int = list_get(fn_node.inst_opcodes, i);
            if op == ssa_op_alloca() { count = count + 1;
            }
        }
        i = i + 1;
    }
    return count;
}

pub fn x86_get_entry_alloca_slots(fn_node: SsaFunction, alloc_res: LinearScanResult, n_callee: Int) -> List[String] {
    let mut slots: List[String] = list_new();
    let n: Int = list_len(fn_node.inst_opcodes);
    let mut i: Int = 0;
    while i < n { if list_get(fn_node.inst_block_ids, i) == 0 { let op: Int = list_get(fn_node.inst_opcodes, i);
    if op == ssa_op_alloca() { let r: Int = list_get(fn_node.inst_results, i);
    let s_r: String = x86_param_operand(r, alloc_res, n_callee);
    slots = list_push(slots, s_r);
    }
        }
        i = i + 1;
    }
    return slots;
}

pub fn x86_emit_param_bindings(fn_node: SsaFunction, alloc_res: LinearScanResult, n_callee: Int) -> List[String] {
    let alloca_slots: List[String] = x86_get_entry_alloca_slots(fn_node, alloc_res, n_callee);
    let param_count: Int = list_len(alloca_slots);
    return x86_bind_incoming_params(param_count, alloca_slots);
}
