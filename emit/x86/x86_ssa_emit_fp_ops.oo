// # x86-64 SSA Floating Point Instruction Format Lowerer
//
// Logline: Formats SSA floating point arithmetic (25-29), comparison (30-35), and conversion (44-45) opcodes into AT&T SSE2 instructions.
//
// Setup: Pure SSA instruction emission helper module for the openOODA x86-64 backend.
//
// Beats:
//   1. Format float scalar arithmetic (addsd, subsd, mulsd, divsd, frem).
//   2. Format float ordered and unordered comparisons with condition flag decoding (ucomisd).
//   3. Format integer-to-float and float-to-integer conversion instructions (cvtsi2sd, cvttsd2si).

pub fn x86_ssa_format_fp_inst(op: Int, s: String, sl: String, s2: String) -> String {
    if op == 25 { return "movsd " + sl + ", %xmm0\n    addsd " + s2 + ", %xmm0\n    movsd %xmm0, " + s;
}
    if op == 26 { return "movsd " + sl + ", %xmm0\n    subsd " + s2 + ", %xmm0\n    movsd %xmm0, " + s;
    }
    if op == 27 { return "movsd " + sl + ", %xmm0\n    mulsd " + s2 + ", %xmm0\n    movsd %xmm0, " + s;
    }
    if op == 28 { return "movsd " + sl + ", %xmm0\n    divsd " + s2 + ", %xmm0\n    movsd %xmm0, " + s;
    }
    if op == 29 { return "movsd " + sl + ", %xmm0\n    movsd " + s2 + ", %xmm1\n    movsd %xmm0, %xmm2\n    divsd %xmm1, %xmm2\n    cvttsd2si %xmm2, %rax\n    cvtsi2sd %rax, %xmm2\n    mulsd %xmm1, %xmm2\n    subsd %xmm2, %xmm0\n    movsd %xmm0, " + s;
    }
    if op == 30 { return "movsd " + sl + ", %xmm0\n    ucomisd " + s2 + ", %xmm0\n    sete %al\n    setnp %dl\n    andb %dl, %al\n    movzbq %al, %rax\n    movq %rax, " + s;
    }
    if op == 31 { return "movsd " + sl + ", %xmm0\n    ucomisd " + s2 + ", %xmm0\n    setb %al\n    setnp %dl\n    andb %dl, %al\n    movzbq %al, %rax\n    movq %rax, " + s;
    }
    if op == 32 { return "movsd " + sl + ", %xmm0\n    ucomisd " + s2 + ", %xmm0\n    setbe %al\n    setnp %dl\n    andb %dl, %al\n    movzbq %al, %rax\n    movq %rax, " + s;
    }
    if op == 33 { return "movsd " + sl + ", %xmm0\n    ucomisd " + s2 + ", %xmm0\n    seta %al\n    setnp %dl\n    andb %dl, %al\n    movzbq %al, %rax\n    movq %rax, " + s;
    }
    if op == 34 { return "movsd " + sl + ", %xmm0\n    ucomisd " + s2 + ", %xmm0\n    setae %al\n    setnp %dl\n    andb %dl, %al\n    movzbq %al, %rax\n    movq %rax, " + s;
    }
    if op == 35 { return "movsd " + sl + ", %xmm0\n    ucomisd " + s2 + ", %xmm0\n    setne %al\n    setp %dl\n    orb %dl, %al\n    movzbq %al, %rax\n    movq %rax, " + s;
    }
    if op == 44 { return "cvtsi2sd " + sl + ", %xmm0\n    movsd %xmm0, " + s;
    }
    if op == 45 { return "movsd " + sl + ", %xmm0\n    cvttsd2si %xmm0, %rax\n    movq %rax, " + s;
    }
    return "";
}
