// # ROCm call dispatch on pre-evaluated args
//
// Logline: User, list, constructor, gpu, device, and string calls.
//
// Setup: Args arrive pre-lowered as tab packs (rc_call_args in
// rocm_expr.oo evaluates them; the entry wrapper keeps evaluation
// order). Hints thread let annotations into nested constructors.
// String ops lower through std::string. println lives in rocm_expr.oo.
//
// Beats:
//   1. rc_call_with_args routes nine call kinds with fail-closed arity and types.
//   2. Constructor hints derive from the outer result or option annotation.

import "rocm_tok.oo";
import "rocm_ty.oo";
import "rocm_buf.oo";
import "rocm_call.oo";
import "rocm_kernel.oo";
import "rocm_device.oo";
import "rocm_str.oo";
import "lex/token_parse_int.oo";

pub fn rc_call_with_args(toks: List[String], name: String, info: String, argstr: String, env: String, fns: String, hint: String, capv: String, line: Int) -> String {
    let endp: Int = rc_span_end(info);
    let nargs: Int = rc_span_nargs(info);
    let kind: Int = rc_call_kind(name);
    if kind == 1 {
        if nargs == 0 && hint == "li" { return rc_e_pack(endp + 1, "li", "std::vector<long long>()"); }
        if nargs == 0 && hint == "lf" { return rc_e_pack(endp + 1, "lf", "std::vector<double>()"); }
        rc_fail(line, "list_new needs a typed let");
        return "0\t?\t";
    }
    if kind == 2 {
        rc_fail(line, "push is a statement");
        return "0\t?\t";
    }
    if kind == 3 {
        let r: String = rc_apply_list(name, argstr, nargs, line);
        return rc_e_pack(endp + 1, rc_e_ty(r), rc_e_code(r));
    }
    if kind == 4 {
        let r2: String = rc_apply_ctor(name, argstr, nargs, hint, line);
        return rc_e_pack(endp + 1, rc_e_ty(r2), rc_e_code(r2));
    }
    if kind == 5 {
        if name == "gpu_hip_vec_add" && rc_k(toks, rc_span_start(info, 3)) != "IDENT" {
            rc_fail(line, "vec_add output needs a variable");
            return "0\t?\t";
        }
        if name == "gpu_copy_d2h" && rc_k(toks, rc_span_start(info, 1)) != "IDENT" {
            rc_fail(line, "copy_d2h output needs a variable");
            return "0\t?\t";
        }
        let r3: String = rc_gpu_call(name, argstr, nargs, capv, line);
        return rc_e_pack(endp + 1, rc_e_ty(r3), rc_e_code(r3));
    }
    if kind == 6 {
        let r4: String = rc_dev_call(name, argstr, nargs, capv, line);
        return rc_e_pack(endp + 1, rc_e_ty(r4), rc_e_code(r4));
    }
    if kind == 8 {
        let r5: String = rc_apply_str(name, argstr, nargs, line);
        return rc_e_pack(endp + 1, rc_e_ty(r5), rc_e_code(r5));
    }
    let r6: String = rc_apply_user(name, argstr, nargs, fns, line);
    return rc_e_pack(endp + 1, rc_e_ty(r6), rc_e_code(r6));
}


