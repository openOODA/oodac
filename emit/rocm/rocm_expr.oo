// # ROCm typed expression lowering
//
// Logline: Climb parser from tokens to typed C++ expressions with packs.
//
// Setup: Packs carry end pos, type code, and C++ text. No logic ops in v1.
//
// Beats:
//   1. Compare, add, mul, unary, and primary levels dispatch on kinds.
//   2. rc_call routes list, gpu, constructor, and user calls with hints.
//   3. Int division guards zero and fails closed at run time.

import "rocm_tok.oo";
import "rocm_ty.oo";
import "rocm_buf.oo";
import "rocm_call.oo";
import "rocm_kernel.oo";
import "rocm_device.oo";
import "rocm_expr_call.oo";
import "rocm_field.oo";
import "rocm_match.oo";
import "lex/token_parse_int.oo";

pub fn rc_expr(toks: List[String], pos: Int, n: Int, env: String, fns: String, hint: String, capv: String) -> String {
    return rc_expr_logic(toks, pos, n, env, fns, hint, capv);
}

pub fn rc_expr_logic(toks: List[String], pos: Int, n: Int, env: String, fns: String, hint: String, capv: String) -> String {
    let mut r: String = rc_expr_cmp(toks, pos, n, env, fns, hint, capv);
    let mut p: Int = rc_e_pos(r);
    let mut lt: String = rc_e_ty(r);
    let mut lc: String = rc_e_code(r);
    while p < n {
        let k: String = rc_k(toks, p);
        if k != "ANDAND" && k != "OROR" { return r; }
        let sym: String = if k == "ANDAND" { "&&" } else { "||" };
        let q: String = rc_expr_cmp(toks, p + 1, n, env, fns, hint, capv);
        p = rc_e_pos(q);
        if lt != "b" || rc_e_ty(q) != "b" {
            rc_fail(rc_line(toks, p), "logic needs bools");
            return "0\t?\t";
        }
        lc = "((" + lc + ") " + sym + " (" + rc_e_code(q) + "))";
        lt = "b";
        r = rc_e_pack(p, lt, lc);
    }
    return r;
}

pub fn rc_expr_cmp(toks: List[String], pos: Int, n: Int, env: String, fns: String, hint: String, capv: String) -> String {
    let l: String = rc_expr_add(toks, pos, n, env, fns, hint, capv);
    let mut p: Int = rc_e_pos(l);
    let k: String = rc_k(toks, p);
    if k != "EQEQ" && k != "NEQ" && k != "LT" && k != "GT" && k != "LTE" && k != "GTE" { return l; }
    let q: String = rc_expr_add(toks, p + 1, n, env, fns, hint, capv);
    p = rc_e_pos(q);
    let lt: String = rc_e_ty(l);
    let rt: String = rc_e_ty(q);
    let sym: String = rc_cmp_sym(k);
    if k == "EQEQ" || k == "NEQ" {
        if lt == "s" && rt == "s" { return rc_e_pack(p, "b", "((" + rc_e_code(l) + ") " + sym + " (" + rc_e_code(q) + "))"); }
        if lt == "b" && rt == "b" { return rc_e_pack(p, "b", "((" + rc_e_code(l) + ") " + sym + " (" + rc_e_code(q) + "))"); }
    }
    let want: String = rc_num2(lt, rt);
    if want == "" {
        rc_fail(rc_line(toks, p), "compare type mismatch");
        return "0\t?\t";
    }
    if rc_k(toks, p) == "EQEQ" || rc_k(toks, p) == "NEQ" || rc_k(toks, p) == "LT" || rc_k(toks, p) == "GT" || rc_k(toks, p) == "LTE" || rc_k(toks, p) == "GTE" {
        rc_fail(rc_line(toks, p), "chained compare");
        return "0\t?\t";
    }
    return rc_e_pack(p, "b", "((" + rc_prom(rc_e_code(l), lt, want) + ") " + sym + " (" + rc_prom(rc_e_code(q), rt, want) + "))");
}

fn rc_cmp_sym(k: String) -> String {
    if k == "EQEQ" { return "=="; }
    if k == "NEQ" { return "!="; }
    if k == "LT" { return "<"; }
    if k == "GT" { return ">"; }
    if k == "LTE" { return "<="; }
    return ">=";
}

pub fn rc_expr_add(toks: List[String], pos: Int, n: Int, env: String, fns: String, hint: String, capv: String) -> String {
    let mut r: String = rc_expr_mul(toks, pos, n, env, fns, hint, capv);
    let mut p: Int = rc_e_pos(r);
    let mut lt: String = rc_e_ty(r);
    let mut lc: String = rc_e_code(r);
    while p < n {
        let k: String = rc_k(toks, p);
        if k != "PLUS" && k != "MINUS" { return r; }
        if k == "PLUS" && lt == "s" {
            let q0: String = rc_expr_mul(toks, p + 1, n, env, fns, hint, capv);
            p = rc_e_pos(q0);
            if rc_e_ty(q0) != "s" {
                rc_fail(rc_line(toks, p), "concat needs strings");
                return "0\t?\t";
            }
            lc = "((" + lc + ") + (" + rc_e_code(q0) + "))";
            lt = "s";
            r = rc_e_pack(p, lt, lc);
            continue;
        }
        let sym: String = if k == "PLUS" { "+" } else { "-" };
        let q: String = rc_expr_mul(toks, p + 1, n, env, fns, hint, capv);
        p = rc_e_pos(q);
        let want: String = rc_num2(lt, rc_e_ty(q));
        if want == "" {
            rc_fail(rc_line(toks, p), "arith type mismatch");
            return "0\t?\t";
        }
        lc = "((" + rc_prom(lc, lt, want) + ") " + sym + " (" + rc_prom(rc_e_code(q), rc_e_ty(q), want) + "))";
        lt = want;
        r = rc_e_pack(p, lt, lc);
    }
    return r;
}

pub fn rc_expr_mul(toks: List[String], pos: Int, n: Int, env: String, fns: String, hint: String, capv: String) -> String {
    let mut r: String = rc_expr_unary(toks, pos, n, env, fns, hint, capv);
    let mut p: Int = rc_e_pos(r);
    let mut lt: String = rc_e_ty(r);
    let mut lc: String = rc_e_code(r);
    while p < n {
        let k: String = rc_k(toks, p);
        if k != "STAR" && k != "SLASH" && k != "PERCENT" { return r; }
        let q: String = rc_expr_unary(toks, p + 1, n, env, fns, hint, capv);
        p = rc_e_pos(q);
        let want: String = rc_num2(lt, rc_e_ty(q));
        if want == "" {
            rc_fail(rc_line(toks, p), "arith type mismatch");
            return "0\t?\t";
        }
        let lz: String = "(" + rc_prom(lc, lt, want) + ")";
        let rz: String = "(" + rc_prom(rc_e_code(q), rc_e_ty(q), want) + ")";
        if k == "STAR" { lc = "(" + lz + " * " + rz + ")"; }
        if k == "SLASH" { lc = rc_div_code(lz, rz, want, rc_line(toks, p)); }
        if k == "PERCENT" {
            if want != "i" {
                rc_fail(rc_line(toks, p), "percent needs ints");
                return "0\t?\t";
            }
            lc = rc_mod_code(lz, rz, rc_line(toks, p));
        }
        lt = want;
        r = rc_e_pack(p, lt, lc);
    }
    return r;
}

fn rc_div_code(lz: String, rz: String, want: String, line: Int) -> String {
    if want == "f" { return "(" + lz + " / " + rz + ")"; }
    let bad: String = "(fprintf(stderr, \"ERR\\trocm\\tdiv zero at line " + line.to_string() + "\\n\"), exit(1), (long long)0)";
    return "((" + rz + " == 0) ? " + bad + " : (" + lz + " / " + rz + "))";
}

fn rc_mod_code(lz: String, rz: String, line: Int) -> String {
    let bad: String = "(fprintf(stderr, \"ERR\\trocm\\tdiv zero at line " + line.to_string() + "\\n\"), exit(1), (long long)0)";
    return "((" + rz + " == 0) ? " + bad + " : (" + lz + " % " + rz + "))";
}

pub fn rc_expr_unary(toks: List[String], pos: Int, n: Int, env: String, fns: String, hint: String, capv: String) -> String {
    if pos < n && rc_k(toks, pos) == "MINUS" {
        let r: String = rc_expr_unary(toks, pos + 1, n, env, fns, hint, capv);
        if rc_e_ty(r) != "i" && rc_e_ty(r) != "f" {
            rc_fail(rc_line(toks, pos), "negate needs a number");
            return "0\t?\t";
        }
        return rc_e_pack(rc_e_pos(r), rc_e_ty(r), "(-(" + rc_e_code(r) + "))");
    }
    if pos < n && rc_k(toks, pos) == "BANG" {
        let r2: String = rc_expr_unary(toks, pos + 1, n, env, fns, hint, capv);
        if rc_e_ty(r2) != "b" {
            rc_fail(rc_line(toks, pos), "not needs a bool");
            return "0\t?\t";
        }
        return rc_e_pack(rc_e_pos(r2), "b", "(!(" + rc_e_code(r2) + "))");
    }
    return rc_expr_postfix(toks, pos, n, env, fns, hint, capv);
}

pub fn rc_expr_postfix(toks: List[String], pos: Int, n: Int, env: String, fns: String, hint: String, capv: String) -> String {
    let r: String = rc_expr_primary(toks, pos, n, env, fns, hint, capv);
    if rc_k(toks, rc_e_pos(r)) != "DOT" {
        return r;
    }
    return rc_field(toks, pos, n, env, fns, r, capv);
}

pub fn rc_expr_primary(toks: List[String], pos: Int, n: Int, env: String, fns: String, hint: String, capv: String) -> String {
    let k: String = rc_k(toks, pos);
    if k == "INT" { return rc_e_pack(pos + 1, "i", "((long long)" + rc_t(toks, pos) + ")"); }
    if k == "FLOAT" { return rc_e_pack(pos + 1, "f", "((double)" + rc_t(toks, pos) + ")"); }
    if k == "STRING" { return rc_e_pack(pos + 1, "s", "std::string(\"" + rc_c_esc(rc_t(toks, pos)) + "\")"); }
    if k == "KW_TRUE" { return rc_e_pack(pos + 1, "b", "true"); }
    if k == "KW_FALSE" { return rc_e_pack(pos + 1, "b", "false"); }
    if k == "LPAREN" {
        let r: String = rc_expr(toks, pos + 1, n, env, fns, hint, capv);
        if rc_k(toks, rc_e_pos(r)) != "RPAREN" {
            rc_fail(rc_line(toks, pos), "missing rparen");
            return "0\t?\t";
        }
        return rc_e_pack(rc_e_pos(r) + 1, rc_e_ty(r), "(" + rc_e_code(r) + ")");
    }
    if k == "IDENT" {
        if rc_k(toks, pos + 1) == "LPAREN" { return rc_call(toks, pos, n, env, fns, hint, capv); }
        let got: String = rc_env_get(env, rc_t(toks, pos));
        if got == "" {
            rc_fail(rc_line(toks, pos), "unknown var " + rc_t(toks, pos));
            return "0\t?\t";
        }
        return rc_e_pack(pos + 1, got, rc_var(rc_t(toks, pos)));
    }
    if k == "KW_MATCH" {
        return rc_match_expr(toks, pos, n, env, fns, hint, capv);
    }
    rc_fail(rc_line(toks, pos), "bad expression");
    return "0\t?\t";
}


