// # Skip a line comment / Skip whitespace and line comments
//
// Logline: Walks from the two slashes to the next newline or the end of source and returns the packed index and column. If the cursor sits on space, tab, newline, or a // line comment, consume it and pack a SKIP step.
//
// Setup: Merged cohesive compiler module.
//
// Beats:
//   1. Unified cohesive implementation.

pub fn lex_skip_line_comment(src: String, pos: Int, n: Int, col: Int) -> List[Int] {
    let mut i = pos + 2;
    let mut c = col + 2;
    let mut cont_c = true;
    while cont_c { if i >= n { cont_c = false;
    } else {
            let c2 = char_at(src, i);
            if c2 == "\n" {
                cont_c = false;
            } else {
                i = i + 1;
                c = c + 1;
            }
        }
    }
    let mut res: List[Int] = list_new();
    res = list_push(res, i);
    res = list_push(res, c);
    return res;
}

pub fn pack_skip(i: Int, line: Int, col: Int) -> List[String] {
    let mut r: List[String] = list_new();
    r = list_push(r, "SKIP");
    r = list_push(r, i.to_string());
    r = list_push(r, line.to_string());
    r = list_push(r, col.to_string());
    return r;
}

pub fn pack_tok(i: Int, line: Int, col: Int, kind: String, text: String, sl: Int, sc: Int) -> List[String] {
    let mut r: List[String] = list_new();
    r = list_push(r, "TOK");
    r = list_push(r, i.to_string());
    r = list_push(r, line.to_string());
    r = list_push(r, col.to_string());
    r = list_push(r, kind);
    r = list_push(r, text);
    r = list_push(r, sl.to_string());
    r = list_push(r, sc.to_string());
    return r;
}

pub fn pack_err(msg: String) -> List[String] {
    let mut r: List[String] = list_new();
    r = list_push(r, "ERR");
    r = list_push(r, msg);
    return r;
}

pub fn try_scan_ws(src: String, i0: Int, line0: Int, col0: Int) -> List[String] {
    let n = chars_len(src);
    if i0 >= n { return list_new();
    }
    let ch = char_at(src, i0);
    let mut i = i0;
    let mut line = line0;
    let mut col = col0;
    if ch == " " || ch == "\t" {
        while i < n { let w = char_at(src, i);
        if w == " " || w == "\t" { i = i + 1;
        col = col + 1;
        } else {
                break;
            }
        }
        return pack_skip(i, line, col);
    }
    if ch == "\n" {
        i = i + 1;
        line = line + 1;
        col = 1;
        return pack_skip(i, line, col);
    }
    if ch == "/" {
        let j = i + 1;
        if j < n { if char_at(src, j) == "/" { i = i + 2;
        col = col + 2;
        let mut cont_c = true;
        while cont_c { if i >= n { cont_c = false;
        } else {
                        if char_at(src, i) == "\n" {
                            cont_c = false;
                        } else {
                            i = i + 1;
                            col = col + 1;
                        }
                    }
                }
                return pack_skip(i, line, col);
            }
        }
    }
    return list_new();
}
