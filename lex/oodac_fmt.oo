// # OODAC Formatter ◈ ZERO-DRAG
//
// Logline: Checks 2-space, => radar, |> 80-col, and blank line.
//
// Setup: Pure formatter, no caps for check.
//
// Beats:
//   1. Scan indent for tabs and odd spaces.
//   2. Check arrow column uniformity per pattern.
//   3. Check |> desugar and 80-col.

// ──▓▓ Sovereign Lattice ── FMT ──▓▓──
// :: 2-space · => radar · |> OODA ::

pub fn fmt_check_2space(src: String) -> Bool {
    let n: Int = chars_len(src);
let mut i: Int = 0;
let mut col: Int = 0;
let mut at_line_start: Bool = true;
while i < n { let c: String = char_at(src, i);
if c == "\n" { at_line_start = true;
col = 0;
} else if at_line_start { if c == "\t" { return false;
}
    if c == " " {
    col = col + 1;
    } else {
    if col % 2 != 0 {
      return false;
    }
    at_line_start = false;
    }
  }
  i = i + 1;
  }
  return true;
}

pub fn fmt_check_arrow(src: String) -> Bool {
    let n: Int = chars_len(src);
let mut i: Int = 0;
let mut line_idx: Int = 0;
let mut col: Int = 0;
let mut expect: Int = -1;
let mut in_match: Bool = false;
let mut line_start: Int = 0;
while i < n { let c: String = char_at(src, i);
if c == "\n" { let line_len: Int = i - line_start;
let mut k: Int = 0;
let mut has_match: Bool = false;
let mut arrow_col: Int = -1;
let mut p: Int = line_start;
while p < i { if p + 4 < i { let a: String = char_at(src, p);
let b: String = char_at(src, p + 1);
let d: String = char_at(src, p + 2);
let e: String = char_at(src, p + 3);
let f: String = char_at(src, p + 4);
if a == "m" && b == "a" { if d == "t" && e == "c" && f == "h" { has_match = true;
}
      }
    }
    if char_at(src, p) == "=" {
      if p + 1 < i { if char_at(src, p + 1) == ">" { arrow_col = p - line_start;
      }
      }
    }
    p = p + 1;
    }
    if has_match { in_match = true;
    expect = -1;
    }
    if arrow_col >= 0 && in_match { if expect == -1 { expect = arrow_col;
    } else if arrow_col != expect { return false;
    }
    }
    if line_len == 0 {  }
    if char_at(src, line_start) == "}" {
    in_match = false;
    expect = -1;
    }
    line_start = i + 1;
    line_idx = line_idx + 1;
    col = 0;
  } else {
    col = col + 1;
  }
  i = i + 1;
  }
  return true;
}

pub fn fmt_check_pipeline(src: String) -> Bool {
    let n: Int = chars_len(src);
let mut i: Int = 0;
let mut depth: Int = 0;
let mut line_has_let: Bool = false;
while i < n { let c: String = char_at(src, i);
if c == "\n" { depth = 0;
line_has_let = false;
}
  if c == "|" {
    if i + 1 < n { if char_at(src, i + 1) == ">" { let mut before_ok: Bool = false;
    if i > 0 { if char_at(src, i - 1) == " " { before_ok = true;
    }
      if char_at(src, i - 1) == "\n" {
        before_ok = true;
      }
      }
      let mut after_ok: Bool = false;
      if i + 2 < n { let ac: String = char_at(src, i + 2);
      if ac == " " || ac == "\n" { after_ok = true;
      }
      } else {
      after_ok = true;
      }
      if !before_ok || !after_ok { return false;
      }
      depth = depth + 1;
      if depth > 2 && !line_has_let { let mut scan: Int = i;
      let mut found_let: Bool = false;
      let mut s: Int = 0;
      while s < 80 && scan >= 0 { if scan + 2 < n { if char_at(src, scan) == "l" { if char_at(src, scan + 1) == "e" { if char_at(src, scan + 2) == "t" { found_let = true;
      }
          }
        }
        }
        scan = scan - 1;
        s = s + 1;
      }
      if !found_let { return false;
      }
      depth = 0;
      }
      i = i + 1;
    }
    }
  }
  if c == "l" {
    if i + 2 < n { if char_at(src, i + 1) == "e" { if char_at(src, i + 2) == "t" { line_has_let = true;
    depth = 0;
    }
    }
    }
  }
  i = i + 1;
  }
  return true;
}

pub fn fmt_check_width(src: String) -> Bool {
    let n: Int = chars_len(src);
let mut i: Int = 0;
let mut col: Int = 0;
let mut line_no: Int = 0;
while i < n { let c: String = char_at(src, i);
if c == "\n" { if line_no >= 6 { if col > 80 { return false;
}
    }
    col = 0;
    line_no = line_no + 1;
  } else {
    col = col + 1;
  }
  i = i + 1;
  }
  if line_no >= 6 && col > 80 { return false;
  }
  return true;
}

pub fn fmt_check_blank(src: String) -> Bool {
    let n: Int = chars_len(src);
let mut i: Int = 0;
let mut consec: Int = 0;
while i < n { let c: String = char_at(src, i);
if c == "\n" { consec = consec + 1;
if consec > 2 { return false;
}
  } else {
    consec = 0;
  }
  i = i + 1;
  }
  return true;
}

pub fn fmt_check_all(src: String) -> Bool {
    if !fmt_check_2space(src) { return false;
}
  if !fmt_check_arrow(src) {
  return false;
  }
  if !fmt_check_pipeline(src) {
  return false;
  }
  if !fmt_check_width(src) {
  return false;
  }
  if !fmt_check_blank(src) {
  return false;
  }
  return true;
}
