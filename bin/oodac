#!/bin/bash
SCRIPT_PATH=$(readlink -f "${BASH_SOURCE[0]:-$0}" 2>/dev/null || realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null || echo "${BASH_SOURCE[0]:-$0}")
DIR=$(cd "$(dirname "$SCRIPT_PATH")" && pwd)
CORE="$DIR/oodac_bin.core"
export OODAC_BIN="$DIR/oodac"
export OODA_COMPILER="$DIR/oodac"
export OODA_BIN="$DIR/oodac"
export OODA_REPO_ROOT="${OODA_REPO_ROOT:-$(cd "$DIR/.." && pwd)}"
export OODA_SRC_ROOT="${OODA_SRC_ROOT:-$OODA_REPO_ROOT}"
if [[ ! -x "$CORE" ]]; then
  echo "oodac: missing compiler core at $CORE" >&2
  exit 127
fi
export OODA_FS_READDIR="${OODA_FS_READDIR:-$(cd "$DIR/../.." && pwd)}"
export OODA_FS_WRITEDIR="${OODA_FS_WRITEDIR:-$(pwd)}"
export OO_LIST_AMBIENT_QUOTA="${OO_LIST_AMBIENT_QUOTA:-1073741824}"
if [[ "$1" == "emit-preamble" && -z "$2" ]]; then
  set -- "$1" "$DIR/../main.oo"
fi
for arg in "$@"; do
  if [[ "$arg" == "--json-errors" || "$arg" == "-json" ]]; then
    export OODA_JSON_ERRORS=1
    break
  fi
done
if [[ -n "${OODA_JSON_ERRORS:-}" ]]; then
  for arg in "$@"; do
    if [[ "$arg" == *.oo && -f "$arg" ]]; then
      export OODA_JSON_PATH="$arg"
      break
    fi
  done
fi
exec "$CORE" "$@"
