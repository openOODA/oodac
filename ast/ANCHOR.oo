// ──▓▓ Sovereign Lattice ── AST ANCHOR ──▓▓──
// :: public: parse_expr, parse_stmt, parse_file ::

pub fn parse_expr(src: String) -> String {
    return parse_expr_inner(src);
}

pub fn parse_stmt(src: String) -> String {
    return parse_stmt_inner(src);
}

pub fn parse_file(src: String) -> String {
    return parse_file_inner(src);
}

pub fn ast_dump(src: String) {
    dump_ast_from_src(src);
}

pub fn ast_load_imports(fs: &FsReadCap, path: String) -> String {
    return load_source_with_imports(fs, path);
}

pub fn ast_expand_macros(src: String) -> String {
    return macro_expand(src);
}

