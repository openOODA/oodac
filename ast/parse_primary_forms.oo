// # Dump Literal Primaries / Dump paren match if primaries
//
// Logline: Print an EXPR LIT line for INT, STRING, true, or false at pos0 and return the next token, or return -1. Dump a parenthesized, match, or if primary and return the next pos, or -1.
//
// Setup: Merged cohesive compiler module.
//
// Beats:
//   1. Unified cohesive implementation.

pub fn parse_primary_try_lit(toks: List[String], pos0: Int, depth: Int) -> Int {
    let pos = pos0;
let pad: String = indent(depth);
let k: String = field_at(list_get(toks, pos), 0);
let line: String = field_at(list_get(toks, pos), 1);
let col: String = field_at(list_get(toks, pos), 2);
let text: String = field_at(list_get(toks, pos), 3);
if k == "INT" { println(pad + "EXPR LIT int:" + text + " @" + line + ":" + col);
return pos + 1;
}
    if k == "STRING" {
        println(pad + "EXPR LIT str:" + escape_dump(text) + " @" + line + ":" + col);
        return pos + 1;
    }
    if k == "KW_TRUE" {
        println(pad + "EXPR LIT bool:true @" + line + ":" + col);
        return pos + 1;
    }
    if k == "KW_FALSE" {
        println(pad + "EXPR LIT bool:false @" + line + ":" + col);
        return pos + 1;
    }
    return -1;
}

pub fn parse_primary_try_form(toks: List[String], pos0: Int, depth: Int) -> Int {
    let n = list_len(toks);
let mut pos = pos0;
let pad: String = indent(depth);
let k: String = field_at(list_get(toks, pos), 0);
let line: String = field_at(list_get(toks, pos), 1);
let col: String = field_at(list_get(toks, pos), 2);
let text: String = field_at(list_get(toks, pos), 3);
if k == "LPAREN" { pos = pos + 1;
pos = parse_expr_dump(toks, pos, depth);
if field_at(list_get(toks, pos), 0) == "RPAREN" { pos = pos + 1;
}
        return pos;
    }
    if k == "KW_MATCH" {
        let ml = line;
        let mc = col;
        pos = pos + 1;
        let mut scan_pos = 0 + skip_expr_bp(toks, pos, 0);
        if field_at(list_get(toks, scan_pos), 0) == "LBRACE" {
            scan_pos = scan_pos + 1;
        }
        let mut arms = 0;
        let mut depth_b = 1;
        let mut cont_m = true;
        while cont_m {
            if scan_pos >= n { cont_m = false;
            }
            else {
                let sk: String = field_at(list_get(toks, scan_pos), 0);
                if sk == "LBRACE" { depth_b = depth_b + 1;
                }
                if sk == "RBRACE" {
                    depth_b = depth_b - 1;
                    if depth_b == 0 { cont_m = false;
                    }
                }
                if sk == "FATARROW" {
                    if depth_b == 1 { arms = arms + 1;
                    }
                }
                scan_pos = scan_pos + 1;
            }
        }
        let arms_s: String = arms.to_string();
        println(pad + "EXPR MATCH arms=" + arms_s + " @" + ml + ":" + mc);

        pos = parse_expr_dump(toks, pos, depth + 1);
        if field_at(list_get(toks, pos), 0) == "LBRACE" {
            pos = pos + 1;
        }
        let mut ai = 0;
        while ai < arms {
            let pat: String = field_at(list_get(toks, pos), 3);
            pos = pos + 1;
            let mut arg = "";
            if field_at(list_get(toks, pos), 0) == "LPAREN" {
                pos = pos + 1;
                arg = field_at(list_get(toks, pos), 3);
                pos = pos + 1;
                if field_at(list_get(toks, pos), 0) == "RPAREN" { pos = pos + 1;
                }
            }
            let ais: String = ai.to_string();
            if arg == "" {
                println(pad + "ARM[" + ais + "] pat=" + pat);
            } else {
                println(pad + "ARM[" + ais + "] pat=var:" + pat + "(" + arg + ")");
            }
            if field_at(list_get(toks, pos), 0) == "FATARROW" { pos = pos + 1;
            }
            pos = parse_expr_dump(toks, pos, depth + 1);
            if field_at(list_get(toks, pos), 0) == "COMMA" { pos = pos + 1;
            }
            ai = ai + 1;
        }
        if field_at(list_get(toks, pos), 0) == "RBRACE" { pos = pos + 1;
        }
        return pos;
    }
    if k == "KW_IF" {
        let il = line;
        let ic = col;
        pos = pos + 1;
        println(pad + "EXPR IF @" + il + ":" + ic);
        pos = parse_expr_dump(toks, pos, depth + 1);
        pos = parse_block_dump(toks, pos, depth + 1);
        if pos < n { if field_at(list_get(toks, pos), 0) == "KW_ELSE" { pos = pos + 1;
        println(pad + "ELSE");
        if field_at(list_get(toks, pos), 0) == "KW_IF" { pos = parse_expr_dump(toks, pos, depth + 1);
        } else {
                    pos = parse_block_dump(toks, pos, depth + 1);
                }
            }
        }
        return pos;
    }
    return -1;
}
