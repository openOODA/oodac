#!/usr/bin/env bash
# Why not .oo: this starts gcc and the seed (first compiler). RULES 1.13 host exception.
# job: official in-repo pure multi-module oodac rebuild (emit each .oo, link once)
# in:  <main.oo> <out_bin>
# out: native binary via emit-c + gcc + oodar.c + host_rt (compiler self-host).
#      Product `oodac build` links the same oodar.c. unique_fns is awk, not Python.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WS_ROOT="$(cd "$ROOT/.." && pwd)"
# Hermetic FS jail: default to WS_ROOT if not set, so new binary can read both ooda and std sources
export OODA_FS_READDIR="$WS_ROOT"
export OODA_FS_WRITEDIR="$WS_ROOT"
export OO_LIST_AMBIENT_QUOTA="${OO_LIST_AMBIENT_QUOTA:-1073741824}"
oodac_abs() {
  local p="$1"
  if [[ -e "$p" ]]; then
    echo "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
  elif [[ -d "$(dirname "$p")" ]]; then
    echo "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
  else
    echo "$p"
  fi
}
SOVEREIGN_BACKEND="${OODA_BACKEND:-${BOOTSTRAP_BACKEND:-}}"
FIXED_POINT="${BOOTSTRAP_FIXED_POINT:-1}"
USE_GCC="${OODAC_USE_GCC:-0}"

ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --backend)
      SOVEREIGN_BACKEND="$2"
      shift 2
      ;;
    --backend=*)
      SOVEREIGN_BACKEND="${1#--backend=}"
      shift
      ;;
    --sovereign)
      USE_GCC=0
      shift
      ;;
    --gcc|--use-gcc)
      USE_GCC=1
      shift
      ;;
    --fixed-point)
      FIXED_POINT=1
      shift
      ;;
    --no-fixed-point)
      FIXED_POINT=0
      shift
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ ${#ARGS[@]} -lt 2 ]]; then
  echo "usage: oodac_pure_build [--backend <target>] [--fixed-point] <main.oo> <out_bin>" >&2
  exit 2
fi

MAIN="$(oodac_abs "${ARGS[0]}")"
OUT="$(oodac_abs "${ARGS[1]}")"

if [[ -z "$SOVEREIGN_BACKEND" ]]; then
  UNAME_M="$(uname -m 2>/dev/null || echo x86_64)"
  UNAME_S="$(uname -s 2>/dev/null || echo Linux)"
  # REDTEAM: the emit-x86/emit-aarch64 direct native paths cannot self-host
  # oodac (Result[T] and struct types exceed the 24-arm chain). Default to
  # the battle-tested C99 path and let users opt in to direct native backends.
  if [[ "$UNAME_S" == "Darwin" ]]; then
    SOVEREIGN_BACKEND="c"
  elif [[ "$UNAME_M" == "aarch64" || "$UNAME_M" == "arm64" ]]; then
    SOVEREIGN_BACKEND="c"
  else
    SOVEREIGN_BACKEND="c"
  fi
fi
OODAC_BIN="${OODAC_BIN:-$ROOT/bin/oodac_bin.core}"
if [[ ! -x "$OODAC_BIN" ]]; then
  if [[ -x "$ROOT/bin/oodac_bin.core" ]]; then OODAC_BIN="$ROOT/bin/oodac_bin.core"
  elif [[ -x "$ROOT/bin/oodac" ]]; then OODAC_BIN="$ROOT/bin/oodac"
  elif [[ -x "$ROOT/bootstrap/seed/oodac" ]]; then OODAC_BIN="$ROOT/bootstrap/seed/oodac"
  else echo "ERR_NO_OODAC" >&2; exit 1; fi
fi
oodac_is_cli() {
  grep -a -q 'pure .oo product CLI' "$1" 2>/dev/null
}
oodac_is_compiler() {
  grep -a -q 'oodac: usage:' "$1" 2>/dev/null
}
# bin/ooda copied onto oodac/oodac execs itself on check (fork bomb).
if oodac_is_cli "$OODAC_BIN"; then
  echo "ERR_OODAC_IS_CLI $OODAC_BIN" >&2
  exit 1
fi
TMP="${TMPDIR:-/tmp}/oodac_pure_$$"
mkdir -p "$TMP"
if [[ ! -f "$MAIN" && -f "$ROOT/$MAIN" ]]; then MAIN="$ROOT/$MAIN"; fi
if [[ ! -f "$MAIN" ]]; then echo "ERR_MISSING $MAIN" >&2; exit 1; fi
DIR="$(cd "$(dirname "$MAIN")" && pwd)"
BASE="$(basename "$MAIN")"
MAIN_ABS="$DIR/$BASE"
# Collect modules (DFS, cycle/missing fail-closed). Order: deps first, main last.
MODS=()
declare -A SEEN=()
declare -A STACK=()
collect() {
  local path="$1"
  local abs
  if [[ "$path" = /* ]]; then abs="$path"
  else abs="$(cd "$(dirname "$path")" 2>/dev/null && pwd || echo "${dir:-$ROOT}")/$(basename "$path")"
  fi
  if [[ -d "$abs" && -f "$abs/ANCHOR.oo" ]]; then
    abs="$abs/ANCHOR.oo"
  fi
  if [[ ! -f "$abs" ]]; then
    echo "ERR_MISSING $abs" >&2
    exit 1
  fi
  abs="$(cd "$(dirname "$abs")" && pwd)/$(basename "$abs")"
  if [[ -n "${STACK[$abs]:-}" ]]; then
    # P4.43 / c_emit: c_emit_block.oo <-> c_emit_stmt.oo is a known intentional cycle.
    # Still walk imports on first visit; only suppress the cycle fail.
    if [[ "${PURE_OO_ALLOW_CYCLE_BLOCK:-0}" == "1" ]] && [[ "$abs" == *"/c_emit_block.oo" || "$abs" == *"/c_emit_stmt.oo" ]]; then
      return 0
    fi
    echo "ERR_IMPORT_CYCLE $abs" >&2
    exit 1
  fi
  if [[ -n "${SEEN[$abs]:-}" ]]; then return 0; fi
  STACK[$abs]=1
  local dir
  dir="$(cd "$(dirname "$abs")" && pwd)"
  local imp
  while IFS= read -r imp; do
    [[ -z "$imp" ]] && continue
    if [[ "$imp" = /* ]]; then
      if [[ -f "$imp" ]]; then collect "$imp"
      elif [[ -f "$imp/ANCHOR.oo" ]]; then collect "$imp/ANCHOR.oo"
      else echo "ERR_MISSING $imp" >&2; exit 1; fi
    elif [[ "$imp" != std/* && "$imp" != oodac/* && -f "$dir/$imp" ]]; then
      collect "$dir/$imp"
    elif [[ "$imp" != std/* && "$imp" != oodac/* && -f "$dir/$imp/ANCHOR.oo" ]]; then
      collect "$dir/$imp/ANCHOR.oo"
    elif [[ -f "$ROOT/$imp" ]]; then
      collect "$ROOT/$imp"
    elif [[ -f "$ROOT/$imp/ANCHOR.oo" ]]; then
      collect "$ROOT/$imp/ANCHOR.oo"
    elif [[ "$imp" == std/* && -f "$ROOT/$imp" ]]; then
      collect "$ROOT/$imp"
    elif [[ "$imp" == std/* && -f "$ROOT/$imp/ANCHOR.oo" ]]; then
      collect "$ROOT/$imp/ANCHOR.oo"
    elif [[ "$imp" == std/* && -f "$WS_ROOT/$imp" ]]; then
      collect "$WS_ROOT/$imp"
    elif [[ "$imp" == std/* && -f "$WS_ROOT/$imp/ANCHOR.oo" ]]; then
      collect "$WS_ROOT/$imp/ANCHOR.oo"
    elif [[ -f "$ROOT/std/$imp" ]]; then
      collect "$ROOT/std/$imp"
    elif [[ -f "$ROOT/std/$imp/ANCHOR.oo" ]]; then
      collect "$ROOT/std/$imp/ANCHOR.oo"
    elif [[ "$imp" == oodac/* && -f "$WS_ROOT/$imp" ]]; then
      collect "$WS_ROOT/$imp"
    elif [[ "$imp" == oodac/* && -f "$WS_ROOT/$imp/ANCHOR.oo" ]]; then
      collect "$WS_ROOT/$imp/ANCHOR.oo"
    elif [[ -f "$ROOT/oodac/$imp" ]]; then
      collect "$ROOT/oodac/$imp"
    elif [[ -f "$ROOT/oodac/$imp/ANCHOR.oo" ]]; then
      collect "$ROOT/oodac/$imp/ANCHOR.oo"
    elif [[ -f "$WS_ROOT/$imp" ]]; then
      collect "$WS_ROOT/$imp"
    elif [[ -f "$WS_ROOT/$imp/ANCHOR.oo" ]]; then
      collect "$WS_ROOT/$imp/ANCHOR.oo"
    else
      echo "ERR_MISSING $dir/$imp" >&2
      exit 1
    fi
  done < <(grep -E '^import "' "$abs" 2>/dev/null | sed -n 's/^import "\(.*\)";.*/\1/p' || true)
  unset "STACK[$abs]"
  SEEN[$abs]=1
  MODS+=("$abs")
}
collect "$MAIN_ABS"

# Same tree → same input_fp. Not a bit-identical product binary claim.
PURE_INPUT_FP="$(
  {
    for src in "${MODS[@]}"; do
      if [[ "$src" == "$ROOT/"* ]]; then
        rel="${src#"$ROOT"/}"
      else
        rel="$(basename "$src")"
      fi
      printf '%s\0' "$rel"
      cat -- "$src"
    done
  } | sha256sum | awk '{print $1}'
)"
echo "pure_build: input_fp=$PURE_INPUT_FP"
if [[ -n "${PURE_BUILD_FP_OUT:-}" ]]; then
  printf '%s\n' "$PURE_INPUT_FP" >"$PURE_BUILD_FP_OUT"
fi

# Check gate unless PURE_SKIP_CHECK=1. Official path leaves that unset.
if [[ "${PURE_SKIP_CHECK:-}" != "1" ]]; then
  nmods=${#MODS[@]}
  # Small trees: 60+2*nmods, cap 180s. Large nmods (oodac/main.oo ~218):
  # cold check exceeds 900s on this host; 180s cannot finish.
  ck_to=$((60 + nmods * 2))
  if [[ $nmods -gt 80 ]]; then
    ck_to=1800
  elif [[ $ck_to -gt 180 ]]; then
    ck_to=180
  fi
  run_main_check() {
    echo "pure_build: check host=$OODAC_BIN nmods=$nmods timeout=${ck_to}s"
    mkdir -p "$TMP"
    # Drop leftover art files so seed vs OODAART2 hosts cannot mix magics.
    rm -f "$ROOT/.ooda-cache/ooda-tmp/art_"*.art
    rm -f "$WS_ROOT/.ooda-cache/ooda-tmp/art_"*.art
    set +e
    (cd "$ROOT" && timeout "$ck_to" "$OODAC_BIN" check "$MAIN_ABS") >"$TMP/main_check.out" 2>"$TMP/main_check.err"
    main_ck=$?
    set -e
  }
  run_main_check
  if [[ $main_ck -eq 124 ]]; then
    echo "ERR_CHECK_TIMEOUT $MAIN_ABS (nmods=$nmods timeout=${ck_to}s)" >&2
    exit 1
  fi
  if [[ $main_ck -ne 0 ]]; then
    echo "ERR_CHECK $MAIN_ABS" >&2
    cat "$TMP/main_check.err" "$TMP/main_check.out" >&2 || true
    exit 1
  fi
fi

if [[ "$USE_GCC" != "1" && "$SOVEREIGN_BACKEND" != "c" ]]; then
  echo "pure_build: sovereign in-process bootstrap ($SOVEREIGN_BACKEND, zero GCC/Clang seed)"

  # Stage 1 self-compilation (S0 -> S1)
  STAGE1_BIN="$TMP/stage1_oodac"
  echo "pure_build: stage 1 self-compilation via $OODAC_BIN..."
  mkdir -p "$(dirname "$STAGE1_BIN")"
  "$OODAC_BIN" build --backend "$SOVEREIGN_BACKEND" "$MAIN_ABS" -o "$STAGE1_BIN"
  chmod +x "$STAGE1_BIN"
  STAGE1_HASH="$(sha256sum "$STAGE1_BIN" | awk '{print $1}')"
  echo "pure_build: stage1_hash=$STAGE1_HASH (zero external toolchains)"

  if [[ "$FIXED_POINT" == "1" ]]; then
    STAGE2_BIN="$TMP/stage2_oodac"
    BUILD_HOST="$OODAC_BIN"
    if oodac_is_compiler "$STAGE1_BIN"; then
      BUILD_HOST="$STAGE1_BIN"
      echo "pure_build: stage 2 fixed-point self-compilation via stage1..."
    else
      echo "pure_build: stage 2 deterministic reproduction compilation..."
    fi
    "$BUILD_HOST" build --backend "$SOVEREIGN_BACKEND" "$MAIN_ABS" -o "$STAGE2_BIN"
    chmod +x "$STAGE2_BIN"
    STAGE2_HASH="$(sha256sum "$STAGE2_BIN" | awk '{print $1}')"
    echo "pure_build: stage2_hash=$STAGE2_HASH (self-compilation fixed point)"

    if [[ "$STAGE1_HASH" != "$STAGE2_HASH" ]]; then
      echo "ERR_FIXED_POINT_DIVERGENCE $STAGE1_HASH != $STAGE2_HASH" >&2
      rm -rf "$TMP"
      exit 1
    fi
    echo "pure_build: fixed_point_verified (S1 == S2, hash=$STAGE1_HASH)"
    mkdir -p "$(dirname "$OUT")"
    cp -f "$STAGE2_BIN" "$OUT"
  else
    mkdir -p "$(dirname "$OUT")"
    cp -f "$STAGE1_BIN" "$OUT"
  fi

  chmod +x "$OUT"
  test -x "$OUT"
  echo "pure_build: sovereign_build_complete ($OUT)"
  echo "pure_build: input_fp=$PURE_INPUT_FP"
  echo OK_PURE_SOVEREIGN
  echo OK_PURE_MULTI
  rm -rf "$TMP"
  exit 0
fi

FN_DEF='^(static[[:space:]]+inline[[:space:]]+|static[[:space:]]+|inline[[:space:]]+)?(void|int|long long|double|float|bool|char|OoStr|OoSList|OoIList|OoFList|OoResS|OoResV|OoResI|OoResB|OoResF|CapToken|[A-Za-z_][A-Za-z0-9_]*)[[:space:]]+[A-Za-z0-9_].*\)[[:space:]]*\{'
EMIT_CACHE="${OODAC_EMIT_CACHE:-$ROOT/.ooda-cache/oodac_emit}"
mkdir -p "$EMIT_CACHE" "$TMP"
MCS=()
emit_skip=0
for src in "${MODS[@]}"; do
  mc="$TMP/$(echo "$src" | tr '/.' '__').c"
  src_hash="$(sha256sum -- "$src" | awk '{print $1}')"
  cache_c="$EMIT_CACHE/${src_hash}.c"
  if [[ -s "$cache_c" ]] && grep -qE "$FN_DEF" "$cache_c" && ! grep -qE $'^ERR\tc_emit' "$cache_c"; then
    cp -f "$cache_c" "$mc"
    emit_skip=$((emit_skip + 1))
  else
    emit_one() {
      (cd "$ROOT" && OODA_EMIT_NO_CONCAT=1 EMIT_NO_CONCAT=1 timeout 1800 "$OODAC_BIN" emit-c "$1")
    }
    emit_one "$src" >"$mc" || true
    if grep -qE $'^ERR\temit\tno artifact' "$mc"; then
      rel="${src#"$ROOT"/}"
      (cd "$ROOT" && timeout 180 "$OODAC_BIN" check "$src") >/dev/null 2>&1 || true
      emit_one "$src" >"$mc" || true
      if grep -qE $'^ERR\temit\tno artifact' "$mc" && [[ "$rel" != "$src" ]]; then
        (cd "$ROOT" && timeout 180 "$OODAC_BIN" check "$rel") >/dev/null 2>&1 || true
        emit_one "$rel" >"$mc" || true
      fi
    fi
    if [[ -s "$mc" ]] && grep -qE "$FN_DEF" "$mc" && ! grep -qE $'^ERR\tc_emit' "$mc"; then
      mkdir -p "$EMIT_CACHE"
      cat "$mc" > "$cache_c" 2>/dev/null || true
    fi
  fi
  if [[ ! -s "$mc" ]] || ! grep -qE "$FN_DEF" "$mc"; then
    echo "ERR_EMIT $src (size: $(wc -c < "$mc") bytes, grep match: $(grep -cE "$FN_DEF" "$mc"))" >&2
    head -n 25 "$mc" >&2 || true
    exit 1
  fi
  if grep -qE $'^ERR\tc_emit' "$mc"; then
    echo "ERR_EMIT_LINE $src" >&2
    /usr/bin/grep -E $'^ERR\tc_emit' "$mc" >&2 || true
    exit 1
  fi
  src_lines=$(wc -l < "$src")
  mc_bytes=$(wc -c < "$mc")
  if [[ "$src_lines" -lt 300 && "$mc_bytes" -gt 200000 ]]; then
    echo "ERR_EMIT_CONCAT_DUMP $src lines=$src_lines bytes=$mc_bytes" >&2
    exit 1
  fi
  MCS+=("$mc")
done
echo "pure_build: emit_cache skip=$emit_skip of ${#MODS[@]}"

awk '/^(#line 1 "|#ifndef OO_FN_|[A-Za-z_][A-Za-z0-9_]*[[:space:]]+[A-Za-z0-9_]+\([^;]*\)[[:space:]]*\{)/{exit} {print}' "${MCS[0]}" >"$TMP/preamble.c"
if ! grep -q '<stdint.h>' "$TMP/preamble.c"; then
  sed -i '1i #include <stdint.h>' "$TMP/preamble.c"
fi
# unique_fns without Python: first OO_FN_ body wins; prototypes first; type
# ifndef blocks merge into the shared preamble so later TUs see TypedArtifact.
: > "$TMP/protos.c"
: > "$TMP/bodies.c"
awk -v proto_path="$TMP/protos.c" -v body_path="$TMP/bodies.c" -v pre_path="$TMP/preamble.c" '
function is_if(s) { return s ~ /^[[:space:]]*#(if|ifdef|ifndef)[[:space:]]/ }
function is_endif(s) { return s ~ /^[[:space:]]*#endif/ }
function start(kind, name, line) {
  blk_kind = kind; blk_name = name; blk = line "\n"; depth = 1
}
BEGIN { blk_kind = ""; nfn = 0 }
FNR == 1 { in_main = 0 }
{
  if (blk_kind != "") {
    blk = blk $0 "\n"
    if (is_if($0)) depth++
    if (is_endif($0)) {
      depth--
      if (depth == 0) {
        if (blk_kind == "fn") {
          if (!(blk_name in seen_fn) && blk ~ /\{/ && blk ~ /\}/) {
            seen_fn[blk_name] = 1
            fn_order[++nfn] = blk_name
            fn_body[blk_name] = blk
          }
        } else if (blk_kind == "ty") {
          if (!(blk_name in seen_ty)) {
            seen_ty[blk_name] = 1
            extra_pre = extra_pre blk
          }
        }
        blk_kind = ""
      }
    }
    next
  }
  if ($0 ~ /^[[:space:]]*#ifndef OO_FN_/) {
    n = $0
    sub(/.*OO_FN_/, "", n)
    gsub(/[^A-Za-z0-9_].*/, "", n)
    if (n != "" && FILENAME !~ /ANCHOR_oo/) start("fn", n, $0)
    else if (n != "") { blk_kind = "skip"; blk_name = n; blk = $0 "\n"; depth = 1 }
    next
  }
  if ($0 ~ /^[[:space:]]*#ifndef OO_(TY_|FWD_|HAVE_|RETAIN_|RELEASE_|FNS_)/) {
    n = $0
    sub(/.*#ifndef[[:space:]]+/, "", n)
    gsub(/[^A-Za-z0-9_].*/, "", n)
    if (n != "") start("ty", n, $0)
    next
  }
  if ($0 ~ /^[[:space:]]*(int|long long)[[:space:]]+main[[:space:]]*\(/) {
    in_main = 1
    last_main = $0 "\n"
    next
  }
  if (in_main) last_main = last_main $0 "\n"
}
END {
  print extra_pre >> pre_path
  for (i = 1; i <= nfn; i++) {
    n = fn_order[i]
    b = fn_body[n]
    nlines = split(b, lines, "\n")
    sig = ""
    for (j = 1; j <= nlines; j++) {
      L = lines[j]
      if (L ~ /^[[:space:]]*#/) continue
      if (L ~ /^[[:space:]]*$/) continue
      if (L ~ /^[[:space:]]*typedef[[:space:]]/) continue
      if (L ~ /oo_retain_|oo_release_/) continue
      if (L ~ /\(/ && L ~ /\{/) { sig = L; sub(/\{.*/, "", sig); gsub(/[[:space:]]+$/, "", sig); break }
    }
    if (sig != "") print sig ";" >> proto_path
    printf "%s", b >> body_path
  }
  if (last_main != "") printf "%s", last_main >> body_path
  print "pure_build: unique_fns=awk fns=" nfn
}
' "${MCS[@]}"
echo "pure_build: unique_fns=awk from_modules=${#MCS[@]}"
# Extra runtime decls: seed/old emit-c preamble can omit names current c_emit_*.oo lowers to.
# Mirror oodac/c_emit_preamble.oo println prototypes (skip python_embed_internal).
echo "void oo_ll_I_retain(OoLL_I x); void oo_ll_I_release(OoLL_I x); void oo_ll_S_retain(OoLL_S x); void oo_ll_S_release(OoLL_S x); void oo_ll_F_retain(OoLL_F x); void oo_ll_F_release(OoLL_F x);" >> "$TMP/preamble.c"
echo "OoStr oo_str_lit(const char*); OoStr oo_str_concat(OoStr,OoStr); OoStr oo_str_concat_list(OoSList); OoStr oo_str_concat_multi(int, ...);" >> "$TMP/preamble.c"
if ! grep -q "oo_retain_OoLL_S" "$TMP/preamble.c"; then
  echo "static inline void oo_retain_OoL_I(OoIList v) { oo_ilist_retain(v); } static inline void oo_release_OoL_I(OoIList v) { oo_ilist_release(v); } static inline void oo_retain_OoLL_S(OoLL_S v) { oo_ll_S_retain(v); } static inline void oo_release_OoLL_S(OoLL_S v) { oo_ll_S_release(v); } static inline void oo_retain_OoLL_I(OoLL_I v) { oo_ll_I_retain(v); } static inline void oo_release_OoLL_I(OoLL_I v) { oo_ll_I_release(v); } static inline void oo_retain_OoLL_F(OoLL_F v) { oo_ll_F_retain(v); } static inline void oo_release_OoLL_F(OoLL_F v) { oo_ll_F_release(v); }" >> "$TMP/preamble.c"
fi
echo "#ifndef oo_list_quota_release_bytes" >> "$TMP/preamble.c"
echo "#define oo_list_quota_release_bytes(cap, sz) ((void)0)" >> "$TMP/preamble.c"
echo "#endif" >> "$TMP/preamble.c"
echo "#ifndef oo_payload_free" >> "$TMP/preamble.c"
echo "#define oo_payload_free(ptr) free(ptr)" >> "$TMP/preamble.c"
echo "#endif" >> "$TMP/preamble.c"
echo "long long oo_cap_grant_fs(void); long long oo_cap_grant_sys(void); long long oo_cap_grant_env(void); long long oo_cap_grant_net(void);" >> "$TMP/preamble.c"
echo "long long oo_cap_grant_time(void); long long oo_cap_grant_rand(void);" >> "$TMP/preamble.c"
echo "long long oo_cap_grant_alloc(void); long long oo_cap_grant_ffi(void);" >> "$TMP/preamble.c"
echo "long long oo_cap_grant_thread(void); long long oo_cap_grant_gpu(void);" >> "$TMP/preamble.c"
echo "long long oo_cap_grant_http(void); long long oo_cap_grant_tcp(void);" >> "$TMP/preamble.c"
echo "long long oo_cap_grant_udp(void); long long oo_cap_grant_bind(void);" >> "$TMP/preamble.c"
echo "long long oo_cap_grant_fsread(void); long long oo_cap_grant_fswrite(void);" >> "$TMP/preamble.c"
echo "long long oo_cap_grant_process(void); long long oo_cap_grant_sync(void);" >> "$TMP/preamble.c"
echo "long long oo_cap_grant_mem(void); long long oo_cap_grant_sign(void);" >> "$TMP/preamble.c"
echo "long long oo_cap_grant_audio(void); long long oo_cap_grant_camera(void);" >> "$TMP/preamble.c"
echo "long long oo_cap_grant_usb(void); long long oo_cap_grant_hid(void);" >> "$TMP/preamble.c"
echo "long long oo_cap_grant_window(void); long long oo_cap_grant_frame(void);" >> "$TMP/preamble.c"
echo "int oo_path_exists(long long,OoStr); long long oo_file_size(long long,OoStr); OoResS oo_env_get(long long,OoStr);" >> "$TMP/preamble.c"
echo "OoResS oo_read_file(long long,OoStr); OoResV oo_write_file(long long,OoStr,OoStr);" >> "$TMP/preamble.c"
echo "OoResV oo_fs_remove_file(long long,OoStr); OoResV oo_fs_rmdir(long long,OoStr); OoResV oo_fs_mkdir(long long,OoStr);" >> "$TMP/preamble.c"
echo "OoSList oo_fs_read_dir(long long,OoStr); int oo_fs_is_dir(long long,OoStr);" >> "$TMP/preamble.c"
echo "OoResV oo_fs_hardlink(long long,OoStr,OoStr); OoResV oo_fs_symlink(long long,OoStr,OoStr);" >> "$TMP/preamble.c"
echo "OoResS oo_sys_exec(long long,int,OoStr*);" >> "$TMP/preamble.c"
