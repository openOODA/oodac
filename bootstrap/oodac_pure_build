#define _GNU_SOURCE 1
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <limits.h>
#include <sys/prctl.h>
#include "oodar.h"
static int g_tn, g_np, g_nm;
static int g_marks[64];
static char g_names[256][16];
void oo_emit_tmp_reset(void) { g_tn = 0; g_np = 0; g_nm = 0; }
void oo_emit_tmp_enter(void) { if (g_nm >= 64) abort(); g_marks[g_nm++] = g_np; }
void oo_emit_tmp_release_print(void) {
  int old = 0; int i; if (g_nm > 0) old = g_marks[g_nm - 1]; i = g_np;
  while (i > old) { i--; printf("  oo_str_release(%s);\n", g_names[i]); }
}
void oo_emit_tmp_leave(void) {
  if (g_nm <= 0) return; int old = g_marks[g_nm - 1];
  oo_emit_tmp_release_print(); g_nm--; g_np = old;
}
void oo_emit_tmp_own(OoStr expr) {
  if (g_np <= 0 || !expr.data || expr.len <= 0) return;
  const char *w = g_names[g_np - 1]; size_t wn = strlen(w);
  if ((long long)wn != expr.len) return;
  if (memcmp(expr.data, w, wn) != 0) return; g_np--;
}
void oo_emit_tmp_release_all_print(void) {
  int i = g_np; while (i > 0) { i--; printf("  oo_str_release(%s);\n", g_names[i]); }
  g_np = 0;
}
OoStr oo_emit_tmp_bind(OoStr call) {
  if (g_np >= 256) abort();
  int w = snprintf(g_names[g_np], 16, "__t%d", g_tn++);
  if (w < 0) abort();
  const char *p = call.data; int n = (p && call.len > 0) ? (int)call.len : 0;
  printf("  OoStr %s = %.*s;\n", g_names[g_np], n, p ? p : "");
  OoStr name = oo_str_intern_bytes(g_names[g_np], (long long)strlen(g_names[g_np]));
  g_np++; return name;
}
static OoStr jail_str(const char *s) {
  OoStr o; o.data = (char *)s; o.len = s ? (long long)strlen(s) : 0; return o;
}
__attribute__((constructor)) void oo_jail_landlock_ctor(void) {
  const char *rd = getenv("OODA_FS_READDIR");
  const char *wd = getenv("OODA_FS_WRITEDIR");
  if (!rd || !rd[0] || !wd || !wd[0]) {
    const char *off = getenv("OODA_NO_JAIL");
    if (off && off[0] == '1' && off[1] == 0) return;
    fprintf(stderr, "ERR\tlandlock\tOODA_FS_READDIR and OODA_FS_WRITEDIR required (or OODA_NO_JAIL=1)\n");
    _exit(1);
  }
  if (prctl(PR_GET_NO_NEW_PRIVS, 0, 0, 0, 0) == 1) return;
  if (!oo_landlock_is_available()) {
    fprintf(stderr, "ERR\tlandlock\trequired when jail env set\n"); _exit(1);
  }
  static char rbuf[PATH_MAX * 2]; static char wbuf[PATH_MAX * 2];
  size_t n = 0; const char *pre = "/usr:/bin:/lib:/lib64:";
  while (pre[n] && n + 1 < sizeof rbuf) { rbuf[n] = pre[n]; n++; }
  while (*rd && n + 1 < sizeof rbuf) rbuf[n++] = *rd++; rbuf[n] = 0;
  n = 0; const char *w = wd; const char *suf = ":/tmp";
  while (w && *w && n + 1 < sizeof wbuf) wbuf[n++] = *w++;
  while (*suf && n + 1 < sizeof wbuf) wbuf[n++] = *suf++; wbuf[n] = 0;
  long long sys = oo_cap_grant_sys();
  OoResS r = oo_landlock_restrict(sys, jail_str(rbuf), jail_str(wbuf));
  if (!r.ok) { fprintf(stderr, "ERR\tlandlock\tjail apply failed\n"); _exit(1); }
}
