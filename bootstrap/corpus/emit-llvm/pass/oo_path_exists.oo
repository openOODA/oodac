// # Host oo_path_exists from std/fs
//
// Logline: Language path_exists and std's oo_path_exists must both lower.
//
// Setup: Default llvm. Needs FsReadCap. Prints 1 if this file exists.
//
// Beats:
//   1. oo_path_exists is not unknown call.

pub fn main(fs: &FsReadCap) {
    if oo_path_exists(fs, ".") {
        println(1);
    } else {
        println(0);
    }
}
