// # ensures complex
//
// Logline: Helper carries a complex ensures clause and still emits on LLVM.
//
// Setup: result is bound as the return value for the ensures expression.
//
// Beats:
//   1. fancy ensures result == x + 1.
//   2. The body returns x + 1.
//   3. main prints fancy(1).

pub fn fancy(x: Int) -> Int
    ensures result == x + 1
{
    return x + 1;
}
pub fn main() {
    println(fancy(1));
}
