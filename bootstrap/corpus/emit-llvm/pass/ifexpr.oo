// # Probe ifexpr valid
// Logline: If expressions as values.
// Setup: No caps.
// Beats:
//   1. Simple two-arm.
//   2. Else-if chain.
//   3. Nested parens.
pub fn pick(c: Bool, x: Int, y: Int) -> Int {
    return if c { x } else { y };
}
pub fn grade(n: Int) -> Int {
    return if n > 10 { 3 } else if n > 5 { 2 } else { 1 };
}
pub fn main() {
    println(pick(true, 7, 9));
    println(pick(false, 7, 9));
    println(grade(20));
    println(grade(7));
    println(grade(1));
}
