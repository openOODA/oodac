// # WASM string slice proof
//
// Logline: str_slice, char_at, and chars_len lower and run under wasmtime.
//
// Setup: ASCII subject so byte addressing matches the host runtime.
//   Default wasm build. No emit/c import.
//
// Beats:
//   1. hello and world slices print from one subject.
//   2. Empty, reversed, and overlong ranges print empty lines.
//   3. char_at and chars_len print e and 11.

pub fn main() {
    let s: String = "hello world";
    println(str_slice(s, 0, 5));
    println(str_slice(s, 6, 11));
    println(str_slice(s, 0, 0));
    println(str_slice(s, 5, 3));
    println(str_slice(s, 0, 99));
    println(char_at(s, 1));
    println(chars_len(s));
}
