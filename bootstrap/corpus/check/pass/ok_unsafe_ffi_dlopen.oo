// # ok unsafe ffi dlopen
//
// Logline: Check-pass fixture that grants dlopen through an FfiCap first argument.
//
// Beats:
//   1. ok takes ffi: &FfiCap.
//   2. dlopen is called with that token.
//   3. Check must accept the FFI grant.

pub fn ok(ffi: &FfiCap) {
    let r = dlopen(ffi, "libx.so");
}
pub fn main() {}
