// # differential case: integer multiplication
//
// Logline: LLVM mul matches C op; nested-loop count still diverges; ledger pins it.
//
// Setup: Multiply loop accumulators; print the product sum.
//
// Beats:
//   1. LLVM lowers STAR and prints the true sum 36.
//   2. C prints 144: the true product sum is 36, and the extra x4 is the
//      known C nested-loop iteration factor (see for_nested_sum.oo).
//   3. Ledger class diverge pins both facts; the C x4 factor is C-side work.

pub fn main() {
    let mut s: Int = 0;
    for i in 1..4 {
        for j in 1..4 {
            s = s + i * j;
        }
    }
    println(s);
}
