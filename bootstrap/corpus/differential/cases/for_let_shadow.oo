// # differential case: let shadowing a loop binding
//
// Logline: C accepts, LLVM refuses; the ledger pins the split.
//
// Setup: Loop var i, then let i inside the body.
//
// Beats:
//   1. LLVM fails closed with shadowing refusal.
//   2. C runs C-scoping and prints 5 three times.
//   3. Ledger class c-only pins both facts; unifying is item-5 fix work.

pub fn main() {
    for i in 0..3 {
        let i: Int = 5;
        println(i);
    }
}
