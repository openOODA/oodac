// # differential case: let shadowing a loop binding
//
// Logline: Both backends accept; LLVM shadow alloca matches C-scoping.
//
// Setup: Loop var i, then let i inside the body.
//
// Beats:
//   1. LLVM binds a fresh shadow alloca and prints 5 three times.
//   2. C runs C-scoping and prints 5 three times.
//   3. Ledger class parity pins the agreement.

pub fn main() {
    for i in 0..3 {
        let i: Int = 5;
        println(i);
    }
}
