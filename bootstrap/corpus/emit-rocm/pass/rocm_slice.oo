// # ROCm string slice proof
//
// Logline: str_slice, char_at, chars_len, and concat run on gfx1100.
//
// Setup: ASCII subject so byte sizes match the host runtime.
//   Default rocm build. No emit/c import.
//
// Beats:
//   1. hello and world slices print from one subject.
//   2. Empty range prints an empty line.
//   3. char_at, chars_len, and concat print e 11 and hello world!.

// pass: string slicing executes on gfx1100
pub fn main() {
    let s: String = "hello world";
    println(str_slice(s, 0, 5));
    println(str_slice(s, 6, 11));
    println(str_slice(s, 0, 0));
    println(char_at(s, 1));
    println(chars_len(s));
    println(s + "!");
}
