// # Stress Test: Alternating COW Buffer Isolation
//
// Logline: Rapid alternation between original and clones asserting total isolation.
//
// Setup: Native LLVM lowering of list_set with multi-way aliasing and COW physics.
//
// Beats:
//   1. 1,000-iteration alternating mutations between original and clone for List[Int].
//   2. 4-way aliasing tree mutation isolation for List[Int].
//   3. 500-iteration alternating mutations for List[String].
//   4. Multi-way aliasing tree isolation for List[String].

fn alias_ilist(l: List[Int]) -> List[Int] { return l; }
fn alias_slist(l: List[String]) -> List[String] { return l; }

pub fn test_alternating_cow_int() -> Bool {
    let mut a: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 8 {
        a = list_push(a, i * 10);
        i = i + 1;
    }
    let mut k: Int = 0;
    while k < 1000 {
        let b: List[Int] = alias_ilist(a);
        let b_val: Int = k * 100 + 1;
        let c: List[Int] = list_set(b, 0, b_val);
        if list_get(a, 0) == b_val {
            println("FAIL: a corrupted by b COW write");
            process_exit(1);
        }
        if list_get(c, 0) != b_val {
            println("FAIL: c missing updated value");
            process_exit(1);
        }
        let a_val: Int = k * 100 + 2;
        a = list_set(a, 0, a_val);
        if list_get(c, 0) != b_val {
            println("FAIL: c corrupted by subsequent a write");
            process_exit(1);
        }
        if list_get(a, 0) != a_val {
            println("FAIL: a missing updated value");
            process_exit(1);
        }
        k = k + 1;
    }
    // 4-way tree aliasing
    let c1: List[Int] = alias_ilist(a);
    let c2: List[Int] = alias_ilist(a);
    let c3: List[Int] = alias_ilist(a);
    let m1: List[Int] = list_set(c1, 1, 111);
    let m2: List[Int] = list_set(c2, 1, 222);
    let m3: List[Int] = list_set(c3, 1, 333);
    a = list_set(a, 1, 444);
    if list_get(m1, 1) != 111 || list_get(m2, 1) != 222 || list_get(m3, 1) != 333 || list_get(a, 1) != 444 {
        println("FAIL: 4-way tree aliasing isolation failure");
        process_exit(1);
    }
    return true;
}

pub fn test_alternating_cow_str() -> Bool {
    let mut sa: List[String] = list_new();
    sa = list_push(sa, "alpha");
    sa = list_push(sa, "beta");
    sa = list_push(sa, "gamma");
    let mut k: Int = 0;
    while k < 500 {
        let sb: List[String] = alias_slist(sa);
        let b_val: String = "clone_" + k.to_string();
        let sc: List[String] = list_set(sb, 0, b_val);
        if list_get(sa, 0) == b_val {
            println("FAIL: sa corrupted by sb COW write");
            process_exit(1);
        }
        let a_val: String = "orig_" + k.to_string();
        sa = list_set(sa, 0, a_val);
        if list_get(sc, 0) != b_val {
            println("FAIL: sc corrupted by subsequent sa write");
            process_exit(1);
        }
        if list_get(sa, 0) != a_val {
            println("FAIL: sa missing updated value");
            process_exit(1);
        }
        k = k + 1;
    }
    return true;
}

pub fn main() -> Int {
    test_alternating_cow_int();
    test_alternating_cow_str();
    println("PASS: alternating COW isolation verified");
    return 0;
}
