// # 2D Matrix Slice Verification Test
//
// Logline: Verifies list_slice on nested List[List[Int]] and List[List[String]].
//
// Setup: Native LLVM lowering of list_slice for 2D matrix collections.
//
// Beats:
//   1. Verify 2D integer matrix slicing retains sub-matrix rows.
//   2. Verify inner list elements remain intact after slice.
//   3. Verify clamped bounds on 2D matrix slices.
//   4. Verify 2D string matrix slicing and ARC retention.

pub fn test_matrix_slice_int() -> Bool {
    let mut m: List[List[Int]] = list_new();
    let mut r1: List[Int] = list_new();
    r1 = list_push(r1, 10);
    r1 = list_push(r1, 11);
    let mut r2: List[Int] = list_new();
    r2 = list_push(r2, 20);
    r2 = list_push(r2, 21);
    let mut r3: List[Int] = list_new();
    r3 = list_push(r3, 30);
    r3 = list_push(r3, 31);

    m = list_push(m, r1);
    m = list_push(m, r2);
    m = list_push(m, r3);

    if list_len(m) != 3 {
        println("FAIL: 2D matrix initial len != 3");
        process_exit(1);
    }

    // Sub-slice [1, 3) -> rows r2 and r3
    let s: List[List[Int]] = list_slice(m, 1, 3);
    if list_len(s) != 2 {
        println("FAIL: 2D matrix slice len mismatch");
        process_exit(1);
    }

    let s_r0: List[Int] = list_get(s, 0);
    if list_get(s_r0, 0) != 20 || list_get(s_r0, 1) != 21 {
        println("FAIL: 2D matrix slice row 0 elements mismatch");
        process_exit(1);
    }

    let s_r1: List[Int] = list_get(s, 1);
    if list_get(s_r1, 0) != 30 || list_get(s_r1, 1) != 31 {
        println("FAIL: 2D matrix slice row 1 elements mismatch");
        process_exit(1);
    }

    // Clamped lo < 0
    let s_lo: List[List[Int]] = list_slice(m, 0 - 5, 2);
    if list_len(s_lo) != 2 {
        println("FAIL: 2D matrix slice lo clamp mismatch");
        process_exit(1);
    }

    // lo >= hi -> empty
    let s_inv: List[List[Int]] = list_slice(m, 2, 1);
    if list_len(s_inv) != 0 {
        println("FAIL: 2D matrix slice lo>=hi not empty");
        process_exit(1);
    }

    return true;
}

pub fn test_matrix_slice_string() -> Bool {
    let mut ms: List[List[String]] = list_new();
    let mut s1: List[String] = list_new();
    s1 = list_push(s1, "alpha");
    s1 = list_push(s1, "beta");
    let mut s2: List[String] = list_new();
    s2 = list_push(s2, "gamma");
    s2 = list_push(s2, "delta");

    ms = list_push(ms, s1);
    ms = list_push(ms, s2);

    let sl: List[List[String]] = list_slice(ms, 1, 2);
    if list_len(sl) != 1 {
        println("FAIL: 2D string matrix slice len mismatch");
        process_exit(1);
    }
    let row: List[String] = list_get(sl, 0);
    if list_get(row, 0) != "gamma" || list_get(row, 1) != "delta" {
        println("FAIL: 2D string matrix slice row elements mismatch");
        process_exit(1);
    }
    return true;
}

pub fn main() -> Int {
    test_matrix_slice_int();
    test_matrix_slice_string();
    println("OK 2D matrix slice verified");
    return 0;
}
