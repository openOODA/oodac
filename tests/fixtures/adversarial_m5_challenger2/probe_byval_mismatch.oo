// # Byval Mismatch Probe
// Logline: Exposes export fn receiving Option[&Int] calling convention mismatch
// Setup: emit-llvm and execute
// Beats: oo_consume, main
export fn oo_consume(o: Option[&Int]) -> Int {
    match o {
        Some(p) => { return *p; }
        None => { return 0; }
    }
}

pub fn main() -> Int {
    let a: Int = 42;
    let o: Option[&Int] = Some(&a);
    let res: Int = oo_consume(o);
    if res != 42 {
        process_exit(1);
    }
    return 0;
}
