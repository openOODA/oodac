// # String & Memory Boundary Edge-Case Test Suite
//
// Logline: Comprehensive verification of string representations, UTF-8 boundaries, NUL safety, and memory invariants.
//
// Setup: Compiled via oodac emit-llvm with oodar C runtime linking.
//
// Beats:
//   1. Empty string representation, null-termination, zero length, and non-null data pointer.
//   2. Single-character strings (ASCII vs non-ASCII) and static pool invariants.
//   3. Multi-byte UTF-8 sequences (2-byte, 3-byte, 4-byte astral/emoji) char vs byte indexing.
//   4. ASCII/non-ASCII flag transitions across slicing and concatenation.
//   5. Length-delimited string safety with embedded NUL bytes.

fn test_empty_string() -> Bool {
    let s0: String = "";
    if bytes_len(s0) != 0 || chars_len(s0) != 0 {
        println("FAIL: empty string len mismatch");
        process_exit(1);
    }
    if str_slice(s0, 0, 0) != "" || byte_slice(s0, 0, 0) != "" {
        println("FAIL: empty string slice");
        process_exit(1);
    }
    if !str_contains("alpha", s0) || !str_starts_with("alpha", s0) {
        println("FAIL: empty string prefix/contains");
        process_exit(1);
    }
    if str_index_of("alpha", s0) != 0 {
        println("FAIL: empty string index_of");
        process_exit(1);
    }
    let cat_pre: String = s0 + "hello";
    let cat_suf: String = "hello" + s0;
    if cat_pre != "hello" || cat_suf != "hello" {
        println("FAIL: empty string concat identity");
        process_exit(1);
    }
    return true;
}

fn test_single_char() -> Bool {
    let s1: String = "a";
    if bytes_len(s1) != 1 || chars_len(s1) != 1 {
        println("FAIL: single char len mismatch");
        process_exit(1);
    }
    if char_at(s1, 0) != "a" || byte_at(s1, 0) != 97 {
        println("FAIL: single char char_at or byte_at");
        process_exit(1);
    }
    let s1_cat: String = s1 + "b";
    if bytes_len(s1_cat) != 2 || s1_cat != "ab" {
        println("FAIL: single char concat");
        process_exit(1);
    }
    if str_slice(s1, 0, 1) != "a" || byte_slice(s1, 0, 1) != "a" {
        println("FAIL: single char full slice");
        process_exit(1);
    }
    if str_slice(s1, 1, 1) != "" || byte_slice(s1, 1, 1) != "" {
        println("FAIL: single char empty slice");
        process_exit(1);
    }
    return true;
}

fn test_multibyte_utf8() -> Bool {
    let s_2b: String = "é";
    if bytes_len(s_2b) != 2 || chars_len(s_2b) != 1 {
        println("FAIL: 2-byte utf8 len");
        process_exit(1);
    }
    if char_at(s_2b, 0) != "é" || byte_at(s_2b, 0) != 195 || byte_at(s_2b, 1) != 169 {
        println("FAIL: 2-byte utf8 bytes");
        process_exit(1);
    }
    let s_3b: String = "€";
    if bytes_len(s_3b) != 3 || chars_len(s_3b) != 1 {
        println("FAIL: 3-byte utf8 len");
        process_exit(1);
    }
    if char_at(s_3b, 0) != "€" || byte_at(s_3b, 0) != 226 || byte_at(s_3b, 1) != 130 {
        println("FAIL: 3-byte utf8 bytes");
        process_exit(1);
    }
    let s_4b: String = "🚀";
    if bytes_len(s_4b) != 4 || chars_len(s_4b) != 1 {
        println("FAIL: 4-byte astral emoji len");
        process_exit(1);
    }
    if char_at(s_4b, 0) != "🚀" || byte_at(s_4b, 0) != 240 || byte_at(s_4b, 1) != 159 {
        println("FAIL: 4-byte astral bytes");
        process_exit(1);
    }
    let comp: String = "Aé€🚀Z";
    if bytes_len(comp) != 11 || chars_len(comp) != 5 {
        println("FAIL: composite utf8 len mismatch");
        process_exit(1);
    }
    if char_at(comp, 0) != "A" || char_at(comp, 1) != "é" || char_at(comp, 2) != "€" {
        println("FAIL: composite char_at 0..2");
        process_exit(1);
    }
    if char_at(comp, 3) != "🚀" || char_at(comp, 4) != "Z" {
        println("FAIL: composite char_at 3..4");
        process_exit(1);
    }
    if str_slice(comp, 1, 4) != "é€🚀" || str_slice(comp, 3, 5) != "🚀Z" {
        println("FAIL: composite str_slice");
        process_exit(1);
    }
    if byte_slice(comp, 0, 1) != "A" || byte_slice(comp, 1, 3) != "é" {
        println("FAIL: composite byte_slice ASCII/2-byte");
        process_exit(1);
    }
    if byte_slice(comp, 3, 6) != "€" || byte_slice(comp, 6, 10) != "🚀" {
        println("FAIL: composite byte_slice 3-byte/4-byte");
        process_exit(1);
    }
    return true;
}

fn test_flag_transitions() -> Bool {
    let ascii: String = "hello world";
    let non_ascii: String = "café au lait";
    let sub_ascii: String = str_slice(non_ascii, 0, 3);
    if sub_ascii != "caf" || bytes_len(sub_ascii) != 3 || chars_len(sub_ascii) != 3 {
        println("FAIL: slice non-ascii into pure ascii");
        process_exit(1);
    }
    let cat_mixed: String = ascii + " " + non_ascii;
    if chars_len(cat_mixed) != 24 || bytes_len(cat_mixed) != 25 {
        println("FAIL: mixed concatenation length");
        process_exit(1);
    }
    let one_c: String = str_slice(non_ascii, 0, 1);
    if bytes_len(one_c) != 1 || chars_len(one_c) != 1 || one_c != "c" {
        println("FAIL: 1-char slice from multi-byte string");
        process_exit(1);
    }
    let one_non_ascii: String = str_slice(non_ascii, 3, 4);
    if bytes_len(one_non_ascii) != 2 || chars_len(one_non_ascii) != 1 || one_non_ascii != "é" {
        println("FAIL: 1-char multi-byte slice");
        process_exit(1);
    }
    return true;
}

fn test_embedded_nul() -> Bool {
    let mut b: List[Int] = bytes_new();
    b = bytes_push(b, 104);
    b = bytes_push(b, 101);
    b = bytes_push(b, 108);
    b = bytes_push(b, 108);
    b = bytes_push(b, 111);
    b = bytes_push(b, 0);
    b = bytes_push(b, 119);
    b = bytes_push(b, 111);
    b = bytes_push(b, 114);
    b = bytes_push(b, 108);
    b = bytes_push(b, 100);
    let s: String = bytes_to_str(b);
    if bytes_len(s) != 11 || chars_len(s) != 11 {
        println("FAIL: embedded nul length truncation");
        process_exit(1);
    }
    if byte_at(s, 5) != 0 || byte_at(s, 6) != 119 {
        println("FAIL: embedded nul byte inspection");
        process_exit(1);
    }
    if byte_slice(s, 0, 5) != "hello" || byte_slice(s, 6, 11) != "world" {
        println("FAIL: embedded nul byte_slice");
        process_exit(1);
    }
    if !str_contains(s, "world") || str_index_of(s, "world") != 6 {
        println("FAIL: embedded nul contains or index_of past NUL");
        process_exit(1);
    }
    if !str_starts_with(s, "hello") || !str_ends_with(s, "world") {
        println("FAIL: embedded nul starts_with / ends_with");
        process_exit(1);
    }
    if s == "hello" {
        println("FAIL: embedded nul false match with prefix");
        process_exit(1);
    }
    let s_cat: String = s + "!";
    if bytes_len(s_cat) != 12 || byte_slice(s_cat, 6, 12) != "world!" {
        println("FAIL: embedded nul concat");
        process_exit(1);
    }
    return true;
}

pub fn main() -> Int {
    test_empty_string();
    test_single_char();
    test_multibyte_utf8();
    test_flag_transitions();
    test_embedded_nul();
    println("OK\tedge_strings_memory\tall tests passed");
    return 0;
}
