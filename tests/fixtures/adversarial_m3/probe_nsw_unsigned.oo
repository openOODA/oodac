// # Unsigned Arithmetic Non-NSW Probe
//
// Logline: Verifies unsigned arithmetic operations do NOT emit nsw flags.
//
// Setup: Compiled to LLVM IR to verify add/sub/mul retain wrap semantics.
//
// Beats:
//   1. Unsigned u64 addition, subtraction, multiplication.
//   2. Unsigned u32 addition, subtraction, multiplication.
//   3. Assert wrap-around behavior without undefined behavior.

pub fn u64_math(a: u64, b: u64) -> u64 {
    let s: u64 = a + b;
    let d: u64 = a - b;
    let m: u64 = a * b;
    return s + d + m;
}

pub fn u32_math(a: u32, b: u32) -> u32 {
    let s: u32 = a + b;
    let d: u32 = a - b;
    let m: u32 = a * b;
    return s + d + m;
}

pub fn main() -> Int {
    let r1: u64 = u64_math(10, 5);
    let r2: u32 = u32_math(20, 4);
    if r1 == 70 && r2 == 120 {
        return 0;
    }
    return 1;
}
