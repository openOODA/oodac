// # Pure Integer List Symbol Pruning Probe
//
// Logline: Verify integer-only list operations omit all string list symbols.
//
// Setup: Compile with oodac emit-llvm and verify presence of ilist and absence of slist.
//
// Beats:
//   1. Allocate and push into List[Int].
//   2. Retrieve and sum elements.
//   3. Validate emitted LLVM IR.

pub fn sum_ilist(n: Int) -> Int {
    let mut nums: List[Int] = list_new();
    let mut i: Int = 1;
    while i <= n {
        nums = list_push(nums, i);
        i = i + 1;
    }
    let mut total: Int = 0;
    let mut j: Int = 0;
    let count: Int = list_len(nums);
    while j < count {
        total = total + list_get(nums, j);
        j = j + 1;
    }
    return total;
}

pub fn main() -> Int {
    let res: Int = sum_ilist(10);
    if res == 55 {
        return 0;
    }
    return 1;
}
