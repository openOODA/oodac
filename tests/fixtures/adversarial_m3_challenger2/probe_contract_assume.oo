// # Contract Assume Probe
//
// Logline: Test contract assumption lowering into @llvm.assume
//
// Setup: Compile with emit-llvm and verify presence of llvm.assume.
//
// Beats:
//   1. Function with requires and ensures contracts.
//   2. Validate emitted LLVM IR with llvm-as.

pub fn inc(x: Int) -> Int
  ensures result == x + 1
{
    return x + 1;
}

pub fn main() -> Int {
    let r: Int = inc(5);
    if r == 6 {
        return 0;
    }
    return 1;
}
