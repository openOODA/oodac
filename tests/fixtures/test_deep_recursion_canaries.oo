// # Deep Recursion & Caller Stack Frame Preservation Stress Test
//
// Logline: Stress-test depth >= 1,000 recursion returning Option[Point] and Result[MyStruct, String].
//
// Setup: Compile with oodac check and build, verify stack frame invariants under -O0..-O3.
//
// Beats:
//   1. Struct definitions Point and MyStruct.
//   2. Recursive Option[Point] functions with internal canaries.
//   3. Recursive Result[MyStruct, String] functions with internal canaries.
//   4. Multi-call tree recursion validating concurrent stack slot isolation.
//   5. Deep caller stack frame canary tests.
//   6. Main entry point executing all stress tests.

pub type Point = struct {
    x: Int,
    y: Int
};

pub type MyStruct = struct {
    id: Int,
    score: Int
};

pub fn recurse_opt_point(depth: Int, p: Point) -> Option[Point] {
    let canary_a: Int = depth * 10007 + 3;
    let canary_b: Int = depth * 31337 + 7;
    if depth <= 0 {
        return Some(p);
    }
    let next: Point = Point { x: p.x + 2, y: p.y + 3 };
    let res: Option[Point] = recurse_opt_point(depth - 1, next);
    if canary_a != depth * 10007 + 3 || canary_b != depth * 31337 + 7 {
        return None;
    }
    return res;
}

pub fn recurse_opt_point_none(depth: Int, p: Point) -> Option[Point] {
    let canary_a: Int = depth * 10007 + 3;
    let canary_b: Int = depth * 31337 + 7;
    if depth <= 0 {
        return None;
    }
    let next: Point = Point { x: p.x + 2, y: p.y + 3 };
    let res: Option[Point] = recurse_opt_point_none(depth - 1, next);
    if canary_a != depth * 10007 + 3 || canary_b != depth * 31337 + 7 {
        return Some(p);
    }
    return res;
}

pub fn recurse_res_mystruct(depth: Int, s: MyStruct) -> Result[MyStruct, String] {
    let canary_a: Int = depth * 20011 + 5;
    let canary_b: Int = depth * 40009 + 9;
    if depth <= 0 {
        return Ok(s);
    }
    let next: MyStruct = MyStruct { id: s.id + 1, score: s.score + 10 };
    let res: Result[MyStruct, String] = recurse_res_mystruct(depth - 1, next);
    if canary_a != depth * 20011 + 5 || canary_b != depth * 40009 + 9 {
        return Err("canary corruption in recurse_res_mystruct");
    }
    return res;
}

pub fn recurse_res_mystruct_err(depth: Int, s: MyStruct) -> Result[MyStruct, String] {
    let canary_a: Int = depth * 20011 + 5;
    let canary_b: Int = depth * 40009 + 9;
    if depth <= 0 {
        return Err("max recursion depth reached");
    }
    let next: MyStruct = MyStruct { id: s.id + 1, score: s.score + 10 };
    let res: Result[MyStruct, String] = recurse_res_mystruct_err(depth - 1, next);
    if canary_a != depth * 20011 + 5 || canary_b != depth * 40009 + 9 {
        return Ok(s);
    }
    return res;
}

pub fn tree_recurse_opt(n: Int) -> Option[Point] {
    if n <= 0 {
        let p: Point = Point { x: 1, y: 1 };
        return Some(p);
    }
    let opt1: Option[Point] = tree_recurse_opt(n - 1);
    let opt2: Option[Point] = tree_recurse_opt(n - 1);
    match opt1 {
        Some(p1) => {
            match opt2 {
                Some(p2) => {
                    let combined: Point = Point { x: p1.x + p2.x, y: p1.y + p2.y };
                    return Some(combined);
                }
                None => { return None; }
            }
        }
        None => { return None; }
    }
}

pub fn tree_recurse_res(n: Int) -> Result[MyStruct, String] {
    if n <= 0 {
        let s: MyStruct = MyStruct { id: 1, score: 2 };
        return Ok(s);
    }
    let res1: Result[MyStruct, String] = tree_recurse_res(n - 1);
    let res2: Result[MyStruct, String] = tree_recurse_res(n - 1);
    match res1 {
        Ok(s1) => {
            match res2 {
                Ok(s2) => {
                    let combined: MyStruct = MyStruct { id: s1.id + s2.id, score: s1.score + s2.score };
                    return Ok(combined);
                }
                Err(e) => { return Err(e); }
            }
        }
        Err(e) => { return Err(e); }
    }
}

pub fn test_caller_stack_canaries() -> Int {
    let c1: Int = 1111111111;
    let c2: Int = 2222222222;
    let c3: Int = 3333333333;
    let c4: Int = 4444444444;

    let init_p: Point = Point { x: 10, y: 20 };
    let r_opt: Option[Point] = recurse_opt_point(1000, init_p);
    match r_opt {
        Some(pt) => {
            if pt.x != 2010 || pt.y != 3020 { return 101; }
        }
        None => { return 102; }
    }
    if c1 != 1111111111 || c2 != 2222222222 || c3 != 3333333333 || c4 != 4444444444 {
        return 103;
    }

    let mid1: Int = 5555555555;
    let mid2: Int = 6666666666;

    let r_opt_none: Option[Point] = recurse_opt_point_none(1000, init_p);
    match r_opt_none {
        Some(_) => { return 104; }
        None => {}
    }
    if c1 != 1111111111 || c2 != 2222222222 || mid1 != 5555555555 || mid2 != 6666666666 {
        return 105;
    }

    let init_s: MyStruct = MyStruct { id: 100, score: 500 };
    let r_res: Result[MyStruct, String] = recurse_res_mystruct(1000, init_s);
    match r_res {
        Ok(st) => {
            if st.id != 1100 || st.score != 10500 { return 106; }
        }
        Err(_) => { return 107; }
    }
    if c1 != 1111111111 || c2 != 2222222222 || c3 != 3333333333 || c4 != 4444444444 {
        return 108;
    }

    let post1: Int = 7777777777;
    let post2: Int = 8888888888;

    let r_res_err: Result[MyStruct, String] = recurse_res_mystruct_err(1000, init_s);
    match r_res_err {
        Ok(_) => { return 109; }
        Err(msg) => {
            if msg != "max recursion depth reached" { return 110; }
        }
    }
    if post1 != 7777777777 || post2 != 8888888888 || c1 != 1111111111 || c4 != 4444444444 {
        return 111;
    }

    return 0;
}

pub fn main() -> Int {
    let ret: Int = test_caller_stack_canaries();
    if ret != 0 { return ret; }

    let p: Point = Point { x: 0, y: 0 };
    let o: Option[Point] = recurse_opt_point(1500, p);
    match o {
        Some(pt) => {
            if pt.x != 3000 || pt.y != 4500 { return 1; }
        }
        None => { return 2; }
    }

    let s: MyStruct = MyStruct { id: 0, score: 0 };
    let r: Result[MyStruct, String] = recurse_res_mystruct(1500, s);
    match r {
        Ok(st) => {
            if st.id != 1500 || st.score != 15000 { return 3; }
        }
        Err(_) => { return 4; }
    }

    let tree_o: Option[Point] = tree_recurse_opt(10);
    match tree_o {
        Some(tp) => {
            if tp.x != 1024 || tp.y != 1024 { return 5; }
        }
        None => { return 6; }
    }

    let tree_r: Result[MyStruct, String] = tree_recurse_res(10);
    match tree_r {
        Ok(ts) => {
            if ts.id != 1024 || ts.score != 2048 { return 7; }
        }
        Err(_) => { return 8; }
    }

    return 0;
}
