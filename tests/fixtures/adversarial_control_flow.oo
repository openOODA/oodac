// # Adversarial Test: Complex Control Flow
//
// Logline: Stress-test nested loops, breaks, continues, early returns, and match.
//
// Setup: Deep nesting of while, for, if-else, and match constructs.
//
// Beats:
//   1. Nested while with break and continue.
//   2. Nested for with early return.
//   3. Deeply nested if-else chain.
//   4. Multi-arm match with guards/blocks.

fn test_nested_loops() -> Int {
    let mut i: Int = 0;
    let mut total: Int = 0;
    while i < 10 {
        i = i + 1;
        if i == 2 {
            continue;
        }
        if i == 8 {
            break;
        }
        let mut j: Int = 0;
        while j < 5 {
            j = j + 1;
            if j == 3 {
                continue;
            }
            if j == 4 {
                break;
            }
            total = total + i * 10 + j;
        }
    }
    return total;
}

fn test_early_return(limit: Int) -> Int {
    let mut count: Int = 0;
    for x in 0..10 {
        for y in 0..10 {
            count = count + 1;
            if x * y > limit {
                return count;
            }
        }
    }
    return count;
}

fn test_deep_branching(val: Int) -> Int {
    let mut res: Int = 0;
    if val < 0 {
        res = -1;
    } else if val == 0 {
        res = 0;
    } else if val < 10 {
        if val < 5 {
            if val == 1 || val == 2 {
                res = 12;
            } else {
                res = 34;
            }
        } else {
            if val == 7 {
                res = 77;
            } else {
                res = 56;
            }
        }
    } else {
        res = 100;
    }
    return res;
}

pub fn main() {
    let t1: Int = test_nested_loops();
    println(t1);
    let t2: Int = test_early_return(25);
    println(t2);
    let t3: Int = test_deep_branching(7);
    println(t3);
    let t4: Int = test_deep_branching(1);
    println(t4);
    let t5: Int = test_deep_branching(99);
    println(t5);
}
