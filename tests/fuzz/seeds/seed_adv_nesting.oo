// # Deep Nesting Adversarial Seed
// Logline: Deeply nested lexical scopes and compound blocks.
// Setup: Pure compute.
// Beats:
//   1. Enter nested blocks.
//   2. Compute value and exit.

pub fn deep_nest_seed(x: Int) -> Int {
    let mut sum: Int = x;
    { { { { { { { { { {
        if sum > 0 {
            if sum > 10 {
                sum = sum + 1;
            } else {
                sum = sum + 2;
            }
        }
    } } } } } } } } } }
    return sum;
}
