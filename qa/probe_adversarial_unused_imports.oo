// # Adversarial Unused Import Hierarchy Probe
//
// Logline: Adversarially tests complex import hierarchies, call chains from main, and struct passing across modules.
//
// Setup: Imports fixture_leaf.oo and fixture_mid.oo.
//
// Beats:
//   1. Import leaf and mid modules in multi-level dependency graph.
//   2. Call leaf and mid functions through nested helper functions and directly from main.
//   3. Pass structs across module boundaries and inspect results.
//   4. Assert correct multi-module execution with zero compiler warnings or errors.

import "fixture_leaf.oo";
import "fixture_mid.oo";

pub fn run_pipeline(x: Int, y: Int, z: Int) -> Int {
    let result: Int = fixture_mid_compute(x, y, z);
    return result;
}

pub fn run_formatter(name: String, val: Int) -> String {
    let data: FixtureLeafData = fixture_mid_build_leaf(name, val);
    let formatted: String = fixture_leaf_format(data);
    return formatted;
}

pub fn main() {
    let mut num_errors: Int = 0;

    // Test 1: Complex call chain through fixture_mid_compute -> fixture_leaf_calc
    // fixture_mid_compute(2, 3, 4):
    //   step1 = fixture_leaf_calc(2, 3) = 2 * 10 + 3 = 23
    //   step2 = fixture_leaf_calc(23, 4) = 23 * 10 + 4 = 234
    let res1: Int = run_pipeline(2, 3, 4);
    if res1 == 234 {
    } else {
        println("FAIL: run_pipeline");
        num_errors = num_errors + 1;
    }

    // Test 2: Cross-module struct building and formatting
    let res2: String = run_formatter("sample_item", 99);
    if res2 == "LEAF[sample_item]" {
    } else {
        println("FAIL: run_formatter");
        num_errors = num_errors + 1;
    }

    // Test 3: Direct leaf call from main
    let direct_res: Int = fixture_leaf_calc(5, 7);
    // 5 * 10 + 7 = 57
    if direct_res == 57 {
    } else {
        println("FAIL: direct fixture_leaf_calc");
        num_errors = num_errors + 1;
    }

    if num_errors == 0 {
        println("probe_adversarial_unused_imports: PASSED");
    } else {
        println("probe_adversarial_unused_imports: FAILED");
        process_exit(1);
    }
}
