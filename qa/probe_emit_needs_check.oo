// # Probe: emit-c without check refuses
//
// Logline: emit-c of a well-typed file with no artifact must ERR and not emit C.
//
// Setup: ProcessCap + EnvCap + FsReadCap. Host is OODA_COMPILER. Victim is probe_list_ok.oo.
//
// Beats:
//   1. Remove the victim artifact by sha. No glob. No shell.
//   2. emit-c without check exits nonzero and prints ERR, not oo_slist_new.
//   3. emit-llvm without check exits nonzero and prints ERR.

fn art_sha16(path: String, src: String) -> String {
    let digest: String = crypto_sha256_internal(path + "\n" + src);
    if chars_len(digest) >= 16 {
        return str_slice(digest, 0, 16);
    }
    return digest;
}

pub fn main(p: &ProcessCap, env: &EnvCap, fs_r: &FsReadCap) {
    let hr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let host: String = match hr { Ok(s) => s, Err(_) => "" };
    if host == "" {
        println("ERR\tOODA_COMPILER required");
        process_exit(1);
    }
    let srcp: String = "oodac/qa/probe_list_ok.oo";
    let sr: Result[String, String] = read_file(fs_r, srcp);
    if sr.is_err() {
        println("ERR\tunreadable victim");
        process_exit(1);
    }
    let src: String = match sr { Ok(s) => s, Err(_) => "" };
    let dest: String = ".ooda-cache/ooda-tmp/art_" + art_sha16(srcp, src) + ".art";
    let _: Result[String, String] = sys_exec(p, "/usr/bin/rm", "-f", dest);
    let em: Result[String, String] = sys_exec(p, host, "emit-c", srcp);
    if em.is_ok() {
        println("ERR\temit without check must fail");
        process_exit(1);
    }
    let et: String = match em { Ok(s) => s, Err(e) => e };
    if str_index_of(et, "oo_slist_new") >= 0 {
        println("ERR\temit leaked C without check");
        process_exit(1);
    }
    if str_index_of(et, "ERR") < 0 {
        println("ERR\temit-c silent");
        process_exit(1);
    }
    let lm: Result[String, String] = sys_exec(p, host, "emit-llvm", srcp);
    if lm.is_ok() {
        println("ERR\temit-llvm without check must fail");
        process_exit(1);
    }
    let lt: String = match lm { Ok(s) => s, Err(e) => e };
    if str_index_of(lt, "ERR") < 0 {
        println("ERR\temit-llvm silent");
        process_exit(1);
    }
    println("OK");
}
