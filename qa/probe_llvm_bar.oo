// # Probe: llvm backend is residual
//
// Logline: build --backend llvm of a well-typed file exits 2 and writes no ELF. wasm residual.
//
// Setup: ProcessCap + EnvCap + FsReadCap. Host is OODA_COMPILER.
//
// Beats:
//   1. build --backend llvm of probe_list_ok.oo exits 2.
//   2. That -o path is absent.
//   3. --backend wasm still exits 2.

pub fn main(p: &ProcessCap, env: &EnvCap, fs_r: &FsReadCap) {
    let hr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let host: String = match hr { Ok(s) => s, Err(_) => "" };
    if host == "" {
        println("ERR\tOODA_COMPILER required");
        process_exit(1);
    }
    let out: String = ".ooda-cache/ooda-tmp/llvm_residual.bin";
    let br: Result[String, String] = sys_exec(p, host, "build", "--backend", "llvm", "oodac/qa/probe_list_ok.oo", "-o", out);
    if br.is_ok() {
        println("ERR\tbackend llvm must stay residual");
        process_exit(1);
    }
    if path_exists(fs_r, out) {
        println("ERR\tllvm residual shipped ELF");
        process_exit(1);
    }
    let wr: Result[String, String] = sys_exec(p, host, "build", "oodac/qa/probe_list_ok.oo", "--backend", "wasm");
    if wr.is_ok() {
        println("ERR\twasm residual must fail");
        process_exit(1);
    }
    println("OK");
}
