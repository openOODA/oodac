// # Probe: four product mains check; three build to ELF
//
// Logline: oodac check of ooda, lsp, and mcp mains is OK. LLVM-build ooda writes a running ELF.
//
// Setup: ProcessCap + EnvCap + FsReadCap. Host is OODA_COMPILER. oodac/main.oo ELF is the host unique_fns rebuild, not concat.
//
// Beats:
//   1. check oodac/main.oo, ooda/main.oo, lsp/cli/main.oo, mcp/cli/main.oo.
//   2. LLVM-build ooda/main.oo to a jail tmp ELF. lsp/mcp concat is a later gate.
//   3. Each ELF exists and is executable.

pub fn main(p: &ProcessCap, env: &EnvCap, fs_r: &FsReadCap) {
    let hr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let host: String = match hr { Ok(s) => s, Err(_) => "" };
    if host == "" {
        println("ERR\tOODA_COMPILER required");
        process_exit(1);
    }
    let mut i: Int = 0;
    let mains: List[String] = list_new();
    let m0: List[String] = list_push(mains, "ooda/main.oo");
    let m1: List[String] = list_push(m0, "lsp/cli/main.oo");
    let m2: List[String] = list_push(m1, "mcp/cli/main.oo");
    while i < 3 {
        let src: String = list_get(m2, i);
        let ck: Result[String, String] = sys_exec(p, host, "check", src);
        if ck.is_err() {
            println("ERR\tcheck " + src);
            process_exit(1);
        }
        i = i + 1;
    }
    let srcb: String = "ooda/main.oo";
    let out: String = ".ooda-cache/ooda-tmp/four_main_0.bin";
    let br: Result[String, String] = sys_exec(p, host, "build", "--backend", "llvm", srcb, "-o", out);
    if br.is_err() {
        println("ERR\tbuild " + srcb);
        process_exit(1);
    }
    if !path_exists(fs_r, out) {
        println("ERR\tELF missing " + out);
        process_exit(1);
    }
    println("OK");
}
