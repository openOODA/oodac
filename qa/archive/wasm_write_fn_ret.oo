// # Drive wasm_emit_program on fn_ret_int
//
// Logline: Write a WASI module via shipped wasm_emit_program.
//
// Setup: FsRead/Write. Output .wasm next to native ELF artifacts.
//
// Beats:
//   1. wasm_emit_program. write_file. Magic is \\0asm.

import "emit/wasm/wasm_emit.oo";

pub fn main(fs_r: &FsReadCap, fs_w: &FsWriteCap) {
    let srcp: String = "bootstrap/corpus/emit-llvm/pass/fn_ret_int.oo";
    let sr: Result[String, String] = read_file(fs_r, srcp);
    if sr.is_err() {
        println("ERR\tread fn_ret_int");
        process_exit(1);
    }
    let src: String = match sr { Ok(s) => s, Err(_) => "" };
    let blob: String = wasm_emit_program(src);
    let out: String = ".ooda-cache/ooda-tmp/fn_ret_int.wasm";
    let wr: Result[Void, String] = write_file(fs_w, out, blob);
    if wr.is_err() {
        println("ERR\twrite wasm");
        process_exit(1);
    }
    println("OK\twrote\t" + out);
}
