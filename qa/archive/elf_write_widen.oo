// # Drive elf_emit_program on if_lit
//
// Logline: Write native ELF via shipped elf_emit_program for if/let/println.
//
// Setup: FsRead/Write + ProcessCap.
//
// Beats:
//   1. elf_emit_program of if_lit. chmod +x.

import "emit/elf/elf_emit.oo";

pub fn main(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap) {
    let srcp: String = "bootstrap/corpus/emit-elf/pass/if_lit.oo";
    let sr: Result[String, String] = read_file(fs_r, srcp);
    if sr.is_err() {
        println("ERR\tread if_lit");
        process_exit(1);
    }
    let src: String = match sr { Ok(s) => s, Err(_) => "" };
    let blob: String = elf_emit_program(src);
    let out: String = ".ooda-cache/ooda-tmp/native_elf_if_lit.bin";
    let wr: Result[Void, String] = write_file(fs_w, out, blob);
    if wr.is_err() {
        println("ERR\twrite ELF");
        process_exit(1);
    }
    let ch: Result[String, String] = sys_exec(sys, "/usr/bin/chmod", "+x", out);
    if ch.is_err() {
        println("ERR\tchmod");
        process_exit(1);
    }
    println("OK\twrote\t" + out);
}
