// # Probe: emit-llvm retains field-access stores
//
// Logline: Storing an owned value from a borrowed field-access chain
// (let / assign / struct-literal / field-store) must emit a retain:
// scope exit releases the new owner unconditionally, so a missing
// retain frees the lender's value early (use-after-free).
//
// Setup: ProcessCap + EnvCap. Host is OODA_COMPILER. Fixture is
// qa/fixtures/llvm_arc_field_retain.oo (checked in).
//
// Beats:
//   1. check accepts the fixture.
//   2. emit-llvm of fr_bind contains @oo_ilist_retain.
//   3. emit-llvm of fr_assign contains @oo_ilist_retain.
//   4. emit-llvm of fr_lit contains @oo_ilist_retain.

fn fn_slice(ir: String, sym: String) -> String {
    let start: Int = str_index_of(ir, sym);
    if start < 0 { return ""; }
    let rest: String = str_slice(ir, start, chars_len(ir));
    let next: Int = str_index_of(str_slice(rest, 1, chars_len(rest)), "define ");
    if next < 0 { return rest; }
    return str_slice(rest, 0, next + 1);
}

fn must_retain(ir: String, sym: String) {
    let body: String = fn_slice(ir, sym);
    if body == "" {
        println("ERR\tmissing function " + sym);
        process_exit(1);
    }
    if str_index_of(body, "@oo_ilist_retain") < 0 {
        println("ERR\tno ilist retain in " + sym);
        process_exit(1);
    }
}

pub fn main(p: &ProcessCap, env: &EnvCap) {
    let hr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let host: String = match hr { Ok(s) => s, Err(_) => "" };
    if host == "" {
        println("ERR\tOODA_COMPILER required");
        process_exit(1);
    }
    let srcp: String = "oodac/qa/fixtures/llvm_arc_field_retain.oo";
    let ck: Result[String, String] = sys_exec(p, host, "check", srcp);
    if ck.is_err() {
        println("ERR\tfixture must check");
        process_exit(1);
    }
    let em: Result[String, String] = sys_exec(p, host, "emit-llvm", srcp);
    if em.is_err() {
        println("ERR\temit-llvm failed");
        process_exit(1);
    }
    let ir: String = match em { Ok(s) => s, Err(_) => "" };
    must_retain(ir, "@llvm_arc_field_retain_fr_bind(");
    must_retain(ir, "@llvm_arc_field_retain_fr_assign(");
    must_retain(ir, "@llvm_arc_field_retain_fr_lit(");
    println("OK");
}
