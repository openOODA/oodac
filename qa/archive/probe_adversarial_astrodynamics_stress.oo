// # Adversarial Astrodynamics Stress & Boundary Verification
//
// Logline: Stress-tests astrodynamics modules against extreme eccentricities, polar/retrograde inclinations, near-zero masses, and degenerate vectors.
//
// Setup: Pure numerical verification suite importing the relativistic
// astrodynamics modules directly (no facades).
//
// Beats:
//   1. Stress-test Kepler equation solvers with boundary eccentricities (e=0.0, e=0.999, e=0.9999).
//   2. Stress-test orbital mechanics and vis-viva under near-zero gravitational parameters and extreme orbits.
//   3. Stress-test J2 oblateness rates across equatorial, polar, retrograde, and critical inclinations.
//   4. Stress-test attitude quaternion kinematics, zero-norm axes, and degenerate coordinate frames.
//   5. Assert all calculations complete without NaN, Inf, arithmetic exceptions, or crashes.

import "std/science/phys/relativistic/anomaly_kepler_solver.oo";
import "std/science/phys/relativistic/kepler_orbit.oo";
import "std/science/phys/relativistic/gravitational_j2_perturbation.oo";
import "std/science/phys/relativistic/attitude_quaternion.oo";
import "std/science/phys/relativistic/attitude_quaternion_vector.oo";
import "std/science/phys/relativistic/lambert_solver.oo";
import "std/science/phys/relativistic/orbital_rsw_frame.oo";
import "std/science/phys/relativistic/hohmann_transfer.oo";
import "std/science/phys/relativistic/rocket_tsiolkovsky.oo";
import "std/science/phys/relativistic/julian_date.oo";
import "std/science/phys/relativistic/relativistic_precession.oo";
import "std/science/phys/relativistic/cr3bp_pseudopotential.oo";

fn assert_finite_positive(val: Float, tag: String) {
    if val <= 0.0 {
        println("FAIL non-positive: " + tag);
        process_exit(1);
    }
}

fn assert_near(val: Float, expected: Float, tol: Float, tag: String) {
    let diff: Float = if val > expected { val - expected } else { expected - val };
    if diff > tol {
        println("FAIL assert_near: " + tag);
        process_exit(1);
    }
}

fn must_ok_f(r: Result[Float, String], tag: String) -> Float {
    return match r { Ok(v) => v, Err(_) => {
        println("FAIL expected Ok: " + tag);
        process_exit(1);
        0.0
    } };
}

pub fn main() {
    let pi: Float = 3.141592653589793;
    let mu_earth: Float = 398600441800000.0;

    // -------------------------------------------------------------
    // Beat 1: Kepler Equation Solver Boundary Eccentricities
    // -------------------------------------------------------------
    // Circular orbit (e = 0.0)
    let e_circ: Float = must_ok_f(kepler_solve_eccentric_anomaly(0.0, 0.0, 0.000001, 50), "e_circ");
    assert_near(e_circ, 0.0, 0.000000001, "e_circ");
    let nu_circ: Float = must_ok_f(kepler_eccentric_to_true(0.0, 0.0), "nu_circ");
    assert_near(nu_circ, 0.0, 0.00001, "nu_circ");

    let e_circ_half: Float = must_ok_f(kepler_solve_eccentric_anomaly(1.5707963, 0.0, 0.000001, 50), "e_circ_half");
    assert_near(e_circ_half, 1.5707963, 0.00001, "e_circ_half");

    // Extreme high eccentricity (e = 0.999)
    let e_ecc_0: Float = must_ok_f(kepler_solve_eccentric_anomaly(0.0, 0.999, 0.000001, 50), "e_ecc_0");
    assert_near(e_ecc_0, 0.0, 0.00001, "e_ecc_0");
    let e_ecc_pi: Float = must_ok_f(kepler_solve_eccentric_anomaly(pi, 0.999, 0.000001, 50), "e_ecc_pi");
    assert_near(e_ecc_pi, pi, 0.0001, "e_ecc_pi");

    let nu_ecc_pi: Float = must_ok_f(kepler_eccentric_to_true(pi, 0.999), "nu_ecc_pi");
    assert_finite_positive(nu_ecc_pi, "nu_ecc_pi");

    // Ultra-extreme eccentricity boundary (e = 0.9999)
    let e_ultra: Float = must_ok_f(kepler_solve_eccentric_anomaly(0.5, 0.9999, 0.000001, 100), "e_ultra");
    assert_finite_positive(e_ultra, "e_ultra");

    // -------------------------------------------------------------
    // Beat 2: Two-Body Dynamics & Near-Zero Central Masses
    // -------------------------------------------------------------
    let t_circ: Float = must_ok_f(kepler_orbital_period(7000000.0, mu_earth), "t_circ");
    assert_finite_positive(t_circ, "t_circ");

    let t_ecc: Float = must_ok_f(kepler_orbital_period(7000000.0, mu_earth), "t_ecc");
    assert_finite_positive(t_ecc, "t_ecc");

    // Near-zero mass (mu = 0.00001)
    let t_tiny_mu: Float = must_ok_f(kepler_orbital_period(1000.0, 0.00001), "t_tiny_mu");
    assert_finite_positive(t_tiny_mu, "t_tiny_mu");

    // Vis-viva speed under extreme parameters
    let v_circ: Float = must_ok_f(kepler_vis_viva(7000000.0, 7000000.0, mu_earth), "v_circ");
    assert_near(v_circ, 7546.05, 1.0, "v_circ");

    let v_near_zero: Float = must_ok_f(kepler_vis_viva(10.0, 100.0, 0.00001), "v_near_zero");
    assert_finite_positive(v_near_zero, "v_near_zero");

    let v_esc_earth: Float = must_ok_f(kepler_escape_speed(7000000.0, mu_earth), "v_esc_earth");
    assert_near(v_esc_earth, 10671.72, 1.0, "v_esc_earth");

    let v_esc_tiny: Float = must_ok_f(kepler_escape_speed(100.0, 0.00001), "v_esc_tiny");
    assert_finite_positive(v_esc_tiny, "v_esc_tiny");

    // -------------------------------------------------------------
    // Beat 3: J2 Perturbation Rates & Extreme Inclinations
    // -------------------------------------------------------------
    // Equatorial (inc = 0 deg)
    let r_eq: Result[J2DriftRate, String] = j2_perturbation_rates(7000.0, 0.001, 0.0, mu_earth, 6378.0, 0.00108263);
    let rates_eq: J2DriftRate = match r_eq { Ok(v) => v, Err(_) => {
        println("FAIL expected Ok: rates_eq");
        process_exit(1);
        J2DriftRate { raan_drift_rad_s: 0.0, arg_periapsis_drift_rad_s: 0.0 }
    } };
    if (rates_eq).raan_drift_rad_s >= 0.0 {
        println("FAIL rates_eq d_raan should be negative");
        process_exit(1);
    }
    assert_finite_positive((rates_eq).arg_periapsis_drift_rad_s, "rates_eq.d_argp");

    // Polar orbit (inc = 90 deg -> cos(inc) = 0 -> d_raan = 0)
    let r_pol: Result[J2DriftRate, String] = j2_perturbation_rates(7000.0, 0.001, 1.5707963267948966, mu_earth, 6378.0, 0.00108263);
    let rates_pol: J2DriftRate = match r_pol { Ok(v) => v, Err(_) => {
        println("FAIL expected Ok: rates_pol");
        process_exit(1);
        J2DriftRate { raan_drift_rad_s: 0.0, arg_periapsis_drift_rad_s: 0.0 }
    } };
    assert_near((rates_pol).raan_drift_rad_s, 0.0, 0.0000001, "rates_pol.d_raan");

    // Retrograde orbit (inc = 180 deg -> cos(inc) = -1 -> d_raan > 0)
    let r_ret: Result[J2DriftRate, String] = j2_perturbation_rates(7000.0, 0.001, pi, mu_earth, 6378.0, 0.00108263);
    let rates_ret: J2DriftRate = match r_ret { Ok(v) => v, Err(_) => {
        println("FAIL expected Ok: rates_ret");
        process_exit(1);
        J2DriftRate { raan_drift_rad_s: 0.0, arg_periapsis_drift_rad_s: 0.0 }
    } };
    assert_finite_positive((rates_ret).raan_drift_rad_s, "rates_ret.d_raan");

    // High eccentricity orbit (e = 0.999) under J2
    let r_high: Result[J2DriftRate, String] = j2_perturbation_rates(70000.0, 0.999, 0.5, mu_earth, 6378.0, 0.00108263);
    let rates_high_e: J2DriftRate = match r_high { Ok(v) => v, Err(_) => {
        println("FAIL expected Ok: rates_high_e");
        process_exit(1);
        J2DriftRate { raan_drift_rad_s: 0.0, arg_periapsis_drift_rad_s: 0.0 }
    } };
    let d_raan_high: Float = (rates_high_e).raan_drift_rad_s;
    if d_raan_high == 0.0 {
        println("FAIL rates_high_e");
        process_exit(1);
    }

    // -------------------------------------------------------------
    // Beat 4: Attitude Kinematics, Singularities & Coordinate Frames
    // -------------------------------------------------------------
    // Degenerate zero-axis quaternion constructor (must not NaN/crash)
    let zero_axis: Vector3 = vec3_new(0.0, 0.0, 0.0);
    let q_zero_axis: Quaternion = quat_from_axis_angle(zero_axis, 1.57);
    if (q_zero_axis).x != 0.0 || (q_zero_axis).y != 0.0 || (q_zero_axis).z != 0.0 {
        println("FAIL q_zero_axis");
        process_exit(1);
    }

    // Degenerate zero-norm quaternion normalization
    let q_all_zero: Quaternion = quat_new(0.0, 0.0, 0.0, 0.0);
    let q_norm_zero: Quaternion = quat_normalize(q_all_zero);
    if (q_norm_zero).w != 1.0 || (q_norm_zero).x != 0.0 {
        println("FAIL q_norm_zero");
        process_exit(1);
    }

    // Quaternion rotation with identity
    let v_test: Vector3 = vec3_new(10.0, -20.0, 30.0);
    let v_rot_id: Vector3 = quat_rotate_vector(quat_identity(), v_test);
    assert_near((v_rot_id).x, 10.0, 0.0001, "v_rot_id.x");
    assert_near((v_rot_id).y, -20.0, 0.0001, "v_rot_id.y");
    assert_near((v_rot_id).z, 30.0, 0.0001, "v_rot_id.z");

    // Collinear RSW frame generation (degenerate pos & vel)
    let pos_zero: Vector3 = vec3_new(0.0, 0.0, 0.0);
    let vel_zero: Vector3 = vec3_new(0.0, 0.0, 0.0);
    let rsw_deg: RswFrame = compute_rsw_frame(pos_zero, vel_zero);
    if (rsw_deg).r.x != 1.0 || (rsw_deg).w.z != 1.0 {
        println("FAIL rsw_deg");
        process_exit(1);
    }

    // -------------------------------------------------------------
    // Beat 5: Transfers, Propulsion & Relativistic Precessions
    // -------------------------------------------------------------
    // Equal radii Hohmann transfer (delta_v == 0)
    let hz: Result[TransferDeltaV, String] = hohmann_calculate_burns(7000.0, 7000.0, mu_earth);
    let hoh_zero: TransferDeltaV = match hz { Ok(v) => v, Err(_) => {
        println("FAIL expected Ok: hoh_zero");
        process_exit(1);
        TransferDeltaV { delta_v1_kms: 0.0, delta_v2_kms: 0.0, total_delta_v_kms: -1.0, transfer_time_s: 0.0 }
    } };
    assert_near((hoh_zero).total_delta_v_kms, 0.0, 0.00001, "hoh_zero.total_delta_v");

    // Descending Hohmann transfer (r1 > r2)
    let hd: Result[TransferDeltaV, String] = hohmann_calculate_burns(42000.0, 7000.0, mu_earth);
    let hoh_desc: TransferDeltaV = match hd { Ok(v) => v, Err(_) => {
        println("FAIL expected Ok: hoh_desc");
        process_exit(1);
        TransferDeltaV { delta_v1_kms: 0.0, delta_v2_kms: 0.0, total_delta_v_kms: -1.0, transfer_time_s: 0.0 }
    } };
    assert_finite_positive((hoh_desc).total_delta_v_kms, "hoh_desc.total_delta_v");

    // Zero-propellant Tsiolkovsky delta-v (m0 == mf)
    let dv_zero_fuel: Float = tsiolkovsky_delta_v(350.0, 5000.0, 5000.0);
    assert_near(dv_zero_fuel, 0.0, 0.00001, "dv_zero_fuel");

    // Negative calendar epoch Julian Date conversion
    let epoch_bce: Float = gregorian_to_julian_date(-500.0, 6.0, 15.0, 12.0, 0.0, 0.0);
    if epoch_bce <= 0.0 {
        println("FAIL epoch_bce.jd");
        process_exit(1);
    }

    // Relativistic perihelion advance on extreme eccentric orbit (e = 0.999)
    let rel_prec: Float = relativistic_perihelion_advance_per_orbit(70000000.0, 0.999, 5972370000000000000000000.0);
    assert_finite_positive(rel_prec, "rel_prec");

    // CR3BP pseudopotential on near-zero secondary mass (mu = 0.00001)
    let cr3bp_u: Float = must_ok_f(cr3bp_pseudopotential(0.5, 0.5, 0.0, 0.00001), "cr3bp_u");
    assert_near(cr3bp_u, 1.6642, 0.001, "cr3bp_u");

    println("probe_adversarial_astrodynamics_stress: PASSED");
    process_exit(0);
}
