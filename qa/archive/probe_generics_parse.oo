// # Probe: Parameterized Generics and Traits Parsing
//
// Logline: Verify AST and type parsing of parameterized type definitions, generic functions, and user-defined generic types.
//
// Setup: Tokenizes source containing generic struct Vector[T] and generic fn map[T, U], parses via ast_parse and ty_parse_at.
//
// Beats:
//   1. Parse generic struct type Vector[T] = struct { len: Int, cap: Int };
//   2. Parse generic function fn map[T, U](v: Vector[T]) -> Vector[U] { return v; };
//   3. Parse parameterized type token stream Vector[Int] via ty_parse_at;
//   4. Assert all AST representations match expected shapes and exit 0.

import "ast/ast_parse.oo";
import "lex/token_fmt.oo";
import "types/ty_parse.oo";

pub fn main(sys: &ProcessCap) {
    let src = "type Vector[T] = struct { len: Int, cap: Int };\nfn map[T, U](v: Vector[T]) -> Vector[U] { return v; }\n";
    let toks: List[String] = tokenize_lines(src);
    let ast_str: String = ast_parse(toks);

    if !str_contains(ast_str, "AstType(Vector,") {
        println("ERR\tmissing AstType(Vector");
        process_exit(1);
    }
    if !str_contains(ast_str, "AstField(len,TyInt)") {
        println("ERR\tmissing AstField len");
        process_exit(1);
    }
    if !str_contains(ast_str, "AstFn(map,") {
        println("ERR\tmissing AstFn(map");
        process_exit(1);
    }

    let ty_src = "Vector[Int]";
    let ty_toks: List[String] = tokenize_lines(ty_src);
    let n: Int = list_len(ty_toks);
    let res: List[String] = ty_parse_at(ty_toks, 0, n);
    let parsed_ty: String = list_get(res, 1);

    if !str_contains(parsed_ty, "Vector[TyInt]") {
        println("ERR\tunexpected parsed ty: " + parsed_ty);
        process_exit(1);
    }

    println("OK probe_generics_parse");
}
