// # Master openOODA x86/ELF64 Codegen E2E Test Suite Runner
//
// Logline: Orchestrate the 4 tiers of opaque-box E2E tests for the direct x86 machine code and pure ELF64 pipeline under a hermetic env -i subshell, with OODA_REPO_ROOT-derived FS confinement, in-tree path containment, and real outcome capture (each suite must print its "N/N TESTS EXECUTED" full-pass marker — process exit alone is insufficient because the tier files only assert the test *count*, not the *pass count*).
//
// Setup: Requires &ProcessCap for subshell invocation, &EnvCap for OODA_REPO_ROOT resolution. No ambient authority; every precondition is fail-closed.
//
// Beats:
//   1. Beat 1: Resolve OODA_REPO_ROOT via &EnvCap; reject unset, metacharacter, traversal, or relative paths; derive OODA_FS_READDIR/OODA_FS_WRITEDIR from the validated root.
//   2. Beat 2: Apply is_hermetic_in_tree_path and has_shell_metachar to every tier suite path; reject absolute, tilde-prefixed, parent-traversal, or metachar-bearing paths.
//   3. Beat 3: Invoke Tier 1 (Feature Coverage, 25 tests), Tier 2 (Boundary & Corner Cases, 25 tests), Tier 3 (Pairwise Cross-Feature, 5 tests), and Tier 4 (Real-World Workloads, 5 tests) inside an env -i hermetic subshell after `cd` to the validated OODA_REPO_ROOT.
//   4. Beat 4: Capture each suite's stdout and require the literal full-pass marker (e.g. "25/25 TESTS EXECUTED" or "5/5 TESTS EXECUTED") — closes the Red 3 silent-fallback vector where the tier file would exit 0 on a degraded "0/25 pass" run.
//   5. Beat 5: Emit per-tier verdict and consolidated master summary; process_exit(1) on any tier that did not emit its full-pass marker.

fn has_shell_metachar(s: String) -> Bool {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = str_slice(s, i, i + 1);
        if c == ";" || c == "|" || c == "$" || c == "`" || c == "&" || c == "<" || c == ">" || c == "(" || c == ")" || c == "{" || c == "}" || c == "[" || c == "]" || c == "\"" || c == "'" || c == "\\" || c == "\n" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn is_hermetic_in_tree_path(path: String) -> Bool {
    if str_starts_with(path, "/") { return false; }
    if str_starts_with(path, "~") { return false; }
    if str_index_of(path, "..") >= 0 { return false; }
    return true;
}

fn contains_full_pass_marker(out: String, expected: String) -> Bool {
    return str_contains(out, expected);
}

fn run_tier_suite(p: &ProcessCap, root: String, suite_file: String, tier_name: String, pass_marker: String) -> Bool {
    if !is_hermetic_in_tree_path(suite_file) {
        println("[E2E RUNNER] [FAIL] " + tier_name + " (out-of-tree path rejected by Red 4)");
        return false;
    }
    if has_shell_metachar(suite_file) {
        println("[E2E RUNNER] [FAIL] " + tier_name + " (shell metacharacter in path)");
        return false;
    }
    println("\n================================================================================");
    println("[E2E RUNNER] Starting Suite: " + tier_name);
    println("================================================================================");
    let cmd: String = "cd '" + root + "' && env -i HOME=/tmp PATH=/usr/bin:/bin OODA_REPO_ROOT='" + root + "' OODA_FS_READDIR='" + root + "' OODA_FS_WRITEDIR='" + root + "' ./ooda/bin/ooda run " + suite_file;
    let res: Result[String, String] = process_exec(p, cmd);
    let out: String = match res { Ok(s) => s, Err(e) => e };
    println(out);
    if !res.is_ok() {
        println("[E2E RUNNER] [FAIL] " + tier_name + " (process exec error)");
        return false;
    }
    if !contains_full_pass_marker(out, pass_marker) {
        println("[E2E RUNNER] [FAIL] " + tier_name + " (missing full-pass marker '" + pass_marker + "')");
        return false;
    }
    println("[E2E RUNNER] [PASS] " + tier_name);
    return true;
}

pub fn main(p: &ProcessCap, env: &EnvCap) {
    let root_r: Result[String, String] = env_get(env, "OODA_REPO_ROOT");
    let root: String = match root_r { Ok(v) => v, Err(_) => "" };
    if chars_len(root) == 0 { println("FAIL [E2E] OODA_REPO_ROOT unset"); process_exit(1); }
    if has_shell_metachar(root) { println("FAIL [E2E] OODA_REPO_ROOT contains shell metacharacters"); process_exit(1); }
    if str_contains(root, "..") { println("FAIL [E2E] OODA_REPO_ROOT contains '..'"); process_exit(1); }
    if !str_starts_with(root, "/") { println("FAIL [E2E] OODA_REPO_ROOT must be absolute"); process_exit(1); }

    println("################################################################################");
    println("# openOODA x86/ELF64 Codegen Master E2E Test Suite (Tiers 1 - 4)              #");
    println("################################################################################");

    let mut suites_passed: Int = 0;

    // Tier 1: Feature Coverage — expect "25/25 TESTS EXECUTED" in stdout
    if run_tier_suite(p, root, "qa/tests_x86_e2e/test_tier1_features.oo", "Tier 1: Feature Coverage (25 Tests)", "25/25 TESTS EXECUTED") {
        suites_passed = suites_passed + 1;
    }

    // Tier 2: Boundary & Corner Cases — expect "25/25 TESTS EXECUTED"
    if run_tier_suite(p, root, "qa/tests_x86_e2e/test_tier2_boundaries.oo", "Tier 2: Boundary & Corner Cases (25 Tests)", "25/25 TESTS EXECUTED") {
        suites_passed = suites_passed + 1;
    }

    // Tier 3: Pairwise Cross-Feature — expect "5/5 TESTS EXECUTED"
    if run_tier_suite(p, root, "qa/tests_x86_e2e/test_tier3_pairwise.oo", "Tier 3: Pairwise Cross-Feature Scenarios (5 Tests)", "5/5 TESTS EXECUTED") {
        suites_passed = suites_passed + 1;
    }

    // Tier 4: Real-World Workloads — expect "5/5 TESTS EXECUTED"
    if run_tier_suite(p, root, "qa/tests_x86_e2e/test_tier4_workloads.oo", "Tier 4: Real-World Domain Workloads (5 Tests)", "5/5 TESTS EXECUTED") {
        suites_passed = suites_passed + 1;
    }

    println("\n################################################################################");
    println("# MASTER E2E RUN SUMMARY                                                       #");
    println("################################################################################");
    println("  Total Test Suites Executed: 4");
    println("  Suites with Full-Pass Marker: " + suites_passed.to_string() + " / 4");
    println("  Total Discrete Test Probes: 60 (25 Tier 1 + 25 Tier 2 + 5 Tier 3 + 5 Tier 4)");
    println("################################################################################");

    if suites_passed == 4 {
        println("\n>>> MASTER E2E VERIFICATION GATE: [APPROVE] ALL 4 TIERS EMITTED FULL-PASS MARKER <<<");
        process_exit(0);
    } else {
        println("\n>>> MASTER E2E VERIFICATION GATE: [REJECT] ONE OR MORE TIERS DID NOT EMIT FULL-PASS MARKER <<<");
        process_exit(1);
    }
}
