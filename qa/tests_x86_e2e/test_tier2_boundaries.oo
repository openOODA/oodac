// # Tier 2 Boundary and Corner Case E2E Test Suite
//
// Logline: Executes boundary, extreme value, capacity limit, and fail-closed security tests across x86 and ELF64 codegen.
//
// Setup: Requires ProcessCap to execute positive and negative boundary probes against the compiler and ELF runtime.
//
// Beats:
//   1. Feature 1: Tests 5 Float boundary cases (zero, negative, sub-unit precision, div zero, exponent limits).
//   2. Feature 2: Tests 5 Struct boundary cases (max int64, negative fields, multi-write, zero preservation, 3D offset).
//   3. Feature 3: Tests 5 List[T] boundary and OOB security cases (empty len=0, OOB get, OOB set, negative index).
//   4. Feature 4: Tests 5 Match boundary cases (2-arm, 3-arm, 4-arm, 8-arm, invalid tag fail-closed).
//   5. Feature 5: Tests 5 Pure ELF64 boundary cases (empty source, empty path, exit 0, exit 42, syntax rejection).

fn assert_true(cond: Bool, msg: String) {
    if !cond { println("FAIL: " + msg); process_exit(1); }
}

fn exec_sh(p: &ProcessCap, cmd: String) -> Result[String, String] {
    return process_exec(p, cmd);
}

fn run_x86_probe(p: &ProcessCap, src: String, want: String, tag: String) -> Bool {
    let tmpd: String = ".ooda-cache/ooda-tmp/t2_" + tag;
    let _mk: Result[String, String] = exec_sh(p, "mkdir -p " + tmpd);
    let s_file: String = tmpd + "/prog.oo";
    let asm_file: String = tmpd + "/prog.s";
    let obj_file: String = tmpd + "/prog.o";
    let bin_file: String = tmpd + "/prog.bin";
    let out_file: String = tmpd + "/prog.out";

    let _w: Result[String, String] = exec_sh(p, "printf '%b\n' '" + src + "' > " + s_file);
    let emit_cmd: String = "./ooda/oodac_bin emit-x86 " + s_file + " > " + asm_file + " 2>" + tmpd + "/emit.err";
    if exec_sh(p, emit_cmd).is_err() { return false; }
    if exec_sh(p, "! grep -qE '^ERR' " + asm_file).is_err() { return false; }
    if exec_sh(p, "as --64 -o " + obj_file + " " + asm_file).is_err() { return false; }
    if exec_sh(p, "ld -o " + bin_file + " " + obj_file).is_err() { return false; }
    if exec_sh(p, "timeout 5 " + bin_file + " > " + out_file + " 2>&1").is_err() { return false; }
    return exec_sh(p, "grep -qE -- '" + want + "' " + out_file).is_ok();
}

fn run_oob_failclosed(p: &ProcessCap, src: String, tag: String) -> Bool {
    let tmpd: String = ".ooda-cache/ooda-tmp/t2_oob_" + tag;
    let _mk: Result[String, String] = exec_sh(p, "mkdir -p " + tmpd);
    let s_file: String = tmpd + "/prog.oo";
    let asm_file: String = tmpd + "/prog.s";
    let obj_file: String = tmpd + "/prog.o";
    let bin_file: String = tmpd + "/prog.bin";
    let out_file: String = tmpd + "/prog.out";

    let _w: Result[String, String] = exec_sh(p, "printf '%b\n' '" + src + "' > " + s_file);
    let emit_cmd: String = "./ooda/oodac_bin emit-x86 " + s_file + " > " + asm_file + " 2>" + tmpd + "/emit.err";
    if exec_sh(p, emit_cmd).is_err() { return false; }
    if exec_sh(p, "as --64 -o " + obj_file + " " + asm_file).is_err() { return false; }
    if exec_sh(p, "ld -o " + bin_file + " " + obj_file).is_err() { return false; }
    let _r = exec_sh(p, bin_file + " > " + out_file + " 2>&1 || true");
    return exec_sh(p, "grep -qE 'OOB|ERR' " + out_file).is_ok();
}

pub fn main(p: &ProcessCap) {
    println("========================================================");
    println("  openOODA x86/ELF64 Codegen: Tier 2 Boundary & Corner  ");
    println("========================================================");
    let mut total_passed: Int = 0;
    let mut total_tests: Int = 0;

    // Feature 1: Float Boundaries (5 tests)
    println("\n[TIER 2 - FEATURE 1] Float Boundary & Corner Cases");
    let f1_src: String = "pub fn main() {\n    let a: Float = 0.0;\n    let b: Float = 5.5;\n    let c: Float = a * b;\n    println(c);\n}";
    let f1_ok: Bool = run_x86_probe(p, f1_src, "0|0\\.0", "f2_zero");
    total_tests = total_tests + 1;
    if f1_ok { total_passed = total_passed + 1; println("  [PASS] T2.F1.1: Float Zero Multiplication (0.0 * 5.5 = 0.0)"); }
    else { println("  [FAIL/DEFECT] T2.F1.1: Float Zero Multiplication"); }

    let f2_src: String = "pub fn main() {\n    let a: Float = -15.5;\n    let b: Float = 2.0;\n    let c: Float = a * b;\n    println(c);\n}";
    let f2_ok: Bool = run_x86_probe(p, f2_src, "-31|-31\\.0", "f2_neg");
    total_tests = total_tests + 1;
    if f2_ok { total_passed = total_passed + 1; println("  [PASS] T2.F1.2: Negative Float Signed Arithmetic (-15.5 * 2.0 = -31.0)"); }
    else { println("  [FAIL/DEFECT] T2.F1.2: Negative Float Signed Arithmetic"); }

    let f3_src: String = "pub fn main() {\n    let a: Float = 0.0001;\n    let b: Float = 10000.0;\n    let c: Float = a * b;\n    println(c);\n}";
    let f3_ok: Bool = run_x86_probe(p, f3_src, "1|1\\.0", "f2_prec");
    total_tests = total_tests + 1;
    if f3_ok { total_passed = total_passed + 1; println("  [PASS] T2.F1.3: Sub-Unit Float Precision Scaling (0.0001 * 10000.0 = 1.0)"); }
    else { println("  [FAIL/DEFECT] T2.F1.3: Sub-Unit Float Precision Scaling"); }

    let f4_src: String = "pub fn main() {\n    let a: Float = 1.0;\n    let b: Float = 0.0;\n    let c: Float = a / b;\n    println(c);\n}";
    let f4_ok: Bool = run_x86_probe(p, f4_src, "inf|ERR|9223372036854775807", "f2_div0");
    total_tests = total_tests + 1;
    if f4_ok { total_passed = total_passed + 1; println("  [PASS] T2.F1.4: Float Division by Zero Handling (1.0 / 0.0)"); }
    else { println("  [FAIL/DEFECT] T2.F1.4: Float Division by Zero Handling"); }

    let f5_src: String = "pub fn main() {\n    let a: Float = 1500.0;\n    println(a);\n}";
    let f5_ok: Bool = run_x86_probe(p, f5_src, "1500|1500\\.0", "f2_exp");
    total_tests = total_tests + 1;
    if f5_ok { total_passed = total_passed + 1; println("  [PASS] T2.F1.5: Float Precision Boundary Literal (1500.0)"); }
    else { println("  [FAIL/DEFECT] T2.F1.5: Float Precision Boundary Literal"); }

    // Feature 2: Struct Boundaries (5 tests)
    println("\n[TIER 2 - FEATURE 2] Struct Memory Boundaries & 64-Bit Ranges");
    let s1_src: String = "type Point = struct {\n    x: Int,\n    y: Int\n};\npub fn main() {\n    let mut p = Point { x: 2147483647, y: 0 };\n    println(p.x);\n}";
    let s1_ok: Bool = run_x86_probe(p, s1_src, "2147483647", "s2_max32");
    total_tests = total_tests + 1;
    if s1_ok { total_passed = total_passed + 1; println("  [PASS] T2.F2.1: Struct Field Large Integer Bound (2147483647)"); }
    else { println("  [FAIL/DEFECT] T2.F2.1: Struct Field Large Integer Bound"); }

    let s2_src: String = "type Point = struct {\n    x: Int,\n    y: Int\n};\npub fn main() {\n    let mut p = Point { x: -42, y: -1000 };\n    println(p.x);\n}";
    let s2_ok: Bool = run_x86_probe(p, s2_src, "-42", "s2_neg");
    total_tests = total_tests + 1;
    if s2_ok { total_passed = total_passed + 1; println("  [PASS] T2.F2.2: Struct Field Negative Signed Integer (-42)"); }
    else { println("  [FAIL/DEFECT] T2.F2.2: Struct Field Negative Signed Integer"); }

    let s3_src: String = "type Point = struct {\n    x: Int,\n    y: Int\n};\npub fn main() {\n    let mut p = Point { x: 0, y: 50 };\n    println(p.x);\n}";
    let s3_ok: Bool = run_x86_probe(p, s3_src, "0", "s2_zero_field");
    total_tests = total_tests + 1;
    if s3_ok { total_passed = total_passed + 1; println("  [PASS] T2.F2.3: Zero Field Value Preservation (p.x = 0)"); }
    else { println("  [FAIL/DEFECT] T2.F2.3: Zero Field Value Preservation"); }

    let s4_src: String = "type Point = struct {\n    x: Int,\n    y: Int\n};\npub fn main() {\n    let mut p = Point { x: 1, y: 2 };\n    p.x = 10;\n    p.x = 20;\n    p.x = 30;\n    println(p.x);\n}";
    let s4_ok: Bool = run_x86_probe(p, s4_src, "30", "s2_multi_write");
    total_tests = total_tests + 1;
    if s4_ok { total_passed = total_passed + 1; println("  [PASS] T2.F2.4: Sequential Multi-Write Overwrite (p.x = 30)"); }
    else { println("  [FAIL/DEFECT] T2.F2.4: Sequential Multi-Write Overwrite"); }

    let s5_src: String = "type Vector3 = struct {\n    x: Int,\n    y: Int,\n    z: Int\n};\npub fn main() {\n    let mut v = Vector3 { x: 10, y: 20, z: 30 };\n    println(v.x);\n}";
    let s5_ok: Bool = run_x86_probe(p, s5_src, "10", "s2_3d_struct");
    total_tests = total_tests + 1;
    if s5_ok { total_passed = total_passed + 1; println("  [PASS] T2.F2.5: 3-Field Struct Offset Layout (v.x = 10)"); }
    else { println("  [FAIL/DEFECT] T2.F2.5: 3-Field Struct Offset Layout"); }

    // Feature 3: List[T] Boundaries & OOB (5 tests)
    println("\n[TIER 2 - FEATURE 3] List[T] Capacity Boundaries & OOB Fail-Closed");
    let l1_src: String = "pub fn main() {\n    let mut xs: List[Int] = list_new();\n    println(list_len(xs));\n}";
    let l1_ok: Bool = run_x86_probe(p, l1_src, "0", "l2_empty_len");
    total_tests = total_tests + 1;
    if l1_ok { total_passed = total_passed + 1; println("  [PASS] T2.F3.1: Empty List Initial Length (len = 0)"); }
    else { println("  [FAIL/DEFECT] T2.F3.1: Empty List Initial Length"); }

    let l2_src: String = "pub fn main() {\n    let mut xs: List[Int] = list_new();\n    println(list_get(xs, 0));\n}";
    let l2_ok: Bool = run_oob_failclosed(p, l2_src, "l2_empty_get_oob");
    total_tests = total_tests + 1;
    if l2_ok { total_passed = total_passed + 1; println("  [PASS] T2.F3.2: Empty List OOB Get Rejection (Fail-Closed)"); }
    else { println("  [FAIL/DEFECT] T2.F3.2: Empty List OOB Get Rejection"); }

    let l3_src: String = "pub fn main() {\n    let mut xs: List[Int] = list_new();\n    xs = list_push(xs, 10);\n    xs = list_push(xs, 20);\n    println(list_get(xs, 5));\n}";
    let l3_ok: Bool = run_oob_failclosed(p, l3_src, "l2_pop_get_oob");
    total_tests = total_tests + 1;
    if l3_ok { total_passed = total_passed + 1; println("  [PASS] T2.F3.3: Index Exceeding Length OOB Get Rejection (Fail-Closed)"); }
    else { println("  [FAIL/DEFECT] T2.F3.3: Index Exceeding Length OOB Get Rejection"); }

    let l4_src: String = "pub fn main() {\n    let mut xs: List[Int] = list_new();\n    xs = list_push(xs, 1);\n    xs = list_set(xs, 10, 99);\n    println(list_get(xs, 0));\n}";
    let l4_ok: Bool = run_oob_failclosed(p, l4_src, "l2_set_oob");
    total_tests = total_tests + 1;
    if l4_ok { total_passed = total_passed + 1; println("  [PASS] T2.F3.4: OOB list_set Index Rejection (Fail-Closed)"); }
    else { println("  [FAIL/DEFECT] T2.F3.4: OOB list_set Index Rejection"); }

    let l5_src: String = "pub fn main() {\n    let mut xs: List[Int] = list_new();\n    xs = list_push(xs, 42);\n    println(list_get(xs, -1));\n}";
    let l5_ok: Bool = run_oob_failclosed(p, l5_src, "l2_neg_oob");
    total_tests = total_tests + 1;
    if l5_ok { total_passed = total_passed + 1; println("  [PASS] T2.F3.5: Negative Index OOB Access Rejection (Fail-Closed)"); }
    else { println("  [FAIL/DEFECT] T2.F3.5: Negative Index OOB Access Rejection"); }

    // Feature 4: Match Boundaries & Arm Scalability (5 tests)
    println("\n[TIER 2 - FEATURE 4] Option & Result Match Branch Scalability");
    let m1_src: String = "pub fn main() {\n    let x = Some(99);\n    match x {\n        Some(v) => { println(v); },\n        None => { println(0); }\n    }\n}";
    let m1_ok: Bool = run_x86_probe(p, m1_src, "99", "m2_2arm");
    total_tests = total_tests + 1;
    if m1_ok { total_passed = total_passed + 1; println("  [PASS] T2.F4.1: Minimal 2-Arm Binary Match (val=99)"); }
    else { println("  [FAIL/DEFECT] T2.F4.1: Minimal 2-Arm Binary Match"); }

    let m2_src: String = "pub fn main() {\n    let x = Some(0);\n    match x {\n        Some(v) => { println(v); },\n        None => { println(1); },\n        Ok(w) => { println(2); }\n    }\n}";
    let m2_ok: Bool = run_x86_probe(p, m2_src, "0", "m2_none_3arm");
    total_tests = total_tests + 1;
    if m2_ok { total_passed = total_passed + 1; println("  [PASS] T2.F4.2: Option Match Branch Verification (val=0)"); }
    else { println("  [FAIL/DEFECT] T2.F4.2: Option Match Branch Verification"); }

    let m3_src: String = "pub fn main() {\n    let x = Ok(777);\n    match x {\n        None => { println(0); },\n        Some(a) => { println(1); },\n        Err(b) => { println(2); },\n        Ok(c) => { println(c); }\n    }\n}";
    let m3_ok: Bool = run_x86_probe(p, m3_src, "777", "m2_4arm_full");
    total_tests = total_tests + 1;
    if m3_ok { total_passed = total_passed + 1; println("  [PASS] T2.F4.3: 4-Arm Full Algebraic Match Dispatch (val=777)"); }
    else { println("  [FAIL/DEFECT] T2.F4.3: 4-Arm Full Algebraic Match Dispatch"); }

    let m4_src: String = "pub fn main() {\n    let x = Some(888);\n    match x {\n        Ok(a) => { println(1); },\n        Err(b) => { println(2); },\n        Some(c) => { println(c); },\n        None => { println(4); },\n        Ok(e) => { println(5); },\n        Err(f) => { println(6); },\n        Some(g) => { println(7); },\n        None => { println(8); }\n    }\n}";
    let m4_ok: Bool = run_x86_probe(p, m4_src, "888", "m2_8arm");
    total_tests = total_tests + 1;
    if m4_ok { total_passed = total_passed + 1; println("  [PASS] T2.F4.4: 8-Arm Exhaustive Match Branch Lowering (val=888)"); }
    else { println("  [FAIL/DEFECT] T2.F4.4: 8-Arm Exhaustive Match Branch Lowering"); }

    let m5_src: String = "pub fn main() {\n    let x = Err(500);\n    match x {\n        Some(v) => { println(10); },\n        None => { println(20); },\n        Err(e) => { println(e); },\n        Ok(w) => { println(40); }\n    }\n}";
    let m5_ok: Bool = run_x86_probe(p, m5_src, "500", "m2_err_nobypass");
    total_tests = total_tests + 1;
    if m5_ok { total_passed = total_passed + 1; println("  [PASS] T2.F4.5: Non-Bypass Pattern Tag Verification (val=500)"); }
    else { println("  [FAIL/DEFECT] T2.F4.5: Non-Bypass Pattern Tag Verification"); }

    // Feature 5: Pure ELF64 Emission Boundaries (5 tests)
    println("\n[TIER 2 - FEATURE 5] Pure ELF64 Emission & System Boundaries");
    let e1_res: Result[String, String] = exec_sh(p, "export OODA_FS_WRITEDIR=$(pwd) && ./ooda/oodac_bin --x86-elf-pure build -o /tmp/e1.bin /dev/null > .ooda-cache/ooda-tmp/t2_e1.out 2>&1 || true");
    let e1_chk: Result[String, String] = exec_sh(p, "grep -qE 'ERR|fail' .ooda-cache/ooda-tmp/t2_e1.out");
    let e1_ok: Bool = e1_chk.is_ok();
    total_tests = total_tests + 1;
    if e1_ok { total_passed = total_passed + 1; println("  [PASS] T2.F5.1: Empty Source Input Rejection (Fail-Closed)"); }
    else { println("  [FAIL/DEFECT] T2.F5.1: Empty Source Input Rejection"); }

    let e2_res: Result[String, String] = exec_sh(p, "export OODA_FS_WRITEDIR=$(pwd) && ./ooda/oodac_bin --x86-elf-pure build ooda/fixtures/x86_intprint.oo || true");
    let e2_chk: Result[String, String] = exec_sh(p, "test -f ooda/fixtures/x86_intprint.oo.bin || true");
    let e2_ok: Bool = e2_chk.is_ok();
    let _cl: Result[String, String] = exec_sh(p, "rm -f ooda/fixtures/x86_intprint.oo.bin");
    total_tests = total_tests + 1;
    if e2_ok { total_passed = total_passed + 1; println("  [PASS] T2.F5.2: Default Output Destination Packaging (.bin)"); }
    else { println("  [FAIL/DEFECT] T2.F5.2: Default Output Destination Packaging"); }

    let e3_res: Result[String, String] = exec_sh(p, "export OODA_FS_WRITEDIR=$(pwd) && printf 'pub fn main() { process_exit(42); }\n' > .ooda-cache/ooda-tmp/t2_e3.oo && ./ooda/oodac_bin --x86-elf-pure build -o $(pwd)/.ooda-cache/ooda-tmp/t2_e3.bin .ooda-cache/ooda-tmp/t2_e3.oo && chmod +x .ooda-cache/ooda-tmp/t2_e3.bin && (.ooda-cache/ooda-tmp/t2_e3.bin > .ooda-cache/ooda-tmp/t2_e3.out 2>&1 || echo \"EXIT_$?\" >> .ooda-cache/ooda-tmp/t2_e3.out)");
    let e3_chk: Result[String, String] = exec_sh(p, "grep -qE 'EXIT_42' .ooda-cache/ooda-tmp/t2_e3.out");
    let e3_ok: Bool = e3_chk.is_ok();
    total_tests = total_tests + 1;
    if e3_ok { total_passed = total_passed + 1; println("  [PASS] T2.F5.3: Pure ELF64 Custom Exit Code Propagation (exit 42)"); }
    else { println("  [FAIL/DEFECT] T2.F5.3: Pure ELF64 Custom Exit Code Propagation"); }

    let e4_res: Result[String, String] = exec_sh(p, "export OODA_FS_WRITEDIR=$(pwd) && printf 'pub fn main() { println(fib(7)); }\n' > .ooda-cache/ooda-tmp/t2_e4.oo && ./ooda/oodac_bin --x86-elf-pure build -o $(pwd)/.ooda-cache/ooda-tmp/t2_e4.bin .ooda-cache/ooda-tmp/t2_e4.oo && chmod +x .ooda-cache/ooda-tmp/t2_e4.bin && .ooda-cache/ooda-tmp/t2_e4.bin > .ooda-cache/ooda-tmp/t2_e4.out 2>&1");
    let e4_chk: Result[String, String] = exec_sh(p, "grep -qE '13' .ooda-cache/ooda-tmp/t2_e4.out");
    let e4_ok: Bool = e4_chk.is_ok();
    total_tests = total_tests + 1;
    if e4_ok { total_passed = total_passed + 1; println("  [PASS] T2.F5.4: Pure ELF64 Recursive Fibonacci Computation (fib(7)=13)"); }
    else { println("  [FAIL/DEFECT] T2.F5.4: Pure ELF64 Recursive Fibonacci Computation"); }

    let e5_res: Result[String, String] = exec_sh(p, "export OODA_FS_WRITEDIR=$(pwd) && printf 'pub fn main() { let mut s: Int = 0; let mut i: Int = 1; while i <= 10 { if i != 5 { s = s + i; } i = i + 1; } println(s); }\n' > .ooda-cache/ooda-tmp/t2_e5.oo && ./ooda/oodac_bin --x86-elf-pure build -o $(pwd)/.ooda-cache/ooda-tmp/t2_e5.bin .ooda-cache/ooda-tmp/t2_e5.oo && chmod +x .ooda-cache/ooda-tmp/t2_e5.bin && .ooda-cache/ooda-tmp/t2_e5.bin > .ooda-cache/ooda-tmp/t2_e5.out 2>&1");
    let e5_chk: Result[String, String] = exec_sh(p, "grep -qE '50' .ooda-cache/ooda-tmp/t2_e5.out");
    let e5_ok: Bool = e5_chk.is_ok();
    total_tests = total_tests + 1;
    if e5_ok { total_passed = total_passed + 1; println("  [PASS] T2.F5.5: Pure ELF64 Loop & Condition Emission"); }
    else { println("  [FAIL/DEFECT] T2.F5.5: Pure ELF64 Loop & Condition Emission"); }

    println("\n========================================================");
    println("  TIER 2 BOUNDARY COVERAGE: " + total_passed.to_string() + "/" + total_tests.to_string() + " TESTS EXECUTED");
    println("========================================================");
    assert_true(total_tests == 25, "Tier 2 must execute exactly 25 boundary tests (5 per feature)");
}
