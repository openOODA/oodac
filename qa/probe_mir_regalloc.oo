// # Probe: Linear Scan Register Allocator and Direct ELF Lowering
//
// Logline: Verify MIR register allocation, interval expiration, spilling, and ELF machine code emission.
//
// Setup: Pure compute test harness exercising mir_regalloc and direct ELF lowering without external tools.
//
// Beats:
//   1. Verify physical register assignment within pool bounds.
//   2. Verify interval expiration and physical register reuse on disjoint ranges.
//   3. Verify deterministic stack spill slot allocation under register pressure.
//   4. Verify direct x86-64 machine code and ELF64 header emission.

import "mir/anchor.oo";
import "emit/elf/elf_emit.oo";

fn test_regalloc_basic() {
    let mut ra: MirRegAlloc = mir_regalloc_new();
    mir_regalloc_add(&mut ra, "%v0", 0, 4);
    mir_regalloc_add(&mut ra, "%v1", 1, 4);
    mir_regalloc_add(&mut ra, "%v2", 2, 4);
    mir_regalloc_solve(&mut ra, 4);
    let p0: Int = mir_regalloc_lookup_phys(&ra, "%v0");
    let p1: Int = mir_regalloc_lookup_phys(&ra, "%v1");
    let p2: Int = mir_regalloc_lookup_phys(&ra, "%v2");
    if p0 != 0 || p1 != 1 || p2 != 2 {
        println("ERR\tprobe_mir_regalloc\tbasic allocation mismatch");
        process_exit(1);
    }
    if mir_regalloc_spill_count(&ra) != 0 {
        println("ERR\tprobe_mir_regalloc\texpected 0 spills");
        process_exit(1);
    }
}

fn test_regalloc_reuse() {
    let mut ra: MirRegAlloc = mir_regalloc_new();
    mir_regalloc_add(&mut ra, "%t0", 0, 1);
    mir_regalloc_add(&mut ra, "%t1", 0, 3);
    mir_regalloc_add(&mut ra, "%t2", 2, 3);
    mir_regalloc_solve(&mut ra, 2);
    let p0: Int = mir_regalloc_lookup_phys(&ra, "%t0");
    let p1: Int = mir_regalloc_lookup_phys(&ra, "%t1");
    let p2: Int = mir_regalloc_lookup_phys(&ra, "%t2");
    if p0 != 0 || p1 != 1 || p2 != 0 {
        println("ERR\tprobe_mir_regalloc\texpiration reuse mismatch");
        process_exit(1);
    }
    if mir_regalloc_spill_count(&ra) != 0 {
        println("ERR\tprobe_mir_regalloc\texpected 0 spills on reuse");
        process_exit(1);
    }
}

fn test_regalloc_spill() {
    let mut ra: MirRegAlloc = mir_regalloc_new();
    mir_regalloc_add(&mut ra, "%s0", 0, 5);
    mir_regalloc_add(&mut ra, "%s1", 0, 5);
    mir_regalloc_add(&mut ra, "%s2", 1, 5);
    mir_regalloc_solve(&mut ra, 2);
    let p0: Int = mir_regalloc_lookup_phys(&ra, "%s0");
    let p1: Int = mir_regalloc_lookup_phys(&ra, "%s1");
    let s2: Int = mir_regalloc_lookup_spill(&ra, "%s2");
    if p0 != 0 || p1 != 1 || s2 != 0 {
        println("ERR\tprobe_mir_regalloc\tspill assignment mismatch");
        process_exit(1);
    }
    if mir_regalloc_spill_count(&ra) != 1 {
        println("ERR\tprobe_mir_regalloc\texpected exactly 1 spill");
        process_exit(1);
    }
}

fn test_mir_elf_emission() {
    let mut insts: List[MirInst] = list_new();
    let op0: MirOpnd = mir_opnd_imm_int(42, "i64");
    insts = list_push(insts, mir_inst_1("mov", "i64", "%v0", op0, 1, 1, 0));
    let op1: MirOpnd = mir_opnd_imm_int(58, "i64");
    insts = list_push(insts, mir_inst_1("mov", "i64", "%v1", op1, 2, 1, 0));
    let mut add_args: List[MirOpnd] = list_new();
    add_args = list_push(add_args, mir_opnd_reg("v0", "i64"));
    add_args = list_push(add_args, mir_opnd_reg("v1", "i64"));
    insts = list_push(insts, mir_inst_make("add", "i64", "%v0", "", 3, 1, 0));
    let elf_img: String = elf_emit_mir_program(insts, "100\n");
    if chars_len(elf_img) < 120 {
        println("ERR\tprobe_mir_regalloc\telf binary image too small");
        process_exit(1);
    }
    if mir_reg_name(0) != "rax" || mir_reg_name(1) != "rcx" {
        println("ERR\tprobe_mir_regalloc\tregister naming mismatch");
        process_exit(1);
    }
}

pub fn main() {
    test_regalloc_basic();
    test_regalloc_reuse();
    test_regalloc_spill();
    test_mir_elf_emission();
    println("OK");
}
