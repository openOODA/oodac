// # Probe: Result-kind mismatch at let and assign cannot ship
//
// Logline: oodac check and build of Ok(String) and String-Result callee at annotated let and mut-assign must ERR and leave no ELF.
//
// Setup: ProcessCap + EnvCap + FsReadCap. Host is OODA_COMPILER. Out paths under .ooda-cache/ooda-tmp.
//
// Beats:
//   1. check and build of probe_result_let_ok_str.oo are ERR; ELF absent.
//   2. check and build of probe_result_let_callee.oo are ERR; ELF absent.
//   3. check and build of probe_result_assign_ok_str.oo are ERR; ELF absent.
//   4. check and build of probe_result_assign_callee.oo are ERR; ELF absent.

fn refuse_kind(p: &ProcessCap, fs_r: &FsReadCap, host: String, src: String, out: String) {
    let ca: Result[String, String] = sys_exec(p, host, "check", src);
    if ca.is_ok() {
        println("ERR\tcheck must fail\t" + src);
        process_exit(1);
    }
    let ct: String = ca.val;
    if str_index_of(ct, "ERR") < 0 {
        println("ERR\tcheck silent\t" + src);
        process_exit(1);
    }
    let ba: Result[String, String] = sys_exec(p, host, "build", src, "-o", out);
    if ba.is_ok() {
        println("ERR\tbuild must fail\t" + src);
        process_exit(1);
    }
    let bt: String = ba.val;
    if str_index_of(bt, "ERR") < 0 {
        println("ERR\tbuild silent\t" + src);
        process_exit(1);
    }
    if path_exists(fs_r, out) {
        println("ERR\tELF shipped\t" + src);
        process_exit(1);
    }
}

pub fn main(p: &ProcessCap, env: &EnvCap, fs_r: &FsReadCap) {
    let hr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let host: String = match hr { Ok(s) => s, Err(_) => "" };
    if host == "" {
        println("ERR\tOODA_COMPILER required");
        process_exit(1);
    }
    refuse_kind(p, fs_r, host, "oodac/qa/probe_result_let_ok_str.oo", ".ooda-cache/ooda-tmp/probe_result_let_ok_str.bin");
    refuse_kind(p, fs_r, host, "oodac/qa/probe_result_let_callee.oo", ".ooda-cache/ooda-tmp/probe_result_let_callee.bin");
    refuse_kind(p, fs_r, host, "oodac/qa/probe_result_assign_ok_str.oo", ".ooda-cache/ooda-tmp/probe_result_assign_ok_str.bin");
    refuse_kind(p, fs_r, host, "oodac/qa/probe_result_assign_callee.oo", ".ooda-cache/ooda-tmp/probe_result_assign_callee.bin");
    println("OK");
}
