// # oodac Compiler QA Anchor
//
// Logline: Front door for oodac compiler QA probes on the check/emit-c/build path.
//
// Setup: Re-exports the api_surface counter. Build and nested import probes are standalone mains.
//
// Beats:
//   1. Re-export probe_api_surface_run.
//   2. Forward qa_main dispatch with FsReadCap.
//   3. Satisfy House Law line boundaries (16-256 LOC).

import "probe_api_surface.oo";

pub fn qa_main(fs: &FsReadCap) -> Int {
    return probe_api_surface_run(fs);
}

pub fn qa_anchor() -> Int {
    return 0;
}
