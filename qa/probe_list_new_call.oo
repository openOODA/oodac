// # Probe: list_new at a List[String] call site
//
// Logline: list_new() as a List[String] argument must emit OoSList, not OoIList.
//
// Setup: No caps. take_s only accepts List[String]. stdout is 0.
//
// Beats:
//   1. Call take_s(list_new()) so the callee formal is the only type witness.
//   2. Bind let mut xs: List[String] = list_new() as a second typed site.
//   3. Print the sum of both lengths (0).

fn take_s(xs: List[String]) -> Int {
    return list_len(xs);
}

pub fn main() {
    let mut xs: List[String] = list_new();
    println((take_s(list_new()) + list_len(xs)).to_string());
}
