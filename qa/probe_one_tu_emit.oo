// # Probe: emit-c is residual
//
// Logline: Naked emit-c of cli_emit.oo exits residual. C backend is gone.
//
// Setup: ProcessCap + EnvCap. Host is OODA_COMPILER.
//
// Beats:
//   1. sys_exec host emit-c oodac/cli/cli_emit.oo is Err.

pub fn main(p: &ProcessCap, env: &EnvCap) {
    let hr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let host: String = match hr { Ok(s) => s, Err(_) => "" };
    if host == "" {
        println("ERR\tOODA_COMPILER required");
        process_exit(1);
    }
    let r: Result[String, String] = sys_exec(p, host, "emit-c", "oodac/cli/cli_emit.oo");
    if r.is_ok() {
        println("ERR\temit-c still lives");
        process_exit(1);
    }
    println("OK");
}
