// # WebAssembly Binary Builder Adversarial Test Suite
//
// Logline: Stress test empty modules, maximal section composition, deep local lists, and large data segments.
//
// Setup: Run with ooda/bin/ooda check or run from qa/.
//
// Beats:
//   1. Import required modules.
//   2. Execute test assertions.
//   3. Report pass or fail with exit code.
import "oodac/emit/wasm/wasm_leb128.oo";
import "oodac/emit/wasm/wasm_opcodes.oo";
import "oodac/emit/wasm/wasm_types.oo";
import "oodac/emit/wasm/wasm_binary_builder.oo";

fn assert_true(cond: Bool, msg: String) {
    if !cond { println("ASSERTION FAILED: " + msg); }
}

fn assert_eq_int(actual: Int, expected: Int, msg: String) {
    if actual != expected {
        println("ASSERTION FAILED: " + msg + " (expected " + expected.to_string() + ", got " + actual.to_string() + ")");
    }
}

pub fn test_adv_empty_module(fs: &FsWriteCap) -> List[Int] {
    let b: WasmModuleBuilder = wasm_builder_new();
    let bin: List[Int] = wasm_builder_emit(b);
    assert_eq_int(list_len(bin), 8, "Empty module size must be exactly 8 bytes");
    assert_eq_int(list_get(bin, 0), 0, "magic 0");
    assert_eq_int(list_get(bin, 1), 97, "magic 'a'");
    assert_eq_int(list_get(bin, 2), 115, "magic 's'");
    assert_eq_int(list_get(bin, 3), 109, "magic 'm'");
    assert_eq_int(list_get(bin, 4), 1, "version 1");
    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/adv_empty.wasm", s);
    return bin;
}

pub fn test_adv_max_sections_module(fs: &FsWriteCap) -> List[Int] {
    let mut b: WasmModuleBuilder = wasm_builder_new();
    // Type 0: (i32) -> void (for proc_exit import)
    let mut p0: List[Int] = list_new(); p0 = list_push(p0, wasm_val_type_i32());
    let r0: List[Int] = list_new();
    let ty0: Int = wasm_builder_add_type(&mut b, p0, r0);

    // Type 1: (i32, i32) -> i32 (for calc func)
    let mut p1: List[Int] = list_new();
    p1 = list_push(p1, wasm_val_type_i32()); p1 = list_push(p1, wasm_val_type_i32());
    let mut r1: List[Int] = list_new(); r1 = list_push(r1, wasm_val_type_i32());
    let ty1: Int = wasm_builder_add_type(&mut b, p1, r1);

    // Imports (Section 2)
    let _imp0: Int = wasm_builder_add_import_func(&mut b, "wasi_snapshot_preview1", "proc_exit", ty0);

    // Functions (Section 3) - calc func is index 1
    let f1: Int = wasm_builder_add_func(&mut b, ty1);

    // Memory (Section 5) - min 2 pages (128KB), max 16 pages (1MB)
    wasm_builder_set_memory(&mut b, 2, 16);

    // Exports (Section 7)
    wasm_builder_add_export(&mut b, "calc", wasm_external_func(), 1);
    wasm_builder_add_export(&mut b, "memory", wasm_external_memory(), 0);

    // Code (Section 10) - (a * b) + 10
    let mut locals: List[Int] = list_new();
    let mut code: List[Int] = list_new();
    code = list_push(code, op_local_get()); code = list_push(code, 0);
    code = list_push(code, op_local_get()); code = list_push(code, 1);
    code = list_push(code, op_i32_mul());
    code = list_push(code, op_i32_const()); code = wasm_append(code, encode_i32_leb128(10));
    code = list_push(code, op_i32_add());
    code = list_push(code, op_end());
    wasm_builder_set_code(&mut b, f1, locals, code);

    // Data (Section 11) - 2 segments
    let mut d1: List[Int] = list_new();
    d1 = list_push(d1, 65); d1 = list_push(d1, 66); d1 = list_push(d1, 67);
    wasm_builder_add_data(&mut b, 0, d1);

    let mut d2: List[Int] = list_new();
    d2 = list_push(d2, 88); d2 = list_push(d2, 89); d2 = list_push(d2, 90);
    wasm_builder_add_data(&mut b, 1024, d2);

    let bin: List[Int] = wasm_builder_emit(b);
    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/adv_max_sections.wasm", s);
    return bin;
}

pub fn test_adv_deep_locals_module(fs: &FsWriteCap) -> List[Int] {
    let mut b: WasmModuleBuilder = wasm_builder_new();
    let p: List[Int] = list_new();
    let mut r: List[Int] = list_new(); r = list_push(r, wasm_val_type_i32());
    let ty: Int = wasm_builder_add_type(&mut b, p, r);
    let f: Int = wasm_builder_add_func(&mut b, ty);

    // 300 i32 locals, 200 i64 locals, 150 f64 locals (total 650 locals)
    let mut locs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 300 { locs = list_push(locs, wasm_val_type_i32()); i = i + 1; }
    i = 0;
    while i < 200 { locs = list_push(locs, wasm_val_type_i64()); i = i + 1; }
    i = 0;
    while i < 150 { locs = list_push(locs, wasm_val_type_f64()); i = i + 1; }

    let mut code: List[Int] = list_new();
    // local.set 0 (val 100)
    code = list_push(code, op_i32_const());
    code = wasm_append(code, encode_i32_leb128(100));
    code = list_push(code, op_local_set());
    code = wasm_append(code, encode_u32_leb128(0));

    // local.set 299 (val 250)
    code = list_push(code, op_i32_const());
    code = wasm_append(code, encode_i32_leb128(250));
    code = list_push(code, op_local_set());
    code = wasm_append(code, encode_u32_leb128(299));

    // read local 0 and local 299, add them -> 350
    code = list_push(code, op_local_get());
    code = wasm_append(code, encode_u32_leb128(0));
    code = list_push(code, op_local_get());
    code = wasm_append(code, encode_u32_leb128(299));
    code = list_push(code, op_i32_add());
    code = list_push(code, op_end());

    wasm_builder_set_code(&mut b, f, locs, code);
    wasm_builder_add_export(&mut b, "sum_deep_locals", wasm_external_func(), f);

    let bin: List[Int] = wasm_builder_emit(b);
    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/adv_deep_locals.wasm", s);
    return bin;
}

pub fn test_adv_large_data_module(fs: &FsWriteCap) -> List[Int] {
    let mut b: WasmModuleBuilder = wasm_builder_new();
    // 2 memory pages min (128KB)
    wasm_builder_set_memory(&mut b, 2, -1);
    wasm_builder_add_export(&mut b, "memory", wasm_external_memory(), 0);

    // Create 4096 byte data segment
    let mut big_data: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 4096 {
        big_data = list_push(big_data, (i * 7 + 13) & 255);
        i = i + 1;
    }
    wasm_builder_add_data(&mut b, 1024, big_data);

    let p: List[Int] = list_new();
    let mut r: List[Int] = list_new(); r = list_push(r, wasm_val_type_i32());
    let ty: Int = wasm_builder_add_type(&mut b, p, r);
    let f: Int = wasm_builder_add_func(&mut b, ty);

    // Returns data length (4096)
    let mut code: List[Int] = list_new();
    code = list_push(code, op_i32_const());
    code = wasm_append(code, encode_i32_leb128(4096));
    code = list_push(code, op_end());
    wasm_builder_set_code(&mut b, f, list_new(), code);
    wasm_builder_add_export(&mut b, "get_data_len", wasm_external_func(), f);

    let bin: List[Int] = wasm_builder_emit(b);
    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/adv_large_data.wasm", s);
    return bin;
}

pub fn main(fs: &FsWriteCap) {
    println("=================================================");
    println(" Running Adversarial WASM Binary Builder Tests");
    println("=================================================");

    let b_empty: List[Int] = test_adv_empty_module(fs);
    assert_eq_int(list_len(b_empty), 8, "Empty module length");

    let b_max: List[Int] = test_adv_max_sections_module(fs);
    assert_true(list_len(b_max) > 8, "Max sections module length");

    let b_deep: List[Int] = test_adv_deep_locals_module(fs);
    assert_true(list_len(b_deep) > 8, "Deep locals module length");

    let b_data: List[Int] = test_adv_large_data_module(fs);
    assert_true(list_len(b_data) > 4096, "Large data module length");

    println("All Adversarial WASM Binary Builder tests emitted successfully!");
}
