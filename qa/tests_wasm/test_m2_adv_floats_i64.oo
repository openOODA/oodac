// # WebAssembly Milestone 2 Adversarial Floats & 64-bit Integers Test Suite
//
// Logline: Stress-test IEEE-754 float boundary conditions (subnormals, infinity, negative zero, boundary rounding) and 64-bit integer bit shifts and divisions.
//
// Setup: Run with ooda/bin/ooda check or run from qa/.
//
// Beats:
//   1. Import required modules.
//   2. Execute test assertions.
//   3. Report pass or fail with exit code.
import "oodac/emit/wasm/wasm_leb128.oo";
import "oodac/emit/wasm/wasm_opcodes.oo";
import "oodac/emit/wasm/wasm_types.oo";
import "oodac/emit/wasm/wasm_binary_builder.oo";
import "oodac/emit/wasm/wasm_lower_expr.oo";
import "oodac/emit/wasm/wasm_lower_stmt.oo";
import "oodac/emit/wasm/wasm_lower_control.oo";
import "oodac/emit/wasm/wasm_lower_fn.oo";
import "oodac/ast/ast.oo";

pub fn test_m2_adv_float_arith(fs: &FsWriteCap) -> List[Int] {
    // 1. float_div(x: Float, y: Float) -> Float { return x / y; }
    let fn1_body: String = mk_block(mk_sreturn(mk_ebinop("Div", mk_evar("x"), mk_evar("y"))), mk_sempty());
    let fn1_params: String = mk_param("x", mk_ty_float()) + "," + mk_param("y", mk_ty_float());
    let fn1: String = mk_fn("float_div", fn1_params, mk_ty_float(), "", fn1_body);

    // 2. float_neg(x: Float) -> Float { return -x; }
    let fn2_body: String = mk_block(mk_sreturn(mk_eunop("Neg", mk_evar("x"))), mk_sempty());
    let fn2: String = mk_fn("float_neg", mk_param("x", mk_ty_float()), mk_ty_float(), "", fn2_body);

    // 3. float_subnormal_step(x: Float, factor: Float) -> Float { return x * factor; }
    let fn3_body: String = mk_block(mk_sreturn(mk_ebinop("Mul", mk_evar("x"), mk_evar("factor"))), mk_sempty());
    let fn3_params: String = mk_param("x", mk_ty_float()) + "," + mk_param("factor", mk_ty_float());
    let fn3: String = mk_fn("float_subnormal_step", fn3_params, mk_ty_float(), "", fn3_body);

    // 4. float_round_test(a: Float, b: Float) -> Float { return (a + b) - a; }
    let fn4_body: String = mk_block(mk_sreturn(mk_ebinop("Sub", mk_ebinop("Add", mk_evar("a"), mk_evar("b")), mk_evar("a"))), mk_sempty());
    let fn4_params: String = mk_param("a", mk_ty_float()) + "," + mk_param("b", mk_ty_float());
    let fn4: String = mk_fn("float_round_test", fn4_params, mk_ty_float(), "", fn4_body);

    // 5. float_cmp(a: Float, b: Float, mode: Int) -> Bool
    // mode 1: ==, 2: !=, 3: <, 4: <=, 5: >, 6: >=
    let cmp_eq: String = mk_ebinop("Eq", mk_evar("a"), mk_evar("b"));
    let cmp_ne: String = mk_ebinop("Neq", mk_evar("a"), mk_evar("b"));
    let cmp_lt: String = mk_ebinop("Lt", mk_evar("a"), mk_evar("b"));
    let cmp_le: String = mk_ebinop("Lte", mk_evar("a"), mk_evar("b"));
    let cmp_gt: String = mk_ebinop("Gt", mk_evar("a"), mk_evar("b"));
    let cmp_ge: String = mk_ebinop("Gte", mk_evar("a"), mk_evar("b"));

    let if5: String = mk_eif(mk_ebinop("==", mk_evar("mode"), mk_eint("5")), mk_block(mk_sreturn(cmp_gt), mk_sempty()), mk_block(mk_sreturn(cmp_ge), mk_sempty()));
    let if4: String = mk_eif(mk_ebinop("==", mk_evar("mode"), mk_eint("4")), mk_block(mk_sreturn(cmp_le), mk_sempty()), if5);
    let if3: String = mk_eif(mk_ebinop("==", mk_evar("mode"), mk_eint("3")), mk_block(mk_sreturn(cmp_lt), mk_sempty()), if4);
    let if2: String = mk_eif(mk_ebinop("==", mk_evar("mode"), mk_eint("2")), mk_block(mk_sreturn(cmp_ne), mk_sempty()), if3);
    let if1: String = mk_eif(mk_ebinop("==", mk_evar("mode"), mk_eint("1")), mk_block(mk_sreturn(cmp_eq), mk_sempty()), if2);

    let fn5_body: String = mk_block(if1, mk_sempty());
    let fn5_params: String = mk_param("a", mk_ty_float()) + "," + mk_param("b", mk_ty_float()) + "," + mk_param("mode", mk_ty_int());
    let fn5: String = mk_fn("float_cmp", fn5_params, mk_ty_bool(), "", fn5_body);

    let file_node: String = mk_file(fn1 + "," + fn2 + "," + fn3 + "," + fn4 + "," + fn5);
    let bin: List[Int] = wasm_compile_ast_module(file_node, "browser", wasm_val_type_i32());

    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m2_adv_floats.wasm", s);
    return bin;
}

pub fn test_m2_adv_i64_ops(fs: &FsWriteCap) -> List[Int] {
    // Compile functions with default_int = i64
    // 1. i64_shifts(val: Int, shift: Int) -> Int: (val << shift) ^ (val >> shift)
    let shl_node: String = mk_ebinop("Shl", mk_evar("val"), mk_evar("shift"));
    let shr_node: String = mk_ebinop("Shr", mk_evar("val"), mk_evar("shift"));
    let xor_node: String = mk_ebinop("Xor", shl_node, shr_node);
    let fn1_body: String = mk_block(mk_sreturn(xor_node), mk_sempty());
    let fn1_params: String = mk_param("val", mk_ty_int()) + "," + mk_param("shift", mk_ty_int());
    let fn1: String = mk_fn("i64_shifts", fn1_params, mk_ty_int(), "", fn1_body);

    // 2. i64_div_rem(a: Int, b: Int) -> Int: (a / b) * 1000 + (a % b)
    let div_node: String = mk_ebinop("Div", mk_evar("a"), mk_evar("b"));
    let rem_node: String = mk_ebinop("Mod", mk_evar("a"), mk_evar("b"));
    let mul_node: String = mk_ebinop("Mul", div_node, mk_eint("1000"));
    let sum_node: String = mk_ebinop("Add", mul_node, rem_node);
    let fn2_body: String = mk_block(mk_sreturn(sum_node), mk_sempty());
    let fn2_params: String = mk_param("a", mk_ty_int()) + "," + mk_param("b", mk_ty_int());
    let fn2: String = mk_fn("i64_div_rem", fn2_params, mk_ty_int(), "", fn2_body);

    // 3. i64_bitwise(a: Int, b: Int) -> Int: (a & b) | (a ^ b)
    let and_node: String = mk_ebinop("And", mk_evar("a"), mk_evar("b"));
    let xor_b_node: String = mk_ebinop("Xor", mk_evar("a"), mk_evar("b"));
    let or_node: String = mk_ebinop("Or", and_node, xor_b_node);
    let fn3_body: String = mk_block(mk_sreturn(or_node), mk_sempty());
    let fn3_params: String = mk_param("a", mk_ty_int()) + "," + mk_param("b", mk_ty_int());
    let fn3: String = mk_fn("i64_bitwise", fn3_params, mk_ty_int(), "", fn3_body);

    // 4. i64_cmp_all(a: Int, b: Int) -> Int: pack comparisons into bitmask
    // bit 0: a < b, bit 1: a <= b, bit 2: a > b, bit 3: a >= b, bit 4: a == b, bit 5: a != b
    let c_lt: String = mk_ebinop("Lt", mk_evar("a"), mk_evar("b"));
    let c_le: String = mk_ebinop("Lte", mk_evar("a"), mk_evar("b"));
    let c_gt: String = mk_ebinop("Gt", mk_evar("a"), mk_evar("b"));
    let c_ge: String = mk_ebinop("Gte", mk_evar("a"), mk_evar("b"));
    let c_eq: String = mk_ebinop("Eq", mk_evar("a"), mk_evar("b"));
    let c_ne: String = mk_ebinop("Neq", mk_evar("a"), mk_evar("b"));

    let s0: String = mk_slet_mut("res", mk_ty_int(), mk_eint("0"));
    let if_lt: String = mk_eif(c_lt, mk_block(mk_sassign("res", mk_ebinop("|", mk_evar("res"), mk_eint("1"))), mk_sempty()), "");
    let if_le: String = mk_eif(c_le, mk_block(mk_sassign("res", mk_ebinop("|", mk_evar("res"), mk_eint("2"))), mk_sempty()), "");
    let if_gt: String = mk_eif(c_gt, mk_block(mk_sassign("res", mk_ebinop("|", mk_evar("res"), mk_eint("4"))), mk_sempty()), "");
    let if_ge: String = mk_eif(c_ge, mk_block(mk_sassign("res", mk_ebinop("|", mk_evar("res"), mk_eint("8"))), mk_sempty()), "");
    let if_eq: String = mk_eif(c_eq, mk_block(mk_sassign("res", mk_ebinop("|", mk_evar("res"), mk_eint("16"))), mk_sempty()), "");
    let if_ne: String = mk_eif(c_ne, mk_block(mk_sassign("res", mk_ebinop("|", mk_evar("res"), mk_eint("32"))), mk_sempty()), "");
    let ret_res: String = mk_sreturn(mk_evar("res"));

    let fn4_body: String = mk_block(s0 + "," + if_lt + "," + if_le + "," + if_gt + "," + if_ge + "," + if_eq + "," + if_ne + "," + ret_res, mk_sempty());
    let fn4_params: String = mk_param("a", mk_ty_int()) + "," + mk_param("b", mk_ty_int());
    let fn4: String = mk_fn("i64_cmp_all", fn4_params, mk_ty_int(), "", fn4_body);

    let file_node: String = mk_file(fn1 + "," + fn2 + "," + fn3 + "," + fn4);
    let bin: List[Int] = wasm_compile_ast_module(file_node, "browser", wasm_val_type_i64());

    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m2_adv_i64.wasm", s);
    return bin;
}

pub fn main(fs: &FsWriteCap) {
    println("=========================================================");
    println(" Running WebAssembly M2 Adversarial Float & i64 Tests");
    println("=========================================================");
    test_m2_adv_float_arith(fs);
    test_m2_adv_i64_ops(fs);
    println("All WASM M2 Adversarial Float & i64 tests emitted successfully!");
}
