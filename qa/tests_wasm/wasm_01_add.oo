// # WebAssembly Integer Addition Verification
//
// Logline: Verify pure integer addition compilation for WebAssembly target.
//
// Setup: Integer arithmetic subset without capability parameters available.
//
// Beats:
//   1. Define compute_sum adding two integer arguments.
//   2. Call compute_sum in main entry point.
//   3. Return sum result for WebAssembly runtime verification.

pub fn compute_sum(x: Int, y: Int) -> Int {
    return x + y;
}

pub fn main() -> Int {
    let s = compute_sum(20, 22);
    return s;
}
