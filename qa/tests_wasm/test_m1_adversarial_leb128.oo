// # WebAssembly LEB128 Adversarial Stress Test Suite
//
// Logline: Adversarially stress test unsigned and signed LEB128 codecs across bit boundaries, multi-byte encodings, stream sequencing, and extreme ranges.
//
// Setup: Run with ooda/bin/ooda check or run from qa/.
//
// Beats:
//   1. Import required modules.
//   2. Execute test assertions.
//   3. Report pass or fail with exit code.
import "oodac/emit/wasm/wasm_leb128.oo";

fn assert_true(cond: Bool, msg: String) {
    if !cond {
        println("ASSERTION FAILED: " + msg);
    }
}

fn assert_eq_int(actual: Int, expected: Int, msg: String) {
    if actual != expected {
        println("ASSERTION FAILED: " + msg + " (expected " + expected.to_string() + ", got " + actual.to_string() + ")");
    }
}

fn check_u32(val: Int) -> Bool {
    let enc: List[Int] = encode_u32_leb128(val);
    let dec: LebDecodeResult = decode_u32_leb128(enc, 0);
    return dec.value == val && dec.next_offset == list_len(enc);
}

fn check_i32(val: Int) -> Bool {
    let enc: List[Int] = encode_i32_leb128(val);
    let dec: LebDecodeResult = decode_i32_leb128(enc, 0);
    return dec.value == val && dec.next_offset == list_len(enc);
}

fn check_u64(val: Int) -> Bool {
    let enc: List[Int] = encode_u64_leb128(val);
    let dec: LebDecodeResult = decode_u64_leb128(enc, 0);
    return dec.value == val && dec.next_offset == list_len(enc);
}

fn check_i64(val: Int) -> Bool {
    let enc: List[Int] = encode_i64_leb128(val);
    let dec: LebDecodeResult = decode_i64_leb128(enc, 0);
    return dec.value == val && dec.next_offset == list_len(enc);
}

pub fn test_u32_boundaries() {
    // 1-byte u32 boundary: 0 to 127
    assert_true(check_u32(0), "u32: 0");
    assert_true(check_u32(1), "u32: 1");
    assert_true(check_u32(126), "u32: 126");
    assert_true(check_u32(127), "u32: 127");

    // 2-byte u32 boundary: 128 to 16383
    assert_true(check_u32(128), "u32: 128");
    assert_true(check_u32(129), "u32: 129");
    assert_true(check_u32(255), "u32: 255");
    assert_true(check_u32(256), "u32: 256");
    assert_true(check_u32(16382), "u32: 16382");
    assert_true(check_u32(16383), "u32: 16383");

    // 3-byte u32 boundary: 16384 to 2097151
    assert_true(check_u32(16384), "u32: 16384");
    assert_true(check_u32(65535), "u32: 65535");
    assert_true(check_u32(65536), "u32: 65536");
    assert_true(check_u32(2097151), "u32: 2097151");

    // 4-byte u32 boundary: 2097152 to 268435455
    assert_true(check_u32(2097152), "u32: 2097152");
    assert_true(check_u32(268435455), "u32: 268435455");

    // 5-byte u32 boundary: 268435456 to 2147483647
    assert_true(check_u32(268435456), "u32: 268435456");
    assert_true(check_u32(1000000000), "u32: 1000000000");
    assert_true(check_u32(2147483647), "u32: 2147483647 (max positive i32)");
}

pub fn test_i32_boundaries() {
    // 1-byte i32 boundary: -64 to 63
    assert_true(check_i32(0), "i32: 0");
    assert_true(check_i32(1), "i32: 1");
    assert_true(check_i32(63), "i32: 63");
    assert_true(check_i32(-1), "i32: -1");
    assert_true(check_i32(-64), "i32: -64");

    // 2-byte i32 boundary: [-8192, -65] and [64, 8191]
    assert_true(check_i32(64), "i32: 64");
    assert_true(check_i32(127), "i32: 127");
    assert_true(check_i32(128), "i32: 128");
    assert_true(check_i32(8191), "i32: 8191");
    assert_true(check_i32(-65), "i32: -65");
    assert_true(check_i32(-128), "i32: -128");
    assert_true(check_i32(-129), "i32: -129");
    assert_true(check_i32(-8192), "i32: -8192");

    // 3-byte i32 boundary: [-1048576, -8193] and [8192, 1048575]
    assert_true(check_i32(8192), "i32: 8192");
    assert_true(check_i32(1048575), "i32: 1048575");
    assert_true(check_i32(-8193), "i32: -8193");
    assert_true(check_i32(-1048576), "i32: -1048576");

    // 5-byte i32 boundary: extremes
    assert_true(check_i32(2147483647), "i32: 2147483647");
    assert_true(check_i32(-2147483648), "i32: -2147483648");
}

pub fn test_stream_decoding() {
    // Encode sequence of diverse numbers into a single continuous stream
    let mut stream: List[Int] = list_new();

    let e1: List[Int] = encode_u32_leb128(42);
    let e2: List[Int] = encode_i32_leb128(-999);
    let e3: List[Int] = encode_u32_leb128(624485);
    let e4: List[Int] = encode_i32_leb128(2147483647);
    let e5: List[Int] = encode_i32_leb128(-2147483648);

    let mut i: Int = 0;
    while i < list_len(e1) { stream = list_push(stream, list_get(e1, i)); i = i + 1; }
    i = 0;
    while i < list_len(e2) { stream = list_push(stream, list_get(e2, i)); i = i + 1; }
    i = 0;
    while i < list_len(e3) { stream = list_push(stream, list_get(e3, i)); i = i + 1; }
    i = 0;
    while i < list_len(e4) { stream = list_push(stream, list_get(e4, i)); i = i + 1; }
    i = 0;
    while i < list_len(e5) { stream = list_push(stream, list_get(e5, i)); i = i + 1; }

    // Decode sequentially using next_offset
    let d1: LebDecodeResult = decode_u32_leb128(stream, 0);
    assert_eq_int(d1.value, 42, "Stream d1 value");

    let d2: LebDecodeResult = decode_i32_leb128(stream, d1.next_offset);
    assert_eq_int(d2.value, -999, "Stream d2 value");

    let d3: LebDecodeResult = decode_u32_leb128(stream, d2.next_offset);
    assert_eq_int(d3.value, 624485, "Stream d3 value");

    let d4: LebDecodeResult = decode_i32_leb128(stream, d3.next_offset);
    assert_eq_int(d4.value, 2147483647, "Stream d4 value");

    let d5: LebDecodeResult = decode_i32_leb128(stream, d4.next_offset);
    assert_eq_int(d5.value, -2147483648, "Stream d5 value");
    assert_eq_int(d5.next_offset, list_len(stream), "Stream final offset == stream length");
}

pub fn main() {
    println("=================================================");
    println(" Running Adversarial LEB128 Stress Tests");
    println("=================================================");

    test_u32_boundaries();
    test_i32_boundaries();
    test_stream_decoding();

    assert_true(check_u64(0), "u64 0");
    assert_true(check_u64(2147483648), "u64 2^31");
    assert_true(check_u64(1099511627776), "u64 2^40");
    assert_true(check_i64(0), "i64 0");
    assert_true(check_i64(-2147483648), "i64 -2^31");
    assert_true(check_i64(-1099511627776), "i64 -2^40");
    assert_true(check_i64(4611686018427387903), "i64 2^62 - 1");
    assert_true(check_i64(-4611686018427387904), "i64 -2^62");

    println("All Adversarial LEB128 stress tests PASSED!");
}
