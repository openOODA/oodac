// # WebAssembly Milestone 2 Adversarial Stress Test Suite
//
// Logline: Stress-test AST lowering, control flow (breaks/continues in if), mutual recursion, deep recursion, and multi-branch matches.
//
// Setup: Run with ooda/bin/ooda check or run from qa/.
//
// Beats:
//   1. Import required modules.
//   2. Execute test assertions.
//   3. Report pass or fail with exit code.
import "oodac/emit/wasm/wasm_leb128.oo";
import "oodac/emit/wasm/wasm_opcodes.oo";
import "oodac/emit/wasm/wasm_types.oo";
import "oodac/emit/wasm/wasm_binary_builder.oo";
import "oodac/emit/wasm/wasm_lower_expr.oo";
import "oodac/emit/wasm/wasm_lower_stmt.oo";
import "oodac/emit/wasm/wasm_lower_control.oo";
import "oodac/emit/wasm/wasm_lower_fn.oo";
import "oodac/ast/ast.oo";

pub fn gen_break_in_if_module(fs: &FsWriteCap) -> List[Int] {
    // fn test_break() -> Int {
    //     let mut i: Int = 0;
    //     while i < 100 {
    //         if i == 5 { break; }
    //         i = i + 1;
    //     }
    //     return i;
    // }
    let s_i: String = mk_slet_mut("i", mk_ty_int(), mk_eint("0"));
    let if_br: String = mk_eif(
        mk_ebinop("==", mk_evar("i"), mk_eint("5")),
        mk_block(mk_sbreak(), mk_sempty()),
        ""
    );
    let inc: String = mk_sassign("i", mk_ebinop("+", mk_evar("i"), mk_eint("1")));
    let loop_body: String = mk_block(if_br + "," + inc, mk_sempty());
    let w_loop: String = mk_swhile(mk_ebinop("<", mk_evar("i"), mk_eint("100")), loop_body);
    let ret: String = mk_sreturn(mk_evar("i"));

    let body: String = mk_block(s_i + "," + w_loop + "," + ret, mk_sempty());
    let fn_node: String = mk_fn("test_break", "", mk_ty_int(), "", body);
    let bin: List[Int] = wasm_compile_ast_module(mk_file(fn_node), "browser", wasm_val_type_i32());
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/adv_m2_break_in_if.wasm", bytes_to_str(bin));
    return bin;
}

pub fn gen_continue_in_if_module(fs: &FsWriteCap) -> List[Int] {
    // fn test_continue() -> Int {
    //     let mut i: Int = 0;
    //     let mut sum: Int = 0;
    //     while i < 10 {
    //         i = i + 1;
    //         if (i % 2) == 0 { continue; }
    //         sum = sum + i;
    //     }
    //     return sum;
    // }
    let s_i: String = mk_slet_mut("i", mk_ty_int(), mk_eint("0"));
    let s_sum: String = mk_slet_mut("sum", mk_ty_int(), mk_eint("0"));
    let inc_i: String = mk_sassign("i", mk_ebinop("+", mk_evar("i"), mk_eint("1")));
    let if_cont: String = mk_eif(
        mk_ebinop("==", mk_ebinop("%", mk_evar("i"), mk_eint("2")), mk_eint("0")),
        mk_block(mk_scontinue(), mk_sempty()),
        ""
    );
    let add_sum: String = mk_sassign("sum", mk_ebinop("+", mk_evar("sum"), mk_evar("i")));
    let loop_body: String = mk_block(inc_i + "," + if_cont + "," + add_sum, mk_sempty());
    let w_loop: String = mk_swhile(mk_ebinop("<", mk_evar("i"), mk_eint("10")), loop_body);
    let ret: String = mk_sreturn(mk_evar("sum"));

    let body: String = mk_block(s_i + "," + s_sum + "," + w_loop + "," + ret, mk_sempty());
    let fn_node: String = mk_fn("test_continue", "", mk_ty_int(), "", body);
    let bin: List[Int] = wasm_compile_ast_module(mk_file(fn_node), "browser", wasm_val_type_i32());
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/adv_m2_continue_in_if.wasm", bytes_to_str(bin));
    return bin;
}

pub fn gen_nested_while_module(fs: &FsWriteCap) -> List[Int] {
    // fn test_nested_while() -> Int {
    //     let mut outer: Int = 0;
    //     let mut total: Int = 0;
    //     while outer < 5 {
    //         let mut inner: Int = 0;
    //         while inner < 10 {
    //             if inner == 3 { break; }
    //             total = total + 1;
    //             inner = inner + 1;
    //         }
    //         outer = outer + 1;
    //     }
    //     return total;
    // }
    let s_outer: String = mk_slet_mut("outer", mk_ty_int(), mk_eint("0"));
    let s_total: String = mk_slet_mut("total", mk_ty_int(), mk_eint("0"));

    let s_inner: String = mk_slet_mut("inner", mk_ty_int(), mk_eint("0"));
    let if_in_br: String = mk_eif(
        mk_ebinop("==", mk_evar("inner"), mk_eint("3")),
        mk_block(mk_sbreak(), mk_sempty()),
        ""
    );
    let inc_tot: String = mk_sassign("total", mk_ebinop("+", mk_evar("total"), mk_eint("1")));
    let inc_in: String = mk_sassign("inner", mk_ebinop("+", mk_evar("inner"), mk_eint("1")));
    let in_body: String = mk_block(if_in_br + "," + inc_tot + "," + inc_in, mk_sempty());
    let in_loop: String = mk_swhile(mk_ebinop("<", mk_evar("inner"), mk_eint("10")), in_body);
    let inc_out: String = mk_sassign("outer", mk_ebinop("+", mk_evar("outer"), mk_eint("1")));

    let out_body: String = mk_block(s_inner + "," + in_loop + "," + inc_out, mk_sempty());
    let out_loop: String = mk_swhile(mk_ebinop("<", mk_evar("outer"), mk_eint("5")), out_body);
    let ret: String = mk_sreturn(mk_evar("total"));

    let body: String = mk_block(s_outer + "," + s_total + "," + out_loop + "," + ret, mk_sempty());
    let fn_node: String = mk_fn("test_nested_while", "", mk_ty_int(), "", body);
    let bin: List[Int] = wasm_compile_ast_module(mk_file(fn_node), "browser", wasm_val_type_i32());
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/adv_m2_nested_while.wasm", bytes_to_str(bin));
    return bin;
}

pub fn gen_deep_expr_module(fs: &FsWriteCap) -> List[Int] {
    // Builds a deeply nested binary addition tree: 1 + 1 + 1 + ... (50 terms)
    let mut expr: String = mk_eint("1");
    let mut i: Int = 1;
    while i < 50 {
        expr = mk_ebinop("+", expr, mk_eint("1"));
        i = i + 1;
    }
    let body: String = mk_block(mk_sreturn(expr), mk_sempty());
    let fn_node: String = mk_fn("deep_expr_50", "", mk_ty_int(), "", body);
    let bin: List[Int] = wasm_compile_ast_module(mk_file(fn_node), "browser", wasm_val_type_i32());
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/adv_m2_deep_expr.wasm", bytes_to_str(bin));
    return bin;
}

pub fn gen_mutual_rec_module(fs: &FsWriteCap) -> List[Int] {
    // fn is_even(n: Int) -> Int { if n == 0 { return 1; } return is_odd(n - 1); }
    // fn is_odd(n: Int) -> Int { if n == 0 { return 0; } return is_even(n - 1); }
    let even_if: String = mk_eif(
        mk_ebinop("==", mk_evar("n"), mk_eint("0")),
        mk_block(mk_sreturn(mk_eint("1")), mk_sempty()),
        ""
    );
    let even_call: String = mk_ecall("is_odd", mk_ebinop("-", mk_evar("n"), mk_eint("1")));
    let even_body: String = mk_block(even_if + "," + mk_sreturn(even_call), mk_sempty());
    let even_fn: String = mk_fn("is_even", mk_param("n", mk_ty_int()), mk_ty_int(), "", even_body);

    let odd_if: String = mk_eif(
        mk_ebinop("==", mk_evar("n"), mk_eint("0")),
        mk_block(mk_sreturn(mk_eint("0")), mk_sempty()),
        ""
    );
    let odd_call: String = mk_ecall("is_even", mk_ebinop("-", mk_evar("n"), mk_eint("1")));
    let odd_body: String = mk_block(odd_if + "," + mk_sreturn(odd_call), mk_sempty());
    let odd_fn: String = mk_fn("is_odd", mk_param("n", mk_ty_int()), mk_ty_int(), "", odd_body);

    let file_node: String = mk_file(even_fn + "," + odd_fn);
    let bin: List[Int] = wasm_compile_ast_module(file_node, "browser", wasm_val_type_i32());
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/adv_m2_mutual_rec.wasm", bytes_to_str(bin));
    return bin;
}

pub fn gen_match_10_arms_module(fs: &FsWriteCap) -> List[Int] {
    let mut arms: String = "";
    let mut i: Int = 0;
    while i < 10 {
        let arm: String = mk_param(mk_eint(i.to_string()), mk_block(mk_sreturn(mk_eint((i * 11).to_string())), mk_sempty()));
        if arms == "" { arms = arm; } else { arms = arms + "," + arm; }
        i = i + 1;
    }
    arms = arms + "," + mk_param("_", mk_block(mk_sreturn(mk_eint("-999")), mk_sempty()));
    let match_node: String = mk_ematch(mk_evar("code"), arms);
    let body: String = mk_block(match_node, mk_sempty());
    let fn_node: String = mk_fn("match_10", mk_param("code", mk_ty_int()), mk_ty_int(), "", body);
    let bin: List[Int] = wasm_compile_ast_module(mk_file(fn_node), "browser", wasm_val_type_i32());
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/adv_m2_match_10.wasm", bytes_to_str(bin));
    return bin;
}

pub fn gen_deep_recursion_module(fs: &FsWriteCap) -> List[Int] {
    // fn sum_rec(n: Int) -> Int { if n <= 0 { return 0; } return n + sum_rec(n - 1); }
    let if_n: String = mk_eif(
        mk_ebinop("<=", mk_evar("n"), mk_eint("0")),
        mk_block(mk_sreturn(mk_eint("0")), mk_sempty()),
        ""
    );
    let rec_call: String = mk_ecall("sum_rec", mk_ebinop("-", mk_evar("n"), mk_eint("1")));
    let ret_stmt: String = mk_sreturn(mk_ebinop("+", mk_evar("n"), rec_call));
    let body: String = mk_block(if_n + "," + ret_stmt, mk_sempty());
    let fn_node: String = mk_fn("sum_rec", mk_param("n", mk_ty_int()), mk_ty_int(), "", body);
    let bin: List[Int] = wasm_compile_ast_module(mk_file(fn_node), "browser", wasm_val_type_i32());
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/adv_m2_deep_rec.wasm", bytes_to_str(bin));
    return bin;
}

pub fn main(fs: &FsWriteCap) {
    println("=================================================");
    println(" Generating Milestone 2 Adversarial Stress Modules");
    println("=================================================");
    gen_break_in_if_module(fs);
    gen_continue_in_if_module(fs);
    gen_nested_while_module(fs);
    gen_deep_expr_module(fs);
    gen_mutual_rec_module(fs);
    gen_match_10_arms_module(fs);
    gen_deep_recursion_module(fs);
    println("All Adversarial Stress modules generated successfully!");
}
