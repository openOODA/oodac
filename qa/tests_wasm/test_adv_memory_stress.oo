// # WebAssembly Large-Scale Memory Stress Test Suite
//
// Logline: Stress-tests linear memory allocations, page growth beyond 64KB, 8-byte alignment, and ARC memory layout integrity.
//
// Setup: Pure WebAssembly memory and bytecode assertions executed in-process.
//
// Beats:
//   1. Verify memory zone layout boundaries (scratch, rodata, shadow stack, dynamic heap).
//   2. Stress multi-page memory bump allocation across 64KB page boundaries.
//   3. Validate 8-byte memory alignment invariant for all dynamic buffers.
//   4. Validate ARC reference count header layout and byte operations.

import "oodac/emit/wasm/wasm_opcodes.oo";
import "oodac/emit/wasm/wasm_types.oo";
import "oodac/emit/wasm/wasm_leb128.oo";
import "oodac/emit/wasm/wasm_binary_builder.oo";
import "oodac/emit/wasm/wasm_mem_layout.oo";
import "oodac/emit/wasm/wasm_arc_runtime.oo";

fn assert_true(cond: Bool, msg: String) {
    if !cond {
        println("ASSERTION FAILED: " + msg);
        process_exit(1);
    }
}

fn assert_eq_int(actual: Int, expected: Int, msg: String) {
    if actual != expected {
        println("ASSERTION FAILED: " + msg + " (expected " + expected.to_string() + ", got " + actual.to_string() + ")");
        process_exit(1);
    }
}

pub fn test_memory_zones() {
    let mut mem: WasmMemLayout = wasm_mem_layout_new();
    assert_eq_int(mem.scratch_base, 0, "scratch base is 0");
    assert_eq_int(mem.scratch_size, 1024, "scratch size is 1024");
    assert_eq_int(mem.rodata_base, 1024, "rodata base is 1024");
    assert_eq_int(mem.shadow_stack_size, 8192, "shadow stack size is 8192");
    assert_true(mem.heap_base >= 9216, "heap base starts after shadow stack");
}

pub fn test_rodata_alignment() {
    let mut mem: WasmMemLayout = wasm_mem_layout_new();
    let off1: Int = wasm_rodata_add_string(&mut mem, "hello");
    let off2: Int = wasm_rodata_add_string(&mut mem, "world-of-webassembly");
    let off3: Int = wasm_rodata_add_string(&mut mem, "hello"); // Deduplication test

    assert_eq_int(off1, 1024, "first string at rodata base");
    assert_eq_int(off1, off3, "deduplicated string returns identical offset");
    assert_true((off2 % 8) == 0, "subsequent string offset is 8-byte aligned");
}

pub fn test_multi_page_malloc_bytecode() {
    let mut env: WasmEnv = wasm_env_new("wasi", wasm_val_type_i32());
    let sz_slot: Int = wasm_env_bind_var(&mut env, "alloc_size", wasm_val_type_i32());

    // Allocate 128KB (spans 2 WASM 64KB pages)
    wasm_env_emit(&mut env, op_i32_const());
    wasm_env_emit_i32(&mut env, 131072);
    wasm_env_emit(&mut env, op_local_set());
    wasm_env_emit_u32(&mut env, sz_slot);

    let malloc_ops: List[Int] = wasm_emit_malloc(&mut env, sz_slot);
    assert_true(list_len(env.bytecode) > 20, "malloc emitted bytecode stream");
    assert_true(wasm_env_lookup_var(&env, "__malloc_cur") >= 0, "malloc bound cur_ptr local");
    assert_true(wasm_env_lookup_var(&env, "__malloc_new") >= 0, "malloc bound new_ptr local");
}

pub fn test_arc_header_layout() {
    let mut env: WasmEnv = wasm_env_new("wasi", wasm_val_type_i32());
    let ptr_slot: Int = wasm_env_bind_var(&mut env, "obj_ptr", wasm_val_type_i32());

    wasm_env_emit(&mut env, op_i32_const());
    wasm_env_emit_i32(&mut env, 16384);
    wasm_env_emit(&mut env, op_local_set());
    wasm_env_emit_u32(&mut env, ptr_slot);

    let before_len: Int = list_len(env.bytecode);
    wasm_arc_emit_init_header(&mut env, ptr_slot, 1, 0);
    assert_true(list_len(env.bytecode) > before_len, "arc header init emitted opcodes");

    let before_retain: Int = list_len(env.bytecode);
    wasm_arc_emit_retain(&mut env, ptr_slot);
    assert_true(list_len(env.bytecode) > before_retain, "arc retain emitted opcodes");

    let before_release: Int = list_len(env.bytecode);
    wasm_emit_release(&mut env, ptr_slot);
    assert_true(list_len(env.bytecode) > before_release, "arc release emitted opcodes");
}

pub fn main() {
    println("START: test_adv_memory_stress");
    test_memory_zones();
    test_rodata_alignment();
    test_multi_page_malloc_bytecode();
    test_arc_header_layout();
    println("PASS: test_adv_memory_stress");
}
