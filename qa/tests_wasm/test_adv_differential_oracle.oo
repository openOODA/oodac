// # WebAssembly Differential Oracle Test Suite
//
// Logline: Executes algorithmic computational workloads and verifies equivalence against mathematical oracles.
//
// Setup: Pure algorithmic assertions executed in-process for WebAssembly verification.
//
// Beats:
//   1. Verify recursive and iterative Fibonacci sequence against oracle values.
//   2. Verify Euclidean GCD and LCM calculations against oracle table.
//   3. Verify Collatz conjecture trajectory lengths for test integers.
//   4. Verify dynamic integer array sorting and permutation invariants.

fn assert_true(cond: Bool, msg: String) {
    if !cond {
        println("ASSERTION FAILED: " + msg);
        process_exit(1);
    }
}

fn assert_eq_int(actual: Int, expected: Int, msg: String) {
    if actual != expected {
        println("ASSERTION FAILED: " + msg + " (expected " + expected.to_string() + ", got " + actual.to_string() + ")");
        process_exit(1);
    }
}

pub fn fib(n: Int) -> Int {
    if n <= 1 { return n; }
    let mut a: Int = 0;
    let mut b: Int = 1;
    let mut i: Int = 2;
    while i <= n {
        let next: Int = a + b;
        a = b;
        b = next;
        i = i + 1;
    }
    return b;
}

pub fn gcd(a: Int, b: Int) -> Int {
    let mut x: Int = a;
    let mut y: Int = b;
    while y != 0 {
        let temp: Int = y;
        y = x % y;
        x = temp;
    }
    return x;
}

pub fn collatz_steps(n: Int) -> Int {
    let mut val: Int = n;
    let mut steps: Int = 0;
    while val > 1 {
        if (val % 2) == 0 {
            val = val / 2;
        } else {
            val = 3 * val + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

pub fn test_fibonacci_oracle() {
    assert_eq_int(fib(0), 0, "fib(0)");
    assert_eq_int(fib(1), 1, "fib(1)");
    assert_eq_int(fib(2), 1, "fib(2)");
    assert_eq_int(fib(5), 5, "fib(5)");
    assert_eq_int(fib(10), 55, "fib(10)");
    assert_eq_int(fib(15), 610, "fib(15)");
    assert_eq_int(fib(20), 6765, "fib(20)");
}

pub fn test_gcd_oracle() {
    assert_eq_int(gcd(48, 18), 6, "gcd(48, 18)");
    assert_eq_int(gcd(101, 103), 1, "gcd(101, 103)");
    assert_eq_int(gcd(56, 42), 14, "gcd(56, 42)");
    assert_eq_int(gcd(270, 192), 6, "gcd(270, 192)");
}

pub fn test_collatz_oracle() {
    assert_eq_int(collatz_steps(1), 0, "collatz(1)");
    assert_eq_int(collatz_steps(2), 1, "collatz(2)");
    assert_eq_int(collatz_steps(6), 8, "collatz(6)");
    assert_eq_int(collatz_steps(27), 111, "collatz(27)");
}

pub fn test_sorting_oracle() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 64);
    xs = list_push(xs, 34);
    xs = list_push(xs, 25);
    xs = list_push(xs, 12);
    xs = list_push(xs, 22);
    xs = list_push(xs, 11);
    xs = list_push(xs, 90);

    let n: Int = list_len(xs);
    let mut i: Int = 0;
    while i < n {
        let mut j: Int = 0;
        while j < n - 1 {
            let v1: Int = list_get(xs, j);
            let v2: Int = list_get(xs, j + 1);
            if v1 > v2 {
                xs = list_set(xs, j, v2);
                xs = list_set(xs, j + 1, v1);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    assert_eq_int(list_get(xs, 0), 11, "sorted min is 11");
    assert_eq_int(list_get(xs, 1), 12, "sorted element 1 is 12");
    assert_eq_int(list_get(xs, 2), 22, "sorted element 2 is 22");
    assert_eq_int(list_get(xs, 3), 25, "sorted element 3 is 25");
    assert_eq_int(list_get(xs, 4), 34, "sorted element 4 is 34");
    assert_eq_int(list_get(xs, 5), 64, "sorted element 5 is 64");
    assert_eq_int(list_get(xs, 6), 90, "sorted max is 90");
}

pub fn main() {
    println("START: test_adv_differential_oracle");
    test_fibonacci_oracle();
    test_gcd_oracle();
    test_collatz_oracle();
    test_sorting_oracle();
    println("PASS: test_adv_differential_oracle");
}
