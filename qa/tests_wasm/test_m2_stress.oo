// # WebAssembly Milestone 2 Stress & Edge Case Test Suite
//
// Logline: Build, emit, and verify WebAssembly binary modules under deep recursion, multi-locals, Collatz loops, and Ackermann function execution.
//
// Setup: Run with ooda/bin/ooda check or run from qa/.
//
// Beats:
//   1. Import required modules.
//   2. Execute test assertions.
//   3. Report pass or fail with exit code.
import "oodac/emit/wasm/wasm_leb128.oo";
import "oodac/emit/wasm/wasm_opcodes.oo";
import "oodac/emit/wasm/wasm_types.oo";
import "oodac/emit/wasm/wasm_binary_builder.oo";
import "oodac/emit/wasm/wasm_lower_expr.oo";
import "oodac/emit/wasm/wasm_lower_stmt.oo";
import "oodac/emit/wasm/wasm_lower_control.oo";
import "oodac/emit/wasm/wasm_lower_fn.oo";
import "oodac/ast/ast.oo";

pub fn test_m2_ackermann_module(fs: &FsWriteCap) -> List[Int] {
    // fn ack(m: Int, n: Int) -> Int {
    //     if m == 0 { return n + 1; }
    //     if n == 0 { return ack(m - 1, 1); }
    //     return ack(m - 1, ack(m, n - 1));
    // }
    let if0: String = mk_eif(
        mk_ebinop("==", mk_evar("m"), mk_eint("0")),
        mk_block(mk_sreturn(mk_ebinop("+", mk_evar("n"), mk_eint("1"))), mk_sempty()),
        ""
    );
    let if1: String = mk_eif(
        mk_ebinop("==", mk_evar("n"), mk_eint("0")),
        mk_block(mk_sreturn(mk_ecall("ack", mk_ebinop("-", mk_evar("m"), mk_eint("1")) + "," + mk_eint("1"))), mk_sempty()),
        ""
    );
    let inner_call: String = mk_ecall("ack", mk_evar("m") + "," + mk_ebinop("-", mk_evar("n"), mk_eint("1")));
    let outer_call: String = mk_ecall("ack", mk_ebinop("-", mk_evar("m"), mk_eint("1")) + "," + inner_call);
    let ret_stmt: String = mk_sreturn(outer_call);

    let body: String = mk_block(if0 + "," + if1 + "," + ret_stmt, mk_sempty());
    let params: String = mk_param("m", mk_ty_int()) + "," + mk_param("n", mk_ty_int());

    let fn_node: String = mk_fn("ack", params, mk_ty_int(), "", body);
    let bin: List[Int] = wasm_compile_ast_module(mk_file(fn_node), "browser", wasm_val_type_i32());
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m2_ackermann.wasm", bytes_to_str(bin));
    return bin;
}

pub fn test_m2_collatz_module(fs: &FsWriteCap) -> List[Int] {
    // fn collatz_steps(start_n: Int) -> Int {
    //     let mut n: Int = start_n;
    //     let mut steps: Int = 0;
    //     while n > 1 {
    //         if (n % 2) == 0 { n = n / 2; }
    //         else { n = 3 * n + 1; }
    //         steps = steps + 1;
    //     }
    //     return steps;
    // }
    let s_n: String = mk_slet_mut("n", mk_ty_int(), mk_evar("start_n"));
    let s_st: String = mk_slet_mut("steps", mk_ty_int(), mk_eint("0"));

    let is_even: String = mk_ebinop("==", mk_ebinop("%", mk_evar("n"), mk_eint("2")), mk_eint("0"));
    let then_b: String = mk_block(mk_sassign("n", mk_ebinop("/", mk_evar("n"), mk_eint("2"))), mk_sempty());
    let else_b: String = mk_block(mk_sassign("n", mk_ebinop("+", mk_ebinop("*", mk_eint("3"), mk_evar("n")), mk_eint("1"))), mk_sempty());
    let step_inc: String = mk_sassign("steps", mk_ebinop("+", mk_evar("steps"), mk_eint("1")));
    let loop_body: String = mk_block(mk_eif(is_even, then_b, else_b) + "," + step_inc, mk_sempty());

    let w_loop: String = mk_swhile(mk_ebinop(">", mk_evar("n"), mk_eint("1")), loop_body);
    let ret: String = mk_sreturn(mk_evar("steps"));

    let body: String = mk_block(s_n + "," + s_st + "," + w_loop + "," + ret, mk_sempty());
    let fn_node: String = mk_fn("collatz_steps", mk_param("start_n", mk_ty_int()), mk_ty_int(), "", body);
    let bin: List[Int] = wasm_compile_ast_module(mk_file(fn_node), "browser", wasm_val_type_i32());
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m2_collatz.wasm", bytes_to_str(bin));
    return bin;
}

pub fn test_m2_many_locals_module(fs: &FsWriteCap) -> List[Int] {
    // Allocates 10 locals v0..v9, mutates them in sequence, sums them up
    let mut stmts: String = "";
    let mut i: Int = 0;
    while i < 10 {
        let vname: String = "v" + i.to_string();
        let init_val: String = (i * 10).to_string();
        let slet: String = mk_slet_mut(vname, mk_ty_int(), mk_eint(init_val));
        if stmts == "" { stmts = slet; } else { stmts = stmts + "," + slet; }
        i = i + 1;
    }

    let mut sum_expr: String = mk_evar("v0");
    i = 1;
    while i < 10 {
        let vname: String = "v" + i.to_string();
        sum_expr = mk_ebinop("+", sum_expr, mk_evar(vname));
        i = i + 1;
    }

    let ret: String = mk_sreturn(sum_expr);
    stmts = stmts + "," + ret;

    let body: String = mk_block(stmts, mk_sempty());
    let fn_node: String = mk_fn("sum_many_locals", "", mk_ty_int(), "", body);
    let bin: List[Int] = wasm_compile_ast_module(mk_file(fn_node), "browser", wasm_val_type_i32());
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m2_locals.wasm", bytes_to_str(bin));
    return bin;
}

pub fn main(fs: &FsWriteCap) {
    println("=================================================");
    println(" Running WebAssembly M2 Stress Unit Tests");
    println("=================================================");
    test_m2_ackermann_module(fs);
    test_m2_collatz_module(fs);
    test_m2_many_locals_module(fs);
    println("All WASM M2 Stress unit tests emitted successfully!");
}
