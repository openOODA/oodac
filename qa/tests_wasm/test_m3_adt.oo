// # WebAssembly Milestone 3 Algebraic Data Types (Result / Option) Test Suite
//
// Logline: Build, emit, and verify WebAssembly binary modules implementing Result[T, E], Option[T], constructors, methods, and pattern matching.
//
// Setup: Run with ooda/bin/ooda check or run from qa/.
//
// Beats:
//   1. Import required modules.
//   2. Execute test assertions.
//   3. Report pass or fail with exit code.
import "oodac/emit/wasm/wasm_leb128.oo";
import "oodac/emit/wasm/wasm_opcodes.oo";
import "oodac/emit/wasm/wasm_types.oo";
import "oodac/emit/wasm/wasm_binary_builder.oo";
import "oodac/emit/wasm/wasm_lower_expr.oo";
import "oodac/emit/wasm/wasm_lower_stmt.oo";
import "oodac/emit/wasm/wasm_lower_control.oo";
import "oodac/emit/wasm/wasm_lower_adt.oo";
import "oodac/emit/wasm/wasm_lower_fn.oo";
import "oodac/ast/ast.oo";

fn assert_true(cond: Bool, msg: String) {
    if !cond { println("ASSERTION FAILED: " + msg); }
}

pub fn test_m3_result_module(fs: &FsWriteCap) -> List[Int] {
    // fn create_ok(v: Int) -> Int
    let s_ok: String = mk_sreturn(mk_ecall(mk_evar("Ok"), mk_evar("v")));
    let b_ok: String = mk_block(s_ok, mk_sempty());
    let fn_ok: String = mk_fn("create_ok", mk_param("v", mk_ty_int()), mk_ty_int(), "", b_ok);

    // fn create_err(e: Int) -> Int
    let s_err: String = mk_sreturn(mk_ecall(mk_evar("Err"), mk_evar("e")));
    let b_err: String = mk_block(s_err, mk_sempty());
    let fn_err: String = mk_fn("create_err", mk_param("e", mk_ty_int()), mk_ty_int(), "", b_err);

    // fn check_is_ok(ptr: Int) -> Bool
    let s_is_ok: String = mk_sreturn(mk_emethod(mk_evar("ptr"), "is_ok", ""));
    let b_is_ok: String = mk_block(s_is_ok, mk_sempty());
    let fn_is_ok: String = mk_fn("check_is_ok", mk_param("ptr", mk_ty_int()), mk_ty_bool(), "", b_is_ok);

    // fn check_is_err(ptr: Int) -> Bool
    let s_is_err: String = mk_sreturn(mk_emethod(mk_evar("ptr"), "is_err", ""));
    let b_is_err: String = mk_block(s_is_err, mk_sempty());
    let fn_is_err: String = mk_fn("check_is_err", mk_param("ptr", mk_ty_int()), mk_ty_bool(), "", b_is_err);

    // fn check_unwrap(ptr: Int) -> Int
    let s_unw: String = mk_sreturn(mk_emethod(mk_evar("ptr"), "unwrap", ""));
    let b_unw: String = mk_block(s_unw, mk_sempty());
    let fn_unw: String = mk_fn("check_unwrap", mk_param("ptr", mk_ty_int()), mk_ty_int(), "", b_unw);

    let file_ast: String = mk_file(fn_ok + "," + fn_err + "," + fn_is_ok + "," + fn_is_err + "," + fn_unw);
    let bin: List[Int] = wasm_compile_ast_module(file_ast, "browser", wasm_val_type_i32());
    assert_true(list_len(bin) > 30, "result_module binary length > 30");

    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m3_result.wasm", s);
    return bin;
}

pub fn test_m3_option_module(fs: &FsWriteCap) -> List[Int] {
    // fn create_some(v: Int) -> Int
    let s_some: String = mk_sreturn(mk_ecall(mk_evar("Some"), mk_evar("v")));
    let b_some: String = mk_block(s_some, mk_sempty());
    let fn_some: String = mk_fn("create_some", mk_param("v", mk_ty_int()), mk_ty_int(), "", b_some);

    // fn create_none() -> Int
    let s_none: String = mk_sreturn(mk_evar("None"));
    let b_none: String = mk_block(s_none, mk_sempty());
    let fn_none: String = mk_fn("create_none", "", mk_ty_int(), "", b_none);

    // fn check_is_some(ptr: Int) -> Bool
    let s_is_some: String = mk_sreturn(mk_emethod(mk_evar("ptr"), "is_some", ""));
    let b_is_some: String = mk_block(s_is_some, mk_sempty());
    let fn_is_some: String = mk_fn("check_is_some", mk_param("ptr", mk_ty_int()), mk_ty_bool(), "", b_is_some);

    // fn check_is_none(ptr: Int) -> Bool
    let s_is_none: String = mk_sreturn(mk_emethod(mk_evar("ptr"), "is_none", ""));
    let b_is_none: String = mk_block(s_is_none, mk_sempty());
    let fn_is_none: String = mk_fn("check_is_none", mk_param("ptr", mk_ty_int()), mk_ty_bool(), "", b_is_none);

    // fn check_opt_unwrap(ptr: Int) -> Int
    let s_unw: String = mk_sreturn(mk_emethod(mk_evar("ptr"), "unwrap", ""));
    let b_unw: String = mk_block(s_unw, mk_sempty());
    let fn_unw: String = mk_fn("check_opt_unwrap", mk_param("ptr", mk_ty_int()), mk_ty_int(), "", b_unw);

    let file_ast: String = mk_file(fn_some + "," + fn_none + "," + fn_is_some + "," + fn_is_none + "," + fn_unw);
    let bin: List[Int] = wasm_compile_ast_module(file_ast, "browser", wasm_val_type_i32());
    assert_true(list_len(bin) > 30, "option_module binary length > 30");

    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m3_option.wasm", s);
    return bin;
}

pub fn test_m3_match_adt_module(fs: &FsWriteCap) -> List[Int] {
    // fn process_result(res: Int) -> Int {
    //     match res {
    //         Ok(x) => return x * 2,
    //         Err(e) => return 0 - e
    //     }
    // }
    let arm_ok: String = mk_param("Ok(x)", mk_block(mk_sreturn(mk_ebinop("*", mk_evar("x"), mk_eint("2"))), mk_sempty()));
    let arm_err: String = mk_param("Err(e)", mk_block(mk_sreturn(mk_ebinop("-", mk_eint("0"), mk_evar("e"))), mk_sempty()));
    let match_res: String = mk_ematch(mk_evar("res"), arm_ok + "," + arm_err);
    let b_match_res: String = mk_block(match_res, mk_sempty());
    let fn_match_res: String = mk_fn("process_result", mk_param("res", mk_ty_int()), mk_ty_int(), "", b_match_res);

    // fn process_option(opt: Int) -> Int {
    //     match opt {
    //         Some(v) => return v + 100,
    //         None => return -1
    //     }
    // }
    let arm_some: String = mk_param("Some(v)", mk_block(mk_sreturn(mk_ebinop("+", mk_evar("v"), mk_eint("100"))), mk_sempty()));
    let arm_none: String = mk_param("None", mk_block(mk_sreturn(mk_eint("-1")), mk_sempty()));
    let match_opt: String = mk_ematch(mk_evar("opt"), arm_some + "," + arm_none);
    let b_match_opt: String = mk_block(match_opt, mk_sempty());
    let fn_match_opt: String = mk_fn("process_option", mk_param("opt", mk_ty_int()), mk_ty_int(), "", b_match_opt);

    // Helpers: make_ok, make_err, make_some, make_none
    let fn_mk_ok: String = mk_fn("make_ok", mk_param("v", mk_ty_int()), mk_ty_int(), "", mk_block(mk_sreturn(mk_ecall(mk_evar("Ok"), mk_evar("v"))), mk_sempty()));
    let fn_mk_err: String = mk_fn("make_err", mk_param("e", mk_ty_int()), mk_ty_int(), "", mk_block(mk_sreturn(mk_ecall(mk_evar("Err"), mk_evar("e"))), mk_sempty()));
    let fn_mk_some: String = mk_fn("make_some", mk_param("v", mk_ty_int()), mk_ty_int(), "", mk_block(mk_sreturn(mk_ecall(mk_evar("Some"), mk_evar("v"))), mk_sempty()));
    let fn_mk_none: String = mk_fn("make_none", "", mk_ty_int(), "", mk_block(mk_sreturn(mk_evar("None")), mk_sempty()));

    let file_ast: String = mk_file(fn_match_res + "," + fn_match_opt + "," + fn_mk_ok + "," + fn_mk_err + "," + fn_mk_some + "," + fn_mk_none);
    let bin: List[Int] = wasm_compile_ast_module(file_ast, "browser", wasm_val_type_i32());
    assert_true(list_len(bin) > 50, "match_adt_module binary length > 50");

    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m3_match_adt.wasm", s);
    return bin;
}

pub fn test_m3_sum_types_module(fs: &FsWriteCap) -> List[Int] {
    // 4-variant custom sum type dispatch
    let arm_0: String = mk_param("Tag0(a)", mk_block(mk_sreturn(mk_ebinop("+", mk_evar("a"), mk_eint("10"))), mk_sempty()));
    let arm_1: String = mk_param("Tag1(b)", mk_block(mk_sreturn(mk_ebinop("+", mk_evar("b"), mk_eint("20"))), mk_sempty()));
    let arm_2: String = mk_param("Tag2(c)", mk_block(mk_sreturn(mk_ebinop("+", mk_evar("c"), mk_eint("30"))), mk_sempty()));
    let arm_3: String = mk_param("Tag3(d)", mk_block(mk_sreturn(mk_ebinop("+", mk_evar("d"), mk_eint("40"))), mk_sempty()));
    let arm_w: String = mk_param("_", mk_block(mk_sreturn(mk_eint("999")), mk_sempty()));

    let match_sum: String = mk_ematch(mk_evar("val"), arm_0 + "," + arm_1 + "," + arm_2 + "," + arm_3 + "," + arm_w);
    let fn_eval: String = mk_fn("eval_sum_type", mk_param("val", mk_ty_int()), mk_ty_int(), "", mk_block(match_sum, mk_sempty()));

    let fn_mk_t0: String = mk_fn("make_tag0", mk_param("v", mk_ty_int()), mk_ty_int(), "", mk_block(mk_sreturn(mk_ecall(mk_evar("Tag0"), mk_evar("v"))), mk_sempty()));
    let fn_mk_t1: String = mk_fn("make_tag1", mk_param("v", mk_ty_int()), mk_ty_int(), "", mk_block(mk_sreturn(mk_ecall(mk_evar("Tag1"), mk_evar("v"))), mk_sempty()));
    let fn_mk_t2: String = mk_fn("make_tag2", mk_param("v", mk_ty_int()), mk_ty_int(), "", mk_block(mk_sreturn(mk_ecall(mk_evar("Tag2"), mk_evar("v"))), mk_sempty()));
    let fn_mk_t3: String = mk_fn("make_tag3", mk_param("v", mk_ty_int()), mk_ty_int(), "", mk_block(mk_sreturn(mk_ecall(mk_evar("Tag3"), mk_evar("v"))), mk_sempty()));

    let file_ast: String = mk_file(fn_eval + "," + fn_mk_t0 + "," + fn_mk_t1 + "," + fn_mk_t2 + "," + fn_mk_t3);
    let bin: List[Int] = wasm_compile_ast_module(file_ast, "browser", wasm_val_type_i32());
    assert_true(list_len(bin) > 50, "sum_types_module binary length > 50");

    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m3_sum_types.wasm", s);
    return bin;
}

pub fn main(fs: &FsWriteCap) {
    println("=================================================");
    println(" Running WebAssembly M3 ADT & Sum Types Test Suite");
    println("=================================================");
    test_m3_result_module(fs);
    test_m3_option_module(fs);
    test_m3_match_adt_module(fs);
    test_m3_sum_types_module(fs);
    println("All WASM M3 ADT unit test binaries emitted successfully!");
}
