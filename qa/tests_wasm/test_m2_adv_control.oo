// # WebAssembly Milestone 2 Adversarial Control Flow Test Suite
//
// Logline: Stress-test complex control flow (empty loop bodies, loops with multiple breaks, unreachable code after returns).
//
// Setup: Run with ooda/bin/ooda check or run from qa/.
//
// Beats:
//   1. Import required modules.
//   2. Execute test assertions.
//   3. Report pass or fail with exit code.
import "oodac/emit/wasm/wasm_leb128.oo";
import "oodac/emit/wasm/wasm_opcodes.oo";
import "oodac/emit/wasm/wasm_types.oo";
import "oodac/emit/wasm/wasm_binary_builder.oo";
import "oodac/emit/wasm/wasm_lower_expr.oo";
import "oodac/emit/wasm/wasm_lower_stmt.oo";
import "oodac/emit/wasm/wasm_lower_control.oo";
import "oodac/emit/wasm/wasm_lower_fn.oo";
import "oodac/ast/ast.oo";

pub fn test_m2_adv_empty_loops(fs: &FsWriteCap) -> List[Int] {
    // 1. empty_while_false() -> Int: while false {} return 42;
    let w_false: String = mk_swhile(mk_ebool("false"), mk_sempty());
    let ret42: String = mk_sreturn(mk_eint("42"));
    let fn1_body: String = mk_block(w_false + "," + ret42, mk_sempty());
    let fn1: String = mk_fn("empty_while_false", "", mk_ty_int(), "", fn1_body);

    // 2. empty_while_cond_mut(limit: Int) -> Int: let mut x = 0; while x < limit { x = x + 1; } return x;
    let s_x: String = mk_slet_mut("x", mk_ty_int(), mk_eint("0"));
    let inc_x: String = mk_sassign("x", mk_ebinop("+", mk_evar("x"), mk_eint("1")));
    let w_inc: String = mk_swhile(mk_ebinop("<", mk_evar("x"), mk_evar("limit")), mk_block(inc_x, mk_sempty()));
    let ret_x: String = mk_sreturn(mk_evar("x"));
    let fn2_body: String = mk_block(s_x + "," + w_inc + "," + ret_x, mk_sempty());
    let fn2: String = mk_fn("while_counter", mk_param("limit", mk_ty_int()), mk_ty_int(), "", fn2_body);

    // 3. empty_for_loop(n: Int) -> Int: for (let mut i = 0; i < n; i = i + 1) {} return 100;
    let f_init: String = mk_slet_mut("i", mk_ty_int(), mk_eint("0"));
    let f_cond: String = mk_ebinop("<", mk_evar("i"), mk_evar("n"));
    let f_step: String = mk_sassign("i", mk_ebinop("+", mk_evar("i"), mk_eint("1")));
    let for_loop: String = mk_sfor(f_init, f_cond, f_step, mk_sempty());
    let ret100: String = mk_sreturn(mk_eint("100"));
    let fn3_body: String = mk_block(for_loop + "," + ret100, mk_sempty());
    let fn3: String = mk_fn("empty_for_loop", mk_param("n", mk_ty_int()), mk_ty_int(), "", fn3_body);

    let file_node: String = mk_file(fn1 + "," + fn2 + "," + fn3);
    let bin: List[Int] = wasm_compile_ast_module(file_node, "browser", wasm_val_type_i32());

    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m2_adv_empty_loops.wasm", s);
    return bin;
}

pub fn test_m2_adv_multi_break(fs: &FsWriteCap) -> List[Int] {
    // 1. multi_break_loop(target: Int) -> Int
    // let mut x = 0;
    // while true {
    //   if x == target { break; }
    //   if x == 10 { break; }
    //   if x == 20 { break; }
    //   if x > 50 { break; }
    //   x = x + 1;
    // }
    // return x;
    let s_x: String = mk_slet_mut("x", mk_ty_int(), mk_eint("0"));
    let br1: String = mk_eif(mk_ebinop("==", mk_evar("x"), mk_evar("target")), mk_block(mk_sbreak(), mk_sempty()), "");
    let br4: String = mk_eif(mk_ebinop(">", mk_evar("x"), mk_eint("50")), mk_block(mk_sbreak(), mk_sempty()), "");
    let inc_x: String = mk_sassign("x", mk_ebinop("+", mk_evar("x"), mk_eint("1")));
    let w_body: String = mk_block(br1 + "," + br4 + "," + inc_x, mk_sempty());
    let w_loop: String = mk_swhile(mk_ebool("true"), w_body);
    let fn1_body: String = mk_block(s_x + "," + w_loop + "," + mk_sreturn(mk_evar("x")), mk_sempty());
    let fn1: String = mk_fn("multi_break_loop", mk_param("target", mk_ty_int()), mk_ty_int(), "", fn1_body);

    // 2. nested_multi_break_continue(max_outer: Int, max_inner: Int) -> Int
    // let mut outer_c = 0; let mut total = 0;
    // while outer_c < max_outer {
    //   outer_c = outer_c + 1;
    //   if outer_c == 2 { continue; }
    //   let mut inner_c = 0;
    //   while inner_c < max_inner {
    //     inner_c = inner_c + 1;
    //     if inner_c == 3 { break; }
    //     if inner_c == 1 { continue; }
    //     total = total + 1;
    //   }
    //   if outer_c == 5 { break; }
    // }
    // return total;
    let s_out: String = mk_slet_mut("outer_c", mk_ty_int(), mk_eint("0"));
    let s_tot: String = mk_slet_mut("total", mk_ty_int(), mk_eint("0"));
    let out_inc: String = mk_sassign("outer_c", mk_ebinop("+", mk_evar("outer_c"), mk_eint("1")));
    let out_cont: String = mk_eif(mk_ebinop("==", mk_evar("outer_c"), mk_eint("2")), mk_block(mk_scontinue(), mk_sempty()), "");

    let s_in: String = mk_slet_mut("inner_c", mk_ty_int(), mk_eint("0"));
    let in_inc: String = mk_sassign("inner_c", mk_ebinop("+", mk_evar("inner_c"), mk_eint("1")));
    let in_br: String = mk_eif(mk_ebinop("==", mk_evar("inner_c"), mk_eint("3")), mk_block(mk_sbreak(), mk_sempty()), "");
    let in_cont: String = mk_eif(mk_ebinop("==", mk_evar("inner_c"), mk_eint("1")), mk_block(mk_scontinue(), mk_sempty()), "");
    let tot_inc: String = mk_sassign("total", mk_ebinop("+", mk_evar("total"), mk_eint("1")));
    let in_body: String = mk_block(in_inc + "," + in_br + "," + in_cont + "," + tot_inc, mk_sempty());
    let in_loop: String = mk_swhile(mk_ebinop("<", mk_evar("inner_c"), mk_evar("max_inner")), in_body);

    let out_br: String = mk_eif(mk_ebinop("==", mk_evar("outer_c"), mk_eint("5")), mk_block(mk_sbreak(), mk_sempty()), "");
    let out_body: String = mk_block(out_inc + "," + out_cont + "," + s_in + "," + in_loop + "," + out_br, mk_sempty());
    let out_loop: String = mk_swhile(mk_ebinop("<", mk_evar("outer_c"), mk_evar("max_outer")), out_body);

    let fn2_body: String = mk_block(s_out + "," + s_tot + "," + out_loop + "," + mk_sreturn(mk_evar("total")), mk_sempty());
    let fn2_params: String = mk_param("max_outer", mk_ty_int()) + "," + mk_param("max_inner", mk_ty_int());
    let fn2: String = mk_fn("nested_multi_break_continue", fn2_params, mk_ty_int(), "", fn2_body);

    let file_node: String = mk_file(fn1 + "," + fn2);
    let bin: List[Int] = wasm_compile_ast_module(file_node, "browser", wasm_val_type_i32());

    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m2_adv_multi_break.wasm", s);
    return bin;
}

pub fn test_m2_adv_unreachable_code(fs: &FsWriteCap) -> List[Int] {
    // 1. unreachable_seq_returns(x: Int) -> Int
    // return x + 10;
    // return x + 20;
    // let mut dead = 100;
    // return dead;
    let r1: String = mk_sreturn(mk_ebinop("+", mk_evar("x"), mk_eint("10")));
    let r2: String = mk_sreturn(mk_ebinop("+", mk_evar("x"), mk_eint("20")));
    let dead_let: String = mk_slet_mut("dead", mk_ty_int(), mk_eint("100"));
    let r3: String = mk_sreturn(mk_evar("dead"));
    let fn1_body: String = mk_block(r1 + "," + r2 + "," + dead_let + "," + r3, mk_sempty());
    let fn1: String = mk_fn("unreachable_seq_returns", mk_param("x", mk_ty_int()), mk_ty_int(), "", fn1_body);

    // 2. unreachable_if_else_returns(cond: Int) -> Int
    // if cond > 0 { return 100; } else { return 200; }
    // let mut unreachable_val = 999;
    // return unreachable_val;
    let if_ret: String = mk_eif(
        mk_ebinop(">", mk_evar("cond"), mk_eint("0")),
        mk_block(mk_sreturn(mk_eint("100")), mk_sempty()),
        mk_block(mk_sreturn(mk_eint("200")), mk_sempty())
    );
    let dead2: String = mk_slet_mut("unreachable_val", mk_ty_int(), mk_eint("999"));
    let r_dead: String = mk_sreturn(mk_evar("unreachable_val"));
    let fn2_body: String = mk_block(if_ret + "," + dead2 + "," + r_dead, mk_sempty());
    let fn2: String = mk_fn("unreachable_if_else_returns", mk_param("cond", mk_ty_int()), mk_ty_int(), "", fn2_body);

    // 3. unreachable_after_infinite_break_return(n: Int) -> Int
    // while true {
    //   if n > 0 { return n * 2; }
    //   break;
    // }
    // return -1;
    let if_loop: String = mk_eif(
        mk_ebinop(">", mk_evar("n"), mk_eint("0")),
        mk_block(mk_sreturn(mk_ebinop("*", mk_evar("n"), mk_eint("2"))), mk_sempty()),
        mk_block(mk_sbreak(), mk_sempty())
    );
    let loop_stmt: String = mk_swhile(mk_ebool("true"), mk_block(if_loop, mk_sempty()));
    let fn3_body: String = mk_block(loop_stmt + "," + mk_sreturn(mk_eint("-1")), mk_sempty());
    let fn3: String = mk_fn("unreachable_after_infinite_break_return", mk_param("n", mk_ty_int()), mk_ty_int(), "", fn3_body);

    let file_node: String = mk_file(fn1 + "," + fn2 + "," + fn3);
    let bin: List[Int] = wasm_compile_ast_module(file_node, "browser", wasm_val_type_i32());

    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m2_adv_unreachable.wasm", s);
    return bin;
}

pub fn main(fs: &FsWriteCap) {
    println("=========================================================");
    println(" Running WebAssembly M2 Adversarial Control Flow Tests");
    println("=========================================================");
    test_m2_adv_empty_loops(fs);
    test_m2_adv_multi_break(fs);
    test_m2_adv_unreachable_code(fs);
    println("All WASM M2 Adversarial Control Flow tests emitted successfully!");
}
