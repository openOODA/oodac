// # WebAssembly Milestone 3 ARC Runtime Test Suite
//
// Logline: Build, emit, and verify WebAssembly binary modules testing ARC reference counting, flags, retain, release, scope drops, and reassignment drops.
//
// Setup: Run with ooda/bin/ooda check or run from qa/.
//
// Beats:
//   1. Import required modules.
//   2. Execute test assertions.
//   3. Report pass or fail with exit code.
import "oodac/emit/wasm/wasm_leb128.oo";
import "oodac/emit/wasm/wasm_opcodes.oo";
import "oodac/emit/wasm/wasm_types.oo";
import "oodac/emit/wasm/wasm_binary_builder.oo";
import "oodac/emit/wasm/wasm_lower_expr.oo";
import "oodac/emit/wasm/wasm_arc_runtime.oo";

fn assert_true(cond: Bool, msg: String) {
    if !cond { println("ASSERTION FAILED: " + msg); }
}

fn assert_eq_int(actual: Int, expected: Int, msg: String) {
    if actual != expected {
        println("ASSERTION FAILED: " + msg + " (expected " + expected.to_string() + ", got " + actual.to_string() + ")");
    }
}

pub fn build_arc_test_module(fs: &FsWriteCap) -> List[Int] {
    let mut b: WasmModuleBuilder = wasm_builder_new();
    wasm_builder_set_memory(&mut b, 1, 2);
    wasm_builder_add_export(&mut b, "memory", wasm_external_memory(), 0);

    // Type 0: (i32, i32, i32) -> i32 [init_obj]
    let mut p_init: List[Int] = list_new();
    p_init = list_push(p_init, wasm_val_type_i32());
    p_init = list_push(p_init, wasm_val_type_i32());
    p_init = list_push(p_init, wasm_val_type_i32());
    let mut r_i32: List[Int] = list_new();
    r_i32 = list_push(r_i32, wasm_val_type_i32());
    let ty_init: Int = wasm_builder_add_type(&mut b, p_init, r_i32);
    let f_init: Int = wasm_builder_add_func(&mut b, ty_init);

    let mut env_init: WasmEnv = wasm_env_new("browser", wasm_val_type_i32());
    let p_slot: Int = wasm_env_bind_var(&mut env_init, "p", wasm_val_type_i32());
    let rc_slot: Int = wasm_env_bind_var(&mut env_init, "rc", wasm_val_type_i32());
    let fl_slot: Int = wasm_env_bind_var(&mut env_init, "fl", wasm_val_type_i32());
    // p[0] = rc
    wasm_env_emit(&mut env_init, op_local_get()); wasm_env_emit_u32(&mut env_init, p_slot);
    wasm_env_emit(&mut env_init, op_local_get()); wasm_env_emit_u32(&mut env_init, rc_slot);
    wasm_env_emit(&mut env_init, op_i32_store()); wasm_env_emit_u32(&mut env_init, 2); wasm_env_emit_u32(&mut env_init, 0);
    // p[4] = fl
    wasm_env_emit(&mut env_init, op_local_get()); wasm_env_emit_u32(&mut env_init, p_slot);
    wasm_env_emit(&mut env_init, op_local_get()); wasm_env_emit_u32(&mut env_init, fl_slot);
    wasm_env_emit(&mut env_init, op_i32_store()); wasm_env_emit_u32(&mut env_init, 2); wasm_env_emit_u32(&mut env_init, 4);
    // return p
    wasm_env_emit(&mut env_init, op_local_get()); wasm_env_emit_u32(&mut env_init, p_slot);
    wasm_env_emit(&mut env_init, op_end());
    wasm_builder_set_code(&mut b, f_init, list_new(), env_init.bytecode);
    wasm_builder_add_export(&mut b, "init_obj", wasm_external_func(), f_init);

    // Type 1: (i32) -> i32
    let mut p_one: List[Int] = list_new();
    p_one = list_push(p_one, wasm_val_type_i32());
    let ty_one: Int = wasm_builder_add_type(&mut b, p_one, r_i32);

    // Func 1: test_retain
    let f_ret: Int = wasm_builder_add_func(&mut b, ty_one);
    let mut env_ret: WasmEnv = wasm_env_new("browser", wasm_val_type_i32());
    let slot_p1: Int = wasm_env_bind_var(&mut env_ret, "p", wasm_val_type_i32());
    wasm_emit_retain(&mut env_ret, slot_p1);
    wasm_arc_emit_get_refcount(&mut env_ret, slot_p1);
    wasm_env_emit(&mut env_ret, op_end());
    wasm_builder_set_code(&mut b, f_ret, list_new(), env_ret.bytecode);
    wasm_builder_add_export(&mut b, "test_retain", wasm_external_func(), f_ret);

    // Func 2: test_release
    let f_rel: Int = wasm_builder_add_func(&mut b, ty_one);
    let mut env_rel: WasmEnv = wasm_env_new("browser", wasm_val_type_i32());
    let slot_p2: Int = wasm_env_bind_var(&mut env_rel, "p", wasm_val_type_i32());
    wasm_emit_release(&mut env_rel, slot_p2);
    wasm_arc_emit_get_refcount(&mut env_rel, slot_p2);
    wasm_env_emit(&mut env_rel, op_end());
    wasm_builder_set_code(&mut b, f_rel, list_new(), env_rel.bytecode);
    wasm_builder_add_export(&mut b, "test_release", wasm_external_func(), f_rel);

    // Func 3: test_release_flags
    let f_rel_fl: Int = wasm_builder_add_func(&mut b, ty_one);
    let mut env_rel_fl: WasmEnv = wasm_env_new("browser", wasm_val_type_i32());
    let slot_p3: Int = wasm_env_bind_var(&mut env_rel_fl, "p", wasm_val_type_i32());
    wasm_emit_release(&mut env_rel_fl, slot_p3);
    wasm_arc_emit_get_flags(&mut env_rel_fl, slot_p3);
    wasm_env_emit(&mut env_rel_fl, op_end());
    wasm_builder_set_code(&mut b, f_rel_fl, list_new(), env_rel_fl.bytecode);
    wasm_builder_add_export(&mut b, "test_release_flags", wasm_external_func(), f_rel_fl);

    // Func 4: test_static_bypass
    let f_stat: Int = wasm_builder_add_func(&mut b, ty_one);
    let mut env_stat: WasmEnv = wasm_env_new("browser", wasm_val_type_i32());
    let slot_p4: Int = wasm_env_bind_var(&mut env_stat, "p", wasm_val_type_i32());
    wasm_emit_retain(&mut env_stat, slot_p4);
    wasm_emit_release(&mut env_stat, slot_p4);
    wasm_arc_emit_get_refcount(&mut env_stat, slot_p4);
    wasm_env_emit(&mut env_stat, op_end());
    wasm_builder_set_code(&mut b, f_stat, list_new(), env_stat.bytecode);
    wasm_builder_add_export(&mut b, "test_static_bypass", wasm_external_func(), f_stat);

    // Func 5: test_null_safe
    let f_null: Int = wasm_builder_add_func(&mut b, ty_one);
    let mut env_null: WasmEnv = wasm_env_new("browser", wasm_val_type_i32());
    let slot_p5: Int = wasm_env_bind_var(&mut env_null, "p", wasm_val_type_i32());
    wasm_emit_retain(&mut env_null, slot_p5);
    wasm_emit_release(&mut env_null, slot_p5);
    wasm_env_emit(&mut env_null, op_i32_const());
    wasm_env_emit_i32(&mut env_null, 42);
    wasm_env_emit(&mut env_null, op_end());
    wasm_builder_set_code(&mut b, f_null, list_new(), env_null.bytecode);
    wasm_builder_add_export(&mut b, "test_null_safe", wasm_external_func(), f_null);

    // Type 2: (i32, i32) -> i32
    let mut p_two: List[Int] = list_new();
    p_two = list_push(p_two, wasm_val_type_i32());
    p_two = list_push(p_two, wasm_val_type_i32());
    let ty_two: Int = wasm_builder_add_type(&mut b, p_two, r_i32);

    // Func 6: test_scope_drops (drops ptr1, ptr2)
    let f_scope: Int = wasm_builder_add_func(&mut b, ty_two);
    let mut env_scope: WasmEnv = wasm_env_new("browser", wasm_val_type_i32());
    let slot_s1: Int = wasm_env_bind_var(&mut env_scope, "p1", wasm_val_type_i32());
    let slot_s2: Int = wasm_env_bind_var(&mut env_scope, "p2", wasm_val_type_i32());
    let mut arc_locs: List[Int] = list_new();
    arc_locs = list_push(arc_locs, slot_s1);
    arc_locs = list_push(arc_locs, slot_s2);
    wasm_emit_scope_exit_drops(&mut env_scope, arc_locs);
    wasm_env_emit(&mut env_scope, op_i32_const());
    wasm_env_emit_i32(&mut env_scope, 1);
    wasm_env_emit(&mut env_scope, op_end());
    wasm_builder_set_code(&mut b, f_scope, list_new(), env_scope.bytecode);
    wasm_builder_add_export(&mut b, "test_scope_drops", wasm_external_func(), f_scope);

    // Func 7: test_reassign_drop (reassign p1 = p2)
    let f_reassign: Int = wasm_builder_add_func(&mut b, ty_two);
    let mut env_re: WasmEnv = wasm_env_new("browser", wasm_val_type_i32());
    let slot_r1: Int = wasm_env_bind_var(&mut env_re, "p1", wasm_val_type_i32());
    let slot_r2: Int = wasm_env_bind_var(&mut env_re, "p2", wasm_val_type_i32());
    wasm_emit_reassignment_drop(&mut env_re, slot_r1, slot_r2);
    wasm_env_emit(&mut env_re, op_local_get());
    wasm_env_emit_u32(&mut env_re, slot_r1);
    wasm_env_emit(&mut env_re, op_end());
    wasm_builder_set_code(&mut b, f_reassign, list_new(), env_re.bytecode);
    wasm_builder_add_export(&mut b, "test_reassign_drop", wasm_external_func(), f_reassign);

    // Func 8: test_return_drops (drops local, preserves ret)
    let f_ret_drops: Int = wasm_builder_add_func(&mut b, ty_two);
    let mut env_rd: WasmEnv = wasm_env_new("browser", wasm_val_type_i32());
    let slot_ret: Int = wasm_env_bind_var(&mut env_rd, "ret_p", wasm_val_type_i32());
    let slot_loc: Int = wasm_env_bind_var(&mut env_rd, "loc_p", wasm_val_type_i32());
    let mut all_locs: List[Int] = list_new();
    all_locs = list_push(all_locs, slot_ret);
    all_locs = list_push(all_locs, slot_loc);
    wasm_emit_return_drops(&mut env_rd, all_locs, slot_ret);
    wasm_env_emit(&mut env_rd, op_local_get());
    wasm_env_emit_u32(&mut env_rd, slot_ret);
    wasm_env_emit(&mut env_rd, op_end());
    wasm_builder_set_code(&mut b, f_ret_drops, list_new(), env_rd.bytecode);
    wasm_builder_add_export(&mut b, "test_return_drops", wasm_external_func(), f_ret_drops);

    let bin: List[Int] = wasm_builder_emit(b);
    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/test_m3_arc.wasm", s);
    return bin;
}

pub fn main(fs: &FsWriteCap) {
    println("=================================================");
    println(" Running WebAssembly ARC Runtime Unit Tests");
    println("=================================================");

    let bin: List[Int] = build_arc_test_module(fs);
    assert_true(list_len(bin) > 50, "m3_arc binary length > 50");
    assert_eq_int(list_get(bin, 0), 0, "magic byte 0");
    assert_eq_int(list_get(bin, 1), 97, "magic byte 'a'");
    assert_eq_int(list_get(bin, 2), 115, "magic byte 's'");
    assert_eq_int(list_get(bin, 3), 109, "magic byte 'm'");
    assert_eq_int(list_get(bin, 4), 1, "version 1");

    assert_eq_int(wasm_arc_header_size(), 8, "header size 8");
    assert_eq_int(wasm_arc_offset_refcount(), 0, "offset ref_count 0");
    assert_eq_int(wasm_arc_offset_flags(), 4, "offset flags 4");
    assert_eq_int(OO_FLAG_STATIC(), 1, "OO_FLAG_STATIC 1");
    assert_eq_int(OO_FLAG_FREED(), 2, "OO_FLAG_FREED 2");

    assert_true(wasm_arc_is_managed_type("String"), "String is managed");
    assert_true(wasm_arc_is_managed_type("List[Int]"), "List[Int] is managed");
    assert_true(!wasm_arc_is_managed_type("Int"), "Int is not managed");
    assert_true(!wasm_arc_is_managed_type("Float"), "Float is not managed");

    println("All WASM ARC test modules generated successfully!");
}
