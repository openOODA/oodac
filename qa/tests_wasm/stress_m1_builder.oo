// # WebAssembly Binary Builder Stress Suite
//
// Logline: Generate complex multi-section WebAssembly binaries with multiple types, imports, memory, data segments, and control flow.
//
// Setup: Run with ooda/bin/ooda run qa/tests_wasm/stress_m1_builder.oo.
//
// Beats:
//   1. Define bytecode push helpers for signed LEB128 constants.
//   2. Build multi-function instruction bodies (fibonacci, collatz, gcd, bitwise arithmetic, i64 operations, memory scanner).
//   3. Assemble complex multi-section WebAssembly module with imports, exports, memory limits, and data segments.
//   4. Emit and validate binary byte stream.

import "oodac/emit/wasm/wasm_leb128.oo";
import "oodac/emit/wasm/wasm_opcodes.oo";
import "oodac/emit/wasm/wasm_types.oo";
import "oodac/emit/wasm/wasm_binary_builder.oo";

fn push_i32_const(mut bc: List[Int], val: Int) -> List[Int] {
    bc = list_push(bc, op_i32_const());
    let enc: List[Int] = encode_i32_leb128(val);
    let mut i: Int = 0;
    while i < list_len(enc) { bc = list_push(bc, list_get(enc, i)); i = i + 1; }
    return bc;
}

fn push_i64_const(mut bc: List[Int], val: Int) -> List[Int] {
    bc = list_push(bc, op_i64_const());
    let enc: List[Int] = encode_i64_leb128(val);
    let mut i: Int = 0;
    while i < list_len(enc) { bc = list_push(bc, list_get(enc, i)); i = i + 1; }
    return bc;
}

fn build_fib_code() -> List[Int] {
    let mut c: List[Int] = list_new();
    c = list_push(c, op_local_get()); c = list_push(c, 0);
    c = push_i32_const(c, 1); c = list_push(c, op_i32_le_s());
    c = list_push(c, op_if()); c = list_push(c, wasm_val_type_i32());
    c = list_push(c, op_local_get()); c = list_push(c, 0);
    c = list_push(c, op_else());
    c = push_i32_const(c, 0); c = list_push(c, op_local_set()); c = list_push(c, 1);
    c = push_i32_const(c, 1); c = list_push(c, op_local_set()); c = list_push(c, 2);
    c = push_i32_const(c, 2); c = list_push(c, op_local_set()); c = list_push(c, 3);
    c = list_push(c, op_block()); c = list_push(c, wasm_block_type_empty());
    c = list_push(c, op_loop()); c = list_push(c, wasm_block_type_empty());
    c = list_push(c, op_local_get()); c = list_push(c, 3);
    c = list_push(c, op_local_get()); c = list_push(c, 0);
    c = list_push(c, op_i32_gt_s()); c = list_push(c, op_br_if()); c = list_push(c, 1);
    c = list_push(c, op_local_get()); c = list_push(c, 1);
    c = list_push(c, op_local_get()); c = list_push(c, 2);
    c = list_push(c, op_i32_add()); c = list_push(c, op_local_set()); c = list_push(c, 4);
    c = list_push(c, op_local_get()); c = list_push(c, 2); c = list_push(c, op_local_set()); c = list_push(c, 1);
    c = list_push(c, op_local_get()); c = list_push(c, 4); c = list_push(c, op_local_set()); c = list_push(c, 2);
    c = list_push(c, op_local_get()); c = list_push(c, 3);
    c = push_i32_const(c, 1); c = list_push(c, op_i32_add()); c = list_push(c, op_local_set()); c = list_push(c, 3);
    c = list_push(c, op_br()); c = list_push(c, 0);
    c = list_push(c, op_end()); c = list_push(c, op_end());
    c = list_push(c, op_local_get()); c = list_push(c, 2);
    c = list_push(c, op_end()); c = list_push(c, op_end());
    return c;
}

fn build_collatz_code() -> List[Int] {
    let mut c: List[Int] = list_new();
    c = push_i32_const(c, 0); c = list_push(c, op_local_set()); c = list_push(c, 1);
    c = list_push(c, op_block()); c = list_push(c, wasm_block_type_empty());
    c = list_push(c, op_loop()); c = list_push(c, wasm_block_type_empty());
    c = list_push(c, op_local_get()); c = list_push(c, 0);
    c = push_i32_const(c, 1); c = list_push(c, op_i32_le_s()); c = list_push(c, op_br_if()); c = list_push(c, 1);
    c = list_push(c, op_local_get()); c = list_push(c, 1);
    c = push_i32_const(c, 1); c = list_push(c, op_i32_add()); c = list_push(c, op_local_set()); c = list_push(c, 1);
    c = list_push(c, op_local_get()); c = list_push(c, 0);
    c = push_i32_const(c, 1); c = list_push(c, op_i32_and()); c = list_push(c, op_i32_eqz());
    c = list_push(c, op_if()); c = list_push(c, wasm_block_type_empty());
    c = list_push(c, op_local_get()); c = list_push(c, 0);
    c = push_i32_const(c, 2); c = list_push(c, op_i32_div_s()); c = list_push(c, op_local_set()); c = list_push(c, 0);
    c = list_push(c, op_else());
    c = list_push(c, op_local_get()); c = list_push(c, 0);
    c = push_i32_const(c, 3); c = list_push(c, op_i32_mul());
    c = push_i32_const(c, 1); c = list_push(c, op_i32_add()); c = list_push(c, op_local_set()); c = list_push(c, 0);
    c = list_push(c, op_end());
    c = list_push(c, op_br()); c = list_push(c, 0);
    c = list_push(c, op_end()); c = list_push(c, op_end());
    c = list_push(c, op_local_get()); c = list_push(c, 1); c = list_push(c, op_end());
    return c;
}

fn build_gcd_code() -> List[Int] {
    let mut c: List[Int] = list_new();
    c = list_push(c, op_block()); c = list_push(c, wasm_block_type_empty());
    c = list_push(c, op_loop()); c = list_push(c, wasm_block_type_empty());
    c = list_push(c, op_local_get()); c = list_push(c, 1);
    c = list_push(c, op_i32_eqz()); c = list_push(c, op_br_if()); c = list_push(c, 1);
    c = list_push(c, op_local_get()); c = list_push(c, 0);
    c = list_push(c, op_local_get()); c = list_push(c, 1);
    c = list_push(c, op_i32_rem_s()); c = list_push(c, op_local_set()); c = list_push(c, 2);
    c = list_push(c, op_local_get()); c = list_push(c, 1); c = list_push(c, op_local_set()); c = list_push(c, 0);
    c = list_push(c, op_local_get()); c = list_push(c, 2); c = list_push(c, op_local_set()); c = list_push(c, 1);
    c = list_push(c, op_br()); c = list_push(c, 0);
    c = list_push(c, op_end()); c = list_push(c, op_end());
    c = list_push(c, op_local_get()); c = list_push(c, 0); c = list_push(c, op_end());
    return c;
}

fn build_bitwise_code() -> List[Int] {
    let mut c: List[Int] = list_new();
    c = list_push(c, op_local_get()); c = list_push(c, 0);
    c = list_push(c, op_local_get()); c = list_push(c, 1);
    c = list_push(c, op_i32_xor());
    c = list_push(c, op_local_get()); c = list_push(c, 0);
    c = push_i32_const(c, 15); c = list_push(c, op_i32_and()); c = list_push(c, op_i32_or());
    c = list_push(c, op_local_get()); c = list_push(c, 1);
    c = push_i32_const(c, 2); c = list_push(c, op_i32_shl()); c = list_push(c, op_i32_add());
    c = list_push(c, op_local_get()); c = list_push(c, 0);
    c = push_i32_const(c, 1); c = list_push(c, op_i32_shr_s()); c = list_push(c, op_i32_sub());
    c = list_push(c, op_end());
    return c;
}

fn build_i64_ops_code() -> List[Int] {
    let mut c: List[Int] = list_new();
    c = list_push(c, op_local_get()); c = list_push(c, 0);
    c = list_push(c, op_local_get()); c = list_push(c, 1);
    c = list_push(c, op_i64_mul()); c = list_push(c, op_local_set()); c = list_push(c, 2);
    c = list_push(c, op_local_get()); c = list_push(c, 0);
    c = push_i64_const(c, 3); c = list_push(c, op_i64_shr_s()); c = list_push(c, op_local_set()); c = list_push(c, 3);
    c = list_push(c, op_local_get()); c = list_push(c, 2);
    c = list_push(c, op_local_get()); c = list_push(c, 3);
    c = list_push(c, op_i64_add());
    c = list_push(c, op_local_get()); c = list_push(c, 1);
    c = push_i64_const(c, 2); c = list_push(c, op_i64_shl()); c = list_push(c, op_i64_sub());
    c = list_push(c, op_end());
    return c;
}

fn build_mem_sum_code() -> List[Int] {
    let mut c: List[Int] = list_new();
    c = push_i32_const(c, 0); c = list_push(c, op_local_set()); c = list_push(c, 3);
    c = push_i32_const(c, 0); c = list_push(c, op_local_set()); c = list_push(c, 4);
    c = list_push(c, op_local_get()); c = list_push(c, 0); c = list_push(c, op_local_set()); c = list_push(c, 5);
    c = list_push(c, op_block()); c = list_push(c, wasm_block_type_empty());
    c = list_push(c, op_loop()); c = list_push(c, wasm_block_type_empty());
    c = list_push(c, op_local_get()); c = list_push(c, 4);
    c = list_push(c, op_local_get()); c = list_push(c, 1);
    c = list_push(c, op_i32_ge_s()); c = list_push(c, op_br_if()); c = list_push(c, 1);
    c = list_push(c, op_local_get()); c = list_push(c, 3);
    c = list_push(c, op_local_get()); c = list_push(c, 5);
    c = list_push(c, op_i32_load()); c = list_push(c, 2); c = list_push(c, 0);
    c = list_push(c, op_i32_add()); c = list_push(c, op_local_set()); c = list_push(c, 3);
    c = list_push(c, op_local_get()); c = list_push(c, 5);
    c = list_push(c, op_local_get()); c = list_push(c, 2);
    c = list_push(c, op_i32_add()); c = list_push(c, op_local_set()); c = list_push(c, 5);
    c = list_push(c, op_local_get()); c = list_push(c, 4);
    c = push_i32_const(c, 1); c = list_push(c, op_i32_add()); c = list_push(c, op_local_set()); c = list_push(c, 4);
    c = list_push(c, op_br()); c = list_push(c, 0);
    c = list_push(c, op_end()); c = list_push(c, op_end());
    c = list_push(c, op_local_get()); c = list_push(c, 3); c = list_push(c, op_end());
    return c;
}

fn build_start_code() -> List[Int] {
    let mut c: List[Int] = list_new();
    c = push_i32_const(c, 0); c = push_i32_const(c, 16);
    c = list_push(c, op_i32_store()); c = list_push(c, 2); c = list_push(c, 0);
    c = push_i32_const(c, 4); c = push_i32_const(c, 20);
    c = list_push(c, op_i32_store()); c = list_push(c, 2); c = list_push(c, 0);
    c = push_i32_const(c, 1); c = push_i32_const(c, 0);
    c = push_i32_const(c, 1); c = push_i32_const(c, 8);
    c = list_push(c, op_call()); c = list_push(c, 0);
    c = list_push(c, op_drop()); c = list_push(c, op_end());
    return c;
}

pub fn generate_stress_module(fs: &FsWriteCap) -> List[Int] {
    let mut b: WasmModuleBuilder = wasm_builder_new();
    let mut p_fd: List[Int] = list_new(); p_fd = list_push(p_fd, wasm_val_type_i32()); p_fd = list_push(p_fd, wasm_val_type_i32()); p_fd = list_push(p_fd, wasm_val_type_i32()); p_fd = list_push(p_fd, wasm_val_type_i32());
    let mut r_fd: List[Int] = list_new(); r_fd = list_push(r_fd, wasm_val_type_i32());
    let ty_fd: Int = wasm_builder_add_type(&mut b, p_fd, r_fd);

    let mut p_i32: List[Int] = list_new(); p_i32 = list_push(p_i32, wasm_val_type_i32());
    let mut r_i32: List[Int] = list_new(); r_i32 = list_push(r_i32, wasm_val_type_i32());
    let ty_i32_i32: Int = wasm_builder_add_type(&mut b, p_i32, r_i32);

    let mut p_2i32: List[Int] = list_new(); p_2i32 = list_push(p_2i32, wasm_val_type_i32()); p_2i32 = list_push(p_2i32, wasm_val_type_i32());
    let ty_2i32_i32: Int = wasm_builder_add_type(&mut b, p_2i32, r_i32);

    let mut p_2i64: List[Int] = list_new(); p_2i64 = list_push(p_2i64, wasm_val_type_i64()); p_2i64 = list_push(p_2i64, wasm_val_type_i64());
    let mut r_i64: List[Int] = list_new(); r_i64 = list_push(r_i64, wasm_val_type_i64());
    let ty_2i64_i64: Int = wasm_builder_add_type(&mut b, p_2i64, r_i64);

    let mut p_3i32: List[Int] = list_new(); p_3i32 = list_push(p_3i32, wasm_val_type_i32()); p_3i32 = list_push(p_3i32, wasm_val_type_i32()); p_3i32 = list_push(p_3i32, wasm_val_type_i32());
    let ty_3i32_i32: Int = wasm_builder_add_type(&mut b, p_3i32, r_i32);

    let ty_void: Int = wasm_builder_add_type(&mut b, list_new(), list_new());
    let _imp_fd: Int = wasm_builder_add_import_func(&mut b, "wasi_snapshot_preview1", "fd_write", ty_fd);
    wasm_builder_set_memory(&mut b, 2, 10);
    wasm_builder_add_export(&mut b, "memory", wasm_external_memory(), 0);

    let msg: String = "Stress Test Passed!\n";
    let mut d0: List[Int] = list_new(); let mut di: Int = 0;
    while di < chars_len(msg) { d0 = list_push(d0, byte_at(msg, di)); di = di + 1; }
    wasm_builder_add_data(&mut b, 16, d0);

    let mut d1: List[Int] = list_new();
    d1 = list_push(d1, 10); d1 = list_push(d1, 0); d1 = list_push(d1, 0); d1 = list_push(d1, 0); d1 = list_push(d1, 20); d1 = list_push(d1, 0); d1 = list_push(d1, 0); d1 = list_push(d1, 0);
    d1 = list_push(d1, 30); d1 = list_push(d1, 0); d1 = list_push(d1, 0); d1 = list_push(d1, 0); d1 = list_push(d1, 40); d1 = list_push(d1, 0); d1 = list_push(d1, 0); d1 = list_push(d1, 0);
    wasm_builder_add_data(&mut b, 1024, d1);

    let f_fib: Int = wasm_builder_add_func(&mut b, ty_i32_i32);
    let mut loc_fib: List[Int] = list_new();
    loc_fib = list_push(loc_fib, wasm_val_type_i32()); loc_fib = list_push(loc_fib, wasm_val_type_i32()); loc_fib = list_push(loc_fib, wasm_val_type_i32()); loc_fib = list_push(loc_fib, wasm_val_type_i32());
    wasm_builder_set_code(&mut b, f_fib, loc_fib, build_fib_code()); wasm_builder_add_export(&mut b, "fib", wasm_external_func(), 1);

    let f_collatz: Int = wasm_builder_add_func(&mut b, ty_i32_i32);
    let mut loc_collatz: List[Int] = list_new(); loc_collatz = list_push(loc_collatz, wasm_val_type_i32());
    wasm_builder_set_code(&mut b, f_collatz, loc_collatz, build_collatz_code()); wasm_builder_add_export(&mut b, "collatz", wasm_external_func(), 2);

    let f_gcd: Int = wasm_builder_add_func(&mut b, ty_2i32_i32);
    let mut loc_gcd: List[Int] = list_new(); loc_gcd = list_push(loc_gcd, wasm_val_type_i32());
    wasm_builder_set_code(&mut b, f_gcd, loc_gcd, build_gcd_code()); wasm_builder_add_export(&mut b, "gcd", wasm_external_func(), 3);

    let f_bit: Int = wasm_builder_add_func(&mut b, ty_2i32_i32);
    wasm_builder_set_code(&mut b, f_bit, list_new(), build_bitwise_code()); wasm_builder_add_export(&mut b, "bitwise_mix", wasm_external_func(), 4);

    let f_i64: Int = wasm_builder_add_func(&mut b, ty_2i64_i64);
    let mut loc_i64: List[Int] = list_new();
    loc_i64 = list_push(loc_i64, wasm_val_type_i64()); loc_i64 = list_push(loc_i64, wasm_val_type_i64());
    loc_i64 = list_push(loc_i64, wasm_val_type_i32()); loc_i64 = list_push(loc_i64, wasm_val_type_i32()); loc_i64 = list_push(loc_i64, wasm_val_type_i64());
    wasm_builder_set_code(&mut b, f_i64, loc_i64, build_i64_ops_code());
    wasm_builder_add_export(&mut b, "i64_ops", wasm_external_func(), 5);

    let f_mem: Int = wasm_builder_add_func(&mut b, ty_3i32_i32);
    let mut loc_mem: List[Int] = list_new();
    loc_mem = list_push(loc_mem, wasm_val_type_i32()); loc_mem = list_push(loc_mem, wasm_val_type_i32()); loc_mem = list_push(loc_mem, wasm_val_type_i32());
    wasm_builder_set_code(&mut b, f_mem, loc_mem, build_mem_sum_code());
    wasm_builder_add_export(&mut b, "mem_read_sum", wasm_external_func(), 6);

    let f_start: Int = wasm_builder_add_func(&mut b, ty_void);
    wasm_builder_set_code(&mut b, f_start, list_new(), build_start_code());
    wasm_builder_add_export(&mut b, "_start", wasm_external_func(), 7);

    let bin: List[Int] = wasm_builder_emit(b);
    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/tmp/tests_wasm_stress_complex.wasm", s);
    return bin;
}

pub fn main(fs: &FsWriteCap) {
    println("=================================================");
    println(" Generating Complex Multi-Section WASM Binary");
    println("=================================================");
    let bin: List[Int] = generate_stress_module(fs);
    println("Successfully generated tests_wasm_stress_complex.wasm (size: " + list_len(bin).to_string() + " bytes)");
}
