// # WebAssembly Milestone 2 Adversarial WASI Standalone Suite
//
// Logline: Build, emit, and verify standalone WASI binaries combining float arithmetic, bitwise shifts, multi-break loops, and wasmtime execution.
//
// Setup: Run with ooda/bin/ooda check or run from qa/.
//
// Beats:
//   1. Import required modules.
//   2. Execute test assertions.
//   3. Report pass or fail with exit code.
import "oodac/emit/wasm/wasm_leb128.oo";
import "oodac/emit/wasm/wasm_opcodes.oo";
import "oodac/emit/wasm/wasm_types.oo";
import "oodac/emit/wasm/wasm_binary_builder.oo";
import "oodac/emit/wasm/wasm_lower_expr.oo";
import "oodac/emit/wasm/wasm_lower_stmt.oo";
import "oodac/emit/wasm/wasm_lower_control.oo";
import "oodac/emit/wasm/wasm_lower_fn.oo";
import "oodac/ast/ast.oo";

pub fn test_m2_adv_wasi_standalone(fs: &FsWriteCap) -> List[Int] {
    // fn compute_val(base: Int) -> Int:
    // let mut acc = base;
    // let mut i = 0;
    // while true {
    //   if i == 5 { break; }
    //   acc = (acc << 1) ^ (i * 3);
    //   i = i + 1;
    // }
    // return acc & 255;
    let s_acc: String = mk_slet_mut("acc", mk_ty_int(), mk_evar("base"));
    let s_i: String = mk_slet_mut("i", mk_ty_int(), mk_eint("0"));
    let if_br: String = mk_eif(mk_ebinop("==", mk_evar("i"), mk_eint("5")), mk_block(mk_sbreak(), mk_sempty()), "");
    let shl_acc: String = mk_ebinop("<<", mk_evar("acc"), mk_eint("1"));
    let mul_i: String = mk_ebinop("*", mk_evar("i"), mk_eint("3"));
    let next_acc: String = mk_sassign("acc", mk_ebinop("^", shl_acc, mul_i));
    let next_i: String = mk_sassign("i", mk_ebinop("+", mk_evar("i"), mk_eint("1")));
    let w_body: String = mk_block(if_br + "," + next_acc + "," + next_i, mk_sempty());
    let w_loop: String = mk_swhile(mk_ebool("true"), w_body);
    let ret_stmt: String = mk_sreturn(mk_ebinop("%", mk_evar("acc"), mk_eint("100")));
    let fn1_body: String = mk_block(s_acc + "," + s_i + "," + w_loop + "," + ret_stmt, mk_sempty());
    let fn1: String = mk_fn("compute_val", mk_param("base", mk_ty_int()), mk_ty_int(), "", fn1_body);

    // fn main() -> Int { return compute_val(7); }
    // Trace for compute_val(7):
    // i=0: acc = (7 << 1) ^ 0 = 14
    // i=1: acc = (14 << 1) ^ 3 = 28 ^ 3 = 31
    // i=2: acc = (31 << 1) ^ 6 = 62 ^ 6 = 56
    // i=3: acc = (56 << 1) ^ 9 = 112 ^ 9 = 121
    // i=4: acc = (121 << 1) ^ 12 = 242 ^ 12 = 254
    // i=5: break -> returns 254 & 255 = 254
    let main_body: String = mk_block(mk_sreturn(mk_ecall("compute_val", mk_eint("7"))), mk_sempty());
    let main_fn: String = mk_fn("main", "", mk_ty_int(), "", main_body);

    let file_node: String = mk_file(fn1 + "," + main_fn);
    let bin: List[Int] = wasm_compile_ast_module(file_node, "wasi", wasm_val_type_i32());

    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m2_adv_wasi_standalone.wasm", s);
    return bin;
}

pub fn main(fs: &FsWriteCap) {
    println("=========================================================");
    println(" Running WebAssembly M2 Adversarial WASI Unit Tests");
    println("=========================================================");
    test_m2_adv_wasi_standalone(fs);
    println("All WASM M2 Adversarial WASI tests emitted successfully!");
}
