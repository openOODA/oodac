// # WebAssembly Milestone 4 Capability Sandboxing & Lowering Test Suite
//
// Logline: Validates compile-time capability token recognition, subsumption hierarchy, fail-closed sandboxing assertions, and zero-cost WebAssembly lowering.
//
// Setup: Run with ooda/bin/ooda check or run from qa/.
//
// Beats:
//   1. Import required modules.
//   2. Execute test assertions.
//   3. Report pass or fail with exit code.
import "oodac/ast/ast.oo";
import "oodac/emit/wasm/wasm_cap_lowering.oo";

fn assert_true(cond: Bool, msg: String) {
    if !cond { println("ASSERTION FAILED (expected true): " + msg); process_exit(1); }
}

fn assert_false(cond: Bool, msg: String) {
    if cond { println("ASSERTION FAILED (expected false): " + msg); process_exit(1); }
}

fn assert_eq_str(actual: String, expected: String, msg: String) {
    if actual != expected {
        println("ASSERTION FAILED: " + msg + " (expected '" + expected + "', got '" + actual + "')");
        process_exit(1);
    }
}

pub fn test_cap_type_cleaning() {
    assert_eq_str(wasm_clean_cap_type_str("&FsCap"), "FsCap", "clean &FsCap");
    assert_eq_str(wasm_clean_cap_type_str("&FsReadCap"), "FsReadCap", "clean &FsReadCap");
    assert_eq_str(wasm_clean_cap_type_str("&mut FsWriteCap"), "FsWriteCap", "clean &mut FsWriteCap");
    assert_eq_str(wasm_clean_cap_type_str("TyCap(TimeCap)"), "TimeCap", "clean TyCap(TimeCap)");
    assert_eq_str(wasm_clean_cap_type_str("TyRef(TyCap(RandCap))"), "RandCap", "clean TyRef(TyCap(RandCap))");
    assert_eq_str(wasm_clean_cap_type_str("TyRefMut(TyName(ProcessCap))"), "ProcessCap", "clean TyRefMut(TyName(ProcessCap))");
    assert_true(is_capability_type_str("&FsCap"), "&FsCap is cap");
    assert_true(is_capability_type_str("&FsReadCap"), "&FsReadCap is cap");
    assert_true(is_capability_type_str("&FsWriteCap"), "&FsWriteCap is cap");
    assert_true(is_capability_type_str("&TimeCap"), "&TimeCap is cap");
    assert_true(is_capability_type_str("&RandCap"), "&RandCap is cap");
    assert_true(is_capability_type_str("&ProcessCap"), "&ProcessCap is cap");
    assert_true(is_capability_type_str("&SysCap"), "&SysCap is cap");
    assert_true(is_capability_type_str("&NetCap"), "&NetCap is cap");
    assert_false(is_capability_type_str("Int"), "Int is not cap");
    assert_false(is_capability_type_str("String"), "String is not cap");
    assert_false(is_capability_type_str("TyFloat"), "TyFloat is not cap");
}

pub fn test_cap_subsumption_and_hierarchy() {
    assert_true(wasm_cap_subsumes("FsCap", "FsCap"), "FsCap subsumes FsCap");
    assert_true(wasm_cap_subsumes("FsCap", "FsReadCap"), "FsCap subsumes FsReadCap");
    assert_true(wasm_cap_subsumes("FsCap", "FsWriteCap"), "FsCap subsumes FsWriteCap");
    assert_false(wasm_cap_subsumes("FsReadCap", "FsWriteCap"), "FsReadCap does NOT subsume FsWriteCap");
    assert_false(wasm_cap_subsumes("FsWriteCap", "FsReadCap"), "FsWriteCap does NOT subsume FsReadCap");
    assert_false(wasm_cap_subsumes("FsReadCap", "FsCap"), "FsReadCap does NOT subsume FsCap");
    assert_true(wasm_cap_subsumes("SysCap", "ProcessCap"), "SysCap subsumes ProcessCap");
    assert_false(wasm_cap_subsumes("ProcessCap", "SysCap"), "ProcessCap does NOT subsume SysCap");
    assert_true(wasm_cap_subsumes("NetCap", "HttpCap"), "NetCap subsumes HttpCap");
    assert_true(wasm_cap_subsumes("NetCap", "TcpCap"), "NetCap subsumes TcpCap");
    assert_true(wasm_cap_subsumes("NetCap", "BindCap"), "NetCap subsumes BindCap");
    assert_true(wasm_cap_subsumes("NetCap", "UdpCap"), "NetCap subsumes UdpCap");
    assert_false(wasm_cap_subsumes("HttpCap", "TcpCap"), "HttpCap does NOT subsume TcpCap");
    assert_false(wasm_cap_subsumes("TcpCap", "BindCap"), "TcpCap does NOT subsume BindCap");
    assert_true(wasm_cap_subsumes("AllocCap", "ArenaCap"), "AllocCap subsumes ArenaCap");
    assert_true(wasm_cap_subsumes("AllocCap", "MemCap"), "AllocCap subsumes MemCap");
    assert_false(wasm_cap_subsumes("ArenaCap", "AllocCap"), "ArenaCap does NOT subsume AllocCap");
}

pub fn test_cap_grant_checking() {
    let mut granted1: List[String] = list_new();
    granted1 = list_push(granted1, "FsReadCap");
    granted1 = list_push(granted1, "TimeCap");
    assert_true(wasm_lower_cap_check("FsReadCap", granted1), "granted1 has FsReadCap");
    assert_true(wasm_lower_cap_check("TimeCap", granted1), "granted1 has TimeCap");
    assert_false(wasm_lower_cap_check("FsWriteCap", granted1), "granted1 lacks FsWriteCap");
    assert_false(wasm_lower_cap_check("ProcessCap", granted1), "granted1 lacks ProcessCap");
    assert_false(wasm_lower_cap_check("SysCap", granted1), "granted1 lacks SysCap");

    let mut granted2: List[String] = list_new();
    granted2 = list_push(granted2, "FsCap");
    granted2 = list_push(granted2, "SysCap");
    assert_true(wasm_lower_cap_check("FsReadCap", granted2), "granted2 FsCap covers FsReadCap");
    assert_true(wasm_lower_cap_check("FsWriteCap", granted2), "granted2 FsCap covers FsWriteCap");
    assert_true(wasm_lower_cap_check("ProcessCap", granted2), "granted2 SysCap covers ProcessCap");
    assert_false(wasm_lower_cap_check("NetCap", granted2), "granted2 lacks NetCap");
}

pub fn test_effectful_syscall_sandboxing() {
    assert_eq_str(wasm_syscall_required_cap("read_file"), "FsReadCap", "read_file needs FsReadCap");
    assert_eq_str(wasm_syscall_required_cap("write_file"), "FsWriteCap", "write_file needs FsWriteCap");
    assert_eq_str(wasm_syscall_required_cap("sys_exec"), "ProcessCap", "sys_exec needs ProcessCap");
    assert_eq_str(wasm_syscall_required_cap("now_ms"), "TimeCap", "now_ms needs TimeCap");
    assert_eq_str(wasm_syscall_required_cap("random_int"), "RandCap", "random_int needs RandCap");
    assert_eq_str(wasm_syscall_required_cap("fetch"), "HttpCap", "fetch needs HttpCap");
    assert_eq_str(wasm_syscall_required_cap("python_embed"), "SysCap", "python_embed needs SysCap");

    let mut caps_read_only: List[String] = list_new();
    caps_read_only = list_push(caps_read_only, "FsReadCap");
    let res_read: Result[Bool, String] = wasm_assert_syscall_granted("read_file", caps_read_only);
    assert_true(res_read.is_ok(), "read_file allowed with FsReadCap");
    let res_write_fail: Result[Bool, String] = wasm_assert_syscall_granted("write_file", caps_read_only);
    assert_false(res_write_fail.is_ok(), "write_file rejected with FsReadCap");

    let mut caps_time_only: List[String] = list_new();
    caps_time_only = list_push(caps_time_only, "TimeCap");
    let res_time: Result[Bool, String] = wasm_assert_syscall_granted("now_ms", caps_time_only);
    assert_true(res_time.is_ok(), "now_ms allowed with TimeCap");
    let res_rand_fail: Result[Bool, String] = wasm_assert_syscall_granted("random_int", caps_time_only);
    assert_false(res_rand_fail.is_ok(), "random_int rejected without RandCap");

    let mut caps_empty: List[String] = list_new();
    let res_exec_fail: Result[Bool, String] = wasm_assert_syscall_granted("sys_exec", caps_empty);
    assert_false(res_exec_fail.is_ok(), "sys_exec rejected with empty caps");
}

pub fn test_cap_forging_rejection() {
    assert_false(is_capability_type_str("42"), "int lit is not cap");
    assert_false(is_capability_type_str("-1"), "neg int is not cap");
    assert_false(is_capability_type_str("0x1234"), "hex is not cap");
    assert_false(is_capability_type_str("FakeFsCap"), "FakeFsCap is not cap");
    assert_false(is_capability_type_str("FsCapFake"), "FsCapFake is not cap");
    assert_false(is_capability_type_str("FsCap_Forged"), "FsCap_Forged is not cap");
    assert_false(is_capability_type_str("UserAdminCap"), "UserAdminCap is not cap");
    assert_false(is_capability_type_str(""), "empty str is not cap");

    assert_false(wasm_cap_subsumes("FakeCap", "FsReadCap"), "fake grant rejected");
    assert_false(wasm_cap_subsumes("", "FsReadCap"), "empty grant rejected");
    assert_false(wasm_cap_subsumes("FsReadCap", ""), "empty required rejected");
}

pub fn test_ast_cap_extraction() {
    let p1: String = mk_param("fs", mk_ty_cap("FsCap"));
    let p2: String = mk_param("count", mk_ty_int());
    let p3: String = mk_param("time", mk_ty_cap("TimeCap"));
    let params_str: String = p1 + "," + p2 + "," + p3;
    let n_p: Int = list_len_str(params_str);
    let extracted: List[String] = wasm_extract_caps_from_params("fn_dummy," + params_str + ",TyUnit,body", n_p + 1);
    if list_len(extracted) != 2 { println("ASSERTION FAILED: extracted caps len"); process_exit(1); }
    assert_eq_str(list_get(extracted, 0), "FsCap", "extracted cap 0");
    assert_eq_str(list_get(extracted, 1), "TimeCap", "extracted cap 1");
    assert_true(wasm_lower_cap_check("FsReadCap", extracted), "extracted caps cover FsReadCap");
    assert_true(wasm_lower_cap_check("TimeCap", extracted), "extracted caps cover TimeCap");
    assert_false(wasm_lower_cap_check("ProcessCap", extracted), "extracted caps reject ProcessCap");
}

pub fn test_param_filtering_and_zero_cost() {
    let mut names: List[String] = list_new();
    names = list_push(names, "fs");
    names = list_push(names, "x");
    names = list_push(names, "sys");
    names = list_push(names, "y");

    let mut types: List[String] = list_new();
    types = list_push(types, "&FsCap");
    types = list_push(types, "Int");
    types = list_push(types, "&SysCap");
    types = list_push(types, "Float");

    let filtered: List[String] = wasm_filter_capability_params(names, types);
    if list_len(filtered) != 2 { println("ASSERTION FAILED: filtered len"); process_exit(1); }
    assert_eq_str(list_get(filtered, 0), "x", "param 0 is x");
    assert_eq_str(list_get(filtered, 1), "y", "param 1 is y");
}

pub fn main() {
    println("=================================================");
    println(" Running WebAssembly M4 Capability Unit Tests");
    println("=================================================");
    test_cap_type_cleaning();
    test_cap_subsumption_and_hierarchy();
    test_cap_grant_checking();
    test_effectful_syscall_sandboxing();
    test_cap_forging_rejection();
    test_ast_cap_extraction();
    test_param_filtering_and_zero_cost();
    println("All WASM M4 Capability unit tests passed successfully!");
}
