// # WebAssembly Binary Builder Test Suite
//
// Logline: Build, emit, and verify WebAssembly binary modules including function exports, memory, data segments, and WASI Preview1 host imports.
//
// Setup: Run with ooda/bin/ooda check or run from qa/.
//
// Beats:
//   1. Import required modules.
//   2. Execute test assertions.
//   3. Report pass or fail with exit code.
import "oodac/emit/wasm/wasm_leb128.oo";
import "oodac/emit/wasm/wasm_opcodes.oo";
import "oodac/emit/wasm/wasm_types.oo";
import "oodac/emit/wasm/wasm_binary_builder.oo";

fn assert_true(cond: Bool, msg: String) {
    if !cond {
        println("ASSERTION FAILED: " + msg);
    }
}

fn assert_eq_int(actual: Int, expected: Int, msg: String) {
    if actual != expected {
        println("ASSERTION FAILED: " + msg + " (expected " + expected.to_string() + ", got " + actual.to_string() + ")");
    }
}

pub fn test_add_module(fs: &FsWriteCap) -> List[Int] {
    let mut b: WasmModuleBuilder = wasm_builder_new();

    let mut p: List[Int] = list_new();
    p = list_push(p, wasm_val_type_i32());
    p = list_push(p, wasm_val_type_i32());

    let mut r: List[Int] = list_new();
    r = list_push(r, wasm_val_type_i32());

    let ty: Int = wasm_builder_add_type(&mut b, p, r);
    assert_eq_int(ty, 0, "add func type index");

    // Test type deduplication
    let ty_dup: Int = wasm_builder_add_type(&mut b, p, r);
    assert_eq_int(ty_dup, 0, "type deduplication index");

    let f_idx: Int = wasm_builder_add_func(&mut b, ty);
    assert_eq_int(f_idx, 0, "add func index");

    let mut locals: List[Int] = list_new();
    let mut code: List[Int] = list_new();
    code = list_push(code, op_local_get());
    code = list_push(code, 0);
    code = list_push(code, op_local_get());
    code = list_push(code, 1);
    code = list_push(code, op_i32_add());
    code = list_push(code, op_end());
    wasm_builder_set_code(&mut b, f_idx, locals, code);

    wasm_builder_add_export(&mut b, "add", wasm_external_func(), f_idx);

    let bin: List[Int] = wasm_builder_emit(b);
    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_wasm_add.wasm", s);
    return bin;
}

pub fn test_memory_data_module(fs: &FsWriteCap) -> List[Int] {
    let mut b: WasmModuleBuilder = wasm_builder_new();
    wasm_builder_set_memory(&mut b, 1, 2);
    wasm_builder_add_export(&mut b, "memory", wasm_external_memory(), 0);

    let mut data: List[Int] = list_new();
    data = list_push(data, 72); data = list_push(data, 101); data = list_push(data, 108);
    data = list_push(data, 108); data = list_push(data, 111); data = list_push(data, 10);
    wasm_builder_add_data(&mut b, 16, data);

    let mut p: List[Int] = list_new();
    let mut r: List[Int] = list_new();
    r = list_push(r, wasm_val_type_i32());
    let ty: Int = wasm_builder_add_type(&mut b, p, r);
    let f: Int = wasm_builder_add_func(&mut b, ty);

    let mut code: List[Int] = list_new();
    code = list_push(code, op_i32_const());
    code = list_push(code, 16);
    code = list_push(code, op_end());
    wasm_builder_set_code(&mut b, f, list_new(), code);
    wasm_builder_add_export(&mut b, "get_offset", wasm_external_func(), f);

    let bin: List[Int] = wasm_builder_emit(b);
    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_wasm_mem.wasm", s);
    return bin;
}

pub fn test_wasi_start_module(fs: &FsWriteCap) -> List[Int] {
    let mut b: WasmModuleBuilder = wasm_builder_new();

    // Type 0: fd_write (i32, i32, i32, i32) -> (i32)
    let mut p_fd: List[Int] = list_new();
    p_fd = list_push(p_fd, wasm_val_type_i32());
    p_fd = list_push(p_fd, wasm_val_type_i32());
    p_fd = list_push(p_fd, wasm_val_type_i32());
    p_fd = list_push(p_fd, wasm_val_type_i32());
    let mut r_fd: List[Int] = list_new();
    r_fd = list_push(r_fd, wasm_val_type_i32());
    let ty_fd: Int = wasm_builder_add_type(&mut b, p_fd, r_fd);

    let _imp: Int = wasm_builder_add_import_func(&mut b, "wasi_snapshot_preview1", "fd_write", ty_fd);

    // Type 1: _start () -> ()
    let mut p_s: List[Int] = list_new();
    let mut r_s: List[Int] = list_new();
    let ty_s: Int = wasm_builder_add_type(&mut b, p_s, r_s);

    let f_start: Int = wasm_builder_add_func(&mut b, ty_s);

    wasm_builder_set_memory(&mut b, 1, -1);
    wasm_builder_add_export(&mut b, "memory", wasm_external_memory(), 0);

    let msg: String = "Hello from WASM M1!\n";
    let mut msg_bytes: List[Int] = list_new();
    let mut mi: Int = 0;
    while mi < chars_len(msg) {
        msg_bytes = list_push(msg_bytes, byte_at(msg, mi));
        mi = mi + 1;
    }
    wasm_builder_add_data(&mut b, 16, msg_bytes);

    let mut code: List[Int] = list_new();
    // iovec[0].ptr = 16
    code = list_push(code, op_i32_const()); code = list_push(code, 0);
    code = list_push(code, op_i32_const()); code = list_push(code, 16);
    code = list_push(code, op_i32_store()); code = list_push(code, 2); code = list_push(code, 0);
    // iovec[0].len = 20
    code = list_push(code, op_i32_const()); code = list_push(code, 4);
    code = list_push(code, op_i32_const()); code = list_push(code, chars_len(msg));
    code = list_push(code, op_i32_store()); code = list_push(code, 2); code = list_push(code, 0);
    // fd_write(1, 0, 1, 8)
    code = list_push(code, op_i32_const()); code = list_push(code, 1);
    code = list_push(code, op_i32_const()); code = list_push(code, 0);
    code = list_push(code, op_i32_const()); code = list_push(code, 1);
    code = list_push(code, op_i32_const()); code = list_push(code, 8);
    code = list_push(code, op_call()); code = list_push(code, 0);
    code = list_push(code, op_drop());
    code = list_push(code, op_end());
    wasm_builder_set_code(&mut b, f_start, list_new(), code);

    // Export _start (function index 1)
    wasm_builder_add_export(&mut b, "_start", wasm_external_func(), 1);

    let bin: List[Int] = wasm_builder_emit(b);
    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_wasm_wasi.wasm", s);
    return bin;
}

pub fn main(fs: &FsWriteCap) {
    println("=================================================");
    println(" Running WebAssembly Binary Builder Unit Tests");
    println("=================================================");

    let bin_add: List[Int] = test_add_module(fs);
    assert_true(list_len(bin_add) > 8, "add module non-empty");
    assert_eq_int(list_get(bin_add, 0), 0, "magic 0");
    assert_eq_int(list_get(bin_add, 1), 97, "magic 'a'");
    assert_eq_int(list_get(bin_add, 2), 115, "magic 's'");
    assert_eq_int(list_get(bin_add, 3), 109, "magic 'm'");
    assert_eq_int(list_get(bin_add, 4), 1, "version 1");

    let bin_mem: List[Int] = test_memory_data_module(fs);
    assert_true(list_len(bin_mem) > 8, "mem module non-empty");

    let bin_wasi: List[Int] = test_wasi_start_module(fs);
    assert_true(list_len(bin_wasi) > 8, "wasi module non-empty");

    println("All WASM Binary Builder unit tests passed successfully!");
}
