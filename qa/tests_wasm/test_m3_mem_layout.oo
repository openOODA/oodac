// # WebAssembly Milestone 3 Linear Memory & Allocator Test Suite
//
// Logline: Build, emit, and verify WebAssembly binary modules for 4-tier linear memory layout, dynamic heap allocation, page growth, memcpy, and memset.
//
// Setup: Run with ooda/bin/ooda check or run from qa/.
//
// Beats:
//   1. Import required modules.
//   2. Execute test assertions.
//   3. Report pass or fail with exit code.
import "oodac/emit/wasm/wasm_mem_layout.oo";

fn assert_true(cond: Bool, msg: String) {
    if !cond { println("ASSERTION FAILED: " + msg); }
}

fn assert_eq_int(actual: Int, expected: Int, msg: String) {
    if actual != expected {
        println("ASSERTION FAILED: " + msg + " (expected " + expected.to_string() + ", got " + actual.to_string() + ")");
    }
}

pub fn test_m3_zones() {
    assert_eq_int(wasm_zone_scratch_base(), 0, "scratch base is 0");
    assert_eq_int(wasm_zone_scratch_size(), 1024, "scratch size is 1024");
    assert_eq_int(wasm_zone_rodata_base(), 1024, "rodata base is 1024");
    assert_eq_int(wasm_zone_shadow_stack_size(), 8192, "shadow stack size is 8192");
    assert_eq_int(wasm_zone_heap_ptr_addr(), 16, "heap ptr address is 16");

    let mut mem: WasmMemLayout = wasm_mem_layout_new();
    assert_eq_int((mem).scratch_base, 0, "layout scratch base");
    assert_eq_int((mem).rodata_base, 1024, "layout rodata base");
    assert_eq_int((mem).shadow_stack_base, 1024, "initial shadow stack base");
    assert_eq_int((mem).heap_base, 1024 + 8192, "initial heap base");

    let off1: Int = wasm_rodata_add_string(&mut mem, "Hello openOODA");
    assert_eq_int(off1, 1024, "first string at 1024");
    let off1_lookup: Int = wasm_rodata_lookup_string(&mem, "Hello openOODA");
    assert_eq_int(off1_lookup, 1024, "lookup string 1");

    let off2: Int = wasm_rodata_add_string(&mut mem, "WebAssembly Linear Memory");
    assert_true(off2 > off1, "second string offset > first");
    assert_true(((mem).shadow_stack_base % 8) == 0, "shadow stack base 8-byte aligned");
    assert_eq_int((mem).heap_base, (mem).shadow_stack_base + 8192, "heap base after shadow stack");
}

pub fn build_m3_alloc_module(fs: &FsWriteCap) -> List[Int] {
    let mut b: WasmModuleBuilder = wasm_builder_new();
    let mut mem: WasmMemLayout = wasm_mem_layout_new();
    let _s_off: Int = wasm_rodata_add_string(&mut mem, "alloc_test_string");
    wasm_mem_init(&mut b, 1, 4);
    wasm_mem_emit_data_section(&mut b, &mem);

    // Func 0: alloc(size: i32) -> i32
    let mut p_alloc: List[Int] = list_new();
    p_alloc = list_push(p_alloc, wasm_val_type_i32());
    let mut r_alloc: List[Int] = list_new();
    r_alloc = list_push(r_alloc, wasm_val_type_i32());
    let ty_alloc: Int = wasm_builder_add_type(&mut b, p_alloc, r_alloc);
    let f_alloc: Int = wasm_builder_add_func(&mut b, ty_alloc);

    let mut env_alloc: WasmEnv = wasm_env_new("wasm", wasm_val_type_i32());
    let sz_param: Int = wasm_env_bind_var(&mut env_alloc, "size", wasm_val_type_i32());
    let _bc: List[Int] = wasm_emit_malloc(&mut env_alloc, sz_param);
    wasm_env_emit(&mut env_alloc, op_end());
    wasm_builder_set_code(&mut b, f_alloc, env_alloc.local_types, env_alloc.bytecode);
    wasm_builder_add_export(&mut b, "alloc", wasm_external_func(), f_alloc);

    // Func 1: write32(ptr: i32, val: i32) -> void
    let mut p_w: List[Int] = list_new();
    p_w = list_push(p_w, wasm_val_type_i32()); p_w = list_push(p_w, wasm_val_type_i32());
    let ty_w: Int = wasm_builder_add_type(&mut b, p_w, list_new());
    let f_w: Int = prevailed_func(&mut b, ty_w);
    let mut code_w: List[Int] = list_new();
    code_w = list_push(code_w, op_local_get()); code_w = list_push(code_w, 0);
    code_w = list_push(code_w, op_local_get()); code_w = list_push(code_w, 1);
    code_w = list_push(code_w, op_i32_store()); code_w = list_push(code_w, 2); code_w = list_push(code_w, 0);
    code_w = list_push(code_w, op_end());
    wasm_builder_set_code(&mut b, f_w, list_new(), code_w);
    wasm_builder_add_export(&mut b, "write32", wasm_external_func(), f_w);

    // Func 2: read32(ptr: i32) -> i32
    let mut p_r: List[Int] = list_new(); p_r = list_push(p_r, wasm_val_type_i32());
    let mut r_r: List[Int] = list_new(); r_r = list_push(r_r, wasm_val_type_i32());
    let ty_r: Int = wasm_builder_add_type(&mut b, p_r, r_r);
    let f_r: Int = prevailed_func(&mut b, ty_r);
    let mut code_r: List[Int] = list_new();
    code_r = list_push(code_r, op_local_get()); code_r = list_push(code_r, 0);
    code_r = list_push(code_r, op_i32_load()); code_r = list_push(code_r, 2); code_r = list_push(code_r, 0);
    code_r = list_push(code_r, op_end());
    wasm_builder_set_code(&mut b, f_r, list_new(), code_r);
    wasm_builder_add_export(&mut b, "read32", wasm_external_func(), f_r);

    // Func 3: get_heap_ptr() -> i32
    let mut r_gp: List[Int] = list_new(); r_gp = list_push(r_gp, wasm_val_type_i32());
    let ty_gp: Int = wasm_builder_add_type(&mut b, list_new(), r_gp);
    let f_gp: Int = prevailed_func(&mut b, ty_gp);
    let mut code_gp: List[Int] = list_new();
    code_gp = list_push(code_gp, op_i32_const()); code_gp = list_push(code_gp, wasm_zone_heap_ptr_addr());
    code_gp = list_push(code_gp, op_i32_load()); code_gp = list_push(code_gp, 2); code_gp = list_push(code_gp, 0);
    code_gp = list_push(code_gp, op_end());
    wasm_builder_set_code(&mut b, f_gp, list_new(), code_gp);
    wasm_builder_add_export(&mut b, "get_heap_ptr", wasm_external_func(), f_gp);

    let bin: List[Int] = wasm_builder_emit(b);
    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m3_alloc.wasm", s);
    return bin;
}

fn prevailed_func(b: &mut WasmModuleBuilder, ty: Int) -> Int {
    return wasm_builder_add_func(b, ty);
}

pub fn build_m3_memcpy_memset_module(fs: &FsWriteCap) -> List[Int] {
    let mut b: WasmModuleBuilder = wasm_builder_new();
    wasm_mem_init(&mut b, 1, 2);

    // Func 0: test_memset(dest: i32, val: i32, len: i32)
    let mut p_ms: List[Int] = list_new();
    p_ms = list_push(p_ms, wasm_val_type_i32()); p_ms = list_push(p_ms, wasm_val_type_i32()); p_ms = list_push(p_ms, wasm_val_type_i32());
    let ty_ms: Int = wasm_builder_add_type(&mut b, p_ms, list_new());
    let f_ms: Int = wasm_builder_add_func(&mut b, ty_ms);
    let mut env_ms: WasmEnv = wasm_env_new("wasm", wasm_val_type_i32());
    let d_p: Int = wasm_env_bind_var(&mut env_ms, "dest", wasm_val_type_i32());
    let v_p: Int = wasm_env_bind_var(&mut env_ms, "val", wasm_val_type_i32());
    let l_p: Int = wasm_env_bind_var(&mut env_ms, "len", wasm_val_type_i32());
    let _bc_ms: List[Int] = wasm_emit_memset(&mut env_ms, d_p, v_p, l_p);
    wasm_env_emit(&mut env_ms, op_end());
    wasm_builder_set_code(&mut b, f_ms, env_ms.local_types, env_ms.bytecode);
    wasm_builder_add_export(&mut b, "test_memset", wasm_external_func(), f_ms);

    // Func 1: test_memcpy(dest: i32, src: i32, len: i32)
    let mut p_mc: List[Int] = list_new();
    p_mc = list_push(p_mc, wasm_val_type_i32()); p_mc = list_push(p_mc, wasm_val_type_i32()); p_mc = list_push(p_mc, wasm_val_type_i32());
    let ty_mc: Int = wasm_builder_add_type(&mut b, p_mc, list_new());
    let f_mc: Int = wasm_builder_add_func(&mut b, ty_mc);
    let mut env_mc: WasmEnv = wasm_env_new("wasm", wasm_val_type_i32());
    let d_mc: Int = wasm_env_bind_var(&mut env_mc, "dest", wasm_val_type_i32());
    let s_mc: Int = wasm_env_bind_var(&mut env_mc, "src", wasm_val_type_i32());
    let l_mc: Int = wasm_env_bind_var(&mut env_mc, "len", wasm_val_type_i32());
    let _bc_mc: List[Int] = wasm_emit_memcpy(&mut env_mc, d_mc, s_mc, l_mc);
    wasm_env_emit(&mut env_mc, op_end());
    wasm_builder_set_code(&mut b, f_mc, env_mc.local_types, env_mc.bytecode);
    wasm_builder_add_export(&mut b, "test_memcpy", wasm_external_func(), f_mc);

    // Func 2: read_u8(ptr: i32) -> i32
    let mut p_u8: List[Int] = list_new(); p_u8 = list_push(p_u8, wasm_val_type_i32());
    let mut r_u8: List[Int] = list_new(); r_u8 = list_push(r_u8, wasm_val_type_i32());
    let ty_u8: Int = wasm_builder_add_type(&mut b, p_u8, r_u8);
    let f_u8: Int = wasm_builder_add_func(&mut b, ty_u8);
    let mut code_u8: List[Int] = list_new();
    code_u8 = list_push(code_u8, op_local_get()); code_u8 = list_push(code_u8, 0);
    code_u8 = list_push(code_u8, op_i32_load8_u()); code_u8 = list_push(code_u8, 0); code_u8 = list_push(code_u8, 0);
    code_u8 = list_push(code_u8, op_end());
    wasm_builder_set_code(&mut b, f_u8, list_new(), code_u8);
    wasm_builder_add_export(&mut b, "read_u8", wasm_external_func(), f_u8);

    // Func 3: write_u8(ptr: i32, val: i32)
    let mut p_wu8: List[Int] = list_new(); p_wu8 = list_push(p_wu8, wasm_val_type_i32()); p_wu8 = list_push(p_wu8, wasm_val_type_i32());
    let ty_wu8: Int = wasm_builder_add_type(&mut b, p_wu8, list_new());
    let f_wu8: Int = wasm_builder_add_func(&mut b, ty_wu8);
    let mut code_wu8: List[Int] = list_new();
    code_wu8 = list_push(code_wu8, op_local_get()); code_wu8 = list_push(code_wu8, 0);
    code_wu8 = list_push(code_wu8, op_local_get()); code_wu8 = list_push(code_wu8, 1);
    code_wu8 = list_push(code_wu8, op_i32_store8()); code_wu8 = list_push(code_wu8, 0); code_wu8 = list_push(code_wu8, 0);
    code_wu8 = list_push(code_wu8, op_end());
    wasm_builder_set_code(&mut b, f_wu8, list_new(), code_wu8);
    wasm_builder_add_export(&mut b, "write_u8", wasm_external_func(), f_wu8);

    let bin: List[Int] = wasm_builder_emit(b);
    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m3_memcpy_memset.wasm", s);
    return bin;
}

pub fn build_m3_growth_module(fs: &FsWriteCap) -> List[Int] {
    let mut b: WasmModuleBuilder = wasm_builder_new();
    let mem: WasmMemLayout = wasm_mem_layout_new();
    wasm_mem_init(&mut b, 1, 10);
    wasm_mem_emit_data_section(&mut b, &mem);

    // Func 0: alloc_large(size: i32) -> i32
    let mut p_al: List[Int] = list_new(); p_al = list_push(p_al, wasm_val_type_i32());
    let mut r_al: List[Int] = list_new(); r_al = list_push(r_al, wasm_val_type_i32());
    let ty_al: Int = wasm_builder_add_type(&mut b, p_al, r_al);
    let f_al: Int = wasm_builder_add_func(&mut b, ty_al);
    let mut env_al: WasmEnv = wasm_env_new("wasm", wasm_val_type_i32());
    let sz_p: Int = wasm_env_bind_var(&mut env_al, "size", wasm_val_type_i32());
    let _bc_al: List[Int] = wasm_emit_malloc(&mut env_al, sz_p);
    wasm_env_emit(&mut env_al, op_end());
    wasm_builder_set_code(&mut b, f_al, env_al.local_types, env_al.bytecode);
    wasm_builder_add_export(&mut b, "alloc_large", wasm_external_func(), f_al);

    // Func 1: get_mem_size() -> i32 (in pages)
    let mut r_ms: List[Int] = list_new(); r_ms = list_push(r_ms, wasm_val_type_i32());
    let ty_ms: Int = wasm_builder_add_type(&mut b, list_new(), r_ms);
    let f_ms: Int = wasm_builder_add_func(&mut b, ty_ms);
    let mut code_ms: List[Int] = list_new();
    code_ms = list_push(code_ms, op_memory_size()); code_ms = list_push(code_ms, 0);
    code_ms = list_push(code_ms, op_end());
    wasm_builder_set_code(&mut b, f_ms, list_new(), code_ms);
    wasm_builder_add_export(&mut b, "get_mem_size", wasm_external_func(), f_ms);

    let bin: List[Int] = wasm_builder_emit(b);
    let s: String = bytes_to_str(bin);
    let _w: Result[Void, String] = write_file(fs, "/home/jeryd/Projects/openOODA/qa/tests_wasm/tests_m3_growth.wasm", s);
    return bin;
}

pub fn main(fs: &FsWriteCap) {
    println("=================================================");
    println(" Running WebAssembly Milestone 3 Mem Layout Tests");
    println("=================================================");

    test_m3_zones();
    println("  [PASS] 4-Tier Memory Zones Verified");

    let bin_alloc: List[Int] = build_m3_alloc_module(fs);
    assert_true(list_len(bin_alloc) > 0, "alloc wasm emitted");
    println("  [PASS] Alloc Module Emitted");

    let bin_mcm: List[Int] = build_m3_memcpy_memset_module(fs);
    assert_true(list_len(bin_mcm) > 0, "memcpy/memset wasm emitted");
    println("  [PASS] Memcpy/Memset Module Emitted");

    let bin_growth: List[Int] = build_m3_growth_module(fs);
    assert_true(list_len(bin_growth) > 0, "growth wasm emitted");
    println("  [PASS] Memory Growth Module Emitted");

    println("All M3 Memory Layout code generators executed successfully!");
}
