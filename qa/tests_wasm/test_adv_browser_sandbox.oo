// # WebAssembly Adversarial Browser Sandbox & VDOM Stress Test Suite
//
// Logline: Validates zero-ambient-authority browser isolation, patch buffer layout, event dispatch, and host boundary exports.
//
// Setup: Run with ooda/bin/ooda run qa/tests_wasm/test_adv_browser_sandbox.oo.
//
// Beats:
//   1. Verify zero ambient OS imports and strict 2-import host boundary.
//   2. Verify export table integrity (memory, init, on_event, patch accessors).
//   3. Stress test VDOM event demultiplexing and dispatch with boundary IDs.
//   4. Stress test patch buffer generation, multi-patch sequences, and AST compilation.
import "oodac/emit/wasm/wasm_leb128.oo";
import "oodac/emit/wasm/wasm_opcodes.oo";
import "oodac/emit/wasm/wasm_types.oo";
import "oodac/emit/wasm/wasm_binary_builder.oo";
import "oodac/emit/wasm/wasm_target_browser.oo";
import "oodac/ast/ast.oo";

fn assert_true(cond: Bool, msg: String) {
    if !cond { println("FAIL: " + msg); process_exit(1); }
}

fn assert_false(cond: Bool, msg: String) {
    if cond { println("FAIL: " + msg); process_exit(1); }
}

fn assert_eq_int(actual: Int, expected: Int, msg: String) {
    if actual != expected {
        println("FAIL: " + msg + " (exp " + expected.to_string() + ", got " + actual.to_string() + ")");
        process_exit(1);
    }
}

fn assert_eq_str(actual: String, expected: String, msg: String) {
    if actual != expected {
        println("FAIL: " + msg + " (exp '" + expected + "', got '" + actual + "')");
        process_exit(1);
    }
}

pub fn test_browser_zero_ambient_isolation() {
    let mut b: WasmModuleBuilder = wasm_builder_new();
    let target: BrowserTarget = wasm_target_browser_init(&mut b);

    // Assert strictly 2 host imports
    assert_eq_int(list_len(b.import_mods), 2, "exactly 2 host imports");
    assert_eq_int(list_len(b.import_fields), 2, "exactly 2 host fields");
    assert_eq_int(list_len(b.import_kinds), 2, "exactly 2 host kinds");
    assert_eq_int(list_len(b.import_types), 2, "exactly 2 host signatures");

    // Assert import 0 is env.wui_host_patch
    assert_eq_str(list_get(b.import_mods, 0), "env", "import 0 module == env");
    assert_eq_str(list_get(b.import_fields, 0), "wui_host_patch", "import 0 field == wui_host_patch");

    // Assert import 1 is env.wui_host_log
    assert_eq_str(list_get(b.import_mods, 1), "env", "import 1 module == env");
    assert_eq_str(list_get(b.import_fields, 1), "wui_host_log", "import 1 field == wui_host_log");

    // Verify ZERO wasi or ambient OS imports
    let n_imp: Int = list_len(b.import_mods);
    let mut i: Int = 0;
    while i < n_imp {
        let m: String = list_get(b.import_mods, i);
        let f: String = list_get(b.import_fields, i);
        assert_false(m == "wasi_snapshot_preview1", "no wasi_snapshot_preview1");
        assert_false(m == "wasi_unstable", "no wasi_unstable");
        assert_false(f == "fd_write", "no ambient fd_write");
        assert_false(f == "proc_exit", "no ambient proc_exit");
        assert_false(f == "random_get", "no ambient random_get");
        assert_false(f == "clock_time_get", "no ambient clock_time_get");
        i = i + 1;
    }

    // Verify memory bounds
    assert_true(b.has_memory, "memory configured");
    assert_eq_int(b.memory_min, 1, "memory min == 1 page (64KB)");
    assert_eq_int(b.memory_max, 2, "memory max == 2 pages (128KB)");
    assert_eq_int(target.patch_buf_offset, 1024, "patch buffer offset == 1024");
    assert_eq_int(target.patch_buf_size, 4096, "patch buffer size == 4096");
}

pub fn test_browser_export_boundary() {
    let mut b: WasmModuleBuilder = wasm_builder_new();
    let mut target: BrowserTarget = wasm_target_browser_init(&mut b);

    wasm_browser_emit_wui_init(&mut b, &mut target, -1);
    wasm_browser_emit_wui_on_event(&mut b, &mut target, -1);
    wasm_browser_emit_patch_accessors(&mut b, &target);

    // Exports must be: memory, wui_init, wui_on_event, wui_get_patch_ptr, wui_get_patch_len
    assert_eq_int(list_len(b.export_names), 5, "5 exported symbols");
    assert_eq_str(list_get(b.export_names, 0), "memory", "export 0 == memory");
    assert_eq_str(list_get(b.export_names, 1), "wui_init", "export 1 == wui_init");
    assert_eq_str(list_get(b.export_names, 2), "wui_on_event", "export 2 == wui_on_event");
    assert_eq_str(list_get(b.export_names, 3), "wui_get_patch_ptr", "export 3 == wui_get_patch_ptr");
    assert_eq_str(list_get(b.export_names, 4), "wui_get_patch_len", "export 4 == wui_get_patch_len");

    let bin: List[Int] = wasm_builder_emit(b);
    assert_true(list_len(bin) > 50, "emitted binary non-trivial length");
    // Verify magic header
    assert_eq_int(list_get(bin, 0), 0, "magic 0");
    assert_eq_int(list_get(bin, 1), 97, "magic a");
    assert_eq_int(list_get(bin, 2), 115, "magic s");
    assert_eq_int(list_get(bin, 3), 109, "magic m");
    assert_eq_int(list_get(bin, 4), 1, "version 1");
}

pub fn test_vdom_event_and_patch_stress() {
    // Test event constants
    assert_eq_int(wui_event_click(), 1, "click == 1");
    assert_eq_int(wui_event_input(), 2, "input == 2");
    assert_eq_int(wui_event_keydown(), 3, "keydown == 3");
    assert_eq_int(wui_event_resize(), 4, "resize == 4");
    assert_eq_int(wui_event_custom(), 5, "custom == 5");

    // Test patch constants
    assert_eq_int(wasm_patch_type_replace(), 1, "replace == 1");
    assert_eq_int(wasm_patch_type_update_props(), 2, "update_props == 2");
    assert_eq_int(wasm_patch_type_append_child(), 3, "append_child == 3");
    assert_eq_int(wasm_patch_type_remove_child(), 4, "remove_child == 4");
    assert_eq_int(wasm_patch_type_set_text(), 5, "set_text == 5");

    let mut b: WasmModuleBuilder = wasm_builder_new();
    let mut target: BrowserTarget = wasm_target_browser_init(&mut b);

    // Construct multi-patch sequence:
    // Patch 1: Replace root (type=1, target=0)
    // Patch 2: Append child (type=3, target=0, tag="div")
    // Patch 3: Set text (type=5, target=1, text="Hello Sandbox")
    let mut patch_seq: List[Int] = list_new();
    patch_seq = list_push(patch_seq, wasm_patch_type_replace());
    patch_seq = list_push(patch_seq, 0); // target root
    patch_seq = list_push(patch_seq, wasm_patch_type_append_child());
    patch_seq = list_push(patch_seq, 0); // target root
    patch_seq = list_push(patch_seq, 3); // tag len
    patch_seq = list_push(patch_seq, 100); patch_seq = list_push(patch_seq, 105); patch_seq = list_push(patch_seq, 118); // "div"
    patch_seq = list_push(patch_seq, wasm_patch_type_set_text());
    patch_seq = list_push(patch_seq, 1); // child id
    patch_seq = list_push(patch_seq, 13); // text len
    let mut k: Int = 0;
    while k < 13 {
        patch_seq = list_push(patch_seq, 65 + k);
        k = k + 1;
    }

    wasm_browser_emit_patch_buffer(&mut b, target.patch_buf_offset, patch_seq);
    wasm_browser_emit_wui_init(&mut b, &mut target, -1);
    wasm_browser_emit_wui_on_event(&mut b, &mut target, -1);
    wasm_browser_emit_patch_accessors(&mut b, &target);

    let bin: List[Int] = wasm_builder_emit(b);
    assert_true(list_len(bin) > 80, "multi-patch binary emitted > 80 bytes");
}

pub fn test_browser_ast_compilation() {
    // AST component with custom event handler:
    // fn wui_on_event(ev_type: Int, target_id: Int, val: Int) -> Int {
    //     if ev_type == 1 { return target_id + val; }
    //     return -1;
    // }
    let cond: String = mk_ebinop("==", mk_evar("ev_type"), mk_eint("1"));
    let ret_val: String = mk_sreturn(mk_ebinop("+", mk_evar("target_id"), mk_evar("val")));
    let if_stmt: String = mk_eif(cond, mk_block(ret_val, mk_sempty()), "");
    let def_ret: String = mk_sreturn(mk_eint("-1"));
    let body: String = mk_block(if_stmt + "," + def_ret, mk_sempty());

    let mut params: String = mk_param("ev_type", mk_ty_int());
    params = params + "," + mk_param("target_id", mk_ty_int());
    params = params + "," + mk_param("val", mk_ty_int());

    let fn_node: String = mk_fn("wui_on_event", params, mk_ty_int(), "", body);
    let file_node: String = mk_file(fn_node);

    let bin: List[Int] = wasm_compile_browser_module(file_node, wasm_val_type_i32());
    assert_true(list_len(bin) > 50, "compiled browser AST module length > 50");
}

pub fn main() {
    println("=========================================================");
    println(" Running Adversarial Browser Sandbox & VDOM Stress Tests");
    println("=========================================================");
    test_browser_zero_ambient_isolation();
    test_browser_export_boundary();
    test_vdom_event_and_patch_stress();
    test_browser_ast_compilation();
    println("All Adversarial Browser Sandbox & VDOM tests PASSED!");
}
