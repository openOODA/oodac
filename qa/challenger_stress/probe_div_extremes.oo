// # Challenger Stress Probe 2: Division and Modulo Extremes
//
// Logline: Adversarially validates signed integer division/modulo edge cases without CPU traps.
//
// Setup: Tests INT_MIN / -1, INT_MIN % -1, INT_MIN / 1, INT_MIN % 1, 0 / -1, INT_MAX / -1.
//
// Beats:
//   1. Test constant-literal and runtime-variable division extremes.
//   2. Validate hardware trap (#DE) prevention on INT_MIN / -1 and INT_MIN % -1.
//   3. Verify boundary conditions: INT_MAX, 0, 1, -1.
//   4. Verify exact two's complement results.

fn runtime_div(num: Int, den: Int) -> Int {
    return num / den;
}

fn runtime_mod(num: Int, den: Int) -> Int {
    return num % den;
}

pub fn main() {
    let mut errs: Int = 0;

    let min_i64: Int = 0 - 9223372036854775807 - 1;
    let max_i64: Int = 9223372036854775807;

    // 1. INT_MIN / -1: Must not cause SIGFPE/CPU trap. Returns INT_MIN in two's complement wrapping.
    let d_min_m1: Int = min_i64 / -1;
    let d_min_m1_rt: Int = runtime_div(min_i64, -1);
    if d_min_m1 != min_i64 || d_min_m1_rt != min_i64 {
        println("FAIL: INT_MIN / -1");
        errs = errs + 1;
    }

    // 2. INT_MIN % -1: Must not cause SIGFPE. Evaluates to 0.
    let m_min_m1: Int = min_i64 % -1;
    let m_min_m1_rt: Int = runtime_mod(min_i64, -1);
    if m_min_m1 != 0 || m_min_m1_rt != 0 {
        println("FAIL: INT_MIN % -1");
        errs = errs + 1;
    }

    // 3. INT_MIN / 1: Evaluates to INT_MIN.
    let d_min_1: Int = min_i64 / 1;
    let d_min_1_rt: Int = runtime_div(min_i64, 1);
    if d_min_1 != min_i64 || d_min_1_rt != min_i64 {
        println("FAIL: INT_MIN / 1");
        errs = errs + 1;
    }

    // 4. INT_MIN % 1: Evaluates to 0.
    let m_min_1: Int = min_i64 % 1;
    let m_min_1_rt: Int = runtime_mod(min_i64, 1);
    if m_min_1 != 0 || m_min_1_rt != 0 {
        println("FAIL: INT_MIN % 1");
        errs = errs + 1;
    }

    // 5. 0 / -1: Evaluates to 0.
    let d_0_m1: Int = 0 / -1;
    let d_0_m1_rt: Int = runtime_div(0, -1);
    if d_0_m1 != 0 || d_0_m1_rt != 0 {
        println("FAIL: 0 / -1");
        errs = errs + 1;
    }

    // 6. 0 % -1: Evaluates to 0.
    let m_0_m1: Int = 0 % -1;
    let m_0_m1_rt: Int = runtime_mod(0, -1);
    if m_0_m1 != 0 || m_0_m1_rt != 0 {
        println("FAIL: 0 % -1");
        errs = errs + 1;
    }

    // 7. INT_MAX / -1: Evaluates to -INT_MAX.
    let d_max_m1: Int = max_i64 / -1;
    let d_max_m1_rt: Int = runtime_div(max_i64, -1);
    let neg_max: Int = 0 - max_i64;
    if d_max_m1 != neg_max || d_max_m1_rt != neg_max {
        println("FAIL: INT_MAX / -1");
        errs = errs + 1;
    }

    // 8. INT_MAX % -1: Evaluates to 0.
    let m_max_m1: Int = max_i64 % -1;
    let m_max_m1_rt: Int = runtime_mod(max_i64, -1);
    if m_max_m1 != 0 || m_max_m1_rt != 0 {
        println("FAIL: INT_MAX % -1");
        errs = errs + 1;
    }

    // 9. INT_MIN / INT_MIN: Evaluates to 1.
    let d_min_min: Int = min_i64 / min_i64;
    let d_min_min_rt: Int = runtime_div(min_i64, min_i64);
    if d_min_min != 1 || d_min_min_rt != 1 {
        println("FAIL: INT_MIN / INT_MIN");
        errs = errs + 1;
    }

    // 10. INT_MIN % INT_MIN: Evaluates to 0.
    let m_min_min: Int = min_i64 % min_i64;
    let m_min_min_rt: Int = runtime_mod(min_i64, min_i64);
    if m_min_min != 0 || m_min_min_rt != 0 {
        println("FAIL: INT_MIN % INT_MIN");
        errs = errs + 1;
    }

    // 11. INT_MAX / INT_MAX: Evaluates to 1.
    let d_max_max: Int = max_i64 / max_i64;
    let d_max_max_rt: Int = runtime_div(max_i64, max_i64);
    if d_max_max != 1 || d_max_max_rt != 1 {
        println("FAIL: INT_MAX / INT_MAX");
        errs = errs + 1;
    }

    // 12. INT_MAX % INT_MAX: Evaluates to 0.
    let m_max_max: Int = max_i64 % max_i64;
    let m_max_max_rt: Int = runtime_mod(max_i64, max_i64);
    if m_max_max != 0 || m_max_max_rt != 0 {
        println("FAIL: INT_MAX % INT_MAX");
        errs = errs + 1;
    }

    // 13. INT_MIN / INT_MAX: -9223372036854775808 / 9223372036854775807 = -1.
    let d_min_max: Int = min_i64 / max_i64;
    let d_min_max_rt: Int = runtime_div(min_i64, max_i64);
    if d_min_max != -1 || d_min_max_rt != -1 {
        println("FAIL: INT_MIN / INT_MAX");
        errs = errs + 1;
    }

    // 14. INT_MIN % INT_MAX: -9223372036854775808 % 9223372036854775807 = -1.
    let m_min_max: Int = min_i64 % max_i64;
    let m_min_max_rt: Int = runtime_mod(min_i64, max_i64);
    if m_min_max != -1 || m_min_max_rt != -1 {
        println("FAIL: INT_MIN % INT_MAX");
        errs = errs + 1;
    }

    if errs == 0 {
        println("PROBE_DIV_EXTREMES: PASS");
    } else {
        println("PROBE_DIV_EXTREMES: FAIL");
        process_exit(1);
    }
}
