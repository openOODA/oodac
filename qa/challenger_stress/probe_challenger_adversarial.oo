// # Probe: Challenger Adversarial Stress Testing
//
// Logline: Adversarially tests boundary conditions, invalid contracts, and unsound assign extractions.
//
// Setup: Pure compute. Tokenizes synthetic ASTs and tests smt_vc_gen and smt_prover_lia.
//
// Beats:
//   1. Subtraction from constant: return 100 - x with requires x >= 1000, ensures result >= 100.
//   2. Multiplication after int: return 10 * 0 with ensures result >= 10.
//   3. Negative bounds valid and invalid contracts.
//   4. Unprovable postcondition gap and struct access fallback.
// RULES.oot 1.7: Under 256 lines.

import "check/smt_contract_parse.oo";
import "check/smt_wp_calc.oo";
import "check/smt_prover_lia.oo";
import "check/smt_vc_gen.oo";

fn mk_tok(k: String, l: Int, c: Int, t: String) -> String {
    return k + "\t" + l.to_string() + "\t" + c.to_string() + "\t" + t;
}

pub fn main() {
    // Beat 1: return 100 - x
    let mut t1: List[String] = list_new();
    t1 = list_push(t1, mk_tok("KW_FN", 1, 1, "fn"));
    t1 = list_push(t1, mk_tok("IDENT", 1, 4, "sub_from_c"));
    t1 = list_push(t1, mk_tok("LPAREN", 1, 14, "("));
    t1 = list_push(t1, mk_tok("IDENT", 1, 15, "x"));
    t1 = list_push(t1, mk_tok("COLON", 1, 16, ":"));
    t1 = list_push(t1, mk_tok("IDENT", 1, 18, "Int"));
    t1 = list_push(t1, mk_tok("RPAREN", 1, 21, ")"));
    t1 = list_push(t1, mk_tok("ARROW", 1, 23, "->"));
    t1 = list_push(t1, mk_tok("IDENT", 1, 26, "Int"));
    t1 = list_push(t1, mk_tok("KW_REQUIRES", 2, 1, "requires"));
    t1 = list_push(t1, mk_tok("IDENT", 2, 10, "x"));
    t1 = list_push(t1, mk_tok("GTE", 2, 12, ">="));
    t1 = list_push(t1, mk_tok("INT", 2, 15, "1000"));
    t1 = list_push(t1, mk_tok("KW_ENSURES", 3, 1, "ensures"));
    t1 = list_push(t1, mk_tok("IDENT", 3, 9, "result"));
    t1 = list_push(t1, mk_tok("GTE", 3, 16, ">="));
    t1 = list_push(t1, mk_tok("INT", 3, 19, "100"));
    t1 = list_push(t1, mk_tok("LBRACE", 4, 1, "{"));
    t1 = list_push(t1, mk_tok("KW_RETURN", 5, 5, "return"));
    t1 = list_push(t1, mk_tok("INT", 5, 12, "100"));
    t1 = list_push(t1, mk_tok("MINUS", 5, 16, "-"));
    t1 = list_push(t1, mk_tok("IDENT", 5, 18, "x"));
    t1 = list_push(t1, mk_tok("SEMI", 5, 19, ";"));
    t1 = list_push(t1, mk_tok("RBRACE", 6, 1, "}"));

    let v1: List[String] = smt_vc_prove_function_clauses(t1, 0, "sub_from_c");
    let mut i: Int = 0;
    while i < list_len(v1) {
        println("BEAT1: " + list_get(v1, i));
        i = i + 1;
    }

    // Beat 2: return 10 * 0
    let mut t2: List[String] = list_new();
    t2 = list_push(t2, mk_tok("KW_FN", 1, 1, "fn"));
    t2 = list_push(t2, mk_tok("IDENT", 1, 4, "int_mult"));
    t2 = list_push(t2, mk_tok("LPAREN", 1, 12, "("));
    t2 = list_push(t2, mk_tok("IDENT", 1, 13, "x"));
    t2 = list_push(t2, mk_tok("COLON", 1, 14, ":"));
    t2 = list_push(t2, mk_tok("IDENT", 1, 16, "Int"));
    t2 = list_push(t2, mk_tok("RPAREN", 1, 19, ")"));
    t2 = list_push(t2, mk_tok("ARROW", 1, 21, "->"));
    t2 = list_push(t2, mk_tok("IDENT", 1, 24, "Int"));
    t2 = list_push(t2, mk_tok("KW_REQUIRES", 2, 1, "requires"));
    t2 = list_push(t2, mk_tok("IDENT", 2, 10, "x"));
    t2 = list_push(t2, mk_tok("GTE", 2, 12, ">="));
    t2 = list_push(t2, mk_tok("INT", 2, 15, "0"));
    t2 = list_push(t2, mk_tok("KW_ENSURES", 3, 1, "ensures"));
    t2 = list_push(t2, mk_tok("IDENT", 3, 9, "result"));
    t2 = list_push(t2, mk_tok("GTE", 3, 16, ">="));
    t2 = list_push(t2, mk_tok("INT", 3, 19, "10"));
    t2 = list_push(t2, mk_tok("LBRACE", 4, 1, "{"));
    t2 = list_push(t2, mk_tok("KW_RETURN", 5, 5, "return"));
    t2 = list_push(t2, mk_tok("INT", 5, 12, "10"));
    t2 = list_push(t2, mk_tok("STAR", 5, 15, "*"));
    t2 = list_push(t2, mk_tok("INT", 5, 17, "0"));
    t2 = list_push(t2, mk_tok("SEMI", 5, 18, ";"));
    t2 = list_push(t2, mk_tok("RBRACE", 6, 1, "}"));

    let v2: List[String] = smt_vc_prove_function_clauses(t2, 0, "int_mult");
    i = 0;
    while i < list_len(v2) {
        println("BEAT2: " + list_get(v2, i));
        i = i + 1;
    }

    // Beat 3: Negative bounds valid and invalid
    let mut t3_val: List[String] = list_new();
    t3_val = list_push(t3_val, mk_tok("KW_FN", 1, 1, "fn"));
    t3_val = list_push(t3_val, mk_tok("IDENT", 1, 4, "neg_val"));
    t3_val = list_push(t3_val, mk_tok("LPAREN", 1, 11, "("));
    t3_val = list_push(t3_val, mk_tok("IDENT", 1, 12, "x"));
    t3_val = list_push(t3_val, mk_tok("COLON", 1, 13, ":"));
    t3_val = list_push(t3_val, mk_tok("IDENT", 1, 15, "Int"));
    t3_val = list_push(t3_val, mk_tok("RPAREN", 1, 18, ")"));
    t3_val = list_push(t3_val, mk_tok("ARROW", 1, 20, "->"));
    t3_val = list_push(t3_val, mk_tok("IDENT", 1, 23, "Int"));
    t3_val = list_push(t3_val, mk_tok("KW_REQUIRES", 2, 1, "requires"));
    t3_val = list_push(t3_val, mk_tok("IDENT", 2, 10, "x"));
    t3_val = list_push(t3_val, mk_tok("GTE", 2, 12, ">="));
    t3_val = list_push(t3_val, mk_tok("MINUS", 2, 15, "-"));
    t3_val = list_push(t3_val, mk_tok("INT", 2, 16, "50"));
    t3_val = list_push(t3_val, mk_tok("KW_ENSURES", 3, 1, "ensures"));
    t3_val = list_push(t3_val, mk_tok("IDENT", 3, 9, "result"));
    t3_val = list_push(t3_val, mk_tok("GTE", 3, 16, ">="));
    t3_val = list_push(t3_val, mk_tok("MINUS", 3, 19, "-"));
    t3_val = list_push(t3_val, mk_tok("INT", 3, 20, "40"));
    t3_val = list_push(t3_val, mk_tok("LBRACE", 4, 1, "{"));
    t3_val = list_push(t3_val, mk_tok("KW_RETURN", 5, 5, "return"));
    t3_val = list_push(t3_val, mk_tok("IDENT", 5, 12, "x"));
    t3_val = list_push(t3_val, mk_tok("PLUS", 5, 14, "+"));
    t3_val = list_push(t3_val, mk_tok("INT", 5, 16, "10"));
    t3_val = list_push(t3_val, mk_tok("SEMI", 5, 18, ";"));
    t3_val = list_push(t3_val, mk_tok("RBRACE", 6, 1, "}"));

    let v3: List[String] = smt_vc_prove_function_clauses(t3_val, 0, "neg_val");
    i = 0;
    while i < list_len(v3) {
        println("BEAT3: " + list_get(v3, i));
        i = i + 1;
    }

    // Beat 4: Struct Access Fallback
    let mut t4: List[String] = list_new();
    t4 = list_push(t4, mk_tok("KW_FN", 1, 1, "fn"));
    t4 = list_push(t4, mk_tok("IDENT", 1, 4, "struct_fn"));
    t4 = list_push(t4, mk_tok("LPAREN", 1, 13, "("));
    t4 = list_push(t4, mk_tok("IDENT", 1, 14, "s"));
    t4 = list_push(t4, mk_tok("COLON", 1, 15, ":"));
    t4 = list_push(t4, mk_tok("IDENT", 1, 17, "State"));
    t4 = list_push(t4, mk_tok("RPAREN", 1, 22, ")"));
    t4 = list_push(t4, mk_tok("ARROW", 1, 24, "->"));
    t4 = list_push(t4, mk_tok("IDENT", 1, 27, "Int"));
    t4 = list_push(t4, mk_tok("KW_REQUIRES", 2, 1, "requires"));
    t4 = list_push(t4, mk_tok("IDENT", 2, 10, "s"));
    t4 = list_push(t4, mk_tok("DOT", 2, 11, "."));
    t4 = list_push(t4, mk_tok("IDENT", 2, 12, "x"));
    t4 = list_push(t4, mk_tok("GTE", 2, 14, ">="));
    t4 = list_push(t4, mk_tok("INT", 2, 17, "0"));
    t4 = list_push(t4, mk_tok("KW_ENSURES", 3, 1, "ensures"));
    t4 = list_push(t4, mk_tok("IDENT", 3, 9, "result"));
    t4 = list_push(t4, mk_tok("GTE", 3, 16, ">="));
    t4 = list_push(t4, mk_tok("INT", 3, 19, "0"));
    t4 = list_push(t4, mk_tok("LBRACE", 4, 1, "{"));
    t4 = list_push(t4, mk_tok("KW_RETURN", 5, 5, "return"));
    t4 = list_push(t4, mk_tok("IDENT", 5, 12, "s"));
    t4 = list_push(t4, mk_tok("DOT", 5, 13, "."));
    t4 = list_push(t4, mk_tok("IDENT", 5, 14, "x"));
    t4 = list_push(t4, mk_tok("SEMI", 5, 15, ";"));
    t4 = list_push(t4, mk_tok("RBRACE", 6, 1, "}"));

    let v4: List[String] = smt_vc_prove_function_clauses(t4, 0, "struct_fn");
    i = 0;
    while i < list_len(v4) {
        println("BEAT4: " + list_get(v4, i));
        i = i + 1;
    }
}
