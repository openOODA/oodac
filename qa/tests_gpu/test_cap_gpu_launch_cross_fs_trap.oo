// # Test GPU Launch Cross Fs Trap
//
// Logline: Asserts fail-closed static rejection when gpu_launch is passed &FsCap instead of &GpuCap.
//
// Setup: Sealed GPU builtin gpu_launch rejects wrong capability kind.
//
// Beats:
//   1. Declare function taking fs: &FsCap.
//   2. Attempt invocation of gpu_launch with fs token.
//   3. Assert static capability violation rejection.

pub fn run_fs_mismatched_launch(fs: &FsCap) {
    let res = gpu_launch(fs, "k_vec_add", 1, 64);
    match res {
        Ok(v) => {},
        Err(e) => {}
    }
}

