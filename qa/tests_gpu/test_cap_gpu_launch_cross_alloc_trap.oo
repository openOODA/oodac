// # Test GPU Launch Cross Alloc Trap
//
// Logline: Asserts fail-closed static rejection when gpu_launch is passed &AllocCap instead of &GpuCap.
//
// Setup: Sealed GPU builtin gpu_launch rejects wrong capability kind.
//
// Beats:
//   1. Declare function taking alloc: &AllocCap.
//   2. Attempt invocation of gpu_launch with alloc token.
//   3. Assert static capability violation rejection.

pub fn run_mismatched_launch(alloc: &AllocCap) {
    let res = gpu_launch(alloc, "k_vec_add", 1, 64);
    match res {
        Ok(v) => {},
        Err(e) => {}
    }
}

pub fn main() {
}
