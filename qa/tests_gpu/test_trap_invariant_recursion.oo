// # Test Device Invariant Recursion Trap
//
// Logline: Asserts fail-closed compile-time rejection of recursion inside @gpu device kernels.
//
// Setup: Device kernel attempts direct or indirect self-recursion violating SIMT execution rules.
//
// Beats:
//   1. Define @gpu annotated device function with recursive invocation.
//   2. Parse and lower AST kernel graph.
//   3. Assert compiler exits non-zero with recursion forbidden diagnostic.

@gpu
pub fn k_recursive_fib(n: Int) -> Int {
    if n <= 1 {
        return n;
    }
    return k_recursive_fib(n - 1) + k_recursive_fib(n - 2);
}

pub fn main() {
}
