// # Test GPU Copy H2D Capability Trap
//
// Logline: Asserts fail-closed static rejection when gpu_copy_h2d is called without &GpuCap.
//
// Setup: Sealed GPU builtin gpu_copy_h2d requires explicit &GpuCap token parameter.
//
// Beats:
//   1. Define unprivileged function attempting ambient gpu_copy_h2d.
//   2. Static typechecker triggers security capability violation.
//   3. Assert default-deny boundary enforcement.

pub fn unprivileged_gpu_copy_h2d() {
    let dev_ptr = 0;
    let host_ptr = 0;
    gpu_copy_h2d(dev_ptr, host_ptr, 1024);
}

pub fn main() {
    unprivileged_gpu_copy_h2d();
}
