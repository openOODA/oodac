// # GPU Runner Helpers
//
// Logline: Pure functions for the GPU test runner: output-scan and summary rendering.
//
// Setup: No caps; pure functions. Caller is the GPU main runner and its test suite.
//
// Beats:
//   1. gpu_output_passes: returns false iff output contains a FAIL marker or is empty.
//   2. gpu_summary: render the summary block with passed/failed/total counts.

pub fn gpu_output_passes(output: String) -> Bool {
    if str_contains(output, "FAIL") { return false; }
    if chars_len(output) == 0 { return false; }
    return true;
}

pub fn gpu_summary(passed: Int, failed: Int) -> String {
    let mut s: String = "  Total Passed Suites: " + passed.to_string() + "\n";
    s = s + "  Total Failed Suites: " + failed.to_string() + "\n";
    s = s + "  Total Executed:      " + (passed + failed).to_string() + "\n";
    return s;
}
