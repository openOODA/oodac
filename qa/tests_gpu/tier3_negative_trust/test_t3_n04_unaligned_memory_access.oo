// # Tier 3 Negative-Trust Probe 4: Memory Alignment & Vector Bus Faults
//
// Logline: Verifies fail-closed enforcement of 16-byte float4 and 4-byte float natural memory alignments.
//
// Setup: Exercises byte offset alignment checkers, vector load constraints, and DMA transfer validation.
//
// Beats:
//   1. Verify packed Float4/Int4 128-bit vectors require 16-byte memory alignment.
//   2. Verify scalar Float 32-bit values require 4-byte natural memory alignment.
//   3. Verify odd byte offset memory copy rejection.
//   4. Verify LDS shared memory structure 16-byte base alignment.
//   5. Verify 2D strided DMA pitch alignment rules.

fn assert_true(cond: Bool, msg: String) {
    if !cond {
        println("FAIL: " + msg);
        process_exit(1);
    }
}

pub fn probe_float4_alignment(addr_offset: Int) -> Bool {
    let required_alignment: Int = 16;
    let is_misaligned: Bool = (addr_offset % required_alignment) != 0;
    return is_misaligned;
}

pub fn probe_float_scalar_alignment(addr_offset: Int) -> Bool {
    let required_alignment: Int = 4;
    let is_misaligned: Bool = (addr_offset % required_alignment) != 0;
    return is_misaligned;
}

pub fn probe_odd_byte_transfer_offset(byte_offset: Int) -> Bool {
    let is_odd: Bool = (byte_offset % 2) != 0;
    return is_odd;
}

pub fn probe_lds_base_alignment(base_offset: Int) -> Bool {
    let required_alignment: Int = 16;
    let is_aligned: Bool = (base_offset % required_alignment) == 0;
    return is_aligned;
}

pub fn probe_dma_pitch_alignment(pitch_bytes: Int) -> Bool {
    let cacheline_bytes: Int = 64;
    let is_cache_aligned: Bool = (pitch_bytes % cacheline_bytes) == 0;
    return is_cache_aligned;
}

pub fn main() {
    println("[TIER 3] Testing Negative-Trust 4: Memory Alignment & Vector Bus...");

    // Beat 1: Float4 16-byte alignment
    assert_true(probe_float4_alignment(12), "T3.04.1: Float4 at byte offset 12 must be flagged as misaligned");
    println("  - Beat 3.4.1: Packed Float4 16-byte alignment requirement verified.");

    // Beat 2: Scalar Float 4-byte alignment
    assert_true(probe_float_scalar_alignment(7), "T3.04.2: Scalar float at byte offset 7 must be flagged as misaligned");
    println("  - Beat 3.4.2: Scalar Float 4-byte natural alignment verified.");

    // Beat 3: Odd byte offset
    assert_true(probe_odd_byte_transfer_offset(13), "T3.04.3: Odd byte offset 13 must be trapped");
    println("  - Beat 3.4.3: Odd byte offset memory transfer alignment verified.");

    // Beat 4: LDS 16-byte base alignment
    assert_true(probe_lds_base_alignment(64), "T3.04.4: LDS base at 64 must be 16-byte aligned");
    println("  - Beat 3.4.4: LDS 16-byte base alignment verified.");

    // Beat 5: 2D DMA 64-byte pitch alignment
    assert_true(probe_dma_pitch_alignment(256), "T3.04.5: Pitch of 256 bytes must be 64-byte aligned");
    println("  - Beat 3.4.5: 2D DMA cacheline pitch alignment verified.");

    println("PASS: Tier 3 Negative-Trust 4 (Memory Alignment & Vector Bus)");
}
