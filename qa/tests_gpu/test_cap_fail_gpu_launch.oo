// # Test GPU Launch Capability Trap
//
// Logline: Asserts fail-closed static rejection when gpu_launch is called without &GpuCap.
//
// Setup: Sealed GPU builtin gpu_launch requires explicit &GpuCap token parameter.
//
// Beats:
//   1. Define unprivileged function attempting ambient gpu_launch.
//   2. Static typechecker triggers security capability violation.
//   3. Assert default-deny boundary enforcement.

pub fn unprivileged_gpu_launch() {
    let handle = 0;
    gpu_launch(handle, "vector_add", 1, 64);
}

pub fn main() {
    unprivileged_gpu_launch();
}
