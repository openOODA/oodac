// # Test Unknown Kernel Launch Trap
//
// Logline: Shipped gpu_launch rejects unknown and default names instead of silent vec-add MATCH.
//
// Setup: Product builtin gpu_launch(gpu, shader) lowers to oo_gpu_launch. HIP names use hip: prefix.
//
// Beats:
//   1. gpu_launch hip:k_not_a_real_kernel is Err without MATCH.
//   2. gpu_launch hip:k_main is Err without MATCH.
//   3. gpu_launch k_not_a_real_kernel without hip: is Err without MATCH.

fn assert_true(cond: Bool, msg: String) {
    if !cond {
        println("FAIL: " + msg);
        process_exit(1);
    }
}

fn payload_has_match(s: String) -> Bool {
    return str_index_of(s, "MATCH") >= 0;
}

fn assert_launch_err(gpu: &GpuCap, shader: String, tag: String) {
    let res: Result[String, String] = gpu_launch(gpu, shader);
    match res {
        Ok(v) => {
            println("FAIL: " + tag + " returned Ok: " + v);
            process_exit(1);
        }
        Err(e) => {
            assert_true(!payload_has_match(e), tag + " Err must not contain MATCH: " + e);
            println("  - " + tag + " trapped: " + e);
        }
    }
}

pub fn main(gpu: &GpuCap) {
    println("[HIP.07] Testing unknown kernel launch trap...");
    assert_launch_err(gpu, "hip:k_not_a_real_kernel", "hip:k_not_a_real_kernel");
    assert_launch_err(gpu, "hip:k_main", "hip:k_main");
    assert_launch_err(gpu, "k_not_a_real_kernel", "bare unknown name");
    println("PASS: unknown kernel name is rejected (not Ok, not silent vec-add)");
}
