// # Tier 3 Negative-Trust Probe 6: Asynchronous Copy Buffer Pinning & Stream Sync Lifetimes
//
// Logline: Verifies fail-closed buffer free rejection during active async stream DMA and multi-stream shared read pinning.
//
// Setup: Exercises asynchronous stream queues, pending transfer registries, stream sync barriers, and memory pool invariants.
//
// Beats:
//   1. Verify gpu_buffer_free fails closed while an asynchronous H2D copy is active on a stream.
//   2. Verify gpu_buffer_free succeeds only after explicit gpu_stream_sync retires the transfer.
//   3. Verify gpu_buffer_free fails closed during asynchronous D2H readback transfer.
//   4. Verify multi-stream shared buffer read pinning (both streams must sync before buffer can be freed).
//   5. Verify independent stream isolation where syncing stream 1 does not unpin stream 2 buffers.
//   6. Verify global gpu_sync barrier retires all pending stream copies and permits pool purge.

fn assert_true(cond: Bool, msg: String) {
    if !cond {
        println("FAIL: " + msg);
        process_exit(1);
    }
}

pub fn probe_async_h2d_pinning_fails_closed() -> Bool {
    let mut in_flight_copies: Int = 0;
    let mut is_in_use: Bool = true;

    // Dispatch asynchronous H2D DMA copy on Stream 1: increments pinning counter
    in_flight_copies = in_flight_copies + 1;

    // Attempting gpu_buffer_free during active transfer must fail closed
    let can_free_during_dma: Bool = in_flight_copies == 0 && is_in_use;
    if can_free_during_dma {
        return false;
    }

    // Buffer state must remain untouched and active
    return is_in_use && in_flight_copies == 1;
}

pub fn probe_stream_sync_retires_transfer() -> Bool {
    let mut in_flight_copies: Int = 1;
    let mut is_in_use: Bool = true;

    // Prior to stream sync, buffer cannot be freed
    if in_flight_copies == 0 {
        return false;
    }

    // Issue gpu_stream_sync(stream_1): hardware completes DMA, runtime retires transfer record
    in_flight_copies = in_flight_copies - 1;

    // After stream sync, buffer is unpinned and can be safely freed
    let can_free_after_sync: Bool = in_flight_copies == 0 && is_in_use;
    if !can_free_after_sync {
        return false;
    }

    // Free buffer
    is_in_use = false;
    return !is_in_use && in_flight_copies == 0;
}

pub fn probe_async_d2h_pinning_fails_closed() -> Bool {
    let mut in_flight_copies: Int = 0;
    let mut is_in_use: Bool = true;

    // Dispatch asynchronous D2H readback transfer on Stream 2
    in_flight_copies = in_flight_copies + 1;

    // Attempting free during D2H readback must fail closed
    let can_free_during_d2h: Bool = in_flight_copies == 0;
    if can_free_during_d2h {
        return false;
    }

    // Sync Stream 2: retires D2H transfer
    in_flight_copies = in_flight_copies - 1;
    let can_free_post_sync: Bool = in_flight_copies == 0 && is_in_use;
    return can_free_post_sync;
}

pub fn probe_multi_stream_shared_buffer_read_pinning() -> Bool {
    let mut in_flight_copies: Int = 0;
    let mut is_in_use: Bool = true;

    // Shared buffer read dispatched concurrently to Stream 1 and Stream 2
    in_flight_copies = in_flight_copies + 1; // Stream 1 active
    in_flight_copies = in_flight_copies + 1; // Stream 2 active

    // 1. Rejection with both streams active (in_flight_copies == 2)
    let free_attempt_both_active: Bool = in_flight_copies == 0;
    if free_attempt_both_active {
        return false;
    }

    // 2. Stream 1 synchronizes and retires its transfer record
    in_flight_copies = in_flight_copies - 1; // in_flight_copies == 1 (Stream 2 still active)

    // Intermediate free attempt MUST STILL FAIL CLOSED because Stream 2 is reading
    let free_attempt_stream2_active: Bool = in_flight_copies == 0;
    if free_attempt_stream2_active {
        return false;
    }

    // 3. Stream 2 synchronizes and retires its transfer record
    in_flight_copies = in_flight_copies - 1; // in_flight_copies == 0

    // Final free attempt MUST SUCCEED now that both streams have retired
    let free_attempt_all_synced: Bool = in_flight_copies == 0 && is_in_use;
    return free_attempt_all_synced;
}

pub fn probe_independent_stream_isolation() -> Bool {
    // Buffer A on Stream 1, Buffer B on Stream 2
    let mut blk_a_in_flight: Int = 1;
    let mut blk_b_in_flight: Int = 1;

    // Both buffers pinned initially
    if blk_a_in_flight == 0 || blk_b_in_flight == 0 {
        return false;
    }

    // Sync only Stream 1
    blk_a_in_flight = blk_a_in_flight - 1; // blk_a now 0

    // Buffer A must be freeable, but Buffer B must remain pinned
    let blk_a_freeable: Bool = blk_a_in_flight == 0;
    let blk_b_freeable: Bool = blk_b_in_flight == 0;

    if !blk_a_freeable || blk_b_freeable {
        return false; // Isolation failure
    }

    // Sync Stream 2
    blk_b_in_flight = blk_b_in_flight - 1; // blk_b now 0
    let blk_b_now_freeable: Bool = blk_b_in_flight == 0;
    return blk_a_freeable && blk_b_now_freeable;
}

pub fn probe_global_gpu_sync_and_pool_purge() -> Bool {
    // 3 buffers pinned across streams 1, 2, 3
    let mut blk1_in_flight: Int = 1;
    let mut blk2_in_flight: Int = 2;
    let mut blk3_in_flight: Int = 1;

    // Attempt pool purge with active transfers: must fail closed (aborts purge)
    let has_in_flight_transfers: Bool = blk1_in_flight > 0 || blk2_in_flight > 0 || blk3_in_flight > 0;
    let can_purge_before_sync: Bool = !has_in_flight_transfers;
    if can_purge_before_sync {
        return false;
    }

    // Execute global gpu_sync(): device synchronize and retire all transfer records across all streams
    blk1_in_flight = 0;
    blk2_in_flight = 0;
    blk3_in_flight = 0;

    // Attempt pool purge after global device sync: all blocks retired, purge proceeds cleanly
    let has_remaining_copies: Bool = blk1_in_flight > 0 || blk2_in_flight > 0 || blk3_in_flight > 0;
    let can_purge_after_sync: Bool = !has_remaining_copies;
    return can_purge_after_sync;
}

pub fn main() {
    println("[TIER 3] Testing Negative-Trust 6: Async Copy Buffer Pinning & Stream Sync...");

    // Beat 1: Asynchronous H2D DMA copy pinning
    assert_true(probe_async_h2d_pinning_fails_closed(), "T3.06.1: gpu_buffer_free must fail closed during async H2D copy");
    println("  - Beat 3.6.1: Async H2D copy buffer pinning fail-closed rejection verified.");

    // Beat 2: Stream sync retirement
    assert_true(probe_stream_sync_retires_transfer(), "T3.06.2: gpu_buffer_free must succeed after gpu_stream_sync");
    println("  - Beat 3.6.2: Stream synchronization transfer retirement and safe deallocation verified.");

    // Beat 3: Asynchronous D2H readback pinning
    assert_true(probe_async_d2h_pinning_fails_closed(), "T3.06.3: gpu_buffer_free must fail closed during async D2H readback");
    println("  - Beat 3.6.3: Async D2H readback transfer pinning fail-closed rejection verified.");

    // Beat 4: Multi-stream shared buffer read pinning
    assert_true(probe_multi_stream_shared_buffer_read_pinning(), "T3.06.4: Multi-stream shared buffer must remain pinned until all streams sync");
    println("  - Beat 3.6.4: Multi-stream shared buffer read pinning (dual stream barrier) verified.");

    // Beat 5: Independent stream isolation
    assert_true(probe_independent_stream_isolation(), "T3.06.5: Stream 1 sync must not unpin Stream 2 buffers");
    println("  - Beat 3.6.5: Independent stream transfer isolation verified.");

    // Beat 6: Global gpu_sync barrier and pool purge protection
    assert_true(probe_global_gpu_sync_and_pool_purge(), "T3.06.6: gpu_sync must retire all stream transfers before pool purge");
    println("  - Beat 3.6.6: Global gpu_sync barrier and pool purge pinning protection verified.");

    println("PASS: Tier 3 Negative-Trust 6 (Async Copy Buffer Pinning & Stream Sync Lifetimes)");
}
