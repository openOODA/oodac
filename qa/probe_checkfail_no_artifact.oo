// # Probe: check-fail writes no artifact; emit-c --artifact refuses
//
// Logline: requires 1 == 0 leaves no art_<sha>.art. emit-c --artifact of that path is ERR.
//
// Setup: ProcessCap + EnvCap + FsReadCap. Victim is probe_smt_false.oo.
//
// Beats:
//   1. check of the victim is ERR.
//   2. artifact cache path does not exist.
//   3. emit-c --artifact that path is ERR.

fn art_sha16(path: String, src: String) -> String {
    let digest: String = crypto_sha256_internal(path + "\n" + src);
    if chars_len(digest) >= 16 {
        return str_slice(digest, 0, 16);
    }
    return digest;
}

pub fn main(p: &ProcessCap, env: &EnvCap, fs_r: &FsReadCap) {
    let hr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let host: String = match hr { Ok(s) => s, Err(_) => "" };
    if host == "" {
        println("ERR\tOODA_COMPILER required");
        process_exit(1);
    }
    let srcp: String = "oodac/qa/probe_smt_false.oo";
    let sr: Result[String, String] = read_file(fs_r, srcp);
    if sr.is_err() {
        println("ERR\tunreadable smt false");
        process_exit(1);
    }
    let src: String = match sr { Ok(s) => s, Err(_) => "" };
    let dest: String = ".ooda-cache/ooda-tmp/art_" + art_sha16(srcp, src) + ".art";
    let _: Result[String, String] = sys_exec(p, "rm", "-f", dest);
    let ck: Result[String, String] = sys_exec(p, host, "check", srcp);
    if ck.is_ok() {
        println("ERR\tcheck should fail");
        process_exit(1);
    }
    if path_exists(fs_r, dest) {
        println("ERR\tcheck-fail wrote artifact");
        process_exit(1);
    }
    let em: Result[String, String] = sys_exec(p, host, "emit-c", "--artifact", dest, srcp);
    if em.is_ok() {
        println("ERR\temit-c ran without artifact");
        process_exit(1);
    }
    println("OK");
}
