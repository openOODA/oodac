// # Probe: cli_emit does not import emit/c
//
// Logline: cli_emit.oo has no emit/c import. check of it and emit/llvm/anchor.oo is OK.
//
// Setup: ProcessCap + EnvCap + FsReadCap. Host is OODA_COMPILER.
//
// Beats:
//   1. cli_emit.oo has no import emit/c/anchor.oo.
//   2. check cli_emit.oo is OK.
//   3. check emit/llvm/anchor.oo is OK.

fn resolve_p(fs: &FsReadCap, p: String) -> String {
    if path_exists(fs, p) { return p; }
    if path_exists(fs, "oodac/" + p) { return "oodac/" + p; }
    if chars_len(p) > 6 && str_slice(p, 0, 6) == "oodac/" {
        let sub: String = str_slice(p, 6, chars_len(p));
        if path_exists(fs, sub) { return sub; }
    }
    return p;
}

pub fn main(p: &ProcessCap, env: &EnvCap, fs_r: &FsReadCap) {
    let hr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let host: String = match hr { Ok(s) => s, Err(_) => "" };
    if host == "" {
        println("ERR\tOODA_COMPILER required");
        process_exit(1);
    }
    let p_cli: String = resolve_p(fs_r, "cli/cli_emit.oo");
    let src_r: Result[String, String] = read_file(fs_r, p_cli);
    if src_r.is_err() {
        println("ERR\tunreadable cli_emit.oo");
        process_exit(1);
    }
    let src: String = match src_r { Ok(s) => s, Err(_) => "" };
    if str_index_of(src, "import \"emit/c/anchor.oo\"") >= 0 || str_index_of(src, "import \"emit/c/ANCHOR.oo\"") >= 0 {
        println("ERR\tcli_emit dumps emit/c anchor");
        process_exit(1);
    }
    let ce: Result[String, String] = sys_exec(p, host, "check", p_cli);
    if ce.is_err() {
        println("ERR\tcheck cli_emit.oo");
        process_exit(1);
    }
    let apath: String = resolve_p(fs_r, "emit/llvm/anchor.oo");
    let ae: Result[String, String] = sys_exec(p, host, "check", apath);
    if ae.is_err() {
        println("ERR\tcheck emit/llvm anchor");
        process_exit(1);
    }
    println("OK");
}
