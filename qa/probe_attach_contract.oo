// # Probe: attach-contract docs and residual backend
//
// Logline: Docs name the typed artifact and C as reference. CLI emit consumes toks. wasm exits 2.
//
// Setup: ProcessCap + EnvCap + FsReadCap. Host is OODA_COMPILER.
//
// Beats:
//   1. Both attach docs contain typed artifact and reference.
//   2. emit/ANCHOR.oo defines emit_backend. CLI emit reads art.toks and does not lex.
//   3. build --backend wasm of a well-typed file exits 2.

fn resolve_p(fs: &FsReadCap, p: String) -> String {
    if path_exists(fs, p) { return p; }
    if path_exists(fs, "oodac/" + p) { return "oodac/" + p; }
    if chars_len(p) > 6 && str_slice(p, 0, 6) == "oodac/" {
        let sub: String = str_slice(p, 6, chars_len(p));
        if path_exists(fs, sub) { return sub; }
    }
    return p;
}

pub fn main(p: &ProcessCap, env: &EnvCap, fs_r: &FsReadCap) {
    let hr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let host: String = match hr { Ok(s) => s, Err(_) => "" };
    if host == "" {
        println("ERR\tOODA_COMPILER required");
        process_exit(1);
    }
    let d1r: Result[String, String] = read_file(fs_r, resolve_p(fs_r, "docs/silent-miscompile-prevention.oot"));
    let d2r: Result[String, String] = read_file(fs_r, resolve_p(fs_r, "docs/x86-codegen-style.oot"));
    if d1r.is_err() || d2r.is_err() {
        println("ERR\tunreadable attach docs");
        process_exit(1);
    }
    let d1: String = match d1r { Ok(s) => s, Err(_) => "" };
    let d2: String = match d2r { Ok(s) => s, Err(_) => "" };
    if str_index_of(d1, "typed artifact") < 0 || str_index_of(d2, "typed artifact") < 0 {
        println("ERR\tdocs missing typed artifact");
        process_exit(1);
    }
    if str_index_of(d1, "reference") < 0 || str_index_of(d2, "reference") < 0 {
        println("ERR\tdocs missing C reference");
        process_exit(1);
    }
    if str_index_of(d1, "emit/<name>/") < 0 && str_index_of(d2, "emit/<name>/") < 0 {
        println("ERR\tdocs missing emit/<name>/ attach dir");
        process_exit(1);
    }
    let mut ea: String = resolve_p(fs_r, "emit/anchor.oo");
    if !path_exists(fs_r, ea) {
        ea = resolve_p(fs_r, "emit/ANCHOR.oo");
    }
    let ar: Result[String, String] = read_file(fs_r, ea);
    if ar.is_err() {
        println("ERR\tunreadable emit anchor");
        process_exit(1);
    }
    let a: String = match ar { Ok(s) => s, Err(_) => "" };
    if str_index_of(a, "emit_backend") < 0 {
        println("ERR\temit/anchor missing emit_backend");
        process_exit(1);
    }
    let c1r: Result[String, String] = read_file(fs_r, resolve_p(fs_r, "cli/cli_emit.oo"));
    let c2r: Result[String, String] = read_file(fs_r, resolve_p(fs_r, "cli/cli_emit_llvm.oo"));
    if c1r.is_err() || c2r.is_err() {
        println("ERR\tunreadable cli emit");
        process_exit(1);
    }
    let c1: String = match c1r { Ok(s) => s, Err(_) => "" };
    let c2: String = match c2r { Ok(s) => s, Err(_) => "" };
    if str_index_of(c1, "art.toks") < 0 || str_index_of(c2, "art.toks") < 0 {
        println("ERR\tcli emit does not consume artifact toks");
        process_exit(1);
    }
    if str_index_of(c1, "lex_scan_source") >= 0 || str_index_of(c2, "lex_scan_source") >= 0 {
        println("ERR\tcli emit re-lexes");
        process_exit(1);
    }
    let wr: Result[String, String] = sys_exec(p, host, "build", resolve_p(fs_r, "qa/probe_list_ok.oo"), "--backend", "wasm");
    if wr.is_ok() {
        println("ERR\tbackend wasm must stay residual");
        process_exit(1);
    }
    println("OK");
}
