pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let _sc1: Result[String, String] = sys_exec(p, "rm", "-rf", ".ooda-cache/ooda-tmp");
    let _sc2: Result[String, String] = sys_exec(p, "rm", "-rf", "oodac/.ooda-cache/ooda-tmp");
    let oodac_res: Result[String, String] = resolve_compiler(fs_r, env);
    let oodac: String = match oodac_res { Ok(s) => s, Err(e) => { return Err(e); } };
    let tag: String = resolve_tag(p, env);
    let mut ps: List[String] = list_new();
    ps = load_probes_1(fs_r, ps);
    ps = load_probes_2(fs_r, ps);
    let mut i: Int = 0;
    while i < list_len(ps) {
        let path: String = list_get(ps, i);
        println("  Running " + path);
        let r: Result[Int, String] = run_probe_twice(p, oodac, path, tag);
        if r.is_err() { return r; }
        i = i + 1;
    }
    println("oodac test suite: ALL PROBES PASSED (double-run identical)");
    let _ec1: Result[String, String] = sys_exec(p, "rm", "-rf", ".ooda-cache/ooda-tmp");
    let _ec2: Result[String, String] = sys_exec(p, "rm", "-rf", "oodac/.ooda-cache/ooda-tmp");
    return Ok(0);
}
