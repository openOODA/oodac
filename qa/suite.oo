    ps = list_push(ps, resolve_probe(fs, "qa/probe_llvm_listops.oo"));
    ps = list_push(ps, resolve_probe(fs, "qa/probe_match_prim_list.oo"));
    ps = list_push(ps, resolve_probe(fs, "qa/probe_match_struct_list.oo"));
    ps = list_push(ps, resolve_probe(fs, "qa/probe_ok_field.oo"));
    ps = list_push(ps, resolve_probe(fs, "qa/probe_one_tu_emit.oo"));
    ps = list_push(ps, resolve_probe(fs, "qa/probe_option_str.oo"));
    ps = list_push(ps, resolve_probe(fs, "qa/probe_result_arg.oo"));
    ps = list_push(ps, resolve_probe(fs, "qa/probe_result_arg_ok.oo"));
    ps = list_push(ps, resolve_probe(fs, "qa/probe_result_let.oo"));
    ps = list_push(ps, resolve_probe(fs, "qa/probe_result_let_ok.oo"));
    ps = list_push(ps, resolve_probe(fs, "qa/probe_result_unknown_kind.oo"));
    ps = list_push(ps, resolve_probe(fs, "qa/probe_smt_vc_gen.oo"));
    ps = list_push(ps, resolve_probe(fs, "qa/probe_smt_bounds_elision.oo"));
