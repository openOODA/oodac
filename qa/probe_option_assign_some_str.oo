// # Probe victim: Some(String) assigned into Option[Int]
//
// Logline: Hostile program. oodac check and build must fail closed. No ELF.
//
// Setup: let mut o is Option[Int] from Some(0), then assigned Some("no").
//
// Beats:
//   1. check exits nonzero with ERR.
//   2. build exits nonzero, prints ERR, and does not write an ELF.

pub fn main() {
    let mut o: Option[Int] = Some(0);
    o = Some("no");
    if o.is_some() {
        println("no");
    }
}
