// # Probe victim: List[String] callee returned from List[Int] main
//
// Logline: Hostile program. check and build must fail closed. No ELF.
//
// Setup: slist returns List[String]. main is List[Int] and returns slist().
//
// Beats:
//   1. check exits nonzero with ERR.
//   2. build exits nonzero, prints ERR, and does not write an ELF.

fn slist() -> List[String] {
    return list_new();
}

pub fn main() -> List[Int] {
    return slist();
}
