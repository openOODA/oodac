// # Adversarial Struct ARC Scope Exit Probe
//
// Logline: Adversarially stress tests memory safety and ARC retain/release for structs containing lists and strings.
//
// Setup: Requires working oodac compiler with correct C emit ARC retain/release on struct scope exit.
//
// Beats:
//   1. Define structs containing List[Int], List[String], and String fields.
//   2. Allocate and release structs in high-iteration loops (5,000 iterations) asserting memory stability.
//   3. Pass and return structs across function boundaries verifying ARC lifecycle.
//   4. Test nested structs holding heap-allocated resources on scope exit.

type InnerData = struct {
    tag: String,
    numbers: List[Int]
};

type OuterContainer = struct {
    label: String,
    inner: InnerData,
    names: List[String]
};

pub fn make_inner(tag: String, count: Int) -> InnerData {
    let mut nums: List[Int] = list_new();
    for i in 0..count {
        nums = list_push(nums, i * 10);
    }
    return InnerData {
        tag: tag,
        numbers: nums
    };
}

pub fn make_outer(label: String, count: Int) -> OuterContainer {
    let in_obj: InnerData = make_inner(label + "_inner", count);
    let mut names: List[String] = list_new();
    for i in 0..count {
        names = list_push(names, "item_" + label);
    }
    return OuterContainer {
        label: label,
        inner: in_obj,
        names: names
    };
}

pub fn inspect_outer(obj: OuterContainer) -> Int {
    let in_tag: String = obj.inner.tag;
    let n_count: Int = list_len(obj.inner.numbers);
    let s_count: Int = list_len(obj.names);
    if chars_len(in_tag) > 0 {
        return n_count + s_count;
    }
    return -1;
}

pub fn soak_scope_exit(iterations: Int) -> Int {
    let mut total_checks: Int = 0;
    for i in 0..iterations {
        let tag_name: String = "iter_tag";
        let container: OuterContainer = make_outer(tag_name, 5);
        let score: Int = inspect_outer(container);
        total_checks = total_checks + score;
    }
    return total_checks;
}

pub fn main() {
    let mut num_errors: Int = 0;

    // Test 1: Single allocation and inspection
    let c1: OuterContainer = make_outer("unit_test", 4);
    let score1: Int = inspect_outer(c1);
    // 4 numbers + 4 names = 8
    if score1 == 8 {
    } else {
        println("FAIL: inspect_outer unit_test");
        num_errors = num_errors + 1;
    }

    // Test 2: Field integrity after passing
    if c1.label == "unit_test" && c1.inner.tag == "unit_test_inner" {
    } else {
        println("FAIL: c1 field integrity");
        num_errors = num_errors + 1;
    }

    // Test 3: High iteration soak loop for ARC stability (5000 cycles)
    let soak_total: Int = soak_scope_exit(5000);
    // 5000 * (5 + 5) = 50,000
    if soak_total == 50000 {
    } else {
        println("FAIL: soak_scope_exit total");
        num_errors = num_errors + 1;
    }

    if num_errors == 0 {
        println("probe_adversarial_struct_arc: PASSED");
    } else {
        println("probe_adversarial_struct_arc: FAILED");
        process_exit(1);
    }
}
