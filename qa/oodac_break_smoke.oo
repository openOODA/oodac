// # Probe: double-run check of a sealed-cap victim
//
// Logline: Two fresh oodac check processes of probe_cap_sealed.oo both fail closed.
//
// Setup: ProcessCap + EnvCap. Host is OODA_COMPILER. No challenger tree. No shell.
//
// Beats:
//   1. First check exits nonzero.
//   2. Second check exits nonzero.
//   3. Both print capability.

pub fn main(p: &ProcessCap, env: &EnvCap) {
    let hr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let host: String = match hr { Ok(s) => s, Err(_) => "" };
    if host == "" {
        println("ERR\tOODA_COMPILER required");
        process_exit(1);
    }
    let v: String = "oodac/qa/probe_cap_sealed.oo";
    let a: Result[String, String] = sys_exec(p, host, "check", v);
    let b: Result[String, String] = sys_exec(p, host, "check", v);
    if a.is_ok() || b.is_ok() {
        println("ERR\tsealed victim must fail");
        process_exit(1);
    }
    if str_index_of(a.val, "capability") < 0 || str_index_of(b.val, "capability") < 0 {
        println("ERR\tmissing capability diagnostic");
        process_exit(1);
    }
    println("OK");
}
