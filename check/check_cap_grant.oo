// # Grant and deny capability bags
//
// Logline: Stores granted Cap kinds and arg-flow names in pipe bags, checks exact preferred-kind membership, and denies sealed calls.
//
// Setup: Bags are "|name|" strings; arg-flow keys are Kind:id; preferred is sealed_kind_of(op); cap_deny prints and process_exit(1).
//
// Beats:
//   1. cap_bag_put and cap_bag_has scan a pipe-delimited bag; cap_deny prints the sealed-call violation and exits.
//   2. Soft-granular net, fs, and sys kinds accept the exact preferred kind only — no legacy supersede.
//   3. Arg-flow bags accept the exact preferred:id form only — no legacy supersede.
//   4. No legacy supersede: callers must use the granular preferred kind.

// Bag of param names: "|fs|other|"
pub fn cap_bag_put(bag: String, name: String) -> String {
    return bag + "|" + name + "|";
}

pub fn cap_bag_has(bag: String, name: String) -> Bool {
    let needle = "|" + name + "|";
let bn = chars_len(bag);
let nn = chars_len(needle);
if nn > bn { return false;
}
    let mut i = 0;
    while i + nn <= bn { let mut j = 0;
    let mut ok = true;
    while j < nn { if char_at(bag, i + j) != char_at(needle, j) { ok = false;
    j = nn;
    } else {
                j = j + 1;
            }
        }
        if ok { return true;
        }
        i = i + 1;
    }
    return false;
}

// Deny sealed free/method call. kind: "FsCap"/"SysCap"/"EnvCap"/"NetCap"
pub fn cap_deny(fname: String, op: String, kind: String, line: String, col: String, why: String) {
    println(
        "ERR\tcapability\tSecurity Capability Violation: Function '"
            + fname
            + "' calls sealed effectful builtin '"
            + op
            + "' which requires a &"
            + kind
            + " "
            + why
            + " at line "
            + line
            + ", col "
            + col
            + ". Default-deny: grant the capability token explicitly."
    );
    process_exit(1);
}

// CAP-G1: soft-granular net preferred kinds (granular only; no broad NetCap supersede).
// No legacy supersede: callers must use the granular preferred kind (HttpCap, TcpCap, UdpCap, BindCap).
// &NetCap is reserved for sock_raw / raw_socket — it does not satisfy HttpCap / TcpCap / UdpCap / BindCap.
pub fn is_soft_net_kind(kind: String) -> Bool {
    if kind == "HttpCap" { return true;
    }
    if kind == "TcpCap" { return true;
    }
    if kind == "UdpCap" { return true;
    }
    if kind == "BindCap" { return true;
    }
    return false;
}

// CAP-G1 bag: exact preferred kind only. No legacy supersede.
// Replaces inverted "any granular satisfies NetCap" (HttpCap must not authorize tcp_bind).
// Callers must declare the exact granular &HttpCap / &TcpCap / &UdpCap / &BindCap; &NetCap does NOT satisfy these.
pub fn cap_net_granted_ok(preferred: String, granted_bag: String) -> Bool {
    if preferred == "" { return false;
    }
    if cap_bag_has(granted_bag, preferred) { return true;
    }
    return false;
}

// CAP-G1 arg-flow names bag: exact preferred:id only. No legacy supersede.
// Callers must pass the matching granular cap (e.g. &HttpCap); &NetCap does NOT satisfy.
pub fn cap_net_argflow_ok(preferred: String, cap_id: String, names_bag: String) -> Bool {
    if preferred == "" { return false;
    }
    if cap_bag_has(names_bag, preferred + ":" + cap_id) { return true;
    }
    return false;
}

// CAP-G2: soft-granular fs kinds (granular only; no broad FsCap supersede).
// No legacy supersede: callers must use the granular preferred kind (FsReadCap, FsWriteCap).
// &FsCap is no longer accepted; split into &FsReadCap and/or &FsWriteCap at the call site.
pub fn is_soft_fs_kind(kind: String) -> Bool {
    if kind == "FsReadCap" { return true;
    }
    if kind == "FsWriteCap" { return true;
    }
    return false;
}

// CAP-G2 bag: exact preferred kind only. No legacy supersede.
// FsReadCap must not authorize write_file and vice versa; &FsCap does NOT satisfy either.
pub fn cap_fs_granted_ok(preferred: String, granted_bag: String) -> Bool {
    if preferred == "" { return false;
    }
    if cap_bag_has(granted_bag, preferred) { return true;
    }
    return false;
}

// CAP-G2 arg-flow: exact preferred:id only. No legacy supersede.
// Callers must pass the matching granular cap (e.g. &FsReadCap); &FsCap does NOT satisfy.
pub fn cap_fs_argflow_ok(preferred: String, cap_id: String, names_bag: String) -> Bool {
    if preferred == "" { return false;
    }
    if cap_bag_has(names_bag, preferred + ":" + cap_id) { return true;
    }
    return false;
}

// CAP-G4: ProcessCap is the only soft-granular sys kind (granular only; no broad SysCap supersede).
// No legacy supersede: callers must use the granular preferred kind (ProcessCap).
// &SysCap is no longer accepted; split into &ProcessCap at the call site.
pub fn is_soft_sys_kind(kind: String) -> Bool {
    if kind == "ProcessCap" { return true;
    }
    return false;
}

// CAP-G4 bag: exact preferred kind only. No legacy supersede.
// ProcessCap alone must NOT unlock hard SysCap ops (python_embed, prctl, …); &SysCap does NOT satisfy ProcessCap.
pub fn cap_sys_granted_ok(preferred: String, granted_bag: String) -> Bool {
    if preferred == "" { return false;
    }
    if cap_bag_has(granted_bag, preferred) { return true;
    }
    return false;
}

// CAP-G4 arg-flow: exact preferred:id only. No legacy supersede.
// Callers must pass the matching granular cap (e.g. &ProcessCap); &SysCap does NOT satisfy.
pub fn cap_sys_argflow_ok(preferred: String, cap_id: String, names_bag: String) -> Bool {
    if preferred == "" { return false;
    }
    if cap_bag_has(names_bag, preferred + ":" + cap_id) { return true;
    }
    return false;
}
