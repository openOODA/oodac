// ──▓▓ Public Type Checking & Verification API ──▓▓──

pub fn types_check_caps(toks: List[String], pos0: Int) -> Int {
    return check_caps(toks, pos0);
}

pub fn types_check_types(src: String) -> String {
    return check_types(src);
}

pub fn types_type_env(env: String, name: String, ty: String) -> String {
    return type_env(env, name, ty);
}

pub fn check_run_src(src: String) -> Int {
    return run_check_from_src(src);
}

pub fn check_run_modules(fs: &FsReadCap, entry: String) -> Int {
    return check_modules(fs, entry);
}

pub fn check_run_typestate(src: String) -> Int {
    return check_typestate(src);
}

pub fn check_run_smt(toks: List[String]) -> Int {
    if smt_verify_pass_run(toks) { return 0; }
    return 1;
}
