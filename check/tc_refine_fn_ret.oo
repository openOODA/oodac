// # Check a refined return INT / Capture a fn return bound
//
// Logline: When a fn has an Int[lo..hi] return bound, reject a literal return N or return -N that falls outside it. Read Int[lo..hi] after a function arrow and pack whether a bound was found with its min and max.
//
// Setup: Merged cohesive compiler module.
//
// Beats:
//   1. Unified cohesive implementation.

pub fn refine_check_return(toks: List[String], i: Int, has_ret_bound: Bool, ret_bound_min: Int, ret_bound_max: Int) {
    if !has_ret_bound { return;
    }
    let n = list_len(toks);
    if i + 1 >= n { return;
    }
    let k1: String = field_at(list_get(toks, i + 1), 0);
    let mut val = 0;
    let mut ok = false;
    let mut err_i = i + 1;
    if k1 == "INT" {
        val = parse_int(field_at(list_get(toks, i + 1), 3));
        ok = true;
    } else if k1 == "MINUS" {
        if i + 2 < n { if field_at(list_get(toks, i + 2), 0) == "INT" { val = 0 - parse_int(field_at(list_get(toks, i + 2), 3));
        err_i = i + 2;
        ok = true;
        }
        }
    }
    if ok { if val < ret_bound_min || val > ret_bound_max { tc_err_at(toks, err_i, "RefinementTypeViolation");
    }
    }
}

pub fn refine_capture_fn_ret_bound(toks: List[String], i: Int) -> List[String] {
    let n = list_len(toks);
    let mut j = i;
    let mut found = false;
    let mut ret_bound_min = 0;
    let mut ret_bound_max = 0;
    while j < n { if field_at(list_get(toks, j), 0) == "LBRACE" { break;
    }
        if field_at(list_get(toks, j), 0) == "ARROW" {
            if j + 6 < n { if field_at(list_get(toks, j + 1), 3) == "Int" { if field_at(list_get(toks, j + 2), 0) == "LBRACKET" { if field_at(list_get(toks, j + 3), 0) == "INT" { if field_at(list_get(toks, j + 4), 0) == "DOTDOT" { if field_at(list_get(toks, j + 5), 0) == "INT" { if field_at(list_get(toks, j + 6), 0) == "RBRACKET" { ret_bound_min = parse_int(field_at(list_get(toks, j + 3), 3));
            ret_bound_max = parse_int(field_at(list_get(toks, j + 5), 3));
            found = true;
            }
                                }
                            }
                        }
                    }
                }
            }
        }
        j = j + 1;
    }
    let mut r: List[String] = list_new();
    if found { r = list_push(r, "1");
    } else {
        r = list_push(r, "0");
    }
    r = list_push(r, ret_bound_min.to_string());
    r = list_push(r, ret_bound_max.to_string());
    return r;
}
