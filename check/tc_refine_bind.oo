// # Check a refined Int let initializer / Check assignment against a refined Int
//
// Logline: Rejects let x: Int[lo..hi] = const when the folded initializer sits outside the range. Rejects an INT assigned to a let-bound Int[lo..hi] when the value sits outside the range.
//
// Setup: Merged cohesive compiler module.
//
// Beats:
//   1. Unified cohesive implementation.

pub fn refine_check_let(toks: List[String], i: Int) {
    let n = list_len(toks);
    let mut off = 2;
    if i + 1 < n { if field_at(list_get(toks, i + 1), 0) == "KW_MUT" { off = 3;
    }
    }
    if i + off + 8 < n { if field_at(list_get(toks, i + off), 0) == "COLON" { if field_at(list_get(toks, i + off + 1), 3) == "Int" { if field_at(list_get(toks, i + off + 2), 0) == "LBRACKET" { if field_at(list_get(toks, i + off + 3), 0) == "INT" { if field_at(list_get(toks, i + off + 4), 0) == "DOTDOT" { if field_at(list_get(toks, i + off + 5), 0) == "INT" { if field_at(list_get(toks, i + off + 6), 0) == "RBRACKET" { if field_at(list_get(toks, i + off + 7), 0) == "EQ" { if field_at(list_get(toks, i + off + 8), 0) == "INT" { let min = 0 + parse_int(field_at(list_get(toks, i + off + 3), 3));
    let max = 0 + parse_int(field_at(list_get(toks, i + off + 5), 3));
    let mut val = 0 + parse_int(field_at(list_get(toks, i + off + 8), 3));
    let mut end_tok = i + off + 8;
    if i + off + 10 < n { let op: String = field_at(list_get(toks, i + off + 9), 0);
    if op == "PLUS" || op == "MINUS" || op == "STAR" || op == "SLASH" { if field_at(list_get(toks, i + off + 10), 0) == "INT" { let val2 = 0 + parse_int(field_at(list_get(toks, i + off + 10), 3));
    if op == "PLUS" { val = val + val2;
    } else if op == "MINUS" {
                                                            val = val - val2;
                                                        } else if op == "STAR" {
                                                            val = val * val2;
                                                        } else if op == "SLASH" {
                                                            if val2 != 0 { val = val / val2;
                                                            }
                                                        }
                                                        end_tok = i + off + 10;
                                                    }
                                                }
                                            }
                                            if val < min || val > max { tc_err_at(toks, end_tok, "RefinementTypeViolation");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

pub fn refine_check_assign(toks: List[String], i: Int) {
    let n = list_len(toks);
    if i + 2 < n { if field_at(list_get(toks, i + 1), 0) == "EQ" { if field_at(list_get(toks, i + 2), 0) == "INT" { let target_var: String = field_at(list_get(toks, i), 3);
    let val = 0 + parse_int(field_at(list_get(toks, i + 2), 3));
    let mut j = i - 1;
    while j >= 0 { if field_at(list_get(toks, j), 0) == "KW_LET" { let mut off = 1;
    if j + 1 < i { if field_at(list_get(toks, j + 1), 0) == "KW_MUT" { off = 2;
    }
                        }
                        if j + off + 9 < i { if field_at(list_get(toks, j + off), 3) == target_var { if field_at(list_get(toks, j + off + 1), 0) == "COLON" { if field_at(list_get(toks, j + off + 2), 3) == "Int" { if field_at(list_get(toks, j + off + 3), 0) == "LBRACKET" { if field_at(list_get(toks, j + off + 4), 0) == "INT" { if field_at(list_get(toks, j + off + 5), 0) == "DOTDOT" { if field_at(list_get(toks, j + off + 6), 0) == "INT" { if field_at(list_get(toks, j + off + 7), 0) == "RBRACKET" { let min = 0 + parse_int(field_at(list_get(toks, j + off + 4), 3));
                        let max = 0 + parse_int(field_at(list_get(toks, j + off + 6), 3));
                        if val < min || val > max { tc_err_at(toks, i + 2, "RefinementTypeViolation");
                        }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                break;
                            }
                        }
                    }
                    j = j - 1;
                }
            }
        }
    }
}
