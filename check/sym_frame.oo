// # Structured lexical symbol frame table
// Logline: Nested lexical frames, CFG borrow analysis, reverse-order ARC exit hooks.
// Setup: Frames own variable lifetimes for the C emitter.
// Beats: SymVar flags formal=1 borrow=2 moved=4; FrameTable enter/leave/bind; borrow elides ARC; lifetimes/regions via parent chain; move denies use-after-move — rustc/Go/Zig best.
import "lex/token_parse_int.oo";
pub type SymVar = struct {
    name: String, ty_ast: String, c_ty: String, flags: Int, borrow_root: String
};
pub type FrameTable = struct {
    levels: List[Int], parents: List[Int], frame_vars: List[String], active_frame: Int
};
pub fn c_is_managed_type(c_ty: String) -> Bool {
    if c_ty == "OoStr" || c_ty == "OoSList" || c_ty == "OoIList" || c_ty == "OoFList" || c_ty == "T" || c_ty == "S" || c_ty == "LI" || c_ty == "LF" || c_ty == "R" || c_ty == "RI" || c_ty == "RLI" || c_ty == "RLS" || c_ty == "RLF" || c_ty == "V" || c_ty == "RB" || c_ty == "RF" { return true; }
    if c_ty == "String" || c_ty == "List" || c_ty == "Option" || c_ty == "Result" || c_ty == "Box" || c_ty == "TyStr" || c_ty == "TyList" || c_ty == "TyOption" || c_ty == "TyResult" || c_ty == "TyBox" { return true; }
    if c_ty == "OoL_S" || c_ty == "OoL_I" || c_ty == "OoL_F" || c_ty == "OoOpt_I" || c_ty == "OoOpt_S" || c_ty == "OoOpt_F" || c_ty == "OoOpt_B" { return true; }
    if c_ty == "OoResS" || c_ty == "OoResI" || c_ty == "OoResV" || c_ty == "OoResB" || c_ty == "OoResF" || c_ty == "OoResLI" || c_ty == "OoResLS" || c_ty == "OoResLF" { return true; }
    return false;
}
fn sv_pack(name: String, ty_ast: String, c_ty: String, flags: Int, borrow_root: String) -> SymVar {
    let res: SymVar = SymVar { name: name, ty_ast: ty_ast, c_ty: c_ty, flags: flags, borrow_root: borrow_root };
    return res;
}
fn sv_flags(is_formal: Bool, is_borrow: Bool) -> Int { if is_formal { if is_borrow { return 3; } return 1; } if is_borrow { return 2; } return 0; }
fn sv_flags_moved(b: Int) -> Int { if b >= 4 { return b; } return b + 4; }
fn sv_is_moved(f: Int) -> Bool { return f == 4 || f == 5 || f == 6 || f == 7; }
fn sv_is_borrow(f: Int) -> Bool { return f == 2 || f == 3 || f == 6 || f == 7; }
fn sv_is_formal(f: Int) -> Bool { return f == 1 || f == 3 || f == 5 || f == 7; }
pub fn c_frame_var_new(name: String, ty_ast: String, c_ty: String, is_formal: Bool) -> SymVar { return sv_pack(name, ty_ast, c_ty, sv_flags(is_formal, false), ""); }
pub fn c_frame_var_borrow_new(name: String, ty_ast: String, c_ty: String, is_formal: Bool, is_borrow: Bool, borrow_root: String) -> SymVar { return sv_pack(name, ty_ast, c_ty, sv_flags(is_formal, is_borrow), borrow_root); }
fn c_symvar_encode(v: SymVar) -> String {
    let f: String = if sv_is_formal(v.flags) { "1" } else { "0" };
    let m: String = if c_is_managed_type(v.c_ty) { "1" } else { "0" };
    let b: String = if sv_is_borrow(v.flags) { "1" } else { "0" };
    let mv: String = if sv_is_moved(v.flags) { "1" } else { "0" };
    return v.name + "\t" + v.ty_ast + "\t" + v.c_ty + "\t" + f + "\t" + m + "\t" + b + "\t" + v.borrow_root + "\t" + mv;
}
fn c_symvar_decode(s: String) -> SymVar {
    let parts: List[String] = str_split(s, "\t");
    if list_len(parts) < 7 { return c_frame_var_borrow_new("", "", "", false, false, ""); }
    let mut flags: Int = 0;
    if list_get(parts, 3) == "1" { flags = flags + 1; }
    if list_get(parts, 5) == "1" { flags = flags + 2; }
    if list_len(parts) >= 8 && list_get(parts, 7) == "1" { flags = flags + 4; }
    let root: String = if list_len(parts) >= 7 { list_get(parts, 6) } else { "" };
    return sv_pack(list_get(parts, 0), list_get(parts, 1), list_get(parts, 2), flags, root);
}
pub fn c_frame_table_new() -> FrameTable {
    let mut levels: List[Int] = list_new(); levels = list_push(levels, 0);
    let mut parents: List[Int] = list_new(); parents = list_push(parents, -1);
    let mut fvars: List[String] = list_new(); fvars = list_push(fvars, "");
    return FrameTable { levels: levels, parents: parents, frame_vars: fvars, active_frame: 0 };
}
pub fn c_frame_enter(tbl: FrameTable) -> FrameTable {
    let p_idx: Int = tbl.active_frame;
    let mut levels: List[Int] = tbl.levels; levels = list_push(levels, list_get(tbl.levels, p_idx) + 1);
    let mut parents: List[Int] = tbl.parents; parents = list_push(parents, p_idx);
    let mut fvars: List[String] = tbl.frame_vars; fvars = list_push(fvars, "");
    return FrameTable { levels: levels, parents: parents, frame_vars: fvars, active_frame: list_len(levels) - 1 };
}
pub fn c_frame_leave(tbl: FrameTable) -> FrameTable {
    let cur_idx: Int = tbl.active_frame;
    if cur_idx <= 0 { return tbl; }
    return FrameTable { levels: tbl.levels, parents: tbl.parents, frame_vars: tbl.frame_vars, active_frame: list_get(tbl.parents, cur_idx) };
}
pub fn c_frame_bind(tbl: FrameTable, name: String, ty_ast: String, c_ty: String, is_formal: Bool) -> FrameTable { return c_frame_bind_borrow(tbl, name, ty_ast, c_ty, is_formal, false, ""); }
pub fn c_frame_bind_borrow(tbl: FrameTable, name: String, ty_ast: String, c_ty: String, is_formal: Bool, is_borrow: Bool, borrow_root: String) -> FrameTable {
    if is_borrow && borrow_root != "" {
        let mut cur = tbl.active_frame;
        while cur >= 0 {
            let vstr = list_get(tbl.frame_vars, cur);
            if vstr != "" {
                let ls: List[String] = str_split(vstr, "\n");
                let mut i = list_len(ls) - 1;
                while i >= 0 {
                    let cv = c_symvar_decode(list_get(ls, i));
                    if cv.borrow_root == borrow_root && sv_is_borrow(cv.flags) { println("ERR\tborrow\tmut alias " + borrow_root); process_exit(1); }
                    i = i - 1;
                }
            }
            cur = list_get(tbl.parents, cur);
        }
        if !c_frame_lifetime_ok(tbl, borrow_root) { println("ERR\tborrow\tlifetime outlives owner " + borrow_root); process_exit(1); }
    }
    if c_frame_is_moved(tbl, name) { println("ERR\tmove\tcannot rebind moved " + name); process_exit(1); }
    let cur_idx: Int = tbl.active_frame;
    let enc: String = c_symvar_encode(c_frame_var_borrow_new(name, ty_ast, c_ty, is_formal, is_borrow, borrow_root));
    let tbl_fvars: List[String] = tbl.frame_vars;
    let cur_v: String = list_get(tbl_fvars, cur_idx);
    let new_v: String = if cur_v == "" { enc + "" } else { cur_v + "\n" + enc };
    let mut fvars: List[String] = list_new();
    let nf: Int = list_len(tbl_fvars);
    let mut i: Int = 0;
    while i < nf { if i == cur_idx { fvars = list_push(fvars, new_v); } else { fvars = list_push(fvars, list_get(tbl_fvars, i)); } i = i + 1; }
    return FrameTable { levels: tbl.levels, parents: tbl.parents, frame_vars: fvars, active_frame: cur_idx };
}
pub fn c_frame_lookup(tbl: FrameTable, name: String) -> SymVar {
    let mut cur: Int = tbl.active_frame;
    let tbl_fvars: List[String] = tbl.frame_vars;
    while cur >= 0 {
        let vstr: String = list_get(tbl_fvars, cur);
        if vstr != "" {
            let lines: List[String] = str_split(vstr, "\n");
            let mut i: Int = list_len(lines) - 1;
            while i >= 0 { let v: SymVar = c_symvar_decode(list_get(lines, i)); if v.name == name { return v; } i = i - 1; }
        }
        cur = list_get(tbl.parents, cur);
    }
    return c_frame_var_borrow_new("", "", "", false, false, "");
}
fn c_frame_find_region(tbl: FrameTable, name: String) -> Int {
    let mut cur: Int = tbl.active_frame;
    let tbl_fvars: List[String] = tbl.frame_vars;
    while cur >= 0 {
        let vstr: String = list_get(tbl_fvars, cur);
        if vstr != "" {
            let lines: List[String] = str_split(vstr, "\n");
            let mut i: Int = list_len(lines) - 1;
            while i >= 0 { let v: SymVar = c_symvar_decode(list_get(lines, i)); if v.name == name { return cur; } i = i - 1; }
        }
        cur = list_get(tbl.parents, cur);
    }
    return -1;
}
pub fn c_frame_lifetime_ok(tbl: FrameTable, borrow_root: String) -> Bool {
    if borrow_root == "" { return true; }
    let mut clean: String = str_slice(borrow_root, 0, chars_len(borrow_root));
    if chars_len(clean) > 1 && char_at(clean, 0) == "&" { clean = str_slice(clean, 1, chars_len(clean)); }
    if chars_len(clean) > 4 && str_slice(clean, 0, 4) == "mut " { clean = str_slice(clean, 4, chars_len(clean)); }
    let n: Int = chars_len(clean);
    let mut di: Int = 0;
    let mut dot: Int = -1;
    while di < n { if char_at(clean, di) == "." && dot < 0 { dot = di; } di = di + 1; }
    if dot > 0 { clean = str_slice(clean, 0, dot); }
    let mut reg: Int = -1;
    let mut cur: Int = tbl.active_frame;
    while cur >= 0 && reg < 0 { let vstr: String = list_get(tbl.frame_vars, cur); if vstr != "" { let lines: List[String] = str_split(vstr, "
"); let mut i: Int = list_len(lines) - 1; while i >= 0 { let v: SymVar = c_symvar_decode(list_get(lines, i)); if v.name == clean { reg = cur; i = -1; } else { i = i - 1; } } } cur = list_get(tbl.parents, cur); }
    if reg < 0 { return false; }
    let mut c: Int = tbl.active_frame;
    while c >= 0 { if c == reg { return true; } if c < 0 || c >= list_len(tbl.parents) { return false; } c = list_get(tbl.parents, c); }
    return false;
}

pub fn c_frame_is_moved(tbl: FrameTable, name: String) -> Bool { let v: SymVar = c_frame_lookup(tbl, name); if v.name == "" { return false; } return sv_is_moved(v.flags); }
pub fn c_frame_check_use(tbl: FrameTable, name: String) -> Bool {
    if name == "" { return true; }
    let mut clean: String = str_slice(name, 0, chars_len(name));
    if chars_len(clean) > 1 && char_at(clean, 0) == "&" { clean = str_slice(clean, 1, chars_len(clean)); }
    if chars_len(clean) > 4 && str_slice(clean, 0, 4) == "mut " { clean = str_slice(clean, 4, chars_len(clean)); }
    let v: SymVar = c_frame_lookup(tbl, clean);
    if v.name == "" { return true; }
    if sv_is_moved(v.flags) { println("ERR\tmove\tuse after move " + clean); process_exit(1); }
    return true;
}
pub fn c_frame_move(tbl: FrameTable, name: String) -> FrameTable {
    let mut clean: String = str_slice(name, 0, chars_len(name)); if chars_len(clean) > 1 && char_at(clean, 0) == "&" { clean = str_slice(clean, 1, chars_len(clean)); }
    let v: SymVar = c_frame_lookup(tbl, clean);
    if v.name == "" { println("ERR	move	unknown " + clean); process_exit(1); }
    if sv_is_moved(v.flags) { println("ERR	move	double move " + clean); process_exit(1); }
    if sv_is_borrow(v.flags) { println("ERR	move	cannot move borrowed " + clean); process_exit(1); }
    if !c_is_managed_type(v.c_ty) { return tbl; }
    let mut cur: Int = tbl.active_frame;
    let mut reg: Int = -1;
    while cur >= 0 && reg < 0 { let vstr: String = list_get(tbl.frame_vars, cur); if vstr != "" { let lines: List[String] = str_split(vstr, "
"); let mut i: Int = list_len(lines) - 1; while i >= 0 { let cv: SymVar = c_symvar_decode(list_get(lines, i)); if cv.name == clean { reg = cur; i = -1; } else { i = i - 1; } } } cur = list_get(tbl.parents, cur); }
    if reg < 0 { return tbl; }
    let tbl_fvars: List[String] = tbl.frame_vars; let vstr: String = list_get(tbl_fvars, reg); let lines: List[String] = str_split(vstr, "
"); let mut out_lines: List[String] = list_new(); let mut i: Int = 0; let ln: Int = list_len(lines);
    while i < ln { let cv: SymVar = c_symvar_decode(list_get(lines, i)); if cv.name == clean { let moved: SymVar = sv_pack(cv.name, cv.ty_ast, cv.c_ty, sv_flags_moved(cv.flags), cv.borrow_root); out_lines = list_push(out_lines, c_symvar_encode(moved)); } else { out_lines = list_push(out_lines, list_get(lines, i)); } i = i + 1; }
    let mut new_v: String = ""; let mut j: Int = 0; let lj: Int = list_len(out_lines); while j < lj { if j == 0 { new_v = list_get(out_lines, j); } else { new_v = new_v + "
" + list_get(out_lines, j); } j = j + 1; }
    let mut fvars: List[String] = list_new(); let nf: Int = list_len(tbl_fvars); let mut k: Int = 0; while k < nf { if k == reg { fvars = list_push(fvars, new_v); } else { fvars = list_push(fvars, list_get(tbl_fvars, k)); } k = k + 1; }
    return FrameTable { levels: tbl.levels, parents: tbl.parents, frame_vars: fvars, active_frame: tbl.active_frame };
}

pub fn c_frame_borrow_check(table: FrameTable, var_name: String, scope_id: Int) -> Bool {
    if var_name == "" { return false; }
    let mut clean_name: String = str_slice(var_name, 0, chars_len(var_name));
    if chars_len(clean_name) > 1 && char_at(clean_name, 0) == "&" { clean_name = str_slice(clean_name, 1, chars_len(clean_name)); }
    if chars_len(clean_name) > 4 && str_slice(clean_name, 0, 4) == "mut " { clean_name = str_slice(clean_name, 4, chars_len(clean_name)); }
    let n: Int = chars_len(clean_name);
    let mut di: Int = 0;
    let mut dot_idx: Int = -1;
    while di < n { if char_at(clean_name, di) == "." && dot_idx < 0 { dot_idx = di; } di = di + 1; }
    if dot_idx > 0 { clean_name = str_slice(clean_name, 0, dot_idx); }
    let v: SymVar = c_frame_lookup(table, clean_name);
    if v.name == "" { return false; }
    if sv_is_borrow(v.flags) || sv_is_formal(v.flags) { return true; }
    if sv_is_moved(v.flags) { return false; }
    let mut cur: Int = table.active_frame;
    let tbl_fvars: List[String] = table.frame_vars;
    while cur >= 0 {
        let vstr: String = list_get(tbl_fvars, cur);
        if vstr != "" {
            let lines: List[String] = str_split(vstr, "\n");
            let mut i: Int = list_len(lines) - 1;
            while i >= 0 { let cv: SymVar = c_symvar_decode(list_get(lines, i)); if cv.name == clean_name { return cur >= 0 && cur <= scope_id; } i = i - 1; }
        }
        cur = list_get(table.parents, cur);
    }
    return false;
}
pub fn c_frame_elide_retain_release(table: FrameTable, expr: String) -> String {
    let n: Int = chars_len(expr);
    if n < 4 { return expr; }
    let mut lp: Int = -1;
    let mut rp: Int = -1;
    let mut i: Int = 0;
    while i < n { let ch: String = char_at(expr, i); if ch == "(" && lp < 0 { lp = i; } if ch == ")" { rp = i; } i = i + 1; }
    if lp < 0 || rp <= lp { return expr; }
    let arg: String = str_slice(expr, lp + 1, rp);
    if c_frame_borrow_check(table, arg, table.active_frame) { return ""; }
    return expr;
}
pub fn c_frame_emit_exit(tbl: FrameTable) -> String {
    let cur_idx: Int = tbl.active_frame;
    if cur_idx < 0 { return ""; }
    let fvars: List[String] = tbl.frame_vars;
    let vstr: String = list_get(fvars, cur_idx);
    if vstr == "" { return ""; }
    let lines: List[String] = str_split(vstr, "\n");
    let mut out: String = "";
    let mut i: Int = list_len(lines) - 1;
    while i >= 0 { let v: SymVar = c_symvar_decode(list_get(lines, i)); if c_is_managed_type(v.c_ty) && !sv_is_borrow(v.flags) && !sv_is_moved(v.flags) { out = out + c_arc_kind_release_sym(v.c_ty, v.name); } i = i - 1; }
    return out;
}
pub fn c_frame_emit_all_exits(tbl: FrameTable) -> String {
    let mut cur: Int = tbl.active_frame;
    let mut out: String = "";
    while cur >= 0 { let sub_tbl: FrameTable = FrameTable { levels: tbl.levels, parents: tbl.parents, frame_vars: tbl.frame_vars, active_frame: cur }; out = out + c_frame_emit_exit(sub_tbl); cur = list_get(tbl.parents, cur); }
    return out;
}
pub fn c_frame_emit_local_exits(tbl: FrameTable) -> String {
    let mut cur: Int = tbl.active_frame;
    let mut out: String = "";
    while cur > 0 { let sub_tbl: FrameTable = FrameTable { levels: tbl.levels, parents: tbl.parents, frame_vars: tbl.frame_vars, active_frame: cur }; out = out + c_frame_emit_exit(sub_tbl); cur = list_get(tbl.parents, cur); }
    return out;
}
pub fn c_arc_kind_release_sym(k: String, name: String) -> String {
    if k == "T" || k == "OoStr" { return "oo_str_release(" + name + "); "; } if k == "S" || k == "OoSList" || k == "OoL_S" { return "oo_slist_release(" + name + "); "; } if k == "LF" || k == "OoFList" || k == "OoL_F" { return "oo_flist_release(" + name + "); "; } if k == "LI" || k == "OoIList" || k == "OoL_I" { return "oo_ilist_release(" + name + "); "; }
    if k == "I" || k == "F" || k == "B" || k == "V" || k == "long long" || k == "double" || k == "int" { return ""; }
    if k == "R" || k == "OoResS" || k == "OoRes_S" { return "if (" + name + ".ok) { oo_str_release(" + name + ".val); } "; } if k == "RI" || k == "OoResI" || k == "OoRes_I" || k == "OoResV" || k == "RB" || k == "OoResB" || k == "OoRes_B" || k == "RF" || k == "OoResF" || k == "OoRes_F" { return "if (!" + name + ".ok) { oo_str_release(" + name + ".err); } "; }
    if k == "RLI" || k == "OoResLI" || k == "OoRes_OoL_I" { return "if (" + name + ".ok) { oo_ilist_release(" + name + ".val); } else { oo_str_release(" + name + ".err); } "; } if k == "RLS" || k == "OoResLS" || k == "OoRes_OoL_S" { return "if (" + name + ".ok) { oo_slist_release(" + name + ".val); } else { oo_str_release(" + name + ".err); } "; } if k == "RLF" || k == "OoResLF" || k == "OoRes_OoL_F" { return "if (" + name + ".ok) { oo_flist_release(" + name + ".val); } else { oo_str_release(" + name + ".err); } "; }
    let kn: Int = bytes_len(k); if kn >= 4 && str_slice(k, 0, 4) == "OoL_" { return "oo_release_" + k + "(" + name + "); "; } if kn >= 6 && (str_slice(k, 0, 6) == "OoOpt_" || str_slice(k, 0, 6) == "OoRes_") { return "oo_release_" + k + "(" + name + "); "; } if kn >= 7 && (str_slice(k, 0, 7) == "OoRes2_" || str_slice(k, 0, 7) == "OoLLLL_") { return "oo_release_" + k + "(" + name + "); "; }
    if kn >= 6 && str_slice(k, 0, 6) == "OoLLL_" { return "oo_lll_" + str_slice(k, 6, kn) + "_release(" + name + "); "; } if kn >= 5 && (str_slice(k, 0, 5) == "OoLL_" || str_slice(k, 0, 5) == "LLLL_") { return "oo_release_" + k + "(" + name + "); "; } if kn >= 4 && str_slice(k, 0, 4) == "LLL_" { return "oo_lll_" + str_slice(k, 4, kn) + "_release(" + name + "); "; } if kn >= 3 && str_slice(k, 0, 3) == "LL_" { return "oo_ll_" + str_slice(k, 3, kn) + "_release(" + name + "); "; }
    if kn > 1 && byte_at(k, 0) >= 65 && byte_at(k, 0) <= 90 { return "oo_release_" + k + "(" + name + "); "; } return "";
}
pub fn c_arc_kind_retain_sym(k: String, name: String) -> String {
    if k == "T" || k == "OoStr" { return "oo_str_retain(" + name + "); "; } if k == "S" || k == "OoSList" || k == "OoL_S" { return "oo_slist_retain(" + name + "); "; } if k == "LF" || k == "OoFList" || k == "OoL_F" { return "oo_flist_retain(" + name + "); "; }
    if k == "I" || k == "F" || k == "B" || k == "V" || k == "long long" || k == "double" || k == "int" { return ""; }
    if k == "R" || k == "OoResS" || k == "OoRes_S" { return "if (" + name + ".ok) { oo_str_retain(" + name + ".val); } "; } if k == "RI" || k == "OoResI" || k == "OoRes_I" || k == "OoResV" || k == "RB" || k == "OoResB" || k == "OoRes_B" || k == "RF" || k == "OoResF" || k == "OoRes_F" { return "if (!" + name + ".ok) { oo_str_retain(" + name + ".err); } "; }
    if k == "RLI" || k == "OoResLI" || k == "OoRes_OoL_I" { return "if (" + name + ".ok) { oo_ilist_retain(" + name + ".val); } else { oo_str_retain(" + name + ".err); } "; } if k == "RLS" || k == "OoResLS" || k == "OoRes_OoL_S" { return "if (" + name + ".ok) { oo_slist_retain(" + name + ".val); } else { oo_str_retain(" + name + ".err); } "; } if k == "RLF" || k == "OoResLF" || k == "OoRes_OoL_F" { return "if (" + name + ".ok) { oo_flist_retain(" + name + ".val); } else { oo_str_retain(" + name + ".err); } "; }
    let kn: Int = bytes_len(k); if kn >= 4 && (str_slice(k, 0, 4) == "OoL_" || str_slice(k, 0, 4) == "LLL_") { return "oo_retain_" + k + "(" + name + "); "; } if kn >= 6 && (str_slice(k, 0, 6) == "OoOpt_" || str_slice(k, 0, 6) == "OoRes_") { return "oo_retain_" + k + "(" + name + "); "; } if kn >= 7 && (str_slice(k, 0, 7) == "OoRes2_" || str_slice(k, 0, 7) == "OoLLLL_") { return "oo_retain_" + k + "(" + name + "); "; }
    if kn >= 6 && str_slice(k, 0, 6) == "OoLLL_" { return "oo_lll_" + str_slice(k, 6, kn) + "_retain(" + name + "); "; } if kn >= 5 && (str_slice(k, 0, 5) == "OoLL_" || str_slice(k, 0, 5) == "LLLL_") { return "oo_retain_" + k + "(" + name + "); "; } if kn >= 3 && str_slice(k, 0, 3) == "LL_" { return "oo_ll_" + str_slice(k, 3, kn) + "_retain(" + name + "); "; }
    if kn > 1 && byte_at(k, 0) >= 65 && byte_at(k, 0) <= 90 { return "oo_retain_" + k + "(" + name + "); "; } return "";
}
