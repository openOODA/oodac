// # Known builtin and keyword names
// Logline: Returns true when a free name is a product builtin, sealed helper, residual-forbidden name, or a keyword or type lexed as IDENT.
// Setup: typecheck_undefined_vars_ext in tc_names.oo calls this; is_sealed_gpu, is_sealed_alloc, is_sealed_ffi, and is_residual_forbidden are in scope.
// Beats:
//   1. Return true for print, assert, list, string, file, env, time, alloc, crypto, net, bytes, math, process, and concurrency names.
//   2. Return true for sealed GPU, alloc, and FFI operations, residual-forbidden names, control keywords, types, caps, and contract words.
//   3. Return false when the name is none of those.

import "tc_names_ext.oo";
import "check_cap_util.oo";
import "check_residual.oo";

fn is_known_data(name: String) -> Bool {
    if name == "println" || name == "print" || name == "eprintln" || name == "oo_print_str" { return true; }
    if name == "assert_eq" || name == "assert_ne" || name == "assert" || name == "list_new" { return true; }
    if name == "list_push" || name == "oo_slist_new" || name == "oo_slist_push" || name == "oo_slist_get" { return true; }
    if name == "oo_ilist_new" || name == "oo_ilist_push" || name == "oo_ilist_get" || name == "oo_flist_new" { return true; }
    if name == "oo_flist_push" || name == "oo_flist_get" || name == "list_get" || name == "list_set" { return true; }
    if name == "list_len" || name == "list_slice" || name == "list_new_int" || name == "list_push_int" { return true; }
    if name == "list_get_int" || name == "chars_len" || name == "char_at" || name == "str_slice" { return true; }
    if name == "char_is_digit" || name == "char_is_alpha" || name == "char_is_space" || name == "str_starts_with" { return true; }
    if name == "str_ends_with" || name == "str_index_of" || name == "str_contains" || name == "str_repeat" { return true; }
    if name == "str_to_uppercase" || name == "str_to_lowercase" || name == "to_lowercase" || name == "to_uppercase" { return true; }
    if name == "trim" || name == "str_split" || name == "str_trim" || name == "to_string" { return true; }
    if name == "len" || name == "ord" || name == "bit_xor" || name == "index_get" { return true; }
    if name == "byte_at" || name == "str_byte_at" || name == "oo_str_byte_at" || name == "bytes_len" { return true; }
    if name == "byte_slice" || name == "bytes_eq" || name == "bytes_from_str" || name == "bytes_concat" { return true; }
    if name == "bytes_new" || name == "bytes_push" || name == "bytes_get" || name == "bytes_to_str" { return true; }
    if name == "limb_add" || name == "limb_sub" || name == "limb_mul" || name == "limb_div" { return true; }
    if name == "limb_cmp" || name == "oo_limb_add" || name == "oo_limb_sub" || name == "oo_limb_mul" { return true; }
    if name == "oo_limb_div" || name == "oo_limb_cmp" || name == "sin" || name == "cos" { return true; }
    if name == "ln" || name == "exp" || name == "sqrt" || name == "pow" { return true; }
    return false;
}

fn is_known_io_sys(name: String) -> Bool {
    if is_sealed_gpu(name) || is_sealed_alloc(name) || is_sealed_ffi(name) || is_residual_forbidden(name) { return true; }
    if name == "read_file" || name == "write_file" || name == "file_append_sync" || name == "path_exists" { return true; }
    if name == "file_size" || name == "fetch" || name == "env_get" || name == "env_set" { return true; }
    if name == "setenv" || name == "unsetenv" || name == "oo_env_get" || name == "sys_exec" { return true; }
    if name == "process_exec" || name == "sys_exec_wait" || name == "oo_sys_exec" || name == "oo_sys_exec_wait" { return true; }
    if name == "now_ms" || name == "monotonic_us" || name == "proc_mem_read" || name == "oo_proc_mem_read" { return true; }
    if name == "sleep_ms" || name == "random" || name == "alloc_bytes" || name == "free_bytes" { return true; }
    if name == "malloc" || name == "free" || name == "realloc" || name == "process_exit" { return true; }
    if name == "chs_build" || name == "heap_alloc_test" || name == "oo_alloc" || name == "oo_free" { return true; }
    if name == "oo_write_int" || name == "oo_read_int" || name == "sys_spawn" || name == "sys_wait" { return true; }
    if name == "sys_kill" || name == "oo_sys_spawn" || name == "oo_sys_wait" || name == "oo_sys_kill" { return true; }
    if name == "sys_epoll_create" || name == "sys_inotify_init" || name == "sys_prctl" || name == "oo_sys_epoll_create" { return true; }
    if name == "oo_sys_inotify_init" || name == "oo_sys_prctl" || name == "oo_fs_is_dir" || name == "oo_sys_args" { return true; }
    if name == "oo_str_eq" || name == "match_rparen" || name == "oo_file_size" || name == "oo_read_file" { return true; }
    if name == "oo_write_file" || name == "oo_path_exists" || name == "oo_emit_tmp_reset" || name == "oo_emit_tmp_enter" { return true; }
    if name == "oo_emit_tmp_leave" || name == "oo_emit_tmp_release_print" || name == "oo_emit_tmp_own" || name == "oo_emit_tmp_release_all_print" { return true; }
    if name == "oo_emit_tmp_bind" || name == "oo_fs_read_dir" || name == "oo_fs_remove_file" || name == "oo_fs_rmdir" { return true; }
    if name == "oo_fs_mkdir" || name == "oo_fs_hardlink" || name == "oo_fs_symlink" { return true; }
    return false;
}

fn is_known_net_crypto(name: String) -> Bool {
    if name == "crypto_sha256_internal" || name == "crypto_hmac_sha256_internal" || name == "crypto_sha512_internal" || name == "crypto_md5_internal" { return true; }
    if name == "crypto_sha1_internal" || name == "crypto_aes_encrypt_internal" || name == "crypto_sha3_256_internal" || name == "crypto_aes_gcm_seal_internal" { return true; }
    if name == "crypto_aes_gcm_open_internal" || name == "crypto_chacha20poly1305_seal_internal" || name == "crypto_chacha20poly1305_open_internal" || name == "crypto_mlkem768_keygen_internal" { return true; }
    if name == "crypto_mlkem768_encaps_internal" || name == "crypto_mlkem768_decaps_internal" || name == "crypto_mldsa65_keygen_internal" || name == "crypto_mldsa65_sign_internal" { return true; }
    if name == "crypto_mldsa65_verify_internal" || name == "tcp_bind" || name == "tcp_connect" || name == "tcp_accept" { return true; }
    if name == "bind_udp" || name == "tls_connect" || name == "tcp_write" || name == "tcp_read" { return true; }
    if name == "udp_recv" || name == "udp_send" || name == "tcp_close" || name == "unix_bind" { return true; }
    if name == "unix_accept" || name == "unix_connect" || name == "unix_read" || name == "unix_write" { return true; }
    if name == "unix_close" || name == "unix_read_timeout" || name == "unix_unlink" || name == "sock_raw" { return true; }
    if name == "raw_socket" || name == "mutex_lock" || name == "mutex_unlock" || name == "thread_spawn" { return true; }
    if name == "thread_join" || name == "gpu_launch" || name == "channel_new" || name == "channel_send" { return true; }
    if name == "channel_recv" || name == "actor_spawn" || name == "actor_send" || name == "actor_recv" { return true; }
    if name == "json_parse_internal" || name == "json_stringify_internal" || name == "python_embed_internal" || name == "oo_rlimit_set_mem_mb" { return true; }
    if name == "oo_rlimit_set_nofile" || name == "oo_rlimit_set_cpu_sec" || name == "sys_path_is_dir" || name == "oo_sys_path_is_dir" { return true; }
    if name == "oo_landlock_is_available" || name == "oo_landlock_restrict" || name == "landlock_is_available" || name == "landlock_restrict" { return true; }
    if name == "oo_dns_resolve" || name == "oo_dns_resolve_ipv4" || name == "oo_arena_create" || name == "arena_create" { return true; }
    if name == "oo_arena_alloc" || name == "arena_alloc" || name == "oo_arena_reset" || name == "arena_reset" { return true; }
    if name == "oo_arena_destroy" || name == "arena_destroy" || name == "oo_actor_restart" || name == "actor_restart" { return true; }
    if name == "soa_layout" || name == "dod_layout" || name == "checkpoint" || name == "rollback" { return true; }
    if name == "otp_supervise" || name == "cap_rpc_send" || name == "cap_rpc_recv" || name == "oo_read_stdin" { return true; }
    if name == "oo_read_stdin_chunk" || name == "oo_file_stamp" || name == "cap_attenuate" || name == "cap_attenuate_ok" { return true; }
    if name == "oo_cap_attenuate" || name == "oo_cap_attenuate_ok" || name == "oo_cap_kernel_seal" || name == "cap_kernel_seal" { return true; }
    if name == "oo_enclave_enter" || name == "enclave_enter" || name == "hot_reload" || name == "oo_hot_reload" { return true; }
    if name == "macro_expand" || name == "ast_macro" || name == "meta_epoch" || name == "meta_mix" { return true; }
    if name == "meta_is_path_a" || name == "meta_decoy_touch" || name == "import_c" || name == "ffi_gen" { return true; }
    if name == "lto_xlang_link" || name == "oo_import_c" || name == "oo_ffi_gen" || name == "oo_lto_xlang_link" { return true; }
    if name == "oo_tui_enable_raw" || name == "oo_tui_disable_raw" || name == "oo_tui_get_size" || name == "oo_tui_alt_screen_enter" { return true; }
    if name == "oo_tui_alt_screen_leave" || name == "oo_tui_show_cursor" || name == "oo_tui_clear" || name == "oo_tui_write" { return true; }
    if name == "oo_tui_read_byte" || name == "oo_tui_read_byte_timeout" || name == "oo_tui_signal_winch_install" || name == "oo_tui_signal_winch_poll" { return true; }
    return false;
}

fn is_known_lang_types(name: String) -> Bool {
    if name == "break" || name == "continue" || name == "return" || name == "for" { return true; }
    if name == "in" || name == "else" || name == "match" || name == "if" { return true; }
    if name == "while" || name == "loop" || name == "type" || name == "mut" { return true; }
    if name == "let" || name == "fn" || name == "pub" || name == "struct" { return true; }
    if name == "impl" || name == "trait" || name == "dyn" || name == "use" { return true; }
    if name == "import" || name == "as" || name == "where" || name == "verify" { return true; }
    if name == "Int" || name == "String" || name == "Bool" || name == "Float" { return true; }
    if name == "Void" || name == "WasmEnv" || name == "TyF32x8" || name == "TyF64x4" { return true; }
    if name == "u8" || name == "i8" || name == "u16" || name == "i16" { return true; }
    if name == "u32" || name == "i32" || name == "u64" || name == "i64" { return true; }
    if name == "f32" || name == "f64" || name == "F32" || name == "F64" { return true; }
    if name == "Vec8f" || name == "Vec4d" || name == "NetCap" || name == "FsCap" { return true; }
    if name == "GpuCap" || name == "ThreadCap" || name == "EnvCap" || name == "SysCap" { return true; }
    if name == "TimeCap" || name == "RandCap" || name == "AllocCap" || name == "ArenaCap" { return true; }
    if name == "ProcessCap" || name == "FsReadCap" || name == "FsWriteCap" || name == "CompilerReadCap" { return true; }
    if name == "FfiCap" || name == "SignCap" || name == "TcpCap" || name == "UdpCap" { return true; }
    if name == "AudioCap" || name == "CameraCap" || name == "FrameCap" || name == "HidCap" { return true; }
    if name == "UsbCap" || name == "WindowCap" || name == "BindCap" || name == "MetricsCap" { return true; }
    if name == "Option" || name == "Result" || name == "List" || name == "list" { return true; }
    if name == "Box" || name == "TyBox" || name == "TyStr" || name == "TyList" { return true; }
    if name == "TyOption" || name == "TyResult" || name == "Ok" || name == "Err" { return true; }
    if name == "Some" || name == "None" || name == "true" || name == "false" { return true; }
    if name == "result" || name == "old" || name == "self" || name == "spec" { return true; }
    return false;
}

fn is_known_simd(name: String) -> Bool {
    if name == "f32x8" || name == "f32x8_new" || name == "f32x8_zero" || name == "f32x8_splat" { return true; }
    if name == "f32x8_get_lane" || name == "f32x8_insert_lane" || name == "f32x8_add" || name == "f32x8_sub" { return true; }
    if name == "f32x8_mul" || name == "f32x8_div" || name == "f32x8_min" || name == "f32x8_max" { return true; }
    if name == "f32x8_scale" || name == "f32x8_fma" || name == "f32x8_reduce_sum" || name == "f32x8_dot" { return true; }
    if name == "f32x8_reverse" || name == "f32x8_shuffle" || name == "f32x8_interleave_lo" || name == "f32x8_interleave_hi" { return true; }
    if name == "f32x8_blend" || name == "f32x8_permute" || name == "f32x8_load_aligned" || name == "f32x8_store_aligned" { return true; }
    if name == "f64x4" || name == "f64x4_new" || name == "f64x4_zero" || name == "f64x4_splat" { return true; }
    if name == "f64x4_get_lane" || name == "f64x4_insert_lane" || name == "f64x4_add" || name == "f64x4_sub" { return true; }
    if name == "f64x4_mul" || name == "f64x4_div" || name == "f64x4_min" || name == "f64x4_max" { return true; }
    if name == "f64x4_scale" || name == "f64x4_fma" || name == "f64x4_reduce_sum" || name == "f64x4_dot" { return true; }
    if name == "f64x4_reverse" || name == "f64x4_shuffle" || name == "f64x4_interleave_lo" || name == "f64x4_interleave_hi" { return true; }
    if name == "f64x4_blend" || name == "f64x4_permute" || name == "f64x4_load_aligned" || name == "f64x4_store_aligned" { return true; }
    return false;
}

pub fn is_known_name(name: String) -> Bool {
    if is_known_ext_name(name) { return true; }
    if is_known_data(name) { return true; }
    if is_known_io_sys(name) { return true; }
    if is_known_net_crypto(name) { return true; }
    if is_known_lang_types(name) { return true; }
    if is_known_simd(name) { return true; }
    return false;
}
