// # Borrow and move check
//
// Logline: Fail-closed use-after-move and conflicting & / &mut on the check path.
//
// Setup: Token rows are kind, line, col, text. Int/Float/Bool/caps copy. String/List/Option/Result/Box move.
//
// Beats:
//   1. Classify managed types by exact names, not prefixes.
//   2. let y = x moves a managed x; a later IDENT x is ERR move.
//   3. Two &mut of one root, or & plus &mut, is ERR borrow. Two shared & are OK.

import "lex/token_fmt.oo";
import "lex/token_parse_int.oo";

fn bk(toks: List[String], i: Int) -> String { if i >= list_len(toks) { return ""; } return field_at(list_get(toks, i), 0); }
fn bt(toks: List[String], i: Int) -> String { if i >= list_len(toks) { return ""; } return field_at(list_get(toks, i), 3); }
fn bag_has(bag: String, name: String) -> Bool { if name == "" { return false; } return str_index_of(bag, "\t" + name + "\t") >= 0; }
fn bag_add(bag: String, name: String) -> String { if name == "" || bag_has(bag, name) { return bag; } return bag + name + "\t"; }

fn bag_union(a: String, b: String) -> String {
    let n: Int = chars_len(b);
    let mut u: String = a;
    let mut i: Int = 0;
    while i < n {
        if char_at(b, i) == "\t" {
            let start: Int = i + 1;
            let mut j: Int = start;
            while j < n && char_at(b, j) != "\t" { j = j + 1; }
            if j > start { u = bag_add(u, str_slice(b, start, j)); }
            i = j;
        } else { i = i + 1; }
    }
    return u;
}

pub fn borrow_is_managed(ty: String) -> Bool {
    return ty == "String" || ty == "TyStr" || ty == "OoStr" || ty == "List" || ty == "TyList" || ty == "OoSList" || ty == "OoIList" || ty == "OoFList" || ty == "Option" || ty == "TyOption" || ty == "Result" || ty == "TyResult" || ty == "Box" || ty == "TyBox";
}

pub fn borrow_is_ctor(name: String) -> Bool {
    return name == "None" || name == "Some" || name == "Ok" || name == "Err" || name == "True" || name == "False" || name == "true" || name == "false";
}

fn borrow_skip_type(toks: List[String], i0: Int, n: Int) -> Int {
    let mut i: Int = i0;
    if i < n && bk(toks, i) == "AMP" { i = i + 1; } if i < n && bk(toks, i) == "KW_MUT" { i = i + 1; } if i < n && bk(toks, i) == "IDENT" { i = i + 1; }
    while i < n && (bk(toks, i) == "LBRACKET" || bk(toks, i) == "LT") {
        i = i + 1;
        while i < n && bk(toks, i) != "RBRACKET" && bk(toks, i) != "GT" && bk(toks, i) != "SEMI" { i = i + 1; }
        if i < n { i = i + 1; }
    }
    return i;
}

fn borrow_is_copy_op(k: String) -> Bool {
    return k == "PLUS" || k == "MINUS" || k == "STAR" || k == "SLASH" || k == "PERCENT" || k == "EQEQ" || k == "NEQ" || k == "LT" || k == "GT" || k == "LTE" || k == "GTE" || k == "AMPAMP" || k == "PIPEPIPE";
}

fn borrow_die_move(name: String, line: String) { println("ERR\tmove\tuse after move " + name + " at " + line); process_exit(1); }
fn borrow_die_alias(name: String, line: String) { println("ERR\tborrow\tmut alias " + name + " at " + line); process_exit(1); }

fn borrow_skip_braces(toks: List[String], pos0: Int) -> Int {
    let n: Int = list_len(toks);
    let mut pos: Int = pos0;
    let mut d: Int = 0;
    while pos < n {
        let k: String = bk(toks, pos);
        if k == "LBRACE" { d = d + 1; }
        if k == "RBRACE" { d = d - 1; if d == 0 { return pos + 1; } }
        pos = pos + 1;
    }
    return n;
}

fn borrow_find_lbrace(toks: List[String], i0: Int, hi: Int) -> Int {
    let mut j: Int = i0;
    let mut d: Int = 0;
    while j < hi {
        let k: String = bk(toks, j);
        if k == "LPAREN" { d = d + 1; }
        if k == "RPAREN" && d > 0 { d = d - 1; }
        if k == "LBRACE" && d == 0 { return j; }
        j = j + 1;
    }
    return hi;
}

fn borrow_walk_let(toks: List[String], i0: Int, n: Int, moved: String, shr: String, mutb: String, owned: String) -> List[String] {
    let mut m: String = moved; let mut s: String = shr; let mut mb: String = mutb; let mut o: String = owned;
    let mut p: Int = i0 + 1;
    if p < n && bk(toks, p) == "KW_MUT" { p = p + 1; }
    if p >= n || bk(toks, p) != "IDENT" {
        let mut r: List[String] = list_new();
        r = list_push(r, p.to_string()); r = list_push(r, m); r = list_push(r, s); r = list_push(r, mb); r = list_push(r, o);
        return r;
    }
    let vname: String = bt(toks, p);
    let line: String = field_at(list_get(toks, p), 1);
    p = p + 1;
    let mut ty: String = "";
    if p < n && bk(toks, p) == "COLON" {
        p = p + 1; let mut tp: Int = p;
        if tp < n && bk(toks, tp) == "AMP" { tp = tp + 1; }
        if tp < n && bk(toks, tp) == "KW_MUT" { tp = tp + 1; }
        if tp < n && bk(toks, tp) == "IDENT" { ty = bt(toks, tp); }
        p = borrow_skip_type(toks, p, n);
    }
    if p < n && bk(toks, p) == "EQ" {
        p = p + 1;
        if p < n && bk(toks, p) == "AMP" {
            p = p + 1;
            let mut is_mut: Bool = false;
            if p < n && bk(toks, p) == "KW_MUT" { is_mut = true; p = p + 1; }
            if p < n && bk(toks, p) == "IDENT" {
                let root: String = bt(toks, p);
                if bag_has(m, root) { borrow_die_move(root, line); }
                if is_mut {
                    if bag_has(s, root) || bag_has(mb, root) { borrow_die_alias(root, line); }
                    mb = bag_add(mb, root);
                } else {
                    if bag_has(mb, root) { borrow_die_alias(root, line); }
                    s = bag_add(s, root);
                }
                p = p + 1;
            }
        } else if p < n && bk(toks, p) == "IDENT" {
            let src: String = bt(toks, p);
            let nxt: String = bk(toks, p + 1);
            if !borrow_is_ctor(src) && bag_has(m, src) { borrow_die_move(src, line); }
            if nxt != "LPAREN" && nxt != "DOT" && nxt != "COLON" && !borrow_is_copy_op(nxt) {
                if !borrow_is_ctor(src) && (bag_has(o, src) || borrow_is_managed(ty)) {
                    m = bag_add(m, src);
                    o = bag_add(o, vname);
                }
            }
            p = p + 1;
        } else if p < n && bk(toks, p) == "STRING" {
            o = bag_add(o, vname);
            p = p + 1;
        }
    }
    if borrow_is_managed(ty) { o = bag_add(o, vname); }
    while p < n && bk(toks, p) != "SEMI" { p = p + 1; }
    if p < n { p = p + 1; }
    let mut out: List[String] = list_new();
    out = list_push(out, p.to_string()); out = list_push(out, m); out = list_push(out, s); out = list_push(out, mb); out = list_push(out, o);
    return out;
}

fn borrow_walk_if(toks: List[String], i: Int, hi: Int, moved: String, shr: String, mutb: String, owned: String) -> List[String] {
    let lb: Int = borrow_find_lbrace(toks, i, hi);
    let mut ci: Int = i + 1;
    while ci < lb {
        if bk(toks, ci) == "IDENT" && !borrow_is_ctor(bt(toks, ci)) && bag_has(moved, bt(toks, ci)) {
            borrow_die_move(bt(toks, ci), field_at(list_get(toks, ci), 1));
        }
        ci = ci + 1;
    }
    let then_end: Int = borrow_skip_braces(toks, lb);
    let then_r: List[String] = borrow_walk_span(toks, lb + 1, then_end - 1, moved, shr, mutb, owned);
    let tm: String = list_get(then_r, 0);
    let td: String = list_get(then_r, 4);
    let mut em: String = ""; let mut ed: String = "0"; let mut nxt: Int = then_end;
    let mut has_else: Bool = false;
    if then_end < hi && bk(toks, then_end) == "KW_ELSE" {
        has_else = true;
        if then_end + 1 < hi && bk(toks, then_end + 1) == "KW_IF" {
            let er: List[String] = borrow_walk_if(toks, then_end + 1, hi, moved, shr, mutb, owned);
            em = list_get(er, 0); nxt = parse_int(list_get(er, 1)); ed = list_get(er, 2);
        } else {
            let elb: Int = borrow_find_lbrace(toks, then_end, hi);
            let else_end: Int = borrow_skip_braces(toks, elb);
            let er: List[String] = borrow_walk_span(toks, elb + 1, else_end - 1, moved, shr, mutb, owned);
            em = list_get(er, 0); ed = list_get(er, 4); nxt = else_end;
        }
    }
    let mut out_m: String = "";
    if !has_else {
        if td == "1" { out_m = moved; } else { out_m = bag_union(tm, moved); }
    } else if td == "1" && ed == "1" { } else if td == "1" { out_m = em; } else if ed == "1" { out_m = tm; } else { out_m = bag_union(tm, em); }
    let mut r: List[String] = list_new();
    r = list_push(r, out_m); r = list_push(r, nxt.to_string()); r = list_push(r, if td == "1" && ed == "1" { "1" } else { "0" });
    return r;
}

fn borrow_walk_span(toks: List[String], lo: Int, hi: Int, moved0: String, shr0: String, mutb0: String, owned0: String) -> List[String] {
    let mut moved: String = moved0; let mut shr: String = shr0; let mut mutb: String = mutb0; let mut owned: String = owned0; let mut div: String = "0";
    let mut shr_stk: List[String] = list_new(); let mut mutb_stk: List[String] = list_new();
    let mut i: Int = lo;
    while i < hi {
        let k: String = bk(toks, i);
        if k == "LBRACE" {
            shr_stk = list_push(shr_stk, shr); mutb_stk = list_push(mutb_stk, mutb); i = i + 1;
        } else if k == "RBRACE" {
            let top: Int = list_len(shr_stk) - 1;
            if top >= 0 {
                shr = list_get(shr_stk, top); mutb = list_get(mutb_stk, top);
                shr_stk = list_slice(shr_stk, 0, top); mutb_stk = list_slice(mutb_stk, 0, top);
            }
            i = i + 1;
        } else if k == "KW_IF" {
            let ir: List[String] = borrow_walk_if(toks, i, hi, moved, shr, mutb, owned);
            moved = list_get(ir, 0); i = parse_int(list_get(ir, 1));
            if list_get(ir, 2) == "1" { div = "1"; }
        } else if k == "KW_WHILE" || k == "KW_FOR" {
            let lb: Int = borrow_find_lbrace(toks, i, hi);
            let mut ci: Int = i + 1;
            while ci < lb {
                if bk(toks, ci) == "IDENT" && !borrow_is_ctor(bt(toks, ci)) && bag_has(moved, bt(toks, ci)) { borrow_die_move(bt(toks, ci), field_at(list_get(toks, ci), 1)); }
                ci = ci + 1;
            }
            let lend: Int = borrow_skip_braces(toks, lb);
            let lr: List[String] = borrow_walk_span(toks, lb + 1, lend - 1, moved, shr, mutb, owned);
            moved = list_get(lr, 0); i = lend;
        } else if k == "KW_LET" {
            let st: List[String] = borrow_walk_let(toks, i, hi, moved, shr, mutb, owned);
            i = parse_int(list_get(st, 0));
            moved = list_get(st, 1); shr = list_get(st, 2); mutb = list_get(st, 3); owned = list_get(st, 4);
        } else if k == "KW_RETURN" {
            div = "1"; i = i + 1;
        } else if k == "IDENT" {
            let name: String = bt(toks, i);
            if name == "process_exit" { div = "1"; }
            let prev: String = bk(toks, i - 1);
            if prev != "DOT" && prev != "COLON" && prev != "KW_FN" && prev != "KW_LET" && prev != "KW_MUT" && prev != "AMP" {
                if !borrow_is_ctor(name) && bag_has(moved, name) { borrow_die_move(name, field_at(list_get(toks, i), 1)); }
            }
            i = i + 1;
        } else { i = i + 1; }
    }
    let mut out: List[String] = list_new();
    out = list_push(out, moved); out = list_push(out, shr); out = list_push(out, mutb); out = list_push(out, owned); out = list_push(out, div);
    return out;
}

fn borrow_walk_fn(toks: List[String], i0: Int, n: Int) -> Int {
    let mut i: Int = i0;
    while i < n && (bk(toks, i) == "KW_PUB" || bk(toks, i) == "KW_EXPORT") { i = i + 1; }
    if i < n && bk(toks, i) == "KW_FN" { i = i + 1; }
    if i < n && bk(toks, i) == "IDENT" { i = i + 1; }
    while i < n && bk(toks, i) != "LBRACE" && bk(toks, i) != "EOF" { i = i + 1; }
    if i >= n || bk(toks, i) != "LBRACE" { return i + 1; }
    let end: Int = borrow_skip_braces(toks, i);
    let _: List[String] = borrow_walk_span(toks, i + 1, end - 1, "\t", "\t", "\t", "\t");
    return end;
}

pub fn check_borrow(toks: List[String]) {
    let n: Int = list_len(toks);
    let mut i: Int = 0;
    while i < n {
        let mut mi: Int = i;
        while mi < n && (bk(toks, mi) == "KW_PUB" || bk(toks, mi) == "KW_EXPORT") { mi = mi + 1; }
        if mi < n && bk(toks, mi) == "KW_FN" { i = borrow_walk_fn(toks, i, n); } else { i = i + 1; }
    }
}
