// # Check call arity (import table)
//
// Logline: String-level fn-header scan for cross-module arity and return type checks.
//
// Setup: Produces "\tfname=argc:RetType\t" entries shaped for arity_get and check_dup_proto.
//
// Beats:
//   1. Skip line comments and string literals via scan_skip_trivia.
//   2. Count IDENT-before-COLON params at paren depth 1, brace-guarded.
//   3. Extract return type following closing paren and ARROW.
//   4. Enforce arity and return-type identity across duplicate prototypes.

fn dup_proto_num(table: String, p: Int) -> Int {
    let n: Int = chars_len(table);
    let mut num: Int = 0;
    let mut q: Int = p;
    let mut cont: Bool = true;
    while cont {
        if q >= n {
            cont = false;
        } else {
            let c: String = char_at(table, q);
            if char_is_digit(c) {
                if c == "0" { num = num * 10 + 0; }
                if c == "1" { num = num * 10 + 1; }
                if c == "2" { num = num * 10 + 2; }
                if c == "3" { num = num * 10 + 3; }
                if c == "4" { num = num * 10 + 4; }
                if c == "5" { num = num * 10 + 5; }
                if c == "6" { num = num * 10 + 6; }
                if c == "7" { num = num * 10 + 7; }
                if c == "8" { num = num * 10 + 8; }
                if c == "9" { num = num * 10 + 9; }
                q = q + 1;
            } else {
                cont = false;
            }
        }
    }
    return num;
}

fn check_dup_proto_entry(names: List[String], arities: List[Int], ret_types: List[String], name: String, argc: Int, ret_ty: String) {
    let mut k: Int = 0;
    let count: Int = list_len(names);
    while k < count {
        if list_get(names, k) == name {
            let old: Int = list_get(arities, k);
            if old != argc {
                println("ERR\tcheck\tdup proto '" + name + "': arity " + old.to_string() + " vs " + argc.to_string());
                process_exit(1);
            }
            let old_ret: String = list_get(ret_types, k);
            if old_ret != "" && ret_ty != "" && old_ret != ret_ty {
                println("ERR\tcheck\tdup proto '" + name + "': return type " + old_ret + " vs " + ret_ty);
                process_exit(1);
            }
            return;
        }
        k = k + 1;
    }
}

pub fn check_dup_proto(table: String) {
    let mut names: List[String] = list_new();
    let mut arities: List[Int] = list_new();
    let mut ret_types: List[String] = list_new();
    let n: Int = chars_len(table);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(table, i);
        if c == "\t" {
            i = i + 1;
        } else {
            let mut name: String = "";
            while i < n && char_at(table, i) != "=" && char_at(table, i) != "\t" {
                name = name + char_at(table, i);
                i = i + 1;
            }
            if i < n && char_at(table, i) == "=" {
                i = i + 1;
                let argc: Int = dup_proto_num(table, i);
                while i < n && char_is_digit(char_at(table, i)) { i = i + 1; }
                let mut ret_ty: String = "";
                if i < n && char_at(table, i) == ":" {
                    i = i + 1;
                    while i < n && char_at(table, i) != "\t" {
                        ret_ty = ret_ty + char_at(table, i);
                        i = i + 1;
                    }
                }
                while i < n && char_at(table, i) != "\t" { i = i + 1; }
                if name != "" {
                    check_dup_proto_entry(names, arities, ret_types, name, argc, ret_ty);
                    names = list_push(names, name);
                    arities = list_push(arities, argc);
                    ret_types = list_push(ret_types, ret_ty);
                }
            }
        }
    }
}

pub fn scan_fn_is_pub(src: String, fn_pos: Int, n: Int) -> Bool {
    if fn_pos > 0 {
        let pc: Int = byte_at(src, fn_pos - 1);
        if (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 { return false; }
    }
    if fn_pos + 2 < n {
        let nc: Int = byte_at(src, fn_pos + 2);
        if (nc >= 97 && nc <= 122) || (nc >= 65 && nc <= 90) || (nc >= 48 && nc <= 57) || nc == 95 { return false; }
    }
    let mut bp: Int = fn_pos - 1;
    while bp >= 0 && (byte_at(src, bp) == 32 || byte_at(src, bp) == 9 || byte_at(src, bp) == 10 || byte_at(src, bp) == 13) {
        bp = bp - 1;
    }
    if bp >= 2 && byte_at(src, bp - 2) == 112 && byte_at(src, bp - 1) == 117 && byte_at(src, bp) == 98 {
        if bp >= 3 {
            let bpc: Int = byte_at(src, bp - 3);
            if (bpc >= 97 && bpc <= 122) || (bpc >= 65 && bpc <= 90) || (bpc >= 48 && bpc <= 57) || bpc == 95 { return false; }
        }
        return true;
    }
    if bp >= 5 && byte_at(src, bp - 5) == 101 && byte_at(src, bp - 4) == 120 && byte_at(src, bp - 3) == 112 && byte_at(src, bp - 2) == 111 && byte_at(src, bp - 1) == 114 && byte_at(src, bp) == 116 {
        if bp >= 6 {
            let bpc2: Int = byte_at(src, bp - 6);
            if (bpc2 >= 97 && bpc2 <= 122) || (bpc2 >= 65 && bpc2 <= 90) || (bpc2 >= 48 && bpc2 <= 57) || bpc2 == 95 { return false; }
        }
        return true;
    }
    return false;
}

fn scan_skip_trivia(src: String, i: Int, n: Int) -> Int {
    let c: Int = byte_at(src, i);
    if c == 47 {
        if i + 1 < n && byte_at(src, i + 1) == 47 {
            let mut j: Int = i + 2;
            while j < n && byte_at(src, j) != 10 { j = j + 1; }
            return j;
        }
        return i + 1;
    }
    if c == 34 {
        let mut j: Int = i + 1;
        while j < n {
            if byte_at(src, j) == 92 { j = j + 2; }
            else if byte_at(src, j) == 34 { return j + 1; }
            else { j = j + 1; }
        }
        return j;
    }
    return i + 1;
}

fn scan_fn_params(src: String, start_pos: Int, n: Int) -> List[Int] {
    let mut argc: Int = 0;
    let mut depth: Int = 1;
    let mut nest: Int = 0;
    let mut in_name: Bool = true;
    let mut j: Int = start_pos;
    let mut word: String = "";
    while j < n && depth > 0 {
        let dc: Int = byte_at(src, j);
        if dc == 123 || dc == 91 {
            word = ""; nest = nest + 1; j = j + 1;
        } else if (dc == 125 || dc == 93) && nest > 0 {
            word = ""; nest = nest - 1; j = j + 1;
        } else if dc == 47 || dc == 34 {
            word = ""; j = scan_skip_trivia(src, j, n);
        } else if dc == 40 {
            word = ""; depth = depth + 1; j = j + 1;
        } else if dc == 41 {
            word = ""; in_name = false; depth = depth - 1; j = j + 1;
        } else if dc == 44 && depth == 1 && nest == 0 {
            word = ""; in_name = true; j = j + 1;
        } else if dc == 58 && depth == 1 && nest == 0 {
            if in_name && word != "" { argc = argc + 1; }
            word = ""; in_name = false; j = j + 1;
        } else if (dc >= 97 && dc <= 122) || (dc >= 65 && dc <= 90) || (dc >= 48 && dc <= 57) || dc == 95 {
            word = word + "a"; j = j + 1;
        } else {
            if dc != 38 && dc != 42 { word = ""; }
            j = j + 1;
        }
    }
    let mut out: List[Int] = list_push(list_new(), argc);
    return list_push(out, j);
}

fn scan_fn_ret_ty(src: String, start_pos: Int, n: Int) -> String {
    let mut i: Int = start_pos;
    while i < n && (byte_at(src, i) == 32 || byte_at(src, i) == 9 || byte_at(src, i) == 10 || byte_at(src, i) == 13) { i = i + 1; }
    if i + 1 < n && byte_at(src, i) == 45 && byte_at(src, i + 1) == 62 {
        i = i + 2;
        while i < n && (byte_at(src, i) == 32 || byte_at(src, i) == 9 || byte_at(src, i) == 10 || byte_at(src, i) == 13) { i = i + 1; }
        let mut ret_ty: String = "";
        let mut depth: Int = 0;
        while i < n {
            let c: Int = byte_at(src, i);
            if c == 91 { depth = depth + 1; ret_ty = ret_ty + "["; }
            else if c == 93 { if depth > 0 { depth = depth - 1; } ret_ty = ret_ty + "]"; }
            else if depth == 0 && (c == 32 || c == 9 || c == 10 || c == 13 || c == 123 || c == 125 || c == 59 || c == 47) { break; }
            else if c != 32 && c != 9 && c != 10 && c != 13 { ret_ty = ret_ty + byte_slice(src, i, i + 1); }
            i = i + 1;
        }
        if ret_ty != "" { return ret_ty; }
    }
    return "Void";
}

pub fn scan_import_arity(src: String) -> String {
    let mut table: String = "\t";
    let n: Int = bytes_len(src);
    let mut i: Int = 0;
    while i < n {
        let c: Int = byte_at(src, i);
        if c == 47 || c == 34 {
            i = scan_skip_trivia(src, i, n);
        } else if c == 102 && i + 1 < n && byte_at(src, i + 1) == 110 {
            if !scan_fn_is_pub(src, i, n) {
                i = i + 1;
            } else {
                let mut j: Int = i + 2;
                while j < n && (byte_at(src, j) == 32 || byte_at(src, j) == 9) { j = j + 1; }
                let name_start: Int = j;
                while j < n {
                    let nc2: Int = byte_at(src, j);
                    if (nc2 >= 97 && nc2 <= 122) || (nc2 >= 65 && nc2 <= 90) || (nc2 >= 48 && nc2 <= 57) || nc2 == 95 { j = j + 1; }
                    else { break; }
                }
                let name: String = byte_slice(src, name_start, j);
                while j < n && (byte_at(src, j) == 32 || byte_at(src, j) == 9) { j = j + 1; }
                if name == "" || j >= n || byte_at(src, j) != 40 {
                    i = i + 1;
                } else {
                    let res: List[Int] = scan_fn_params(src, j + 1, n);
                    let argc: Int = list_get(res, 0);
                    let end_paren: Int = list_get(res, 1);
                    let ret_ty: String = scan_fn_ret_ty(src, end_paren, n);
                    i = end_paren;
                    table = table + name + "=" + argc.to_string() + ":" + ret_ty + "\t";
                }
            }
        } else {
            i = i + 1;
        }
    }
    return table;
}

