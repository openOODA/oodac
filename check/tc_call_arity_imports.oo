// # Check call arity (import table)
//
// Logline: String-level fn-header scan for cross-module arity checks.
//
// Setup: Produces "\tfname=argc\t" entries shaped for arity_get.
//
// Beats:
//   1. Skip line comments and string literals.
//   2. Count IDENT-before-COLON params at paren depth 1, brace-guarded.
//   3. Local table always wins; unknown names still skip.

// scan_import_arity: string-level header scan for cross-module calls.
// Returns "\tfname=argc\t" entries (same shape arity_get reads). Counts a
// param exactly like Pass 1: an IDENT followed by COLON at paren depth 1.
// Skips line comments and string literals so commented-out headers cannot
// poison the table. Local table always wins (consulted first at use sites).
//
// check_dup_proto: fail closed when one fn name carries two arities.
// The import graph concatenates TUs and the language has no overload
// semantics, so a same-name different-arity pair is a silent
// first-wins hole (arity_get reads the first entry). Same-arity dupes
// keep today's behavior (residual: first wins, no error).
fn dup_proto_num(table: String, p: Int) -> Int {
    let n: Int = chars_len(table);
    let mut num: Int = 0;
    let mut q: Int = p;
    let mut cont: Bool = true;
    while cont {
        if q >= n {
            cont = false;
        } else {
            let c: String = char_at(table, q);
            if char_is_digit(c) {
                if c == "0" { num = num * 10 + 0; }
                if c == "1" { num = num * 10 + 1; }
                if c == "2" { num = num * 10 + 2; }
                if c == "3" { num = num * 10 + 3; }
                if c == "4" { num = num * 10 + 4; }
                if c == "5" { num = num * 10 + 5; }
                if c == "6" { num = num * 10 + 6; }
                if c == "7" { num = num * 10 + 7; }
                if c == "8" { num = num * 10 + 8; }
                if c == "9" { num = num * 10 + 9; }
                q = q + 1;
            } else {
                cont = false;
            }
        }
    }
    return num;
}

fn check_dup_proto_entry(names: List[String], arities: List[Int], name: String, argc: Int) {
    let mut k: Int = 0;
    let count: Int = list_len(names);
    while k < count {
        if list_get(names, k) == name {
            let old: Int = list_get(arities, k);
            if old != argc {
                println("ERR\tcheck\tdup proto '" + name + "': arity " + old.to_string() + " vs " + argc.to_string());
                process_exit(1);
            }
            return;
        }
        k = k + 1;
    }
}

pub fn check_dup_proto(table: String) {
    let mut names: List[String] = list_new();
    let mut arities: List[Int] = list_new();
    let n: Int = chars_len(table);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(table, i);
        if c == "\t" {
            i = i + 1;
        } else {
            let mut name: String = "";
            while i < n && char_at(table, i) != "=" && char_at(table, i) != "\t" {
                name = name + char_at(table, i);
                i = i + 1;
            }
            if i < n && char_at(table, i) == "=" {
                i = i + 1;
                let argc: Int = dup_proto_num(table, i);
                while i < n && char_at(table, i) != "\t" { i = i + 1; }
                if name != "" {
                    check_dup_proto_entry(names, arities, name, argc);
                    names = list_push(names, name);
                    arities = list_push(arities, argc);
                }
            }
        }
    }
}

fn scan_fn_is_pub(src: String, fn_pos: Int) -> Bool {
    let mut bp: Int = fn_pos - 1;
    while bp >= 0 && (char_at(src, bp) == " " || char_at(src, bp) == "\t" || char_at(src, bp) == "\n" || char_at(src, bp) == "\r") {
        bp = bp - 1;
    }
    if bp >= 2 && char_at(src, bp - 2) == "p" && char_at(src, bp - 1) == "u" && char_at(src, bp) == "b" {
        if bp >= 3 {
            let bpc: String = char_at(src, bp - 3);
            if char_is_alpha(bpc) || char_is_digit(bpc) || bpc == "_" { return false; }
        }
        return true;
    }
    if bp >= 5 && char_at(src, bp - 5) == "e" && char_at(src, bp - 4) == "x" && char_at(src, bp - 3) == "p" && char_at(src, bp - 2) == "o" && char_at(src, bp - 1) == "r" && char_at(src, bp) == "t" {
        if bp >= 6 {
            let bpc2: String = char_at(src, bp - 6);
            if char_is_alpha(bpc2) || char_is_digit(bpc2) || bpc2 == "_" { return false; }
        }
        return true;
    }
    return false;
}

pub fn scan_import_arity(src: String) -> String {
    let mut table = "\t";
    let n = chars_len(src);
    let mut i = 0;
    while i < n {
        let c: String = char_at(src, i);
        if c == "/" {
            if i + 1 < n && char_at(src, i + 1) == "/" {
                i = i + 2;
                while i < n && char_at(src, i) != "\n" { i = i + 1; }
            } else {
                i = i + 1;
            }
        } else if c == "\"" {
            i = i + 1;
            while i < n {
                if char_at(src, i) == "\\" { i = i + 2; }
                else if char_at(src, i) == "\"" { i = i + 1; break; }
                else { i = i + 1; }
            }
        } else if c == "f" && i + 1 < n && char_at(src, i + 1) == "n" {
            let mut prev_ok = true;
            if i > 0 {
                let pc: String = char_at(src, i - 1);
                if char_is_alpha(pc) || char_is_digit(pc) || pc == "_" { prev_ok = false; }
            }
            let mut next_ok = true;
            if i + 2 < n {
                let nc: String = char_at(src, i + 2);
                if char_is_alpha(nc) || char_is_digit(nc) || nc == "_" { next_ok = false; }
            }
            if !prev_ok || !next_ok || !scan_fn_is_pub(src, i) {
                i = i + 1;
            } else {
                let mut j = i + 2;
                while j < n && (char_at(src, j) == " " || char_at(src, j) == "\t") { j = j + 1; }
                let mut name = "";
                while j < n {
                    let nc2: String = char_at(src, j);
                    if char_is_alpha(nc2) || char_is_digit(nc2) || nc2 == "_" { name = name + nc2; j = j + 1; }
                    else { break; }
                }
                while j < n && (char_at(src, j) == " " || char_at(src, j) == "\t") { j = j + 1; }
                if name == "" || j >= n || char_at(src, j) != "(" {
                    i = i + 1;
                } else {
                    let mut argc = 0;
                    let mut depth = 1;
                    let mut nest = 0;
                    let mut in_name = true;
                    j = j + 1;
                    let mut word = "";
                    while j < n && depth > 0 {
                        let dc: String = char_at(src, j);
                        if dc == "{" || dc == "[" {
                            word = "";
                            nest = nest + 1;
                            j = j + 1;
                        } else if (dc == "}" || dc == "]") && nest > 0 {
                            word = "";
                            nest = nest - 1;
                            j = j + 1;
                        } else if dc == "\"" {
                            word = "";
                            j = j + 1;
                            while j < n {
                                if char_at(src, j) == "\\" { j = j + 2; }
                                else if char_at(src, j) == "\"" { j = j + 1; break; }
                                else { j = j + 1; }
                            }
                        } else if dc == "(" {
                            word = "";
                            depth = depth + 1;
                            j = j + 1;
                        } else if dc == ")" {
                            word = "";
                            in_name = false;
                            depth = depth - 1;
                            j = j + 1;
                        } else if dc == "," && depth == 1 && nest == 0 {
                            word = "";
                            in_name = true;
                            j = j + 1;
                        } else if dc == ":" && depth == 1 && nest == 0 {
                            if in_name && word != "" { argc = argc + 1; }
                            word = "";
                            in_name = false;
                            j = j + 1;
                        } else if dc == " " || dc == "\t" || dc == "\n" {
                            word = "";
                            j = j + 1;
                        } else if char_is_alpha(dc) || char_is_digit(dc) || dc == "_" {
                            word = word + dc;
                            j = j + 1;
                        } else {
                            if dc != "&" && dc != "*" { word = ""; }
                            j = j + 1;
                        }
                    }
                    table = table + name + "=" + argc.to_string() + "\t";
                    i = j;
                }
            }
        } else {
            i = i + 1;
        }
    }
    return table;
}

