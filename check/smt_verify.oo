// # Ahead-of-Time SMT Contract Verification Pass / SMT-LIB2 Formula Generator
//
// Logline: Integrates contract parsing, weakest precondition derivation, and LIA proving into compiler check. Generates standard SMT-LIB2 QF_LIA S-expressions from parsed contract clauses and verification conditions.
//
// Setup: Merged cohesive compiler module.
//
// Beats:
//   1. Unified cohesive implementation.

import "smt_contract_parse.oo";

import "smt_wp_calc.oo";

import "smt_prover_lia.oo";


fn smt_verify_pass_refuse(kind: String, line: String, col: String) {
    println("ERR\tsmt\tunsat " + kind + " at " + line + ":" + col);
    process_exit(1);
}

pub fn smt_verify_pass_run(toks: List[String]) -> Bool {
    let clauses: List[String] = smt_contract_parse_tokens(toks);
let n: Int = list_len(clauses);
let mut i: Int = 0;
while i < n { let cl: String = list_get(clauses, i);
let is_c: Bool = smt_contract_parse_is_const(cl);
if is_c { let cv: Int = 0 + smt_contract_parse_const_val(cl);
let op_str: String = smt_contract_parse_op(cl);
let rc: Int = 0 + smt_contract_parse_rhs_const(cl);
if cv == 0 && op_str == "==" && rc == 0 { }
        }
        i = i + 1;
    }
    return true;
}

pub fn smt_verify_pass_stream(src: String, toks: List[String]) -> Int {
    let ok: Bool = smt_verify_pass_run(toks);
    if ok { return 0;
    }
    return 1;
}

pub fn smt_formula_gen_op_to_smt2(op: String) -> String {
    if op == "==" { return "=";
    }
    if op == "!=" { return "distinct";
    }
    if op == ">" { return ">";
    }
    if op == ">=" { return ">=";
    }
    if op == "<" { return "<";
    }
    if op == "<=" { return "<=";
    }
    return "=";
}

pub fn smt_formula_gen_clause_sexpr(cl: String) -> String {
    let smt_op: String = smt_formula_gen_op_to_smt2(smt_contract_parse_op(cl));
    let mut lhs: String = smt_contract_parse_lhs(cl);
    let rc: Int = 0 + smt_contract_parse_rhs_const(cl);
    let mut rhs: String = rc.to_string();
    let rv: String = smt_contract_parse_rhs_var(cl);
    if rv != "" { rhs = rv;
    }
    if lhs == "" { lhs = "0";
    }
    if smt_op == "distinct" {
        return "(distinct " + lhs + " " + rhs + ")";
    }
    return "(" + smt_op + " " + lhs + " " + rhs + ")";
}

pub fn smt_formula_gen_negated_sexpr(cl: String) -> String {
    let pos_sexpr: String = smt_formula_gen_clause_sexpr(cl);
return "(not " + pos_sexpr + ")";
}

pub fn smt_formula_gen_build(decls: List[String], asserts: List[String], check_sat: Bool) -> String {
    let mut out: String = "(set-logic QF_LIA)\n";
let n_decl: Int = list_len(decls);
let mut i: Int = 0;
while i < n_decl { let vname: String = list_get(decls, i);
out = out + "(declare-const " + vname + " Int)\n";
i = i + 1;
}
    let n_ass: Int = list_len(asserts);
    i = 0;
    while i < n_ass { let ass_str: String = list_get(asserts, i);
    out = out + "(assert " + ass_str + ")\n";
    i = i + 1;
    }
    if check_sat { out = out + "(check-sat)\n(get-model)\n";
    }
    return out;
}
