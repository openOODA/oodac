// # Check a refined call argument / Check char_at and str_slice const bounds
//
// Logline: When a one-INT call matches a fn whose first param is Int[lo..hi], reject an argument outside that range. Rejects a const-string char_at or str_slice call whose integer indices sit outside the literal.
//
// Setup: Merged cohesive compiler module.
//
// Beats:
//   1. Unified cohesive implementation.

pub fn refine_check_call_arg(toks: List[String], i: Int) {
    let n = list_len(toks);
    if i + 3 < n { if field_at(list_get(toks, i + 1), 0) == "LPAREN" { if field_at(list_get(toks, i + 2), 0) == "INT" { if field_at(list_get(toks, i + 3), 0) == "RPAREN" { let call_name: String = field_at(list_get(toks, i), 3);
    let arg_val = 0 + parse_int(field_at(list_get(toks, i + 2), 3));
    let mut scan = 0;
    while scan < n { if field_at(list_get(toks, scan), 0) == "KW_FN" { if scan + 11 < n { if field_at(list_get(toks, scan + 1), 3) == call_name { if field_at(list_get(toks, scan + 2), 0) == "LPAREN" { if field_at(list_get(toks, scan + 4), 0) == "COLON" { if field_at(list_get(toks, scan + 5), 3) == "Int" { if field_at(list_get(toks, scan + 6), 0) == "LBRACKET" { if field_at(list_get(toks, scan + 7), 0) == "INT" { if field_at(list_get(toks, scan + 8), 0) == "DOTDOT" { if field_at(list_get(toks, scan + 9), 0) == "INT" { if field_at(list_get(toks, scan + 10), 0) == "RBRACKET" { let p_min = 0 + parse_int(field_at(list_get(toks, scan + 7), 3));
    let p_max = 0 + parse_int(field_at(list_get(toks, scan + 9), 3));
    if arg_val < p_min || arg_val > p_max { tc_err_at(toks, i + 2, "RefinementTypeViolation");
    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        scan = scan + 1;
                    }
                }
            }
        }
    }
}

pub fn refine_check_str_builtins(toks: List[String], i: Int) {
    let n = list_len(toks);
    let func_name: String = field_at(list_get(toks, i), 3);
    if func_name == "char_at" {
        if i + 5 < n { if field_at(list_get(toks, i + 1), 0) == "LPAREN" { if field_at(list_get(toks, i + 2), 0) == "STRING" { if field_at(list_get(toks, i + 3), 0) == "COMMA" { if field_at(list_get(toks, i + 4), 0) == "INT" { if field_at(list_get(toks, i + 5), 0) == "RPAREN" { let s: String = field_at(list_get(toks, i + 2), 3);
        let idx = 0 + parse_int(field_at(list_get(toks, i + 4), 3));
        let length = chars_len(s);
        if idx < 0 || idx >= length { tc_err_at(toks, i, "char_at index out of bounds");
        }
                            }
                        }
                    }
                }
            }
        }
    }
    if func_name == "str_slice" {
        if i + 7 < n { if field_at(list_get(toks, i + 1), 0) == "LPAREN" { if field_at(list_get(toks, i + 2), 0) == "STRING" { if field_at(list_get(toks, i + 3), 0) == "COMMA" { if field_at(list_get(toks, i + 4), 0) == "INT" { if field_at(list_get(toks, i + 5), 0) == "COMMA" { if field_at(list_get(toks, i + 6), 0) == "INT" { if field_at(list_get(toks, i + 7), 0) == "RPAREN" { let s: String = field_at(list_get(toks, i + 2), 3);
        let start_idx = 0 + parse_int(field_at(list_get(toks, i + 4), 3));
        let end_idx = 0 + parse_int(field_at(list_get(toks, i + 6), 3));
        let length = chars_len(s);
        if start_idx < 0 || end_idx > length || start_idx > end_idx { tc_err_at(toks, i, "str_slice out of bounds");
        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
