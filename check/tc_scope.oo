// # Bind names and look up types
//
// Logline: Test whether a name is bound and look up its type in the typecheck env.
//
// Setup: binds and env are string tables. Stage is typecheck.
//
// Beats:
//   1. binds_has looks for a tab-wrapped name.
//   2. Scope walk finds the live binding.
//   3. Types come from the env string.

import "lex/token_fmt.oo";

pub fn binds_has(binds: String, name: String) -> Bool {
    let needle = "\t" + name + "\t";
    return binds.contains(needle);
}

// Scope-aware undefined-var: single reverse-pass prefix check with zero-alloc byte scan.
pub fn scope_has(binds: List[String], name: String, max_depth: Int) -> Bool {
    let prefix: String = name + "@";
    let plen: Int = bytes_len(prefix);
    let p0: Int = byte_at(prefix, 0);
    let mut i: Int = list_len(binds) - 1;
    while i >= 0 {
        let e: String = list_get(binds, i);
        if bytes_len(e) >= plen && byte_at(e, 0) == p0 && str_starts_with(e, prefix) {
            let elen: Int = bytes_len(e);
            let mut d: Int = 0;
            let mut j: Int = plen;
            while j < elen {
                let b: Int = byte_at(e, j);
                if b >= 48 && b <= 57 {
                    d = d * 10 + (b - 48);
                }
                j = j + 1;
            }
            if d <= max_depth {
                return true;
            }
        }
        i = i - 1;
    }
    return false;
}

// Tail-drop out-of-scope bindings: O(1) fast path for empty scopes.
pub fn drop_depth(binds: List[String], depth: Int) -> List[String] {
    let n: Int = list_len(binds);
    if n == 0 {
        return binds;
    }
    let marker: String = "@" + depth.to_string();
    if !str_ends_with(list_get(binds, n - 1), marker) {
        return binds;
    }
    let mut cut: Int = n - 1;
    while cut > 0 {
        if !str_ends_with(list_get(binds, cut - 1), marker) {
            break;
        }
        cut = cut - 1;
    }
    return list_slice(binds, 0, cut);
}

// Single-pass scoped undefined-var check.
pub fn env_lookup_type(env: String, name: String) -> String {
    let key = "\t" + name + ":";
    if !env.contains(key) { return ""; }
    let tn = chars_len(env);
    let kn = chars_len(key);
    let mut pos = 0;
    let mut last_found = "";
    while pos + kn <= tn {
        let mut m = true;
        let mut j = 0;
        while j < kn {
            if char_at(env, pos + j) != char_at(key, j) {
                m = false;
                j = kn;
            } else {
                j = j + 1;
            }
        }
        if m {
            let mut ty_res: String = "";
            let mut p: Int = pos + kn;
            while p < tn {
                let c: String = char_at(env, p);
                if c == "\t" {
                    p = tn;
                } else {
                    ty_res = ty_res + c;
                    p = p + 1;
                }
            }
            last_found = ty_res;
        }
        pos = pos + 1;
    }
    return last_found;
}

// Fail-closed: `let mut x: Int = 1; x = "a";` and `x = y` when y is pure-lit typed.
pub fn is_mut_binding(toks: List[String], name: String) -> Bool {
    let n = list_len(toks);
    let mut i = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        if k == "KW_LET" {
            if i + 2 < n && field_at(list_get(toks, i + 1), 0) == "KW_MUT" {
                if field_at(list_get(toks, i + 2), 0) == "IDENT" && field_at(list_get(toks, i + 2), 3) == name {
                    return true;
                }
            }
        } else if k == "IDENT" {
            if field_at(list_get(toks, i), 3) == name {
                if i + 3 < n && field_at(list_get(toks, i + 1), 0) == "COLON" {
                    if field_at(list_get(toks, i + 2), 0) == "AMP" && field_at(list_get(toks, i + 3), 0) == "KW_MUT" {
                        return true;
                    }
                }
            }
        }
        i = i + 1;
    }
    return false;
}
