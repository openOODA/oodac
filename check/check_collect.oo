// # Collect import graph paths
//
// Logline: Walks import lines depth-first, deps first, and returns the path list or a source body with import lines stripped.
//
// Setup: Needs FsReadCap; parse_import_line, path_dirname, path_join, path_exists, set_has, and set_add live in check_scan.oo.
//
// Beats:
//   1. collect_module_paths DFS-expands a root path and splits the joined newline list into paths.
//   2. collect_expand fail-closes on cycles and missing files, resolves std and relative imports, then appends the current path.
//   3. strip_import_lines keeps a blank line for each import so per-file line numbers stay put.
//   4. compute_input_fp hashes canonical manifest of paths and content hashes to a 16-char Merkle root.

import "check_scan.oo";
import "ast/load_import_parse.oo";


// DFS collect paths (deps first). Returns List[String] of paths.
pub fn collect_module_paths(fs: &FsReadCap, path: String) -> List[String] {
    let r: List[String] = collect_expand(fs, path, "\t", "\t");
    let joined: String = list_get(r, 1);
    let mut out: List[String] = list_new();
    let n = chars_len(joined);
    let mut i = 0;
    let mut start = 0;
    while i <= n { let at_end = i == n;
    let mut nl = at_end;
    if !at_end { if char_at(joined, i) == "\n" { nl = true;
    }
        }
        if nl { if i > start { out = list_push(out, str_slice(joined, start, i));
        }
            if at_end { i = n + 1;
            } else {
                i = i + 1;
                start = i;
            }
        } else {
            i = i + 1;
        }
    }
    return out;
}

// Returns [done', paths_joined_by_newline]
fn collect_expand(fs: &FsReadCap, path: String, stack: String, done: String) -> List[String] {
    let mut out: List[String] = list_new();
    if set_has(done, path) {
        out = list_push(out, done);
        out = list_push(out, "");
        return out;
    }
    if set_has(stack, path) {
        println("ERR\timport\tcycle involving " + path);
        process_exit(1);
    }
    let stack2: String = set_add(stack, path);
    if !path_exists(fs, path) {
        println("ERR\timport\tmissing " + path);
        process_exit(1);
    }
    let src_r = read_file(fs, path);
    if src_r.is_err() {
        println("ERR\timport\tunreadable " + path);
        process_exit(1);
    }
    let src: String = match src_r { Ok(s)    => s, Err(msg) => msg };
    let dir: String = path_dirname(path);
    let mut done_cur: String = str_slice(done, 0, chars_len(done));
    let mut paths_acc: String = "";
    let n = chars_len(src);
    let mut i = 0;
    let mut start = 0;
    while i <= n { let at_end = i == n;
    let mut nl = at_end;
    if !at_end { if char_at(src, i) == "\n" { nl = true;
    }
        }
        if nl { let line: String = str_slice(src, start, i);
        let imp: String = parse_import_line(line);
        if imp != "" { reject_bad_import_name(imp);
        let ipath: String = resolve_import_path(fs, dir, imp);
        if chars_len(ipath) == 0 {
            println("ERR\timport\tnot found: " + imp);
            process_exit(1);
        }

                let sub: List[String] = collect_expand(fs, ipath, stack2, done_cur);
                done_cur = list_get(sub, 0);
                let subp: String = list_get(sub, 1);
                if chars_len(subp) > 0 { if chars_len(paths_acc) > 0 { paths_acc = paths_acc + "\n" + subp;
                } else {
                        paths_acc = subp;
                    }
                }
            }
            if at_end { i = n + 1;
            } else {
                i = i + 1;
                start = i;
            }
        } else {
            i = i + 1;
        }
    }
    done_cur = set_add(done_cur, path);
    if chars_len(paths_acc) > 0 { paths_acc = paths_acc + "\n" + path;
    } else {
        paths_acc = path;
    }
    out = list_push(out, done_cur);
    out = list_push(out, paths_acc);
    return out;
}

// Strip leading import lines from module source.
pub fn strip_import_lines(src: String) -> String {
    let mut body: String = "";
let n = chars_len(src);
let mut i = 0;
let mut start = 0;
while i <= n { let at_end = i == n;
let mut nl = at_end;
if !at_end { if char_at(src, i) == "\n" { nl = true;
}
        }
        if nl { let line: String = str_slice(src, start, i);
        let imp: String = parse_import_line(line);
        if imp == "" { body = body + line;
        if !at_end { body = body + "\n";
        }
            } else {
                // Keep the line slot so per-file line/col stays honest (OPEN-12).
                if !at_end {
                    body = body + "\n";
                }
            }
            if at_end { i = n + 1;
            } else {
                i = i + 1;
                start = i;
            }
        } else {
            i = i + 1;
        }
    }
    return body;
}

// Normalize path by stripping leading "./"
fn normalize_path_prefix(path: String) -> String {
    let n: Int = chars_len(path);
    if n >= 2 {
        if str_slice(path, 0, 2) == "./" {
            return str_slice(path, 2, n);
        }
    }
    return path;
}

// Computes Merkle root over canonical manifest of module relative paths and content hashes.
pub fn compute_input_fp(fs: &FsReadCap, paths: List[String]) -> String {
    let np: Int = list_len(paths);
    let mut manifest: String = "";
    let mut i: Int = 0;
    while i < np {
        let pth: String = list_get(paths, i);
        let norm_pth: String = normalize_path_prefix(pth);
        let sr: Result[String, String] = read_file(fs, pth);
        let src: String = match sr { Ok(s) => s, Err(_) => "" };
        let h: String = crypto_sha256_internal(src);
        manifest = manifest + norm_pth + "\t" + h + "\n";
        i = i + 1;
    }
    let digest: String = crypto_sha256_internal(manifest);
    if chars_len(digest) >= 16 {
        return str_slice(digest, 0, 16);
    }
    return digest;
}

// Generates the canonical CAS cache path for an emitted .ll file
pub fn emit_cache_path(merkle_root: String, src_hash: String) -> String {
    return ".ooda-cache/oodac_emit/" + merkle_root + "_" + src_hash + ".ll";
}
