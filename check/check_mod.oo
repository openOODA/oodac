// # Modular Cached Check Driver
//
// Logline: Checks every module on the import graph and prints OK. Fast check cache hit skips typecheck.
//
// Setup: Needs FsReadCap, FsWriteCap, ProcessCap, and ArenaCap; check_graph and check_cache helpers in scope.
//
// Beats:
//   1. Collect import graph paths and test tree key cache hit.
//   2. Typecheck every module in graph and write per-file typed artifacts.
//   3. Provide arena attach and detach hooks for compiler driver stages.

import "check_cache.oo";
import "check_artifact.oo";
import "types/typed_artifact.oo";
import "ast/load_import.oo";
import "ast/load_import_parse.oo";
import "lex/token_fmt.oo";
import "lex/token_parse_int.oo";
import "check_scan.oo";
import "tc_unused_import.oo";
import "check_collect.oo";
import "check_drive.oo";
import "check_hash.oo";
import "tc_call_arity_imports.oo";
import "check_graph.oo";

fn mod_artifact_write_toks(fs_w: &FsWriteCap, sys: &ProcessCap, path: String, src: String, toks: List[String]) -> String {
    artifact_ensure_dir(sys);
    let art: TypedArtifact = artifact_new(path, src, toks, artifact_typenv_of(toks), artifact_caps_of(toks), artifact_smt_of(toks));
    let dest: String = artifact_cache_path(art.sha);
    let mut out: String = "OODAART3\n" + art.path + "\n" + art.sha + "\ntypes:\n";
    if art.typenv != "" { out = out + art.typenv + "\n"; }
    out = out + "caps:\n";
    if art.caps != "" { out = out + art.caps + "\n"; }
    out = out + "smt:\n";
    if art.smt != "" { out = out + art.smt + "\n"; }
    out = out + "--\n" + fold_toks(art.toks, 0, list_len(art.toks));
    let wr: Result[Void, String] = write_file(fs_w, dest, out);
    if wr.is_err() {
        println("ERR\tartifact\twrite failed");
        process_exit(1);
    }
    return dest;
}

fn mod_strip_imports(src: String, strip_imp: Bool) -> String {
    let mut lines: List[String] = list_new();
    let n: Int = bytes_len(src);
    let mut i: Int = 0;
    let mut start: Int = 0;
    let mut in_str: Bool = false;
    while i <= n {
        let at_end: Bool = i == n;
        let mut nl: Bool = at_end;
        if !at_end { if byte_at(src, i) == 10 { nl = true; } }
        if nl {
            let mut line: String = str_slice(src, start, i);
            if !in_str {
                let ln: Int = bytes_len(line);
                let mut sp: Int = 0;
                while sp < ln && (byte_at(line, sp) == 32 || byte_at(line, sp) == 9) { sp = sp + 1; }
                if sp > 0 { line = str_slice(line, sp, ln); }
            }
            let mut li: Int = 0;
            let ln2: Int = bytes_len(line);
            while li < ln2 {
                let b2: Int = byte_at(line, li);
                if in_str {
                    if b2 == 92 { li = li + 1; } else if b2 == 34 { in_str = false; }
                } else {
                    if b2 == 47 && li + 1 < ln2 && byte_at(line, li + 1) == 47 { li = ln2; }
                    else if b2 == 34 { in_str = true; }
                }
                li = li + 1;
            }
            if strip_imp && parse_import_line(line) != "" { lines = list_push(lines, ""); }
            else { lines = list_push(lines, line); }
            if at_end { i = n + 1; } else { i = i + 1; start = i; }
        } else { i = i + 1; }
    }
    return fold_toks(lines, 0, list_len(lines));
}

fn check_one_module(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, ar: &ArenaCap, ar_id: Int, pth2: String, is_last: Bool, extra_names: String) {
    if ar_id >= 0 {
        let _: Result[String, String] = arena_attach(ar, ar_id);
    }
    let rr2: Result[String, String] = read_file(fs_r, pth2);
    let raw2: String = match rr2 { Ok(s) => s, Err(_) => "" };
    let body: String = mod_strip_imports(raw2, !is_last);
    if chars_len(body) > 0 {
        // Gap 10: per-TU closure binds (not graph union); target keeps anchor.
        let closure: List[String] = collect_module_paths(fs_r, pth2);
        let direct: String = direct_imports_set(fs_r, pth2);
        let mut tu_names: String = scan_graph_names_for(fs_r, closure, direct) + scan_graph_type_names(fs_r, closure);
        if is_last { tu_names = tu_names + extra_names; }
        let binds: String = names_to_depth0_binds(tu_names);
        let tu_arity: String = scan_graph_arity(fs_r, closure);
        check_dup_proto(tu_arity);
        let toks: List[String] = run_check_core_binds_at(sys, body, binds, pth2, tu_arity);
        typecheck_unused_imports_graph(fs_r, pth2, toks);
        let _: String = mod_artifact_write_toks(fs_w, sys, pth2, raw2, toks);
    }
    if ar_id >= 0 {
        let _: Result[String, String] = arena_detach(ar);
        let _: Result[String, String] = arena_reset(ar, ar_id);
    }
}

fn check_modules(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, ar: &ArenaCap, paths: List[String], extra_names: String) {
    let np = list_len(paths);
    let mut i = 0;
    while i < np {
        let pth: String = list_get(paths, i);
        let rr = read_file(fs_r, pth);
        if rr.is_err() {
            println("ERR\timport\tmissing " + pth);
            process_exit(1);
        }
        let raw: String = match rr { Ok(s) => s, Err(_) => "" };
        if count_lines(raw) > 256 {
            println("ERR\tcheck\toversized " + pth + " " + count_lines(raw).to_string() + " > 256");
            process_exit(1);
        }
        i = i + 1;
    }
    let ar_res: Result[String, String] = arena_create(ar, 62914560);
    let ar_id: Int = parse_arena_id(ar_res);
    i = 0;
    while i < np {
        let pth2: String = list_get(paths, i);
        check_one_module(fs_r, fs_w, sys, ar, ar_id, pth2, i + 1 == np, extra_names);
        i = i + 1;
    }
    if ar_id >= 0 {
        let _: Result[String, String] = arena_destroy(ar, ar_id);
    }
}

fn check_cache_arts_ok(fs_r: &FsReadCap, paths: List[String]) -> Bool {
    let n: Int = list_len(paths);
    let mut i: Int = 0;
    while i < n {
        let p: String = list_get(paths, i);
        let rr: Result[String, String] = read_file(fs_r, p);
        if rr.is_err() { return false; }
        let src: String = match rr { Ok(s) => s, Err(_) => "" };
        let art: String = artifact_cache_path(artifact_sha(p, src));
        if !path_exists(fs_r, art) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn run_check_path(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, ar: &ArenaCap, path: String) {
    check_cache_ensure(fs_r, sys);
    let paths: List[String] = collect_module_paths(fs_r, path);
    let roll: String = check_paths_listing(fs_r, paths);
    let tk: String = check_cache_tree_key(fs_r, content_hash("dw1\n" + roll));
    if check_cache_hit(fs_r, tk) && check_cache_arts_ok(fs_r, paths) {
        println("OK");
        return;
    }
    let extra: String = anchor_extra_names(fs_r, path);
    check_modules(fs_r, fs_w, sys, ar, paths, extra);
    persist_graph(fs_r, fs_w, sys, path, roll);
    println("OK");
}

pub fn arena_attach(ar: &ArenaCap, id: Int) -> Result[String, String] {
    return arena_alloc(ar, id, 0);
}

pub fn arena_detach(ar: &ArenaCap) -> Result[String, String] {
    return arena_alloc(ar, 0, 0 - 1);
}
