// # Modular cached check driver
//
// Logline: Checks every module on the import graph and prints OK. Cache never skips typecheck.
//
// Setup: Needs FsReadCap, FsWriteCap, and ProcessCap; collect_module_paths, scan_fn_names, run_check_core_binds, oo_file_stamp, and the check_cache_* helpers are in scope.
//
// Beats:
//   1. Collect the import graph.
//   2. Typecheck every module and write a per-file artifact.
//   3. Persist the graph listing after a real check.
//   Isolated TUs (not main.oo) seed extra_binds from sibling ANCHOR.oo.
//   Entry (last path) keeps import lines so unused-import can see KW_IMPORT.
//
// residual: RAM-cold typecheck stays ~523s; disk-warm new-process uses g_ stamp snapshot.

import "check_cache.oo";
import "check_artifact.oo";
import "types/typed_artifact.oo";
import "ast/load_import.oo";
import "ast/load_import_parse.oo";
import "lex/token_fmt.oo";
import "lex/token_parse_int.oo";
import "check_scan.oo";

fn parse_arena_id(res: Result[String, String]) -> Int {
    if res.is_err() { return 0 - 1; }
    let s: String = match res { Ok(v) => v, Err(_) => "" };
    if chars_len(s) >= 7 && str_slice(s, 0, 6) == "arena:" {
        return parse_int(str_slice(s, 6, chars_len(s)));
    }
    return parse_int(s);
}


fn sibling_anchor(fs_r: &FsReadCap, path: String) -> String {
    let n: Int = chars_len(path);
    let mut i: Int = n;
    let mut dir: String = "";
    while i > 0 {
        i = i - 1;
        if char_at(path, i) == "/" {
            dir = str_slice(path, 0, i + 1);
            i = 0;
        }
    }
    let lower: String = dir + "anchor.oo";
    if path_exists(fs_r, lower) {
        return lower;
    }
    return dir + "ANCHOR.oo";
}

fn path_is_main_oo(path: String) -> Bool {
    let n: Int = chars_len(path);
    if n >= 7 {
        if str_slice(path, n - 7, n) == "main.oo" {
            return true;
        }
    }
    return path == "main.oo";
}

fn scan_graph_names(fs_r: &FsReadCap, paths: List[String]) -> String {
    let np: Int = list_len(paths);
    let mut names: String = "\t";
    let mut i: Int = 0;
    while i < np {
        let pth: String = list_get(paths, i);
        let rr: Result[String, String] = read_file(fs_r, pth);
        if !rr.is_err() {
            let raw: String = match rr { Ok(s) => s, Err(_) => "" };
            names = names + scan_fn_names(raw);
        }
        i = i + 1;
    }
    return names;
}

fn anchor_extra_names(fs_r: &FsReadCap, path: String) -> String {
    if path_is_main_oo(path) {
        return "\t";
    }
    let anc: String = sibling_anchor(fs_r, path);
    if anc == path {
        return "\t";
    }
    if !path_exists(fs_r, anc) {
        return "\t";
    }
    let ap: List[String] = collect_module_paths(fs_r, anc);
    return scan_graph_names(fs_r, ap);
}

fn persist_graph(fs_r: &FsReadCap, fs: &FsWriteCap, sys: &ProcessCap, root: String, listing: String) {
    let tk: String = check_cache_tree_key(fs_r, content_hash("dw1\n" + listing));
    check_cache_put(fs, sys, tk);
    check_cache_put_body(fs, sys, check_cache_graph_key(fs_r, root), listing);
}

fn count_lines(s: String) -> Int {
    let n: Int = chars_len(s);
    if n == 0 { return 0;
    }
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(s, i) == "\n" { c = c + 1;
        }
        i = i + 1;
    }
    if char_at(s, n - 1) != "\n" { c = c + 1;
    }
    return c;
}

fn fold_toks(toks: List[String], l: Int, r: Int) -> String {
    let mut out: String = "";
    let mut i: Int = l;
    while i < r {
        out = out + list_get(toks, i) + "\n";
        i = i + 1;
    }
    return out;
}

fn mod_artifact_write_toks(fs_w: &FsWriteCap, sys: &ProcessCap, path: String, src: String, toks: List[String]) -> String {
    artifact_ensure_dir(sys);
    let art: TypedArtifact = artifact_new(path, src, toks, artifact_typenv_of(toks), artifact_caps_of(toks), artifact_smt_of(toks));
    let dest: String = artifact_cache_path(art.sha);
    let mut out: String = "OODAART3\n" + art.path + "\n" + art.sha + "\ntypes:\n";
    if art.typenv != "" { out = out + art.typenv + "\n"; }
    out = out + "caps:\n";
    if art.caps != "" { out = out + art.caps + "\n"; }
    out = out + "smt:\n";
    if art.smt != "" { out = out + art.smt + "\n"; }
    out = out + "--\n" + fold_toks(art.toks, 0, list_len(art.toks));
    let wr: Result[Void, String] = write_file(fs_w, dest, out);
    if wr.is_err() {
        println("ERR\tartifact\twrite failed");
        process_exit(1);
    }
    return dest;
}

fn mod_strip_imports(src: String) -> String {
    let mut lines: List[String] = list_new();
    let n: Int = chars_len(src);
    let mut i: Int = 0;
    let mut start: Int = 0;
    while i <= n {
        let at_end: Bool = i == n;
        let mut nl: Bool = at_end;
        if !at_end { if char_at(src, i) == "\n" { nl = true; } }
        if nl {
            let line: String = str_slice(src, start, i);
            if parse_import_line(line) == "" {
                lines = list_push(lines, line);
            } else {
                lines = list_push(lines, "");
            }
            if at_end { i = n + 1; }
            else { i = i + 1; start = i; }
        } else { i = i + 1; }
    }
    return fold_toks(lines, 0, list_len(lines));
}

fn check_one_module(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, ar: &ArenaCap, ar_id: Int, pth2: String, is_last: Bool, binds: String, arity_all: String) {
    if ar_id >= 0 {
        let _: Result[String, String] = arena_attach(ar, ar_id);
    }
    let rr2: Result[String, String] = read_file(fs_r, pth2);
    let raw2: String = match rr2 { Ok(s) => s, Err(_) => "" };
    let mut body: String = str_slice(raw2, 0, chars_len(raw2));
    if !is_last { body = mod_strip_imports(raw2); }
    if chars_len(body) > 0 {
        let toks: List[String] = run_check_core_binds_at(sys, body, binds, pth2, arity_all);
        let _: String = mod_artifact_write_toks(fs_w, sys, pth2, raw2, toks);
    }
    if ar_id >= 0 {
        let _: Result[String, String] = arena_detach(ar);
        let _: Result[String, String] = arena_reset(ar, ar_id);
    }
}

fn check_modules(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, ar: &ArenaCap, paths: List[String], extra_names: String) {
    let np = list_len(paths);
    let mut names = extra_names;
    // E_CAP: graph-wide fn-arity table so cross-module calls cannot dodge
    // the arity check (capless net calls used to silent-OK via imports).
    let mut arity_all: String = "\t";
    let mut i = 0;
    while i < np {
        let pth: String = list_get(paths, i);
        let rr = read_file(fs_r, pth);
        if rr.is_err() {
            println("ERR\timport\tmissing " + pth);
            process_exit(1);
        }
        let raw: String = match rr { Ok(s) => s, Err(_) => "" };
        if count_lines(raw) > 256 {
            println("ERR\tcheck\toversized " + pth + " " + count_lines(raw).to_string() + " > 256");
            process_exit(1);
        }
        names = names + scan_fn_names(raw);
        arity_all = arity_all + scan_import_arity(raw);
        i = i + 1;
    }
    let binds: String = names_to_depth0_binds(names);
    let ar_res: Result[String, String] = arena_create(ar, 62914560);
    let ar_id: Int = parse_arena_id(ar_res);
    i = 0;
    while i < np {
        let pth2: String = list_get(paths, i);
        check_one_module(fs_r, fs_w, sys, ar, ar_id, pth2, i + 1 == np, binds, arity_all);
        i = i + 1;
    }
    if ar_id >= 0 {
        let _: Result[String, String] = arena_destroy(ar, ar_id);
    }
}

pub fn run_check_path(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, ar: &ArenaCap, path: String) {
    check_cache_ensure(fs_r, sys);
    let paths: List[String] = collect_module_paths(fs_r, path);
    let extra: String = anchor_extra_names(fs_r, path);
    let roll: String = check_paths_listing(fs_r, paths);
    check_modules(fs_r, fs_w, sys, ar, paths, extra);
    persist_graph(fs_r, fs_w, sys, path, roll);
    println("OK");
}

pub fn arena_attach(ar: &ArenaCap, id: Int) -> Result[String, String] {
    return arena_alloc(ar, id, 0);
}

pub fn arena_detach(ar: &ArenaCap) -> Result[String, String] {
    return arena_alloc(ar, 0, 0 - 1);
}

