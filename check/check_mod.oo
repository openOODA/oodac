// # Modular cached check driver
//
// Logline: Checks every module on the import graph and prints OK. Cache never skips typecheck.
//
// Setup: Needs FsReadCap, FsWriteCap, and ProcessCap; collect_module_paths, scan_fn_names, run_check_core_binds, oo_file_stamp, and the check_cache_* helpers are in scope.
//
// Beats:
//   1. Collect the import graph.
//   2. Typecheck every module and write a per-file artifact.
//   3. Persist the graph listing after a real check.
//   Isolated TUs (not main.oo) seed extra_binds from sibling ANCHOR.oo.
//   Entry (last path) keeps import lines so unused-import can see KW_IMPORT.
//
// residual: RAM-cold typecheck stays ~523s; disk-warm new-process uses g_ stamp snapshot.

import "check_cache.oo";
import "check_artifact.oo";
import "ast/load_import.oo";


fn sibling_anchor(path: String) -> String {
    let n: Int = chars_len(path);
    let mut i: Int = n;
    while i > 0 {
        i = i - 1;
        if char_at(path, i) == "/" {
            return str_slice(path, 0, i + 1) + "ANCHOR.oo";
        }
    }
    return "ANCHOR.oo";
}

fn path_is_main_oo(path: String) -> Bool {
    let n: Int = chars_len(path);
    if n >= 7 {
        if str_slice(path, n - 7, n) == "main.oo" {
            return true;
        }
    }
    return path == "main.oo";
}

fn scan_graph_names(fs_r: &FsReadCap, paths: List[String]) -> String {
    let np: Int = list_len(paths);
    let mut names: String = "\t";
    let mut i: Int = 0;
    while i < np {
        let pth: String = list_get(paths, i);
        let rr: Result[String, String] = read_file(fs_r, pth);
        if !rr.is_err() {
            let raw: String = match rr { Ok(s) => s, Err(_) => "" };
            names = names + scan_fn_names(raw);
        }
        i = i + 1;
    }
    return names;
}

fn anchor_extra_names(fs_r: &FsReadCap, path: String) -> String {
    if path_is_main_oo(path) {
        return "\t";
    }
    let anc: String = sibling_anchor(path);
    if anc == path {
        return "\t";
    }
    if !path_exists(fs_r, anc) {
        return "\t";
    }
    let ap: List[String] = collect_module_paths(fs_r, anc);
    return scan_graph_names(fs_r, ap);
}

fn persist_graph(fs: &FsWriteCap, sys: &ProcessCap, root: String, listing: String) {
    let tk: String = check_cache_tree_key(content_hash("dw1\n" + listing));
    check_cache_put(fs, sys, tk);
    check_cache_put_body(fs, sys, check_cache_graph_key(root), listing);
}

fn count_lines(s: String) -> Int {
    let n: Int = chars_len(s);
    if n == 0 { return 0;
    }
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(s, i) == "\n" { c = c + 1;
        }
        i = i + 1;
    }
    if char_at(s, n - 1) != "\n" { c = c + 1;
    }
    return c;
}

fn check_modules(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, paths: List[String], extra_names: String) {
    let np = list_len(paths);
    let mut names = extra_names;
    let mut raws: List[String] = list_new();
    let mut i = 0;
    while i < np { let pth: String = list_get(paths, i);
    let rr = read_file(fs_r, pth);
    let mut raw: String = "";
    if !rr.is_err() { raw = match rr { Ok(s)    => s, Err(msg) => msg };
            if count_lines(raw) > 256 { println("ERR\tcheck\toversized " + pth + " " + count_lines(raw).to_string() + " > 256");
            process_exit(1);
            }
            names = names + scan_fn_names(raw);
        } else {
            println("ERR\timport\tmissing " + pth);
            process_exit(1);
        }
        raws = list_push(raws, raw);
        i = i + 1;
    }
    let binds: String = names_to_depth0_binds(names);
    i = 0;
    while i < np {
        let pth2: String = list_get(paths, i);
        let raw2: String = list_get(raws, i);
        let mut body: String = raw2;
        if i + 1 < np { body = strip_import_lines(raw2); }
        if chars_len(body) > 0 {
            let toks: List[String] = run_check_core_binds_path(sys, body, binds, pth2);
            let _: String = artifact_write_toks(fs_w, sys, pth2, raw2, toks);
        }
        i = i + 1;
    }
}

pub fn run_check_path(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, path: String) {
    check_cache_ensure(fs_r, sys);
    let paths: List[String] = collect_module_paths(fs_r, path);
    let extra: String = anchor_extra_names(fs_r, path);
    let roll: String = check_paths_listing(paths);
    check_modules(fs_r, fs_w, sys, paths, extra);
    persist_graph(fs_w, sys, path, roll);
    println("OK");
}
