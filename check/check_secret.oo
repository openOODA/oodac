// # Check secret sink leaks during check phase
//
// Logline: Refuse secret-tagged values passed into sealed sinks.
//
// Setup: Fails closed on secret leak detection.
//
// Beats:
//   1. Verify presence of SECRET annotations in source.
//   2. Seed tainted idents from SECRET names.
//   3. Propagate taint through alias assignments.
//   4. Scan token stream for print or sink calls taking tainted arguments.
//   5. Fail closed on leak detection.

fn tainted_has(t: List[String], name: String) -> Bool {
    let mut i: Int = 0;
    while i < list_len(t) {
        if list_get(t, i) == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn tainted_add(t: List[String], name: String) -> List[String] {
    if tainted_has(t, name) {
        return t;
    }
    return list_push(t, name);
}

fn is_secret_name(src: String, name: String) -> Bool {
    let s1 = "// SECRET: " + name;
    let s2 = "//SECRET: " + name;
    if str_contains(src, s1 + "\n") || str_contains(src, s1 + "\r") || str_contains(src, s1 + " ") || str_contains(src, s1 + "\t") {
        return true;
    }
    if str_contains(src, s2 + "\n") || str_contains(src, s2 + "\r") || str_contains(src, s2 + " ") || str_contains(src, s2 + "\t") {
        return true;
    }
    if str_ends_with(src, s1) || str_ends_with(src, s2) {
        return true;
    }
    return false;
}

pub fn check_secret_println_sinks(src: String, toks: List[String]) {
    if !str_contains(src, "// SECRET:") && !str_contains(src, "//SECRET:") {
        return;
    }
    let n: Int = list_len(toks);
    let mut tainted: List[String] = list_new();
    let mut s: Int = 0;
    while s < n {
        if field_at(list_get(toks, s), 0) == "IDENT" {
            let nm: String = field_at(list_get(toks, s), 3);
            if is_secret_name(src, nm) {
                tainted = tainted_add(tainted, nm);
            }
        }
        s = s + 1;
    }
    let mut pass: Int = 0;
    let mut changed: Bool = true;
    while changed && pass < n {
        changed = false;
        pass = pass + 1;
        let mut i: Int = 0;
        while i + 1 < n {
            if field_at(list_get(toks, i), 0) == "IDENT" && field_at(list_get(toks, i + 1), 0) == "EQ" {
                let alias: String = field_at(list_get(toks, i), 3);
                if !tainted_has(tainted, alias) {
                    let mut p: Int = i + 2;
                    let mut hit: Bool = false;
                    while p < n && field_at(list_get(toks, p), 0) != "SEMI" {
                        if field_at(list_get(toks, p), 0) == "IDENT" && tainted_has(tainted, field_at(list_get(toks, p), 3)) {
                            hit = true;
                        }
                        p = p + 1;
                    }
                    if hit {
                        tainted = list_push(tainted, alias);
                        changed = true;
                    }
                }
            }
            i = i + 1;
        }
    }
    let mut i: Int = 0;
    while i < n {
        let t: String = list_get(toks, i);
        let k: String = field_at(t, 0);
        let v: String = field_at(t, 3);
        if k == "IDENT" && (v == "println" || v == "print" || v == "eprintln" || v == "write_file" || v == "file_append_sync" || v == "sys_exec" || v == "sys_exec_wait") {
            if i + 1 < n && field_at(list_get(toks, i + 1), 0) == "LPAREN" {
                let mut p: Int = i + 2;
                while p < n && field_at(list_get(toks, p), 0) != "RPAREN" {
                    let arg_k: String = field_at(list_get(toks, p), 0);
                    let arg_v: String = field_at(list_get(toks, p), 3);
                    if arg_k == "IDENT" && tainted_has(tainted, arg_v) {
                        println("ERR\tsecret\tsink refuse: " + v + " receives secret " + arg_v);
                        process_exit(1);
                    }
                    p = p + 1;
                }
            }
        }
        i = i + 1;
    }
}
