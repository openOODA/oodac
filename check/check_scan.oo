// # Scan fn names without tokenize
//
// Logline: Char-walks module source for depth-0 fn names, skipping comments and strings so fake names cannot seed extra_binds.
//
// Setup: chars_len and char_at exist; tokenize_lines is grepped out of this path (Darwin 1.8GiB RSS / 120s on 150 modules); seed emit cannot lower .contains so this file is char-walk only.
//
// Beats:
//   1. Skip // comments and "strings" so comment or string text cannot seed names.
//   2. On a standalone pub/export fn keyword, collect the following ident into a tab-separated name table.
//   3. names_to_depth0_binds maps "\tfoo\tbar\t" to "\tfoo@0\tbar@0\t" for typecheck_undefined_vars_ext.
//
// residual: shared sig tables not wired

import "lex/token_parse_int.oo";
import "tc_call_arity_imports.oo";

fn scan_fn_names_mode(src: String, only_pub: Bool) -> String {
    let mut names: String = "\t";
    let n: Int = bytes_len(src);
    let mut i: Int = 0;
    while i < n {
        let c = byte_at(src, i);
        if c == 47 && i + 1 < n && byte_at(src, i + 1) == 47 {
            i = i + 2; while i < n && byte_at(src, i) != 10 { i = i + 1; }
        } else if c == 34 {
            i = i + 1;
            while i < n && byte_at(src, i) != 34 { if byte_at(src, i) == 92 { i = i + 2; } else { i = i + 1; } }
            if i < n { i = i + 1; }
        } else if c == 102 && i + 1 < n && byte_at(src, i + 1) == 110 {
            let mut is_fn: Bool = true;
            if i > 0 { let p = byte_at(src, i - 1); if (p >= 97 && p <= 122) || (p >= 65 && p <= 90) || (p >= 48 && p <= 57) || p == 95 { is_fn = false; } }
            if i + 2 < n { let nx = byte_at(src, i + 2); if (nx >= 97 && nx <= 122) || (nx >= 65 && nx <= 90) || (nx >= 48 && nx <= 57) || nx == 95 { is_fn = false; } }
            if is_fn && only_pub { is_fn = scan_fn_is_pub(src, i, n); }
            if is_fn {
                let mut j: Int = i + 2;
                while j < n && (byte_at(src, j) == 32 || byte_at(src, j) == 9) { j = j + 1; }
                let mut jc: Int = 0; if j < n { jc = byte_at(src, j); }
                if j < n && ((jc >= 97 && jc <= 122) || (jc >= 65 && jc <= 90) || jc == 95) {
                    let fn0: Int = j;
                    while j < n {
                        let cj = byte_at(src, j);
                        if (cj >= 97 && cj <= 122) || (cj >= 65 && cj <= 90) || (cj >= 48 && cj <= 57) || cj == 95 { j = j + 1; }
                        else { break; }
                    }
                    let fname: String = byte_slice(src, fn0, j);
                    if !names.contains("\t" + fname + "\t") { names = names + fname + "\t"; }
                }
                i = j;
            } else { i = i + 1; }
        } else { i = i + 1; }
    }
    return names;
}

pub fn scan_fn_names(src: String) -> String {
    return scan_fn_names_mode(src, false);
}

pub fn scan_fn_names_pub(src: String) -> String {
    return scan_fn_names_mode(src, true);
}

pub fn names_to_depth0_binds(names: String) -> String {
    let mut binds = "\t";
    let n = bytes_len(names);
    let mut i = 0;
    let mut start = 0;
    while i < n {
        if byte_at(names, i) == 9 {
            if i > start { binds = binds + byte_slice(names, start, i) + "@0\t"; }
            start = i + 1;
        }
        i = i + 1;
    }
    if i > start { binds = binds + byte_slice(names, start, i) + "@0\t"; }
    return binds;
}

pub fn parse_arena_id(res: Result[String, String]) -> Int {
    if res.is_err() { return 0 - 1; }
    let s: String = match res { Ok(v) => v, Err(_) => "" };
    let n = bytes_len(s);
    if n >= 7 && byte_slice(s, 0, 6) == "arena:" {
        return parse_int(byte_slice(s, 6, n));
    }
    return parse_int(s);
}

pub fn path_is_main_oo(path: String) -> Bool {
    let n: Int = bytes_len(path);
    if n >= 7 {
        if byte_slice(path, n - 7, n) == "main.oo" { return true; }
    }
    return path == "main.oo";
}

pub fn count_lines(s: String) -> Int {
    let n: Int = bytes_len(s);
    if n == 0 { return 0; }
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if byte_at(s, i) == 10 { c = c + 1; }
        i = i + 1;
    }
    if byte_at(s, n - 1) != 10 { c = c + 1; }
    return c;
}

pub fn fold_toks(toks: List[String], l: Int, r: Int) -> String {
    let count: Int = r - l;
    if count <= 0 { return ""; }
    if count == 1 { return list_get(toks, l) + "\n"; }
    let mid: Int = l + count / 2;
    return fold_toks(toks, l, mid) + fold_toks(toks, mid, r);
}
