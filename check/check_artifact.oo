// # Persist the typed artifact after a passing check
//
// Logline: Write token rows under .ooda-cache so emit-c does not re-lex.
//
// Setup: FsWriteCap. mkdir via ProcessCap. Decode refuses a bad magic.
//
// Beats:
//   1. Pack path, sha, and toks only.
//   2. Encode OODAART2 text.
//   3. write_file the cache path. Missing write is ERR.

import "types/typed_artifact.oo";
import "check/tc_struct_field_table.oo";
import "check/smt_contract_parse.oo";
import "check/smt_vc_gen.oo";
import "lex/token_parse_int.oo";

pub fn artifact_ensure_dir(sys: &ProcessCap) {
    let _: Result[String, String] = sys_exec(sys, "/usr/bin/mkdir", "-p", ".ooda-cache/ooda-tmp");
}

fn art_kind(toks: List[String], i: Int) -> String {
    if i < 0 || i >= list_len(toks) { return ""; }
    return field_at(list_get(toks, i), 0);
}

fn art_text(toks: List[String], i: Int) -> String {
    if i < 0 || i >= list_len(toks) { return ""; }
    return field_at(list_get(toks, i), 3);
}

fn art_has(bag: String, name: String) -> Bool {
    if name == "" { return false; }
    return str_index_of(bag, "\t" + name + "\t") >= 0;
}

// Nominal type env: struct shapes declared in this module.
pub fn artifact_typenv_of(toks: List[String]) -> String {
    return artifact_norm_section(build_struct_field_table(toks));
}

fn art_is_cap_name(t: String) -> Bool {
    if chars_len(t) <= 3 { return false; }
    return str_slice(t, chars_len(t) - 3, chars_len(t)) == "Cap";
}

// Declared cap grants: &XxxCap params in fn headers, first-seen order.
pub fn artifact_caps_of(toks: List[String]) -> String {
    let n: Int = list_len(toks);
    let mut out: String = "";
    let mut seen: String = "\t";
    let mut i: Int = 0;
    while i < n {
        if art_kind(toks, i) == "KW_FN" {
            let mut j: Int = i + 1;
            while j < n && art_kind(toks, j) != "LPAREN" && art_kind(toks, j) != "LBRACE" {
                j = j + 1;
            }
            if j < n && art_kind(toks, j) == "LPAREN" {
                let mut depth: Int = 0;
                let mut k: Int = j;
                while k < n {
                    let kk: String = art_kind(toks, k);
                    if kk == "LPAREN" { depth = depth + 1; }
                    if kk == "RPAREN" {
                        depth = depth - 1;
                        if depth == 0 { k = n; }
                    }
                    if kk == "AMP" && art_kind(toks, k + 1) == "IDENT" {
                        let nm: String = art_text(toks, k + 1);
                        if art_is_cap_name(nm) && !art_has(seen, nm) {
                            seen = seen + nm + "\t";
                            out = out + nm + "\n";
                        }
                    }
                    if k < n { k = k + 1; }
                }
            }
            i = j;
        }
        i = i + 1;
    }
    return artifact_norm_section(out);
}

// Contract verdict: const requires/ensures proved by this check.
// Reaching the artifact write means none refused, so the count proved.
pub fn artifact_smt_of(toks: List[String]) -> String {
    let clauses: List[String] = smt_contract_parse_tokens(toks);
    let n_cl: Int = list_len(clauses);
    if n_cl == 0 { return "0 clauses proved"; }
    let mut out: String = "";
    let n_tok: Int = list_len(toks);
    let mut i: Int = 0;
    while i < n_tok {
        let k: String = art_kind(toks, i);
        if k == "KW_FN" && i + 1 < n_tok {
            let fn_name: String = art_text(toks, i + 1);
            let verdicts: List[String] = smt_vc_prove_function_clauses(toks, i, fn_name);
            let n_v: Int = list_len(verdicts);
            let mut j: Int = 0;
            while j < n_v {
                let vrow: String = list_get(verdicts, j);
                let stat: String = field_at(vrow, 2);
                let cl_idx_str: String = field_at(vrow, 1);
                let cl_idx: Int = parse_int(cl_idx_str);
                let detail: String = field_at(vrow, 3);
                if smt_status_is_proven(stat) {
                    let mut vc_hash: String = smt_status_extract_hash(stat);
                    if vc_hash == "" {
                        let form: String = fn_name + ":" + cl_idx_str + ":" + detail;
                        let dig: String = crypto_sha256_internal(form);
                        vc_hash = str_slice(dig, 0, 16);
                    }
                    out = out + smt_record_pack_proven(fn_name, cl_idx, vc_hash, detail) + "\n";
                } else if stat == "DYNAMIC" {
                    out = out + smt_record_pack_dynamic(fn_name, cl_idx, detail) + "\n";
                } else {
                    out = out + vrow + "\n";
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    if out == "" { return n_cl.to_string() + " clauses proved"; }
    return artifact_norm_section(out);
}

pub fn artifact_write_toks(fs_w: &FsWriteCap, sys: &ProcessCap, path: String, src: String, toks: List[String]) -> String {
    artifact_ensure_dir(sys);
    let art: TypedArtifact = artifact_new(path, src, toks, artifact_typenv_of(toks), artifact_caps_of(toks), artifact_smt_of(toks));
    let dest: String = artifact_cache_path(art.sha);
    let body: String = artifact_encode(art);
    let wr: Result[Void, String] = write_file(fs_w, dest, body);
    if wr.is_err() {
        println("ERR\tartifact\twrite failed");
        process_exit(1);
    }
    return dest;
}

// Emit-side re-verification: recompute sections from decoded toks and
// refuse on any mismatch. Tag matches the caller prefix (emit, llvm).
pub fn artifact_verify_sections(art: TypedArtifact, tag: String) {
    if artifact_typenv_of(art.toks) != art.typenv {
        println("ERR\t" + tag + "\tartifact types mismatch");
        process_exit(1);
    }
    if artifact_caps_of(art.toks) != art.caps {
        println("ERR\t" + tag + "\tartifact caps mismatch");
        process_exit(1);
    }
    if artifact_smt_of(art.toks) != art.smt {
        println("ERR\t" + tag + "\tartifact smt mismatch");
        process_exit(1);
    }
}

pub fn artifact_remove_toks(sys: &ProcessCap, path: String, src: String) {
    let sha: String = artifact_sha(path, src);
    let dest: String = artifact_cache_path(sha);
    let _: Result[String, String] = sys_exec(sys, "rm", "-f", dest);
}
