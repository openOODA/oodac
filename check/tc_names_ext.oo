// # Typechecker Known Extension Names
//
// Logline: Recognize runtime extension symbols for PQC, GPU, Actor, and Audio.
//
// Setup: Called by is_known_name in tc_names_known.oo.
//
// Beats:
//   1. Post-quantum cryptography symbols and byte-level shims.
//   2. GPU initialization, buffer allocation, transfer, and HIP kernel dispatch.
//   3. Actor lifecycle, supervisor trees, channels, and threads.
//   4. Audio capture initialization and stream management.

pub fn is_known_ext_name(name: String) -> Bool {
    let mut s: String = name;
    let n: Int = bytes_len(s);
    if n == 0 { return false; }
    if byte_at(s, 0) == 64 {
        s = byte_slice(s, 1, n);
    }
    let b0: Int = byte_at(s, 0);
    if b0 != 99 && b0 != 111 && b0 != 103 && b0 != 97 && b0 != 116 && b0 != 115 {
        return false;
    }
    if str_starts_with(s, "crypto_") || str_starts_with(s, "oo_gpu_") { return true; }
    if str_starts_with(s, "oo_actor_") || str_starts_with(s, "oo_audio_") { return true; }
    if str_starts_with(s, "oo_channel_") || str_starts_with(s, "oo_thread_") { return true; }
    if str_starts_with(s, "oo_shm_") || str_starts_with(s, "oo_sys_") { return true; }
    if s == "oo_memfd_create" || s == "oo_ftruncate" || s == "oo_mmap" || s == "oo_munmap" || s == "oo_close_fd" { return true; }
    if s == "oo_otp_supervise" || s == "oo_shake256" || s == "oo_shake128" { return true; }
    if s == "oo_sha3_256_bytes" || s == "oo_sha3_512_bytes" { return true; }
    if str_starts_with(s, "gpu_") || str_starts_with(s, "actor_") { return true; }
    if str_starts_with(s, "audio_") || str_starts_with(s, "channel_") { return true; }
    if str_starts_with(s, "thread_") || str_starts_with(s, "shm_") || s == "otp_supervise" { return true; }
    return false;
}
