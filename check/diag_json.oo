// # Emit check errors as JSON
//
// Logline: Escapes diagnostic text, maps ERR kinds to stable codes, and reprints a check run as a JSON array.
//
// Setup: FsReadCap, FsWriteCap, ProcessCap, EnvCap. --json-errors re-invokes check and prints JSON.
//
// Beats:
//   1. Object builders + kind codes live in diag_json_obj.oo (cycle leaf).
//   2. run_check_json_errors re-invokes host check (no --json-errors), prints JSON, exits 1 on fail.

import "diag_json_parse.oo";
import "diag_json_obj.oo";


pub fn diag_emit_load_err(path: String, msg: String) {
    let obj: String = diag_obj_json("E_LOAD", "0", "0", msg, path);
    println("[" + obj + "]");
}


// Re-invoke `check` without --json-errors (no recurse). Print JSON. Exit 1 on check fail.
pub fn run_check_json_errors(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, env: &EnvCap, path: String) {
    let oc: Result[String, String] = env_get(env, "OODA_COMPILER");
    let mut host: String = "";
    if oc.is_ok() { host = oc.val; }
    if host == "" {
        let ob: Result[String, String] = env_get(env, "OODAC_BIN");
        if ob.is_ok() { host = ob.val; }
    }
    if host == "" {
        println("ERR\tjson\tOODA_COMPILER or OODAC_BIN required");
        process_exit(1);
    }
    if !path_exists(fs_r, path) {
        println("ERR\tjson\tmissing " + path);
        process_exit(1);
    }
    let r: Result[String, String] = sys_exec(sys, host, "check", path);
    let mut raw: String = "";
    if r.is_ok() { raw = r.val; } else { raw = r.val; }
    let json: String = diag_check_output_to_json(raw, path);
    println(json);
    if r.is_ok() { return; }
    process_exit(1);
}
