// # Build the fn return type table
//
// Logline: Scan fn headers and pack a tab-delimited fname:Ret table for annotation checks.
//
// Setup: field_at, list_get, and list_len exist; ann_prep calls build_fn_ret_table.
//
// Beats:
//   1. On KW_FN IDENT, walk tokens until LBRACE.
//   2. After ARROW IDENT, take the ident text as the return type.
//   3. Append fname:ret to the table when a return type was found.

import "tc_read_result.oo";


pub fn build_fn_ret_table(toks: List[String]) -> String {
    let n = list_len(toks);
let mut table = "\t";
let mut i = 0;
while i < n {
    let k: String = field_at(list_get(toks, i), 0);
    let mut fn_pos: Int = 0 - 1;
    if k == "KW_FN" {
        fn_pos = i;
    } else if k == "KW_PUB" || k == "KW_EXPORT" {
        let mut mi: Int = i + 1;
        while mi < n && (field_at(list_get(toks, mi), 0) == "KW_PUB" || field_at(list_get(toks, mi), 0) == "KW_EXPORT") {
            mi = mi + 1;
        }
        if mi < n && field_at(list_get(toks, mi), 0) == "KW_FN" {
            fn_pos = mi;
        }
    }
    if fn_pos >= 0 && fn_pos + 1 < n {
        if field_at(list_get(toks, fn_pos + 1), 0) == "IDENT" {
            let fname: String = field_at(list_get(toks, fn_pos + 1), 3);
            let mut j: Int = fn_pos + 2;
            let mut ret = "";
            let mut cont = true;
            while cont {
                if j >= n {
                    cont = false;
                } else {
                    let kk: String = field_at(list_get(toks, j), 0);
                    if kk == "ARROW" {
                        j = j + 1;
                        if j < n && field_at(list_get(toks, j), 0) == "AMP" {
                            j = j + 1;
                        }
                        if j < n {
                            if field_at(list_get(toks, j), 0) == "IDENT" {
                                ret = field_at(list_get(toks, j), 3);
                                j = j + 1;
                                if j < n {
                                    ret = tc_read_result_ann(ret, toks, j);
                                }
                            }
                        }
                    } else if kk == "LBRACE" {
                        cont = false;
                    } else {
                        j = j + 1;
                    }
                }
            }
            if ret != "" {
                table = table + fname + ":" + ret + "\t";
            }
            i = fn_pos + 1;
        } else {
            i = i + 1;
        }
    } else {
        i = i + 1;
    }
}
return table;
}
