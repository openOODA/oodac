// # Refuse an unused import
//
// Logline: An import path whose exported symbols never appear in the importer is unused.
//
// Setup: toks carry SRC_PATH. tc_err_at prints path and caret. Skip allow-listed harnesses, preludes, and stem _.
//
// Beats:
//   1. Walk KW_IMPORT; next STRING or IDENT STRING is the import path.
//   2. Resolve the path against the importer's directory; unresolvable or
//      unreadable targets stay silent (resolution errors surface elsewhere).
//   3. Scan the target's exported fn and type names; an import is used iff
//      some export appears as an IDENT in the importer. Targets with zero
//      scannable exports, or containing impl blocks, stay silent.
//   4. Heuristic lints must err toward silence, not toward refusing valid
//      programs (false negatives slip a dead import through; false
//      positives block real code). Name matching (not stem guessing) keeps
//      false positives near zero: a coincidental local with an export's
//      name counts as use.

fn tc_imp_ends(path: String, suf: String) -> Bool {
    let n: Int = chars_len(path);
    let m: Int = chars_len(suf);
    if n < m {
        return false;
    }
    return str_slice(path, n - m, n) == suf;
}

fn tc_imp_allow(path: String) -> Bool {
    // Preludes/harnesses/indexes: load-bearing or link-free (num_buffer:
    // int<->string println formatting has no textual link to its stem).
    if tc_imp_ends(path, "std/result.oo") { return true; }
    if tc_imp_ends(path, "std/option.oo") { return true; }
    if tc_imp_ends(path, "std/core/result.oo") { return true; }
    if tc_imp_ends(path, "std/core/option.oo") { return true; }
    if tc_imp_ends(path, "std/core/list.oo") { return true; }
    if tc_imp_ends(path, "std/core/text/num_buffer.oo") { return true; }
    if tc_imp_ends(path, "qa_harness.oo") { return true; }
    if tc_imp_ends(path, "test_harness.oo") { return true; }
    if tc_imp_ends(path, "ANCHOR.oo") || tc_imp_ends(path, "anchor.oo") { return true; }
    return false;
}

fn tc_imp_dirname(path: String) -> String {
    let n: Int = chars_len(path);
    let mut i: Int = n;
    while i > 0 {
        i = i - 1;
        if char_at(path, i) == "/" {
            return str_slice(path, 0, i + 1);
        }
    }
    return "";
}

fn tc_imp_is_word_char(c: String) -> Bool {
    if char_is_digit(c) { return true; }
    if c == "_" { return true; }
    let up: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let lo: String = "abcdefghijklmnopqrstuvwxyz";
    let mut i: Int = 0;
    while i < 26 {
        if c == char_at(up, i) { return true; }
        if c == char_at(lo, i) { return true; }
        i = i + 1;
    }
    return false;
}

fn tc_imp_scan_idents_body(src: String) -> String {
    let n: Int = chars_len(src);
    let mut out: String = "\t";
    let mut i: Int = 0;
    let mut in_str: Bool = false;
    let mut in_com: Bool = false;
    while i < n {
        let c: String = char_at(src, i);
        if in_str {
            if c == "\"" { in_str = false; }
            i = i + 1;
        } else if in_com {
            if c == "\n" { in_com = false; }
            i = i + 1;
        } else if c == "\"" {
            in_str = true;
            i = i + 1;
        } else if c == "/" && i + 1 < n && char_at(src, i + 1) == "/" {
            in_com = true;
            i = i + 2;
        } else if tc_imp_is_word_char(c) {
            let mut w: String = "";
            while i < n && tc_imp_is_word_char(char_at(src, i)) {
                w = w + char_at(src, i);
                i = i + 1;
            }
            out = out + w + "\t";
        } else {
            i = i + 1;
        }
    }
    return out;
}

fn tc_imp_scan_type_names(src: String) -> String {
    let n: Int = chars_len(src);
    let mut out: String = "\t";
    let mut i: Int = 0;
    let mut in_str: Bool = false;
    let mut in_com: Bool = false;
    while i < n {
        let c: String = char_at(src, i);
        if in_str {
            if c == "\"" { in_str = false; }
            i = i + 1;
        } else if in_com {
            if c == "\n" { in_com = false; }
            i = i + 1;
        } else if c == "\"" {
            in_str = true;
            i = i + 1;
        } else if c == "/" && i + 1 < n && char_at(src, i + 1) == "/" {
            in_com = true;
            i = i + 2;
        } else if tc_imp_is_word_char(c) {
            let mut w: String = "";
            while i < n && tc_imp_is_word_char(char_at(src, i)) {
                w = w + char_at(src, i);
                i = i + 1;
            }
            if w == "type" || w == "struct" || w == "trait" || w == "enum" {
                while i < n && (char_at(src, i) == " " || char_at(src, i) == "\t" || char_at(src, i) == "\n") { i = i + 1; }
                let mut nm: String = "";
                while i < n && tc_imp_is_word_char(char_at(src, i)) {
                    nm = nm + char_at(src, i);
                    i = i + 1;
                }
                if nm != "" {
                    out = out + nm + "\t";
                }
            }
        } else {
            i = i + 1;
        }
    }
    return out;
}

fn tc_imp_src_exempt(srcp: String) -> Bool {
    if srcp.contains("oodac/") {
        return true;
    }
    if srcp.contains("lex/") || srcp.contains("emit/") || srcp.contains("ast/") {
        return true;
    }
    if srcp.contains("check/") || srcp.contains("types/") || srcp.contains("cli/") {
        return true;
    }
    // anchor.oo / ANCHOR.oo files are module indexes: the import list IS the content.
    // A stale path still fails at import resolution, so nothing is hidden.
    if chars_len(srcp) >= 9 && (str_slice(srcp, chars_len(srcp) - 9, chars_len(srcp)) == "ANCHOR.oo" || str_slice(srcp, chars_len(srcp) - 9, chars_len(srcp)) == "anchor.oo") {
        return true;
    }
    return false;
}

fn tc_imp_export_used(idtable: String, exports: String) -> Bool {
    let n: Int = chars_len(exports);
    let mut i: Int = 0;
    while i < n {
        if char_at(exports, i) == "\t" {
            i = i + 1;
        } else {
            let mut nm: String = "";
            while i < n && char_at(exports, i) != "\t" {
                nm = nm + char_at(exports, i);
                i = i + 1;
            }
            if nm != "" && str_contains(idtable, "\t" + nm + "\t") {
                return true;
            }
        }
    }
    return false;
}

pub fn typecheck_unused_imports_graph(fs_r: &FsReadCap, src_path: String, toks: List[String]) {
    if tc_imp_src_exempt(src_path) {
        return;
    }
    let n: Int = list_len(toks);
    let dir: String = tc_imp_dirname(src_path);
    let mut idtable: String = "\t";
    let mut j: Int = 0;
    while j < n {
        let tk: String = list_get(toks, j);
        if field_at(tk, 0) == "IDENT" {
            idtable = idtable + field_at(tk, 3) + "\t";
        }
        j = j + 1;
    }
    let mut i: Int = 0;
    while i < n {
        if field_at(list_get(toks, i), 0) == "KW_IMPORT" {
            let mut path: String = "";
            let mut p: Int = i + 1;
            if p < n {
                let pk: String = field_at(list_get(toks, p), 0);
                if pk == "STRING" {
                    path = field_at(list_get(toks, p), 3);
                } else if pk == "IDENT" {
                    p = p + 1;
                    if p < n {
                        if field_at(list_get(toks, p), 0) == "STRING" {
                            path = field_at(list_get(toks, p), 3);
                        }
                    }
                }
            }
            if path != "" && !tc_imp_allow(path) && !tc_imp_ends(path, "/_.oo") && path != "_.oo" {
                let hit: String = resolve_import_path(fs_r, dir, path);
                if hit != "" {
                    let rr: Result[String, String] = read_file(fs_r, hit);
                    if !rr.is_err() {
                        let raw: String = match rr { Ok(s) => s, Err(_) => "" };
                        let idents: String = tc_imp_scan_idents_body(raw);
                        if !str_contains(idents, "\timpl\t") {
                            let exports: String = scan_fn_names(raw) + tc_imp_scan_type_names(raw);
                            if exports != "\t\t" && !tc_imp_export_used(idtable, exports) {
                                tc_err_at(toks, i, "unused import '" + path + "'");
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
}
