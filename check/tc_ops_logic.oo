// # Typecheck logical && and || operands
//
// Logline: Enforces that both operands of ANDAND and OROR evaluate to Bool.
//
// Setup: toks rows are kind, line, col, text; lit_env, struct_table, ret_table built once.
//
// Beats:
//   1. Identify ANDAND and OROR operators in the token stream.
//   2. Scan operand spans backward and forward respecting nested parentheses.
//   3. Infer operand types (atoms, paren subexpressions, arithmetic, comparisons).
//   4. Exit with a clean type error if either resolved operand is not Bool.

fn tc_logic_left_span(toks: List[String], op_idx: Int) -> Int {
    let mut p = op_idx - 1;
    let mut depth = 0;
    while p >= 0 {
        let pk = field_at(list_get(toks, p), 0);
        if pk == "RPAREN" {
            depth = depth + 1;
        } else if pk == "LPAREN" {
            if depth == 0 {
                return p + 1;
            }
            depth = depth - 1;
        } else if depth == 0 {
            if pk == "SEMI" || pk == "LBRACE" || pk == "RBRACE" || pk == "COMMA"
                || pk == "EQ" || pk == "COLON" || pk == "ARROW" || pk == "FAT_ARROW"
                || pk == "KW_IF" || pk == "KW_WHILE" || pk == "KW_LET" || pk == "KW_RETURN"
                || pk == "KW_MATCH" || pk == "KW_ELSE" || pk == "ANDAND" || pk == "OROR" {
                return p + 1;
            }
        }
        p = p - 1;
    }
    return 0;
}

fn tc_logic_right_span(toks: List[String], op_idx: Int, n: Int) -> Int {
    let mut p = op_idx + 1;
    let mut depth = 0;
    while p < n {
        let pk = field_at(list_get(toks, p), 0);
        if pk == "LPAREN" {
            depth = depth + 1;
        } else if pk == "RPAREN" {
            if depth == 0 {
                return p;
            }
            depth = depth - 1;
        } else if depth == 0 {
            if pk == "SEMI" || pk == "LBRACE" || pk == "RBRACE" || pk == "COMMA"
                || pk == "COLON" || pk == "EQ" || pk == "ARROW" || pk == "FAT_ARROW"
                || pk == "KW_IF" || pk == "KW_WHILE" || pk == "KW_LET" || pk == "KW_RETURN"
                || pk == "KW_MATCH" || pk == "KW_ELSE" || pk == "ANDAND" || pk == "OROR" {
                return p;
            }
        }
        p = p + 1;
    }
    return n;
}

fn tc_logic_infer_type(toks: List[String], start0: Int, end0: Int, lit_env: String, struct_table: String, ret_table: String) -> String {
    let mut s = start0;
    let mut e = end0;
    let mut strip = true;
    while strip {
        if s < e {
            if field_at(list_get(toks, s), 0) == "LPAREN" {
                let rp = match_rparen(toks, s);
                if rp == e - 1 {
                    s = s + 1;
                    e = e - 1;
                } else {
                    strip = false;
                }
            } else {
                strip = false;
            }
        } else {
            strip = false;
        }
    }
    if s >= e {
        return "";
    }
    let mut p = s;
    let mut d = 0;
    let mut has_cmp = false;
    let mut has_inner_logic = false;
    let mut has_arith_or_bit = false;
    while p < e {
        let pk = field_at(list_get(toks, p), 0);
        if pk == "LPAREN" {
            d = d + 1;
        } else if pk == "RPAREN" {
            if d > 0 {
                d = d - 1;
            }
        } else if d == 0 {
            if pk == "EQEQ" || pk == "NEQ" || pk == "LT" || pk == "GT" || pk == "LTE" || pk == "GTE" {
                has_cmp = true;
            } else if pk == "ANDAND" || pk == "OROR" {
                has_inner_logic = true;
            } else if pk == "PLUS" || pk == "MINUS" || pk == "STAR" || pk == "SLASH" || pk == "PERCENT"
                || pk == "AMP" || pk == "PIPE" || pk == "CARET" || pk == "BXOR"
                || pk == "LSHIFT" || pk == "RSHIFT" {
                has_arith_or_bit = true;
            }
        }
        p = p + 1;
    }
    if has_inner_logic || has_cmp {
        return "Bool";
    }
    if has_arith_or_bit {
        let ty = infer_typed_expr_type_exact(toks, s, e, lit_env);
        if ty != "" && ty != "ERR_BINOP" && ty != "ERR_DIV0" {
            return ty;
        }
        return "Int";
    }
    let sk = field_at(list_get(toks, s), 0);
    if sk == "BANG" {
        return "Bool";
    }
    if sk == "MINUS" {
        return "Int";
    }
    if e == s + 1 {
        let lit = lit_token_type(sk);
        if lit != "" {
            return lit;
        }
        if sk == "IDENT" {
            return atom_type_with_env(toks, s, lit_env);
        }
    }
    if sk == "IDENT" && s + 1 < e && field_at(list_get(toks, s + 1), 0) == "LPAREN" {
        if match_rparen(toks, s + 1) == e - 1 {
            let cname = field_at(list_get(toks, s), 3);
            if ret_table != "" {
                let got = resolve_type_alias(ret_table, cname);
                if got != cname && got != "" {
                    return got;
                }
            }
            if cname == "oo_str_eq" {
                return "Bool";
            }
        }
    }
    if sk == "IDENT" {
        let m_end = 0 + operand_end(toks, s);
        if m_end == e {
            let oty = operand_type_with_env(toks, s, lit_env);
            if oty != "" {
                return oty;
            }
        }
        let fty = field_chain_type(toks, s, e, lit_env, struct_table);
        if fty != "" {
            return fty;
        }
        let fty2 = field_access_type_at(toks, s, lit_env, struct_table);
        if fty2 != "" {
            return fty2;
        }
    }
    let exact_ty = infer_typed_expr_type_exact(toks, s, e, lit_env);
    if exact_ty != "" && exact_ty != "ERR_BINOP" && exact_ty != "ERR_DIV0" {
        return exact_ty;
    }
    return "";
}

pub fn typecheck_logic_binop_lits(toks: List[String]) {
    let n = list_len(toks);
    let lit_env: String = build_pure_lit_env(toks);
    let struct_table: String = build_struct_field_table(toks);
    let ret_table: String = build_fn_ret_table(toks);
    let mut i = 0;
    while i < n {
        let k: String = field_at(list_get(toks, i), 0);
        let mut is_logic = false;
        if k == "ANDAND" {
            is_logic = true;
        } else if k == "OROR" {
            is_logic = true;
        }
        if is_logic {
            if i > 0 && i + 1 < n {
                let lstart = tc_logic_left_span(toks, i);
                let rend = tc_logic_right_span(toks, i, n);
                let lty = tc_logic_infer_type(toks, lstart, i, lit_env, struct_table, ret_table);
                let rty = tc_logic_infer_type(toks, i + 1, rend, lit_env, struct_table, ret_table);
                if lty != "" && lty != "Bool" {
                    let mut rmsg = rty;
                    if rmsg == "" {
                        rmsg = "unknown";
                    }
                    tc_err_at(
                        toks,
                        i,
                        "logical operator requires Bool operands, found "
                            + lty
                            + " and "
                            + rmsg
                    );
                }
                if rty != "" && rty != "Bool" {
                    let mut lmsg = lty;
                    if lmsg == "" {
                        lmsg = "unknown";
                    }
                    tc_err_at(
                        toks,
                        i,
                        "logical operator requires Bool operands, found "
                            + lmsg
                            + " and "
                            + rty
                    );
                }
            }
        }
        i = i + 1;
    }
}
