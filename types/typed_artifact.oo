// # Typed compile artifact
//
// Logline: Token rows plus type env, granted caps, and SMT verdict. Check writes it. Emit verifies it.
//
// Setup: TSV token rows. SHA is content_hash of path plus source. No second lex.
//        Sections record what check computed: struct shapes, declared cap
//        grants, and the proved contract count. Emit recomputes and refuses
//        on mismatch. Old OODAART2 files are stale and refused.
//
// Beats:
//   1. Pack path, sha, token rows, typenv, caps, and smt verdict.
//   2. Encode and decode OODAART3 text for the cache.
//   3. Cache path is .ooda-cache/ooda-tmp/art_<sha>.art.

import "lex/token_parse_int.oo";

pub type TypedArtifact = struct {
    path: String,
    sha: String,
    toks: List[String],
    typenv: String,
    caps: String,
    smt: String
};

pub fn artifact_sha(path: String, src: String) -> String {
    let digest: String = crypto_sha256_internal(path + "\n" + src);
    if chars_len(digest) >= 16 {
        return str_slice(digest, 0, 16);
    }
    if chars_len(digest) > 0 {
        return digest;
    }
    return "empty000";
}

pub fn artifact_cache_path(sha: String) -> String {
    return ".ooda-cache/ooda-tmp/art_" + sha + ".art";
}

pub fn artifact_new(path: String, src: String, toks: List[String], typenv: String, caps: String, smt: String) -> TypedArtifact {
    return TypedArtifact {
        path: path,
        sha: artifact_sha(path, src),
        toks: toks,
        typenv: artifact_norm_section(typenv),
        caps: artifact_norm_section(caps),
        smt: artifact_norm_section(smt)
    };
}

fn artifact_emit_section(out: String, body: String) -> String {
    let mut acc: String = out;
    if body != "" {
        acc = acc + body;
        if char_at(body, chars_len(body) - 1) != "\n" {
            acc = acc + "\n";
        }
    }
    return acc;
}

pub fn artifact_encode(art: TypedArtifact) -> String {
    let mut out: String = "OODAART3\n";
    out = out + art.path + "\n";
    out = out + art.sha + "\n";
    out = out + "types:\n";
    out = artifact_emit_section(out, art.typenv);
    out = out + "caps:\n";
    out = artifact_emit_section(out, art.caps);
    out = out + "smt:\n";
    out = artifact_emit_section(out, art.smt);
    out = out + "--\n";
    let n: Int = list_len(art.toks);
    let mut i: Int = 0;
    while i < n {
        out = out + list_get(art.toks, i) + "\n";
        i = i + 1;
    }
    return out;
}

fn art_line_end(s: String, start: Int) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = start;
    while i < n {
        if char_at(s, i) == "\n" { return i; }
        i = i + 1;
    }
    return n;
}

pub fn artifact_norm_section(body: String) -> String {
    let mut out: String = body;
    while chars_len(out) > 0 && char_at(out, chars_len(out) - 1) == "\n" {
        out = str_slice(out, 0, chars_len(out) - 1);
    }
    return out;
}

fn artifact_push_row(buf: String, line: String) -> String {
    if buf == "" {
        return line;
    }
    return buf + "\n" + line;
}

pub fn artifact_decode(text: String) -> TypedArtifact {
    let n: Int = chars_len(text);
    let mut i: Int = 0;
    let mut field: Int = 0;
    let mut path: String = "";
    let mut sha: String = "";
    let mut typenv: String = "";
    let mut caps: String = "";
    let mut smt: String = "";
    let mut toks: List[String] = list_new();
    let mut in_toks: Bool = false;
    while i < n {
        let e: Int = art_line_end(text, i);
        let line: String = str_slice(text, i, e);
        if in_toks {
            if chars_len(line) > 0 {
                toks = list_push(toks, line);
            }
        } else if field == 0 {
            if line == "OODAART2" {
                println("ERR\tartifact\tstale v2, re-run check");
                process_exit(1);
            }
            if line != "OODAART3" {
                println("ERR\tartifact\tbad magic");
                process_exit(1);
            }
            field = 1;
        } else if field == 1 {
            path = line;
            field = 2;
        } else if field == 2 {
            sha = line;
            field = 3;
        } else if field == 3 {
            if line != "types:" {
                println("ERR\tartifact\tbad types header");
                process_exit(1);
            }
            field = 4;
        } else if field == 4 {
            if line == "caps:" {
                field = 5;
            } else {
                typenv = artifact_push_row(typenv, line);
            }
        } else if field == 5 {
            if line == "smt:" {
                field = 6;
            } else {
                caps = artifact_push_row(caps, line);
            }
        } else if field == 6 {
            if line == "--" {
                in_toks = true;
            } else {
                smt = artifact_push_row(smt, line);
            }
        }
        if e >= n {
            i = n;
        } else {
            i = e + 1;
        }
    }
    if !in_toks {
        println("ERR\tartifact\ttruncated");
        process_exit(1);
    }
    return TypedArtifact { path: path, sha: sha, toks: toks, typenv: typenv, caps: caps, smt: smt };
}

fn art_field(line: String, which: Int) -> String {
    let n: Int = chars_len(line);
    let mut field: Int = 0;
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(line, i) == "\t" {
            if field == which { return str_slice(line, start, i); }
            field = field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if field == which { return str_slice(line, start, n); }
    return "";
}

pub fn smt_status_is_proven(status: String) -> Bool {
    if status == "PROVEN" { return true; }
    return chars_len(status) >= 7 && str_slice(status, 0, 7) == "PROVEN:";
}

pub fn smt_status_extract_hash(status: String) -> String {
    if chars_len(status) > 7 && str_slice(status, 0, 7) == "PROVEN:" {
        return str_slice(status, 7, chars_len(status));
    }
    return "";
}

pub fn smt_record_pack_proven(fn_name: String, cl_idx: Int, vc_hash: String, detail: String) -> String {
    let mut row: String = fn_name + "\t" + cl_idx.to_string() + "\tPROVEN:" + vc_hash;
    if detail != "" { row = row + "\t" + detail; }
    return row;
}

pub fn smt_record_pack_dynamic(fn_name: String, cl_idx: Int, reason: String) -> String {
    let mut row: String = fn_name + "\t" + cl_idx.to_string() + "\tDYNAMIC";
    if reason != "" { row = row + "\t" + reason; }
    return row;
}

pub fn artifact_smt_row_fn(row: String) -> String { return art_field(row, 0); }
pub fn artifact_smt_row_idx(row: String) -> Int { return parse_int(art_field(row, 1)); }
pub fn artifact_smt_row_status(row: String) -> String {
    let stat: String = art_field(row, 2);
    if smt_status_is_proven(stat) { return "PROVEN"; }
    return stat;
}

pub fn artifact_smt_find_status(smt_sec: String, fn_name: String, cl_idx: Int) -> String {
    let n: Int = chars_len(smt_sec);
    let mut p: Int = 0;
    while p < n {
        let mut e: Int = p;
        while e < n && char_at(smt_sec, e) != "\n" { e = e + 1; }
        let line: String = str_slice(smt_sec, p, e);
        if art_field(line, 0) == fn_name && parse_int(art_field(line, 1)) == cl_idx {
            return art_field(line, 2);
        }
        p = e + 1;
    }
    return "";
}

