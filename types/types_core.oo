// # Check Caps — Capability Seal / Check Types — Type Validation / Type Env — Type Environment
//
// Logline: Validates sealed capability arguments per function with zero ambient authority. Validates type correctness via token length and fail-closed bounds. Manages type environment bindings for checking.
//
// Setup: Merged cohesive compiler module.
//
// Beats:
//   1. Unified cohesive implementation.

pub fn check_caps(toks: List[String], pos0: Int) -> Int {
    let n: Int = list_len(toks);
if pos0 < 0 || pos0 >= n { println("ERR\tcapability\tpos out of bounds at " + pos0.to_string());
process_exit(1);
}
  if n > 1048576 { println("ERR\tcapability\ttoken stream exceeds 1MiB limit");
  process_exit(1);
  }
  return pos0;
}

pub fn check_types(src: String) -> String {
    let n: Int = chars_len(src);
if n == 0 { return "";
}
  if n > 1048576 { return "ERR\tcheck\tpayload too large";
  }
  return "";
}

pub fn type_env_new() -> String {
    return "";
}

pub fn type_env_put(env: String, name: String, ty: String) -> String {
    return env + name + "=" + ty + ";";
}

pub fn type_env_get(env: String, name: String) -> String {
    let key: String = name + "=";
let kn: Int = chars_len(key);
let en: Int = chars_len(env);
let mut found: String = "";
let mut i: Int = 0;
while i + kn <= en { let at: Bool = i == 0 || (char_at(env, i - 1) == ";");
if at { let mut ok: Bool = true;
let mut j: Int = 0;
while j < kn { if !(char_at(env, i + j) == char_at(key, j)) { ok = false;
j = kn;
}
        j = j + 1;
      }
      if ok { let s: Int = i + kn;
      let mut k: Int = s;
      while k < en && !(char_at(env, k) == ";") { k = k + 1;
      }
        found = str_slice(env, s, k);
      }
    }
    i = i + 1;
  }
  return found;
}

pub fn type_env(env: String, name: String, ty: String) -> String {
    return type_env_put(env, name, ty);
}

pub fn result_ok_payload_type(rty: String) -> String {
    let n: Int = chars_len(rty);
    if n < 8 || str_slice(rty, 0, 7) != "Result[" { return "String"; }
    let mut i: Int = 7;
    let mut name: String = "";
    while i < n {
        let c: String = char_at(rty, i);
        if c == "," || c == "]" { break; }
        name = name + c;
        i = i + 1;
    }
    if name == "Void" { return "Void"; }
    if name == "List" { return str_slice(rty, 7, n - 1); }
    if name == "" { return "String"; }
    return name;
}

pub fn is_cap_type(t: String) -> Bool {
    return t == "NetCap" || t == "FsCap" || t == "FsReadCap" || t == "FsWriteCap" || t == "GpuCap" || t == "ThreadCap" || t == "SysCap" || t == "EnvCap" || t == "TimeCap" || t == "RandCap" || t == "AllocCap" || t == "MemCap" || t == "ArenaCap" || t == "UnsafeFFICap" || t == "FfiCap" || t == "HitlCap" || t == "AuditCap" || t == "SignCap" || t == "HttpCap" || t == "TcpCap" || t == "UdpCap" || t == "BindCap" || t == "ProcessCap" || t == "SyncCap" || t == "AudioCap" || t == "CameraCap" || t == "UsbCap" || t == "HidCap" || t == "WindowCap" || t == "FrameCap" || t == "CompilerReadCap";
}


