// # Compiler Type System
//
// Logline: Type system core — type definitions, representation, parsing, and name mangling. The companion type-checker lives in oodac/check/.
//
// Setup: Pure functional type primitives. The lexer produces typed tokens (token_typed.oo) that flow into ty.oo for type representation. ty_parse.oo parses type expressions; ty_mangle.oo lowers type names to linker symbols; types_core.oo is the canonical type algebra.
//
// Beats:
//   1. ast_type_def.oo — type definitions in the AST (struct, enum, type alias).
//   2. token_typed.oo — typed tokens produced by the lexer and TSV converters.
//   3. str_escape.oo — canonical shell and string escaping routines.
//   4. token_search.oo — canonical delimiter and token skipping utilities.
//   5. ty.oo — type representation (the central type algebra).
//   6. ty_parse.oo — parse a type expression into a ty.oo value.
//   7. ty_mangle.oo — mangle a type into a stable linker symbol.
//   8. types_core.oo — primitive type constructors and operations.

import "ty.oo";
import "ty_parse.oo";
import "ty_mangle.oo";
import "types_core.oo";
import "token_typed.oo";
import "str_escape.oo";
import "token_search.oo";

// ──▓▓ Public Types Subsystem API ──▓▓──

pub fn types_is_cap(t: String) -> Bool {
    return is_cap_type(t);
}

pub fn types_result_payload(rty: String) -> String {
    return result_ok_payload_type(rty);
}

pub fn types_env_new() -> String {
    return type_env_new();
}

pub fn types_env_put(env: String, name: String, ty: String) -> String {
    return type_env_put(env, name, ty);
}

pub fn types_env_get(env: String, name: String) -> String {
    return type_env_get(env, name);
}

pub fn types_parse_str(raw: String) -> String {
    return ty_parse_str(raw);
}

pub fn types_mangle(raw: String) -> String {
    return ty_mangle(raw);
}

pub fn token_typed_from_tsv(tsv_toks: List[String]) -> List[TypedToken] {
    return tokens_from_tsv(tsv_toks);
}

pub fn token_typed_to_tsv(typed_toks: List[TypedToken]) -> List[String] {
    return tokens_to_tsv(typed_toks);
}

pub fn str_escape_shell_sq(s: String) -> String {
    return shell_sq(s);
}

pub fn token_search_until_semi(toks: List[String], pos: Int) -> Int {
    return skip_until_semi(toks, pos);
}

pub fn token_search_balanced(toks: List[String], pos: Int) -> Int {
    return skip_balanced(toks, pos);
}
