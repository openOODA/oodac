// # Type tag decode
//
// Logline: Decode a tagged type string into a constructor name. No C enum (unique_fns preamble has no TyTag).
//
// Setup: Nested payloads stay strings. Completeness 4.
//
// Beats:
//   1. ty_kind_tag returns the constructor prefix before '('.
//   2. ty_kind maps wire aliases onto TyInt/TyFloat/.../TUnknown.
//   3. ty_kind_is_ref is true for TyRef and TyRefMut.

fn ty_kind_tag(ty: String) -> String {
    let n: Int = chars_len(ty);
    let mut i: Int = 0;
    while i < n {
        if char_at(ty, i) == "(" { return str_slice(ty, 0, i); }
        i = i + 1;
    }
    return ty;
}

pub fn ty_kind(ty: String) -> String {
    let t: String = ty_kind_tag(ty);
    if t == "TyInt" || t == "Int" || t == "i64" || t == "isize" { return "TyInt"; }
    if t == "TyFloat" || t == "Float" || t == "f64" { return "TyFloat"; }
    if t == "TyBool" || t == "Bool" { return "TyBool"; }
    if t == "TyStr" || t == "String" || t == "str" { return "TyStr"; }
    if t == "TyUnit" || t == "Void" || t == "void" || t == "unit" { return "TyUnit"; }
    if t == "TyF32x8" || t == "f32x8" { return "TyF32x8"; }
    if t == "TyF64x4" || t == "f64x4" { return "TyF64x4"; }
    if t == "TyList" { return "TyList"; }
    if t == "TyOption" { return "TyOption"; }
    if t == "TyResult" { return "TyResult"; }
    if t == "TyBox" { return "TyBox"; }
    if t == "TyName" { return "TyName"; }
    if t == "TyCap" { return "TyCap"; }
    if t == "TyRef" { return "TyRef"; }
    if t == "TyRefMut" { return "TyRefMut"; }
    return "TUnknown";
}

pub fn ty_kind_is_ref(ty: String) -> Bool {
    let t: String = ty_kind(ty);
    if t == "TyRef" { return true; }
    if t == "TyRefMut" { return true; }
    return false;
}
