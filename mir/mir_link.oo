// # In-Tree Sovereign Static Linker for Multi-Module MIR
//
// Logline: Merge relocatable modules, resolve symbol addresses, and emit executable ELF64 binaries.
//
// Setup: Standalone resolution without external linkers. Implements S + A - P PC32 relocation.
//
// Beats:
//   1. Collect and layout module text segments with 16-byte alignment.
//   2. Build global symbol address table and fail closed on duplicates or missing targets.
//   3. Patch rel32 call/branch displacements and prepend ET_EXEC ELF64 header.

import "emit/elf/elf_hdr.oo";
import "emit/elf/elf_u.oo";

pub type MirSymbol = struct {
    name: String,
    val: Int,
    is_def: Bool
};

pub type MirReloc = struct {
    patch_offset: Int,
    sym_name: String,
    addend: Int
};

pub type MirModule = struct {
    name: String,
    code: List[Int],
    syms: List[MirSymbol],
    rels: List[MirReloc]
};

pub type MirLinker = struct {
    modules: List[MirModule],
    entry_sym: String
};

pub fn mir_module_new(name: String, code: List[Int]) -> MirModule {
    return MirModule { name: name, code: code, syms: list_new(), rels: list_new() };
}

pub fn mir_module_add_sym(m: &mut MirModule, name: String, val: Int, is_def: Bool) {
    let s: MirSymbol = MirSymbol { name: name, val: val, is_def: is_def };
    m.syms = list_push(m.syms, s);
}

pub fn mir_module_add_rel(m: &mut MirModule, patch_off: Int, sym_name: String, addend: Int) {
    let r: MirReloc = MirReloc { patch_offset: patch_off, sym_name: sym_name, addend: addend };
    m.rels = list_push(m.rels, r);
}

pub fn mir_linker_new(entry_sym: String) -> MirLinker {
    return MirLinker { modules: list_new(), entry_sym: entry_sym };
}

pub fn mir_linker_add(linker: &mut MirLinker, m: MirModule) {
    linker.modules = list_push(linker.modules, m);
}

pub fn mir_linker_patch_i32(b: List[Int], pos: Int, val: Int) -> List[Int] {
    let mut out: List[Int] = b;
    let mut uv: Int = if val >= 0 { val } else { 4294967296 + val };
    let mut i: Int = 0;
    while i < 4 {
        let byte_val: Int = uv - (uv / 256) * 256;
        out = list_set(out, pos + i, byte_val);
        uv = uv / 256;
        i = i + 1;
    }
    return out;
}

pub fn mir_linker_resolve_rels(b: List[Int], modules: List[MirModule], mod_offs: List[Int], sym_names: List[String], sym_addrs: List[Int], base_vaddr: Int) -> List[Int] {
    let mut merged: List[Int] = b;
    let mut mi: Int = 0;
    while mi < list_len(modules) {
        let m: MirModule = list_get(modules, mi);
        let m_off: Int = list_get(mod_offs, mi);
        let mut ri: Int = 0;
        while ri < list_len(m.rels) {
            let rel: MirReloc = list_get(m.rels, ri);
            let mut target_s: Int = 0;
            let mut ski: Int = 0;
            while ski < list_len(sym_names) {
                if list_get(sym_names, ski) == rel.sym_name { target_s = list_get(sym_addrs, ski); break; }
                ski = ski + 1;
            }
            let p_off: Int = m_off + rel.patch_offset;
            let p_addr: Int = base_vaddr + p_off;
            let disp32: Int = target_s + rel.addend - p_addr;
            merged = mir_linker_patch_i32(merged, p_off, disp32);
            ri = ri + 1;
        }
        mi = mi + 1;
    }
    return merged;
}

pub fn mir_linker_link(linker: &MirLinker) -> List[Int] {
    let mut merged: List[Int] = bytes_new();
    let mut mod_offs: List[Int] = list_new();
    let mut sym_names: List[String] = list_new();
    let mut sym_addrs: List[Int] = list_new();
    let base_vaddr: Int = 4194424;
    let mut mi: Int = 0;
    while mi < list_len(linker.modules) {
        let m: MirModule = list_get(linker.modules, mi);
        while (list_len(merged) % 16) != 0 { merged = bytes_push(merged, 144); }
        let cur_off: Int = list_len(merged);
        mod_offs = list_push(mod_offs, cur_off);
        let mut ci: Int = 0;
        while ci < list_len(m.code) { merged = bytes_push(merged, list_get(m.code, ci)); ci = ci + 1; }
        let mut si: Int = 0;
        while si < list_len(m.syms) {
            let s: MirSymbol = list_get(m.syms, si);
            if s.is_def { sym_names = list_push(sym_names, s.name); sym_addrs = list_push(sym_addrs, base_vaddr + cur_off + s.val); }
            si = si + 1;
        }
        mi = mi + 1;
    }
    merged = mir_linker_resolve_rels(merged, linker.modules, mod_offs, sym_names, sym_addrs, base_vaddr);
    let mut out: List[Int] = elf_ehdr_phdr(list_len(merged));
    let mut bi: Int = 0;
    while bi < list_len(merged) { out = bytes_push(out, list_get(merged, bi)); bi = bi + 1; }
    if chars_len(linker.entry_sym) > 0 {
        let mut ei: Int = 0;
        while ei < list_len(sym_names) {
            if list_get(sym_names, ei) == linker.entry_sym { out = mir_linker_patch_i32(out, 24, list_get(sym_addrs, ei)); break; }
            ei = ei + 1;
        }
    }
    return out;
}
