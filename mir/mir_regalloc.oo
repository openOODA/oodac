// # Linear Scan Register Allocator with Loop-Depth Weighting
//
// Logline: Deterministic interval allocation, 10^d spill cost weighting, and active eviction.
//
// Setup: Maps virtual registers to physical register pool or stack spill slots.
//
// Beats:
//   1. Collects live ranges [start_pc, end_pc] and loop-depth execution frequencies.
//   2. Linear scan assigns hinted or free physical registers to eliminate moves.
//   3. Weighted priority eviction and deterministic stack spill slot allocation.

import "mir_types.oo";

pub type MirInterval = struct {
    vreg: String,
    start_pc: Int,
    end_pc: Int,
    phys: Int,
    spill: Int,
    hint_phys: Int,
    weight: Int
};

pub type MirRegAlloc = struct {
    intervals: List[MirInterval],
    num_spills: Int
};

pub fn mir_regalloc_new() -> MirRegAlloc {
    let empty: List[MirInterval] = list_new();
    return MirRegAlloc { intervals: empty, num_spills: 0 };
}

pub fn mir_regalloc_add(ra: &mut MirRegAlloc, vreg: String, start_pc: Int, end_pc: Int) {
    let iv: MirInterval = MirInterval {
        vreg: vreg,
        start_pc: start_pc,
        end_pc: end_pc,
        phys: 0 - 1,
        spill: 0 - 1,
        hint_phys: 0 - 1,
        weight: 1
    };
    ra.intervals = list_push(ra.intervals, iv);
}

pub fn mir_regalloc_solve(ra: &mut MirRegAlloc, pool_size: Int) {
    let mut free_until: List[Int] = list_new(); let mut p: Int = 0;
    while p < pool_size { free_until = list_push(free_until, 0 - 1); p = p + 1; }
    let mut updated: List[MirInterval] = list_new();
    let mut i: Int = 0;
    while i < list_len(ra.intervals) {
        let mut iv: MirInterval = list_get(ra.intervals, i);
        let mut allocated: Bool = false;
        if iv.hint_phys >= 0 && iv.hint_phys < pool_size && list_get(free_until, iv.hint_phys) < iv.start_pc {
            iv.phys = iv.hint_phys; free_until = list_set(free_until, iv.hint_phys, iv.end_pc); allocated = true;
        }
        if !allocated {
            let mut r: Int = 0;
            while r < pool_size {
                if list_get(free_until, r) < iv.start_pc {
                    iv.phys = r; free_until = list_set(free_until, r, iv.end_pc); allocated = true; break;
                }
                r = r + 1;
            }
        }
        if !allocated {
            let mut ev_i: Int = 0 - 1; let mut min_w: Int = iv.weight; let mut k: Int = 0;
            while k < list_len(updated) {
                let prev: MirInterval = list_get(updated, k);
                if prev.phys >= 0 && prev.end_pc > iv.start_pc && prev.weight < min_w { min_w = prev.weight; ev_i = k; }
                k = k + 1;
            }
            if ev_i >= 0 {
                let mut ev: MirInterval = list_get(updated, ev_i);
                iv.phys = ev.phys; free_until = list_set(free_until, ev.phys, iv.end_pc);
                ev.phys = 0 - 1; ev.spill = ra.num_spills; ra.num_spills = ra.num_spills + 1;
                updated = list_set(updated, ev_i, ev); allocated = true;
            }
        }
        if !allocated { iv.phys = 0 - 1; iv.spill = ra.num_spills; ra.num_spills = ra.num_spills + 1; }
        updated = list_push(updated, iv); i = i + 1;
    }
    ra.intervals = updated;
}

pub fn mir_regalloc_run(insts: List[MirInst], pool_size: Int) -> MirRegAlloc {
    let mut ra: MirRegAlloc = mir_regalloc_new();
    let mut vregs: List[String] = list_new(); let mut starts: List[Int] = list_new();
    let mut ends: List[Int] = list_new(); let mut weights: List[Int] = list_new();
    let mut pc: Int = 0; let mut depth: Int = 0;
    while pc < list_len(insts) {
        let inst: MirInst = list_get(insts, pc);
        if inst.op == "loop_begin" || inst.op == "loop_start" { depth = depth + 1; }
        if inst.op == "loop_end" && depth > 0 { depth = depth - 1; }
        let cost: Int = if depth == 0 { 1 } else if depth == 1 { 10 } else if depth == 2 { 100 } else if depth == 3 { 1000 } else { 10000 };
        let mut names: List[String] = list_new();
        if inst.dst != "" { names = list_push(names, inst.dst); }
        let mut a: Int = 0;
        while a < list_len(inst.args) {
            let opnd: MirOpnd = list_get(inst.args, a);
            if opnd.is_reg && opnd.val != "" { names = list_push(names, opnd.val); }
            a = a + 1;
        }
        let mut m: Int = 0;
        while m < list_len(names) {
            let raw_nm: String = list_get(names, m);
            let nm: String = if chars_len(raw_nm) > 0 && char_at(raw_nm, 0) == "%" { raw_nm } else { "%" + raw_nm };
            let mut k: Int = 0; let mut found: Int = 0 - 1;
            while k < list_len(vregs) { if list_get(vregs, k) == nm { found = k; break; } k = k + 1; }
            if found < 0 {
                vregs = list_push(vregs, nm); starts = list_push(starts, pc); ends = list_push(ends, pc); weights = list_push(weights, cost);
            } else { ends = list_set(ends, found, pc); weights = list_set(weights, found, list_get(weights, found) + cost); }
            m = m + 1;
        }
        pc = pc + 1;
    }
    let mut j: Int = 0;
    while j < list_len(vregs) {
        let iv: MirInterval = MirInterval { vreg: list_get(vregs, j), start_pc: list_get(starts, j), end_pc: list_get(ends, j), phys: 0 - 1, spill: 0 - 1, hint_phys: 0 - 1, weight: list_get(weights, j) };
        ra.intervals = list_push(ra.intervals, iv); j = j + 1;
    }
    mir_regalloc_solve(&mut ra, pool_size);
    return ra;
}

pub fn mir_regalloc_lookup_phys(ra: &MirRegAlloc, vreg: String) -> Int {
    let n: Int = list_len(ra.intervals);
    let mut i: Int = 0;
    while i < n {
        let iv: MirInterval = list_get(ra.intervals, i);
        if iv.vreg == vreg { return iv.phys; }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn mir_regalloc_lookup_spill(ra: &MirRegAlloc, vreg: String) -> Int {
    let n: Int = list_len(ra.intervals);
    let mut i: Int = 0;
    while i < n {
        let iv: MirInterval = list_get(ra.intervals, i);
        if iv.vreg == vreg { return iv.spill; }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn mir_regalloc_spill_count(ra: &MirRegAlloc) -> Int {
    return ra.num_spills;
}

pub fn mir_reg_name(phys: Int) -> String {
    if phys == 0 { return "rax"; }
    if phys == 1 { return "rcx"; }
    if phys == 2 { return "rdx"; }
    if phys == 3 { return "rbx"; }
    if phys == 4 { return "rsi"; }
    if phys == 5 { return "rdi"; }
    if phys == 6 { return "r8"; }
    if phys == 7 { return "r9"; }
    if phys == 8 { return "r10"; }
    if phys == 9 { return "r11"; }
    return "none";
}
