// # oodac Compiler Core — Canonical ANCHOR Entry
//
// Logline: Re-exports the C-backend compiler surface for toolchain consumers.
//
// Setup: Compiles the canonical surface from the flat layout. Subsystem boundaries: lex → parse → check → tc → emit/c. This ANCHOR.oo is the oodac/ parent directory entry.
//
// Beats:
//   1. Re-export the lexical scanner surface (lex_all).
//   2. Re-export the parser surface (ast/, parse_expr, parse_stmt, parse_file).
//   3. Re-export the typechecker surface (types/, check_caps, check_types).
//   4. Boundary: internal refactor of the C emitter stays local; toolchain imports this single file.

import "lex/anchor.oo";
import "ast/anchor.oo";
import "check/anchor.oo";
import "types/anchor.oo";
import "emit/c/anchor.oo";
import "cli/anchor.oo";
// ──▓▓ Sovereign Lattice ── OODAC ANCHOR ──▓▓──
// :: public: oodac_lex_all, oodac_parse_expr, oodac_parse_stmt, oodac_parse_file ::

pub fn oodac_lex_all(src: String) -> String {
    return lex_scan_source(src).unwrap_or("");
}

pub fn oodac_parse_expr(src: String) -> String {
    return parse_expr(src);
}

pub fn oodac_parse_stmt(src: String) -> String {
    return parse_stmt(src);
}

pub fn oodac_parse_file(src: String) -> String {
    return parse_file(src);
}
