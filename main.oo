// # Dispatch oodac commands
//
// Logline: Parse argv and run check, build, emit-c, or tokens on the C backend.
//
// Setup: Dispatch check, build, emit-c, emit-llvm, and tokens. C is the reference ISA.
//
// Beats:
//   1. Unpack cmd/path/out/backend/json/plain.
//   2. Dispatch check, build, emit-c family, emit-llvm, or tokens.
//   3. Unknown cmd exits 2.

import "lex/ANCHOR.oo";
import "ast/ANCHOR.oo";
import "check/ANCHOR.oo";
import "types/ANCHOR.oo";
import "emit/c/ANCHOR.oo";
import "cli/cli_parse.oo";
import "cli/cli_build.oo";
import "cli/cli_emit.oo";
import "cli/cli_emit_llvm.oo";

pub fn main(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, env: &EnvCap, args: List[String]) {
    let a: List[String] = parse_cli_argv(fs_r, fs_w, sys, args);
    let cmd: String = list_get(a, 0);
    let path: String = list_get(a, 1);
    let out_arg: String = list_get(a, 2);
    let backend: String = list_get(a, 3);
    let json_errors: Bool = list_get(a, 4) == "1";
    let is_plain: Bool = list_get(a, 5) == "1";
    let concat: Bool = list_get(a, 6) == "1";
    let mut art_path: String = "";
    if list_len(a) > 7 {
        art_path = list_get(a, 7);
    }

    if cmd == "build" {
        run_build_san(fs_r, fs_w, sys, env, path, out_arg, backend);
        return;
    }
    if cmd == "emit-llvm" {
        run_emit_llvm(fs_r, env, path, concat);
        return;
    }
    if cmd == "emit-c" || cmd == "emit-protos" || cmd == "emit-bodies" || cmd == "emit-preamble" {
        run_emit_c_family(fs_r, env, cmd, path, is_plain, concat, art_path);
        return;
    }
    if cmd == "check" {
        if json_errors { run_check_json_errors(fs_r, fs_w, sys, path); return; }
        run_check_path(fs_r, fs_w, sys, path);
        return;
    }
    if cmd == "tokens" {
        dump_tokens(load_source_with_imports(fs_r, path));
        return;
    }
    println("ERR\tcmd\tresidual: " + cmd);
    process_exit(2);
}
